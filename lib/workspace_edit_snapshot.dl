# Normalize all protocol targets and snapshot touched disk resources/open buffers.

import lib/workspace_edit_plan_types.dl
import lib/workspace_edit_uri.dl
import lib/path.dl
import lib/filesystem.dl
import lib/text.dl

function workspace identity {string:candidate} equals or is below {string:directory}:
    execute:
        if candidate = directory:
            return true
        set boundary to the length of directory
        if the length of candidate <= boundary:
            return false
        if candidate lacks directory at offset 0:
            return false
        return the character at boundary in candidate = 47

function workspace identity {string:candidate} is outside {string:directory}:
    execute:
        return (workspace identity candidate equals or is below directory) = false

function the workspace resource identified by {string:identity} in {a pointer to a workspace resource snapshot collection:collection}:
    execute:
        set position to 0
        loop while position < the length of collection:
            set candidate to the workspace resource snapshot at position in collection
            if candidate's activity and candidate's identity = identity:
                return candidate
            set position to (position + 1)
        return 0 as a pointer to a workspace resource snapshot

function the original workspace resource identified by {string:identity} in {a pointer to a workspace resource snapshot collection:collection}:
    execute:
        set position to 0
        loop while position < the length of collection:
            set candidate to the workspace resource snapshot at position in collection
            if candidate's original identity = identity:
                return candidate
            set position to (position + 1)
        return 0 as a pointer to a workspace resource snapshot

function normalize workspace changes from {a pointer to a parsed workspace edit:edit} using {a pointer to a workspace edit context:context} into {a pointer to a workspace edit plan:plan}:
    execute:
        set position to 0
        loop while position < the length of edit's changes and plan is valid:
            set change to the workspace change at index position in edit's changes
            set initial to @intrinsic(
                "construct",
                a normalized workspace change,
                change,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text,
                an empty workspace edit text
            )
            allocate one slot of initial and set normalized to it
            if change's kind = the workspace rename change kind:
                set origin to the normalized workspace file URI for change's old URI inside the root path of context
                set destination to the normalized workspace file URI for change's new URI inside the root path of context
                if origin failed:
                    invalidate plan with (a failed workspace edit result reporting origin's failure reason at change position)
                else if destination failed:
                    invalidate plan with (a failed workspace edit result reporting destination's failure reason at change position)
                else:
                    set the old path of normalized to origin's path
                    set the old identity of normalized to origin's identity
                    set the old relative path of normalized to origin's relative path
                    set the new path of normalized to destination's path
                    set the new identity of normalized to destination's identity
                    set the new relative path of normalized to destination's relative path
            else:
                set target to the normalized workspace file URI for change's uri inside the root path of context
                if target failed:
                    invalidate plan with (a failed workspace edit result reporting target's failure reason at change position)
                else:
                    set the path of normalized to target's path
                    set the identity of normalized to target's identity
                    set the relative path of normalized to target's relative path
            if plan is valid:
                append normalized workspace change normalized to the normalized changes of plan
            else:
                @intrinsic("destroy at", normalized)
                @intrinsic("call", "libc", "free", nothing, normalized)
            set position to (position + 1)

local function snapshot workspace resource at {string:path} identified by {string:identity} with relative path {string:relative} scanning descendants {boolean:recursive} for change {integer:protocol} using {a pointer to a workspace edit context:context} in {a pointer to a workspace edit plan:plan}:
    execute:
        set existing to the original workspace resource identified by identity in the resources of plan
        if existing != (0 as a pointer to a workspace resource snapshot):
            if recursive and existing's disk kind = the workspace directory resource kind:
                if the inverse of existing's descendant scan completion:
                    set existing's descendant scan completion to true
                    snapshot workspace directory descendants of existing for change protocol using context in plan
            @intrinsic("return")
        set entry to the file system entry at path
        if entry lookup failed:
            invalidate plan with (a failed workspace edit result reporting the string form of "Workspace resource could not be inspected" at change protocol)
            @intrinsic("return")
        if entry is a symbolic link:
            invalidate plan with (a failed workspace edit result reporting the string form of "Workspace edit paths may not traverse symbolic links" at change protocol)
            @intrinsic("return")
        if entry has another filesystem kind:
            invalidate plan with (a failed workspace edit result reporting the string form of "Workspace resource must be a regular file or directory" at change protocol)
            @intrinsic("return")
        set kind to 0
        if entry is a regular file:
            set kind to the workspace regular file resource kind
        else if entry is a directory:
            set kind to the workspace directory resource kind
        set contents to an empty workspace edit text
        if entry is a regular file:
            read the file at path and set reading to it
            if reading failed:
                invalidate plan with (a failed workspace edit result reporting the string form of "Workspace file could not be read" at change protocol)
                @intrinsic("return")
            set contents to the contents of reading
        set document to the workspace open document identified by identity in context
        set opened to (document != (0 as a pointer to a workspace open document))
        set exists to (entry was found or opened)
        set category to kind
        set text to contents
        if opened:
            set category to the workspace regular file resource kind
            set text to document's text
        set initial to @intrinsic(
            "construct",
            a workspace resource snapshot,
            true,
            path,
            identity,
            path,
            identity,
            relative,
            protocol as a 32 bit integer,
            entry was found,
            kind,
            contents,
            entry supports modification times,
            entry's modification time,
            entry was found,
            kind,
            exists,
            category,
            text,
            recursive and entry is a directory,
            document,
            opened,
            an empty workspace edit text,
            an empty workspace edit text,
            an empty workspace edit text,
            0,
            0
        )
        allocate one slot of initial and set candidate to it
        if opened:
            set the open path of candidate to document's path
            set the open identity of candidate to document's identity
            set the open text of candidate to document's text
            set the open version of candidate to document's version
            set the virtual version of candidate to document's version
        append workspace resource snapshot candidate to the resources of plan
        if recursive and entry is a directory:
            snapshot workspace directory descendants of candidate for change protocol using context in plan

local function snapshot workspace directory descendants of {a pointer to a workspace resource snapshot:directory} for change {integer:protocol} using {a pointer to a workspace edit context:context} in {a pointer to a workspace edit plan:plan}:
    execute:
        open the directory at directory's original path and set enumeration to it
        if enumeration failed:
            invalidate plan with (a failed workspace edit result reporting the string form of "Workspace directory could not be read" at change protocol)
            @intrinsic("return")
        set reading to true
        loop while reading and plan is valid:
            read the next directory entry from enumeration and set child to it
            if child lookup failed:
                invalidate plan with (a failed workspace edit result reporting the string form of "Workspace directory could not be read" at change protocol)
                set reading to false
            else if child was absent:
                set reading to false
            else:
                set joined to directory's original path joined with child's name using the path style of context
                if joined failed:
                    invalidate plan with (a failed workspace edit result reporting the string form of "Workspace child path could not be normalized" at change protocol)
                else:
                    set relative to the path from joined's value relative to the root path of context using the path style of context
                    if relative failed:
                        invalidate plan with (a failed workspace edit result reporting the string form of "Workspace child path could not be normalized" at change protocol)
                    else:
                        set identity to the workspace identity of joined's value using the path style of context
                        snapshot workspace resource at joined's value identified by identity with relative path relative's value scanning descendants child is a directory for change protocol using context in plan
        set position to 0
        loop while position < the length of the documents of context and plan is valid:
            set document to the workspace open document at index position in the documents of context
            if workspace identity document's identity equals or is below directory's original identity:
                set relative to the path from document's path relative to the root path of context using the path style of context
                if relative failed:
                    invalidate plan with (a failed workspace edit result reporting the string form of "Workspace document path could not be normalized" at change protocol)
                else:
                    snapshot workspace resource at document's path identified by document's identity with relative path relative's value scanning descendants false for change protocol using context in plan
            set position to (position + 1)

local function snapshot workspace ancestors of {string:path} for change {integer:protocol} using {a pointer to a workspace edit context:context} in {a pointer to a workspace edit plan:plan}:
    execute:
        set current to path
        set searching to true
        loop while searching and plan is valid:
            set parent to the parent path of current using the path style of context
            if parent failed:
                invalidate plan with (a failed workspace edit result reporting the string form of "Workspace parent path could not be normalized" at change protocol)
                set searching to false
            else:
                set ancestor to parent's value
                set relative to the path from ancestor relative to the root path of context using the path style of context
                if relative failed:
                    invalidate plan with (a failed workspace edit result reporting the string form of "Workspace parent path could not be normalized" at change protocol)
                    set searching to false
                else:
                    set identity to the workspace identity of ancestor using the path style of context
                    snapshot workspace resource at ancestor identified by identity with relative path relative's value scanning descendants false for change protocol using context in plan
                    if identity = the workspace identity of the root path of context using the path style of context:
                        set searching to false
                    else:
                        set current to ancestor

function snapshot normalized workspace changes using {a pointer to a workspace edit context:context} in {a pointer to a workspace edit plan:plan}:
    execute:
        set position to 0
        loop while position < the length of the normalized changes of plan and plan is valid:
            set entry to the normalized workspace change at position in the normalized changes of plan
            set request to entry's source change
            if request's kind = the workspace rename change kind:
                snapshot workspace resource at entry's old path identified by entry's old identity with relative path entry's old relative path scanning descendants true for change position using context in plan
                if plan is valid:
                    snapshot workspace resource at entry's new path identified by entry's new identity with relative path entry's new relative path scanning descendants true for change position using context in plan
                if plan is valid:
                    snapshot workspace ancestors of entry's new path for change position using context in plan
            else:
                set recursive to (request's kind = the workspace delete change kind)
                snapshot workspace resource at entry's path identified by entry's identity with relative path entry's relative path scanning descendants recursive for change position using context in plan
                if plan is valid:
                    snapshot workspace ancestors of entry's path for change position using context in plan
            set position to (position + 1)
