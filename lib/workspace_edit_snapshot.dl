# Normalize all protocol targets and snapshot touched disk resources/open buffers.

import lib/workspace_edit_plan_types.dl
import lib/workspace_edit_uri.dl
import lib/path.dl
import lib/filesystem.dl
import lib/text.dl

function workspace identity {string:candidate_identity} is equal to or below {string:directory_identity}:
    execute:
        if candidate_identity = directory_identity:
            return true
        set prefix_length to the length of directory_identity
        if the length of candidate_identity <= prefix_length:
            return false
        if not candidate_identity has directory_identity at offset 0:
            return false
        return character prefix_length of candidate_identity = 47

function workspace resource with identity {string:requested_identity} in {a pointer to workspace resource snapshot collection:collection}:
    execute:
        set position to 0
        loop while position < the length of collection:
            set resource_value to workspace resource snapshot at position in collection
            if resource_value's active and resource_value's identity = requested_identity:
                return resource_value
            set position to position + 1
        return 0 as a pointer to workspace resource snapshot

function workspace original resource with identity {string:requested_identity} in {a pointer to workspace resource snapshot collection:collection}:
    execute:
        set position to 0
        loop while position < the length of collection:
            set resource_value to workspace resource snapshot at position in collection
            if resource_value's original identity = requested_identity:
                return resource_value
            set position to position + 1
        return 0 as a pointer to workspace resource snapshot

function normalize workspace changes from {a pointer to parsed workspace edit:parsed_value} using {a pointer to workspace edit context:state_value} into {a pointer to workspace edit plan:plan_value}:
    execute:
        set change_index to 0
        loop while change_index < the length of parsed_value's changes and the valid of plan_value:
            set source_value to workspace change at index change_index in parsed_value's changes
            set path_value to an empty workspace edit text
            set identity_value to an empty workspace edit text
            set relative_value to an empty workspace edit text
            set old_path_value to an empty workspace edit text
            set old_identity_value to an empty workspace edit text
            set old_relative_value to an empty workspace edit text
            set new_path_value to an empty workspace edit text
            set new_identity_value to an empty workspace edit text
            set new_relative_value to an empty workspace edit text
            if source_value's kind = the workspace rename change kind:
                set old_result to normalize workspace file URI source_value's old URI inside native root the root path of state_value
                set new_result to normalize workspace file URI source_value's new URI inside native root the root path of state_value
                if not old_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting old_result's failure reason at change change_index)
                else if not new_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting new_result's failure reason at change change_index)
                else:
                    set old_path_value to old_result's path
                    set old_identity_value to old_result's identity
                    set old_relative_value to old_result's relative path
                    set new_path_value to new_result's path
                    set new_identity_value to new_result's identity
                    set new_relative_value to new_result's relative path
            else:
                set target_result to normalize workspace file URI source_value's uri inside native root the root path of state_value
                if not target_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting target_result's failure reason at change change_index)
                else:
                    set path_value to target_result's path
                    set identity_value to target_result's identity
                    set relative_value to target_result's relative path
            if the valid of plan_value:
                set initial_value to @intrinsic(
                    "construct",
                    a normalized workspace change,
                    source_value,
                    path_value,
                    identity_value,
                    relative_value,
                    old_path_value,
                    old_identity_value,
                    old_relative_value,
                    new_path_value,
                    new_identity_value,
                    new_relative_value
                )
                set normalized_value to allocate 1 slots of initial_value
                append normalized workspace change normalized_value to the normalized changes of plan_value
            set change_index to change_index + 1

local function snapshot workspace resource at {string:native_path} with identity {string:native_identity} and relative path {string:relative_value} scanning descendants {boolean:scan_descendants} for change {integer:change_index} using {a pointer to workspace edit context:state_value} in {a pointer to workspace edit plan:plan_value}:
    execute:
        set existing to workspace original resource with identity native_identity in the resources of plan_value
        if existing != (0 as a pointer to workspace resource snapshot):
            if scan_descendants and existing's disk kind = the workspace directory resource kind:
                if not existing's descendants scanned:
                    set the descendants scanned of existing to true
                    snapshot workspace directory descendants of existing for change change_index using state_value in plan_value
            return existing
        set status_value to the file system entry at native_path
        if not status_value's succeeded:
            invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace resource could not be inspected" at change change_index)
            return 0 as a pointer to workspace resource snapshot
        if status_value's symbolic link:
            invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace edit paths may not traverse symbolic links" at change change_index)
            return 0 as a pointer to workspace resource snapshot
        if status_value's other:
            invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace resource must be a regular file or directory" at change change_index)
            return 0 as a pointer to workspace resource snapshot
        set disk_kind_value to 0
        if status_value's regular file:
            set disk_kind_value to the workspace regular file resource kind
        else if status_value's directory:
            set disk_kind_value to the workspace directory resource kind
        set disk_contents to an empty workspace edit text
        if status_value's regular file:
            read native_path
            if not it succeeded:
                invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace file could not be read" at change change_index)
                return 0 as a pointer to workspace resource snapshot
            set disk_contents to the contents of it
        set open_value to workspace open document with identity native_identity in state_value
        set open_present to open_value != (0 as a pointer to workspace open document)
        set virtual_exists to status_value's found or open_present
        set virtual_kind to disk_kind_value
        set virtual_contents to disk_contents
        set open_path_value to an empty workspace edit text
        set open_identity_value to an empty workspace edit text
        set open_text_value to an empty workspace edit text
        set open_version_value to 0
        if open_present:
            set virtual_kind to the workspace regular file resource kind
            set virtual_contents to open_value's text
            set open_path_value to open_value's path
            set open_identity_value to open_value's identity
            set open_text_value to open_value's text
            set open_version_value to open_value's version
        set initial_value to @intrinsic(
            "construct",
            a workspace resource snapshot,
            true,
            native_path,
            native_identity,
            native_path,
            native_identity,
            relative_value,
            change_index as i32,
            status_value's found,
            disk_kind_value,
            disk_contents,
            status_value's modification time supported,
            status_value's modification time,
            status_value's found,
            disk_kind_value,
            virtual_exists,
            virtual_kind,
            virtual_contents,
            scan_descendants and status_value's directory,
            open_value,
            open_present,
            open_path_value,
            open_identity_value,
            open_text_value,
            open_version_value as i32,
            open_version_value as i32
        )
        set resource_value to allocate 1 slots of initial_value
        append workspace resource snapshot resource_value to the resources of plan_value
        if scan_descendants and status_value's directory:
            snapshot workspace directory descendants of resource_value for change change_index using state_value in plan_value
        return resource_value

local function snapshot workspace directory descendants of {a pointer to workspace resource snapshot:directory_value} for change {integer:change_index} using {a pointer to workspace edit context:state_value} in {a pointer to workspace edit plan:plan_value}:
    execute:
        open directory at directory_value's original path
        set enumeration to it
        if not enumeration's succeeded:
            invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace directory could not be read" at change change_index)
            @intrinsic("return")
        set reading to true
        loop while reading and the valid of plan_value:
            read the next directory entry from enumeration
            set next_entry to it
            if not next_entry's succeeded:
                invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace directory could not be read" at change change_index)
                set reading to false
            else if not next_entry's has_entry:
                set reading to false
            else:
                set child_result to join directory_value's original path with next_entry's name using the path style of state_value
                if not child_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace child path could not be normalized" at change change_index)
                else:
                    set relative_result to make path child_result's value relative to base the root path of state_value using the path style of state_value
                    if not relative_result's succeeded:
                        invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace child path could not be normalized" at change change_index)
                    else:
                        set child_identity to workspace identity for native path child_result's value using the path style of state_value
                        set ignored_resource to snapshot workspace resource at child_result's value with identity child_identity and relative path relative_result's value scanning descendants next_entry's directory for change change_index using state_value in plan_value
        set document_index to 0
        loop while document_index < the length of the documents of state_value and the valid of plan_value:
            set document_value to workspace open document at index document_index in the documents of state_value
            if workspace identity document_value's identity is equal to or below directory_value's original identity:
                set relative_result to make path document_value's path relative to base the root path of state_value using the path style of state_value
                if not relative_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace document path could not be normalized" at change change_index)
                else:
                    set ignored_resource to snapshot workspace resource at document_value's path with identity document_value's identity and relative path relative_result's value scanning descendants false for change change_index using state_value in plan_value
            set document_index to document_index + 1

local function snapshot workspace ancestors of {string:native_path} for change {integer:change_index} using {a pointer to workspace edit context:state_value} in {a pointer to workspace edit plan:plan_value}:
    execute:
        set current_path to native_path
        set searching to true
        loop while searching and the valid of plan_value:
            set parent_result to the parent path of current_path using the path style of state_value
            if not parent_result's succeeded:
                invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace parent path could not be normalized" at change change_index)
                set searching to false
            else:
                set parent_value to parent_result's value
                set relative_result to make path parent_value relative to base the root path of state_value using the path style of state_value
                if not relative_result's succeeded:
                    invalidate workspace edit plan plan_value with (a failed workspace edit result reporting the string form of "Workspace parent path could not be normalized" at change change_index)
                    set searching to false
                else:
                    set parent_identity to workspace identity for native path parent_value using the path style of state_value
                    set ignored_resource to snapshot workspace resource at parent_value with identity parent_identity and relative path relative_result's value scanning descendants false for change change_index using state_value in plan_value
                    if parent_identity = workspace identity for native path the root path of state_value using the path style of state_value:
                        set searching to false
                    else:
                        set current_path to parent_value

function snapshot normalized workspace changes using {a pointer to workspace edit context:state_value} in {a pointer to workspace edit plan:plan_value}:
    execute:
        set change_index to 0
        loop while change_index < the length of the normalized changes of plan_value and the valid of plan_value:
            set normalized_value to normalized workspace change at change_index in the normalized changes of plan_value
            set source_value to normalized_value's source change
            if source_value's kind = the workspace rename change kind:
                set ignored_resource to snapshot workspace resource at normalized_value's old path with identity normalized_value's old identity and relative path normalized_value's old relative path scanning descendants true for change change_index using state_value in plan_value
                if the valid of plan_value:
                    set ignored_resource to snapshot workspace resource at normalized_value's new path with identity normalized_value's new identity and relative path normalized_value's new relative path scanning descendants true for change change_index using state_value in plan_value
                if the valid of plan_value:
                    snapshot workspace ancestors of normalized_value's new path for change change_index using state_value in plan_value
            else:
                set scan_descendants to source_value's kind = the workspace delete change kind
                set ignored_resource to snapshot workspace resource at normalized_value's path with identity normalized_value's identity and relative path normalized_value's relative path scanning descendants scan_descendants for change change_index using state_value in plan_value
                if the valid of plan_value:
                    snapshot workspace ancestors of normalized_value's path for change change_index using state_value in plan_value
            set change_index to change_index + 1
