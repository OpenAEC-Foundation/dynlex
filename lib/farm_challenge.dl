flex function {farm target:target} [needs|need] plowing:
    replacement:
        @intrinsic("set subject", @intrinsic("construct", farm target, @intrinsic("cast", @intrinsic("negate", 1), a farm number), ""))
        @intrinsic("construct", farm condition, @intrinsic("cast", 8, a farm number), @intrinsic("cast", 0, a farm number), @intrinsic("cast", @intrinsic("negate", 1), a farm number), target's identifier, target's area)

flex function {farm target:target} [is|are] ready:
    replacement:
        @intrinsic("set subject", @intrinsic("construct", farm target, @intrinsic("cast", @intrinsic("negate", 1), a farm number), ""))
        @intrinsic("construct", farm condition, @intrinsic("cast", 9, a farm number), @intrinsic("cast", 0, a farm number), @intrinsic("cast", @intrinsic("negate", 1), a farm number), target's identifier, target's area)

flex function {farm target:target} [is|are] hungry:
    replacement:
        @intrinsic("set subject", @intrinsic("construct", farm target, @intrinsic("cast", @intrinsic("negate", 1), a farm number), ""))
        @intrinsic("construct", farm condition, @intrinsic("cast", 10, a farm number), @intrinsic("cast", 0, a farm number), @intrinsic("cast", @intrinsic("negate", 1), a farm number), target's identifier, target's area)

flex function i am carrying {farm item:items}:
    replacement:
        @intrinsic("set subject", @intrinsic("construct", farm item, @intrinsic("cast", @intrinsic("negate", 2), a farm number), @intrinsic("cast", @intrinsic("negate", 1), a farm number)))
        @intrinsic("construct", farm condition, @intrinsic("cast", 11, a farm number), items's identifier, items's amount, @intrinsic("cast", @intrinsic("negate", 2), a farm number), "")

flex function i am not carrying {farm item:items}:
    replacement:
        @intrinsic("set subject", @intrinsic("construct", farm item, @intrinsic("cast", @intrinsic("negate", 2), a farm number), @intrinsic("cast", @intrinsic("negate", 1), a farm number)))
        @intrinsic("construct", farm condition, @intrinsic("cast", 12, a farm number), items's identifier, items's amount, @intrinsic("cast", @intrinsic("negate", 2), a farm number), "")

flex function i am a {farm role:role}:
    replacement:
        @intrinsic("construct", farm condition, @intrinsic("cast", 13, a farm number), role's identifier, @intrinsic("cast", @intrinsic("negate", 1), a farm number), @intrinsic("cast", @intrinsic("negate", 2), a farm number), "")

flex function i can step {farm direction:direction}:
    replacement:
        @intrinsic("construct", farm condition, @intrinsic("cast", 14, a farm number), direction's identifier, @intrinsic("cast", @intrinsic("negate", 1), a farm number), @intrinsic("cast", @intrinsic("negate", 2), a farm number), "")

flex function there are at least {a farm number:count} {farm item:items} in {farm target:target}:
    replacement:
        @intrinsic("construct", farm condition, @intrinsic("cast", 15, a farm number), items's identifier, count, target's identifier, target's area)

flex function there are fewer than {a farm number:count} {farm item:items} in {farm target:target}:
    replacement:
        @intrinsic("construct", farm condition, @intrinsic("cast", 16, a farm number), items's identifier, count, target's identifier, target's area)

flex section if {farm condition:condition}:
    replacement:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", a farm number, 1, "IF|%d|%d|%d|%d|%s\n", condition's identifier, condition's argument, condition's amount, condition's target, condition's area))
        @intrinsic("execute body")
        emit farm "END"

flex section else:
    replacement:
        emit farm "ELSE"
        @intrinsic("execute body")
        emit farm "END"

flex section else if {farm condition:condition}:
    replacement:
        emit farm "ELSE"
        if condition:
            @intrinsic("execute body")
        emit farm "END"

flex section loop forever:
    replacement:
        emit farm "LOOP|-1"
        @intrinsic("execute body")
        emit farm "END"

flex section loop count [time|times]:
    replacement:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", a farm number, 1, "LOOP|%d\n", @intrinsic("cast", count, a farm number)))
        @intrinsic("execute body")
        emit farm "END"
