import lib/std.dl

atomically load {a pointer to a value:address} means: @intrinsic("atomic load", address, "seq_cst")

atomically load relaxed {a pointer to a value:address} means: @intrinsic("atomic load", address, "relaxed")

atomically load acquire {a pointer to a value:address} means: @intrinsic("atomic load", address, "acquire")

function atomically store {a value:value} at {a pointer to a value:address}:
    replacement:
        @intrinsic("atomic store", address, value, "seq_cst")

function atomically store relaxed {a value:value} at {a pointer to a value:address}:
    replacement:
        @intrinsic("atomic store", address, value, "relaxed")

function atomically store release {a value:value} at {a pointer to a value:address}:
    replacement:
        @intrinsic("atomic store", address, value, "release")

atomically exchange {a value:value} at {a pointer to a value:address} means: @intrinsic("atomic exchange", address, value, "seq_cst")

atomically add {a value:value} at {a pointer to a value:address} means: @intrinsic("atomic fetch add", address, value, "seq_cst")

atomically add acquire release {a value:value} at {a pointer to a value:address} means: @intrinsic("atomic fetch add", address, value, "acq_rel")

atomically subtract {a value:value} at {a pointer to a value:address} means: @intrinsic("atomic fetch sub", address, value, "seq_cst")
