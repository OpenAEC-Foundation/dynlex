# Cache data does not import the SVG renderer or its icon catalog.
import lib/graphics.dl

class:
    patterns:
        UI icon texture
    members:
        name as a C string
        logical size as a floating-point number
        texture as a graphics texture
        next as a pointer to UI icon texture

class:
    patterns:
        UI icon cache
    members:
        library as a pointer
        scale as a floating-point number
        first as a pointer to UI icon texture
