# JSON-RPC 2.0 process connection, terminal state, and cleanup.

import lib/json_rpc_framing.dl
import lib/process.dl

class:
    patterns:
        [a|] json rpc connection
    members:
        child as process
        limits as json rpc limits
        state as i32
        input_closed as boolean
        output_ended as boolean
        buffered_output as string
        standard_error as string
        failure_status as i32
        failure_message as string

class:
    patterns:
        [a|] json rpc connection result
    members:
        succeeded as boolean
        connection as a pointer to json rpc connection
        error_message as string

class:
    patterns:
        [a|] json rpc close result
    members:
        succeeded as boolean
        status as i32
        exit_code as i64
        terminated as boolean
        forced as boolean
        standard_error as string
        error_message as string

function [the|] json rpc open state:
    replacement:
        0

function [the|] json rpc peer closed state:
    replacement:
        1

function [the|] json rpc broken state:
    replacement:
        2

function [the|] json rpc closed state:
    replacement:
        3

function {json rpc connection result:result}'s error message:
    replacement:
        @intrinsic("property", result, "error_message")

function {json rpc close result:result}'s error message:
    replacement:
        @intrinsic("property", result, "error_message")

local function failed json rpc connection reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc connection result,
            false,
            0 as a pointer to json rpc connection,
            message
        )

local function successful json rpc connection containing {a pointer to json rpc connection:connection}:
    replacement:
        @intrinsic("construct", a json rpc connection result, true, connection, an empty json rpc error)

function connect json rpc to {process:child} with limits {json rpc limits:limits}:
    execute:
        set limit_validation to validate limits as json rpc limits
        if not limit_validation's succeeded:
            return failed json rpc connection reporting limit_validation's error message
        if not child launched:
            return failed json rpc connection reporting the starting error of child
        set initial_connection to @intrinsic(
            "construct",
            a json rpc connection,
            child,
            limits,
            the json rpc open state,
            false,
            false,
            the string form of "",
            the string form of "",
            the json rpc success status,
            the string form of ""
        )
        set connection to allocate 1 slots of initial_connection
        return successful json rpc connection containing connection

function connect json rpc to {process:child}:
    replacement:
        connect json rpc to child with limits the default json rpc limits

function open a json rpc connection using {process command:command} with limits {json rpc limits:limits}:
    execute:
        set child to launch command
        return connect json rpc to child with limits limits

function open a json rpc connection using {process command:command}:
    replacement:
        open a json rpc connection using command with limits the default json rpc limits

local function break json rpc connection {a pointer to json rpc connection:connection} with status {integer:error_status} reporting {string:message}:
    execute:
        if connection's state != the json rpc broken state:
            set connection's state to the json rpc broken state
            set connection's failure_status to error_status
            set connection's failure_message to message
        return a failed json rpc operation with status connection's failure_status reporting connection's failure_message

local function break json rpc connection {a pointer to json rpc connection:connection} with status {integer:error_status} reporting {cstring:message}:
    execute:
        return break json rpc connection connection with status error_status reporting the string form of message

local function append json rpc standard error {string:contents} to {a pointer to json rpc connection:connection}:
    execute:
        set remaining_capacity to connection's limits's maximum_standard_error_length - the length of connection's standard_error
        if the length of contents <= remaining_capacity:
            set connection's standard_error to connection's standard_error + contents
            return a successful json rpc operation
        if remaining_capacity > 0:
            set prefix to the substring of contents from 0 with length remaining_capacity
            set connection's standard_error to connection's standard_error + prefix
        return break json rpc connection connection with status the json rpc limit exceeded status reporting "JSON-RPC child standard error exceeds its configured limit"

local function drain json rpc standard error from {a pointer to json rpc connection:connection}:
    execute:
        set reading to true
        loop while reading:
            set read_result to read available the standard error of connection's child
            if not read_result's succeeded:
                return break json rpc connection connection with status the json rpc io error status reporting read_result's error message
            if the length of read_result's contents > 0:
                set appended to append json rpc standard error read_result's contents to connection
                if not appended's succeeded:
                    return appended
            else:
                set reading to false
        return a successful json rpc operation

local function append json rpc output {string:contents} to {a pointer to json rpc connection:connection}:
    execute:
        set available to connection's limits's maximum_buffered_output_length - the length of connection's buffered_output
        if the length of contents > available:
            return break json rpc connection connection with status the json rpc limit exceeded status reporting "Buffered JSON-RPC output exceeds its configured limit"
        set connection's buffered_output to connection's buffered_output + contents
        return a successful json rpc operation

local function read more json rpc output using {a pointer to json rpc connection:connection}:
    execute:
        if connection's output_ended:
            return a failed json rpc operation with status the json rpc end of stream status reporting "JSON-RPC stream ended"
        set waiting to true
        loop while waiting:
            set error_result to drain json rpc standard error from connection
            if not error_result's succeeded:
                return error_result
            set read_result to read available the standard output of connection's child
            if not read_result's succeeded:
                return break json rpc connection connection with status the json rpc io error status reporting read_result's error message
            if the length of read_result's contents > 0:
                return append json rpc output read_result's contents to connection
            if read_result's end of stream:
                set connection's output_ended to true
                set final_error_result to drain json rpc standard error from connection
                if not final_error_result's succeeded:
                    return final_error_result
                return a failed json rpc operation with status the json rpc end of stream status reporting "JSON-RPC stream ended"
            set activity to wait for process activity using connection's child with timeout 1000
            if not activity's succeeded:
                return break json rpc connection connection with status the json rpc io error status reporting activity's error message
        return break json rpc connection connection with status the json rpc io error status reporting "JSON-RPC output loop ended unexpectedly"

local function terminal json rpc receive from {a pointer to json rpc connection:connection}:
    execute:
        if connection's state = the json rpc peer closed state:
            return a failed json rpc receive with status the json rpc end of stream status reporting "JSON-RPC stream ended"
        if connection's state = the json rpc broken state:
            return a failed json rpc receive with status connection's failure_status reporting connection's failure_message
        return a failed json rpc receive with status the json rpc io error status reporting "JSON-RPC connection is closed"

function receive a json rpc message from {a pointer to json rpc connection:connection}:
    execute:
        if connection's state != the json rpc open state:
            return terminal json rpc receive from connection
        set receiving to true
        loop while receiving:
            set header to inspect json rpc frame header in connection's buffered_output with connection's limits
            if not header's succeeded:
                set broken to break json rpc connection connection with status header's status reporting header's error message
                return a failed json rpc receive with status broken's status reporting broken's error message
            if not header's complete:
                set read_result to read more json rpc output using connection
                if not read_result's succeeded:
                    if read_result's status = the json rpc end of stream status:
                        if the length of connection's buffered_output = 0:
                            set connection's state to the json rpc peer closed state
                            return terminal json rpc receive from connection
                        set broken to break json rpc connection connection with status the json rpc malformed frame status reporting "JSON-RPC stream ended in a header"
                        return a failed json rpc receive with status broken's status reporting broken's error message
                    return a failed json rpc receive with status read_result's status reporting read_result's error message
            else:
                set required_length to header's header_length + header's payload_length
                if the length of connection's buffered_output < required_length:
                    set read_result to read more json rpc output using connection
                    if not read_result's succeeded:
                        if read_result's status = the json rpc end of stream status:
                            set broken to break json rpc connection connection with status the json rpc malformed frame status reporting "JSON-RPC stream ended in a payload"
                            return a failed json rpc receive with status broken's status reporting broken's error message
                        return a failed json rpc receive with status read_result's status reporting read_result's error message
                else:
                    set payload to the substring of connection's buffered_output from header's header_length with length header's payload_length
                    set utf8_validation to validate payload as utf8
                    if the status of utf8_validation != the text position success status:
                        set message to the string form of "JSON-RPC payload contains invalid UTF-8 at byte "
                        set message to message + the string form of the error byte offset of utf8_validation
                        set broken to break json rpc connection connection with status the json rpc invalid utf8 status reporting message
                        return a failed json rpc receive with status broken's status reporting broken's error message
                    set parsed to parse payload as json
                    if not json parsing succeeded for parsed:
                        set message to the string form of "JSON-RPC payload contains invalid JSON at byte "
                        set message to message + the string form of the json error position in parsed
                        free json result parsed
                        set broken to break json rpc connection connection with status the json rpc invalid json status reporting message
                        return a failed json rpc receive with status broken's status reporting broken's error message
                    set message to the value of parsed
                    if not message is a json object:
                        free json result parsed
                        set broken to break json rpc connection connection with status the json rpc invalid message status reporting "JSON-RPC batches and non-object messages are unsupported"
                        return a failed json rpc receive with status broken's status reporting broken's error message
                    set remaining_length to the length of connection's buffered_output - required_length
                    set connection's buffered_output to the substring of connection's buffered_output from required_length with length remaining_length
                    return a successful json rpc receive containing message
        return terminal json rpc receive from connection

local function write all {string:contents} to json rpc connection {a pointer to json rpc connection:connection}:
    execute:
        set written to 0
        loop while written < the length of contents:
            set remaining to the substring of contents from written with length the length of contents - written
            set result to write remaining to connection's child
            set byte_count to @intrinsic("cast", result's byte count, an integer)
            if byte_count < 0 or byte_count > the length of remaining:
                return break json rpc connection connection with status the json rpc io error status reporting "JSON-RPC write reported an invalid byte count"
            set written to written + byte_count
            if not result's succeeded:
                set message to result's error message
                if written > 0:
                    set message to the string form of "JSON-RPC frame was partially written: " + message
                return break json rpc connection connection with status the json rpc io error status reporting message
            if byte_count = 0:
                return break json rpc connection connection with status the json rpc io error status reporting "JSON-RPC write made no progress"
        return a successful json rpc operation

function send json rpc value {a pointer to json value:value} using {a pointer to json rpc connection:connection}:
    execute:
        if connection's state != the json rpc open state or connection's input_closed:
            return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC input is not open"
        set message_validation to validate outbound json rpc message value
        if not message_validation's succeeded:
            return message_validation
        set payload to the compact json form of value
        if the length of payload > connection's limits's maximum_payload_length:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "JSON-RPC output payload exceeds its configured limit"
        set header to the string form of "Content-Length: "
        set header to header + the string form of the length of payload
        set frame to header + the string form of "\r\n\r\n"
        set frame to frame + payload
        return write all frame to json rpc connection connection

local function new json rpc connection text for {any:input}:
    execute:
        set result to a new json value of kind the json text kind
        set the text of result to the string form of input
        return result

function send json rpc notification {any:method} with {a pointer to json value:parameters} using {a pointer to json rpc connection:connection}:
    execute:
        set message to a new json value of kind the json object kind
        append json member the string form of "jsonrpc" with new json rpc connection text for "2.0" to message
        append json member the string form of "method" with new json rpc connection text for method to message
        append json member the string form of "params" with parameters to message
        set result to send json rpc value message using connection
        store 0 as a pointer to json value into the items of message at 2
        free json value message
        return result

function send json rpc notification {any:method} using {a pointer to json rpc connection:connection}:
    execute:
        set message to a new json value of kind the json object kind
        append json member the string form of "jsonrpc" with new json rpc connection text for "2.0" to message
        append json member the string form of "method" with new json rpc connection text for method to message
        set result to send json rpc value message using connection
        free json value message
        return result

function close [the|] input of {a pointer to json rpc connection:connection}:
    execute:
        if connection's state = the json rpc closed state:
            return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC connection is closed"
        if connection's input_closed:
            return a successful json rpc operation
        set result to close the standard input of connection's child
        if not result's succeeded:
            return break json rpc connection connection with status the json rpc io error status reporting result's error message
        set connection's input_closed to true
        return a successful json rpc operation

local function json rpc close outcome succeeded {boolean:succeeded} with status {integer:status} exit code {64 bit integer:exit_code} terminated {boolean:terminated} forced {boolean:forced} error {string:error_message} for {a pointer to json rpc connection:connection}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc close result,
            succeeded,
            status,
            exit_code,
            terminated,
            forced,
            connection's standard_error,
            error_message
        )

function close json rpc connection {a pointer to json rpc connection:connection}:
    execute:
        if connection's state = the json rpc closed state:
            return json rpc close outcome succeeded true with status the json rpc success status exit code 0 as a 64 bit integer terminated false forced false error an empty json rpc error for connection
        set close_succeeded to true
        set close_status to the json rpc success status
        set close_error to an empty json rpc error
        if not connection's input_closed:
            set input_result to close the input of connection
            if not input_result's succeeded:
                set close_succeeded to false
                set close_status to input_result's status
                set close_error to input_result's error message
        set forced to false
        set status_result to wait up to connection's limits's graceful_close_timeout_milliseconds milliseconds for connection's child
        if not status_result's succeeded:
            set close_succeeded to false
            set close_status to the json rpc io error status
            set close_error to status_result's error message
        if status_result's succeeded and (not status_result's finished):
            set forced to true
            set terminated_result to terminate connection's child
            if not terminated_result's succeeded:
                set close_succeeded to false
                set close_status to the json rpc io error status
                set close_error to terminated_result's error message
            else:
                set status_result to wait up to connection's limits's termination_timeout_milliseconds milliseconds for connection's child
                if not status_result's succeeded:
                    set close_succeeded to false
                    set close_status to the json rpc io error status
                    set close_error to status_result's error message
        set error_result to drain json rpc standard error from connection
        if not error_result's succeeded:
            set close_succeeded to false
            set close_status to error_result's status
            set close_error to error_result's error message
        if status_result's succeeded and status_result's finished:
            if (not forced) and status_result's exit code != (0 as a 64 bit integer):
                set close_succeeded to false
                set close_status to the json rpc child exit error status
                set close_error to the string form of "JSON-RPC child exited unsuccessfully"
        set cleaned to clean up connection's child
        if not cleaned's succeeded:
            return json rpc close outcome succeeded false with status the json rpc io error status exit code status_result's exit code terminated status_result's terminated forced forced error cleaned's error message for connection
        set connection's state to the json rpc closed state
        return json rpc close outcome succeeded close_succeeded with status close_status exit code status_result's exit code terminated status_result's terminated forced forced error close_error for connection

function free json rpc connection {a pointer to json rpc connection:connection}:
    execute:
        set closed to close json rpc connection connection
        if not closed's succeeded and connection's state != the json rpc closed state:
            return closed
        @intrinsic("destroy at", connection)
        @intrinsic("call", "libc", "free", void, connection)
        return closed
