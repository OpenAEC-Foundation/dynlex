# LSP text document synchronization and UTF-16 ranged edits.

import lib/lsp_client.dl
import lib/path.dl
import lib/unicode.dl

local class:
    patterns:
        [an|a|] lsp offset result
    members:
        succeeded as boolean
        position as i32
        error_message as string

local function an empty lsp document text:
    replacement:
        the string form of ""

local function lsp document index for {string:document_uri} in {a pointer to lsp client:state}:
    execute:
        set documents to state's documents
        set cursor to 0
        loop while cursor < the length of documents:
            set document_state to @intrinsic("cast", item cursor of documents, a pointer to lsp document)
            if document_state's uri = document_uri:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function lsp document pointer at {integer:index} in {a pointer to lsp client:state}:
    execute:
        set documents to state's documents
        return @intrinsic("cast", item index of documents, a pointer to lsp document)

function lsp document uri {any:document_uri} in {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        set document_index to lsp document index for uri_text in state
        if document_index < 0:
            return @intrinsic(
                "construct",
                an lsp document result,
                false,
                uri_text,
                an empty lsp document text,
                an empty lsp document text,
                0
            )
        set document_state to lsp document pointer at document_index in state
        return @intrinsic(
            "construct",
            an lsp document result,
            true,
            document_state's uri,
            document_state's language_id,
            document_state's text,
            document_state's version
        )

local function send lsp document change {a pointer to json value:change_node} for {a pointer to lsp document:document_state} at version {integer:document_version} using {a pointer to lsp client:state}:
    execute:
        set document_uri to document_state's uri
        set parameters to lsp did change parameters for uri document_uri version document_version containing change_node
        set session to state's rpc_session
        set sent to send json rpc session notification "textDocument/didChange" with parameters using session
        free json value parameters
        return sent

local function lsp replacement change for {string:original_text} with {string:replacement_text}:
    execute:
        set scanned to scan lines in original_text
        set line_map to the line index of scanned
        set final_line to (the number of lines in line_map) - 1
        set start_result to line start for line final_line in line_map
        set end_result to line content end for line final_line in line_map
        set line_start to start_result's position
        set line_end to end_result's position
        set final_line_text to the substring of original_text from line_start with length line_end - line_start
        set converted to utf8 byte offset the length of final_line_text to utf16 position in final_line_text
        set final_character to converted's position
        free line index line_map
        return lsp ranged content change from line 0 character 0 to line final_line character final_character with text replacement_text

function open lsp document uri {any:document_uri} with language {any:language_id} and text {any:contents} using {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        set language_text to the string form of language_id
        set document_text to the string form of contents
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        if lsp document index for uri_text in state >= 0:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document is already open"
        set uri_is_valid to uri_text is valid utf8
        set language_is_valid to language_text is valid utf8
        set text_is_valid to document_text is valid utf8
        if (not uri_is_valid) or ((not language_is_valid) or (not text_is_valid)):
            return a failed json rpc operation with status the json rpc invalid utf8 status reporting "LSP document fields must be valid UTF-8"
        if state's synchronization_open_close:
            set parameters to lsp did open parameters for uri uri_text language language_text version 1 text document_text
            set session to state's rpc_session
            set sent to send json rpc session notification "textDocument/didOpen" with parameters using session
            free json value parameters
            if not sent's succeeded:
                return sent
        set initial_document to @intrinsic("construct", an lsp document, uri_text, language_text, document_text, 1)
        set document_state to allocate 1 slots of initial_document
        set documents to state's documents
        append document_state to documents
        return a successful json rpc operation

function open lsp document at native path {any:native_path} with language {any:language_id} and text {any:contents} using {a pointer to lsp client:state}:
    execute:
        set path_text to the string form of native_path
        set uri_result to a file URI from native path path_text
        if not uri_result's succeeded:
            return a failed json rpc operation with status the lsp document error status reporting uri_result's error message
        return open lsp document uri uri_result's value with language language_id and text contents using state

function replace lsp document uri {any:document_uri} with text {any:contents} using {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        set document_text to the string form of contents
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set document_index to lsp document index for uri_text in state
        if document_index < 0:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document is not open"
        if not document_text is valid utf8:
            return a failed json rpc operation with status the json rpc invalid utf8 status reporting "LSP document text must be valid UTF-8"
        set document_state to lsp document pointer at document_index in state
        if document_state's version = 2147483647:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document version is exhausted"
        set next_version to document_state's version + 1
        if state's synchronization_kind = the lsp incremental synchronization kind:
            set change_node to lsp replacement change for document_state's text with document_text
            set sent to send lsp document change change_node for document_state at version next_version using state
            if not sent's succeeded:
                return sent
        else if state's synchronization_kind = the lsp full synchronization kind:
            set change_node to lsp full content change for text document_text
            set sent to send lsp document change change_node for document_state at version next_version using state
            if not sent's succeeded:
                return sent
        set document_state's text to document_text
        set document_state's version to next_version
        return a successful json rpc operation

function save lsp document uri {any:document_uri} using {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set document_index to lsp document index for uri_text in state
        if document_index < 0:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document is not open"
        if not state's synchronization_save:
            return a successful json rpc operation
        set document_state to lsp document pointer at document_index in state
        if state's synchronization_save_include_text:
            set parameters to lsp did save parameters for uri document_state's uri with text document_state's text
        else:
            set parameters to lsp did save parameters for uri document_state's uri
        set session to state's rpc_session
        set sent to send json rpc session notification "textDocument/didSave" with parameters using session
        free json value parameters
        return sent

local function a failed lsp offset reporting {string:error_text}:
    replacement:
        @intrinsic("construct", an lsp offset result, false, 0, error_text)

local function a failed lsp offset reporting {cstring:error_text}:
    execute:
        return a failed lsp offset reporting the string form of error_text

local function a successful lsp offset at {integer:position}:
    replacement:
        @intrinsic("construct", an lsp offset result, true, position, an empty lsp document text)

local function byte offset for lsp line {integer:line_number} character {integer:character_number} in {string:contents}:
    execute:
        if line_number < 0 or character_number < 0:
            return a failed lsp offset reporting "LSP positions must not be negative"
        set scanned to scan lines in contents
        if the status of scanned != the text position success status:
            return a failed lsp offset reporting "LSP document text is not valid UTF-8"
        set line_map to the line index of scanned
        set start_result to line start for line line_number in line_map
        set end_result to line content end for line line_number in line_map
        if the status of start_result != the text position success status or the status of end_result != the text position success status:
            free line index line_map
            return a failed lsp offset reporting "LSP line is outside the document"
        set line_start to start_result's position
        set line_end to end_result's position
        set line_text to the substring of contents from line_start with length line_end - line_start
        set converted to utf16 position character_number to utf8 byte offset in line_text
        free line index line_map
        if the status of converted != the text position success status:
            return a failed lsp offset reporting "LSP character is outside the line or splits a UTF-16 surrogate pair"
        return a successful lsp offset at line_start + converted's position

function edit lsp document uri {any:document_uri} from line {integer:start_line} character {integer:start_character} to line {integer:end_line} character {integer:end_character} with text {any:replacement_text} using {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        set replacement to the string form of replacement_text
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set document_index to lsp document index for uri_text in state
        if document_index < 0:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document is not open"
        if not replacement is valid utf8:
            return a failed json rpc operation with status the json rpc invalid utf8 status reporting "LSP replacement text must be valid UTF-8"
        set document_state to lsp document pointer at document_index in state
        set original_text to document_state's text
        set start_result to byte offset for lsp line start_line character start_character in original_text
        if not start_result's succeeded:
            return a failed json rpc operation with status the lsp document error status reporting start_result's error_message
        set end_result to byte offset for lsp line end_line character end_character in original_text
        if not end_result's succeeded:
            return a failed json rpc operation with status the lsp document error status reporting end_result's error_message
        if start_result's position > end_result's position:
            return a failed json rpc operation with status the lsp document error status reporting "LSP edit range is reversed"
        if document_state's version = 2147483647:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document version is exhausted"
        set prefix to the substring of original_text from 0 with length start_result's position
        set suffix_length to the length of original_text - end_result's position
        set suffix to the substring of original_text from end_result's position with length suffix_length
        set updated_text to prefix + replacement
        set updated_text to updated_text + suffix
        set next_version to document_state's version + 1
        if state's synchronization_kind = the lsp incremental synchronization kind:
            set change_node to lsp ranged content change from line start_line character start_character to line end_line character end_character with text replacement
            set sent to send lsp document change change_node for document_state at version next_version using state
            if not sent's succeeded:
                return sent
        else if state's synchronization_kind = the lsp full synchronization kind:
            set change_node to lsp full content change for text updated_text
            set sent to send lsp document change change_node for document_state at version next_version using state
            if not sent's succeeded:
                return sent
        set document_state's text to updated_text
        set document_state's version to next_version
        return a successful json rpc operation

function close lsp document uri {any:document_uri} using {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set document_index to lsp document index for uri_text in state
        if document_index < 0:
            return a failed json rpc operation with status the lsp document error status reporting "LSP document is not open"
        set document_state to lsp document pointer at document_index in state
        if state's synchronization_open_close:
            set parameters to lsp did close parameters for uri uri_text
            set session to state's rpc_session
            set sent to send json rpc session notification "textDocument/didClose" with parameters using session
            free json value parameters
            if not sent's succeeded:
                return sent
        set documents to state's documents
        remove item document_index from documents
        @intrinsic("destroy at", document_state)
        @intrinsic("call", "libc", "free", void, document_state)
        return a successful json rpc operation
