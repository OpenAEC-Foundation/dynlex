# File URI normalization and native workspace boundary validation.

import lib/workspace_edit_types.dl
import lib/path.dl
import lib/filesystem.dl
import lib/host.dl
import lib/text.dl

local function a failed workspace URI reporting {string:reason}:
    replacement:
        @intrinsic(
            "construct",
            a workspace URI result,
            false,
            an empty workspace edit text,
            an empty workspace edit text,
            an empty workspace edit text,
            false,
            reason
        )

local function a successful workspace URI with {string:path}, identity {string:identity}, relative path {string:relative}, and directory hint {boolean:hint}:
    replacement:
        @intrinsic(
            "construct",
            a workspace URI result,
            true,
            path,
            identity,
            relative,
            hint,
            an empty workspace edit text
        )

local function workspace URI {string:input} has a directory hint:
    execute:
        return (the length of input > 0) and (the character at (the length of input - 1) in input = 47)

function the workspace identity of native path {string:path} using {path style:style}:
    execute:
        if the value of style = the value of the Windows path style:
            return the lowercase form of path
        return path

function the normalized workspace file URI for {string:input} using {path style:style}:
    execute:
        set decoded to the path from input interpreted as a file URI using style
        if decoded failed:
            return a failed workspace URI reporting decoded's error message
        if decoded is unsupported:
            return a failed workspace URI reporting the string form of "File URI conversion is unsupported"
        set normalized to decoded's value lexically normalized using style
        if normalized failed:
            return a failed workspace URI reporting normalized's error message
        set absolute to whether normalized's value is an absolute path using style
        if absolute failed:
            return a failed workspace URI reporting absolute's error message
        if the inverse of absolute's value:
            return a failed workspace URI reporting the string form of "File URI path must be absolute"
        set identity to the workspace identity of native path normalized's value using style
        return a successful workspace URI with normalized's value, identity identity, relative path an empty workspace edit text, and directory hint (workspace URI input has a directory hint)

function the normalized workspace file URI for {C string:input} using {path style:style}:
    execute:
        return the normalized workspace file URI for the string form of input using style

local function {string:path} is outside its workspace boundary:
    execute:
        if path = "..":
            return true
        if path starts with "../":
            return true
        if the length of path >= 3:
            if the character at 0 in path = 46:
                if (the character at 1 in path = 46) and (the character at 2 in path = 92):
                    return true
        return false

function native path {string:path} has a symbolic link ancestor within the workspace using {path style:style}:
    execute:
        set current to path
        set searching to true
        loop while searching:
            set entry to the file system entry at current
            if entry lookup failed:
                return true
            if entry was found and entry is a symbolic link:
                return true
            set parent to the parent path of current using style
            if parent failed:
                return true
            if parent's value = current:
                set searching to false
            else:
                set current to parent's value
        return false

function the normalized workspace file URI for {string:input} inside native root {string:root}:
    execute:
        set native to the native path style
        if (native failed) or (native is unsupported):
            return a failed workspace URI reporting the string form of "Native path style is unsupported"
        set style to native's value
        set boundary to root lexically normalized using style
        if boundary failed:
            return a failed workspace URI reporting boundary's error message
        set absolute to whether boundary's value is an absolute path using style
        if (absolute failed) or (the inverse of absolute's value):
            return a failed workspace URI reporting the string form of "Workspace root must be absolute"
        set normalized to the normalized workspace file URI for input using style
        if normalized failed:
            return normalized
        set relative to the path from normalized's path relative to boundary's value using style
        if relative failed:
            return a failed workspace URI reporting relative's error message
        if the value of relative is outside its workspace boundary:
            return a failed workspace URI reporting the string form of "File URI is outside the workspace"
        if native path normalized's path has a symbolic link ancestor within the workspace using style:
            return a failed workspace URI reporting the string form of "Workspace edit paths may not traverse symbolic links"
        return a successful workspace URI with normalized's path, identity normalized's identity, relative path relative's value, and directory hint normalized's directory hint

function the normalized workspace file URI for {C string:input} inside native root {string:root}:
    execute:
        return the normalized workspace file URI for the string form of input inside native root root
