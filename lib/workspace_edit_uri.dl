# File URI normalization and native workspace boundary validation.

import lib/workspace_edit_types.dl
import lib/path.dl
import lib/filesystem.dl
import lib/host.dl
import lib/text.dl

local function a failed workspace URI reporting {string:reason}:
    replacement:
        @intrinsic(
            "construct",
            a workspace URI result,
            false,
            an empty workspace edit text,
            an empty workspace edit text,
            an empty workspace edit text,
            false,
            reason
        )

local function a successful workspace URI with {string:normalized_path}, identity {string:normalized_identity}, relative path {string:relative}, and directory hint {boolean:directory_hint}:
    replacement:
        @intrinsic(
            "construct",
            a workspace URI result,
            true,
            normalized_path,
            normalized_identity,
            relative,
            directory_hint,
            an empty workspace edit text
        )

local function workspace URI {string:input} has a directory hint:
    execute:
        return the length of input > 0 and character (the length of input - 1) of input = 47

function workspace identity for native path {string:normalized_path} using {path style:path_style}:
    execute:
        if the value of path_style = the value of the Windows path style:
            return the lowercase form of normalized_path
        return normalized_path

function normalize workspace file URI {string:input} using {path style:style}:
    execute:
        set decoded to the path from file URI input using style
        if not decoded's succeeded:
            return a failed workspace URI reporting decoded's error message
        if not decoded's supported:
            return a failed workspace URI reporting the string form of "File URI conversion is unsupported"
        set normalized to lexically normalize decoded's value using style
        if not normalized's succeeded:
            return a failed workspace URI reporting normalized's error message
        set absolute_check to whether path normalized's value is absolute using style
        if not absolute_check's succeeded:
            return a failed workspace URI reporting absolute_check's error message
        if not absolute_check's value:
            return a failed workspace URI reporting the string form of "File URI path must be absolute"
        set identity to workspace identity for native path normalized's value using style
        return a successful workspace URI with normalized's value, identity identity, relative path an empty workspace edit text, and directory hint (workspace URI input has a directory hint)

function normalize workspace file URI {cstring:input} using {path style:style}:
    execute:
        return normalize workspace file URI the string form of input using style

local function workspace path value {string:path_value} is outside its boundary:
    execute:
        if path_value = "..":
            return true
        if path_value starts with "../":
            return true
        if the length of path_value >= 3:
            if character 0 of path_value = 46:
                if character 1 of path_value = 46 and character 2 of path_value = 92:
                    return true
        return false

function workspace native path {string:absolute_path} has a symbolic link ancestor using {path style:path_style}:
    execute:
        set current_path to absolute_path
        set searching to true
        loop while searching:
            set entry_status to inspect filesystem entry at current_path
            if not entry_status's succeeded:
                return true
            if entry_status's found and entry_status's symbolic_link:
                return true
            set parent_result to the parent path of current_path using path_style
            if not parent_result's succeeded:
                return true
            if parent_result's value = current_path:
                set searching to false
            else:
                set current_path to parent_result's value
        return false

function normalize workspace file URI {string:input} inside native root {string:workspace_root}:
    execute:
        set native_style_result to the native path style
        if (not native_style_result's succeeded) or (not native_style_result's supported):
            return a failed workspace URI reporting the string form of "Native path style is unsupported"
        set style to native_style_result's value
        set normalized_root_result to lexically normalize workspace_root using style
        if not normalized_root_result's succeeded:
            return a failed workspace URI reporting normalized_root_result's error message
        set root_absolute to whether path normalized_root_result's value is absolute using style
        if (not root_absolute's succeeded) or (not root_absolute's value):
            return a failed workspace URI reporting the string form of "Workspace root must be absolute"
        set normalized to normalize workspace file URI input using style
        if not normalized's succeeded:
            return normalized
        set relative_result to make path normalized's path relative to base normalized_root_result's value using style
        if not relative_result's succeeded:
            return a failed workspace URI reporting relative_result's error message
        if workspace path value (the value of relative_result) is outside its boundary:
            return a failed workspace URI reporting the string form of "File URI is outside the workspace"
        if workspace native path normalized's path has a symbolic link ancestor using style:
            return a failed workspace URI reporting the string form of "Workspace edit paths may not traverse symbolic links"
        return a successful workspace URI with normalized's path, identity normalized's identity, relative path relative_result's value, and directory hint normalized's directory_hint

function normalize workspace file URI {cstring:input} inside native root {string:workspace_root}:
    execute:
        return normalize workspace file URI the string form of input inside native root workspace_root
