# DynLex Portable Path Library

import lib/std.dl

class:
    patterns:
        [a|] path style
    members:
        value as an integer

class:
    patterns:
        [a|] path result
    members:
        success as a boolean
        value as a string
        error message as a string

class:
    patterns:
        [a|] path truth result
    members:
        success as a boolean
        value as a boolean
        error message as a string

class:
    patterns:
        [a|] native path style result
    members:
        success as a boolean
        support as a boolean
        value as a path style
        error message as a string

class:
    patterns:
        [a|] file URI result
    members:
        success as a boolean
        support as a boolean
        value as a string
        error message as a string

local class:
    patterns:
        [a|] path text
    members:
        data as a pointer to a byte
        length as a word sized integer
        validity as a boolean
        storage as a string

local function {path text:text} is invalid:
    replacement:
        the inverse of text's validity

{path result:result} succeeded means: result's success
{path result:result} failed means: the inverse of result's success
{path truth result:result} succeeded means: result's success
{path truth result:result} failed means: the inverse of result's success
{native path style result:result} succeeded means: result's success
{native path style result:result} failed means: the inverse of result's success
{native path style result:result} is supported means: result's support
{native path style result:result} is unsupported means: the inverse of result's support
{file URI result:result} succeeded means: result's success
{file URI result:result} failed means: the inverse of result's success
{file URI result:result} is supported means: result's support
{file URI result:result} is unsupported means: the inverse of result's support
the POSIX path style means: @intrinsic("construct", a path style, 1 as a 32 bit integer)
the Windows path style means: @intrinsic("construct", a path style, 2 as a 32 bit integer)
to get the native path style:
    set value to 0 as an integer
    set supported to 0 as an integer
    set outcome to @intrinsic(
        "call",
        "dynlex_runtime",
        "dynlex_path_native_style",
        an integer,
        the address of value,
        the address of supported
    )
    set selection to @intrinsic("construct", a path style, value)
    if outcome != 0:
        return @intrinsic(
            "construct",
            a native path style result,
            false,
            supported != 0,
            selection,
            the current path error message
        )
    if supported = 0:
        return @intrinsic(
            "construct",
            a native path style result,
            false,
            false,
            selection,
            the current path error message
        )
    return @intrinsic(
        "construct",
        a native path style result,
        true,
        true,
        selection,
        an empty path string
    )

local function an empty path string:
    execute:
        return the string form of ""

local function a path text for {C string:input}:
    execute:
        set storage to an empty path string
        if input = (0 as a pointer to a byte):
            return @intrinsic(
                "construct",
                a path text,
                input,
                0 as a word sized integer,
                false,
                storage
            )
        return @intrinsic(
            "construct",
            a path text,
            input,
            (the length of input) as a word sized integer,
            true,
            storage
        )

local function a path text for {string:input}:
    execute:
        return @intrinsic(
            "construct",
            a path text,
            the data of input,
            input's length as a word sized integer,
            input is valid,
            input
        )

local function the current path error message:
    execute:
        set length to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_error_message",
            a word sized integer,
            0 as a pointer to a byte,
            0 as a word sized integer
        )
        set text to a new string buffer containing (length as an integer) bytes
        if length > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_path_error_message",
                a word sized integer,
                the data of text,
                length + 1
            )
        return text

local function a successful path result containing value:
    replacement:
        @intrinsic("construct", a path result, true, value, an empty path string)

local function a failed path result reporting message:
    replacement:
        @intrinsic("construct", a path result, false, an empty path string, message)

local function a failed path result:
    replacement:
        a failed path result reporting the current path error message

local function a path operation result for {integer:status} from {a pointer to a byte:data} spanning {word sized integer:length} bytes:
    execute:
        if status != 0:
            deallocate data
            return a failed path result
        set output to a new string buffer containing (length as an integer) bytes
        if length > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "libc",
                "memcpy",
                a pointer to a byte,
                the data of output,
                data,
                length
            )
        deallocate data
        return a successful path result containing output

local function a supported file URI failure reporting {string:message}:
    replacement:
        @intrinsic("construct", a file URI result, false, true, an empty path string, message)

local function an unsupported file URI failure reporting {string:message}:
    replacement:
        @intrinsic("construct", a file URI result, false, false, an empty path string, message)

local function a file URI operation result for {integer:status} with support indicated by {integer:supported} from {a pointer to a byte:data} spanning {word sized integer:length} bytes:
    execute:
        if status != 0:
            deallocate data
            if supported != 0:
                return a supported file URI failure reporting the current path error message
            return an unsupported file URI failure reporting the current path error message
        if supported = 0:
            deallocate data
            return an unsupported file URI failure reporting the current path error message
        set output to a new string buffer containing (length as an integer) bytes
        if length > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "libc",
                "memcpy",
                a pointer to a byte,
                the data of output,
                data,
                length
            )
        deallocate data
        return @intrinsic(
            "construct",
            a file URI result,
            true,
            true,
            output,
            an empty path string
        )

to get left joined with right using {path style:style}:
    set first to a path text for left
    set second to a path text for right
    if first is invalid or second is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call",
        "dynlex_runtime",
        "dynlex_path_binary",
        an integer,
        1,
        style's value,
        first's data,
        first's length,
        second's data,
        second's length,
        the address of data,
        the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the parent path of input using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_unary", an integer,
        2, style's value, prepared's data, prepared's length,
        the address of data, the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the filename of input using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_unary", an integer,
        3, style's value, prepared's data, prepared's length,
        the address of data, the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the base name of input using {path style:style}:
    return the filename of input using style

to get the stem of input using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_unary", an integer,
        4, style's value, prepared's data, prepared's length,
        the address of data, the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the suffix of input using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_unary", an integer,
        5, style's value, prepared's data, prepared's length,
        the address of data, the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the extension of input using {path style:style}:
    return the suffix of input using style

to get whether input is an absolute path using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return @intrinsic(
            "construct",
            a path truth result,
            false,
            false,
            the string form of "Invalid path text"
        )
    set outcome to 0 as an integer
    set status to @intrinsic(
        "call",
        "dynlex_runtime",
        "dynlex_path_is_absolute",
        an integer,
        style's value,
        prepared's data,
        prepared's length,
        the address of outcome
    )
    if status != 0:
        return @intrinsic(
            "construct",
            a path truth result,
            false,
            false,
            the current path error message
        )
    return @intrinsic(
        "construct",
        a path truth result,
        true,
        outcome != 0,
        an empty path string
    )

to get input lexically normalized using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_unary", an integer,
        1, style's value, prepared's data, prepared's length,
        the address of data, the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the path obtained by resolving input against foundation using {path style:style}:
    set prepared to a path text for input
    set basis to a path text for foundation
    if prepared is invalid or basis is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call",
        "dynlex_runtime",
        "dynlex_path_binary",
        an integer,
        2,
        style's value,
        prepared's data,
        prepared's length,
        basis's data,
        basis's length,
        the address of data,
        the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the path from input relative to foundation using {path style:style}:
    set prepared to a path text for input
    set basis to a path text for foundation
    if prepared is invalid or basis is invalid:
        return a failed path result reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set status to @intrinsic(
        "call",
        "dynlex_runtime",
        "dynlex_path_binary",
        an integer,
        3,
        style's value,
        prepared's data,
        prepared's length,
        basis's data,
        basis's length,
        the address of data,
        the address of length
    )
    return a path operation result for status from data spanning length bytes

to get the file URI representing input using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a supported file URI failure reporting the string form of "Invalid path text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set supported to 0 as an integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_file_uri", an integer,
        1, style's value, prepared's data, prepared's length,
        the address of data, the address of length,
        the address of supported
    )
    return a file URI operation result for status with support indicated by supported from data spanning length bytes

to get the path from input interpreted as a file URI using {path style:style}:
    set prepared to a path text for input
    if prepared is invalid:
        return a supported file URI failure reporting the string form of "Invalid file URI text"
    set data to 0 as a pointer to a byte
    set length to 0 as a word sized integer
    set supported to 0 as an integer
    set status to @intrinsic(
        "call", "dynlex_runtime", "dynlex_path_file_uri", an integer,
        2, style's value, prepared's data, prepared's length,
        the address of data, the address of length,
        the address of supported
    )
    return a file URI operation result for status with support indicated by supported from data spanning length bytes

to get the path from {string:input} interpreted as a file URI:
    set conversion to the native path style
    if conversion failed:
        if conversion is supported:
            return a supported file URI failure reporting conversion's error message
        return an unsupported file URI failure reporting conversion's error message
    return the path from input interpreted as a file URI using conversion's value

to get the file URI for {string:input} interpreted as a native path:
    set conversion to the native path style
    if conversion failed:
        if conversion is supported:
            return a supported file URI failure reporting conversion's error message
        return an unsupported file URI failure reporting conversion's error message
    return the file URI representing input using conversion's value
