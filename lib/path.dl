# DynLex Portable Path Library

import lib/std.dl

class:
    patterns:
        [a|] path style
    members:
        value as i32

class:
    patterns:
        [a|] path result
    members:
        succeeded as boolean
        value as string
        error message as string

class:
    patterns:
        [a|] path truth result
    members:
        succeeded as boolean
        value as boolean
        error message as string

class:
    patterns:
        [a|] file URI resolution result
    members:
        succeeded as boolean
        supported as boolean
        path as string
        error as string

local class:
    patterns:
        [a|] path text
    members:
        data as pointer to byte
        length as word sized integer
        valid as boolean
        storage as string

function [the|] POSIX path style:
    replacement:
        @intrinsic("construct", a path style, 1 as a 32 bit integer)

function [the|] Windows path style:
    replacement:
        @intrinsic("construct", a path style, 2 as a 32 bit integer)

function [the|] native path style:
    execute:
        set style_value to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_native_style",
            a 32 bit integer
        )
        return @intrinsic("construct", a path style, style_value)

function [the|] native path style is supported:
    execute:
        return @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_native_style_supported",
            a 32 bit integer
        ) != 0

local function an empty path string:
    execute:
        return the string form of ""

local function a path text for {cstring:input}:
    execute:
        set storage to an empty path string
        if input = (0 as a pointer to byte):
            return @intrinsic(
                "construct",
                a path text,
                input,
                0 as a word sized integer,
                false,
                storage
            )
        return @intrinsic(
            "construct",
            a path text,
            input,
            (the length of input) as a word sized integer,
            true,
            storage
        )

local function a path text for {string:input}:
    execute:
        return @intrinsic(
            "construct",
            a path text,
            the data of input,
            input's length as a word sized integer,
            input is valid,
            input
        )

local function [the|] current path error message:
    execute:
        set message_length to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_error_message",
            a word sized integer,
            0 as a pointer to byte,
            0 as a word sized integer
        )
        set error_text to a new string buffer with length message_length as an integer
        if message_length > 0 as a word sized integer:
            discard @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_path_error_message",
                a word sized integer,
                the data of error_text,
                message_length + 1
            )
        return error_text

local function a successful path result containing result_value:
    replacement:
        @intrinsic("construct", a path result, true, result_value, an empty path string)

local function a failed path result reporting message:
    replacement:
        @intrinsic("construct", a path result, false, an empty path string, message)

local function a failed path result:
    replacement:
        a failed path result reporting the current path error message

local function finish path operation with {integer:status} and {a pointer to byte:native_data} of length {word sized integer:native_length}:
    execute:
        if status != 0:
            @intrinsic("call", "libc", "free", void, native_data)
            return a failed path result
        set output to a new string buffer with length native_length as an integer
        if native_length > 0 as a word sized integer:
            discard @intrinsic(
                "call",
                "libc",
                "memcpy",
                a pointer to byte,
                the data of output,
                native_data,
                native_length
            )
        @intrinsic("call", "libc", "free", void, native_data)
        return a successful path result containing output

function join left with right using {path style:style}:
    execute:
        set prepared_left to a path text for left
        set prepared_right to a path text for right
        if (not prepared_left's valid) or (not prepared_right's valid):
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_binary",
            an integer,
            1,
            style's value,
            prepared_left's data,
            prepared_left's length,
            prepared_right's data,
            prepared_right's length,
            the address of native_data,
            the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [the|] parent path of input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_unary", an integer,
            2, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [the|] filename of input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_unary", an integer,
            3, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [the|] base name of input using {path style:style}:
    execute:
        return the filename of input using style

function [the|] stem of input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_unary", an integer,
            4, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [the|] suffix of input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_unary", an integer,
            5, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [the|] extension of input using {path style:style}:
    execute:
        return the suffix of input using style

function whether path input is absolute using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return @intrinsic(
                "construct",
                a path truth result,
                false,
                false,
                the string form of "Invalid path text"
            )
        set is_absolute to 0 as a 32 bit integer
        set status to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_is_absolute",
            an integer,
            style's value,
            prepared's data,
            prepared's length,
            the address of is_absolute
        )
        if status != 0:
            return @intrinsic(
                "construct",
                a path truth result,
                false,
                false,
                the current path error message
            )
        return @intrinsic(
            "construct",
            a path truth result,
            true,
            is_absolute != 0,
            an empty path string
        )

function lexically normalize input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_unary", an integer,
            1, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function resolve path input against base base_path using {path style:style}:
    execute:
        set prepared_input to a path text for input
        set prepared_base to a path text for base_path
        if (not prepared_input's valid) or (not prepared_base's valid):
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_binary",
            an integer,
            2,
            style's value,
            prepared_input's data,
            prepared_input's length,
            prepared_base's data,
            prepared_base's length,
            the address of native_data,
            the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function make path input relative to base base_path using {path style:style}:
    execute:
        set prepared_input to a path text for input
        set prepared_base to a path text for base_path
        if (not prepared_input's valid) or (not prepared_base's valid):
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_path_binary",
            an integer,
            3,
            style's value,
            prepared_input's data,
            prepared_input's length,
            prepared_base's data,
            prepared_base's length,
            the address of native_data,
            the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [a|the|] file URI for input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid path text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_file_uri", an integer,
            1, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function [a|the|] path from file URI input using {path style:style}:
    execute:
        set prepared to a path text for input
        if not prepared's valid:
            return a failed path result reporting the string form of "Invalid file URI text"
        set native_data to 0 as a pointer to byte
        set native_length to 0 as a word sized integer
        set status to @intrinsic(
            "call", "dynlex_runtime", "dynlex_path_file_uri", an integer,
            2, style's value, prepared's data, prepared's length,
            the address of native_data, the address of native_length
        )
        return finish path operation with status and native_data of length native_length

function resolve file URI {string:input}:
    execute:
        if not the native path style is supported:
            return @intrinsic(
                "construct",
                a file URI resolution result,
                false,
                false,
                an empty path string,
                the string form of "Native path mapping is not available in this environment"
            )
        set result to a path from file URI input using the native path style
        return @intrinsic(
            "construct",
            a file URI resolution result,
            result's succeeded,
            true,
            result's value,
            result's error message
        )

function [a|the|] file URI from native path {string:input}:
    execute:
        if not the native path style is supported:
            return a failed path result reporting the string form of "Native path mapping is not available in this environment"
        return a file URI for input using the native path style
