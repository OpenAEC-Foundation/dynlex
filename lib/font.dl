# DynLex Font Library - TrueType rendering via FreeType + OpenGL

import lib/string.dl
import lib/graphics.dl

# --- FreeType struct definitions ---

# FT_FaceRec — font face metadata
# Mirrors the C struct field-by-field up to 'glyph'
class:
    patterns:
        [an|] FT face
    members:
        face count as a C long integer
        face index as a C long integer
        face flags as a C long integer
        style flags as a C long integer
        glyph count as a C long integer
        family name as a pointer
        style name as a pointer
        fixed size count as an integer
        available sizes as a pointer
        character map count as an integer
        charmaps as a pointer
        generic data as a pointer
        generic finalizer as a pointer
        bounding box minimum x as a C long integer
        bounding box minimum y as a C long integer
        bounding box maximum x as a C long integer
        bounding box maximum y as a C long integer
        units per EM as a 16 bit integer
        ascender as a 16 bit integer
        descender as a 16 bit integer
        height as a 16 bit integer
        maximum horizontal advance as a 16 bit integer
        maximum vertical advance as a 16 bit integer
        underline position as a 16 bit integer
        underline thickness as a 16 bit integer
        glyph as a pointer

# FT_GlyphSlotRec — rendered glyph data
# Mirrors the C struct field-by-field up to 'bitmap_top'
class:
    patterns:
        [an|] FT glyph slot
    members:
        library as a pointer
        face as a pointer
        next as a pointer
        glyph index as an integer
        generic data as a pointer
        generic finalizer as a pointer
        metrics width as a C long integer
        metrics height as a C long integer
        horizontal bearing x as a C long integer
        horizontal bearing y as a C long integer
        horizontal advance as a C long integer
        vertical bearing x as a C long integer
        vertical bearing y as a C long integer
        vertical advance as a C long integer
        linear horizontal advance as a C long integer
        linear vertical advance as a C long integer
        advance x as a C long integer
        advance y as a C long integer
        format as an integer
        padding:
            8
        bitmap rows as an integer
        bitmap width as an integer
        bitmap pitch as an integer
        bitmap buffer as a pointer
        bitmap number of gray levels as a 16 bit integer
        bitmap pixel mode as a byte
        bitmap palette mode as a byte
        bitmap palette as a pointer
        bitmap left as an integer
        bitmap top as an integer

# --- Font loading ---

class:
    patterns:
        [a|] font
    members:
        library as a pointer
        face as a pointer
        texture as an integer

class:
    patterns:
        [a|] FreeType operation status
    members:
        error code as an integer
        operation as a C string

class:
    patterns:
        [a|] font load result
    members:
        typeface as a font
        status as a FreeType operation status

class:
    patterns:
        [a|] font rendering result
    members:
        horizontal position as an integer
        status as a FreeType operation status

class:
    patterns:
        [a|] font color
    members:
        red as an integer
        green as an integer
        blue as an integer

local function a new font using {pointer:library}, {pointer:face} and {integer:texture}:
    replacement:
        @intrinsic("construct", a font, library, face, texture)

local function an empty font:
    execute:
        return a new font using (0 as a pointer to a byte), (0 as a pointer to a byte) and 0

local function a successful FreeType operation status:
    replacement:
        @intrinsic("construct", a FreeType operation status, 0, "")

local function a failed FreeType operation status for {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a FreeType operation status, error, operation)

function {FreeType operation status:status} succeeded:
    replacement:
        status's error code = 0

function {FreeType operation status:status} failed:
    replacement:
        status's error code != 0

local function a successful font load containing {font:typeface}:
    replacement:
        @intrinsic("construct", a font load result, typeface, a successful FreeType operation status)

local function a failed font load in {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a font load result, an empty font, (a failed FreeType operation status for operation with error code error))

local function a failed font load containing {font:typeface} with {FreeType operation status:status}:
    replacement:
        @intrinsic("construct", a font load result, typeface, status)

function {font load result:result} succeeded:
    replacement:
        result's status succeeded

function {font load result:result} failed:
    replacement:
        result's status failed

local function a successful font rendering at horizontal position {integer:horizontal}:
    replacement:
        @intrinsic("construct", a font rendering result, horizontal, a successful FreeType operation status)

local function a failed font rendering at horizontal position {integer:horizontal} in {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a font rendering result, horizontal, (a failed FreeType operation status for operation with error code error))

function {font rendering result:result} succeeded:
    replacement:
        result's status succeeded

function {font rendering result:result} failed:
    replacement:
        result's status failed

function a font color from {a value:red}, {a value:green} and {a value:blue}:
    replacement:
        @intrinsic("construct", a font color, red, green, blue)

local function a failed font load after cleaning up {pointer:library} and {pointer:face} following {C string:operation} with error code {integer:error}:
    execute:
        set typeface to a new font using library, face and 0
        set cleanup to the result of releasing (the address of typeface)
        if cleanup failed:
            return a failed font load containing typeface with cleanup
        return a failed font load in operation with error code error

function the result of loading a font from path at size {a value:size}:
    execute:
        # Initialize FreeType
        set library to 0 as a pointer to a byte
        set error to @intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)
        if error != 0:
            return a failed font load in "FT_Init_FreeType" with error code error

        # Load font face
        set face to 0 as a pointer to a byte
        set error to @intrinsic("call", "freetype", "FT_New_Face", an integer, library, path, 0 as a C long integer, the address of face)
        if error != 0:
            return a failed font load after cleaning up library and face following "FT_New_Face" with error code error

        # Set pixel size
        set error to @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)
        if error != 0:
            return a failed font load after cleaning up library and face following "FT_Set_Pixel_Sizes" with error code error

        # Set up GL state for texture rendering
        @intrinsic("call", "GL", "glPixelStorei", nothing, 3317, 1)

        # Create GL texture
        set texture to 0 as an integer
        @intrinsic("call", "GL", "glGenTextures", nothing, 1, the address of texture)
        @intrinsic("call", "GL", "glBindTexture", nothing, 3553, texture)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10241, 9729)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10240, 9729)
        # Linear filtering samples half a texel beyond a glyph bitmap at the
        # quad edge. Use OpenGL's transparent default border there instead of
        # repeating the opposite glyph edge around its rectangular quad.
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10242, 33069)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10243, 33069)

        return a successful font load containing (a new font using library, face and texture)

# --- Character rendering ---

local function the result of rendering character {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color}:
    execute:
        set face to the face of typeface
        set texture to the texture of typeface

        # Load and render the glyph
        set error to @intrinsic("call", "freetype", "FT_Load_Char", an integer, face, code as a C long integer, 4)
        if error != 0:
            return a failed font rendering at horizontal position horizontal in "FT_Load_Char" with error code error

        # Read glyph slot from the face after loading the character
        set metadata to face as a pointer to an FT face
        set glyph to the glyph of metadata

        # Cast the glyph slot pointer to access its bitmap data
        set slot to glyph as a pointer to an FT glyph slot

        set width to the bitmap width of slot
        set height to the bitmap rows of slot
        set buffer to the bitmap buffer of slot
        set left to the bitmap left of slot
        set top to the bitmap top of slot
        set advance to the advance x of slot

        # Upload bitmap to GL texture
        @intrinsic("call", "GL", "glBindTexture", nothing, 3553, texture)
        @intrinsic("call", "GL", "glTexImage2D", nothing, 3553, 0, 6406, width, height, 0, 6406, 5121, buffer)

        # Set text color
        @intrinsic("call", "GL", "glColor3ub", nothing, color's red, color's green, color's blue)

        # Calculate quad corners
        set west to (horizontal + left)
        set north to (vertical - top)
        set east to (west + width)
        set south to (north + height)

        # Draw textured quad
        @intrinsic("call", "GL", "glBegin", nothing, 7)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 0.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, west, north)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 0.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, east, north)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 1.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, east, south)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 1.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, west, south)
        @intrinsic("call", "GL", "glEnd", nothing)

        # Advance is in 26.6 fixed point, so divide it by 64.
        return a successful font rendering at horizontal position ((horizontal + advance / 64) as an integer)

flex function render {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color}:
    replacement:
        set the subject to the result of rendering character code at x horizontal and y vertical using typeface in color

# --- Text rendering helpers ---

# Enable GL texture state before drawing text
function enable text rendering:
    execute:
        @intrinsic("call", "GL", "glEnable", nothing, 3553)
        @intrinsic("call", "GL", "glEnable", nothing, 3042)
        @intrinsic("call", "GL", "glBlendFunc", nothing, 770, 771)

# Disable GL texture state after drawing text
function disable text rendering:
    execute:
        @intrinsic("call", "GL", "glDisable", nothing, 3553)

# Set font pixel size (call before rendering at a new size)
function the result of setting {font:typeface}'s pixel size to {a value:size}:
    execute:
        set face to the face of typeface
        set error to @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)
        if error != 0:
            return a failed FreeType operation status for "FT_Set_Pixel_Sizes" with error code error
        return a successful FreeType operation status

# --- Number rendering ---

function the result of drawing {a value:number} as a number at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {a value:red}, green {a value:green} and blue {a value:blue}:
    execute:
        enable text rendering
        set cursor to horizontal
        set ink to a font color from red, green and blue
        if number < 10:
            render (number + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
        else if number < 100:
            render (number / 10 + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
            render ((the remainder of number divided by 10) + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
        else:
            render (number / 100 + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
            set remaining to the remainder of number divided by 100
            render (remaining / 10 + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
            render ((the remainder of remaining divided by 10) + 48) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
        disable text rendering
        return a successful font rendering at horizontal position cursor

# --- Text rendering ---

function the result of drawing {a value:message} as text at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {a value:red}, green {a value:green} and blue {a value:blue}:
    execute:
        enable text rendering
        set cursor to horizontal
        set ink to a font color from red, green and blue
        set position to 0
        loop while position < the length of message:
            render (the character at position in message) at x cursor and y vertical using typeface in ink and set rendering to it
            if rendering failed:
                disable text rendering
                return rendering
            set cursor to rendering's horizontal position
            set position to (position + 1)
        disable text rendering
        return a successful font rendering at horizontal position cursor

function the result of releasing {a pointer to a font:typeface}:
    execute:
        set status to a successful FreeType operation status
        if the library of typeface != 0 as a pointer to a byte:
            set error to @intrinsic("call", "freetype", "FT_Done_FreeType", an integer, the library of typeface)
            if error != 0:
                set status to a failed FreeType operation status for "FT_Done_FreeType" with error code error
            else:
                if the texture of typeface != 0:
                    set texture to the texture of typeface
                    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of texture)
                set the library of typeface to 0 as a pointer to a byte
                set the face of typeface to 0 as a pointer to a byte
                set the texture of typeface to 0
        return status
