# DynLex Font Library - TrueType rendering via FreeType + OpenGL

import lib/string.dl
import lib/graphics.dl

# --- FreeType struct definitions ---

# FT_FaceRec — font face metadata
# Mirrors the C struct field-by-field up to 'glyph'
class:
    patterns:
        [an|] FT face
    members:
        face count as a C long integer
        face index as a C long integer
        face flags as a C long integer
        style flags as a C long integer
        glyph count as a C long integer
        family name as a pointer
        style name as a pointer
        fixed size count as an integer
        available sizes as a pointer
        character map count as an integer
        charmaps as a pointer
        generic data as a pointer
        generic finalizer as a pointer
        bounding box minimum x as a C long integer
        bounding box minimum y as a C long integer
        bounding box maximum x as a C long integer
        bounding box maximum y as a C long integer
        units per EM as a 16 bit integer
        ascender as a 16 bit integer
        descender as a 16 bit integer
        height as a 16 bit integer
        maximum horizontal advance as a 16 bit integer
        maximum vertical advance as a 16 bit integer
        underline position as a 16 bit integer
        underline thickness as a 16 bit integer
        glyph as a pointer

# FT_GlyphSlotRec — rendered glyph data
# Mirrors the C struct field-by-field up to 'bitmap_top'
class:
    patterns:
        [an|] FT glyph slot
    members:
        library as a pointer
        face as a pointer
        next as a pointer
        glyph index as an integer
        generic data as a pointer
        generic finalizer as a pointer
        metrics width as a C long integer
        metrics height as a C long integer
        horizontal bearing x as a C long integer
        horizontal bearing y as a C long integer
        horizontal advance as a C long integer
        vertical bearing x as a C long integer
        vertical bearing y as a C long integer
        vertical advance as a C long integer
        linear horizontal advance as a C long integer
        linear vertical advance as a C long integer
        advance x as a C long integer
        advance y as a C long integer
        format as an integer
        padding:
            8
        bitmap rows as an integer
        bitmap width as an integer
        bitmap pitch as an integer
        bitmap buffer as a pointer
        bitmap number of gray levels as a 16 bit integer
        bitmap pixel mode as a byte
        bitmap palette mode as a byte
        bitmap palette as a pointer
        bitmap left as an integer
        bitmap top as an integer

# --- Font loading ---

class:
    patterns:
        [a|] font
    members:
        face as a pointer
        texture as an integer

class:
    patterns:
        [a|] font color
    members:
        red as an integer
        green as an integer
        blue as an integer

function a new font using {pointer:face} and {integer:texture}:
    replacement:
        @intrinsic("construct", a font, face, texture)

function a font color from {a value:red}, {a value:green} and {a value:blue}:
    replacement:
        @intrinsic("construct", a font color, red, green, blue)

function a loaded font from path at size {a value:size}:
    execute:
        # Initialize FreeType
        set library to 0 as a pointer to a byte
        ignore @intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)

        # Load font face
        set face to 0 as a pointer to a byte
        ignore @intrinsic("call", "freetype", "FT_New_Face", an integer, library, path, 0 as a C long integer, the address of face)

        # Set pixel size
        ignore @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)

        # Set up GL state for texture rendering
        @intrinsic("call", "GL", "glPixelStorei", nothing, 3317, 1)

        # Create GL texture
        set texture to 0 as an integer
        @intrinsic("call", "GL", "glGenTextures", nothing, 1, the address of texture)
        @intrinsic("call", "GL", "glBindTexture", nothing, 3553, texture)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10241, 9729)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10240, 9729)
        # Linear filtering samples half a texel beyond a glyph bitmap at the
        # quad edge. Use OpenGL's transparent default border there instead of
        # repeating the opposite glyph edge around its rectangular quad.
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10242, 33069)
        @intrinsic("call", "GL", "glTexParameteri", nothing, 3553, 10243, 33069)

        return a new font using face and texture

# --- Character rendering ---

local function the horizontal position after rendering character {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color}:
    execute:
        set face to the face of typeface
        set texture to the texture of typeface

        # Load and render the glyph
        ignore @intrinsic("call", "freetype", "FT_Load_Char", an integer, face, code as a C long integer, 4)

        # Read glyph slot from the face after loading the character
        set metadata to face as a pointer to an FT face
        set glyph to the glyph of metadata

        # Cast the glyph slot pointer to access its bitmap data
        set slot to glyph as a pointer to an FT glyph slot

        set width to the bitmap width of slot
        set height to the bitmap rows of slot
        set buffer to the bitmap buffer of slot
        set left to the bitmap left of slot
        set top to the bitmap top of slot
        set advance to the advance x of slot

        # Upload bitmap to GL texture
        @intrinsic("call", "GL", "glBindTexture", nothing, 3553, texture)
        @intrinsic("call", "GL", "glTexImage2D", nothing, 3553, 0, 6406, width, height, 0, 6406, 5121, buffer)

        # Set text color
        @intrinsic("call", "GL", "glColor3ub", nothing, color's red, color's green, color's blue)

        # Calculate quad corners
        set west to (horizontal + left)
        set north to (vertical - top)
        set east to (west + width)
        set south to (north + height)

        # Draw textured quad
        @intrinsic("call", "GL", "glBegin", nothing, 7)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 0.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, west, north)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 0.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, east, north)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 1.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, east, south)
        @intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 1.0)
        @intrinsic("call", "GL", "glVertex2i", nothing, west, south)
        @intrinsic("call", "GL", "glEnd", nothing)

        # Advance is in 26.6 fixed point, so divide it by 64.
        return (horizontal + advance / 64) as an integer

flex function render {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color}:
    replacement:
        set the subject to the horizontal position after rendering character code at x horizontal and y vertical using typeface in color

# --- Text rendering helpers ---

# Enable GL texture state before drawing text
function enable text rendering:
    execute:
        @intrinsic("call", "GL", "glEnable", nothing, 3553)
        @intrinsic("call", "GL", "glEnable", nothing, 3042)
        @intrinsic("call", "GL", "glBlendFunc", nothing, 770, 771)

# Disable GL texture state after drawing text
function disable text rendering:
    execute:
        @intrinsic("call", "GL", "glDisable", nothing, 3553)

# Set font pixel size (call before rendering at a new size)
function set {font:typeface}'s pixel size to {a value:size}:
    execute:
        set face to the face of typeface
        ignore @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)

# --- Number rendering ---

function draw {a value:number} as a number at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {a value:red}, green {a value:green} and blue {a value:blue}:
    execute:
        enable text rendering
        set cursor to horizontal
        set ink to a font color from red, green and blue
        if number < 10:
            render (number + 48) at x cursor and y vertical using typeface in ink and set cursor to it
        else if number < 100:
            render (number / 10 + 48) at x cursor and y vertical using typeface in ink and set cursor to it
            render ((the remainder of number divided by 10) + 48) at x cursor and y vertical using typeface in ink and set cursor to it
        else:
            render (number / 100 + 48) at x cursor and y vertical using typeface in ink and set cursor to it
            set remaining to the remainder of number divided by 100
            render (remaining / 10 + 48) at x cursor and y vertical using typeface in ink and set cursor to it
            render ((the remainder of remaining divided by 10) + 48) at x cursor and y vertical using typeface in ink and set cursor to it
        disable text rendering

# --- Text rendering ---

function draw {a value:message} as text at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {a value:red}, green {a value:green} and blue {a value:blue}:
    execute:
        enable text rendering
        set cursor to horizontal
        set ink to a font color from red, green and blue
        set position to 0
        loop while position < the length of message:
            render (the character at position in message) at x cursor and y vertical using typeface in ink and set cursor to it
            set position to (position + 1)
        disable text rendering
