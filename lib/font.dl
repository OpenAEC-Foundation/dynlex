# DynLex Font Library - TrueType rendering through the graphics renderer

import lib/string.dl
import lib/graphics.dl

# --- FreeType struct definitions ---

# FT_FaceRec — font face metadata
# Mirrors the C struct field-by-field up to 'glyph'
class:
    patterns:
        [an|] FT face
    members:
        face count as a C long integer
        face index as a C long integer
        face flags as a C long integer
        style flags as a C long integer
        glyph count as a C long integer
        family name as a pointer
        style name as a pointer
        fixed size count as an integer
        available sizes as a pointer
        character map count as an integer
        charmaps as a pointer
        generic data as a pointer
        generic finalizer as a pointer
        bounding box minimum x as a C long integer
        bounding box minimum y as a C long integer
        bounding box maximum x as a C long integer
        bounding box maximum y as a C long integer
        units per EM as a 16 bit integer
        ascender as a 16 bit integer
        descender as a 16 bit integer
        height as a 16 bit integer
        maximum horizontal advance as a 16 bit integer
        maximum vertical advance as a 16 bit integer
        underline position as a 16 bit integer
        underline thickness as a 16 bit integer
        glyph as a pointer

# FT_GlyphSlotRec — rendered glyph data
# Mirrors the C struct field-by-field up to 'bitmap_top'
class:
    patterns:
        [an|] FT glyph slot
    members:
        library as a pointer
        face as a pointer
        next as a pointer
        glyph index as an integer
        generic data as a pointer
        generic finalizer as a pointer
        metrics width as a C long integer
        metrics height as a C long integer
        horizontal bearing x as a C long integer
        horizontal bearing y as a C long integer
        horizontal advance as a C long integer
        vertical bearing x as a C long integer
        vertical bearing y as a C long integer
        vertical advance as a C long integer
        linear horizontal advance as a C long integer
        linear vertical advance as a C long integer
        advance x as a C long integer
        advance y as a C long integer
        format as an integer
        padding:
            8
        bitmap rows as an integer
        bitmap width as an integer
        bitmap pitch as an integer
        bitmap buffer as a pointer
        bitmap number of gray levels as a 16 bit integer
        bitmap pixel mode as a byte
        bitmap palette mode as a byte
        bitmap palette as a pointer
        bitmap left as an integer
        bitmap top as an integer

# --- Font loading ---

class:
    patterns:
        [a|] font
    members:
        library as a pointer
        face as a pointer
        texture as a graphics texture

class:
    patterns:
        [a|] font operation status
    members:
        error code as an integer
        operation as a C string

class:
    patterns:
        [a|] font load result
    members:
        typeface as a font
        status as a font operation status

class:
    patterns:
        [a|] font rendering result
    members:
        horizontal position as an integer
        status as a font operation status

class:
    patterns:
        [a|] font color
    members:
        red as an integer
        green as an integer
        blue as an integer

local function a new font using {pointer:library}, {pointer:face} and {graphics texture:texture}:
    replacement:
        @intrinsic("construct", a font, library, face, texture)

local function an empty font:
    execute:
        return a new font using (0 as a pointer to a byte), (0 as a pointer to a byte) and an empty graphics texture

local function a successful font operation status:
    replacement:
        @intrinsic("construct", a font operation status, 0, "")

local function a failed font operation status for {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a font operation status, error, operation)

function {font operation status:status} succeeded:
    replacement:
        status's error code = 0

function {font operation status:status} failed:
    replacement:
        status's error code != 0

local function a successful font load containing {font:typeface}:
    replacement:
        @intrinsic("construct", a font load result, typeface, a successful font operation status)

local function a failed font load in {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a font load result, an empty font, (a failed font operation status for operation with error code error))

local function a failed font load containing {font:typeface} with {font operation status:status}:
    replacement:
        @intrinsic("construct", a font load result, typeface, status)

function {font load result:result} succeeded:
    replacement:
        result's status succeeded

function {font load result:result} failed:
    replacement:
        result's status failed

local function a successful font rendering at horizontal position {integer:horizontal}:
    replacement:
        @intrinsic("construct", a font rendering result, horizontal, a successful font operation status)

local function a failed font rendering at horizontal position {integer:horizontal} in {C string:operation} with error code {integer:error}:
    replacement:
        @intrinsic("construct", a font rendering result, horizontal, (a failed font operation status for operation with error code error))

function {font rendering result:result} succeeded:
    replacement:
        result's status succeeded

function {font rendering result:result} failed:
    replacement:
        result's status failed

function a font color from {a value:red}, {a value:green} and {a value:blue}:
    replacement:
        @intrinsic("construct", a font color, red, green, blue)

local function a failed font load after cleaning up {pointer:library} and {pointer:face} following {C string:operation} with error code {integer:error}:
    execute:
        set typeface to a new font using library, face and an empty graphics texture
        set cleanup to the result of releasing (the address of typeface)
        if cleanup failed:
            return a failed font load containing typeface with cleanup
        return a failed font load in operation with error code error

function the result of loading a font from path at size {a value:size} for {pointer:window}:
    execute:
        # Initialize FreeType
        set library to 0 as a pointer to a byte
        set error to @intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)
        if error != 0:
            return a failed font load in "FT_Init_FreeType" with error code error

        # Load font face
        set face to 0 as a pointer to a byte
        set error to @intrinsic("call", "freetype", "FT_New_Face", an integer, library, path, 0 as a C long integer, the address of face)
        if error != 0:
            return a failed font load after cleaning up library and face following "FT_New_Face" with error code error

        # Set pixel size
        set error to @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)
        if error != 0:
            return a failed font load after cleaning up library and face following "FT_Set_Pixel_Sizes" with error code error

        set blank to 0 as a byte
        set resource to @intrinsic("call", "dynlex_graphics", "dynlex_graphics_texture_create_red8", a pointer to a byte, window, 1, 1, the address of blank)
        if resource = 0 as a pointer to a byte:
            return a failed font load after cleaning up library and face following "dynlex_graphics_texture_create_red8" with error code -1
        set texture to @intrinsic("construct", a graphics texture, resource, 1, 1)

        return a successful font load containing (a new font using library, face and texture)

# --- Character rendering ---

local function the result of rendering character {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color} in {graphics frame:frame}:
    execute:
        set face to the face of typeface
        set texture to typeface's texture

        # Load and render the glyph
        set error to @intrinsic("call", "freetype", "FT_Load_Char", an integer, face, code as a C long integer, 4)
        if error != 0:
            return a failed font rendering at horizontal position horizontal in "FT_Load_Char" with error code error

        # Read glyph slot from the face after loading the character
        set metadata to face as a pointer to an FT face
        set glyph to the glyph of metadata

        # Cast the glyph slot pointer to access its bitmap data
        set slot to glyph as a pointer to an FT glyph slot

        set width to the bitmap width of slot
        set height to the bitmap rows of slot
        set buffer to the bitmap buffer of slot
        set left to the bitmap left of slot
        set top to the bitmap top of slot
        set advance to the advance x of slot

        if (width > 0) and (height > 0):
            set status to @intrinsic("call", "dynlex_graphics", "dynlex_graphics_texture_update", an integer, texture's resource, width, height, buffer)
            if status = 0:
                print (the current graphics error message) as a line
                @intrinsic("call", "libc", "abort", nothing)

            set west to (horizontal + left)
            set north to (vertical - top)
            set east to (west + width)
            set south to (north + height)
            draw texture from x west, y north to x east, y south in color red color's red, green color's green and blue color's blue in frame

        # Advance is in 26.6 fixed point, so divide it by 64.
        return a successful font rendering at horizontal position ((horizontal + advance / 64) as an integer)

flex function render {a value:code} at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in {font color:color} in {graphics frame:frame}:
    replacement:
        set the subject to the result of rendering character code at x horizontal and y vertical using typeface in color in frame

# Set font pixel size (call before rendering at a new size)
function the result of setting {font:typeface}'s pixel size to {a value:size}:
    execute:
        set face to the face of typeface
        set error to @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, size as a 32 bit integer)
        if error != 0:
            return a failed font operation status for "FT_Set_Pixel_Sizes" with error code error
        return a successful font operation status

# --- Number rendering ---

function the result of drawing {a value:value} as a number at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {integer:red}, green {integer:green} and blue {integer:blue} in {graphics frame:frame}:
    execute:
        set cursor to horizontal
        set ink to a font color from red, green and blue
        if value < 10:
            render (value + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
        else if value < 100:
            render (value / 10 + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
            render ((the remainder of value divided by 10) + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
        else:
            render (value / 100 + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
            set remaining to the remainder of value divided by 100
            render (remaining / 10 + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
            render ((the remainder of remaining divided by 10) + 48) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
        return a successful font rendering at horizontal position cursor

# --- Text rendering ---

function the result of drawing {a value:message} as text at x {a value:horizontal} and y {a value:vertical} using {font:typeface} in color red {integer:red}, green {integer:green} and blue {integer:blue} in {graphics frame:frame}:
    execute:
        set cursor to horizontal
        set ink to a font color from red, green and blue
        set position to 0
        loop while position < the length of message:
            render (the character at position in message) at x cursor and y vertical using typeface in ink in frame and set rendering to it
            if rendering failed:
                return rendering
            set cursor to rendering's horizontal position
            set position to (position + 1)
        return a successful font rendering at horizontal position cursor

function the result of releasing {a pointer to a font:typeface}:
    execute:
        set status to a successful font operation status
        if the library of typeface != 0 as a pointer to a byte:
            set error to @intrinsic("call", "freetype", "FT_Done_FreeType", an integer, the library of typeface)
            if error != 0:
                set status to a failed font operation status for "FT_Done_FreeType" with error code error
            else:
                release typeface's texture
                set the library of typeface to 0 as a pointer to a byte
                set the face of typeface to 0 as a pointer to a byte
        return status
