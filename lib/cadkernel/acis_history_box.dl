# SPDX-License-Identifier: MPL-2.0
# Box creation path of cadkernel src/acis/history.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# The size maps to SolidHistoryBox.length/width/height; matrix maps to
# SolidHistoryNodeBase.transform. Input is borrowed; the returned body is owned.
import lib/cadkernel/acis_history_frames.dl
import lib/cadkernel/brep_make.dl

class:
    patterns:
        [a|] cad history body result
    members:
        valid as a boolean
        value as a cad body
        failure as an integer

# 1 = InvalidTransform, 2 = InvalidParameters, 3 = Unsupported.
local function the cad history body refusal for {an integer:reason}:
    execute:
        set empty to no cad body
        return @intrinsic("construct", a cad history body result, false, empty's value, reason)

# Native selector 1 projects codec Box; 0 projects Unknown. Other selectors
# are unported and cannot be mistaken for successful reconstruction.
function the cad history rebuilt body for operation {an integer:kind} with box size {cad vector3:size} and transform {a pointer to a list:matrix}:
    execute:
        if kind != 1:
            return the cad history body refusal for 3
        set created to the cad cuboid at (the cad zero vector3) with size size
        if created's valid = false:
            return the cad history body refusal for 2
        set parsed to the cad history placement of matrix
        if parsed's valid = false:
            return the cad history body refusal for 1
        set moved to the cad transformed (created's value) by (parsed's value)
        if moved's valid = false:
            return the cad history body refusal for 1
        return @intrinsic("construct", a cad history body result, true, moved's value, 0)
