        set sideCapacity to ((the length of meshValue's triangles) * 3) as an integer
        set sideTable to a cad pair index with room for sideCapacity entries
        loop triangleIndex from 0 to the length of meshValue's triangles:
            if (triangleIndex < (the length of groupValues)) and (the item at triangleIndex in includedValues):
                set triangleValue to the item at triangleIndex in meshValue's triangles
                if (((triangleValue's first >= 0) and (triangleValue's second >= 0)) and (triangleValue's third >= 0)) and (((triangleValue's first < (the length of meshValue's positions)) and (triangleValue's second < (the length of meshValue's positions))) and (triangleValue's third < (the length of meshValue's positions))):
                    set firstPosition to the item at triangleValue's first in meshValue's positions
                    set secondPosition to the item at triangleValue's second in meshValue's positions
                    set thirdPosition to the item at triangleValue's third in meshValue's positions
                    set geometricResult to the cad normalization of (the cad cross of (the cad difference of secondPosition and firstPosition) and (the cad difference of thirdPosition and firstPosition))
                    if geometricResult's valid:
                        set firstNormal to the cad silhouette normal at triangleValue's first in meshValue otherwise geometricResult's value
                        set secondNormal to the cad silhouette normal at triangleValue's second in meshValue otherwise geometricResult's value
                        set thirdNormal to the cad silhouette normal at triangleValue's third in meshValue otherwise geometricResult's value
                        set firstChange to the cad length of (the cad difference of firstNormal and secondNormal)
                        set secondChange to the cad length of (the cad difference of secondNormal and thirdNormal)
                        set thirdChange to the cad length of (the cad difference of thirdNormal and firstNormal)
                        if ((firstChange > 1e-10) or (secondChange > 1e-10)) or (thirdChange > 1e-10):
                            append (@intrinsic("construct", a cad silhouette triangle, firstPosition, secondPosition, thirdPosition, firstNormal, secondNormal, thirdNormal)) to triangleValues
                        else:
                            set groupValue to the item at triangleIndex in groupValues
                            cad silhouette remember side from firstPosition to secondPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
                            cad silhouette remember side from secondPosition to thirdPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
                            cad silhouette remember side from thirdPosition to firstPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
