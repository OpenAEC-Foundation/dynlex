            set tolerance to 1e-9
        set meshValue to the cad mesh of faceKey in bodyValue with maximum angle maxAngle within tolerance
        return @intrinsic("construct", a cad mesh result, (the cad triangle count of meshValue) > 0, meshValue)

function free cad mesh result {cad mesh result:resultValue}:
