        free sectionValues

function the cad swept surface of {cad planar curve3:profileValue} along {cad planar curve3:pathValue} with maximum angle {a number:requestedAngle}:
    execute:
        if pathValue is cad closed:
            return no cad surface mesh result
        set maxAngle to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
        set closedValue to profileValue is cad closed
        set outlinePoints to cad surface mesh open samples of profileValue within angle maxAngle
        set trackPoints to cad surface mesh open samples of pathValue within angle maxAngle
        if ((the length of outlinePoints) < 2) or ((the length of trackPoints) < 2):
            free outlinePoints
            free trackPoints
