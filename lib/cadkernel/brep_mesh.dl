        set triangleValues to an empty list of a cad silhouette triangle
        set openValues to an empty list of a cad open silhouette side
        set precisionValue to the maximum of requestedPrecision and 1e-12
        set originValue to the cad zero vector3
        if (the length of meshValue's positions) > 0:
