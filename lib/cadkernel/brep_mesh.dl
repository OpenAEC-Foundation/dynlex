    members:
        valid as a boolean
        low as a cad vector2
        high as a cad vector2

function a cad tessellation tolerance with maximum angle {a number:requestedAngle} within {a number:requestedLinear}:
    execute:
        set angleValue to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
        set linearValue to requestedLinear as a 64 bit floating-point number
        if ((linearValue > 0.0) and ((the absolute value of linearValue) <= 1.7976931348623157e308)) = false:
            set linearValue to 1e-9
        return @intrinsic("construct", a cad tessellation tolerance, angleValue, linearValue, false, 0.0, 0, 0, false)

function {cad tessellation tolerance:value} with chordal cad deflection {a number:requestedDeflection}:
    execute:
        set resultValue to value
        set deflectionValue to requestedDeflection as a 64 bit floating-point number
        set resultValue's chordalValid to (deflectionValue > 0.0) and ((the absolute value of deflectionValue) <= 1.7976931348623157e308)
        set resultValue's chordal to deflectionValue
        return resultValue

function {cad tessellation tolerance:value} with {integer:requestedCount} cad isolines:
    execute:
        set resultValue to value
        set countValue to the maximum of requestedCount and 0
        set resultValue's uIsolines to countValue
        set resultValue's vIsolines to countValue
        return resultValue

function {cad tessellation tolerance:value} with {integer:requestedU} cad u isolines and {integer:requestedV} cad v isolines:
    execute:
        set resultValue to value
        set resultValue's uIsolines to the maximum of requestedU and 0
        set resultValue's vIsolines to the maximum of requestedV and 0
        return resultValue

function {cad tessellation tolerance:value} including planar cad isolines {boolean:enabled}:
    execute:
        set resultValue to value
        set resultValue's planarIsolines to enabled
        return resultValue

function free cad edge mesh {cad edge mesh:value}:
    replacement:
        set value to a new (the type of value)

function free cad face polyline {cad face polyline:value}:
    replacement:
        set value to a new (the type of value)

function free cad body wireframe {cad body wireframe:value}:
    replacement:
        set value to a new (the type of value)

function free cad body mesh {cad body mesh:value}:
    replacement:
        set value to a new (the type of value)

local function the cad mesh owned edge {cad edge key:edgeKey} with parameters {a pointer to a list:parameterValues} and positions {a pointer to a list:positionValues}:
    execute:
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad edge mesh, edgeKey, parameterValues, positionValues, storageOwner)

local function the cad mesh owned polyline for {cad face key:faceKey} with positions {a pointer to a list:positionValues}:
    execute:
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad face polyline, faceKey, positionValues, storageOwner)

local function cad mesh edge {cad edge key:edgeKey} is a parameter seam in {cad body:bodyValue}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return false
        set edgeValue to @intrinsic("dereference", edgeNode)
        loop firstIndex from 0 to the length of ((edgeValue's coedges's values)):
            set firstNode to the cad node pointer for (the item at firstIndex in ((edgeValue's coedges's values))) in bodyValue
            if firstNode != (0 as the type of firstNode):
                set firstUse to @intrinsic("dereference", firstNode)
                loop secondIndex from (firstIndex + 1) to the length of ((edgeValue's coedges's values)):
                    set secondNode to the cad node pointer for (the item at secondIndex in ((edgeValue's coedges's values))) in bodyValue
                    if secondNode != (0 as the type of secondNode):
                        set secondUse to @intrinsic("dereference", secondNode)
                        if (firstUse's owner = secondUse's owner) and (firstUse's forward != secondUse's forward):
                            return true
        return false

local function the cad edge mesh of {cad edge key:edgeKey} in {cad body:bodyValue} within angle {a 64 bit floating-point number:maxAngle}:
    execute:
        set parameterValues to an empty list of a 64 bit floating-point number
        set positionValues to an empty list of a cad vector3
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return the cad mesh owned edge edgeKey with parameters parameterValues and positions positionValues
        set edgeValue to @intrinsic("dereference", edgeNode)
        set curveNode to the cad node pointer for edgeValue's curve in bodyValue
        if curveNode = (0 as the type of curveNode):
            return the cad mesh owned edge edgeKey with parameters parameterValues and positions positionValues
        set curveValue to @intrinsic("dereference", curveNode)
        set segmentCount to 1
        if (the length of ((edgeValue's coedges's values))) > 0:
            set segmentCount to the cad mesh divisions of (the item at 0 in ((edgeValue's coedges's values))) in bodyValue within angle maxAngle
        loop sampleIndex from 0 to (segmentCount + 1):
            set unitValue to (sampleIndex as a 64 bit floating-point number) / (segmentCount as a 64 bit floating-point number)
            set parameterValue to edgeValue's startParameter + ((edgeValue's endParameter - edgeValue's startParameter) * unitValue)
            append parameterValue to parameterValues
            append (the cad point on curveValue at parameterValue) to positionValues
        return the cad mesh owned edge edgeKey with parameters parameterValues and positions positionValues

local function the cad mesh chordal radius of {cad edge curve3:curveValue}:
    execute:
        if curveValue's kind = 1:
            return the absolute value of curveValue's circle's radius
        if curveValue's kind = 2:
            set majorValue to the maximum of (the absolute value of curveValue's ellipse's majorRadius) and (the absolute value of curveValue's ellipse's minorRadius)
            set minorValue to the minimum of (the absolute value of curveValue's ellipse's majorRadius) and (the absolute value of curveValue's ellipse's minorRadius)
            if minorValue > 2.2250738585072014e-308:
                return (majorValue * majorValue) / minorValue
        return 0.0

local function the cad mesh chordal radius of {cad surface:surfaceValue}:
    execute:
        if surfaceValue's kind = 1:
            return the absolute value of surfaceValue's cylinder's radius
        if surfaceValue's kind = 2:
            return the absolute value of surfaceValue's cone's radius
        if surfaceValue's kind = 3:
            return the absolute value of surfaceValue's sphere's radius
        if surfaceValue's kind = 4:
            return (the absolute value of surfaceValue's torus's majorRadius) + (the absolute value of surfaceValue's torus's minorRadius)
        return 0.0

local function the cad mesh angle for {cad tessellation tolerance:toleranceValue} at chordal radius {a 64 bit floating-point number:radiusValue}:
    execute:
        if (toleranceValue's chordalValid = false) or (radiusValue <= 2.2250738585072014e-308):
            return toleranceValue's angle
        set ratioValue to (toleranceValue's chordal / radiusValue) clamped between 0.0 and 1.0
        set chordValue to 2.0 * @intrinsic("call", "libc", "acos", a 64 bit floating-point number, 1.0 - ratioValue)
        set chordValue to the maximum of chordValue and 2.220446049250313e-16
        return the minimum of toleranceValue's angle and (the cad sampling angle for chordValue)

local function the cad mesh edge angle of {cad edge key:edgeKey} in {cad body:bodyValue} with tolerance {cad tessellation tolerance:toleranceValue}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return toleranceValue's angle
        set edgeValue to @intrinsic("dereference", edgeNode)
        set curveNode to the cad node pointer for edgeValue's curve in bodyValue
        if curveNode = (0 as the type of curveNode):
            return toleranceValue's angle
        return the cad mesh angle for toleranceValue at chordal radius (the cad mesh chordal radius of @intrinsic("dereference", curveNode))

local function the cad mesh face angle of {cad face key:faceKey} in {cad body:bodyValue} with tolerance {cad tessellation tolerance:toleranceValue}:
    execute:
        set radiusValue to 0.0
        set faceNode to the cad node pointer for faceKey in bodyValue
        if faceNode != (0 as the type of faceNode):
            set faceValue to @intrinsic("dereference", faceNode)
            set surfaceNode to the cad node pointer for faceValue's surface in bodyValue
            if surfaceNode != (0 as the type of surfaceNode):
                set radiusValue to the cad mesh chordal radius of @intrinsic("dereference", surfaceNode)
        set useKeys to the cad face coedges of faceKey in bodyValue
        loop useIndex from 0 to the length of useKeys:
            set useNode to the cad node pointer for (the item at useIndex in useKeys) in bodyValue
            if useNode != (0 as the type of useNode):
                set useValue to @intrinsic("dereference", useNode)
                set edgeNode to the cad node pointer for useValue's edge in bodyValue
                if edgeNode != (0 as the type of edgeNode):
                    set topologyEdgeValue to @intrinsic("dereference", edgeNode)
                    set curveNode to the cad node pointer for topologyEdgeValue's curve in bodyValue
                    if curveNode != (0 as the type of curveNode):
                        set candidateValue to the cad mesh chordal radius of @intrinsic("dereference", curveNode)
                        if (candidateValue >= 0.0) and (candidateValue <= 1.7976931348623157e308):
                            set radiusValue to the maximum of radiusValue and candidateValue
        free useKeys
        return the cad mesh angle for toleranceValue at chordal radius radiusValue

local function the cad analytic cone of {cad face key:faceKey} in {cad body:bodyValue} from {cad mesh:meshValue}:
    execute:
        set absentValue to @intrinsic("construct", a cad analytic cone face result, false, a new cad analytic cone face)
        set faceNode to the cad node pointer for faceKey in bodyValue
        if faceNode = (0 as the type of faceNode):
            return absentValue
        set faceValue to @intrinsic("dereference", faceNode)
        set surfaceNode to the cad node pointer for faceValue's surface in bodyValue
        if surfaceNode = (0 as the type of surfaceNode):
            return absentValue
        set surfaceValue to @intrinsic("dereference", surfaceNode)
        if surfaceValue's kind != 2:
            return absentValue
        set fullRevolution to false
        loop ringIndex from 0 to the length of ((faceValue's loops's values)):
            set loopNode to the cad node pointer for (the item at ringIndex in ((faceValue's loops's values))) in bodyValue
