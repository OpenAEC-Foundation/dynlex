# Sphere creation path of cadkernel src/acis/history.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Radius projects SolidHistorySphere.radius; the borrowed matrix projects
# SolidHistoryNodeBase.transform. A successful result owns its B-rep body.
import lib/cadkernel/acis_history_frames.dl
import lib/cadkernel/brep_make.dl

class:
    patterns:
        [a|] cad history sphere body result
    members:
        valid as a boolean
        value as a cad body
        failure as an integer

# 1 = InvalidTransform, 2 = InvalidParameters. Read value only if valid.
local function the cad history sphere refusal for {an integer:reason}:
    execute:
        set empty to no cad body
        return @intrinsic("construct", a cad history sphere body result, false, empty's value, reason)

# Match finish(make::sphere([0; 3], radius), base.transform): a failed
# primitive wins over a malformed transform; a non-similarity fails later.
function the cad history rebuilt sphere with radius {a 64 bit floating-point number:radius} and transform {a pointer to a list:matrix}:
    execute:
        set created to the cad sphere body at (the cad zero vector3) with radius radius
        if created's valid = false:
            return the cad history sphere refusal for 2
        set parsed to the cad history placement of matrix
        if parsed's valid = false:
            return the cad history sphere refusal for 1
        set moved to the cad transformed (created's value) by (parsed's value)
        if moved's valid = false:
            return the cad history sphere refusal for 1
        return @intrinsic("construct", a cad history sphere body result, true, moved's value, 0)
