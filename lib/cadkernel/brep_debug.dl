        set result to (result + (the string form of ", coedges: ")) + (the cad debug text of (value's coedges))
        set result to (result + (the string form of ", loops: ")) + (the cad debug text of (value's loops))
        set result to (result + (the string form of ", faces: ")) + (the cad debug text of (value's faces))
        set result to (result + (the string form of ", shells: ")) + (the cad debug text of (value's shells))
        set result to (result + (the string form of ", lumps: ")) + (the cad debug text of (value's lumps))
        set result to (result + (the string form of ", surfaces: ")) + (the cad debug text of (value's surfaces))
        set result to (result + (the string form of ", curves: ")) + (the cad debug text of (value's curves))
        set result to (result + (the string form of ", roots: ")) + (the cad debug text of (value's roots))
        set result to (result + (the string form of ", provenance: ")) + (the cad debug text of (value's provenance))
        return result + (the string form of " }")

function the cad debug text of {cad curve2:value}:
    execute:
        if value's kind = 0:
            return the cad debug text of (value's line)
        if value's kind = 1:
            return the cad debug text of (value's circle)
        if value's kind = 2:
            return the cad debug text of (value's arc)
        if value's kind = 3:
            return the cad debug text of (value's ellipse)
        if value's kind = 4:
            return the cad debug text of (value's polyline)
        if value's kind = 5:
            return the cad debug text of (value's nurbs)
        if value's kind = 6:
            return the cad debug text of (value's ray)
        if value's kind = 7:
            return the cad debug text of (value's xline)
        @intrinsic("call", "libc", "abort", nothing)
        return the string form of ""

function the cad debug text of {cad surface:value}:
    execute:
        if value's kind = 0:
            return the cad debug text of (value's plane)
        if value's kind = 1:
            return the cad debug text of (value's cylinder)
        if value's kind = 2:
            return the cad debug text of (value's cone)
        if value's kind = 3:
            return the cad debug text of (value's sphere)
        if value's kind = 4:
            return the cad debug text of (value's torus)
        if value's kind = 5:
            return the cad debug text of (value's nurbs)
        @intrinsic("call", "libc", "abort", nothing)
        return the string form of ""

function the cad debug text of {cad edge curve3:value}:
    execute:
        if value's kind = 0:
            return the cad debug text of (value's line)
        if value's kind = 1:
            return the cad debug text of (value's circle)
        if value's kind = 2:
            return the cad debug text of (value's ellipse)
        if value's kind = 3:
            return the cad debug text of (value's planar)
        if value's kind = 4:
            return the cad debug text of (value's nurbs)
        @intrinsic("call", "libc", "abort", nothing)
        return the string form of ""

function the cad debug text of {cad topology flaw:value}:
    execute:
        if value's kind = 0:
            return (the string form of "DanglingKey: ") + value's message
        if value's kind = 1:
            return (the string form of "BrokenOwnership: ") + value's message
        if value's kind = 2:
            return ((the string form of "EmptyLump(") + (the cad debug text of value's lump)) + (the string form of ")")
        if value's kind = 3:
            return ((the string form of "EmptyShell(") + (the cad debug text of value's shell)) + (the string form of ")")
        if value's kind = 4:
            return ((the string form of "UnboundedFace(") + (the cad debug text of value's face)) + (the string form of ")")
        if value's kind = 5:
            return ((the string form of "DegenerateLoop(") + (the cad debug text of value's ring)) + (the string form of ")")
        if value's kind = 6:
            return ((the string form of "OpenLoop(") + (the cad debug text of value's ring)) + (the string form of ")")
        if value's kind = 7:
            return ((the string form of "UnusedEdge(") + (the cad debug text of value's edge)) + (the string form of ")")
        if value's kind = 8:
            return ((the string form of "NonManifoldEdge(") + (the cad debug text of value's edge)) + (the string form of ")")
        if value's kind = 9:
            return ((the string form of "SameSidedEdge(") + (the cad debug text of value's edge)) + (the string form of ")")
        @intrinsic("call", "libc", "abort", nothing)
        return the string form of ""

