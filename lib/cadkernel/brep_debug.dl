# SPDX-License-Identifier: MPL-2.0
# Structural diagnostics for the native B-rep foundation.
# Returned strings own their bytes. Formatting borrows all geometry and arenas.
# Binary64 scalars use 17 significant digits, including signed zero/non-finites.
# Native field spelling and numeric text are diagnostic, not a serialization ABI.
import lib/cadkernel/brep_topology.dl
import lib/cadkernel/transform2.dl

function the cad debug text of {cad transform2:value}:
    execute:
        set result to (the string form of "Transform2 { xAxis: ") + (the cad debug text of value's xAxis)
        set result to (result + (the string form of ", yAxis: ")) + (the cad debug text of value's yAxis)
        set result to (result + (the string form of ", origin: ")) + (the cad debug text of value's origin)
        return result + (the string form of " }")

function the cad debug text of {floating-point number:value}:
    execute:
        set result to a new string buffer containing 64 bytes
        set count to @intrinsic("variadic call", "libc", "snprintf", an integer, 3, result's data, 64 as a word sized unsigned integer, "%.17g", value as a 64 bit floating-point number)
        if (count < 0) or (count >= 64):
            @intrinsic("call", "libc", "abort", nothing)
        set result's length to count
        return result

function the cad debug text of {integer:value}:
    execute:
        return the string form of value

function the cad debug text of {unsigned integer:value}:
    execute:
        return the string form of value

function the cad debug text of {boolean:value}:
    execute:
        return the string form of value

function the cad debug text of {a pointer to a list:items}:
    execute:
        set result to the string form of "["
        if items != (0 as the type of items):
            loop index from 0 to the length of items:
                if index > 0:
                    set result to result + (the string form of ", ")
                set result to result + (the cad debug text of (the item at index in items))
        return result + (the string form of "]")

function the cad debug text of {cad topology list:items}:
    execute:
        return the cad debug text of items's values

function the cad debug text of {cad source reference:value}:
    execute:
        return ((the string form of "SourceRef(") + (the string form of value's index)) + (the string form of ")")

function the cad debug text of {cad provenance:value}:
    execute:
        if value's kind = 0:
            return the string form of "Synthesized"
        set label to the string form of "Clean("
        if value's kind = 2:
            set label to the string form of "Dirty("
        return (label + (the cad debug text of value's reference)) + (the string form of ")")

function the cad debug text of {cad pcurve result:value}:
    execute:
        if value's valid = false:
            return the string form of "None"
        return ((the string form of "Some(") + (the cad debug text of value's value)) + (the string form of ")")

function the cad debug text of {cad vector2:value}:
    execute:
        set result to the string form of "["
        set result to result + (the cad debug text of value's x)
        set result to result + (the string form of ", ")
        set result to result + (the cad debug text of value's y)
        return result + (the string form of "]")

function the cad debug text of {cad vector3:value}:
