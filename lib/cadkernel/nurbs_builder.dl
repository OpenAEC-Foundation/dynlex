    release:
        set owner to the owner of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                free (the controls of @intrinsic("lifecycle value"))
                free (the knots of @intrinsic("lifecycle value"))
                free (the weights of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, count - 1)

local function cad rational owned curve3 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    execute:
        check cad rational (0 as a pointer to a cad vector3) against (0 as a pointer to the type of (the item at 0 in points))
        check cad rational (0 as a pointer to a 64 bit floating-point number) against (0 as a pointer to the type of (the item at 0 in knots))
        check cad rational (0 as a pointer to a 64 bit floating-point number) against (0 as a pointer to the type of (the item at 0 in weights))
        allocate one slot of 0 and set owner to it
        return @intrinsic("construct", a cad rational curve3, degree, points, knots, weights, owner)
function the cad rational curve3 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    execute:
        return cad rational owned curve3 of degree degree with controls (cad rational copied points), knots (cad rational copied knots) and weights (cad rational copied weights)
function an empty cad rational curve3:
    execute:
        return cad rational owned curve3 of degree 0 with controls (an empty list of a cad vector3), knots (an empty list of a 64 bit floating-point number) and weights (an empty list of a 64 bit floating-point number)
function free cad rational {cad rational curve3:shape}:
    replacement:
        set shape to a new (the type of shape)
function the cad clone of {cad rational curve3:shape}:
    execute:
        return the cad rational curve3 of degree shape's degree with controls shape's controls, knots shape's knots and weights shape's weights
function the cad reverse of {cad rational curve3:shape}:
    execute:
        return cad rational owned curve3 of degree shape's degree with controls (cad rational reversed shape's controls), knots (cad rational reversed knots shape's knots) and weights (cad rational reversed shape's weights)
