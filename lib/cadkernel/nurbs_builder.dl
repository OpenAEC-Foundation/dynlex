# SPDX-License-Identifier: MPL-2.0
# Port of https://github.com/HakanSeven12/cadkernel at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f, src/brep/nurbs_builder.rs.
# Intermediate rational builders deliberately defer geometric validation.
# Constructors borrow and copy input lists. Copies retain read-only storage;
# clone, reverse, lift and translate allocate independent lists. Raw list fields
# are borrowed views: do not mutate or free them. Final curve/surface construction
# uses the existing strict NURBS validators.
import lib/cadkernel/curve2.dl
import lib/cadkernel/nurbs3.dl
import lib/cadkernel/plane.dl

local function check cad rational expected against {the type of expected:actual}:
    execute:
        ignore expected
        ignore actual

local function cad rational copied {a pointer to a list:values}:
    execute:
        set result to an empty list of the type of (the item at 0 in values)
        loop index from 0 to the length of values:
            append (the item at index in values) to result
        return result
local function cad rational reversed {a pointer to a list:values}:
    execute:
        set result to an empty list of the type of (the item at 0 in values)
        loop index from 0 to the length of values:
            append (the item at (((the length of values) - 1) - index) in values) to result
        return result
local function cad rational reversed knots {a pointer to a list:values}:
    execute:
        set result to an empty list of a 64 bit floating-point number
        loop index from 0 to the length of values:
            append (1.0 - (the item at (((the length of values) - 1) - index) in values)) to result
        return result

class:
    patterns:
        [a|] cad rational curve2
    members:
        degree as an integer
        controls
        knots
        weights
        owner as a pointer to an integer
    retain:
        set owner to the owner of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            @intrinsic("store at", owner, (@intrinsic("dereference", owner)) + 1)
    release:
        set owner to the owner of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                free (the controls of @intrinsic("lifecycle value"))
                free (the knots of @intrinsic("lifecycle value"))
                free (the weights of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, count - 1)

local function cad rational owned curve2 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    execute:
        check cad rational (0 as a pointer to a cad vector2) against (0 as a pointer to the type of (the item at 0 in points))
        check cad rational (0 as a pointer to a 64 bit floating-point number) against (0 as a pointer to the type of (the item at 0 in knots))
        check cad rational (0 as a pointer to a 64 bit floating-point number) against (0 as a pointer to the type of (the item at 0 in weights))
        allocate one slot of 0 and set owner to it
        return @intrinsic("construct", a cad rational curve2, degree, points, knots, weights, owner)
function the cad rational curve2 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    execute:
        return cad rational owned curve2 of degree degree with controls (cad rational copied points), knots (cad rational copied knots) and weights (cad rational copied weights)
function an empty cad rational curve2:
    execute:
        return cad rational owned curve2 of degree 0 with controls (an empty list of a cad vector2), knots (an empty list of a 64 bit floating-point number) and weights (an empty list of a 64 bit floating-point number)
function free cad rational {cad rational curve2:shape}:
    replacement:
        set shape to a new (the type of shape)
function the cad clone of {cad rational curve2:shape}:
    execute:
        return the cad rational curve2 of degree shape's degree with controls shape's controls, knots shape's knots and weights shape's weights
function the cad reverse of {cad rational curve2:shape}:
    execute:
        return cad rational owned curve2 of degree shape's degree with controls (cad rational reversed shape's controls), knots (cad rational reversed knots shape's knots) and weights (cad rational reversed shape's weights)
function the cad curve of {cad rational curve2:shape}:
    execute:
        return the strict cad nurbs curve2 of degree shape's degree with controls shape's controls, knots shape's knots and weights shape's weights

