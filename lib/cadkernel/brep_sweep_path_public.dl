# SPDX-License-Identifier: MPL-2.0
# Public open-profile line, straight NURBS and bounded curved NURBS route from pinned
# src/brep/sweep_path.rs at 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
import lib/cadkernel/brep_sweep_path_base.dl
import lib/cadkernel/brep_sweep_path_transport.dl
import lib/cadkernel/brep_sweep_path_patches.dl
import lib/cadkernel/brep_sweep_path_fit.dl
import lib/cadkernel/brep_sweep_path_body.dl
import lib/cadkernel/brep_sweep_path_curved.dl
import lib/cadkernel/brep_sweep.dl
import lib/cadkernel/transform2.dl

class:
    patterns:
        [a|] cad public path frame evaluator
    members:
        piece as a cad path sweep patch piece
        frame as a cad path sweep frame
        startPoint as a cad vector3
        startTangent as a cad vector3

# For this route the path tangent has one direction, so the source's
# curved_transport(frame, piece, span-start, t, false) reduces to moved().
function the cad path sweep fit sample of {cad public path frame evaluator:source} at {a 64 bit floating-point number:parameter}:
    execute:
        set tangent to the cad path sweep patch tangent on source's piece at parameter
        if tangent's valid = false:
            return @intrinsic("construct", a cad path sweep frame result, false, source's frame)
        set point to the cad path sweep patch point on source's piece at parameter
        return the cad path sweep moved frame source's frame from source's startTangent to tangent's value between source's startPoint and point

local function cad public path {a 64 bit floating-point number:value} is finite:
    execute:
        return (the absolute value of value) <= 1.7976931348623157e308

# The bounded route accepts a clamped, monotone straight spline.
# Its exact knot spans are retained for walk and fit.
local function cad public path {cad nurbs curve3:path} is straight from {cad vector3:first} to {cad vector3:last}:
    execute:
        if path's closed:
            return false
        set chord to the cad difference of last and first
        set length to the cad length of chord
        if ((cad public path length is finite) = false) or (length <= 1e-12):
            return false
        set direction to chord cad divided by length
        set previous to 0.0 as a 64 bit floating-point number
        set tolerance to (the maximum of length and 1.0) * (2.220446049250313e-16 * 64.0)
        loop index from 0 to the length of path's controls:
            set point to the item at index in (path's controls)
            set offset to the cad difference of point and first
            set distance to the cad dot of offset and direction
            set normalOffset to the cad difference of offset and (direction scaled by distance)
            if (((the cad length of normalOffset) > tolerance) or (distance < (previous - tolerance))) or (distance > (length + tolerance)):
                return false
            set previous to distance
        return ((the cad distance from first to (the item at 0 in (path's controls))) <= tolerance) and ((the cad distance from last to (the last item of (path's controls))) <= tolerance)

local function the cad public path recentered {cad rational curve2:curve} by {cad vector2:anchor}:
    execute:
        set points to an empty list of a cad vector2
        loop index from 0 to the length of curve's controls:
            append (the cad difference of (the item at index in (curve's controls)) and anchor) to points
        set result to the cad rational curve2 of degree curve's degree with controls points, knots curve's knots and weights curve's weights
        free points
        return result

# The borrowed profile and path are unchanged. Every raw walk/fit list is
# released once, including refusal paths; prepared rational data is managed.
function the cad path sweep sheet of {a pointer to a list:profile} on {cad plane:plane} along {cad nurbs curve3:path} using {cad path sweep options:options}:
    execute:
        if (the length of profile) != 1:
            return no cad body
        if (((cad public path (options's rotation) is finite) = false) or ((cad public path (options's twist) is finite) = false)) or ((cad public path (options's scale) is finite) = false):
            return no cad body
        if ((options's twist != 0.0) or (options's scale != 1.0)) or options's bank:
            return no cad body
        set sourceCurve to the item at 0 in profile
        if (sourceCurve's kind != (cad line curve2 kind)) and (sourceCurve's kind != (cad nurbs curve2 kind)):
            return no cad body
        if sourceCurve's kind = (cad nurbs curve2 kind):
            if sourceCurve's nurbs's owner = (0 as a pointer to an integer):
                return no cad body
            set strictProfile to the strict cad nurbs curve2 of degree sourceCurve's nurbs's degree with controls sourceCurve's nurbs's controls, knots sourceCurve's nurbs's knots and weights sourceCurve's nurbs's weights
            if strictProfile's valid = false:
                return no cad body
        set builtCurve to the cad rational builder of sourceCurve
        if builtCurve's valid = false:
            return no cad body
        set checkedCurve to the cad curve of builtCurve's value
        if checkedCurve's valid = false:
            return no cad body
        set firstUv to the cad point on checkedCurve's value at 0.0
        set lastUv to the cad point on checkedCurve's value at 1.0
        set uvScale to the maximum of (the maximum of (the absolute value of firstUv's x) and (the absolute value of firstUv's y)) and (the maximum of (the absolute value of lastUv's x) and (the absolute value of lastUv's y))
        if (the cad distance from firstUv to lastUv) <= (1e-8 + ((the maximum of uvScale and 1.0) * 2.220446049250313e-16 * 64.0)):
            return no cad body
        if path's owner = (0 as a pointer to an integer):
            return no cad body
        if path's closed:
            return no cad body
        set strictPath to the strict cad nurbs curve3 of degree path's degree with controls path's controls, knots path's knots and weights path's weights
        if strictPath's valid = false:
            return no cad body
        set domain to the cad domain of strictPath's value
        set startKnot to domain's start
        set endKnot to domain's end
        set uniqueKnots to an empty list of a 64 bit floating-point number
        loop index from 0 to the length of strictPath's value's knots:
            set knot to the item at index in (strictPath's value's knots)
            if (knot >= startKnot) and (knot <= endKnot):
                if (the length of uniqueKnots) = 0:
                    append knot to uniqueKnots
                else if (the absolute value of (knot - (the last item of uniqueKnots))) > 1e-14:
                    append knot to uniqueKnots
        if (the length of uniqueKnots) < 2:
            free uniqueKnots
            return no cad body
        set firstPiece to the cad path sweep patch spline strictPath's value from knot (the item at 0 in uniqueKnots) to (the item at 1 in uniqueKnots)
        set pieces to a list containing firstPiece
        loop span from 1 to ((the length of uniqueKnots) - 1):
            append (the cad path sweep patch spline strictPath's value from knot (the item at span in uniqueKnots) to (the item at (span + 1) in uniqueKnots)) to pieces
        free uniqueKnots
        set pathStart to the cad path sweep patch point on firstPiece at 0.0
        set pathEnd to the cad path sweep patch point on (the last item of pieces) at 1.0
        if (cad public path strictPath's value is straight from pathStart to pathEnd) = false:
            free pieces
            return the cad curved path sweep sheet of profile on plane along path using options
        set sources to a list containing profile
        set base to @intrinsic("construct", a cad path sweep point result, true, options's basePoint)
        if options's hasBasePoint = false:
            set base to the cad path sweep profile base of sources on plane
        if base's valid = false:
            free sources
            free pieces
            return no cad body
        # A straight monotone span has the chord as its directed path head.
        set endpoints to a list containing pathStart
        append pathEnd to endpoints
        set placement to the cad path sweep placement of sources on plane along points endpoints closed false using options
        free endpoints
        free sources
        if placement's valid = false:
            free pieces
            return no cad body
        set projected to the cad projection of base's value onto plane
        if projected's valid = false:
            free pieces
            return no cad body
        set anchorPoint to the cad point at projected's value on plane
        set firstFrame to a cad path sweep frame at (the cad image of anchorPoint under placement's value) with x (the cad direction of plane's xAxis under placement's value) and y (the cad direction of plane's yAxis under placement's value)
        set tangent to the cad path sweep patch tangent on firstPiece at 0.0
        set normal to the cad normalization of (the cad cross of firstFrame's xAxis and firstFrame's yAxis)
        if (tangent's valid = false) or (normal's valid = false):
            free pieces
            return no cad body
        set outward to (the cad dot of normal's value and tangent's value) >= 0.0
        set radius to 1.0 as a 64 bit floating-point number
        loop index from 0 to the length of builtCurve's value's controls:
            set control to the item at index in (builtCurve's value's controls)
            set world to the cad point at control on plane
            set distance to the cad distance from world to base's value
            if distance > radius:
                set radius to distance
        set extent to 0.0 as a 64 bit floating-point number
        loop pieceIndex from 0 to the length of pieces:
            set pieceLength to the cad path sweep patch length of (the item at pieceIndex in pieces) to 1.0
            if ((cad public path pieceLength is finite) = false) or (pieceLength <= 1e-12):
                free pieces
                return no cad body
            set extent to extent + pieceLength
        if ((cad public path extent is finite) = false) or (extent <= 1e-12):
            free pieces
            return no cad body
        set walked to the cad path sweep patch walk of pieces starting firstFrame bank false
        if walked's valid = false:
            release cad path sweep patch walk walked
            free pieces
            return no cad body
        set allPatches to an empty list of a cad path sweep cubic patch
        loop pieceIndex from 0 to the length of pieces:
            set piece to the item at pieceIndex in pieces
            set section to the item at pieceIndex in walked's sections
            loop span from 0 to ((the length of section's parameters) - 1):
                set from to the item at span in section's parameters
                set to to the item at (span + 1) in section's parameters
                set frame to the item at span in section's frames
                set startPoint to the cad path sweep patch point on piece at from
                set startTangent to the cad path sweep patch tangent on piece at from
                if startTangent's valid = false:
                    free allPatches
                    release cad path sweep patch walk walked
                    free pieces
                    return no cad body
                set evaluator to @intrinsic("construct", a cad public path frame evaluator, piece, frame, startPoint, startTangent's value)
                set fitted to the cad path sweep fit of evaluator from from to to at radius radius within tolerance ((the maximum of extent and radius) * 1e-7)
                if fitted's valid = false:
                    release cad path sweep fit fitted
                    free allPatches
                    release cad path sweep patch walk walked
                    free pieces
                    return no cad body
                loop patchIndex from 0 to the length of fitted's patches:
                    set candidate to the item at patchIndex in fitted's patches
                    if (the length of allPatches) > 0:
                        set prior to the last item of allPatches
                        if (the cad path sweep patch frame error between prior's last and candidate's first at radius radius) > ((the maximum of extent and radius) * 1e-6):
                            release cad path sweep fit fitted
                            free allPatches
                            release cad path sweep patch walk walked
                            free pieces
                            return no cad body
                        set candidate's first to prior's last
                    append candidate to allPatches
                release cad path sweep fit fitted
        set shiftedCurve to the cad public path recentered builtCurve's value by projected's value
        set rationalCurves to a list containing shiftedCurve
        set prepared to a cad path sweep prepared wire from rationalCurves closed false
        set preparedWires to a list containing prepared
        set assembled to the cad path sweep body from preparedWires with patches allPatches sheet true closed path false outward outward
        free preparedWires
        free rationalCurves
        free allPatches
        release cad path sweep patch walk walked
        free pieces
        return assembled

# Rust's ordinary Line path takes the analytic extrude_surface branch.
function the cad path sweep sheet of {a pointer to a list:profile} on {cad plane:plane} from {cad vector3:start} to {cad vector3:finish} using {cad path sweep options:options}:
    execute:
        if (the length of profile) != 1:
            return no cad body
        if (((cad public path (options's rotation) is finite) = false) or ((cad public path (options's twist) is finite) = false)) or ((cad public path (options's scale) is finite) = false):
            return no cad body
        if ((options's twist != 0.0) or (options's scale != 1.0)) or options's bank:
            return no cad body
        set sourceCurve to the item at 0 in profile
        if (sourceCurve's kind != (cad line curve2 kind)) and (sourceCurve's kind != (cad nurbs curve2 kind)):
            return no cad body
        if sourceCurve's kind = (cad nurbs curve2 kind):
            if sourceCurve's nurbs's owner = (0 as a pointer to an integer):
                return no cad body
            set strictProfile to the strict cad nurbs curve2 of degree sourceCurve's nurbs's degree with controls sourceCurve's nurbs's controls, knots sourceCurve's nurbs's knots and weights sourceCurve's nurbs's weights
            if strictProfile's valid = false:
                return no cad body
        set builtCurve to the cad rational builder of sourceCurve
        if builtCurve's valid = false:
            return no cad body
        set checkedCurve to the cad curve of builtCurve's value
        if checkedCurve's valid = false:
            return no cad body
        set firstUv to the cad point on checkedCurve's value at 0.0
        set lastUv to the cad point on checkedCurve's value at 1.0
        set uvScale to the maximum of (the maximum of (the absolute value of firstUv's x) and (the absolute value of firstUv's y)) and (the maximum of (the absolute value of lastUv's x) and (the absolute value of lastUv's y))
        if (the cad distance from firstUv to lastUv) <= (1e-8 + ((the maximum of uvScale and 1.0) * 2.220446049250313e-16 * 64.0)):
            return no cad body
        set direction to the cad difference of finish and start
        set extent to the cad length of direction
        if ((cad public path extent is finite) = false) or (extent <= 1e-12):
            return no cad body
        set sources to a list containing profile
        set base to @intrinsic("construct", a cad path sweep point result, true, options's basePoint)
        if options's hasBasePoint = false:
            set base to the cad path sweep profile base of sources on plane
        if base's valid = false:
            free sources
            return no cad body
        set endpoints to a list containing start
        append finish to endpoints
        set placement to the cad path sweep placement of sources on plane along points endpoints closed false using options
        free endpoints
        free sources
        if placement's valid = false:
            return no cad body
        set projected to the cad projection of base's value onto plane
        if projected's valid = false:
            return no cad body
        set offset to the cad difference of (the cad zero vector2) and projected's value
        set transformed to the cad transformed sourceCurve by (a cad translation2 by offset)
        if transformed's valid = false:
            return no cad body
        set anchorPoint to the cad point at projected's value on plane
        set firstPlane to a cad plane with origin (the cad image of anchorPoint under placement's value), x axis (the cad direction of plane's xAxis under placement's value) and y axis (the cad direction of plane's yAxis under placement's value)
        set shiftedProfile to a list containing transformed's value
        set assembled to the cad extrusion sheet of shiftedProfile on firstPlane along direction
        free shiftedProfile
        return assembled
