# SPDX-License-Identifier: MPL-2.0
# Torus creation path of cadkernel src/acis/history.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Radii project SolidHistoryTorus; the borrowed matrix projects its base
# transform. A successful result owns its B-rep body.
import lib/cadkernel/acis_history_frames.dl
import lib/cadkernel/brep_make.dl

class:
    patterns:
        [a|] cad history torus body result
    members:
        valid as a boolean
        value as a cad body
        failure as an integer

# 1 = InvalidTransform, 2 = InvalidParameters. Read value only if valid.
local function the cad history torus refusal for {an integer:reason}:
    execute:
        set empty to no cad body
        return @intrinsic("construct", a cad history torus body result, false, empty's value, reason)

# Match finish(make::torus([0; 3], major_radius, minor_radius), base.transform).
# Construction runs before placement parsing, including for horn and spindle.
function the cad history rebuilt torus with major radius {a 64 bit floating-point number:majorRadius}, minor radius {a 64 bit floating-point number:minorRadius} and transform {a pointer to a list:matrix}:
    execute:
        set created to the cad torus at (the cad zero vector3) with major radius majorRadius and minor radius minorRadius
        if created's valid = false:
            return the cad history torus refusal for 2
        set parsed to the cad history placement of matrix
        if parsed's valid = false:
            return the cad history torus refusal for 1
        set moved to the cad transformed (created's value) by (parsed's value)
        if moved's valid = false:
            return the cad history torus refusal for 1
        return @intrinsic("construct", a cad history torus body result, true, moved's value, 0)
