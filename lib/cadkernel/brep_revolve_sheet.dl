# Sheet revolution from cadkernel src/brep/sweep.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
import lib/cadkernel/brep_result.dl
import lib/cadkernel/brep_profile.dl
import lib/cadkernel/brep_append.dl
import lib/cadkernel/brep_revolve_rational.dl

class:
    patterns:
        [a|] cad revolve sheet use
    members:
        edge as a cad edge key
        forward as a boolean
        pcurve as a cad pcurve result
class:
    patterns:
        [a|] cad revolve sheet lifted result
    members:
        valid as a boolean
        curve as a cad edge curve3
        start as a 64 bit floating-point number
        end as a 64 bit floating-point number
class:
    patterns:
        [a|] cad revolve sheet edge result
    members:
        valid as a boolean
        value as a cad edge key
class:
    patterns:
        [a|] cad revolve sheet sense result
    members:
        valid as a boolean
        value as a boolean
class:
    patterns:
        [a|] cad revolve sheet revolution station
    members:
        radius as a 64 bit floating-point number
        height as a 64 bit floating-point number
class:
    patterns:
        [a|] cad revolve sheet projection bounds
    members:
        valid as a boolean
        low as a 64 bit floating-point number
        high as a 64 bit floating-point number
class:
    patterns:
        [a|] cad revolve sheet revolution turn
    members:
        valid as a boolean
        pivot as a cad vector3
        axis as a cad vector3
        radial as a cad vector3
        spin as a boolean
        tolerance as a 64 bit floating-point number
        angle as a 64 bit floating-point number
        full as a boolean
class:
    patterns:
        [a|] cad revolve sheet revolution piece
    members:
        valid as a boolean
        kind as an integer
        surface as a cad surface key
        surfaceKind as an integer
        flat as a boolean
class:
    patterns:
        [a|] cad revolve sheet optional vertex
    members:
        valid as a boolean
        value as a cad vertex key
class:
    patterns:
        [a|] cad revolve sheet revolved arc parameters
    members:
        valid as a boolean
        around as a 64 bit floating-point number
        start as a 64 bit floating-point number
        end as a 64 bit floating-point number

local function cad revolve sheet [use] of {cad edge key:edge} forward {boolean:forward}:
    execute:
        return @intrinsic("construct", a cad revolve sheet use, edge, forward, no cad pcurve)
local function cad revolve sheet [vertex] at {cad vector3:point} in {cad body:body}:
    execute:
        return the cad body key after inserting (a cad vertex at point with provenance (the synthesized cad provenance)) into body
local function cad revolve sheet [edge] on {cad edge curve3:curve} from {a 64 bit floating-point number:start} to {a 64 bit floating-point number:end} between {cad vertex key:first} and {cad vertex key:last} in {cad body:body}:
    execute:
        set key to the cad body key after inserting curve into body
        return the cad body key after inserting (a cad edge on key from start to end between first and last with provenance (the synthesized cad provenance)) into body

local function cad revolve sheet lift of {cad curve2:piece} on {cad plane:plane}:
    execute:
        set absent to @intrinsic("construct", a cad revolve sheet lifted result, false, the cad edge curve3 of (a cad line3 with origin (the cad zero vector3) and direction (the cad zero vector3)), 0.0, 0.0)
        if (piece's kind) = 0:
            set start to the cad point at (piece's line's start) on plane
            set end to the cad point at (piece's line's end) on plane
            set curve to the cad edge curve3 of (a cad line3 with origin start and direction (the cad difference of end and start))
            return @intrinsic("construct", a cad revolve sheet lifted result, true, curve, 0.0, 1.0)
        if (piece's kind) = 2:
            set centre to the cad point at (piece's arc's centre) on plane
            set frame to a cad plane with origin centre, x axis (plane's xAxis) and y axis (plane's yAxis)
            set start to the cad normalized angle of (piece's arc's startAngle)
            set curve to the cad edge curve3 of (a cad circle3 with plane frame and radius (piece's arc's radius))
            return @intrinsic("construct", a cad revolve sheet lifted result, true, curve, start, start + (the cad sweep of (piece's arc)))
        if (piece's kind) = 3:
            set centre to the cad point at (piece's ellipse's ellipse's centre) on plane
            set normal to the cad normal of plane
            if (normal's valid) = false:
                return absent
            set along to the cad vector at (piece's ellipse's ellipse's majorAxis) on plane
            set frame to the cad orthonormal plane with origin centre, x axis along and normal (normal's value)
            if (frame's valid) = false:
                return absent
            set curve to the cad edge curve3 of (a cad ellipse3 with plane (frame's value), major radius (piece's ellipse's ellipse's majorRadius) and minor radius (piece's ellipse's ellipse's minorRadius))
            set start to piece's ellipse's startParameter
            return @intrinsic("construct", a cad revolve sheet lifted result, true, curve, start, start + (the cad sweep of (piece's ellipse)))
        if (piece's kind) = 5:
            set curve to the cad edge curve3 of (a cad planar spline3 with plane plane and curve (the cad clone of (piece's nurbs)))
            return @intrinsic("construct", a cad revolve sheet lifted result, true, curve, 0.0, 1.0)
        return absent

local function cad revolve sheet profile [edge] of {cad curve2:piece} on {cad plane:plane} from {cad vertex key:first} to {cad vertex key:last} in {cad body:body}:
    execute:
        set lifted to cad revolve sheet lift of piece on plane
        if (lifted's valid) = false:
            return @intrinsic("construct", a cad revolve sheet edge result, false, a new cad edge key)
        set key to cad revolve sheet edge on (lifted's curve) from (lifted's start) to (lifted's end) between first and last in body
        return @intrinsic("construct", a cad revolve sheet edge result, true, key)

local function cad revolve sheet [sense] of {cad surface:surface} at {cad vector3:point} outward {cad vector3:out}:
    execute:
        set absent to @intrinsic("construct", a cad revolve sheet sense result, false, false)
        set slope to 0.0
        if (surface's kind) = 4:
            set parameters to the cad parameters on surface nearest point
            if (parameters's valid) = false:
                return absent
            set normal to the cad normal of surface at parameters (parameters's value's x) and (parameters's value's y)
            if (normal's valid) = false:
                return absent
            set slope to the cad dot of (normal's value) and out
        else if (surface's kind) = 5:
            set domain to the cad domain of (surface's nurbs)
            set normal to the cad normal of surface at parameters (((domain's u's start) + (domain's u's end)) * 0.5) and (((domain's v's start) + (domain's v's end)) * 0.5)
            if (normal's valid) = false:
                return absent
            set slope to the cad dot of (normal's value) and out
        else:
            set normalized to the cad normalization of out
            if (normalized's valid) = false:
                return absent
            set step to (normalized's value) scaled by 1e-6
            set ahead to the cad sum of point and step
            set behind to the cad difference of point and step
            set slope to (the cad distance from surface to ahead) - (the cad distance from surface to behind)
        if (slope = 0.0) or (((the absolute value of slope) <= 1.7976931348623157e308) = false):
            return absent
        return @intrinsic("construct", a cad revolve sheet sense result, true, slope > 0.0)

local function cad revolve sheet outward of {cad curve2:piece} on {cad plane:plane} forward {boolean:forward} counterclockwise {boolean:counterclockwise}:
    execute:
        set tangent to the cad tangent of piece at 0.5
        set along to -1.0
        if forward:
            set along to 1.0
        set right to the negative of along
        if counterclockwise:
            set right to along
        return the cad vector at (a cad vector2 with x ((tangent's y) * right) and y ((the negative of (tangent's x)) * right)) on plane


local function cad revolve sheet revolution scalar {a 64 bit floating-point number:value} is finite:
    execute:
        return (value = value) and ((the absolute value of value) <= 1.7976931348623157e308)

local function no cad revolve sheet projection bounds:
    execute:
        return @intrinsic("construct", a cad revolve sheet projection bounds, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function cad revolve sheet projection bounds between {a 64 bit floating-point number:first} and {a 64 bit floating-point number:second}:
    execute:
        if ((cad revolve sheet revolution scalar first is finite) and (cad revolve sheet revolution scalar second is finite)) = false:
            return no cad revolve sheet projection bounds
        return @intrinsic("construct", a cad revolve sheet projection bounds, true, the minimum of first and second, the maximum of first and second)

local function cad revolve sheet revolution angle from {a 64 bit floating-point number:y} over {a 64 bit floating-point number:x}:
    execute:
        return @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, y, x)

local function cad revolve sheet revolution positive remainder of {a 64 bit floating-point number:value}:
    execute:
        set result to the remainder of value divided by 6.283185307179586
        if result < 0.0:
            set result to result + 6.283185307179586
        return result

local function cad revolve sheet trigonometric value with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine} at {a 64 bit floating-point number:parameter}:
    execute:
        return (centre + (cosine * (the cosine of parameter))) + (sine * (the sine of parameter))

local function cad revolve sheet trigonometric bounds with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine}, start {a 64 bit floating-point number:start} and sweep {a 64 bit floating-point number:sweep}:
    execute:
        set finish to start + sweep
        if (((((cad revolve sheet revolution scalar centre is finite) and (cad revolve sheet revolution scalar cosine is finite)) and (cad revolve sheet revolution scalar sine is finite)) and (cad revolve sheet revolution scalar start is finite)) and ((cad revolve sheet revolution scalar sweep is finite) and (sweep > 0.0))) = false:
            return no cad revolve sheet projection bounds
        if (cad revolve sheet revolution scalar finish is finite) = false:
            return no cad revolve sheet projection bounds
        set first to cad revolve sheet trigonometric value with centre centre, cosine cosine, sine sine at start
        set last to cad revolve sheet trigonometric value with centre centre, cosine cosine, sine sine at finish
        set interval to cad revolve sheet projection bounds between first and last
        if (interval's valid) = false:
            return interval
        set maximumParameter to cad revolve sheet revolution angle from sine over cosine
        loop offsetIndex from 0 to 2:
            set extreme to maximumParameter + ((offsetIndex as a 64 bit floating-point number) * 3.141592653589793)
            set offset to cad revolve sheet revolution positive remainder of (extreme - start)
            if (sweep >= (6.283185307179586 - 1e-12)) or (offset <= (sweep + 1e-12)):
                set measured to cad revolve sheet trigonometric value with centre centre, cosine cosine, sine sine at extreme
                if (cad revolve sheet revolution scalar measured is finite) = false:
                    return no cad revolve sheet projection bounds
                set interval's low to the minimum of (interval's low) and measured
                set interval's high to the maximum of (interval's high) and measured
        return interval

local function cad revolve sheet projection of {cad vector3:point} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        return the cad dot of (the cad difference of point and origin) and direction

local function cad revolve sheet projection bounds of {cad curve2:piece} on {cad plane:plane} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        if (piece's kind) = 0:
            set first to cad revolve sheet projection of (the cad point at (piece's line's start) on plane) from origin along direction
            set second to cad revolve sheet projection of (the cad point at (piece's line's end) on plane) from origin along direction
            return cad revolve sheet projection bounds between first and second
        if (piece's kind) = 2:
            set arc to piece's arc
            set centre to cad revolve sheet projection of (the cad point at (arc's centre) on plane) from origin along direction
            set cosineVector to the cad vector at (a cad vector2 with x (arc's radius) and y 0.0) on plane
            set sineVector to the cad vector at (a cad vector2 with x 0.0 and y (arc's radius)) on plane
            set cosine to the cad dot of cosineVector and direction
            set sine to the cad dot of sineVector and direction
            return cad revolve sheet trigonometric bounds with centre centre, cosine cosine, sine sine, start (arc's startAngle) and sweep (the cad sweep of arc)
        return no cad revolve sheet projection bounds

local function no cad revolve sheet revolution turn:
    execute:
        return @intrinsic("construct", a cad revolve sheet revolution turn, false, the cad zero vector3, the cad zero vector3, the cad zero vector3, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number, false)

local function cad revolve sheet revolution turn of {a pointer to a list:profile} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a 64 bit floating-point number:angle}:
    execute:
        set rational to false
        loop index from 0 to the length of profile:
            set kind to (the item at index in profile)'s kind
            if (kind = 3) or (kind = 5):
                set rational to true
            else if (kind != 0) and (kind != 2):
                return no cad revolve sheet revolution turn
        if rational:
            set built to the cad rational revolution turn of profile on plane about pivot along axis by angle
            if built's valid = false:
                return no cad revolve sheet revolution turn
            return @intrinsic("construct", a cad revolve sheet revolution turn, true, built's pivot, built's axis, built's radial, built's spin, built's tolerance, built's angle, built's full)
        set normalResult to the cad normal of plane
        set directionResult to the cad normalization of axis
        if ((normalResult's valid) and (directionResult's valid)) = false:
            return no cad revolve sheet revolution turn
        set direction to directionResult's value
        set turnAngle to angle
        if turnAngle < 0.0:
            set direction to the cad negative of direction
            set turnAngle to 0.0 - turnAngle
        if ((cad revolve sheet revolution scalar turnAngle is finite) = false) or ((turnAngle <= 0.0) or (turnAngle > (6.283185307179586 + 1e-12))):
            return no cad revolve sheet revolution turn
        set planeDistance to the cad distance from pivot to plane
        if (planeDistance's valid) = false:
            return no cad revolve sheet revolution turn
        if ((the absolute value of (the cad dot of direction and (normalResult's value))) > 1e-9) or ((the absolute value of (planeDistance's value)) > 1e-9):
            return no cad revolve sheet revolution turn
        set radialResult to the cad normalization of (the cad cross of (normalResult's value) and direction)
        if (radialResult's valid) = false:
            return no cad revolve sheet revolution turn
        set radial to radialResult's value
        set spin to (the cad dot of (normalResult's value) and (the cad cross of direction and radial)) > 0.0
        set foundFirst to false
        set scaleOrigin to the cad zero vector3
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            if ((piece's kind) != 0) and ((piece's kind) != 2):
                return no cad revolve sheet revolution turn
            if foundFirst = false:
                set scaleOrigin to the cad point at (the cad point on piece at 0.0) on plane
                set foundFirst to true
        if foundFirst = false:
            return no cad revolve sheet revolution turn
        set radialBounds to no cad revolve sheet projection bounds
        set heightBounds to no cad revolve sheet projection bounds
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            set pieceRadial to cad revolve sheet projection bounds of piece on plane from pivot along radial
            set pieceHeight to cad revolve sheet projection bounds of piece on plane from scaleOrigin along direction
            if ((pieceRadial's valid) and (pieceHeight's valid)) = false:
                return no cad revolve sheet revolution turn
            if radialBounds's valid:
                set radialBounds's low to the minimum of (radialBounds's low) and (pieceRadial's low)
                set radialBounds's high to the maximum of (radialBounds's high) and (pieceRadial's high)
            else:
                set radialBounds to pieceRadial
            if heightBounds's valid:
                set heightBounds's low to the minimum of (heightBounds's low) and (pieceHeight's low)
                set heightBounds's high to the maximum of (heightBounds's high) and (pieceHeight's high)
            else:
                set heightBounds to pieceHeight
        set radialMagnitude to the maximum of (the absolute value of (radialBounds's low)) and (the absolute value of (radialBounds's high))
        set profileScale to the maximum of radialMagnitude and ((heightBounds's high) - (heightBounds's low))
        set tolerance to 1e-9 * (the maximum of profileScale and 1.0)
        if profileScale <= tolerance:
            return no cad revolve sheet revolution turn
        set reachesNegative to (radialBounds's low) < (the negative of tolerance)
        set reachesPositive to (radialBounds's high) > tolerance
        if reachesNegative and reachesPositive:
            return no cad revolve sheet revolution turn
        if (reachesNegative or reachesPositive) = false:
            return no cad revolve sheet revolution turn
        if reachesPositive = false:
            set radial to the cad negative of radial
            set spin to spin = false
        return @intrinsic("construct", a cad revolve sheet revolution turn, true, pivot, direction, radial, spin, tolerance, turnAngle, (the absolute value of (6.283185307179586 - turnAngle)) <= 1e-9)

local function cad revolve sheet revolution station at {cad vector2:uv} on {cad plane:plane} for {cad revolve sheet revolution turn:turn}:
    execute:
        set offset to the cad difference of (the cad point at uv on plane) and (turn's pivot)
        return @intrinsic("construct", a cad revolve sheet revolution station, the cad dot of offset and (turn's radial), the cad dot of offset and (turn's axis))

local function cad revolve sheet revolution circle at {a 64 bit floating-point number:height} for {cad revolve sheet revolution turn:turn}:
    execute:
        set centre to the cad sum of (turn's pivot) and ((turn's axis) scaled by height)
        return the cad orthonormal plane with origin centre, x axis (turn's radial) and normal (turn's axis)

local function no cad revolve sheet revolution piece:
    execute:
        return @intrinsic("construct", a cad revolve sheet revolution piece, false, 2, a new cad surface key, 0, false)

local function collapsed cad revolve sheet revolution piece:
    execute:
        return @intrinsic("construct", a cad revolve sheet revolution piece, true, 0, a new cad surface key, 0, false)

local function cad revolve sheet revolution piece on {cad surface:surface} flat {boolean:flat} in {cad body:body}:
    execute:
        set surfaceKey to the cad body key after inserting surface into body
        return @intrinsic("construct", a cad revolve sheet revolution piece, true, 1, surfaceKey, surface's kind, flat)

local function cad revolve sheet revolution surface of {cad curve2:piece} on {cad plane:plane} for {cad revolve sheet revolution turn:turn} in {cad body:body}:
    execute:
        if ((piece's kind) = 3) or ((piece's kind) = 5):
            set rationalTurn to @intrinsic("construct", a cad rational revolution turn, turn's valid, turn's pivot, turn's axis, turn's radial, turn's spin, turn's tolerance, turn's angle, turn's full)
            set made to the cad rational revolution surface of piece on plane for rationalTurn
            if made's collapsed:
                return collapsed cad revolve sheet revolution piece
            if made's valid = false:
                return no cad revolve sheet revolution piece
            return cad revolve sheet revolution piece on (the cad surface of made's value) flat false in body
        set radialBounds to cad revolve sheet projection bounds of piece on plane from (turn's pivot) along (turn's radial)
        if radialBounds's valid = false:
            return no cad revolve sheet revolution piece
        set reachesNegative to (radialBounds's low) < (the negative of (turn's tolerance))
        set reachesPositive to (radialBounds's high) > (turn's tolerance)
        if (reachesNegative or reachesPositive) = false:
            return collapsed cad revolve sheet revolution piece
        if (piece's kind) = 0:
            set first to cad revolve sheet revolution station at (piece's line's start) on plane for turn
            set second to cad revolve sheet revolution station at (piece's line's end) on plane for turn
            set frameResult to cad revolve sheet revolution circle at (first's height) for turn
            if frameResult's valid = false:
                return no cad revolve sheet revolution piece
            if (the absolute value of ((second's height) - (first's height))) <= (turn's tolerance):
                return cad revolve sheet revolution piece on (the cad surface of (frameResult's value)) flat true in body
            if (the absolute value of ((second's radius) - (first's radius))) <= (turn's tolerance):
                return cad revolve sheet revolution piece on (the cad surface of (a cad cylinder with base (frameResult's value) and radius (first's radius))) flat false in body
            set halfAngle to @intrinsic("call", "libc", "atan", a 64 bit floating-point number, ((first's radius) - (second's radius)) / ((second's height) - (first's height)))
            return cad revolve sheet revolution piece on (the cad surface of (a cad cone with base (frameResult's value), radius (first's radius) and half angle halfAngle)) flat false in body
        if (piece's kind) = 2:
            set centreStation to cad revolve sheet revolution station at (piece's arc's centre) on plane for turn
            set frameResult to cad revolve sheet revolution circle at (centreStation's height) for turn
            if frameResult's valid = false:
                return no cad revolve sheet revolution piece
            if (the absolute value of (centreStation's radius)) <= (turn's tolerance):
                return cad revolve sheet revolution piece on (the cad surface of (a cad sphere with frame (frameResult's value) and radius (piece's arc's radius))) flat false in body
            return cad revolve sheet revolution piece on (the cad surface of (a cad torus with frame (frameResult's value), major radius (the absolute value of (centreStation's radius)) and minor radius (piece's arc's radius))) flat false in body
        return no cad revolve sheet revolution piece

local function cad revolve sheet revolution turned {cad vector3:vector} by {a 64 bit floating-point number:angle} for {cad revolve sheet revolution turn:turn}:
    execute:
        set cosine to the cosine of angle
        set sine to the sine of angle
        set first to vector scaled by cosine
        set second to (the cad cross of (turn's axis) and vector) scaled by sine
        set third to (turn's axis) scaled by ((the cad dot of (turn's axis) and vector) * (1.0 - cosine))
        return the cad sum of (the cad sum of first and second) and third

local function cad revolve sheet revolution moved {cad vector3:point} by {a 64 bit floating-point number:angle} for {cad revolve sheet revolution turn:turn}:
    execute:
        return the cad sum of (turn's pivot) and (cad revolve sheet revolution turned (the cad difference of point and (turn's pivot)) by angle for turn)

local function no cad revolve sheet revolved arc parameters:
    execute:
        return @intrinsic("construct", a cad revolve sheet revolved arc parameters, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function cad revolve sheet revolved parameters of {cad arc2:arc} on {cad plane:plane} for {cad revolve sheet revolution turn:turn}:
    execute:
        set arcSweep to the cad sweep of arc
        set midpoint to (arc's startAngle) + arcSweep * 0.5
        set offset to the cad vector at (a cad vector2 with x ((arc's radius) * (the cosine of midpoint)) and y ((arc's radius) * (the sine of midpoint))) on plane
        set tangent to the cad vector at (a cad vector2 with x ((the negative of (arc's radius)) * (the sine of midpoint)) and y ((arc's radius) * (the cosine of midpoint))) on plane
        set radial to the cad dot of offset and (turn's radial)
        set height to the cad dot of offset and (turn's axis)
        set radialTangent to the cad dot of tangent and (turn's radial)
        set heightTangent to the cad dot of tangent and (turn's axis)
        set orientation to radial * heightTangent - height * radialTangent
        if (((cad revolve sheet revolution scalar arcSweep is finite) and (cad revolve sheet revolution scalar radial is finite)) and ((cad revolve sheet revolution scalar height is finite) and ((cad revolve sheet revolution scalar orientation is finite) and (orientation != 0.0)))) = false:
            return no cad revolve sheet revolved arc parameters
        set middleAngle to cad revolve sheet revolution angle from height over radial
        set direction to the negative of (1.0 as a 64 bit floating-point number)
        if orientation > 0.0:
            set direction to 1.0
        set beginning to middleAngle - ((direction * arcSweep) * 0.5)
        set ending to middleAngle + ((direction * arcSweep) * 0.5)
        set centreStation to cad revolve sheet revolution station at (arc's centre) on plane for turn
        if (centreStation's radius) < (the negative of (turn's tolerance)):
            return @intrinsic("construct", a cad revolve sheet revolved arc parameters, true, 3.141592653589793 as a 64 bit floating-point number, 3.141592653589793 - beginning, 3.141592653589793 - ending)
        return @intrinsic("construct", a cad revolve sheet revolved arc parameters, true, 0.0 as a 64 bit floating-point number, beginning, ending)

local function cad revolve sheet ring on {cad face key:faceKey} in {cad body:body} using {cad topology list:uses}:
    execute:
        set ringKey to the cad body key after inserting (a cad loop owned by faceKey with provenance (the synthesized cad provenance)) into body
        loop index from 0 to the length of (uses's values):
            set usage to the item at index in (uses's values)
            set coedgeKey to the cad body key after inserting (a cad coedge on (usage's edge) forward (usage's forward) with pcurve (usage's pcurve) owned by ringKey with provenance (the synthesized cad provenance)) into body
            set edgeNode to the cad node pointer for (usage's edge) in body
            set ringNode to the cad node pointer for ringKey in body
            if (edgeNode = (0 as the type of edgeNode)) or (ringNode = (0 as the type of ringNode)):
                return false
            append coedgeKey to (edgeNode's coedges's values)
            append coedgeKey to (ringNode's coedges's values)
        set faceNode to the cad node pointer for faceKey in body
        if faceNode = (0 as the type of faceNode):
            return false
        append ringKey to (faceNode's loops's values)
        return true

local function cad revolve sheet optional vertex at {cad vector3:point} in {cad body:body} present {boolean:present}:
    execute:
        if present:
            return @intrinsic("construct", a cad revolve sheet optional vertex, true, cad revolve sheet vertex at point in body)
        return @intrinsic("construct", a cad revolve sheet optional vertex, false, a new cad vertex key)

local function cad revolve sheet far plane from {cad plane:plane} for {cad revolve sheet revolution turn:turn}:
    execute:
        return a cad plane with origin (cad revolve sheet revolution moved (plane's origin) by (turn's angle) for turn), x axis (cad revolve sheet revolution turned (plane's xAxis) by (turn's angle) for turn) and y axis (cad revolve sheet revolution turned (plane's yAxis) by (turn's angle) for turn)

local function cad revolve sheet face orientation of {cad curve2:piece} on {cad plane:plane} for {cad revolve sheet revolution turn:turn} with {cad surface key:surfaceKey} in {cad body:body} forward {boolean:forward}:
    execute:
        set outward to cad revolve sheet outward of piece on plane forward forward counterclockwise true
        set samplePoint to the cad point at (the cad point on piece at 0.5) on plane
        set halfwayOut to cad revolve sheet revolution turned outward by ((turn's angle) * 0.5) for turn
        set halfwayOn to cad revolve sheet revolution moved samplePoint by ((turn's angle) * 0.5) for turn
        set surfaceNode to the cad node pointer for surfaceKey in body
        if surfaceNode = (0 as the type of surfaceNode):
            return @intrinsic("construct", a cad revolve sheet sense result, false, false)
        return cad revolve sheet sense of (@intrinsic("dereference", surfaceNode)) at halfwayOn outward halfwayOut

local function cad revolve sheet arc usage on {cad edge key:edge} forward {boolean:forward} from {cad vector2:first} to {cad vector2:last}:
    execute:
        set mappedUse to cad revolve sheet use of edge forward forward
        set mappedUse's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from first to last))
        return mappedUse

local function cad revolve sheet split {cad body:body} with lump {cad lump key:lumpKey}, shell {cad shell key:shellKey}, faces {cad topology list:faces}, active {cad topology list:active}, joins {cad topology list:joins} closed {boolean:closed}:
    execute:
        set count to the length of (faces's values)
        set ids to a cad topology list of an integer
        set nextId to 0
        loop index from 0 to count:
            set id to -1
            if the item at index in (active's values):
                set connected to false
                if index > 0:
                    set connected to (the item at (index - 1) in (active's values)) and (the item at index in (joins's values))
                if connected:
                    set id to the item at (index - 1) in (ids's values)
                else:
                    set id to nextId
                    increment nextId
            append id to (ids's values)
        if nextId = 0:
            return false
        if (((closed and (the item at 0 in (active's values))) and (the item at (count - 1) in (active's values))) and (the item at 0 in (joins's values))):
            set firstId to the item at 0 in (ids's values)
            set lastId to the item at (count - 1) in (ids's values)
            loop index from 0 to count:
                if (the item at index in (ids's values)) = lastId:
                    replace item at index index in (ids's values) with firstId
        set firstComponent to true
        loop id from 0 to nextId:
            set component to a cad topology list of a cad face key
            loop index from 0 to count:
                if (the item at index in (ids's values)) = id:
                    append (the item at index in (faces's values)) to (component's values)
            if (the length of (component's values)) > 0:
                set ownerLump to lumpKey
                set ownerShell to shellKey
                if firstComponent = false:
                    set ownerLump to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
                    set ownerShell to the cad body key after inserting (a cad shell owned by ownerLump with provenance (the synthesized cad provenance)) into body
                set shellNode to the cad node pointer for ownerShell in body
                set lumpNode to the cad node pointer for ownerLump in body
                if (shellNode = (0 as the type of shellNode)) or (lumpNode = (0 as the type of lumpNode)):
                    return false
                set shellNode's faces to the cad clone of component
                append ownerShell to (lumpNode's shells's values)
                loop index from 0 to the length of (component's values):
                    set faceNode to the cad node pointer for (the item at index in (component's values)) in body
                    if faceNode = (0 as the type of faceNode):
                        return false
                    set faceNode's owner to ownerShell
                append ownerLump to (body's roots)
                set firstComponent to false
        return true

function the cad revolved sheet of {a pointer to a list:profile} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a number:angle}:
    execute:
        set ordered to the cad profile senses of profile
        set closed to ordered's valid
        if closed = false:
            set ordered to the cad path senses of profile
        if ordered's valid = false:
            return no cad body
        set senses to ordered's value
        set corners to a cad topology list of a cad vector2
        loop index from 0 to the length of profile:
            set parameter to 1.0
            if the item at index in (senses's values):
                set parameter to 0.0
            append (the cad point on (the item at index in profile) at parameter) to (corners's values)
        if closed = false:
            set parameter to 0.0
            if the last item of (senses's values):
                set parameter to 1.0
            append (the cad point on (the last item of profile) at parameter) to (corners's values)
        if ((the length of profile) = 0) or ((the length of (corners's values)) < 2):
            return no cad body
        set turn to cad revolve sheet revolution turn of profile on plane about pivot along axis by (angle as a 64 bit floating-point number)
        if turn's valid = false:
            return no cad body
        set stations to a cad topology list of a cad revolve sheet revolution station
        loop index from 0 to the length of (corners's values):
            append (cad revolve sheet revolution station at (the item at index in (corners's values)) on plane for turn) to (stations's values)
        set body to an empty cad body
        set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
        set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
        set pieces to a cad topology list of a cad revolve sheet revolution piece
        set active to a cad topology list of a boolean
        loop index from 0 to the length of profile:
            set shape to cad revolve sheet revolution surface of (the item at index in profile) on plane for turn in body
            if shape's valid = false:
                return no cad body
            append shape to (pieces's values)
            append ((shape's kind) = 1) to (active's values)
        if turn's full:
            if (cad revolve sheet whole profile on plane with senses senses, corners corners, stations stations, pieces pieces, active active for turn in body within shellKey and lumpKey closed closed) = false:
                return no cad body
        else:
            if (cad revolve sheet partial profile on plane with senses senses, corners corners, stations stations, pieces pieces, active active for turn in body within shellKey and lumpKey closed closed) = false:
                return no cad body
        return the validated cad body result of body

function the cad revolved sheets of {a pointer to a list:profiles} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a number:angle}:
    execute:
        set combined to an empty cad body
        loop index from 0 to the length of profiles:
            set sheet to the cad revolved sheet of (the item at index in profiles) on plane about pivot along axis by angle
            if sheet's valid = false:
                return no cad body
            if (append cad body (sheet's value) into combined) = false:
                return no cad body
        if (the length of (combined's roots)) = 0:
            return no cad body
        return the validated cad body result of combined

local function cad revolve sheet partial {a pointer to a list:profile} on {cad plane:plane} with senses {cad topology list:senses}, corners {cad topology list:corners}, stations {cad topology list:stations}, pieces {cad topology list:pieces}, active {cad topology list:active} for {cad revolve sheet revolution turn:turn} in {cad body:body} within {cad shell key:shellKey} and {cad lump key:lumpKey} closed {boolean:closed}:
    execute:
        set farPlane to cad revolve sheet far plane from plane for turn
        set near to a cad topology list of a cad vertex key
        set far to a cad topology list of a cad vertex key
        loop index from 0 to the length of (corners's values):
            set uv to the item at index in (corners's values)
            set nearKey to cad revolve sheet vertex at (the cad point at uv on plane) in body
            append nearKey to (near's values)
            set farKey to nearKey
            if ((the item at index in (stations's values))'s radius) > (turn's tolerance):
                set farKey to cad revolve sheet vertex at (the cad point at uv on farPlane) in body
            append farKey to (far's values)
        set nearEdges to a cad topology list of a cad revolve sheet edge result
        set farEdges to a cad topology list of a cad revolve sheet edge result
        loop index from 0 to the length of profile:
            set absent to @intrinsic("construct", a cad revolve sheet edge result, false, a new cad edge key)
            if (the item at index in (active's values)) = false:
                append absent to (nearEdges's values)
                append absent to (farEdges's values)
            else:
                set next to index + 1
                if closed:
                    set next to the remainder of next divided by (the length of (corners's values))
                set from to index
                set to to next
                if (the item at index in (senses's values)) = false:
                    set from to next
                    set to to index
                set piece to the item at index in profile
                set baseEdge to cad revolve sheet profile edge of piece on plane from (the item at from in (near's values)) to (the item at to in (near's values)) in body
                set topEdge to cad revolve sheet profile edge of piece on farPlane from (the item at from in (far's values)) to (the item at to in (far's values)) in body
                if (baseEdge's valid = false) or (topEdge's valid = false):
                    return false
                append baseEdge to (nearEdges's values)
                append topEdge to (farEdges's values)
        set rails to a cad topology list of a cad revolve sheet edge result
        set joins to a cad topology list of a boolean
        loop index from 0 to the length of (corners's values):
            set station to the item at index in (stations's values)
            set hasRail to (station's radius) > (turn's tolerance)
            append hasRail to (joins's values)
            if hasRail:
                set circle to cad revolve sheet revolution circle at (station's height) for turn
                if circle's valid = false:
                    return false
                set curve to the cad edge curve3 of (a cad circle3 with plane (circle's value) and radius (station's radius))
                set railKey to cad revolve sheet edge on curve from 0.0 to (turn's angle) between (the item at index in (near's values)) and (the item at index in (far's values)) in body
                append (@intrinsic("construct", a cad revolve sheet edge result, true, railKey)) to (rails's values)
            else:
                append (@intrinsic("construct", a cad revolve sheet edge result, false, a new cad edge key)) to (rails's values)
        set faces to a cad topology list of a cad face key
        loop index from 0 to the length of profile:
            if (the item at index in (active's values)) = false:
                append (a new cad face key) to (faces's values)
            else:
                set next to index + 1
                if closed:
                    set next to the remainder of next divided by (the length of (corners's values))
                set piece to the item at index in profile
                set pieceShape to the item at index in (pieces's values)
                set sense to the item at index in (senses's values)
                set orientation to cad revolve sheet face orientation of piece on plane for turn with (pieceShape's surface) in body forward sense
                if orientation's valid = false:
                    return false
                set faceKey to the cad body key after inserting (a cad face on (pieceShape's surface) forward (orientation's value) owned by shellKey with provenance (the synthesized cad provenance)) into body
                set circuit to a cad topology list of a cad revolve sheet use
                set baseEdge to the item at index in (nearEdges's values)
                set topEdge to the item at index in (farEdges's values)
                set nextRail to the item at next in (rails's values)
                set firstRail to the item at index in (rails's values)
                set arcParameters to no cad revolve sheet revolved arc parameters
                if ((pieceShape's surfaceKind) = 3) or ((pieceShape's surfaceKind) = 4):
                    if (piece's kind) = 2:
                        set arcParameters to cad revolve sheet revolved parameters of (piece's arc) on plane for turn
                        if arcParameters's valid = false:
                            return false
                if arcParameters's valid:
                    set beginning to arcParameters's start
                    set ending to arcParameters's end
                    if sense = false:
                        set beginning to arcParameters's end
                        set ending to arcParameters's start
                    set nearAngle to arcParameters's around
                    set farAngle to nearAngle + (turn's angle)
                    append (cad revolve sheet arc usage on (baseEdge's value) forward sense from (a cad vector2 with x nearAngle and y beginning) to (a cad vector2 with x nearAngle and y ending)) to (circuit's values)
                    if nextRail's valid:
                        append (cad revolve sheet arc usage on (nextRail's value) forward true from (a cad vector2 with x nearAngle and y ending) to (a cad vector2 with x farAngle and y ending)) to (circuit's values)
                    append (cad revolve sheet arc usage on (topEdge's value) forward (sense = false) from (a cad vector2 with x farAngle and y ending) to (a cad vector2 with x farAngle and y beginning)) to (circuit's values)
                    if firstRail's valid:
                        append (cad revolve sheet arc usage on (firstRail's value) forward false from (a cad vector2 with x farAngle and y beginning) to (a cad vector2 with x nearAngle and y beginning)) to (circuit's values)
                else if (pieceShape's surfaceKind) = 5:
                    set start to 0.0
                    set end to 1.0
                    if sense = false:
                        set start to 1.0
                        set end to 0.0
                    append (cad revolve sheet arc usage on (baseEdge's value) forward sense from (a cad vector2 with x start and y 0.0) to (a cad vector2 with x end and y 0.0)) to (circuit's values)
                    if nextRail's valid:
                        append (cad revolve sheet arc usage on (nextRail's value) forward true from (a cad vector2 with x end and y 0.0) to (a cad vector2 with x end and y 1.0)) to (circuit's values)
                    append (cad revolve sheet arc usage on (topEdge's value) forward (sense = false) from (a cad vector2 with x end and y 1.0) to (a cad vector2 with x start and y 1.0)) to (circuit's values)
                    if firstRail's valid:
                        append (cad revolve sheet arc usage on (firstRail's value) forward false from (a cad vector2 with x start and y 1.0) to (a cad vector2 with x start and y 0.0)) to (circuit's values)
                else:
                    append (cad revolve sheet use of (baseEdge's value) forward sense) to (circuit's values)
                    if nextRail's valid:
                        append (cad revolve sheet use of (nextRail's value) forward true) to (circuit's values)
                    append (cad revolve sheet use of (topEdge's value) forward (sense = false)) to (circuit's values)
                    if firstRail's valid:
                        append (cad revolve sheet use of (firstRail's value) forward false) to (circuit's values)
                if (cad revolve sheet ring on faceKey in body using circuit) = false:
                    return false
                set shellNode to the cad node pointer for shellKey in body
                append faceKey to (shellNode's faces's values)
                append faceKey to (faces's values)
        return cad revolve sheet split body with lump lumpKey, shell shellKey, faces faces, active active, joins joins closed closed

local function cad revolve sheet whole {a pointer to a list:profile} on {cad plane:plane} with senses {cad topology list:senses}, corners {cad topology list:corners}, stations {cad topology list:stations}, pieces {cad topology list:pieces}, active {cad topology list:active} for {cad revolve sheet revolution turn:turn} in {cad body:body} within {cad shell key:shellKey} and {cad lump key:lumpKey} closed {boolean:closed}:
    execute:
        set pieceCount to the length of profile
        set cornerCount to the length of (corners's values)
        set hasRim to a cad topology list of a boolean
        set hasSeam to a cad topology list of a boolean
        loop index from 0 to pieceCount:
            set shape to the item at index in (pieces's values)
            append (((shape's kind) = 1) and ((shape's flat) = false)) to (hasSeam's values)
        loop index from 0 to cornerCount:
            set before to index - 1
            if (before < 0) and closed:
                set before to pieceCount - 1
            set after to index
            if after >= pieceCount:
                if closed:
                    set after to 0
                else:
                    set after to -1
            set touchesSurface to false
            if before >= 0:
                set touchesSurface to the item at before in (active's values)
            if after >= 0:
                set touchesSurface to touchesSurface or (the item at after in (active's values))
            append ((((the item at index in (stations's values))'s radius) > (turn's tolerance)) and touchesSurface) to (hasRim's values)
        set vertices to a cad topology list of a cad revolve sheet optional vertex
        loop index from 0 to cornerCount:
            set before to index - 1
            if (before < 0) and closed:
                set before to pieceCount - 1
            set after to index
            if after >= pieceCount:
                if closed:
                    set after to 0
                else:
                    set after to -1
            set needed to the item at index in (hasRim's values)
            if before >= 0:
                set needed to needed or (the item at before in (hasSeam's values))
            if after >= 0:
                set needed to needed or (the item at after in (hasSeam's values))
            append (cad revolve sheet optional vertex at (the cad point at (the item at index in (corners's values)) on plane) in body present needed) to (vertices's values)
        set rims to a cad topology list of a cad revolve sheet edge result
        loop index from 0 to cornerCount:
            if the item at index in (hasRim's values):
                set station to the item at index in (stations's values)
                set vertex to the item at index in (vertices's values)
                set circle to cad revolve sheet revolution circle at (station's height) for turn
                if (vertex's valid = false) or (circle's valid = false):
                    return false
                set curve to the cad edge curve3 of (a cad circle3 with plane (circle's value) and radius (station's radius))
                set edgeKey to cad revolve sheet edge on curve from 0.0 to 6.283185307179586 between (vertex's value) and (vertex's value) in body
                append (@intrinsic("construct", a cad revolve sheet edge result, true, edgeKey)) to (rims's values)
            else:
                append (@intrinsic("construct", a cad revolve sheet edge result, false, a new cad edge key)) to (rims's values)
        set seams to a cad topology list of a cad revolve sheet edge result
        loop index from 0 to pieceCount:
            if the item at index in (hasSeam's values):
                set next to index + 1
                if closed:
                    set next to the remainder of next divided by cornerCount
                set first to the item at index in (vertices's values)
                set last to the item at next in (vertices's values)
                if (first's valid = false) or (last's valid = false):
                    return false
                set fromKey to first's value
                set toKey to last's value
                if (the item at index in (senses's values)) = false:
                    set fromKey to last's value
                    set toKey to first's value
                set seam to cad revolve sheet profile edge of (the item at index in profile) on plane from fromKey to toKey in body
                if seam's valid = false:
                    return false
                append seam to (seams's values)
            else:
                append (@intrinsic("construct", a cad revolve sheet edge result, false, a new cad edge key)) to (seams's values)
        set faces to a cad topology list of a cad face key
        loop index from 0 to pieceCount:
            if (the item at index in (active's values)) = false:
                append (a new cad face key) to (faces's values)
            else:
                set next to index + 1
                if closed:
                    set next to the remainder of next divided by cornerCount
                set piece to the item at index in profile
                set pieceShape to the item at index in (pieces's values)
                set sense to the item at index in (senses's values)
                set orientation to cad revolve sheet face orientation of piece on plane for turn with (pieceShape's surface) in body forward sense
                if orientation's valid = false:
                    return false
                set faceKey to the cad body key after inserting (a cad face on (pieceShape's surface) forward (orientation's value) owned by shellKey with provenance (the synthesized cad provenance)) into body
                set firstRim to the item at index in (rims's values)
                set lastRim to the item at next in (rims's values)
                if pieceShape's flat:
                    set firstLargest to true
                    if firstRim's valid and lastRim's valid:
                        set firstLargest to ((the item at index in (stations's values))'s radius) >= ((the item at next in (stations's values))'s radius)
                    if firstLargest:
                        if firstRim's valid:
                            set circuit to a cad topology list of a cad revolve sheet use
                            append (cad revolve sheet use of (firstRim's value) forward true) to (circuit's values)
                            if (cad revolve sheet ring on faceKey in body using circuit) = false:
                                return false
                        if lastRim's valid:
                            set circuit to a cad topology list of a cad revolve sheet use
                            append (cad revolve sheet use of (lastRim's value) forward false) to (circuit's values)
                            if (cad revolve sheet ring on faceKey in body using circuit) = false:
                                return false
                    else:
                        set circuit to a cad topology list of a cad revolve sheet use
                        append (cad revolve sheet use of (lastRim's value) forward false) to (circuit's values)
                        if (cad revolve sheet ring on faceKey in body using circuit) = false:
                            return false
                        set circuit to a cad topology list of a cad revolve sheet use
                        append (cad revolve sheet use of (firstRim's value) forward true) to (circuit's values)
                        if (cad revolve sheet ring on faceKey in body using circuit) = false:
                            return false
                else:
                    set seam to the item at index in (seams's values)
                    if seam's valid = false:
                        return false
                    set circuit to a cad topology list of a cad revolve sheet use
                    set arcParameters to no cad revolve sheet revolved arc parameters
                    if ((pieceShape's surfaceKind) = 4) and ((piece's kind) = 2):
                        set arcParameters to cad revolve sheet revolved parameters of (piece's arc) on plane for turn
                        if arcParameters's valid = false:
                            return false
                    if arcParameters's valid:
                        set beginning to arcParameters's start
                        set ending to arcParameters's end
                        if sense = false:
                            set beginning to arcParameters's end
                            set ending to arcParameters's start
                        set nearAngle to arcParameters's around
                        set farAngle to nearAngle + 6.283185307179586
                        if firstRim's valid:
                            append (cad revolve sheet arc usage on (firstRim's value) forward true from (a cad vector2 with x nearAngle and y beginning) to (a cad vector2 with x farAngle and y beginning)) to (circuit's values)
                        append (cad revolve sheet arc usage on (seam's value) forward sense from (a cad vector2 with x farAngle and y beginning) to (a cad vector2 with x farAngle and y ending)) to (circuit's values)
                        if lastRim's valid:
                            append (cad revolve sheet arc usage on (lastRim's value) forward false from (a cad vector2 with x farAngle and y ending) to (a cad vector2 with x nearAngle and y ending)) to (circuit's values)
                        append (cad revolve sheet arc usage on (seam's value) forward (sense = false) from (a cad vector2 with x nearAngle and y ending) to (a cad vector2 with x nearAngle and y beginning)) to (circuit's values)
                    else if (pieceShape's surfaceKind) = 5:
                        set start to 0.0
                        set end to 1.0
                        if sense = false:
                            set start to 1.0
                            set end to 0.0
                        if firstRim's valid:
                            append (cad revolve sheet arc usage on (firstRim's value) forward true from (a cad vector2 with x start and y 0.0) to (a cad vector2 with x start and y 1.0)) to (circuit's values)
                        append (cad revolve sheet arc usage on (seam's value) forward sense from (a cad vector2 with x start and y 1.0) to (a cad vector2 with x end and y 1.0)) to (circuit's values)
                        if lastRim's valid:
                            append (cad revolve sheet arc usage on (lastRim's value) forward false from (a cad vector2 with x end and y 1.0) to (a cad vector2 with x end and y 0.0)) to (circuit's values)
                        append (cad revolve sheet arc usage on (seam's value) forward (sense = false) from (a cad vector2 with x end and y 0.0) to (a cad vector2 with x start and y 0.0)) to (circuit's values)
                    else:
                        if firstRim's valid:
                            append (cad revolve sheet use of (firstRim's value) forward true) to (circuit's values)
                        append (cad revolve sheet use of (seam's value) forward sense) to (circuit's values)
                        if lastRim's valid:
                            append (cad revolve sheet use of (lastRim's value) forward false) to (circuit's values)
                        append (cad revolve sheet use of (seam's value) forward (sense = false)) to (circuit's values)
                    if (cad revolve sheet ring on faceKey in body using circuit) = false:
                        return false
                set shellNode to the cad node pointer for shellKey in body
                append faceKey to (shellNode's faces's values)
                append faceKey to (faces's values)
        return cad revolve sheet split body with lump lumpKey, shell shellKey, faces faces, active active, joins hasRim closed closed
