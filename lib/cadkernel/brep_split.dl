        set firstVertex to the cad split landing vertex for firstLanding in body within tolerance
        if firstVertex's valid = false:
            return no cad split face
        set secondVertex to the cad split landing vertex for secondLanding in body within tolerance
        if secondVertex's valid = false:
            return no cad split face
        if (firstVertex's value = secondVertex's value) and (sameLanding = false):
            return no cad split face
        set startVertex to firstVertex's value
        set endVertex to secondVertex's value
