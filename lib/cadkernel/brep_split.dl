                    set firstCandidate to the item at pairCursor in (landings's values)
                    set secondCandidate to the item at nextCursor in (landings's values)
                    set firstAmount to the cad parameter on cutter nearest firstCandidate's point
                    set secondAmount to the cad parameter on cutter nearest secondCandidate's point
                    if nextCursor = 0:
                        if pairPeriod's valid = false:
