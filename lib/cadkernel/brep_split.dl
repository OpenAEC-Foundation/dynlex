                            set landingPoint to the cad point on (@intrinsic("dereference", surfaceNode)) at parameters crossing's point's x and crossing's point's y
                            set edgeAlong to the cad split parameter on (@intrinsic("dereference", edgeCurve)) nearest landingPoint within span edgeNode's startParameter to edgeNode's endParameter
                            set low to the minimum of edgeNode's startParameter and edgeNode's endParameter
                            set high to the maximum of edgeNode's startParameter and edgeNode's endParameter
                            set slack to (the absolute value of (high - low)) * 1e-9
                            if (edgeAlong >= (low - slack)) and (edgeAlong <= (high + slack)):
                                set duplicate to false
                                loop seenCursor from 0 to the length of (landings's values):
                                    set seen to the item at seenCursor in (landings's values)
                                    if ((the cad distance from seen's point to landingPoint) <= tolerance) and (((seen's edge != useNode's edge) or (seen's coedge = part's coedge))):
                                        set duplicate to true
                                if duplicate = false:
