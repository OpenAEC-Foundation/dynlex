                    set candidateAmount to the cad parameter on cutter nearest candidateLanding's point
                    set beforeStatus to the cad split containment of cutter at (candidateAmount - tangentStep) on (@intrinsic("dereference", surfaceNode)) bounded by boundaryCurves with periods periods within tolerance requiring clearance false
                    set afterStatus to the cad split containment of cutter at (candidateAmount + tangentStep) on (@intrinsic("dereference", surfaceNode)) bounded by boundaryCurves with periods periods within tolerance requiring clearance false
                    if (beforeStatus's valid and afterStatus's valid) and (beforeStatus's contained != afterStatus's contained):
