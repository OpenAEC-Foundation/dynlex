            loop vTurn from (0 - vSpan) to (vSpan + 1):
                set uShift to 0.0
                set vShift to 0.0
                if periods's uValid:
                    set uShift to (periods's u) * (uTurn as a 64 bit floating-point number)
                if periods's vValid:
                    set vShift to (periods's v) * (vTurn as a 64 bit floating-point number)
                set shiftedMidway to a cad vector2 with x ((midwayUV's value's x) + uShift) and y ((midwayUV's value's y) + vShift)
                loop partCursor from 0 to the length of (boundary's parts's values):
                    set part to the item at partCursor in (boundary's parts's values)
                    if (the cad distance to part's curve from shiftedMidway) <= tolerance:
