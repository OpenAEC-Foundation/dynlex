function the cad split of {cad face key:faceKey} in {cad body:body} along {cad edge curve3:cutter} within {a number:givenTolerance}:
    execute:
        set tolerance to givenTolerance as a 64 bit floating-point number
        if ((tolerance > 0.0) and ((the absolute value of tolerance) <= 1.7976931348623157e308)) = false:
            return no cad split face
        set candidate to the cad clone of body
        set proof to cad split face in place faceKey in candidate along cutter within tolerance
        if proof's valid = false:
