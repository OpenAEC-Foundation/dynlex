                        set secondAmount to secondAmount + pairPeriod's amount
                    set spanStatus to the cad split containment of cutter at (0.5 * (firstAmount + secondAmount)) on (@intrinsic("dereference", surfaceNode)) bounded by boundaryCurves with periods periods within tolerance requiring clearance true
                    if spanStatus's valid and spanStatus's contained:
