            if fullSphere's valid:
                return fullSphere
        set boundary to the cad boundary parts of faceKey in body within tolerance
        if boundary's valid = false:
            return no cad split face
        set boundaryCurves to a cad topology list of (the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2)))
        set landings to a cad topology list of a cad split landing
        set periods to the cad parameter periods of (@intrinsic("dereference", surfaceNode))
        set uSpan to 0
        set vSpan to 0
        if periods's uValid:
            set uSpan to 2
        if periods's vValid:
            set vSpan to 2
        loop uTurn from (0 - uSpan) to (uSpan + 1):
            loop vTurn from (0 - vSpan) to (vSpan + 1):
                set uShift to 0.0
                set vShift to 0.0
                if periods's uValid:
