local function cad split face in place {cad face key:faceKey} in {cad body:body} along {cad edge curve3:cutter} within {a 64 bit floating-point number:tolerance}:
    execute:
        if cutter's kind = 1:
            set closedPlanar to cad split closed planar face in place faceKey in body along cutter within tolerance
            if closedPlanar's valid:
                return closedPlanar
        set faceNode to the cad node pointer for faceKey in body
        if faceNode = (0 as the type of faceNode):
            return no cad split face
        set originalFace to the cad payload clone of (@intrinsic("dereference", faceNode))
