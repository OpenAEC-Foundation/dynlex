        set secondLanding to the item at 1 in (landings's values)
        set sameLanding to (the cad distance from firstLanding's point to secondLanding's point) <= tolerance
        set firstAlong to the cad parameter on cutter nearest firstLanding's point
        set secondAlong to the cad parameter on cutter nearest secondLanding's point
        set lowLandingIndex to 0
        set highLandingIndex to 1
        set lowAlong to firstAlong
        set highAlong to secondAlong
        if secondAlong < firstAlong:
            set lowLandingIndex to 1
            set highLandingIndex to 0
            set lowAlong to secondAlong
            set highAlong to firstAlong
        set startLandingIndex to lowLandingIndex
        set endLandingIndex to highLandingIndex
        set startAlong to lowAlong
        set endAlong to highAlong
        set closedPeriod to cutterPeriod
