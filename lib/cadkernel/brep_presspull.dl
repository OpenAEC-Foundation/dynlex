# SPDX-License-Identifier: MPL-2.0
# Port of cadkernel src/brep/presspull.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Face offsets edit cloned topology in place so concavity, holes and unrelated
# lumps are retained. Region booleans are added with the boolean dependency.
import lib/cadkernel/brep_result.dl
import lib/cadkernel/brep_pcurve.dl
import lib/cadkernel/brep_bounds.dl
import lib/cadkernel/brep_place.dl
import lib/cadkernel/brep_intersect.dl
import lib/cadkernel/area2.dl
import lib/cadkernel/brep_profile.dl
import lib/cadkernel/brep_profile_pieces.dl
import lib/cadkernel/brep_sweep.dl
import lib/cadkernel/brep_boolean.dl
import lib/cadkernel/transform2.dl
import lib/cadkernel/cross2.dl
import lib/cadkernel/containment2.dl

class:
    patterns:
        [a|] cad presspull curve loop
    members:
        values as the type of (a cad topology list of (the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))))
class:
    patterns:
        [a|] cad planar face profile
    members:
        plane as a cad plane
        loops as the type of (a cad topology list of a cad presspull curve loop)
        outward as a cad vector3
