        set offset to the cad vector at (a cad vector2 with x ((arc's radius) * (the cosine of midpoint)) and y ((arc's radius) * (the sine of midpoint))) on plane
        set tangent to the cad vector at (a cad vector2 with x ((the negative of (arc's radius)) * (the sine of midpoint)) and y ((arc's radius) * (the cosine of midpoint))) on plane
