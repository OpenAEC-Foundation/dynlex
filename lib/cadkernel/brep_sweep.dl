        if lumpNode = (0 as the type of lumpNode):
            return no cad body
        append shellKey to (lumpNode's shells's values)
        append lumpKey to (body's roots)
        return the validated cad body result of body

function the cad extrusion of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction}:
    execute:
        set normal to the cad normal of plane
        if (normal's valid) = false:
            return no cad body
        set up to the cad dot of direction and (normal's value)
        if (the absolute value of up) <= (1e-12 * (the maximum of (the cad length of direction) and 1.0)):
            return no cad body
        set ordered to the cad profile senses of profile
        if (ordered's valid) = false:
            return no cad body
        set senses to ordered's value
        set corners to a cad topology list of a cad vector2
        set handed to -0.0
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            set parameter to 1.0
            set area to the cad enclosed area of piece
            if the item at index in (senses's values):
                set parameter to 0.0
            else:
                set area to the negative of area
            append (the cad point on piece at parameter) to (corners's values)
            set handed to handed + area
        if (handed = 0.0) or (handed != handed):
            return no cad body
        set outward to (up * handed) > 0.0
        set body to an empty cad body
        set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
        set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
        set base to a cad topology list of a cad vertex key
        set top to a cad topology list of a cad vertex key
        loop index from 0 to the length of (corners's values):
            set point to the cad point at (the item at index in (corners's values)) on plane
            append (cad sweep vertex at point in body) to (base's values)
        loop index from 0 to the length of (corners's values):
            set point to the cad point at (the item at index in (corners's values)) on plane
            append (cad sweep vertex at (the cad sum of point and direction) in body) to (top's values)
        set baseEdges to cad sweep profile edges of profile on plane with senses senses and corners base in body
        if (the length of (baseEdges's values)) != (the length of profile):
            return no cad body
        set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
        set topEdges to cad sweep profile edges of profile on far with senses senses and corners top in body
        if (the length of (topEdges's values)) != (the length of profile):
            return no cad body
        set rails to a cad topology list of a cad edge key
        loop index from 0 to the length of (corners's values):
            set rail to cad sweep line from (the item at index in (base's values)) to (the item at index in (top's values)) in body
            if (rail's valid) = false:
                return no cad body
            append (rail's value) to (rails's values)
