        set firstForward to the item at 0 in (senses's values)
        set direction2 to the cad tangent of firstPiece at 0.5
        if firstForward = false:
            set direction2 to direction2 scaled by -1.0
        set tangentLength to the cad length of direction2
        if ((cad sweep revolution scalar tangentLength is finite) = false) or (tangentLength <= 1e-12):
            free cad polyline source
            return no cad body
        set tangent2 to direction2 scaled by (1.0 / tangentLength)
        set inward to a cad vector2 with x (the negative of (tangent2's y)) and y (tangent2's x)
        if handed < 0.0:
            set inward to a cad vector2 with x (tangent2's y) and y (the negative of (tangent2's x))
        set sideSign to -1.0
        if angle > 0.0:
            set sideSign to 1.0
        set middle to the cad point on firstPiece at 0.5
        set side to the cad sum of middle and (inward scaled by (offsetDistance * sideSign))
        set outlines to the cad offset polylines of source by offsetDistance toward side
