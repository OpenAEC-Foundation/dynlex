        if ordered's valid = false:
            return no cad body
        set senses to ordered's value
        set vertices to an empty list of a cad polyline vertex2
        set handed to -0.0
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            if ((piece's kind = 0) or (piece's kind = 2)) = false:
                free vertices
