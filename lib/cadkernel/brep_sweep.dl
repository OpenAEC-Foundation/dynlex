import lib/cadkernel/brep_result.dl
import lib/cadkernel/brep_profile.dl
import lib/cadkernel/nurbs_builder.dl
import lib/cadkernel/area2.dl
import lib/cadkernel/offset2.dl
import lib/cadkernel/brep_loft.dl
import lib/cadkernel/brep_profile_pieces.dl
import lib/cadkernel/brep_append.dl

class:
    patterns:
        [a|] cad sweep use
    members:
        edge as a cad edge key
        forward as a boolean
        pcurve as a cad pcurve result
class:
    patterns:
        [a|] cad sweep lifted result
    members:
        valid as a boolean
        curve as a cad edge curve3
        start as a 64 bit floating-point number
        end as a 64 bit floating-point number
class:
    patterns:
        [a|] cad sweep edge result
    members:
        valid as a boolean
        value as a cad edge key
class:
    patterns:
        [a|] cad sweep wall result
    members:
        valid as a boolean
        surface as a cad surface key
        spline as a boolean
class:
    patterns:
        [a|] cad sweep sense result
    members:
        valid as a boolean
        value as a boolean
class:
    patterns:
        [a|] cad sweep revolution station
    members:
        radius as a 64 bit floating-point number
        height as a 64 bit floating-point number
class:
    patterns:
        [a|] cad sweep projection bounds
    members:
        valid as a boolean
        low as a 64 bit floating-point number
        high as a 64 bit floating-point number
class:
    patterns:
        [a|] cad sweep revolution turn
    members:
        valid as a boolean
        pivot as a cad vector3
        axis as a cad vector3
        radial as a cad vector3
        spin as a boolean
        tolerance as a 64 bit floating-point number
class:
    patterns:
        [a|] cad sweep revolution piece
    members:
        valid as a boolean
        kind as an integer
        surface as a cad surface key
        surfaceKind as an integer
        flat as a boolean
class:
    patterns:
        [a|] cad sweep optional vertex
    members:
        valid as a boolean
        value as a cad vertex key
class:
    patterns:
        [a|] cad sweep revolved arc parameters
    members:
        valid as a boolean
        around as a 64 bit floating-point number
        start as a 64 bit floating-point number
        end as a 64 bit floating-point number

local function cad sweep [use] of {cad edge key:edge} forward {boolean:forward}:
    execute:
        return @intrinsic("construct", a cad sweep use, edge, forward, no cad pcurve)
local function cad sweep [vertex] at {cad vector3:point} in {cad body:body}:
    execute:
        return the cad body key after inserting (a cad vertex at point with provenance (the synthesized cad provenance)) into body
local function cad sweep [edge] on {cad edge curve3:curve} from {a 64 bit floating-point number:start} to {a 64 bit floating-point number:end} between {cad vertex key:first} and {cad vertex key:last} in {cad body:body}:
    execute:
        set key to the cad body key after inserting curve into body
        return the cad body key after inserting (a cad edge on key from start to end between first and last with provenance (the synthesized cad provenance)) into body
local function cad sweep line from {cad vertex key:first} to {cad vertex key:last} in {cad body:body}:
    execute:
        set start to the cad node pointer for first in body
        set end to the cad node pointer for last in body
        if (start = (0 as the type of start)) or (end = (0 as the type of end)):
            return @intrinsic("construct", a cad sweep edge result, false, a new cad edge key)
        set curve to the cad edge curve3 of (a cad line3 with origin (start's point) and direction (the cad difference of (end's point) and (start's point)))
        set key to cad sweep edge on curve from 0.0 to 1.0 between first and last in body
        return @intrinsic("construct", a cad sweep edge result, true, key)

local function cad sweep lift of {cad curve2:piece} on {cad plane:plane}:
    execute:
        set absent to @intrinsic("construct", a cad sweep lifted result, false, the cad edge curve3 of (a cad line3 with origin (the cad zero vector3) and direction (the cad zero vector3)), 0.0, 0.0)
        if (piece's kind) = 0:
            set start to the cad point at (piece's line's start) on plane
            set end to the cad point at (piece's line's end) on plane
            set curve to the cad edge curve3 of (a cad line3 with origin start and direction (the cad difference of end and start))
            return @intrinsic("construct", a cad sweep lifted result, true, curve, 0.0, 1.0)
        if (piece's kind) = 2:
            set centre to the cad point at (piece's arc's centre) on plane
            set frame to a cad plane with origin centre, x axis (plane's xAxis) and y axis (plane's yAxis)
            set start to the cad normalized angle of (piece's arc's startAngle)
            set curve to the cad edge curve3 of (a cad circle3 with plane frame and radius (piece's arc's radius))
            return @intrinsic("construct", a cad sweep lifted result, true, curve, start, start + (the cad sweep of (piece's arc)))
        if (piece's kind) = 3:
            set centre to the cad point at (piece's ellipse's ellipse's centre) on plane
            set normal to the cad normal of plane
            if (normal's valid) = false:
                return absent
            set along to the cad vector at (piece's ellipse's ellipse's majorAxis) on plane
            set frame to the cad orthonormal plane with origin centre, x axis along and normal (normal's value)
            if (frame's valid) = false:
                return absent
            set curve to the cad edge curve3 of (a cad ellipse3 with plane (frame's value), major radius (piece's ellipse's ellipse's majorRadius) and minor radius (piece's ellipse's ellipse's minorRadius))
            set start to piece's ellipse's startParameter
            return @intrinsic("construct", a cad sweep lifted result, true, curve, start, start + (the cad sweep of (piece's ellipse)))
        if (piece's kind) = 5:
            set curve to the cad edge curve3 of (a cad planar spline3 with plane plane and curve (the cad clone of (piece's nurbs)))
            return @intrinsic("construct", a cad sweep lifted result, true, curve, 0.0, 1.0)
        return absent

local function cad sweep profile [edge] of {cad curve2:piece} on {cad plane:plane} from {cad vertex key:first} to {cad vertex key:last} in {cad body:body}:
    execute:
        set lifted to cad sweep lift of piece on plane
        if (lifted's valid) = false:
            return @intrinsic("construct", a cad sweep edge result, false, a new cad edge key)
        set key to cad sweep edge on (lifted's curve) from (lifted's start) to (lifted's end) between first and last in body
        return @intrinsic("construct", a cad sweep edge result, true, key)

local function cad sweep wall of {cad curve2:piece} on {cad plane:plane} along {cad vector3:along} in {cad body:body}:
    execute:
        set absent to @intrinsic("construct", a cad sweep wall result, false, a new cad surface key, false)
        if (piece's kind) = 0:
            set start to the cad point at (piece's line's start) on plane
            set end to the cad point at (piece's line's end) on plane
            set direction to the cad difference of end and start
            set normal to the cad normalization of (the cad cross of direction and along)
            if (normal's valid) = false:
                return absent
            set frame to the cad orthonormal plane with origin start, x axis direction and normal (normal's value)
            if (frame's valid) = false:
                return absent
            set key to the cad body key after inserting (the cad surface of (frame's value)) into body
            return @intrinsic("construct", a cad sweep wall result, true, key, false)
        if (piece's kind) = 2:
            set centre to the cad point at (piece's arc's centre) on plane
            set frame to the cad orthonormal plane with origin centre, x axis (plane's xAxis) and normal along
            if (frame's valid) = false:
                return absent
            set key to the cad body key after inserting (the cad surface of (a cad cylinder with base (frame's value) and radius (piece's arc's radius))) into body
            return @intrinsic("construct", a cad sweep wall result, true, key, false)
        if ((piece's kind) = 3) or ((piece's kind) = 5):
            set built to the cad rational builder of piece
            if (built's valid) = false:
                return absent
            set base to the cad lift of (built's value) onto plane
            set top to the cad translation of base by along
            set surface to the cad ruled surface from base to top
            if (surface's valid) = false:
                return absent
            set key to the cad body key after inserting (the cad surface of (surface's value)) into body
            return @intrinsic("construct", a cad sweep wall result, true, key, true)
        return absent

local function cad sweep [sense] of {cad surface:surface} at {cad vector3:point} outward {cad vector3:out}:
    execute:
        set absent to @intrinsic("construct", a cad sweep sense result, false, false)
        set slope to 0.0
        if (surface's kind) = 4:
            set parameters to the cad parameters on surface nearest point
            if (parameters's valid) = false:
                return absent
            set normal to the cad normal of surface at parameters (parameters's value's x) and (parameters's value's y)
            if (normal's valid) = false:
                return absent
            set slope to the cad dot of (normal's value) and out
        else if (surface's kind) = 5:
            set domain to the cad domain of (surface's nurbs)
            set normal to the cad normal of surface at parameters (((domain's u's start) + (domain's u's end)) * 0.5) and (((domain's v's start) + (domain's v's end)) * 0.5)
            if (normal's valid) = false:
                return absent
            set slope to the cad dot of (normal's value) and out
        else:
            set normalized to the cad normalization of out
            if (normalized's valid) = false:
                return absent
            set step to (normalized's value) scaled by 1e-6
            set ahead to the cad sum of point and step
            set behind to the cad difference of point and step
            set slope to (the cad distance from surface to ahead) - (the cad distance from surface to behind)
        if (slope = 0.0) or (((the absolute value of slope) <= 1.7976931348623157e308) = false):
            return absent
        return @intrinsic("construct", a cad sweep sense result, true, slope > 0.0)

local function cad sweep outward of {cad curve2:piece} on {cad plane:plane} forward {boolean:forward} counterclockwise {boolean:counterclockwise}:
    execute:
        set tangent to the cad tangent of piece at 0.5
        set along to -1.0
        if forward:
            set along to 1.0
        set right to the negative of along
        if counterclockwise:
            set right to along
        return the cad vector at (a cad vector2 with x ((tangent's y) * right) and y ((the negative of (tangent's x)) * right)) on plane

local function cad sweep reordered {cad topology list:uses} outward {boolean:outward}:
    execute:
        if outward:
            return uses
        set result to a cad topology list of a cad sweep use
        loop index from 0 to the length of (uses's values):
            set usage to the item at (((the length of (uses's values)) - 1) - index) in (uses's values)
            set usage's forward to (usage's forward) = false
            if usage's pcurve's valid:
                set line to usage's pcurve's value's line
                set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (line's end) to (line's start)))
            append usage to (result's values)
        return result

# Linking preserves the creation order of faces, loops and edge uses.
local function cad sweep [face] in {cad body:body} within {cad shell key:shellKey} on {cad surface key:surfaceKey} forward {boolean:forward} using {cad topology list:uses}:
    execute:
        set faceKey to the cad body key after inserting (a cad face on surfaceKey forward forward owned by shellKey with provenance (the synthesized cad provenance)) into body
        set ringKey to the cad body key after inserting (a cad loop owned by faceKey with provenance (the synthesized cad provenance)) into body
        loop index from 0 to the length of (uses's values):
            set usage to the item at index in (uses's values)
            set coedge to the cad body key after inserting (a cad coedge on (usage's edge) forward (usage's forward) with pcurve (usage's pcurve) owned by ringKey with provenance (the synthesized cad provenance)) into body
            set edge to the cad node pointer for (usage's edge) in body
            if edge = (0 as the type of edge):
                return false
            append coedge to (edge's coedges's values)
            set ring to the cad node pointer for ringKey in body
            append coedge to (ring's coedges's values)
        set face to the cad node pointer for faceKey in body
        append ringKey to (face's loops's values)
        set shell to the cad node pointer for shellKey in body
        if shell = (0 as the type of shell):
            return false
        append faceKey to (shell's faces's values)
        return true

local function cad sweep cap in {cad body:body} within {cad shell key:shell} on {cad plane:plane} with edges {cad topology list:edges} and senses {cad topology list:senses} forward {boolean:forward} along profile {boolean:along}:
    execute:
        set uses to a cad topology list of a cad sweep use
        loop index from 0 to the length of (edges's values):
            set position to index
            if along = false:
                set position to ((the length of (edges's values)) - 1) - index
            set sense to the item at position in (senses's values)
            append (cad sweep use of (the item at position in (edges's values)) forward (sense = along)) to (uses's values)
        set key to the cad body key after inserting (the cad surface of plane) into body
        return cad sweep face in body within shell on key forward forward using uses

local function cad sweep profile [edges] of {a pointer to a list:profile} on {cad plane:plane} with senses {cad topology list:senses} and corners {cad topology list:corners} in {cad body:body}:
    execute:
        set edges to a cad topology list of a cad edge key
        loop index from 0 to the length of profile:
            set next to the remainder of (index + 1) divided by (the length of profile)
            set from to the item at index in (corners's values)
            set to to the item at next in (corners's values)
            if (the item at index in (senses's values)) = false:
                set from to the item at next in (corners's values)
                set to to the item at index in (corners's values)
            set edge to cad sweep profile edge of (the item at index in profile) on plane from from to to in body
            if (edge's valid) = false:
                return a cad topology list of a cad edge key
            append (edge's value) to (edges's values)
        return edges

local function cad sweep circuit with base {cad edge key:base}, next rail {cad edge key:next}, top {cad edge key:top} and rail {cad edge key:rail} along {boolean:forward} with spline {boolean:spline}:
    execute:
        set result to a cad topology list of a cad sweep use
        append (cad sweep use of base forward forward) to (result's values)
        append (cad sweep use of next forward true) to (result's values)
        append (cad sweep use of top forward (forward = false)) to (result's values)
        append (cad sweep use of rail forward false) to (result's values)
        if spline:
            set start to 1.0
            if forward:
                set start to 0.0
            set end to 1.0 - start
            set corners to [[start,0.0],[end,0.0],[end,1.0],[start,1.0]]
            loop index from 0 to 4:
                set first to the item at index in corners
                set last to the item at (the remainder of (index + 1) divided by 4) in corners
                set p to a cad vector2 with x (the item at 0 in first) and y (the item at 1 in first)
                set q to a cad vector2 with x (the item at 0 in last) and y (the item at 1 in last)
                set usage to the item at index in (result's values)
                set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from p to q))
                replace item at index index in (result's values) with usage
        return result

local function cad sweep revolution scalar {a 64 bit floating-point number:value} is finite:
    execute:
        return (value = value) and ((the absolute value of value) <= 1.7976931348623157e308)

local function no cad sweep projection bounds:
    execute:
        return @intrinsic("construct", a cad sweep projection bounds, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function cad sweep projection bounds between {a 64 bit floating-point number:first} and {a 64 bit floating-point number:second}:
    execute:
        if ((cad sweep revolution scalar first is finite) and (cad sweep revolution scalar second is finite)) = false:
            return no cad sweep projection bounds
        return @intrinsic("construct", a cad sweep projection bounds, true, the minimum of first and second, the maximum of first and second)

local function cad sweep revolution angle from {a 64 bit floating-point number:y} over {a 64 bit floating-point number:x}:
    execute:
        return @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, y, x)

local function cad sweep revolution positive remainder of {a 64 bit floating-point number:value}:
    execute:
        set result to the remainder of value divided by 6.283185307179586
        if result < 0.0:
            set result to result + 6.283185307179586
        return result

local function cad sweep trigonometric value with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine} at {a 64 bit floating-point number:parameter}:
    execute:
        return (centre + (cosine * (the cosine of parameter))) + (sine * (the sine of parameter))

local function cad sweep trigonometric bounds with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine}, start {a 64 bit floating-point number:start} and sweep {a 64 bit floating-point number:sweep}:
    execute:
        set finish to start + sweep
        if (((((cad sweep revolution scalar centre is finite) and (cad sweep revolution scalar cosine is finite)) and (cad sweep revolution scalar sine is finite)) and (cad sweep revolution scalar start is finite)) and ((cad sweep revolution scalar sweep is finite) and (sweep > 0.0))) = false:
            return no cad sweep projection bounds
        if (cad sweep revolution scalar finish is finite) = false:
            return no cad sweep projection bounds
        set first to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at start
        set last to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at finish
        set interval to cad sweep projection bounds between first and last
        if (interval's valid) = false:
            return interval
        set maximumParameter to cad sweep revolution angle from sine over cosine
        loop offsetIndex from 0 to 2:
            set extreme to maximumParameter + ((offsetIndex as a 64 bit floating-point number) * 3.141592653589793)
            set offset to cad sweep revolution positive remainder of (extreme - start)
            if (sweep >= (6.283185307179586 - 1e-12)) or (offset <= (sweep + 1e-12)):
                set measured to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at extreme
                if (cad sweep revolution scalar measured is finite) = false:
                    return no cad sweep projection bounds
                set interval's low to the minimum of (interval's low) and measured
                set interval's high to the maximum of (interval's high) and measured
        return interval

local function cad sweep projection of {cad vector3:point} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        return the cad dot of (the cad difference of point and origin) and direction

local function cad sweep projection bounds of {cad curve2:piece} on {cad plane:plane} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        if (piece's kind) = 0:
            set first to cad sweep projection of (the cad point at (piece's line's start) on plane) from origin along direction
            set second to cad sweep projection of (the cad point at (piece's line's end) on plane) from origin along direction
            return cad sweep projection bounds between first and second
        if (piece's kind) = 2:
            set arc to piece's arc
            set centre to cad sweep projection of (the cad point at (arc's centre) on plane) from origin along direction
            set cosineVector to the cad vector at (a cad vector2 with x (arc's radius) and y 0.0) on plane
            set sineVector to the cad vector at (a cad vector2 with x 0.0 and y (arc's radius)) on plane
            set cosine to the cad dot of cosineVector and direction
            set sine to the cad dot of sineVector and direction
            return cad sweep trigonometric bounds with centre centre, cosine cosine, sine sine, start (arc's startAngle) and sweep (the cad sweep of arc)
        return no cad sweep projection bounds

local function no cad sweep revolution turn:
    execute:
        return @intrinsic("construct", a cad sweep revolution turn, false, the cad zero vector3, the cad zero vector3, the cad zero vector3, false, 0.0 as a 64 bit floating-point number)

local function cad sweep complete revolution turn of {a pointer to a list:profile} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a 64 bit floating-point number:angle}:
    execute:
        set normalResult to the cad normal of plane
        set directionResult to the cad normalization of axis
        if ((normalResult's valid) and (directionResult's valid)) = false:
            return no cad sweep revolution turn
        set direction to directionResult's value
        set turnAngle to angle
        if turnAngle < 0.0:
            set direction to the cad negative of direction
            set turnAngle to 0.0 - turnAngle
        if ((cad sweep revolution scalar turnAngle is finite) = false) or ((turnAngle <= 0.0) or (turnAngle > (6.283185307179586 + 1e-12))):
            return no cad sweep revolution turn
        if (the absolute value of (6.283185307179586 - turnAngle)) > 1e-9:
            return no cad sweep revolution turn
        set planeDistance to the cad distance from pivot to plane
        if (planeDistance's valid) = false:
            return no cad sweep revolution turn
        if ((the absolute value of (the cad dot of direction and (normalResult's value))) > 1e-9) or ((the absolute value of (planeDistance's value)) > 1e-9):
            return no cad sweep revolution turn
        set radialResult to the cad normalization of (the cad cross of (normalResult's value) and direction)
        if (radialResult's valid) = false:
            return no cad sweep revolution turn
        set radial to radialResult's value
        set spin to (the cad dot of (normalResult's value) and (the cad cross of direction and radial)) > 0.0
        set foundFirst to false
        set scaleOrigin to the cad zero vector3
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            if ((piece's kind) != 0) and ((piece's kind) != 2):
                return no cad sweep revolution turn
            if foundFirst = false:
                set scaleOrigin to the cad point at (the cad point on piece at 0.0) on plane
                set foundFirst to true
        if foundFirst = false:
            return no cad sweep revolution turn
        set radialBounds to no cad sweep projection bounds
        set heightBounds to no cad sweep projection bounds
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            set pieceRadial to cad sweep projection bounds of piece on plane from pivot along radial
            set pieceHeight to cad sweep projection bounds of piece on plane from scaleOrigin along direction
            if ((pieceRadial's valid) and (pieceHeight's valid)) = false:
                return no cad sweep revolution turn
            if radialBounds's valid:
                set radialBounds's low to the minimum of (radialBounds's low) and (pieceRadial's low)
                set radialBounds's high to the maximum of (radialBounds's high) and (pieceRadial's high)
            else:
                set radialBounds to pieceRadial
            if heightBounds's valid:
                set heightBounds's low to the minimum of (heightBounds's low) and (pieceHeight's low)
                set heightBounds's high to the maximum of (heightBounds's high) and (pieceHeight's high)
            else:
                set heightBounds to pieceHeight
        set radialMagnitude to the maximum of (the absolute value of (radialBounds's low)) and (the absolute value of (radialBounds's high))
        set profileScale to the maximum of radialMagnitude and ((heightBounds's high) - (heightBounds's low))
        set tolerance to 1e-9 * (the maximum of profileScale and 1.0)
        if profileScale <= tolerance:
            return no cad sweep revolution turn
        set reachesNegative to (radialBounds's low) < (the negative of tolerance)
        set reachesPositive to (radialBounds's high) > tolerance
        if reachesNegative and reachesPositive:
            return no cad sweep revolution turn
        if (reachesNegative or reachesPositive) = false:
            return no cad sweep revolution turn
        if reachesPositive = false:
            set radial to the cad negative of radial
            set spin to spin = false
        return @intrinsic("construct", a cad sweep revolution turn, true, pivot, direction, radial, spin, tolerance)

local function cad sweep revolution station at {cad vector2:uv} on {cad plane:plane} for {cad sweep revolution turn:turn}:
    execute:
        set offset to the cad difference of (the cad point at uv on plane) and (turn's pivot)
        return @intrinsic("construct", a cad sweep revolution station, the cad dot of offset and (turn's radial), the cad dot of offset and (turn's axis))

local function cad sweep revolution circle at {a 64 bit floating-point number:height} for {cad sweep revolution turn:turn}:
    execute:
        set centre to the cad sum of (turn's pivot) and ((turn's axis) scaled by height)
        return the cad orthonormal plane with origin centre, x axis (turn's radial) and normal (turn's axis)

local function no cad sweep revolution piece:
    execute:
        return @intrinsic("construct", a cad sweep revolution piece, false, 2, a new cad surface key, 0, false)

local function collapsed cad sweep revolution piece:
    execute:
        return @intrinsic("construct", a cad sweep revolution piece, true, 0, a new cad surface key, 0, false)

local function cad sweep revolution piece on {cad surface:surface} flat {boolean:flat} in {cad body:body}:
    execute:
        set surfaceKey to the cad body key after inserting surface into body
        return @intrinsic("construct", a cad sweep revolution piece, true, 1, surfaceKey, surface's kind, flat)

local function cad sweep revolution surface of {cad curve2:piece} on {cad plane:plane} for {cad sweep revolution turn:turn} in {cad body:body}:
    execute:
        set radialBounds to cad sweep projection bounds of piece on plane from (turn's pivot) along (turn's radial)
        if radialBounds's valid = false:
            return no cad sweep revolution piece
        set reachesNegative to (radialBounds's low) < (the negative of (turn's tolerance))
        set reachesPositive to (radialBounds's high) > (turn's tolerance)
        if (reachesNegative or reachesPositive) = false:
            return collapsed cad sweep revolution piece
        if (piece's kind) = 0:
            set first to cad sweep revolution station at (piece's line's start) on plane for turn
            set second to cad sweep revolution station at (piece's line's end) on plane for turn
            set frameResult to cad sweep revolution circle at (first's height) for turn
            if frameResult's valid = false:
                return no cad sweep revolution piece
            if (the absolute value of ((second's height) - (first's height))) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (frameResult's value)) flat true in body
            if (the absolute value of ((second's radius) - (first's radius))) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (a cad cylinder with base (frameResult's value) and radius (first's radius))) flat false in body
            set halfAngle to @intrinsic("call", "libc", "atan", a 64 bit floating-point number, ((first's radius) - (second's radius)) / ((second's height) - (first's height)))
            return cad sweep revolution piece on (the cad surface of (a cad cone with base (frameResult's value), radius (first's radius) and half angle halfAngle)) flat false in body
        if (piece's kind) = 2:
            set centreStation to cad sweep revolution station at (piece's arc's centre) on plane for turn
            set frameResult to cad sweep revolution circle at (centreStation's height) for turn
            if frameResult's valid = false:
                return no cad sweep revolution piece
            if (the absolute value of (centreStation's radius)) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (a cad sphere with frame (frameResult's value) and radius (piece's arc's radius))) flat false in body
            return cad sweep revolution piece on (the cad surface of (a cad torus with frame (frameResult's value), major radius (the absolute value of (centreStation's radius)) and minor radius (piece's arc's radius))) flat false in body
        return no cad sweep revolution piece

local function cad sweep revolution turned {cad vector3:vector} by {a 64 bit floating-point number:angle} for {cad sweep revolution turn:turn}:
    execute:
        set cosine to the cosine of angle
