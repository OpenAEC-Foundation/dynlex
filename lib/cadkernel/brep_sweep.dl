local function cad sweep offset area of {cad polyline2:outline}:
    execute:
        set curve to the cad curve2 of outline
        set pieces to the cad segments of curve
        set total to 0.0
        loop index from 0 to the length of pieces:
            set total to total + (the cad enclosed area of (the item at index in pieces))
