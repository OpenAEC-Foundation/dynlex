            set coordinateScale to the maximum of offsetDistance and 1.0
            loop vertexIndex from 0 to the length of profile:
                set startPoint to the cad point on (the item at vertexIndex in profile) at 0.0
                set finishPoint to the cad point on (the item at vertexIndex in profile) at 1.0
                set coordinateScale to the maximum of coordinateScale and (the absolute value of (startPoint's x))
                set coordinateScale to the maximum of coordinateScale and (the absolute value of (startPoint's y))
                set coordinateScale to the maximum of coordinateScale and (the absolute value of (finishPoint's x))
                set coordinateScale to the maximum of coordinateScale and (the absolute value of (finishPoint's y))
