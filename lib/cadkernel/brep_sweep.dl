                        if arcParameters's valid:
                            set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x far and y ending) to (a cad vector2 with x near and y ending)))
                        append usage to (circuit's values)
                    set usage to cad sweep use of (seam's value) forward ((the item at index in (senses's values)) = false)
                    if arcParameters's valid:
                        set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x near and y ending) to (a cad vector2 with x near and y beginning)))
                    append usage to (circuit's values)
