# Positive angles move the far outline inward; negative angles move it outward.
# The offset distance uses the component normal to the profile plane, matching
# the wall angle for oblique extrusion vectors.
function the tapered cad extrusion of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction} by {a number:givenAngle}:
    execute:
        set angle to givenAngle as a 64 bit floating-point number
        if ((cad sweep revolution scalar angle is finite) = false) or ((the absolute value of angle) >= 1.5707963267948966):
            return no cad body
        if (the absolute value of angle) <= 1e-12:
            return the cad extrusion of profile on plane along direction
        set normal to the cad normal of plane
        if normal's valid = false:
            return no cad body
        set circular to false
        set circularCentre to the cad zero vector2
        set circularRadius to 0.0 as a 64 bit floating-point number
        if (the length of profile) > 0:
            set firstPiece to the item at 0 in profile
            if ((the length of profile) = 1) and (firstPiece's kind = 1):
                set circular to true
                set circularCentre to firstPiece's circle's centre
                set circularRadius to firstPiece's circle's radius
            else if firstPiece's kind = 2:
                set circular to true
                set circularCentre to firstPiece's arc's centre
                set circularRadius to firstPiece's arc's radius
                set totalSweep to 0.0 as a 64 bit floating-point number
