                    set start to the item at index in corners
                    set finish to the item at (the remainder of (index + 1) divided by 4) in corners
                    set firstPoint to a cad vector2 with x (the item at 0 in start) and y (the item at 1 in start)
                    set lastPoint to a cad vector2 with x (the item at 0 in finish) and y (the item at 1 in finish)
