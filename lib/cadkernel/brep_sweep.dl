                if ((corner's valid) and (frameResult's valid)) = false:
                    return no cad body
                set circle to the cad edge curve3 of (a cad circle3 with plane (frameResult's value) and radius ((the item at index in (stations's values))'s radius))
                set edgeKey to cad sweep edge on circle from 0.0 to 6.283185307179586 between (corner's value) and (corner's value) in body
