# DynLex Set Library

import lib/list.dl

class:
    patterns:
        [a|] unique set
    members:
        values

to get an empty set of {type:kind}:
    set values to an empty list of kind
    set initial to @intrinsic("construct", a unique set, values)
    set result to storage for one slot initialized with initial
    return result

to get the size of {a pointer to a unique set:items}:
    return the length of the values of items

to get {a pointer to a unique set:items} contains value:
    return the values of items contains value

to get {a pointer to a unique set:items} does not contain value:
    return the values of items does not contain value

to add value to {a pointer to a unique set:items}:
    if items does not contain value:
        append value to the values of items

to remove value from {a pointer to a unique set:items}:
    set position to the index of value in the values of items
    if position >= 0:
        remove item position from the values of items

to clear {a pointer to a unique set:items}:
    clear the values of items

to free {a pointer to a unique set:items}:
    free (the values of items)
    deallocate items
