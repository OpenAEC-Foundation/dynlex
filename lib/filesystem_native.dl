# DynLex native filesystem snapshot and transaction primitives

import lib/std.dl

class:
    patterns:
        [a|] file system timestamp
    members:
        seconds as a word sized integer
        nanoseconds as an integer

class:
    patterns:
        [a|] file identity
    members:
        support as a boolean
        availability as a boolean
        representation as a string

class:
    patterns:
        [a|] file system entry
    members:
        support as a boolean
        success as a boolean
        presence as a boolean
        regular file kind as a boolean
        directory kind as a boolean
        symbolic link kind as a boolean
        other kind as a boolean
        mode support as a boolean
        mode as a word sized integer
        Windows attributes support as a boolean
        Windows attributes as a word sized integer
        restorable Windows attributes as a word sized integer
        access time support as a boolean
        access time as a file system timestamp
        modification time support as a boolean
        modification time as a file system timestamp
        creation time support as a boolean
        creation time as a file system timestamp
        identity as a file identity
        error message as a string

class:
    patterns:
        [a|] file system staging file
    members:
        handle as a pointer
        support as a boolean
        success as a boolean
        path as a string
        commit outcome knowledge as a boolean
        commitment as a boolean
        durability as a boolean
        cleanup success as a boolean
        error message as a string
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_staging_retain", nothing, handle)
        set owner to the owner of the path of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set references to @intrinsic("dereference", owner)
            @intrinsic("store at", owner, references + 1)
        set owner to the owner of the error message of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set references to @intrinsic("dereference", owner)
            @intrinsic("store at", owner, references + 1)
    release:
        set owner to the owner of the error message of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set references to @intrinsic("dereference", owner)
            if references = 1:
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, references - 1)
        set owner to the owner of the path of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set references to @intrinsic("dereference", owner)
            if references = 1:
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, references - 1)
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_staging_release", nothing, handle)

local class:
    patterns:
        [a|] native filesystem path
    members:
        data as a pointer to a byte
        length as a word sized integer
        storage as a string
        validity as a boolean

local function {native filesystem path:path} is invalid:
    replacement:
        the inverse of path's validity

local class:
    patterns:
        [a|] file metadata support record
    members:
        mode as an integer
        Windows attributes as an integer
        access time as an integer
        modification time as an integer
        creation time as an integer
        identity as an integer

function {file identity:identity} is supported:
    replacement:
        identity's support

function {file identity:identity} is unsupported:
    replacement:
        the inverse of identity's support

function {file identity:identity} is available:
    replacement:
        identity's availability

function {file identity:identity} is unavailable:
    replacement:
        the inverse of identity's availability

function {file system entry:entry} is supported:
    replacement:
        entry's support

function {file system entry:entry} is unsupported:
    replacement:
        the inverse of entry's support

function {file system entry:entry} lookup succeeded:
    replacement:
        entry's success

function {file system entry:entry} lookup failed:
    replacement:
        the inverse of entry's success

function {file system entry:entry} was found:
    replacement:
        entry's presence

function {file system entry:entry} was absent:
    replacement:
        the inverse of entry's presence

function {file system entry:entry} is a regular file:
    replacement:
        entry's regular file kind

function {file system entry:entry} is not a regular file:
    replacement:
        the inverse of entry's regular file kind

function {file system entry:entry} is a directory:
    replacement:
        entry's directory kind

function {file system entry:entry} is not a directory:
    replacement:
        entry's directory kind = false

function {file system entry:entry} is a symbolic link:
    replacement:
        entry's symbolic link kind

function {file system entry:entry} is not a symbolic link:
    replacement:
        entry's symbolic link kind = false

function {file system entry:entry} has another filesystem kind:
    replacement:
        entry's other kind

function {file system entry:entry} does not have another filesystem kind:
    replacement:
        entry's other kind = false

function {file system entry:entry}'s mode is supported:
    replacement:
        entry's mode support

function {file system entry:entry}'s mode is unsupported:
    replacement:
        the inverse of entry's mode support

function {file system entry:entry}'s Windows attributes are supported:
    replacement:
        entry's Windows attributes support

function {file system entry:entry}'s Windows attributes are unsupported:
    replacement:
        the inverse of entry's Windows attributes support

function {file system entry:entry}'s access time is supported:
    replacement:
        entry's access time support

function {file system entry:entry}'s access time is unsupported:
    replacement:
        the inverse of entry's access time support

function {file system entry:entry} supports modification times:
    replacement:
        entry's modification time support

function {file system entry:entry} does not support modification times:
    replacement:
        the inverse of entry's modification time support

function {file system entry:entry}'s creation time is supported:
    replacement:
        entry's creation time support

function {file system entry:entry}'s creation time is unsupported:
    replacement:
        the inverse of entry's creation time support

function {file system staging file:staging} is supported:
    replacement:
        staging's support

function {file system staging file:staging} is unsupported:
    replacement:
        the inverse of staging's support

function {file system staging file:staging} succeeded:
    replacement:
        staging's success

function {file system staging file:staging} failed:
    replacement:
        the inverse of staging's success

function {file system staging file:staging}'s commit outcome is known:
    replacement:
        staging's commit outcome knowledge

function {file system staging file:staging} was committed:
    replacement:
        staging's commitment

function {file system staging file:staging} was not committed:
    replacement:
        staging's commitment = false

function {file system staging file:staging} is durable:
    replacement:
        staging's durability

function {file system staging file:staging} is not durable:
    replacement:
        staging's durability = false

function {file system staging file:staging}'s cleanup succeeded:
    replacement:
        staging's cleanup success

function {file system staging file:staging}'s cleanup failed:
    replacement:
        the inverse of staging's cleanup success

local function an empty native filesystem failure text:
    execute:
        return the string form of ""

local function the current native filesystem failure text:
    execute:
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_error_message",
            a word sized integer,
            0 as a pointer to a byte,
            0 as a word sized integer
        )
        set message to a new string buffer containing (size as an integer) bytes
        if size > (0 as a word sized integer):
            ignore @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_filesystem_error_message",
                a word sized integer,
                the data of message,
                size + 1
            )
        return message

local function an invalid native filesystem path:
    execute:
        set storage to @intrinsic(
            "construct",
            a string,
            0 as a pointer to a byte,
            0,
            0 as a pointer to an integer
        )
        return @intrinsic(
            "construct",
            a native filesystem path,
            0 as a pointer to a byte,
            0 as a word sized integer,
            storage,
            false
        )

local function a native filesystem path for {C string:input}:
    execute:
        if input = (0 as a pointer to a byte):
            return an invalid native filesystem path
        set storage to @intrinsic(
            "construct",
            a string,
            0 as a pointer to a byte,
            0,
            0 as a pointer to an integer
        )
        return @intrinsic(
            "construct",
            a native filesystem path,
            input,
            (the length of input) as a word sized integer,
            storage,
            true
        )

local function a native filesystem path for {string:input}:
    execute:
        if input is invalid:
            return an invalid native filesystem path
        if input's length = 0:
            return an invalid native filesystem path
        set terminator to @intrinsic(
            "call",
            "libc",
            "memchr",
            a pointer to a byte,
            the data of input,
            0,
            input's length as a word sized integer
        )
        if terminator != (0 as a pointer to a byte):
            return an invalid native filesystem path
        set storage to a new string buffer containing input's length bytes
        ignore @intrinsic(
            "call",
            "libc",
            "memcpy",
            a pointer to a byte,
            the data of storage,
            the data of input,
            input's length as a word sized integer
        )
        return @intrinsic(
            "construct",
            a native filesystem path,
            the data of storage,
            storage's length as a word sized integer,
            storage,
            true
        )

local function an empty file system timestamp:
    replacement:
        @intrinsic("construct", a file system timestamp, 0 as a 64 bit integer, 0)

local function a supported file system entry failure reporting {string:message}:
    execute:
        set timestamp to an empty file system timestamp
        set identity to @intrinsic("construct", a file identity, false, false, the string form of "")
        return @intrinsic(
            "construct",
            a file system entry,
            true,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            0 as a 64 bit integer,
            false,
            0 as a 64 bit integer,
            0 as a 64 bit integer,
            false,
            timestamp,
            false,
            timestamp,
            false,
            timestamp,
            identity,
            message
        )

function {file identity:left} identifies the same file as {file identity:right}:
    execute:
        if left is unsupported:
            return false
        if right is unsupported:
            return false
        if left is unavailable:
            return false
        if right is unavailable:
            return false
        return left's representation = right's representation

function the file system entry at {a value:path}:
    execute:
        set prepared to a native filesystem path for path
        if prepared is invalid:
            set message to the string form of "Invalid filesystem path"
            return a supported file system entry failure reporting message

        set kind to 0
        set support to @intrinsic("construct", a file metadata support record, 0, 0, 0, 0, 0, 0)
        set mode to 0 as a word sized integer
        set attributes to 0 as a word sized integer
        set restoration to 0 as a word sized integer
        set access to an empty file system timestamp
        set modification to an empty file system timestamp
        set creation to an empty file system timestamp
        set extent to 0 as a word sized integer
        set buffer to a new string buffer containing 26 bytes
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_entry",
            an integer,
            prepared's data,
            prepared's length,
            the address of kind,
            the address of (support's mode),
            the address of mode,
            the address of (support's Windows attributes),
            the address of attributes,
            the address of restoration,
            the address of (support's access time),
            the address of (access's seconds),
            the address of (access's nanoseconds),
            the address of (support's modification time),
            the address of (modification's seconds),
            the address of (modification's nanoseconds),
            the address of (support's creation time),
            the address of (creation's seconds),
            the address of (creation's nanoseconds),
            the address of (support's identity),
            the data of buffer,
            buffer's length as a word sized integer,
            the address of extent
        )
        if outcome < 0:
            return a supported file system entry failure reporting the current native filesystem failure text

        set representation to the string form of ""
        if extent > (0 as a word sized integer):
            set representation to the substring of buffer from 0 spanning (extent as an integer) bytes
        set identity to @intrinsic(
            "construct",
            a file identity,
            support's identity != 0,
            extent > (0 as a word sized integer),
            representation
        )
        return @intrinsic(
            "construct",
            a file system entry,
            true,
            true,
            outcome = 1,
            kind = 1,
            kind = 2,
            kind = 3,
            kind = 4,
            support's mode != 0,
            mode,
            support's Windows attributes != 0,
            attributes,
            restoration,
            support's access time != 0,
            access,
            support's modification time != 0,
            modification,
            support's creation time != 0,
            creation,
            identity,
            an empty native filesystem failure text
        )

local function a supported staging file creation failure reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a file system staging file,
            0 as a pointer to a byte,
            true,
            false,
            the string form of "",
            false,
            false,
            false,
            false,
            message
        )

local function an unsupported staging file creation failure reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a file system staging file,
            0 as a pointer to a byte,
            false,
            false,
            the string form of "",
            false,
            false,
            false,
            false,
            message
        )

local function a supported staging operation failure derived from {file system staging file:staging} reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a file system staging file,
            staging's handle,
            true,
            false,
            staging's path,
            staging's commit outcome knowledge,
            staging's commitment,
            staging's durability,
            staging's cleanup success,
            message
        )

local function an unsupported staging operation failure derived from {file system staging file:staging} reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a file system staging file,
            staging's handle,
            false,
            false,
            staging's path,
            staging's commit outcome knowledge,
            staging's commitment,
            staging's durability,
            staging's cleanup success,
            message
        )

local function a supported staging operation success derived from {file system staging file:staging}:
    replacement:
        @intrinsic(
            "construct",
            a file system staging file,
            staging's handle,
            true,
            true,
            staging's path,
            staging's commit outcome knowledge,
            staging's commitment,
            staging's durability,
            staging's cleanup success,
            an empty native filesystem failure text
        )

local function the result of creating a staging file beside target:
    execute:
        set prepared to a native filesystem path for target
        if prepared is invalid:
            set message to the string form of "Invalid filesystem path"
            return a supported staging file creation failure reporting message
        set unsupported to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_transactions_supported",
            an integer
        ) = 0
        if unsupported:
            set message to the string form of "Native filesystem transactions are unsupported on this target"
            return an unsupported staging file creation failure reporting message
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_create",
            a pointer to a byte,
            prepared's data,
            prepared's length
        )
        if handle = (0 as a pointer to a byte):
            return a supported staging file creation failure reporting the current native filesystem failure text
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_staging_retain", nothing, handle)
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_path_length",
            a word sized integer,
            handle
        )
        set path to a new string buffer containing (size as an integer) bytes
        set copied to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_copy_path",
            an integer,
            handle,
            the data of path,
            size + 1
        )
        if copied != 0:
            set message to the current native filesystem failure text
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_staging_release", nothing, handle)
            return a supported staging file creation failure reporting message
        set outcome to @intrinsic(
            "construct",
            a file system staging file,
            handle,
            true,
            true,
            path,
            false,
            false,
            false,
            false,
            an empty native filesystem failure text
        )
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_staging_release", nothing, handle)
        return outcome

flex function create a staging file beside target:
    replacement:
        set the subject to the result of creating a staging file beside target

local function the result of writing {string:contents} to {file system staging file:staging}:
    execute:
        if staging's handle = (0 as a pointer to a byte):
            if staging is supported:
                return a supported staging operation failure derived from staging reporting staging's error message
            return an unsupported staging operation failure derived from staging reporting staging's error message
        if contents is invalid:
            return a supported staging operation failure derived from staging reporting the string form of "Invalid file contents"
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_write",
            an integer,
            staging's handle,
            the data of contents,
            contents's length as a word sized integer
        )
        if outcome != 0:
            return a supported staging operation failure derived from staging reporting the current native filesystem failure text
        return a supported staging operation success derived from staging

flex function write {string:contents} to {file system staging file:staging}:
    replacement:
        set the subject to the result of writing contents to staging

local function the result of restoring metadata from {file system entry:snapshot} to {file system staging file:staging}:
    execute:
        if staging's handle = (0 as a pointer to a byte):
            if staging is supported:
                return a supported staging operation failure derived from staging reporting staging's error message
            return an unsupported staging operation failure derived from staging reporting staging's error message
        if snapshot lookup failed or snapshot was absent:
            return a supported staging operation failure derived from staging reporting the string form of "Metadata snapshot does not describe an existing filesystem entry"
        set access to snapshot's access time
        set modification to snapshot's modification time
        set creation to snapshot's creation time
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_restore_metadata",
            an integer,
            staging's handle,
            snapshot's mode support,
            snapshot's mode,
            snapshot's Windows attributes support,
            snapshot's restorable Windows attributes,
            snapshot's access time support,
            access's seconds,
            access's nanoseconds,
            snapshot's modification time support,
            modification's seconds,
            modification's nanoseconds,
            snapshot's creation time support,
            creation's seconds,
            creation's nanoseconds
        )
        if outcome = -2:
            return an unsupported staging operation failure derived from staging reporting the current native filesystem failure text
        if outcome != 0:
            return a supported staging operation failure derived from staging reporting the current native filesystem failure text
        return a supported staging operation success derived from staging

flex function restore metadata from {file system entry:snapshot} to {file system staging file:staging}:
    replacement:
        set the subject to the result of restoring metadata from snapshot to staging

local function the result of cancelling {file system staging file:staging}:
    execute:
        if staging's handle = (0 as a pointer to a byte):
            if staging is supported:
                return a supported staging operation failure derived from staging reporting staging's error message
            return an unsupported staging operation failure derived from staging reporting staging's error message
        set cleanup to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_cancel",
            an integer,
            staging's handle,
            the address of cleanup
        )
        if outcome != 0:
            return @intrinsic(
                "construct",
                a file system staging file,
                staging's handle,
                true,
                false,
                staging's path,
                staging's commit outcome knowledge,
                staging's commitment,
                staging's durability,
                cleanup != 0,
                the current native filesystem failure text
            )
        return @intrinsic(
            "construct",
            a file system staging file,
            staging's handle,
            true,
            true,
            staging's path,
            staging's commit outcome knowledge,
            staging's commitment,
            staging's durability,
            cleanup != 0,
            an empty native filesystem failure text
        )

flex function cancel {file system staging file:staging}:
    replacement:
        set the subject to the result of cancelling staging

local function the result of committing {file system staging file:staging} where overwriting is {boolean:replacement} and durability is {boolean:persistence}:
    execute:
        if staging's handle = (0 as a pointer to a byte):
            return @intrinsic(
                "construct",
                a file system staging file,
                staging's handle,
                staging's support,
                false,
                staging's path,
                true,
                false,
                false,
                false,
                staging's error message
            )
        set knowledge to 1
        set committed to 0
        set durable to 0
        set cleanup to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_staging_commit",
            an integer,
            staging's handle,
            replacement,
            persistence,
            the address of knowledge,
            the address of committed,
            the address of durable,
            the address of cleanup
        )
        set supported to outcome != -2
        set succeeded to (outcome = 0)
        set failed to outcome != 0
        set message to an empty native filesystem failure text
        if failed:
            set message to the current native filesystem failure text
        return @intrinsic(
            "construct",
            a file system staging file,
            staging's handle,
            supported,
            succeeded,
            staging's path,
            knowledge != 0,
            committed != 0,
            durable != 0,
            cleanup != 0,
            message
        )

flex function commit {file system staging file:staging} where overwriting is {boolean:replacement} and durability is {boolean:persistence}:
    replacement:
        set the subject to the result of committing staging where overwriting is replacement and durability is persistence
