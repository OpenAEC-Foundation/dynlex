import std.dl

class:
    patterns:
        [a|] cpu vector
        vector
    members:
        x, y, z

function [a|] gpu vector:
    replacement:
        @intrinsic("vector", 3)

function [a|] vector type:
    replacement:
        a gpu vector if the build info "platform" = "gpu", else a cpu vector

function a new vector with x vx, y vy and z vz:
    replacement:
        @intrinsic("construct", a vector type, vx, vy, vz)

function a new vector from x y z:
    replacement:
        @intrinsic("construct", a vector type, x, y, z)

function {vector:left} + right:
    execute:
        return a new vector from the x of left + right the y of left + right the z of left + right

function {vector:left} * factor:
    execute:
        return a new vector from the x of left * factor the y of left * factor the z of left * factor

function [the|] string form of {vector:msg}:
    execute:
        set result to the string form of "["
        set separator to the string form of ", "
        set result to (result + the string form of the x of msg)
        set result to (result + separator)
        set result to (result + the string form of the y of msg)
        set result to (result + separator)
        set result to (result + the string form of the z of msg)
        set result to (result + the string form of "]")
        return result
