import std.dl

class:
    patterns:
        [a|] CPU vector
    members:
        x, y, z

[a|] GPU vector means: @intrinsic("vector", 3)
vector means: a GPU vector if the build target is GPU, else a CPU vector
[the vector type] means: vector

function {a GPU vector:value}['s|'] x:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        the element at 0 in value
function {a GPU vector:value}['s|'] y:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        the element at 1 in value
function {a GPU vector:value}['s|'] z:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        the element at 2 in value
function the x of {a GPU vector:value}:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        value's x
function the y of {a GPU vector:value}:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        value's y
function the z of {a GPU vector:value}:
    before: $ + $, $ - $, $ * $, $ / $, set $ to $
    replacement:
        value's z

flex function set the x coordinate of {vector:target} to {a number:value}:
    replacement:
        if the build target is GPU:
            set target to the aggregate formed by replacing element 0 in target with (value as (the type of (target's x)))
        else:
            @intrinsic("store", target's x, value)
flex function set the y coordinate of {vector:target} to {a number:value}:
    replacement:
        if the build target is GPU:
            set target to the aggregate formed by replacing element 1 in target with (value as (the type of (target's y)))
        else:
            @intrinsic("store", target's y, value)
flex function set the z coordinate of {vector:target} to {a number:value}:
    replacement:
        if the build target is GPU:
            set target to the aggregate formed by replacing element 2 in target with (value as (the type of (target's z)))
        else:
            @intrinsic("store", target's z, value)

a new vector with x {a number:horizontal}, y {a number:vertical} and z {a number:depth} means: @intrinsic("construct", the vector type, horizontal, vertical, depth)

function {vector:left} + {vector:right}:
    before: $ or $, $ and $, $ = $, $ != $, $ < $, $ > $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set horizontal to leftHorizontal + rightHorizontal
        set vertical to leftVertical + rightVertical
        set depth to leftDepth + rightDepth
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} + {a number:right}:
    before: $ or $, $ and $, $ = $, $ != $, $ < $, $ > $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set horizontal to ((the x of left) + right)
        set vertical to ((the y of left) + right)
        set depth to ((the z of left) + right)
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} - {vector:right}:
    before: $ or $, $ and $, $ = $, $ != $, $ < $, $ > $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set horizontal to leftHorizontal - rightHorizontal
        set vertical to leftVertical - rightVertical
        set depth to leftDepth - rightDepth
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} * {vector:right}:
    before: $ + $, $ - $
    execute:
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set horizontal to leftHorizontal * rightHorizontal
        set vertical to leftVertical * rightVertical
        set depth to leftDepth * rightDepth
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} / {vector:right}:
    before: $ + $, $ - $
    execute:
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set horizontal to leftHorizontal / rightHorizontal
        set vertical to leftVertical / rightVertical
        set depth to leftDepth / rightDepth
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} * {a number:factor}:
    before: $ + $, $ - $
    execute:
        set horizontal to ((the x of left) * factor)
        set vertical to ((the y of left) * factor)
        set depth to ((the z of left) * factor)
        return a new vector with x horizontal, y vertical and z depth

function {a number:factor} * {vector:right}:
    before: $ + $, $ - $
    execute:
        set horizontal to factor * (the x of right)
        set vertical to factor * (the y of right)
        set depth to factor * (the z of right)
        return a new vector with x horizontal, y vertical and z depth

function {vector:left} / {a number:divisor}:
    before: $ + $, $ - $
    execute:
        set horizontal to (the x of left) / divisor
        set vertical to (the y of left) / divisor
        set depth to (the z of left) / divisor
        return a new vector with x horizontal, y vertical and z depth

to get the string form of {vector:value}:
    return formatted "[{the x of value}, {the y of value}, {the z of value}]"

to get the dot product of {vector:left} and {vector:right}:
    set leftHorizontal to the x of left
    set leftVertical to the y of left
    set leftDepth to the z of left
    set rightHorizontal to the x of right
    set rightVertical to the y of right
    set rightDepth to the z of right
    set horizontal to leftHorizontal * rightHorizontal
    set vertical to leftVertical * rightVertical
    set depth to leftDepth * rightDepth
    return (horizontal + vertical) + depth

to get the cross product of {vector:left} and {vector:right}:
    return a new vector with x ((the y of left) * (the z of right) - (the z of left) * (the y of right)), y ((the z of left) * (the x of right) - (the x of left) * (the z of right)) and z ((the x of left) * (the y of right) - (the y of left) * (the x of right))

to get the squared length of {vector:value}:
    return the dot product of value and value

to get the length of {vector:value}:
    return the square root of the squared length of value

to get {vector:value} normalized:
    set magnitude to the length of value
    if magnitude = 0.0:
        set horizontal to 0.0 as (the type of ((the x of value) / magnitude))
        set vertical to 0.0 as (the type of ((the y of value) / magnitude))
        set depth to 0.0 as (the type of ((the z of value) / magnitude))
        return a new vector with x horizontal, y vertical and z depth
    set horizontal to (the x of value) / magnitude
    set vertical to (the y of value) / magnitude
    set depth to (the z of value) / magnitude
    return a new vector with x horizontal, y vertical and z depth
