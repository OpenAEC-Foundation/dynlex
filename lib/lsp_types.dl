# Shared Language Server Protocol client state.

import lib/json_rpc_session.dl
import lib/list.dl

class:
    patterns:
        [an|] LSP document
    members:
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|] LSP diagnostic report
    members:
        uri as a string
        version presence as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

class:
    patterns:
        [an|] LSP synchronization
    members:
        kind as a 32 bit integer
        open and close notifications as a boolean
        save notifications as a boolean
        saved text inclusion as a boolean

class:
    patterns:
        [an|] LSP client
    members:
        session as a pointer to a JSON-RPC session
        lifecycle as a 32 bit integer
        synchronization as an LSP synchronization
        capabilities as a pointer to a JSON value
        documents as a pointer to a list
        reports as a pointer to a list
        notifications as a pointer to a list

class:
    patterns:
        [an|] LSP client result
    members:
        success as a boolean
        status as a 32 bit integer
        client as a pointer to an LSP client
        error message as a string

class:
    patterns:
        [an|] LSP document result
    members:
        availability as a boolean
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|] LSP diagnostics result
    members:
        availability as a boolean
        version presence as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

the LSP created lifecycle means: 0
the LSP running lifecycle means: 1
the LSP shutdown lifecycle means: 2
the LSP stopped lifecycle means: 3
the LSP no synchronization kind means: 0
the LSP full synchronization kind means: 1
the LSP incremental synchronization kind means: 2
the LSP invalid state status means: 20
the LSP invalid response status means: 21
the LSP document error status means: 22
the LSP server not initialized code means: -32002
the LSP unknown error code means: -32001
the LSP request failed code means: -32803
the LSP server cancelled code means: -32802
the LSP content modified code means: -32801
the LSP request cancelled code means: -32800
{LSP client result:outcome} succeeded means: outcome's success
{LSP client result:outcome} failed means: the inverse of outcome's success
{LSP document result:outcome} was found means: outcome's availability
{LSP document result:outcome} is missing means: the inverse of outcome's availability
{LSP diagnostics result:outcome} was found means: outcome's availability
{LSP diagnostics result:outcome} has a version means: outcome's version presence
{LSP synchronization:settings} sends open and close notifications means: settings's open and close notifications
{LSP synchronization:settings} does not send open and close notifications means: the inverse of settings's open and close notifications
{LSP synchronization:settings} sends save notifications means: settings's save notifications
{LSP synchronization:settings} does not send save notifications means: the inverse of settings's save notifications
{LSP synchronization:settings} includes text in save notifications means: settings's saved text inclusion
{LSP synchronization:settings} does not include text in save notifications means: the inverse of settings's saved text inclusion
