# Shared Language Server Protocol client state.

import lib/json_rpc_session.dl
import lib/list.dl

class:
    patterns:
        [an|] LSP document
    members:
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|] LSP diagnostic report
    members:
        uri as a string
        version presence as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

class:
    patterns:
        [an|] LSP synchronization
    members:
        kind as a 32 bit integer
        open and close notifications as a boolean
        save notifications as a boolean
        saved text inclusion as a boolean

class:
    patterns:
        [an|] LSP client
    members:
        session as a pointer to a JSON-RPC session
        lifecycle as a 32 bit integer
        synchronization as an LSP synchronization
        capabilities as a pointer to a JSON value
        documents as a pointer to a list
        reports as a pointer to a list
        notifications as a pointer to a list

class:
    patterns:
        [an|] LSP client result
    members:
        success as a boolean
        status as a 32 bit integer
        client as a pointer to an LSP client
        error message as a string

class:
    patterns:
        [an|] LSP document result
    members:
        availability as a boolean
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|] LSP diagnostics result
    members:
        availability as a boolean
        version presence as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

function the LSP created lifecycle:
    replacement:
        0

function the LSP running lifecycle:
    replacement:
        1

function the LSP shutdown lifecycle:
    replacement:
        2

function the LSP stopped lifecycle:
    replacement:
        3

function the LSP no synchronization kind:
    replacement:
        0

function the LSP full synchronization kind:
    replacement:
        1

function the LSP incremental synchronization kind:
    replacement:
        2

function the LSP invalid state status:
    replacement:
        20

function the LSP invalid response status:
    replacement:
        21

function the LSP document error status:
    replacement:
        22

function the LSP server not initialized code:
    replacement:
        0 - 32002

function the LSP unknown error code:
    replacement:
        0 - 32001

function the LSP request failed code:
    replacement:
        0 - 32803

function the LSP server cancelled code:
    replacement:
        0 - 32802

function the LSP content modified code:
    replacement:
        0 - 32801

function the LSP request cancelled code:
    replacement:
        0 - 32800

function {LSP client result:outcome} succeeded:
    replacement:
        outcome's success

function {LSP client result:outcome} failed:
    replacement:
        the inverse of outcome's success

function {LSP document result:outcome} was found:
    replacement:
        outcome's availability

function {LSP document result:outcome} is missing:
    replacement:
        the inverse of outcome's availability

function {LSP diagnostics result:outcome} was found:
    replacement:
        outcome's availability

function {LSP diagnostics result:outcome} has a version:
    replacement:
        outcome's version presence

function {LSP synchronization:settings} sends open and close notifications:
    replacement:
        settings's open and close notifications

function {LSP synchronization:settings} does not send open and close notifications:
    replacement:
        the inverse of settings's open and close notifications

function {LSP synchronization:settings} sends save notifications:
    replacement:
        settings's save notifications

function {LSP synchronization:settings} does not send save notifications:
    replacement:
        the inverse of settings's save notifications

function {LSP synchronization:settings} includes text in save notifications:
    replacement:
        settings's saved text inclusion

function {LSP synchronization:settings} does not include text in save notifications:
    replacement:
        the inverse of settings's saved text inclusion
