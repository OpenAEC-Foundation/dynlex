# Shared Language Server Protocol client state.

import lib/json_rpc_session.dl
import lib/list.dl

class:
    patterns:
        [an|a|] lsp document
    members:
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|a|] lsp diagnostic report
    members:
        uri as a string
        versioned as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

class:
    patterns:
        [an|a|] lsp synchronization
    members:
        kind as a 32 bit integer
        open and close notifications as a boolean
        save notifications as a boolean
        saved text inclusion as a boolean

class:
    patterns:
        [an|a|] lsp client
    members:
        session as a pointer to json rpc session
        lifecycle as a 32 bit integer
        synchronization as an lsp synchronization
        capabilities as a pointer to a JSON value
        documents as a pointer to list
        reports as a pointer to list
        notifications as a pointer to list

class:
    patterns:
        [an|a|] lsp client result
    members:
        success as a boolean
        status as a 32 bit integer
        client as a pointer to an lsp client
        error message as a string

class:
    patterns:
        [an|a|] lsp document result
    members:
        availability as a boolean
        uri as a string
        language as a string
        text as a string
        version as a 32 bit integer

class:
    patterns:
        [an|a|] lsp diagnostics result
    members:
        availability as a boolean
        versioned as a boolean
        version as a 32 bit integer
        diagnostics as a pointer to a JSON value

function the lsp created lifecycle:
    replacement:
        0

function the lsp running lifecycle:
    replacement:
        1

function the lsp shutdown lifecycle:
    replacement:
        2

function the lsp stopped lifecycle:
    replacement:
        3

function the lsp no synchronization kind:
    replacement:
        0

function the lsp full synchronization kind:
    replacement:
        1

function the lsp incremental synchronization kind:
    replacement:
        2

function the lsp invalid state status:
    replacement:
        20

function the lsp invalid response status:
    replacement:
        21

function the lsp document error status:
    replacement:
        22

function the lsp server not initialized code:
    replacement:
        0 - 32002

function the lsp unknown error code:
    replacement:
        0 - 32001

function the lsp request failed code:
    replacement:
        0 - 32803

function the lsp server cancelled code:
    replacement:
        0 - 32802

function the lsp content modified code:
    replacement:
        0 - 32801

function the lsp request cancelled code:
    replacement:
        0 - 32800

function {lsp client result:outcome} succeeded:
    replacement:
        outcome's success

function {lsp client result:outcome} failed:
    replacement:
        the inverse of outcome's success

function {lsp document result:outcome} was found:
    replacement:
        outcome's availability

function {lsp document result:outcome} is missing:
    replacement:
        the inverse of outcome's availability

function {lsp diagnostics result:outcome} was found:
    replacement:
        outcome's availability

function {lsp diagnostics result:outcome} has a version:
    replacement:
        outcome's versioned
