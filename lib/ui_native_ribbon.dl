import lib/ui_native_icons.dl
import lib/ui_native.dl
import lib/ui_native_clip.dl

to draw ribbon control {a pointer to UI layout:layout} in {UI bounds:box} focused {boolean:focused} in {a pointer to native UI view:view} on {graphics frame:frame}:
    set node to layout's node
    set ink to view's theme's text
    set background to UI ink between (UI ink 255 255 255) and (UI ink 222 228 237) at (layout's hover * 0.65)
    if (node's kind = 33) and (layout's parent's kind = 0):
        set background to UI ink between (view's theme's background) and (UI ink 211 219 231) at (layout's hover * 0.75)
    if (view's pressed = layout) or (view's popup = layout):
        set background to UI ink 224 229 237
    if focused and view's keyboard focus:
        draw a rounded UI box (UI box at (box's x - 2.0) (box's y - 2.0) sized (box's width + 4.0) (box's height + 4.0)) with radius 6.0 in (view's theme's accent) on frame
    if node's kind = 38:
        draw a rounded UI box box with radius 6.0 in (UI ink 229 232 237) on frame
        draw a rounded UI box (UI box at (box's x + 1.0) (box's y + 1.0) sized (box's width - 2.0) (box's height - 2.0)) with radius 5.0 in background on frame
        save the model transform in frame
        move the model in frame by x (box's x + (box's width / 2.0)), y (box's y + (box's height / 2.0)) and z 0.0
        set angle to 180.0 if node's columns < 0, else 0.0
        rotate the model in frame by angle degrees around x 0.0, y 0.0 and z 1.0
        draw UI icon "chevron" in (UI box at -8 -8 sized 16 16) in ink using (the address of (view's icons)) on frame
        restore the model transform in frame
        return nothing
    if node's kind = 29:
        set background to UI ink between (view's theme's background) and (UI ink 228 231 235) at (layout's hover * 0.7)
        draw a rounded UI box box with radius 6.0 in background on frame
        if node = (the selected tab of (layout's parent) in (view's instance)):
            set ink to view's theme's accent
            draw UI text (node's text) centered in box with (view's strong) in ink on frame
        else:
            draw UI text (node's text) centered in box with (view's typeface) in ink on frame
        return nothing
    if node's kind = 34:
        draw a rounded UI box box with radius 4.0 in (UI ink 210 214 221) on frame
        draw a rounded UI box (UI box at (box's x + 1.0) (box's y + 1.0) sized (box's width - 2.0) (box's height - 2.0)) with radius 3.0 in background on frame
        draw UI text ((the UI value for node in (view's instance))'s text) at (box's x + 8.0) (box's y + 19.0) with (view's small) in ink on frame
        draw UI icon "down" in (UI box at ((box's x + box's width) - 17.0) (box's y + 10.0) sized 8 8) in (view's theme's muted) using (the address of (view's icons)) on frame
        return nothing
    if node's rows = 5:
        set tint to UI ink between (UI ink 224 230 240) and (UI ink 200 211 230) at (layout's hover * 0.8)
        draw a rounded UI box box with radius 15.0 in tint on frame
        draw UI text (node's text) centered in box with (view's small) in (UI ink 67 84 111) on frame
        return nothing
    if node's rows = 6:
        set tint to UI ink between (UI ink 232 234 238) and (UI ink 216 223 234) at (layout's hover * 0.7)
        draw a rounded UI box box with radius 6.0 in tint on frame
        draw UI icon "search" in (UI box at (box's x + 13.0) (box's y + 9.0) sized 15 15) in (view's theme's muted) using (the address of (view's icons)) on frame
        draw UI text (node's text) at (box's x + 39.0) (box's y + 21.0) with (view's small) in (view's theme's muted) on frame
        return nothing
    if node's rows = 4:
        set tint to UI ink between (UI ink 255 255 255) and (UI ink 219 225 235) at (layout's hover * 0.7)
        if node's color != "":
            set tint to UI ink between (view's theme's accent) and (UI ink 145 46 26) at (layout's hover * 0.6)
            set ink to UI ink 255 255 255
        draw a rounded UI box box with radius 5.0 in tint on frame
        set width to (the width of (node's text) using (view's small)) + 24
        set left to box's x + ((box's width - width) / 2.0)
        draw UI icon (node's variant) in (UI box at left (box's y + ((box's height - 16.0) / 2.0)) sized 16 16) in ink using (the address of (view's icons)) on frame
        draw UI text (node's text) at (left + 24.0) (box's y + ((box's height / 2.0) + 5.0)) with (view's small) in ink on frame
        return nothing
    draw a rounded UI box box with radius 5.0 in background on frame
    if node's rows = 3:
        set color to the UI ink named (node's color)
        set preview to UI box at (box's x + 5.0) (box's y + 4.0) sized (box's width - 10.0) 55
        draw a rounded UI box preview with radius 3.0 in (UI ink 213 219 226) on frame
        draw a flat UI box (UI box at (preview's x + 1.0) (preview's y + 1.0) sized (preview's width - 2.0) 53) in (UI ink between (UI ink 255 255 255) and color at 0.06) on frame
        draw a flat UI box (UI box at ((preview's x + preview's width) - 23.0) (preview's y + 1.0) sized 22 53) in color on frame
        draw UI text "Aa" at (preview's x + 9.0) (preview's y + 33.0) with (view's heading) in color on frame
        draw a flat UI box (UI box at (preview's x + 11.0) (preview's y + 42.0) sized 35 2) in (UI ink between color and (UI ink 255 255 255) at 0.6) on frame
        draw UI text (node's text) centered in (UI box at (box's x) (box's y + 59.0) sized (box's width) 22) with (view's small) in ink on frame
        return nothing
    set {icon ink} to UI ink 71 102 127
    if (node's variant = "paste") or ((node's variant = "slide") or (node's variant = "star")):
        set icon ink to view's theme's accent
    if node's rows = 1:
        draw UI icon (node's variant) in (UI box at (box's x + ((box's width - 30.0) / 2.0)) (box's y + 7.0) sized 30 30) in icon ink using (the address of (view's icons)) on frame
        draw UI text (node's text) centered in (UI box at (box's x) (box's y + 40.0) sized (box's width) 22) with (view's small) in ink on frame
        if node's count > 0:
            draw UI icon "down" in (UI box at (box's x + ((box's width - 10.0) / 2.0)) (box's y + 67.0) sized 10 10) in (view's theme's muted) using (the address of (view's icons)) on frame
    else if node's rows = 2:
        set size to 18.0
        if box's height < 24.0:
            set size to 14.0
        draw UI icon (node's variant) in (UI box at (box's x + ((box's width - size) / 2.0)) (box's y + ((box's height - size) / 2.0)) sized size size) in ink using (the address of (view's icons)) on frame
    else:
        draw UI icon (node's variant) in (UI box at (box's x + 5.0) (box's y + 5.0) sized 18 18) in icon ink using (the address of (view's icons)) on frame
        draw UI text (node's text) at (box's x + 31.0) (box's y + 19.0) with (view's small) in ink on frame
        if node's count > 0:
            draw UI icon "down" in (UI box at ((box's x + box's width) - 15.0) (box's y + 9.0) sized 10 10) in (view's theme's muted) using (the address of (view's icons)) on frame

to draw UI ribbon {a pointer to UI layout:layout} in {UI bounds:box} with cursor {cursor position:cursor} in {a pointer to native UI view:view} on {graphics frame:frame}:
    set body to UI box at (box's x) (box's y + 40.0) sized (box's width) (box's height - 40.0)
    draw a UI shadow under body with radius 10.0 softness 5.0 strength 12 in (UI ink 30 39 51) on frame
    draw a rounded UI box body with radius 10.0 in (UI ink 255 255 255) on frame
    set selected to the selected tab of (layout's node) in (view's instance)
    set active to @intrinsic("construct", a pointer to UI layout)
    set child to layout's first
    set index to 0
    loop while index < layout's node's count:
        set header to child's bounds
        set header's x to header's x + box's x
        set header's y to header's y + box's y
        draw UI control child in header with cursor cursor in view on frame
        if child's node = selected:
            set active to child
        set child to child's next
        increment index
    set earlier to child
    set later to child's next
    require condition (active != @intrinsic("construct", a pointer to UI layout)) reporting "The selected tab has no native layout"
    set destination to active's bounds' x + 14.0
    set width to active's bounds' width - 28.0
    if (layout's painted = false) or view's instance's reduced motion:
        set layout's transition to destination
        set layout's extent to width
    else:
        set response to the minimum of 1.0 and (view's frame seconds * 22.0)
        set layout's transition to layout's transition + ((destination - layout's transition) * response)
        set layout's extent to layout's extent + ((width - layout's extent) * response)
    set layout's painted to true
    draw a rounded UI box (UI box at (box's x + layout's transition) (box's y + 35.0) sized (layout's extent) 3) with radius 1.5 in (view's theme's accent) on frame
    set visible to the ribbon viewport width for active in layout
    set overflowing to (the ribbon content width of active) > visible
    set left to box's x + 6.0
    if overflowing:
        set left to left + 24.0
    if view's keyboard focus:
        set child to active's first
        loop while child != @intrinsic("construct", a pointer to UI layout):
            reveal UI control ordered (view's focus order) in child at 0.0 within visible for active
            set child to child's next
    if view's instance's reduced motion:
        set active's scroll position to active's scroll target
    else:
        set response to the minimum of 1.0 and (view's frame seconds * 22.0)
        set active's scroll position to active's scroll position + ((active's scroll target - active's scroll position) * response)
        if (the absolute value of (active's scroll target - active's scroll position)) < 0.2:
            set active's scroll position to active's scroll target
    set clip to a UI clip restricted to (UI box at left (box's y + 45.0) sized visible (box's height - 45.0)) in view on frame
    set child to active's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        draw UI layout child at (left - active's scroll position) (box's y + 45.0) with cursor cursor in view on frame
        set child to child's next
    restore UI clip clip in view on frame
    if overflowing:
        draw UI control earlier in (UI box at (box's x + 4.0) (box's y + 48.0) sized 24 108) with cursor cursor in view on frame
        draw UI control later in (UI box at ((box's x + box's width) - 28.0) (box's y + 48.0) sized 24 108) with cursor cursor in view on frame

to navigate UI tabs in {a pointer to native UI view:view}:
    if view's keyboard focus and (view's focused != @intrinsic("construct", a pointer to UI layout)):
        if view's focused's node's kind = 29:
            set direction to 0
            if view's key press = 263:
                set direction to -1
            if view's key press = 262:
                set direction to 1
            if direction != 0:
                set ribbon to view's focused's parent
                set current to 0
                loop while (the UI child at current in ribbon) != view's focused's node:
                    increment current
                set index to ((current + direction) + ribbon's count) mod ribbon's count
                set view's focus order to view's focus order + (index - current)
                activate (the UI child at index in ribbon) belonging to ribbon in (view's instance)
