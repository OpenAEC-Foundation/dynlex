# Caller-owned single-precision normal distribution state.
#
# This uses the Marsaglia polar method, returning the vertical variate first
# and caching the horizontal variate. The state deliberately contains only the
# cached standard-normal variate; mean and standard deviation are call
# parameters, so changing them does not disturb the cache.

import lib/std.dl
import lib/mersenne_twister.dl
import lib/mersenne_twister64.dl

class:
    patterns:
        [a|] normal distribution state
    members:
        cached standard value as a 32 bit floating-point number
        cached standard value available as a boolean

function reset {a pointer to a normal distribution state:statePointer}:
    execute:
        set the cached standard value available of statePointer to false

function the next normal value from {a pointer to a normal distribution state:statePointer} using {a value:enginePointer} with mean {a 32 bit floating-point number:meanValue} and standard deviation {a 32 bit floating-point number:deviationValue}:
    execute:
        if the cached standard value available of statePointer:
            set standardValue to the cached standard value of statePointer
            set the cached standard value available of statePointer to false
        else:
            set rejectedValue to true
            loop while rejectedValue:
                set horizontalValue to ((2.0 as a 32 bit floating-point number) * (the next 32 bit unit fraction from enginePointer)) - (1.0 as a 32 bit floating-point number)
                set verticalValue to ((2.0 as a 32 bit floating-point number) * (the next 32 bit unit fraction from enginePointer)) - (1.0 as a 32 bit floating-point number)
                set squaredRadius to ((horizontalValue * horizontalValue) + (verticalValue * verticalValue))
                set rejectedValue to squaredRadius > (1.0 as a 32 bit floating-point number) or squaredRadius = (0.0 as a 32 bit floating-point number)
            set multiplierValue to the square root of ((((-2.0) as a 32 bit floating-point number) * @intrinsic("log", squaredRadius)) / squaredRadius)
            set the cached standard value of statePointer to horizontalValue * multiplierValue
            set the cached standard value available of statePointer to true
            set standardValue to verticalValue * multiplierValue
        return (standardValue * deviationValue) + meanValue
