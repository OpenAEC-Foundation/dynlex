    if name = "copy":
        return a UI icon from [icon line 8.0 7.0 to 4.0 7.0, icon line 4.0 7.0 to 4.0 21.0, icon line 4.0 21.0 to 16.0 21.0, icon line 16.0 21.0 to 16.0 17.0, icon line 9.0 3.0 to 21.0 3.0, icon line 21.0 3.0 to 21.0 17.0, icon line 21.0 17.0 to 9.0 17.0, icon line 9.0 17.0 to 9.0 3.0]
