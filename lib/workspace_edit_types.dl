# Workspace edit protocol model and explicit ownership helpers.

class:
    patterns:
        [a|] workspace edit position
    members:
        line as a 32 bit integer
        character as a 32 bit integer

class:
    patterns:
        [a|] workspace text edit
    members:
        start as a workspace edit position
        end as a workspace edit position
        new text as a string
        annotation presence as a boolean
        annotation id as a string

class:
    patterns:
        [a|] workspace text edit collection
    members:
        items as a pointer to a pointer to a workspace text edit
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] workspace change annotation
    members:
        identifier as a string
        label as a string
        confirmation requirement as a boolean
        description presence as a boolean
        description as a string

class:
    patterns:
        [a|] workspace annotation collection
    members:
        items as a pointer to a pointer to a workspace change annotation
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] workspace edit change
    members:
        kind as a 32 bit integer
        uri as a string
        old URI as a string
        new URI as a string
        version presence as a boolean
        version as a 32 bit integer
        edits as a pointer to a workspace text edit collection
        overwrite as a boolean
        existing target tolerance as a boolean
        recursion as a boolean
        missing target tolerance as a boolean
        directory hint as a boolean
        annotation presence as a boolean
        annotation id as a string

class:
    patterns:
        [a|] workspace change collection
    members:
        items as a pointer to a pointer to a workspace edit change
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] parsed workspace edit
    members:
        changes as a pointer to a workspace change collection
        annotations as a pointer to a workspace annotation collection
        document change usage as a boolean

class:
    patterns:
        [a|] workspace edit parse result
    members:
        success as a boolean
        edit as a pointer to a parsed workspace edit
        failure reason as a string
        failed change presence as a boolean
        failed change as a 32 bit integer

class:
    patterns:
        [a|] workspace URI result
    members:
        success as a boolean
        path as a string
        identity as a string
        relative path as a string
        directory hint as a boolean
        failure reason as a string

class:
    patterns:
        [a|] workspace text result
    members:
        success as a boolean
        text as a string
        failure reason as a string

[the|] workspace text change kind means: 1

[the|] workspace create change kind means: 2

[the|] workspace rename change kind means: 3

[the|] workspace delete change kind means: 4

[the|] workspace UTF-8 position encoding means: 1

[the|] workspace UTF-16 position encoding means: 2

[the|] workspace UTF32 position encoding means: 3

to get [an|the|] empty workspace edit text:
    return the string form of ""

{workspace edit parse result:result} succeeded means: result's success

{workspace edit parse result:result} failed means: not result's success

{workspace URI result:result} succeeded means: result's success

{workspace URI result:result} failed means: not result's success

{workspace text result:result} succeeded means: result's success

{workspace text result:result} failed means: not result's success

to get a new workspace text edit collection:
    set initial to @intrinsic(
        "construct",
        a workspace text edit collection,
        0 as a pointer to a pointer to a workspace text edit,
        0,
        0
    )
    allocate one slot of initial and set result to it
    return result

to append {a pointer to a workspace text edit:value} to workspace text edits {a pointer to a workspace text edit collection:collection}:
    set required to the collection length after adding one item to the length of collection
    set growth to the collection capacity from the capacity of collection expanded to hold required items
    if growth > the capacity of collection:
        set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a workspace text edit
        set the items of collection to resized
        set the capacity of collection to growth
    @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
    set the length of collection to required

to get the workspace text edit at index {integer:position} in {a pointer to a workspace text edit collection:collection}:
    if position < 0 or position >= the length of collection:
        abort the program
    return the item at position in the items of collection

to get a new workspace annotation collection:
    set initial to @intrinsic(
        "construct",
        a workspace annotation collection,
        0 as a pointer to a pointer to a workspace change annotation,
        0,
        0
    )
    allocate one slot of initial and set result to it
    return result

to append {a pointer to a workspace change annotation:value} to workspace annotations {a pointer to a workspace annotation collection:collection}:
    set required to the collection length after adding one item to the length of collection
    set growth to the collection capacity from the capacity of collection expanded to hold required items
    if growth > the capacity of collection:
        set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a workspace change annotation
        set the items of collection to resized
        set the capacity of collection to growth
    @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
    set the length of collection to required

to get the workspace change annotation at index {integer:position} in {a pointer to a workspace annotation collection:collection}:
    if position < 0 or position >= the length of collection:
        abort the program
    return the item at position in the items of collection

to get a new workspace change collection:
    set initial to @intrinsic(
        "construct",
        a workspace change collection,
        0 as a pointer to a pointer to a workspace edit change,
        0,
        0
    )
    allocate one slot of initial and set result to it
    return result

to append {a pointer to a workspace edit change:value} to workspace changes {a pointer to a workspace change collection:collection}:
    set required to the collection length after adding one item to the length of collection
    set growth to the collection capacity from the capacity of collection expanded to hold required items
    if growth > the capacity of collection:
        set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a workspace edit change
        set the items of collection to resized
        set the capacity of collection to growth
    @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
    set the length of collection to required

to get the workspace change at index {integer:position} in {a pointer to a workspace change collection:collection}:
    if position < 0 or position >= the length of collection:
        abort the program
    return the item at position in the items of collection

to get a new parsed workspace edit using document changes {boolean:ordered}:
    set collection to a new workspace change collection
    set annotations to a new workspace annotation collection
    set initial to @intrinsic(
        "construct",
        a parsed workspace edit,
        collection,
        annotations,
        ordered
    )
    allocate one slot of initial and set result to it
    return result

a successful workspace edit parse containing {a pointer to a parsed workspace edit:edit} means: @intrinsic(
    "construct",
    a workspace edit parse result,
    true,
    edit,
    an empty workspace edit text,
    false,
    0
)

a failed workspace edit parse reporting {string:reason} means: @intrinsic(
    "construct",
    a workspace edit parse result,
    false,
    0 as a pointer to a parsed workspace edit,
    reason,
    false,
    0
)

a failed workspace edit parse reporting {string:reason} at change {integer:position} means: @intrinsic(
    "construct",
    a workspace edit parse result,
    false,
    0 as a pointer to a parsed workspace edit,
    reason,
    true,
    position as a 32 bit integer
)

a successful workspace text result containing {string:contents} means: @intrinsic(
    "construct",
    a workspace text result,
    true,
    contents,
    an empty workspace edit text
)

a failed workspace text result reporting {string:reason} means: @intrinsic(
    "construct",
    a workspace text result,
    false,
    an empty workspace edit text,
    reason
)

to free {a pointer to a workspace text edit:target}:
    if target = (0 as a pointer to a workspace text edit):
        return nothing
    @intrinsic("destroy at", target)
    deallocate target

to free {a pointer to a workspace text edit collection:target}:
    if target = (0 as a pointer to a workspace text edit collection):
        return nothing
    set position to 0
    loop while (position < the length of target):
        free (the workspace text edit at index position in target)
        set position to (position + 1)
    deallocate the items of target
    @intrinsic("destroy at", target)
    deallocate target

to free {a pointer to a workspace edit change:target}:
    if target = (0 as a pointer to a workspace edit change):
        return nothing
    set edits to the edits of target
    if edits != (0 as a pointer to a workspace text edit collection):
        free edits
    @intrinsic("destroy at", target)
    deallocate target

to free {a pointer to a parsed workspace edit:target}:
    if target = (0 as a pointer to a parsed workspace edit):
        return nothing
    set changes to the changes of target
    set position to 0
    loop while (position < the length of changes):
        free (the workspace change at index position in changes)
        set position to (position + 1)
    deallocate the items of changes
    @intrinsic("destroy at", changes)
    deallocate changes
    set annotations to the annotations of target
    set position to 0
    loop while (position < the length of annotations):
        set annotation to the workspace change annotation at index position in annotations
        @intrinsic("destroy at", annotation)
        deallocate annotation
        set position to (position + 1)
    deallocate the items of annotations
    @intrinsic("destroy at", annotations)
    deallocate annotations
    @intrinsic("destroy at", target)
    deallocate target

to free {workspace edit parse result:outcome}: free outcome's edit
