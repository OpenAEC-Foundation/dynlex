import lib/std.dl

# Fragment shader I/O
# Coordinates follow Vulkan: fragment origin is the upper left, clip-space Y
# points down, and clip-space depth runs from zero to W. Project a world whose
# Y points up by negating its projected Y before writing the output position.

the fragment coordinates means: @intrinsic("shader input", "FragCoord")
the fragment x coordinate means: the element at 0 in @intrinsic("shader input", "FragCoord")
the fragment y coordinate means: the element at 1 in @intrinsic("shader input", "FragCoord")
function set the fragment color with a red channel of {a value:red}, a green channel of {a value:green}, a blue channel of {a value:blue} and an alpha channel of {a value:alpha}:
    replacement:
        @intrinsic(
            "shader output",
            @intrinsic("construct", an aggregate of 4 floating-point number values, red, green, blue, alpha)
        )

# Vertex shader I/O

[the|] vertex input named {a value:name} at location {a value:location} of type {type:kind} means: @intrinsic("shader vertex input", name, location, kind)

the vertex position means: @intrinsic("shader input", "Position")
the vertex x means: the element at 0 in @intrinsic("shader input", "Position")
the vertex y means: the element at 1 in @intrinsic("shader input", "Position")
the vertex z means: the element at 2 in @intrinsic("shader input", "Position")
the vertex w means: the element at 3 in @intrinsic("shader input", "Position")
function set the output position with x {a value:horizontal}, y {a value:vertical}, z {a value:depth} and w {a value:magnitude}:
    replacement:
        @intrinsic(
            "shader output",
            @intrinsic("construct", an aggregate of 4 floating-point number values, horizontal, vertical, depth, magnitude)
        )

# Vertex-to-fragment interpolants

function set [the|] shader interpolant named {a value:name} with an x coordinate of {a value:horizontal}, a y coordinate of {a value:vertical}, a z coordinate of {a value:depth} and a w coordinate of {a value:magnitude}:
    replacement:
        @intrinsic("shader interpolant output", name, horizontal, vertical, depth, magnitude)
[the|] shader interpolant x named name means: the element at 0 in @intrinsic("shader interpolant input", name)
[the|] shader interpolant y named name means: the element at 1 in @intrinsic("shader interpolant input", name)
[the|] shader interpolant z named name means: the element at 2 in @intrinsic("shader interpolant input", name)
[the|] shader interpolant w named name means: the element at 3 in @intrinsic("shader interpolant input", name)
# Shader uniforms (values passed from host each frame)

[the|] shader uniform named {a value:name} at binding {a value:slot} as {type:kind} means: @intrinsic("shader uniform", name, slot, kind)

the shader time means: @intrinsic("shader uniform", "time", 0, @intrinsic("type", "float", 32))
the shader render pass means: @intrinsic("shader uniform", "render_pass", 1, @intrinsic("type", "float", 32))

# Sampled resources are static bindings, separate from runtime texture storage.
[a|] shader image means: @intrinsic("type", "shader image")
[a|] shader sampler means: @intrinsic("type", "shader sampler")

[the|] shader image named {fixed C string:name} at binding {fixed integer:slot} means: @intrinsic("shader image", name, slot, "2d", false)
[the|] shader cube image named {fixed C string:name} at binding {fixed integer:slot} means: @intrinsic("shader image", name, slot, "cube", false)
[the|] shader depth image named {fixed C string:name} at binding {fixed integer:slot} means: @intrinsic("shader image", name, slot, "2d", true)
[the|] shader sampler named {fixed C string:name} at binding {fixed integer:slot} means: @intrinsic("shader sampler", name, slot, false)
[the|] shader comparison sampler named {fixed C string:name} at binding {fixed integer:slot} means: @intrinsic("shader sampler", name, slot, true)

to get the sample from {fixed shader image:image} using {fixed shader sampler:sampler} at {a value:coordinates} with level {a 32 bit floating-point number:level}:
    return @intrinsic("shader sample level", image, sampler, coordinates, level)

to get the visibility from {fixed shader image:image} using {fixed shader sampler:sampler} at {a value:coordinates} with depth {a 32 bit floating-point number:depth}:
    return @intrinsic("shader sample compare", image, sampler, coordinates, depth)
