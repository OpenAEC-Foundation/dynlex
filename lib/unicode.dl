# UTF8 decoding, UTF16 position conversion, and byte-based line indexing.
# Status 0 is success, 1 is invalid UTF8 input, and 2 is an invalid requested
# code-point boundary or position. Error byte offsets are zero-based.

import lib/string.dl

class:
    patterns:
        [a|] UTF-8 validation result
    members:
        status as an integer
        error byte offset as an integer

class:
    patterns:
        [a|] UTF-8 code point result
    members:
        status as an integer
        code point as an integer
        byte offset as an integer
        next byte offset as an integer
        error byte offset as an integer

class:
    patterns:
        [a|] text position result
    members:
        status as an integer
        position as an integer
        error byte offset as an integer

class:
    patterns:
        [a|] text line
    members:
        start as an integer
        content end as an integer
        next start as an integer

class:
    patterns:
        [a|] text line index
    members:
        lines as a pointer to a text line
        line count as an integer
        source length as an integer

class:
    patterns:
        [a|] text line index result
    members:
        status as an integer
        line index as a pointer to a text line index
        error byte offset as an integer

the text position success status means: 0
the invalid UTF-8 status means: 1
the invalid text position status means: 2
the error byte offset of {UTF-8 validation result:result} means: result's error byte offset
the error byte offset of {UTF-8 code point result:result} means: result's error byte offset
the error byte offset of {text position result:result} means: result's error byte offset
the error byte offset of {text line index result:result} means: result's error byte offset
the code point of {UTF-8 code point result:result} means: result's code point
the byte offset of {UTF-8 code point result:result} means: result's byte offset
the next byte offset of {UTF-8 code point result:result} means: result's next byte offset
the line index of {text line index result:result} means: result's line index
{UTF-8 validation result:result} succeeded means: result's status = the text position success status
{UTF-8 validation result:result} failed means: result's status != the text position success status
{UTF-8 code point result:result} succeeded means: result's status = the text position success status
{UTF-8 code point result:result} failed means: result's status != the text position success status
{text position result:result} succeeded means: result's status = the text position success status
{text position result:result} failed means: result's status != the text position success status
{text line index result:result} succeeded means: result's status = the text position success status
{text line index result:result} failed means: result's status != the text position success status
local function the unsigned UTF-8 byte at {integer:offset} in {string:text}:
    execute:
        return (the character at offset in text as a 32 bit integer) bitwise and 255

local function a successful UTF-8 validation:
    replacement:
        @intrinsic("construct", a UTF-8 validation result, the text position success status, -1)

local function an invalid UTF-8 validation at {integer:error}:
    replacement:
        @intrinsic("construct", a UTF-8 validation result, the invalid UTF-8 status, error)

local function a decoded UTF-8 code point {integer:value} at {integer:offset} ending at {integer:finish}:
    replacement:
        @intrinsic("construct", a UTF-8 code point result, the text position success status, value, offset, finish, -1)

local function an invalid UTF-8 code point at {integer:offset} reporting {integer:error}:
    replacement:
        @intrinsic("construct", a UTF-8 code point result, the invalid UTF-8 status, 0, offset, offset, error)

local function an invalid UTF-8 code point position at {integer:offset}:
    replacement:
        @intrinsic("construct", a UTF-8 code point result, the invalid text position status, 0, offset, offset, -1)

local function {integer:value} is a UTF-8 continuation byte:
    execute:
        return value >= 128 and value <= 191

local function {integer:value} is not a UTF-8 continuation byte:
    execute:
        return value < 128 or value > 191

local function the raw UTF-8 code point in {string:text} at {integer:offset}:
    execute:
        set first to the unsigned UTF-8 byte at offset in text
        if first <= 127:
            return a decoded UTF-8 code point first at offset ending at offset + 1
        if first < 194 or first > 244:
            return an invalid UTF-8 code point at offset reporting offset
        if offset + 1 >= the length of text:
            return an invalid UTF-8 code point at offset reporting the length of text
        set second to the unsigned UTF-8 byte at offset + 1 in text
        if second is not a UTF-8 continuation byte:
            return an invalid UTF-8 code point at offset reporting offset + 1
        if first = 224 and second < 160:
            return an invalid UTF-8 code point at offset reporting offset + 1
        if first = 237 and second > 159:
            return an invalid UTF-8 code point at offset reporting offset + 1
        if first = 240 and second < 144:
            return an invalid UTF-8 code point at offset reporting offset + 1
        if first = 244 and second > 143:
            return an invalid UTF-8 code point at offset reporting offset + 1
        if first <= 223:
            set scalar to ((first - 192) * 64) + (second - 128)
            return a decoded UTF-8 code point scalar at offset ending at offset + 2
        if offset + 2 >= the length of text:
            return an invalid UTF-8 code point at offset reporting the length of text
        set third to the unsigned UTF-8 byte at offset + 2 in text
        if third is not a UTF-8 continuation byte:
            return an invalid UTF-8 code point at offset reporting offset + 2
        if first <= 239:
            set scalar to (((first - 224) * 4096) + ((second - 128) * 64)) + (third - 128)
            return a decoded UTF-8 code point scalar at offset ending at offset + 3
        if offset + 3 >= the length of text:
            return an invalid UTF-8 code point at offset reporting the length of text
        set fourth to the unsigned UTF-8 byte at offset + 3 in text
        if fourth is not a UTF-8 continuation byte:
            return an invalid UTF-8 code point at offset reporting offset + 3
        set scalar to ((((first - 240) * 262144) + ((second - 128) * 4096)) + ((third - 128) * 64)) + (fourth - 128)
        return a decoded UTF-8 code point scalar at offset ending at offset + 4

local function the UTF-8 validation of {string:text}:
    execute:
        set offset to 0
        loop while offset < the length of text:
            set decoded to the raw UTF-8 code point in text at offset
            if the status of decoded != the text position success status:
                return an invalid UTF-8 validation at the error byte offset of decoded
            set offset to the next byte offset of decoded
        return a successful UTF-8 validation

local function the UTF-8 validation of {C string:text}:
    execute:
        return the UTF-8 validation of the string form of text

flex function validate text as UTF-8:
    replacement:
        set the subject to the UTF-8 validation of text
to get {string:text} is valid UTF-8:
    validate text as UTF-8 and set validation to it
    return validation succeeded

to get {C string:text} is valid UTF-8:
    return the string form of text is valid UTF-8

to get {string:text} is invalid UTF-8:
    validate text as UTF-8 and set validation to it
    return validation failed

to get {C string:text} is invalid UTF-8:
    return the string form of text is invalid UTF-8

local function the UTF-8 code point decoded in {string:text} at byte {integer:offset}:
    execute:
        if offset < 0 or offset >= the length of text:
            return an invalid UTF-8 code point position at offset
        set cursor to 0
        loop while cursor < offset:
            set entry to the raw UTF-8 code point in text at cursor
            if the status of entry != the text position success status:
                return entry
            if the next byte offset of entry > offset:
                return an invalid UTF-8 code point position at offset
            set cursor to the next byte offset of entry
        return the raw UTF-8 code point in text at offset

local function the UTF-8 code point decoded in {C string:text} at byte {integer:offset}:
    execute:
        return the UTF-8 code point decoded in the string form of text at byte offset

flex function decode the UTF-8 code point in {string:text} at byte {integer:offset}:
    replacement:
        set the subject to the UTF-8 code point decoded in text at byte offset
flex function decode the UTF-8 code point in {C string:text} at byte {integer:offset}:
    replacement:
        set the subject to the UTF-8 code point decoded in text at byte offset
local function a successful text position at {integer:position}:
    replacement:
        @intrinsic("construct", a text position result, the text position success status, position, -1)

local function an invalid text input position reporting {integer:error}:
    replacement:
        @intrinsic("construct", a text position result, the invalid UTF-8 status, 0, error)

local function an invalid requested text position:
    replacement:
        @intrinsic("construct", a text position result, the invalid text position status, 0, -1)

local function the UTF-16 position result in {string:text} for byte {integer:offset}:
    execute:
        validate text as UTF-8 and set validation to it
        if validation failed:
            return an invalid text input position reporting the error byte offset of validation
        if offset < 0 or offset > the length of text:
            return an invalid requested text position
        set cursor to 0
        set total to 0
        loop while cursor < offset:
            set decoded to the raw UTF-8 code point in text at cursor
            if the next byte offset of decoded > offset:
                return an invalid requested text position
            if the code point of decoded > 65535:
                add 2 to total
            else:
                increment total
            set cursor to the next byte offset of decoded
        return a successful text position at total

the UTF-16 position of UTF-8 byte offset {integer:offset} in {string:text} means: the UTF-16 position result in text for byte offset
the UTF-16 position of UTF-8 byte offset {integer:offset} in {C string:text} means: the UTF-16 position result in the string form of text for byte offset
local function the UTF-8 byte offset result for UTF-16 position {integer:request} in {string:text}:
    execute:
        validate text as UTF-8 and set validation to it
        if validation failed:
            return an invalid text input position reporting the error byte offset of validation
        if request < 0:
            return an invalid requested text position
        set cursor to 0
        set total to 0
        loop while cursor < the length of text:
            if total = request:
                return a successful text position at cursor
            set decoded to the raw UTF-8 code point in text at cursor
            set next to total + 1
            if the code point of decoded > 65535:
                set next to total + 2
            if request < next:
                return an invalid requested text position
            set total to next
            set cursor to the next byte offset of decoded
        if total = request:
            return a successful text position at cursor
        return an invalid requested text position

the UTF-8 byte offset of UTF-16 position {integer:request} in {string:text} means: the UTF-8 byte offset result for UTF-16 position request in text
the UTF-8 byte offset of UTF-16 position {integer:request} in {C string:text} means: the UTF-8 byte offset result for UTF-16 position request in the string form of text
local function a failed text line index reporting {integer:error}:
    replacement:
        @intrinsic("construct", a text line index result, the invalid UTF-8 status, 0 as a pointer to a text line index, error)

local function a successful text line index containing {a pointer to a text line index:index}:
    replacement:
        @intrinsic("construct", a text line index result, the text position success status, index, -1)

local function the line index scanned from {string:text}:
    execute:
        validate text as UTF-8 and set validation to it
        if validation failed:
            return a failed text line index reporting the error byte offset of validation
        set capacity to the length of text + 1
        set lines to a text line array of capacity slots
        set count to 0
        set start to 0
        set offset to 0
        loop while offset < the length of text:
            set character to the unsigned UTF-8 byte at offset in text
            if character = 13:
                set next to offset + 1
                if next < the length of text:
                    if the unsigned UTF-8 byte at next in text = 10:
                        increment next
                set entry to @intrinsic("construct", a text line, start, offset, next)
                initialize entry at lines + count
                increment count
                set start to next
                set offset to next
            else if character = 10:
                set next to offset + 1
                set entry to @intrinsic("construct", a text line, start, offset, next)
                initialize entry at lines + count
                increment count
                set start to next
                set offset to next
            else:
                increment offset
        set entry to @intrinsic("construct", a text line, start, the length of text, the length of text)
        initialize entry at lines + count
        increment count
        set initial to @intrinsic("construct", a text line index, lines, count, the length of text)
        set catalogue to storage for one slot initialized with initial
        return a successful text line index containing catalogue

local function the line index scanned from {C string:text}:
    execute:
        return the line index scanned from the string form of text

flex function scan lines in text:
    replacement:
        set the subject to the line index scanned from text
the number of lines in {a pointer to a text line index:index} means: index's line count
to get the start of line {integer:number} in {a pointer to a text line index:index}:
    set count to index's line count
    if number < 0 or number >= count:
        return an invalid requested text position
    set entry to the item at number in (index's lines)
    return a successful text position at entry's start

to get the content end of line {integer:number} in {a pointer to a text line index:index}:
    set count to index's line count
    if number < 0 or number >= count:
        return an invalid requested text position
    set entry to the item at number in (index's lines)
    return a successful text position at entry's content end

to get the next start after line {integer:number} in {a pointer to a text line index:index}:
    set count to index's line count
    if number < 0 or number >= count:
        return an invalid requested text position
    set entry to the item at number in (index's lines)
    return a successful text position at entry's next start

to get the line number at byte offset {integer:offset} in {a pointer to a text line index:index}:
    set length to index's source length
    if offset < 0 or offset > length:
        return an invalid requested text position
    set count to index's line count
    set cursor to 0
    loop while cursor + 1 < count:
        set entry to the item at cursor in (index's lines)
        if offset < entry's next start:
            return a successful text position at cursor
        increment cursor
    return a successful text position at cursor

to free {a pointer to a text line index:index}:
    deallocate index's lines
    deallocate index

to free {text line index result:outcome}:
    set catalogue to outcome's line index
    if catalogue != (0 as a pointer to a text line index):
        free catalogue
