# Parser for a deliberately small YAML-compatible subset.
# Supported: ordered indentation-based block mappings, blank/comment lines,
# plain keys and strings, single-quoted strings, and double-quoted strings.
# Outside quoted scalars, "#" begins a comment. Errors use one-based source
# lines and UTF8 byte columns.
# Sequences, flow collections, tags, anchors, aliases, directives, typed
# scalars, and multiline scalars are not part of this library's syntax.

import lib/string.dl

class:
    patterns:
        [a|] YAML mapping node
    members:
        key as a string
        scalar as a string
        scalar presence as a boolean
        children as a pointer to a pointer to a YAML mapping node
        length as an integer
        capacity as an integer
        source line as an integer
        source column as an integer

class:
    patterns:
        [a|] YAML result
    members:
        success as a boolean
        document as a pointer to a YAML mapping node
        error line as an integer
        error column as an integer
        error message as a string

local class:
    patterns:
        [a|] decoded YAML scalar
    members:
        success as a boolean
        value as a string
        error column as an integer
        error message as a string

local function an empty YAML string:
    execute:
        return the string form of ""

local function the unsigned YAML byte at {integer:offset} in {string:source}:
    execute:
        return (the character at offset in source as a 32 bit integer) bitwise and 255

local function a new YAML mapping node named {string:name} at source position {integer:line}, {integer:column}:
    execute:
        set scalar to an empty YAML string
        set children to 0 as a pointer to a pointer to a YAML mapping node
        set initial to @intrinsic(
            "construct",
            a YAML mapping node,
            name,
            scalar,
            false,
            children,
            0,
            0,
            line,
            column
        )
        allocate 1 slots of initial and set result to it
        return result

local function add {a pointer to a YAML mapping node:child} to the YAML mapping {a pointer to a YAML mapping node:parent}:
    execute:
        if the length of parent = the capacity of parent:
            set capacity to the capacity of parent
            if capacity < 4:
                set capacity to 4
            else:
                set capacity to capacity * 2
            set children to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to a pointer to a YAML mapping node,
                the children of parent,
                capacity * the size of a pointer to a YAML mapping node
            )
            if children = (0 as a pointer to a pointer to a YAML mapping node):
                @intrinsic("call", "libc", "abort", nothing)
            set the children of parent to children
            set the capacity of parent to capacity
        @intrinsic("initialize at", (the children of parent) + (the length of parent), child)
        set the length of parent to (the length of parent) + 1

local function the YAML child index named {string:name} in {a pointer to a YAML mapping node:parent}:
    execute:
        set cursor to 0
        loop while cursor < the length of parent:
            set entry to the item at cursor in the children of parent
            if the key of entry = name:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

function free {a pointer to a YAML mapping node:document}:
    execute:
        if document = (0 as a pointer to a YAML mapping node):
            @intrinsic("return")
        set index to 0
        loop while index < the length of document:
            free the item at index in the children of document
            set index to index + 1
        @intrinsic("call", "libc", "free", nothing, the children of document)
        @intrinsic("destroy at", document)
        @intrinsic("call", "libc", "free", nothing, document)

local function a successful decoded YAML scalar containing {string:text}:
    execute:
        set message to an empty YAML string
        return @intrinsic("construct", a decoded YAML scalar, true, text, 0, message)

local function a failed decoded YAML scalar at {integer:column} reporting message:
    execute:
        set value to an empty YAML string
        set text to the string form of message
        return @intrinsic("construct", a decoded YAML scalar, false, value, column, text)

local function the YAML double-quote escape value for {integer:escaped}:
    execute:
        if escaped = 110:
            return 10
        if escaped = 114:
            return 13
        if escaped = 116:
            return 9
        if escaped = 34:
            return 34
        if escaped = 92:
            return 92
        return 0 - 1

local function the YAML scalar decoded in {string:source} from {integer:start} to {integer:finish} relative to {integer:beginning}:
    execute:
        set first to the unsigned YAML byte at start in source
        if first != 34 and first != 39:
            set text to the substring of source from start spanning (finish - start) bytes
            return a successful decoded YAML scalar containing text
        set quote to first
        set reader to start + 1
        set length to 0
        set closing to 0 - 1
        set reading to true
        loop while reading and reader < finish:
            set current to the unsigned YAML byte at reader in source
            if quote = 34 and current = 92:
                if reader + 1 >= finish:
                    set column to (reader - beginning) + 1
                    return a failed decoded YAML scalar at column reporting "unterminated quoted scalar escape"
                set escaped to the unsigned YAML byte at reader + 1 in source
                if the YAML double-quote escape value for escaped < 0:
                    set column to (reader - beginning) + 1
                    return a failed decoded YAML scalar at column reporting "unsupported quoted scalar escape"
                set length to length + 1
                set reader to reader + 2
            else if current = quote:
                if quote = 39 and reader + 1 < finish:
                    if the unsigned YAML byte at reader + 1 in source = 39:
                        set length to length + 1
                        set reader to reader + 2
                    else:
                        set closing to reader
                        set reading to false
                else:
                    set closing to reader
                    set reading to false
            else:
                set length to length + 1
                set reader to reader + 1
        if closing < 0:
            set column to (start - beginning) + 1
            return a failed decoded YAML scalar at column reporting "unterminated quoted scalar"
        set cursor to closing + 1
        loop while cursor < finish:
            set octet to the unsigned YAML byte at cursor in source
            if octet = 32 or octet = 9:
                set cursor to cursor + 1
            else:
                set column to (cursor - beginning) + 1
                return a failed decoded YAML scalar at column reporting "unexpected text after quoted scalar"
        set text to a new string buffer containing length bytes
        set writer to 0
        set reader to start + 1
        loop while reader < closing:
            set current to the unsigned YAML byte at reader in source
            if quote = 34 and current = 92:
                set escaped to the unsigned YAML byte at reader + 1 in source
                store the YAML double-quote escape value for escaped as a byte into the data of text at writer
                set reader to reader + 2
            else if quote = 39 and current = 39:
                store 39 as a byte into the data of text at writer
                set reader to reader + 2
            else:
                store current as a byte into the data of text at writer
                set reader to reader + 1
            set writer to writer + 1
        return a successful decoded YAML scalar containing text

local function a YAML parsing failure for {a pointer to a YAML mapping node:document} with {a pointer to a pointer to a YAML mapping node:ancestors} at source position {integer:line}, {integer:column} reporting message:
    execute:
        @intrinsic("call", "libc", "free", nothing, ancestors)
        free document
        set text to the string form of message
        return @intrinsic(
            "construct",
            a YAML result,
            false,
            0 as a pointer to a YAML mapping node,
            line,
            column,
            text
        )

local function a successful YAML parsing with {a pointer to a YAML mapping node:document}:
    execute:
        set message to an empty YAML string
        return @intrinsic("construct", a YAML result, true, document, 0, 0, message)

local function scan the YAML line in {string:source} from {integer:start} storing its end at {a pointer to an integer:destination} and its continuation at {a pointer to an integer:continuation}:
    execute:
        set ending to start
        set scanning to true
        loop while scanning and ending < the length of source:
            set octet to the unsigned YAML byte at ending in source
            if octet = 10 or octet = 13:
                set scanning to false
            else:
                set ending to ending + 1
        set next to ending
        if next < the length of source:
            if the unsigned YAML byte at next in source = 13:
                set next to next + 1
                if next < the length of source:
                    if the unsigned YAML byte at next in source = 10:
                        set next to next + 1
            else:
                set next to next + 1
        @intrinsic("store at", destination, ending)
        @intrinsic("store at", continuation, next)

local function the YAML leading content in {string:source} from {integer:start} to {integer:finish}:
    execute:
        set position to start
        set trimming to true
        loop while trimming and position < finish:
            set octet to the unsigned YAML byte at position in source
            if octet = 32 or octet = 9:
                set position to position + 1
            else:
                set trimming to false
        return position

local function the YAML trailing content end in {string:source} from {integer:start} to {integer:finish}:
    execute:
        set position to finish
        set trimming to true
        loop while trimming and position > start:
            set octet to the unsigned YAML byte at position - 1 in source
            if octet = 32 or octet = 9:
                set position to position - 1
            else:
                set trimming to false
        return position

local function find YAML delimiters in {string:source} from {integer:start} to {integer:finish} storing colon at {a pointer to an integer:destination} and comment at {a pointer to an integer:annotation}:
    execute:
        set delimiter to 0 - 1
        set marker to finish
        set cursor to start
        set quote to 0
        set escaped to false
        set scanning to true
        loop while scanning and cursor < finish:
            set octet to the unsigned YAML byte at cursor in source
            if quote = 0:
                if octet = 35:
                    set marker to cursor
                    set scanning to false
                else:
                    if delimiter < 0 and octet = 58:
                        set delimiter to cursor
                    if octet = 34 or octet = 39:
                        set quote to octet
                    set cursor to cursor + 1
            else if quote = 34:
                if escaped:
                    set escaped to false
                else if octet = 92:
                    set escaped to true
                else if octet = 34:
                    set quote to 0
                set cursor to cursor + 1
            else:
                if octet = 39:
                    if cursor + 1 < finish:
                        if the unsigned YAML byte at cursor + 1 in source = 39:
                            set cursor to cursor + 1
                        else:
                            set quote to 0
                    else:
                        set quote to 0
                set cursor to cursor + 1
        @intrinsic("store at", destination, delimiter)
        @intrinsic("store at", annotation, marker)

local function the YAML mapping parsed from {string:source}:
    execute:
        set name to an empty YAML string
        set document to a new YAML mapping node named name at source position 0, 0
        allocate (the length of source + 1) slots of a pointer to a YAML mapping node and set ancestors to it
        store document into ancestors at 0
        set width to 0
        set previous to 0
        set prior to 0 as a pointer to a YAML mapping node
        set offset to 0
        set line to 1
        loop while offset < the length of source:
            set origin to offset
            set ending to origin
            set next to ending
            scan the YAML line in source from origin storing its end at the address of ending and its continuation at the address of next
            set offset to next
            set content to the YAML leading content in source from origin to ending
            set present to content < ending
            if present:
                if the unsigned YAML byte at content in source = 35:
                    set present to false
            if present:
                set cursor to origin
                loop while cursor < content:
                    if the unsigned YAML byte at cursor in source = 9:
                        set column to (cursor - origin) + 1
                        return a YAML parsing failure for document with ancestors at source position line, column reporting "tabs are not allowed for indentation"
                    set cursor to cursor + 1
                set spaces to content - origin
                set column to spaces + 1
                set depth to 0
                if spaces > 0:
                    if width = 0:
                        set width to spaces
                        set depth to 1
                    else:
                        if the remainder of spaces divided by width != 0:
                            return a YAML parsing failure for document with ancestors at source position line, column reporting "indentation does not match the established width"
                        set depth to spaces / width
                if depth > previous + 1:
                    return a YAML parsing failure for document with ancestors at source position line, column reporting "indentation can only increase by one level"
                if depth > previous:
                    if prior = (0 as a pointer to a YAML mapping node):
                        return a YAML parsing failure for document with ancestors at source position line, column reporting "an indented entry must follow a parent entry"
                    if prior's scalar presence:
                        return a YAML parsing failure for document with ancestors at source position line, column reporting "a scalar entry cannot contain nested entries"
                    store prior into ancestors at depth
                set parent to the item at depth in ancestors
                set delimiter to 0 - 1
                set comment to ending
                find YAML delimiters in source from content to ending storing colon at the address of delimiter and comment at the address of comment
                if delimiter < 0 or delimiter >= comment:
                    return a YAML parsing failure for document with ancestors at source position line, column reporting "expected a mapping entry with ':'"
                set beginning to content
                set ending to the YAML trailing content end in source from beginning to delimiter
                if ending <= beginning:
                    return a YAML parsing failure for document with ancestors at source position line, column reporting "a mapping key cannot be empty"
                set column to (beginning - origin) + 1
                set initial to the unsigned YAML byte at beginning in source
                if initial = 34 or initial = 39:
                    return a YAML parsing failure for document with ancestors at source position line, column reporting "quoted mapping keys are not supported"
                set name to the substring of source from beginning spanning (ending - beginning) bytes
                if the YAML child index named name in parent >= 0:
                    return a YAML parsing failure for document with ancestors at source position line, column reporting "duplicate mapping key"
                set remainder to delimiter + 1
                set start to the YAML leading content in source from remainder to comment
                set finish to the YAML trailing content end in source from start to comment
                set child to a new YAML mapping node named name at source position line, column
                if start < finish:
                    set decoded to the YAML scalar decoded in source from start to finish relative to origin
                    if decoded failed:
                        set column to decoded's error column
                        set message to decoded's error message
                        free child
                        return a YAML parsing failure for document with ancestors at source position line, column reporting message
                    set the scalar of child to the value of decoded
                    set child's scalar presence to true
                add child to the YAML mapping parent
                set prior to child
                set previous to depth
            set line to line + 1
        @intrinsic("call", "libc", "free", nothing, ancestors)
        return a successful YAML parsing with document

local function the YAML mapping parsed from {C string:source}:
    execute:
        return the YAML mapping parsed from the string form of source

flex function parse source as a YAML mapping:
    replacement:
        set the subject to the YAML mapping parsed from source

function {YAML result:outcome} succeeded:
    replacement:
        outcome's success

function {YAML result:outcome} failed:
    replacement:
        the inverse of outcome's success

local function {decoded YAML scalar:outcome} succeeded:
    replacement:
        outcome's success

local function {decoded YAML scalar:outcome} failed:
    replacement:
        the inverse of outcome's success

function the number of YAML entries in {a pointer to a YAML mapping node:parent}:
    execute:
        return the length of parent

function {a pointer to a YAML mapping node:node} is a YAML mapping:
    replacement:
        the inverse of node's scalar presence

function {a pointer to a YAML mapping node:node} is a YAML scalar:
    replacement:
        node's scalar presence

function the YAML key of {a pointer to a YAML mapping node:node}:
    execute:
        return the key of node

function the YAML scalar of {a pointer to a YAML mapping node:node}:
    execute:
        if node is a YAML mapping:
            @intrinsic("call", "libc", "abort", nothing)
        return the scalar of node

function the YAML source line of {a pointer to a YAML mapping node:node}:
    replacement:
        node's source line

function the YAML source column of {a pointer to a YAML mapping node:node}:
    replacement:
        node's source column

function the YAML entry at index {integer:index} in {a pointer to a YAML mapping node:parent}:
    execute:
        if index < 0 or index >= the length of parent:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at index in the children of parent

function {a pointer to a YAML mapping node:parent} has YAML entry named {any:name}:
    execute:
        return the YAML child index named the string form of name in parent >= 0

function the YAML entry named {any:name} in {a pointer to a YAML mapping node:parent}:
    execute:
        set index to the YAML child index named the string form of name in parent
        if index < 0:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at index in the children of parent

function the YAML scalar named {any:name} in {a pointer to a YAML mapping node:parent}:
    execute:
        set child to the YAML entry named name in parent
        return the YAML scalar of child

function free {YAML result:outcome}:
    execute:
        set document to outcome's document
        if document != (0 as a pointer to a YAML mapping node):
            free document
