# DynLex Process Library

import lib/std.dl

local class:
    patterns:
        [a|] process text
    members:
        data as a pointer to a byte
        length as a word sized integer
        storage as a string

local function a process text for {C string:value}:
    execute:
        set storage to @intrinsic(
            "construct",
            a string,
            0 as a pointer to a byte,
            0,
            0 as a pointer to an integer
        )
        set length to the length of value
        return @intrinsic("construct", a process text, value, length as a word sized integer, storage)

local function a process text for {string:value}:
    execute:
        return @intrinsic(
            "construct",
            a process text,
            the data of value,
            value's length as a word sized integer,
            value
        )

local function an empty process error:
    execute:
        return the string form of ""

local function the current process error:
    execute:
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_error_message",
            a word sized integer,
            0 as a pointer to a byte,
            0 as a word sized integer
        )
        set message to a new string buffer containing (size as an integer) bytes
        if size > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_process_error_message",
                a word sized integer,
                the data of message,
                size + 1
            )
        return message

function the process platform is Windows:
    execute:
        return @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_platform_is_windows",
            an integer
        ) != 0

class:
    patterns:
        [a|] process command
    members:
        handle as a pointer
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_process_command_retain", nothing, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_process_command_release", nothing, handle)

class:
    patterns:
        [a|] process
    members:
        handle as a pointer
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_process_retain", nothing, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_process_release", nothing, handle)

class:
    patterns:
        [a|] process action
    members:
        success as a boolean
        error message as a string

class:
    patterns:
        [a|] process write result
    members:
        success as a boolean
        byte count as a word sized integer
        error message as a string

class:
    patterns:
        [a|] process read result
    members:
        success as a boolean
        contents as a string
        end of stream as a boolean
        error message as a string

class:
    patterns:
        [a|] process wait result
    members:
        success as a boolean
        completion as a boolean
        exit code as a word sized integer
        termination as a boolean
        termination signal as an integer
        error message as a string

class:
    patterns:
        [a|] process result
    members:
        launch as a boolean
        success as a boolean
        standard output as a string
        standard error as a string
        exit code as a word sized integer
        termination as a boolean
        termination signal as an integer
        error message as a string

local class:
    patterns:
        [a|] process wait strategy
    members:
        blocking as a boolean

local function a blocking process wait strategy:
    replacement:
        @intrinsic("construct", a process wait strategy, true)

local function a nonblocking process wait strategy:
    replacement:
        @intrinsic("construct", a process wait strategy, false)

local function a successful process action:
    replacement:
        @intrinsic("construct", a process action, true, an empty process error)

local function a failed process action:
    replacement:
        @intrinsic("construct", a process action, false, the current process error)

local function a failed process write after writing count:
    replacement:
        @intrinsic(
            "construct",
            a process write result,
            false,
            count,
            the current process error
        )

local function a failed process read result:
    replacement:
        @intrinsic(
            "construct",
            a process read result,
            false,
            the string form of "",
            false,
            the current process error
        )

local function a failed process wait result:
    replacement:
        @intrinsic(
            "construct",
            a process wait result,
            false,
            false,
            0 as a 64 bit integer,
            false,
            0 as a 32 bit integer,
            the current process error
        )

function {process action:result} succeeded:
    replacement:
        result's success

function {process action:result} failed:
    replacement:
        the inverse of result's success

function {process write result:result} succeeded:
    replacement:
        result's success

function {process write result:result} failed:
    replacement:
        the inverse of result's success

function {process read result:result} succeeded:
    replacement:
        result's success

function {process read result:result} failed:
    replacement:
        the inverse of result's success

function {process read result:result} reached the end of stream:
    replacement:
        result's end of stream

function {process read result:result} has not reached the end of stream:
    replacement:
        the inverse of result's end of stream

function {process wait result:result} succeeded:
    replacement:
        result's success

function {process wait result:result} failed:
    replacement:
        the inverse of result's success

function {process result:result} succeeded:
    replacement:
        result's success

function {process result:result} failed:
    replacement:
        the inverse of result's success

function {process wait result:result} reports completion:
    replacement:
        result's completion

function {process wait result:result} reports termination:
    replacement:
        result's termination

function {process result:result} was launched:
    replacement:
        result's launch

function {process result:result} reports termination:
    replacement:
        result's termination

function a process command for executable:
    execute:
        set prepared to a process text for executable
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_create",
            a pointer to a byte,
            prepared's data,
            prepared's length
        )
        return @intrinsic("construct", a process command, handle)

function add value as an argument to {process command:command}:
    execute:
        set prepared to a process text for value
        ignore @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_add_argument",
            an integer,
            command's handle,
            prepared's data,
            prepared's length
        )

function use path as the working directory of {process command:command}:
    execute:
        set prepared to a process text for path
        ignore @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_set_working_directory",
            an integer,
            command's handle,
            prepared's data,
            prepared's length
        )

function inherit the environment in {process command:command}:
    execute:
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_inherit_environment",
            nothing,
            command's handle,
            1
        )

function do not inherit the environment in {process command:command}:
    execute:
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_inherit_environment",
            nothing,
            command's handle,
            0
        )

function set environment variable name of {process command:command} to value:
    execute:
        set key to a process text for name
        set setting to a process text for value
        ignore @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_set_environment",
            an integer,
            command's handle,
            key's data,
            key's length,
            setting's data,
            setting's length
        )

function unset environment variable name of {process command:command}:
    execute:
        set key to a process text for name
        ignore @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_command_unset_environment",
            an integer,
            command's handle,
            key's data,
            key's length
        )

local function the process launched from {process command:command}:
    execute:
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_launch",
            a pointer to a byte,
            command's handle
        )
        return @intrinsic("construct", a process, handle)

flex function launch {process command:command}:
    replacement:
        set the subject to the process launched from command

function {process:child} was launched:
    execute:
        return @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_was_launched",
            an integer,
            child's handle
        ) != 0

function {process:child} failed to launch:
    execute:
        return @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_was_launched",
            an integer,
            child's handle
        ) = 0

function the starting error of {process:child}:
    execute:
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_launch_error",
            a word sized integer,
            child's handle,
            0 as a pointer to a byte,
            0 as a word sized integer
        )
        set message to a new string buffer containing (size as an integer) bytes
        if size > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_process_launch_error",
                a word sized integer,
                child's handle,
                the data of message,
                size + 1
            )
        return message

local function the result of writing {string:input} to {process:child}:
    execute:
        if child failed to launch:
            return (a failed process write after writing 0 as a word sized integer)
        set written to 0 as a word sized integer
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_write",
            an integer,
            child's handle,
            the data of input,
            input's length as a word sized integer,
            the address of written
        )
        if outcome != 0:
            return (a failed process write after writing written)
        return @intrinsic("construct", a process write result, true, written, an empty process error)

local function the result of writing {C string:input} to {process:child}:
    execute:
        return the result of writing the string form of input to child

flex function write input to the standard input of {process:child}:
    replacement:
        set the subject to the result of writing input to child

local function the result of closing the standard input of {process:child}:
    execute:
        if child failed to launch:
            return a failed process action
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_close_input",
            an integer,
            child's handle
        )
        if outcome != 0:
            return a failed process action
        return a successful process action

flex function close the standard input of {process:child}:
    replacement:
        set the subject to the result of closing the standard input of child

local function the result of reading {integer:stream} from {process:child} using {process wait strategy:strategy}:
    execute:
        if child failed to launch:
            return a failed process read result
        set capacity to 4096
        set buffer to a new string buffer containing capacity bytes
        set count to 0 as a word sized integer
        set ended to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_read",
            an integer,
            child's handle,
            stream,
            strategy's blocking as an integer,
            the data of buffer,
            capacity as a word sized integer,
            the address of count,
            the address of ended
        )
        if outcome != 0:
            return a failed process read result
        set contents to buffer
        if count < capacity as a word sized integer:
            set contents to the substring of buffer from 0 spanning (count as an integer) bytes
        return @intrinsic(
            "construct",
            a process read result,
            true,
            contents,
            ended != 0,
            an empty process error
        )

flex function read the standard output of {process:child}:
    replacement:
        set the subject to the result of reading 1 from child using a blocking process wait strategy

flex function read the standard error of {process:child}:
    replacement:
        set the subject to the result of reading 2 from child using a blocking process wait strategy

flex function read the available standard output of {process:child}:
    replacement:
        set the subject to the result of reading 1 from child using a nonblocking process wait strategy

flex function read the available standard error of {process:child}:
    replacement:
        set the subject to the result of reading 2 from child using a nonblocking process wait strategy

local function the status of {process:child} using {process wait strategy:strategy}:
    execute:
        if child failed to launch:
            return a failed process wait result
        set finished to 0
        set code to 0 as a word sized integer
        set terminated to 0
        set signal to 0 as an integer
        set outcome to 0
        if strategy's blocking:
            set outcome to @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_process_wait",
                an integer,
                child's handle,
                the address of finished,
                the address of code,
                the address of terminated,
                the address of signal
            )
        else:
            set outcome to @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_process_poll",
                an integer,
                child's handle,
                the address of finished,
                the address of code,
                the address of terminated,
                the address of signal
            )
        if outcome != 0:
            return a failed process wait result
        return @intrinsic(
            "construct",
            a process wait result,
            true,
            finished != 0,
            code,
            terminated != 0,
            signal,
            an empty process error
        )

flex function poll {process:child}:
    replacement:
        set the subject to the status of child using a nonblocking process wait strategy

flex function wait for {process:child}:
    replacement:
        set the subject to the status of child using a blocking process wait strategy

local function the result of terminating {process:child}:
    execute:
        if child failed to launch:
            return a failed process action
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_terminate",
            an integer,
            child's handle
        )
        if outcome != 0:
            return a failed process action
        return a successful process action

flex function terminate {process:child}:
    replacement:
        set the subject to the result of terminating child

local function the result of cleaning up {process:child}:
    execute:
        if child failed to launch:
            return a failed process action
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_cleanup",
            an integer,
            child's handle
        )
        if outcome != 0:
            return a failed process action
        return a successful process action

flex function clean up {process:child}:
    replacement:
        set the subject to the result of cleaning up child

local function the remaining output from stream {integer:stream} of {process:child}:
    execute:
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_output_size",
            a word sized integer,
            child's handle,
            stream
        )
        set text to a new string buffer containing (size as an integer) bytes
        if size > 0 as a word sized integer:
            ignore @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_process_copy_output",
                a word sized integer,
                child's handle,
                stream,
                the data of text,
                size
            )
        return text

local function a failed process result that was not launched:
    replacement:
        @intrinsic(
            "construct",
            a process result,
            false,
            false,
            the string form of "",
            the string form of "",
            0 as a 64 bit integer,
            false,
            0 as a 32 bit integer,
            the current process error
        )

local function the result of running {process command:command} using {string:input}:
    execute:
        launch command and set child to it
        if child failed to launch:
            return a failed process result that was not launched
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_process_communicate",
            an integer,
            child's handle,
            the data of input,
            input's length as a word sized integer
        )
        set failure to an empty process error
        if outcome != 0:
            set failure to the current process error
        set status to the status of child using a blocking process wait strategy
        if (outcome = 0) and status failed:
            set failure to status's error message
        set output to the remaining output from stream 1 of child
        set errors to the remaining output from stream 2 of child
        return @intrinsic(
            "construct",
            a process result,
            true,
            (outcome = 0) and status succeeded,
            output,
            errors,
            status's exit code,
            status's termination,
            status's termination signal,
            failure
        )

local function the result of running {process command:command} using {C string:input}:
    execute:
        return the result of running command using (the string form of input)

local function the result of running {process command:command}:
    execute:
        return the result of running command using (the string form of "")

flex function run {process command:command} using input:
    replacement:
        set the subject to the result of running command using input

flex function run {process command:command}:
    replacement:
        set the subject to the result of running command
