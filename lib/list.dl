# DynLex Resizable List Library

import lib/array.dl

class:
    patterns:
        [a|] list
    members:
        data
        length as i32
        capacity as i32

function an empty list of {type:element_type}:
    execute:
        set data to 0 as a pointer to element_type
        set initial_value to @intrinsic("construct", a list, data, 0, 0)
        set result to allocate 1 slots of initial_value
        return result

function a list containing first_item:
    execute:
        set result to an empty list of the type of first_item
        append first_item to result
        return result

function stop because a list index is out of bounds:
    execute:
        @intrinsic("call", "libc", "abort", void)

function list {a pointer to list:values} has index {integer:position}:
    execute:
        return position >= 0 and position < the length of values

function item {integer:position} of {a pointer to list:values}:
    execute:
        if not list values has index position:
            stop because a list index is out of bounds
        return item position of the data of values

function [the|] last item of {a pointer to list:values}:
    execute:
        if the length of values = 0:
            stop because a list index is out of bounds
        return item ((the length of values) - 1) of values

function ensure list {a pointer to list:values} has capacity for required_count using sample:
    execute:
        if required_count > the capacity of values:
            set new_capacity to the capacity of values
            if new_capacity < 4:
                set new_capacity to 4
            loop while new_capacity < required_count:
                set new_capacity to new_capacity * 2
            set resized_data to @intrinsic("call", "libc", "realloc", a pointer to the type of sample, the data of values, new_capacity * the size of the type of sample)
            set the data of values to resized_data
            set the capacity of values to new_capacity

function append item to {a pointer to list:values}:
    execute:
        ensure list values has capacity for (the length of values) + 1 using item
        store item into the data of values at the length of values
        set the length of values to (the length of values) + 1

function insert item into {a pointer to list:values} at index {integer:position}:
    execute:
        if position < 0 or position > the length of values:
            stop because a list index is out of bounds
        ensure list values has capacity for (the length of values) + 1 using item
        set move_index to the length of values
        loop while move_index > position:
            store item move_index - 1 of the data of values into the data of values at move_index
            set move_index to move_index - 1
        store item into the data of values at position
        set the length of values to (the length of values) + 1

function replace item at index {integer:position} in {a pointer to list:values} with replacement:
    execute:
        if not list values has index position:
            stop because a list index is out of bounds
        store replacement into the data of values at position

function remove and return [the|] last item from {a pointer to list:values}:
    execute:
        set result to the last item of values
        set the length of values to (the length of values) - 1
        return result

function remove item {integer:position} from {a pointer to list:values}:
    execute:
        if not list values has index position:
            stop because a list index is out of bounds
        set move_index to position
        loop while move_index + 1 < the length of values:
            store item move_index + 1 of the data of values into the data of values at move_index
            set move_index to move_index + 1
        set the length of values to (the length of values) - 1

function {a pointer to list:values} contains item:
    execute:
        set index to 0
        loop while index < the length of values:
            if item index of values = item:
                return true
            set index to index + 1
        return false

function [the|] index of item in {a pointer to list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            if item cursor of values = item:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

function {a pointer to list:values} is empty:
    execute:
        return the length of values = 0

function clear {a pointer to list:values}:
    execute:
        set the length of values to 0

function free list {a pointer to list:values}:
    execute:
        @intrinsic("call", "libc", "free", void, the data of values)
        @intrinsic("call", "libc", "free", void, values)
