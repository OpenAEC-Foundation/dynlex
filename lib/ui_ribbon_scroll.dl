# A ribbon keeps one strip of groups. Each tab owns its scroll position.
import lib/ui_layout_types.dl
import lib/ui_ribbon.dl

to get the UI layout for element {UI reference:node} in {a pointer to UI layout:layout}:
    if layout's node = node:
        return layout
    set child to layout's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set found to the UI layout for element node in child
        if found != @intrinsic("construct", a pointer to UI layout):
            return found
        set child to child's next
    return @intrinsic("construct", a pointer to UI layout)

to get the active UI tab in {a pointer to UI layout:layout} for {a pointer to UI instance:instance}:
    set selected to the selected tab of (layout's node) in instance
    set child to layout's first
    loop while child's node != selected:
        set child to child's next
    return child

to get the ribbon content width of {a pointer to UI layout:tab}:
    set span to 0.0
    set child to tab's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set span to the maximum of span and (child's bounds' x + child's bounds' width)
        set child to child's next
    return span

to get the ribbon viewport width for {a pointer to UI layout:tab} in {a pointer to UI layout:ribbon}:
    set span to ribbon's bounds' width - 12.0
    if (the ribbon content width of tab) > span:
        set span to span - 48.0
    return span

to get the ribbon scroll limit for {a pointer to UI layout:tab} within {floating-point number:width}:
    return the maximum of 0.0 and ((the ribbon content width of tab) - width)

to get UI ribbon arrow {a pointer to UI layout:control} is visible in {a pointer to UI layout:root} for {a pointer to UI instance:instance}:
    set strip to the UI layout for element (control's parent) in root
    set tab to the active UI tab in strip for instance
    if control's node's columns < 0:
        return tab's scroll position > 0.0
    return tab's scroll position < (the ribbon scroll limit for tab within (the ribbon viewport width for tab in strip))

to scroll ribbon tab {a pointer to UI layout:tab} in direction {integer:direction} within {floating-point number:width}:
    set limit to the ribbon scroll limit for tab within width
    set destination to 0.0
    if direction > 0:
        set destination to limit
    set child to tab's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set left to child's bounds' x
        if direction > 0:
            if left > (tab's scroll target + 0.5):
                set tab's scroll target to the minimum of limit and left
                return nothing
        else if left < (tab's scroll target - 0.5):
            set destination to left
        set child to child's next
    set tab's scroll target to destination

to constrain ribbon scrolling in {a pointer to UI layout:layout}:
    set child to layout's first
    set index to 0
    loop while index < layout's node's count:
        set width to the ribbon viewport width for child in layout
        set limit to the ribbon scroll limit for child within width
        set child's scroll target to the minimum of limit and (child's scroll target)
        set child's scroll position to the minimum of limit and (child's scroll position)
        set child to child's next
        increment index

to reveal UI control ordered {integer:order} in {a pointer to UI layout:layout} at {floating-point number:offset} within {floating-point number:width} for {a pointer to UI layout:tab}:
    set left to offset + layout's bounds' x
    if layout's order = order:
        if left < tab's scroll target:
            set tab's scroll target to left
        if (left + layout's bounds' width) > (tab's scroll target + width):
            set tab's scroll target to (left + layout's bounds' width) - width
    set child to layout's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        reveal UI control ordered order in child at left within width for tab
        set child to child's next
