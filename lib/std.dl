# DynLex Standard Library

import lib/string.dl

# --- Basic patterns ---

function return value:
    replacement:
        @intrinsic("return", value)

function a new {type:kind} from value:
	replacement:
		@intrinsic("construct", kind, value)

# --- Variables ---

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

flex function set the subject to value:
    replacement:
        @intrinsic("set subject", value)

flex function it:
    replacement:
        @intrinsic("subject")

# --- Primitive types ---

function any:
    replacement:
        @intrinsic("type", "any")

function fixed:
    replacement:
        @intrinsic("fix", any)

function fixed value:
    replacement:
        @intrinsic("fix", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function [a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("type", "int", bits)

function [a|] float:
    replacement:
        @intrinsic("type", "float")

function [a|] {fixed integer:bits} bit float:
    replacement:
        @intrinsic("type", "float", bits)

function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

function [a|] boolean:
    replacement:
        @intrinsic("type", "bool")

function true:
    replacement:
        1 as a boolean

function false:
    replacement:
        0 as a boolean

function [a|] type:
	replacement:
		@intrinsic("type", "type")

function [a|] constraint:
    replacement:
        @intrinsic("type", "constraint")

function [a|] {fixed integer:bits} bit any:
    replacement:
        @intrinsic("type", "any", bits)

function nothing:
    replacement:
        @intrinsic("type", "void")

function a number:
    replacement:
        @intrinsic("number")

# --- Pointer and string types ---

function [a|] pointer:
    replacement:
        a pointer to a byte

function [a|] pointer to {type:kind}:
    replacement:
        @intrinsic("add pointer depth", kind)

function an array:
    replacement:
        @intrinsic("array")

function [an|] array of {fixed integer:count} [item|items]:
    replacement:
        @intrinsic("array", count)

function {type:kind} array of {fixed integer:count} [item|items]:
    replacement:
        @intrinsic("array", count, kind)

function {fixed integer:count} {type:kind} array:
    replacement:
        @intrinsic("array", count, kind)

flex function [an|] array as long as value:
    replacement:
        @intrinsic("array", @intrinsic("type extent", value, 0))

function [an|] array of numbers:
    replacement:
        @intrinsic("array", a number)

flex function [an|] array of numbers as long as value:
    replacement:
        @intrinsic("array", @intrinsic("type extent", value, 0), a number)

function the length of {an array:values}:
    replacement:
        @intrinsic("type extent", values, 0)

function the element type of value:
    replacement:
        @intrinsic("element type", value)

function the arithmetic type promoted from {type:left} and {type:right}:
    replacement:
        @intrinsic("promote arithmetic type", left, right)

# --- Type casts ---

function value as {type:destination}:
    execute:
        return @intrinsic("cast", value, destination)

function truth if {boolean:condition}, else falsehood:
    replacement:
        @intrinsic("select", condition, truth, falsehood)

function the build info {fixed C string:key}:
    replacement:
        @intrinsic("build info", key)

function the build word size:
    replacement:
        @intrinsic("build info", "word size")

function [a|] word sized integer:
    replacement:
        @intrinsic("type", "int", @intrinsic("build info", "word size"))

function [a|] C long integer:
    replacement:
        @intrinsic("type", "int", @intrinsic("build info", "c long size"))

function the build optimization level:
    replacement:
        @intrinsic("build info", "optimization level")

function the build target is CPU:
    replacement:
        @intrinsic("target is", "cpu")

function the build target is GPU:
    replacement:
        @intrinsic("target is", "gpu")

function the build target is WebAssembly:
    replacement:
        @intrinsic("target is", "wasm")

function an aggregate of {fixed integer:count} {type:kind} values:
    execute:
        if the build target is GPU:
            return @intrinsic("vector", count, kind)
        return @intrinsic("array", count, kind)

function this is a {word:stage} shader:
    replacement:
        @intrinsic("shader stage is", stage)

function the size of kind:
    replacement:
        @intrinsic("size of", kind)

function the type of value:
    replacement:
        @intrinsic("type of", value)

function the function named {fixed C string:name}:
    replacement:
        @intrinsic("function", name)

# --- Pointers ---

function the address of variable:
    replacement:
        @intrinsic("address of", variable)

function the value at address:
    replacement:
        @intrinsic("dereference", address)

function store value at address:
    replacement:
        @intrinsic("store at", address, value)

function the item at index in address:
    replacement:
        @intrinsic("dereference", address + index)

# --- Arithmetic (with precedence) ---

# Precedence chain (lowest to highest):
#   or < and < the inverse of < | < ^ < & < comparisons < <<,>> < +,- < *,remainder < negative, bitwise inverse

function left[ |]|[ |]right:
    before: $ or $, $ and $, the inverse of $
    execute:
        return @intrinsic("bitwise or", left, right)

function left bitwise or right:
    before: $ or $, $ and $, the inverse of $
    execute:
        return @intrinsic("bitwise or", left, right)

function left[ |]^[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left bitwise xor right:
    before: $ or $, $ and $, the inverse of $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left[ |]&[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left bitwise and right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left[ |]<<[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", left, right)

function value shifted left by distance:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", value, distance)

function left[ |]>>[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", left, right)

function value shifted right by distance:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", value, distance)

function left[ |]+[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("add", left, right)

function left[ |]-[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("subtract", left, right)

function left[ |]*[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("multiply", left, right)

function left[ |]/[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("divide", left, right)

function {an array of numbers:left}[ |]+[ |]{an array of numbers as long as left:right}:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the element type of right))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) + (the item at position in right)) at result + position
        return result

function {an array of numbers:left}[ |]-[ |]{an array of numbers as long as left:right}:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the element type of right))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) - (the item at position in right)) at result + position
        return result

function {an array of numbers:left}[ |]*[ |]{a number:factor}:
    before: $ + $, $ - $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the type of factor))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) * factor) at result + position
        return result

function {an array of numbers:left}[ |]/[ |]{a number:divisor}:
    before: $ + $, $ - $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the type of divisor))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) / divisor) at result + position
        return result

function the remainder of left divided by right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("modulo", left, right)

function [the negative of |the opposite of |-]value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("negate", value)

function ~value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("bitwise not", value)

function the bitwise inverse of value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("bitwise not", value)

function multiply value by factor:
	replacement:
		set value to value * factor

function divide value by divisor:
	replacement:
		set value to value / divisor

function add value to target:
	replacement:
		set target to target + value

function subtract value from target:
	replacement:
		set target to target - value

function increment value:
	replacement:
		set value to value + 1

function decrement value:
	replacement:
		set value to value - 1

# --- Clamping ---

function clamp value between low and high:
	replacement:
		if value < low:
			set value to low
		if value > high:
			set value to high

function {a number:value} clamped between {a number:low} and {a number:high}:
    execute:
        return @intrinsic("min", @intrinsic("max", value, low), high)

# --- Math functions ---

function the sine of value:
    after: default
    execute:
        return @intrinsic("sin", value)

function the cosine of value:
    after: default
    execute:
        return @intrinsic("cos", value)

function the square root of value:
    after: default
    execute:
        return @intrinsic("sqrt", value)

function the absolute value of magnitude:
    after: default
    execute:
        return @intrinsic("abs", magnitude)

function the floor of value:
    after: default
    execute:
        return @intrinsic("floor", value)

function the ceiling of value:
    after: default
    execute:
        return @intrinsic("ceil", value)

function value [raised to the power of|to the power of] exponent:
    after: default
    execute:
        return @intrinsic("pow", value, exponent)

function the minimum of left and right:
    after: default
    execute:
        return @intrinsic("min", left, right)

function the maximum of left and right:
    after: default
    execute:
        return @intrinsic("max", left, right)

function the product of left and right:
    after: default
    execute:
        return @intrinsic("multiply", left, right)

# --- Comparison ---

function left < right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than", left, right)

function left > right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than", left, right)

function left = right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left is right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left [!=|is not] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    replacement:
        the inverse of left = right

function left [is less than or equal to|<=] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than or equal", left, right)

function left [is greater than or equal to|>=] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than or equal", left, right)

# --- Logic ---

function the inverse of value:
    before: $ or $, $ and $
    replacement:
        @intrinsic("not", value)

function {boolean:left} and {boolean:right}:
    before: $ or $
    execute:
        return @intrinsic("and", left, right)

flex function {nothing:left} and {nothing:right}:
    before: $ or $
    replacement:
        left
        right

function left or right:
    before: default
    execute:
        return @intrinsic("or", left, right)

# --- Control flow ---

flex function loop while condition:
    replacement:
        @intrinsic("loop while", condition)

flex function execute the body:
    replacement:
        @intrinsic("execute body")

flex section [loop |]while condition:
    replacement:
        loop while condition

flex section loop count [time|times]:
    replacement:
        set iteration to 0
        loop while iteration < count:
            execute the body
            increment iteration

flex section loop index from start to end:
    replacement:
        set index to start
        loop while index < end:
            execute the body
            increment index

flex section loop index from start through end:
    replacement:
        set index to start
        loop while index <= end:
            execute the body
            increment index

flex section loop index from start down to end:
    replacement:
        set index to start
        loop while index > end:
            execute the body
            decrement index

flex section loop index from start down through end:
    replacement:
        set index to start
        loop while index >= end:
            execute the body
            decrement index

flex section if condition:
    replacement:
        @intrinsic("if", condition)

flex section else if condition:
    replacement:
        @intrinsic("else if", condition)

flex section else:
    replacement:
        @intrinsic("else")

flex section [match|switch] [based on|on] value:
    replacement:
        @intrinsic("switch", value)

flex section case value:
    replacement:
        @intrinsic("case", value)

flex section [otherwise|default]:
    replacement:
        @intrinsic("default case")

# --- Command-line arguments ---

class:
    patterns:
        [an|] argument list
    members:
        data as a pointer to a C string
        length as an integer

function the command line arguments:
    execute:
        return @intrinsic(
            "construct",
            an argument list,
            @intrinsic("command line argument values"),
            @intrinsic("command line argument count")
        )

function the argument at {integer:index} in {argument list:arguments}:
    execute:
        if index < 0 or index >= arguments' length:
            @intrinsic("call", "libc", "abort", nothing)
        set value to the item at index in arguments' data
        return a new string from value containing (the length of value) bytes
