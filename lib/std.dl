# DynLex Standard Library

import lib/string.dl

# --- Basic patterns ---

function return value:
    replacement:
        @intrinsic("return", value)

function a new variabletype from value:
	replacement:
		@intrinsic("construct", variabletype, value)

# --- Variables ---

function set var to val:
    replacement:
        @intrinsic("store", var, val)

function discard val:
    replacement:
        @intrinsic("discard", val)

# --- Primitive types ---

function [an|a|] integer:
    patterns:
        int
    replacement:
        @intrinsic("type", "int")

function [an|a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("type", "int", bits)

function [a|] float:
    replacement:
        @intrinsic("type", "float")

function [a|] {fixed integer:bits} bit float:
    replacement:
        @intrinsic("type", "float", bits)

function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

function [a|] boolean:
    replacement:
        @intrinsic("type", "bool")

function true:
    replacement:
        1 as a boolean

function false:
    replacement:
        0 as a boolean

function [a|] type:
	replacement:
		@intrinsic("type", "type")

function [a|] constraint:
    replacement:
        @intrinsic("type", "constraint")

function any:
    replacement:
        @intrinsic("type", "any")

function fix:
    replacement:
        @intrinsic("fix", any)

function fix tofix:
    replacement:
        @intrinsic("fix", tofix)

function fixed:
    replacement:
        @intrinsic("fix", any)

function fixed tofix:
    replacement:
        @intrinsic("fix", tofix)

function [a|an|] {fixed integer:bits} bit any:
    replacement:
        @intrinsic("type", "any", bits)

function i8:
    replacement:
        a byte

function i16:
    replacement:
        a 16 bit integer

function i32:
    replacement:
        a 32 bit integer

function i64:
    replacement:
        a 64 bit integer

function f32:
    replacement:
        a 32 bit float

function f64:
    replacement:
        a 64 bit float

function void:
    replacement:
        @intrinsic("type", "void")

# --- Pointer and string types ---

function pointer:
    replacement:
        a pointer to byte

function [a|] pointer to pointedtype:
    replacement:
        @intrinsic("add pointer depth", pointedtype)

function [an|a|] array of {fixed integer:n} [item|items]:
    replacement:
        @intrinsic("array", n)

function [an|a|] elementtype array of {fixed integer:n} [item|items]:
    replacement:
        @intrinsic("array", n, elementtype)

function [an|a|] {fixed integer:n} elementtype array:
    replacement:
        @intrinsic("array", n, elementtype)

# --- Type casts ---

function value as destinationtype:
    execute:
        return @intrinsic("cast", value, destinationtype)

function true_value if condition, else false_value:
    replacement:
        @intrinsic("select", condition, true_value, false_value)

function [the|] build info {fixed cstring:key}:
    replacement:
        @intrinsic("build info", key)

function [the|] build word size:
    replacement:
        @intrinsic("build info", "word size")

function [the|] build optimization level:
    replacement:
        @intrinsic("build info", "optimization level")

function [the|] build target is {word:platform}:
    replacement:
        @intrinsic("target is", platform)

function this is a {word:shaderstage} shader:
    replacement:
        @intrinsic("shader stage is", shaderstage)

function [the|] size of typetomeasure:
    replacement:
        @intrinsic("size of", typetomeasure)

function [the|] type of value:
    replacement:
        @intrinsic("type of", value)

function [the|] function named {fixed cstring:name}:
    replacement:
        @intrinsic("function", name)

# --- Pointers ---

function [the|] address of var:
    replacement:
        @intrinsic("address of", var)

function [the|] value at ptr:
    replacement:
        @intrinsic("dereference", ptr)

function element index of ptr:
    replacement:
        @intrinsic("dereference", ptr + index)

# --- Arithmetic (with precedence) ---

# Precedence chain (lowest to highest):
#   or < and < not < | < ^ < & < comparisons < <<,>> < +,- < *,/,mod < negative, bitwise not

function left[ |]|[ |]right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("bitwise or", left, right)

function left bitwise or right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("bitwise or", left, right)

function left[ |]^[ |]right:
    before: $ or $, $ and $, not $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left bitwise xor right:
    before: $ or $, $ and $, not $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left[ |]&[ |]right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left bitwise and right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left[ |]<<[ |]right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", left, right)

function left shifted left by right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", left, right)

function left[ |]>>[ |]right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", left, right)

function left shifted right by right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", left, right)

function left[ |]+[ |]right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("add", left, right)

function left[ |]-[ |]right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("subtract", left, right)

function left[ |]*[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("multiply", left, right)

function left[ |]/[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("divide", left, right)

function left mod right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("modulo", left, right)

function [the |][negative [of ]|opposite [of ]|-]value:
    before: $ * $, $ / $, $ mod $
    execute:
        return @intrinsic("negate", value)

function [the |]~value:
    before: $ * $, $ / $, $ mod $
    execute:
        return @intrinsic("bitwise not", value)

function [the|] bitwise not [of|] value:
    before: $ * $, $ / $, $ mod $
    execute:
        return @intrinsic("bitwise not", value)

function multiply value by factor:
	replacement:
		set value to value * factor

function divide value by divisor:
	replacement:
		set value to value / divisor

function add value to target:
	replacement:
		set target to target + value

function subtract value from target:
	replacement:
		set target to target - value

function increment val:
	replacement:
		set val to val + 1

function decrement val:
	replacement:
		set val to val - 1

# --- Clamping ---

function clamp val between low and high:
	replacement:
		if val < low:
			set val to low
		if val > high:
			set val to high

# --- Math functions ---

function [the|] sine of value:
    after: default
    execute:
        return @intrinsic("sin", value)

function [the|] cosine of value:
    after: default
    execute:
        return @intrinsic("cos", value)

function [the|] square root of value:
    after: default
    execute:
        return @intrinsic("sqrt", value)

function [the|] absolute value of magnitude:
    after: default
    execute:
        return @intrinsic("abs", magnitude)

function [the|] floor of value:
    after: default
    execute:
        return @intrinsic("floor", value)

function [the|] ceiling of value:
    after: default
    execute:
        return @intrinsic("ceil", value)

function value [raised|] to the power [of|] exponent:
    after: default
    execute:
        return @intrinsic("pow", value, exponent)

function [the|] minimum of a and b:
    after: default
    execute:
        return @intrinsic("min", a, b)

function [the|] maximum of a and b:
    after: default
    execute:
        return @intrinsic("max", a, b)

function [the|] product of left and right:
    after: default
    execute:
        return @intrinsic("multiply", left, right)

# --- Comparison ---

function left < right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than", left, right)

function left > right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than", left, right)

function left = right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left is right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left [!=|is not] right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("not equal", left, right)

function left [is less than or equal to|<=] right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than or equal", left, right)

function left [is greater than or equal to|>=] right:
    before: $ or $, $ and $, not $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than or equal", left, right)

# --- Logic ---

function not value:
    before: $ or $, $ and $
    execute:
        return @intrinsic("not", value)

function left and right:
    before: $ or $
    execute:
        return @intrinsic("and", left, right)

function left or right:
    before: default
    execute:
        return @intrinsic("or", left, right)

# --- Control flow ---

flex function loop while condition:
    replacement:
        @intrinsic("loop while", condition)

flex function execute [the |]body:
    replacement:
        @intrinsic("execute body")

flex section [loop |]while condition:
    replacement:
        loop while condition

flex section loop iterationcount [time|times]:
    replacement:
        set iteration to 0
        loop while iteration < iterationcount:
            execute the body
            increment iteration

flex section loop index from start to end:
    replacement:
        set index to start
        loop while index < end:
            execute the body
            increment index

flex section loop index from start through end:
    replacement:
        set index to start
        loop while index <= end:
            execute the body
            increment index

flex section loop index from start down to end:
    replacement:
        set index to start
        loop while index > end:
            execute the body
            decrement index

flex section loop index from start down through end:
    replacement:
        set index to start
        loop while index >= end:
            execute the body
            decrement index

flex section if condition:
    replacement:
        @intrinsic("if", condition)

flex section else if condition:
    replacement:
        @intrinsic("else if", condition)

flex section else:
    replacement:
        @intrinsic("else")

flex section [match|switch] [based|] [on|] value:
    replacement:
        @intrinsic("switch", value)

flex section case value:
    replacement:
        @intrinsic("case", value)

flex section [otherwise|default]:
    replacement:
        @intrinsic("default case")

# --- Command-line arguments ---

class:
    patterns:
        [an|] argument list
    members:
        data as a pointer to cstring
        length as i32

function [the|] command line arguments:
    execute:
        return @intrinsic(
            "construct",
            an argument list,
            @intrinsic("command line argument values"),
            @intrinsic("command line argument count")
        )

function argument {integer:index} of {argument list:arguments}:
    execute:
        if index < 0 or index >= arguments' length:
            @intrinsic("call", "libc", "abort", void)
        set value to item index of arguments' data
        return new string from data value with length the length of value
