# DynLex Standard Library

import lib/string.dl

# --- Basic patterns ---

function return value:
    after: default
    replacement:
        @intrinsic("return", value)

function a new type from value:
	replacement:
		@intrinsic("construct", type, value)

# --- Variables ---

function set var to val:
    replacement:
        @intrinsic("store", var, val)

function discard val:
    replacement:
        @intrinsic("discard", val)

# --- Primitive types ---

function [an|a|] integer:
    replacement:
        @intrinsic("type", "int", 32)

function [an|a|] bits bit integer:
    replacement:
        @intrinsic("type", "int", bits)

function [a|] float:
    replacement:
        @intrinsic("type", "float", 64)

function [a|] bits bit float:
    replacement:
        @intrinsic("type", "float", bits)

function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

function [a|] boolean:
    replacement:
        @intrinsic("type", "bool")

function void:
    replacement:
        @intrinsic("type", "void")

# --- Pointer and string types ---

function [a|] pointer to type:
    replacement:
        @intrinsic("add pointer depth", type)

function [an|a|] array of n [item|items]:
    replacement:
        @intrinsic("array", n)

function [an|a|] type array of n [item|items]:
    replacement:
        @intrinsic("array", n, type)

# --- Type casts ---

function value as type:
    replacement:
        @intrinsic("cast", value, type)

function true_value if condition, else false_value:
    replacement:
        @intrinsic("select", condition, true_value, false_value)

function [the|] build info key:
    replacement:
        @intrinsic("build info", key)

function [the|] build platform:
    replacement:
        the build info "platform"

# --- Class properties ---

function:
    patterns:
        the {word:propertyname} of ownername
        ownername's {word:propertyname}
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ + $, $ - $, $ * $, $ / $, $ mod $
    replacement:
        @intrinsic("property", ownername, propertyname)

# --- Pointers ---

function [the|] address of var:
    replacement:
        @intrinsic("address of", var)

function [the|] value at ptr:
    replacement:
        @intrinsic("dereference", ptr)

function element index of ptr:
    replacement:
        @intrinsic("dereference", ptr + index)

# --- Arithmetic (with precedence) ---

# Precedence chain (lowest to highest):
#   or < and < not < comparisons < +,- < *,/,mod < negative

function left + right:
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    replacement:
        @intrinsic("add", left, right)

function left - right:
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    replacement:
        @intrinsic("subtract", left, right)

function left * right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("multiply", left, right)

function left / right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("divide", left, right)

function left mod right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("modulo", left, right)

function [the|] [negative|opposite] [of|] value:
    before: $ * $, $ / $, $ mod $
    replacement:
        @intrinsic("negate", value)

function multiply value by factor:
	replacement:
		set value to @intrinsic("multiply", value, factor)

function divide value by divisor:
	replacement:
		set value to @intrinsic("divide", value, divisor)

function add value to target:
	replacement:
		set target to @intrinsic("add", target, value)

function subtract value from target:
	replacement:
		set target to @intrinsic("subtract", target, value)

function increment val:
	replacement:
		set val to @intrinsic("add", val, 1)

function decrement val:
	replacement:
		set val to @intrinsic("subtract", val, 1)

# --- Clamping ---

function clamp val between low and high:
	replacement:
		if val < low:
			set val to low
		if val > high:
			set val to high

# --- Math functions ---

function [the|] sine of value:
    after: default
    replacement:
        @intrinsic("sin", value)

function [the|] cosine of value:
    after: default
    replacement:
        @intrinsic("cos", value)

function [the|] square root of value:
    after: default
    replacement:
        @intrinsic("sqrt", value)

function [the|] absolute value of value:
    after: default
    replacement:
        @intrinsic("abs", value)

function [the|] floor of value:
    after: default
    replacement:
        @intrinsic("floor", value)

function [the|] ceiling of value:
    after: default
    replacement:
        @intrinsic("ceil", value)

function value [raised|] to the power [of|] exponent:
    after: default
    replacement:
        @intrinsic("pow", value, exponent)

function [the|] minimum of a and b:
    after: default
    replacement:
        @intrinsic("min", a, b)

function [the|] maximum of a and b:
    after: default
    replacement:
        @intrinsic("max", a, b)

# --- Comparison ---

function left < right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("less than", left, right)

function left > right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("greater than", left, right)

function left = right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("equal", left, right)

function left is right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("equal", left, right)

function left [!=|is not] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("not equal", left, right)

function left [is less than or equal to|<=] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("less than or equal", left, right)

function left [is greater than or equal to|>=] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("greater than or equal", left, right)

# --- Logic ---

function not value:
    before: $ or $, $ and $
    replacement:
        @intrinsic("not", value)

function left and right:
    before: $ or $
    replacement:
        @intrinsic("and", left, right)

function left or right:
    before: default
    replacement:
        @intrinsic("or", left, right)

# --- Control flow ---

macro section [loop |]while condition:
    replacement:
        @intrinsic("loop while", condition)

macro section if condition:
    replacement:
        @intrinsic("if", condition)

macro section else if condition:
    replacement:
        @intrinsic("else if", condition)

macro section else:
    replacement:
        @intrinsic("else")

macro section [match|switch] [based|] [on|] value:
    replacement:
        @intrinsic("switch", value)

macro section case value:
    replacement:
        @intrinsic("case", value)
