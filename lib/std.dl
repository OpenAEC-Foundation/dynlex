# DynLex Standard Library

import lib/string.dl

# --- Return ---

macro function return value:
    after: default
    replacement:
        @intrinsic("return", value)

# --- Variables ---

macro function set var to val:
    replacement:
        @intrinsic("store", var, val)

macro function discard val:
    replacement:
        @intrinsic("discard", val)

# --- Primitive types ---

macro function [an|a|] integer:
    replacement:
        @intrinsic("type", "int", 32)

macro function [an|a|] bits bit integer:
    replacement:
        @intrinsic("type", "int", bits)

macro function [a|] float:
    replacement:
        @intrinsic("type", "float", 64)

macro function [a|] bits bit float:
    replacement:
        @intrinsic("type", "float", bits)

macro function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

macro function [a|] boolean:
    replacement:
        @intrinsic("type", "bool")

macro function void:
    replacement:
        @intrinsic("type", "void")

# --- Pointer and string types ---

macro function [a|] pointer to type:
    replacement:
        @intrinsic("add pointer depth", type)

# --- Type casts ---

macro function value as type:
    replacement:
        @intrinsic("cast", value, type)

# --- Class properties ---

macro function:
    patterns:
        the {word:propertyname} of ownername
        ownername's {word:propertyname}
    replacement:
        @intrinsic("property", ownername, propertyname)

# --- Pointers ---

macro function [the|] address of var:
    replacement:
        @intrinsic("address of", var)

macro function [the|] value at ptr:
    replacement:
        @intrinsic("dereference", ptr)

macro function element index of ptr:
    replacement:
        @intrinsic("dereference", ptr + index)

# --- Arithmetic (with precedence) ---

# Precedence chain (lowest to highest):
#   or < and < not < comparisons < +,- < *,/,mod < negative

macro function left + right:
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    replacement:
        @intrinsic("add", left, right)

macro function left - right:
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    replacement:
        @intrinsic("subtract", left, right)

macro function left * right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("multiply", left, right)

macro function left / right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("divide", left, right)

macro function left mod right:
    before: $ + $, $ - $
    replacement:
        @intrinsic("modulo", left, right)

macro function [the|] [negative|opposite] [of|] value:
    before: $ * $, $ / $, $ mod $
    replacement:
        @intrinsic("negate", value)

macro function multiply value by factor:
	replacement:
		set value to @intrinsic("multiply", value, factor)

macro function divide value by divisor:
	replacement:
		set value to @intrinsic("divide", value, divisor)

macro function add value to target:
	replacement:
		set target to @intrinsic("add", target, value)

macro function subtract value from target:
	replacement:
		set target to @intrinsic("subtract", target, value)

macro function increment val:
	replacement:
		set val to @intrinsic("add", val, 1)

macro function decrement val:
	replacement:
		set val to @intrinsic("subtract", val, 1)

# --- Clamping ---

macro function clamp val between low and high:
	replacement:
		if val < low:
			set val to low
		if val > high:
			set val to high

# --- Math functions ---

macro function [the|] sine of value:
    after: default
    replacement:
        @intrinsic("sin", value)

macro function [the|] cosine of value:
    after: default
    replacement:
        @intrinsic("cos", value)

macro function [the|] square root of value:
    after: default
    replacement:
        @intrinsic("sqrt", value)

macro function [the|] absolute value of value:
    after: default
    replacement:
        @intrinsic("abs", value)

macro function [the|] floor of value:
    after: default
    replacement:
        @intrinsic("floor", value)

macro function [the|] ceiling of value:
    after: default
    replacement:
        @intrinsic("ceil", value)

macro function value [raised|] to the power [of|] exponent:
    after: default
    replacement:
        @intrinsic("pow", value, exponent)

macro function [the|] minimum of a and b:
    after: default
    replacement:
        @intrinsic("min", a, b)

macro function [the|] maximum of a and b:
    after: default
    replacement:
        @intrinsic("max", a, b)

# --- Comparison ---

function left < right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("less than", left, right)

function left > right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("greater than", left, right)

function left = right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("equal", left, right)

function left [!=|is not] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("not equal", left, right)

function left [is less than or equal to|<=] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("less than or equal", left, right)

function left [is greater than or equal to|>=] right:
    before: $ or $, $ and $, not $
    execute:
        return @intrinsic("greater than or equal", left, right)

# --- Logic ---

macro function not value:
    before: $ or $, $ and $
    replacement:
        @intrinsic("not", value)

macro function left and right:
    before: $ or $
    replacement:
        @intrinsic("and", left, right)

macro function left or right:
    before: default
    replacement:
        @intrinsic("or", left, right)

# --- Control flow ---

macro section [loop |]while condition:
    replacement:
        @intrinsic("loop while", condition)

macro section if condition:
    replacement:
        @intrinsic("if", condition)

macro section else if condition:
    replacement:
        @intrinsic("else if", condition)

macro section else:
    replacement:
        @intrinsic("else")

macro section [match|switch] [based|] [on|] value:
    replacement:
        @intrinsic("switch", value)

macro section case value:
    replacement:
        @intrinsic("case", value)
