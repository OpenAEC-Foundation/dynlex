# DynLex Standard Library

import lib/string.dl
import lib/subject.dl

# --- Basic patterns ---

function return [nothing]:
    replacement:
        @intrinsic("return")
function return value:
    replacement:
        @intrinsic("return", value)
a new {type:kind} from value means: @intrinsic("construct", kind, value)
a new {type:kind} means: @intrinsic("construct", kind)
# --- Variables ---

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)
function ignore value:
    replacement:
        @intrinsic("discard", value)
flex function set the subject to value:
    replacement:
        @intrinsic("set subject", value)
# --- Primitive types ---

a value means: @intrinsic("type", "any")
fixed means: @intrinsic("fix", a value)
fixed value means: @intrinsic("fix", value)
[an|] integer means: @intrinsic("type", "int")
[a|] {fixed integer:bits} bit integer means: @intrinsic("type", "int", bits)

[an|] unsigned integer means: @intrinsic("type", "uint")
[a|] {fixed integer:bits} bit unsigned integer means: @intrinsic("type", "uint", bits)

[a|] floating-point number means: @intrinsic("type", "float")
[a|] {fixed integer:bits} bit floating-point number means: @intrinsic("type", "float", bits)
[a|] byte means: @intrinsic("type", "int", 8)
[a|] boolean means: @intrinsic("type", "bool")
true means: 1 as a boolean
false means: 0 as a boolean
[a|] type means: @intrinsic("type", "type")
[a|] constraint means: @intrinsic("type", "constraint")
[a|] {fixed integer:bits} bit value means: @intrinsic("type", "any", bits)
nothing means: @intrinsic("type", "nothing")
the type [nothing] means: @intrinsic("type", "nothing")
a number means: @intrinsic("number")
# --- Pointer and string types ---

[a|] pointer means: a pointer to a byte
[a|] pointer to {type:kind} means: @intrinsic("add pointer depth", kind)
an array means: @intrinsic("array")
[an|] array of {fixed integer:count} [item|items] means: @intrinsic("array", count)
{type:kind} array of {fixed integer:count} [item|items] means: @intrinsic("array", count, kind)
{fixed integer:count} {type:kind} array means: @intrinsic("array", count, kind)
[an|] array as long as value means: @intrinsic("array", @intrinsic("type extent", value, 0))
[an|] array of numbers means: @intrinsic("array", a number)
[an|] array of numbers as long as value means: @intrinsic("array", @intrinsic("type extent", value, 0), a number)
the length of {an array:values} means: @intrinsic("type extent", values, 0)
the element type of value means: @intrinsic("element type", value)
the arithmetic type promoted from {type:left} and {type:right} means: @intrinsic("promote arithmetic type", left, right)
# --- Type casts ---

to get value as {type:destination}:
    return @intrinsic("cast", value, destination)

truth if {boolean:condition}, else falsehood means: @intrinsic("select", condition, truth, falsehood)
the build info {fixed C string:key} means: @intrinsic("build info", key)
the build word size means: @intrinsic("build info", "word size")
[a|] word sized integer means: @intrinsic("type", "int", @intrinsic("build info", "word size"))

[a|] word sized unsigned integer means: @intrinsic("type", "uint", @intrinsic("build info", "word size"))

[a|] C long integer means: @intrinsic("type", "int", @intrinsic("build info", "c long size"))
the build optimization level means: @intrinsic("build info", "optimization level")
the build target is CPU means: @intrinsic("target is", "cpu")
the build target is GPU means: @intrinsic("target is", "gpu")
the build target is WebAssembly means: @intrinsic("target is", "wasm")
to get an aggregate of {fixed integer:count} {type:kind} values:
    if the build target is GPU:
        return @intrinsic("vector", count, kind)
    return @intrinsic("array", count, kind)

this is a fragment shader means: @intrinsic("shader stage is", "fragment")
this is a vertex shader means: @intrinsic("shader stage is", "vertex")
the size of kind means: @intrinsic("size of", kind)
the type of value means: @intrinsic("type of", value)
the function named {fixed C string:name} means: @intrinsic("function", name)
# --- Pointers ---

the address of variable means: @intrinsic("address of", variable)
the value at address means: @intrinsic("dereference", address)
to abort the program:
    @intrinsic("call", "libc", "abort", nothing)
flex function:
    patterns:
        deallocate {a pointer to a value:address}
    replacement:
        @intrinsic("call", "libc", "free", nothing, address)
flex function:
    patterns:
        deallocate {a pointer to a pointer to a value:address}
    replacement:
        @intrinsic("call", "libc", "free", nothing, address)
function store value at address:
    replacement:
        @intrinsic("store at", address, value)
flex function initialize value at address:
    replacement:
        @intrinsic("initialize at", address, value)
flex function destroy the value at address:
    replacement:
        @intrinsic("destroy at", address)
the element at {index} in {aggregate} means: @intrinsic("extract element", aggregate, index)
the aggregate formed by replacing element {index} in {aggregate} with {value} means: @intrinsic("insert element", aggregate, index, value)
the item at index in address means: @intrinsic("dereference", address + index)

# --- Dynamic allocations ---

local function stop because a collection allocation failed:
    execute:
        abort the program

local function the maximum collection capacity:
    replacement:
        2147483647

local function the maximum allocation byte count:
    execute:
        if the build word size = 32:
            return 2147483647 as a word sized integer
        return 9223372036854775807 as a word sized integer

to get the expanded collection capacity after {integer:capacity}:
    if capacity < 0 or capacity >= the maximum collection capacity:
        stop because a collection allocation failed
    if capacity < 4:
        return 4
    if capacity > the maximum collection capacity / 2:
        return the maximum collection capacity
    return capacity * 2

to get the collection length after adding one item to {integer:length}:
    if length < 0 or length >= the maximum collection capacity:
        stop because a collection allocation failed
    return length + 1

to get the collection capacity from {integer:capacity} expanded to hold {integer:count} items:
    if (capacity < 0) or ((count < 0) or (count > the maximum collection capacity)):
        stop because a collection allocation failed
    set limit to capacity
    loop while limit < count:
        set limit to the expanded collection capacity after limit
    return limit

to get the checked allocation from {pointer:allocation} resized to {integer:count} items of {type:kind}:
    if count <= 0:
        stop because a collection allocation failed
    if the build word size = 32 and count > 2147483647:
        stop because a collection allocation failed
    set quantity to count as a word sized integer
    set width to (the size of kind) as a word sized integer
    if quantity > the maximum allocation byte count / width:
        stop because a collection allocation failed
    set replacement to @intrinsic("call", "libc", "realloc", a pointer to kind, allocation, quantity * width)
    if replacement = 0 as a pointer to kind:
        stop because a collection allocation failed
    return replacement

# --- Arithmetic (with precedence) ---

# Precedence chain (lowest to highest):
#   or < and < the inverse of < | < ^ < & < comparisons < <<,>> < +,- < *,remainder < negative, bitwise inverse

function left[ |]|[ |]right:
    before: $ or $, $ and $, the inverse of $
    execute:
        return @intrinsic("bitwise or", left, right)

function left bitwise or right:
    before: $ or $, $ and $, the inverse of $
    execute:
        return @intrinsic("bitwise or", left, right)

function left[ |]^[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left bitwise xor right:
    before: $ or $, $ and $, the inverse of $, $ | $
    execute:
        return @intrinsic("bitwise xor", left, right)

function left[ |]&[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left bitwise and right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $
    execute:
        return @intrinsic("bitwise and", left, right)

function left[ |]<<[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", left, right)

function value shifted left by distance:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift left", value, distance)

function left[ |]>>[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", left, right)

function value shifted right by distance:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        return @intrinsic("shift right", value, distance)

function left[ |]+[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("add", left, right)

function left[ |]-[ |]right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        return @intrinsic("subtract", left, right)

function left[ |]*[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("multiply", left, right)

function left[ |]/[ |]right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("divide", left, right)

function {an array of numbers:left}[ |]+[ |]{an array of numbers as long as left:right}:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the element type of right))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) + (the item at position in right)) at result + position
        return result

function {an array of numbers:left}[ |]-[ |]{an array of numbers as long as left:right}:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $, $ << $, $ >> $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the element type of right))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) - (the item at position in right)) at result + position
        return result

function {an array of numbers:left}[ |]*[ |]{a number:factor}:
    before: $ + $, $ - $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the type of factor))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) * factor) at result + position
        return result

function {an array of numbers:left}[ |]/[ |]{a number:divisor}:
    before: $ + $, $ - $
    execute:
        set result to left as (
            (the arithmetic type promoted from (the element type of left) and (the type of divisor))
            array of the length of left items
        )
        loop position from 0 to the length of result:
            store ((the item at position in left) / divisor) at result + position
        return result

function the remainder of left divided by right:
    before: $ + $, $ - $
    execute:
        return @intrinsic("modulo", left, right)

function [the negative of |the opposite of |-]value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("negate", value)

function ~value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("bitwise not", value)

function the bitwise inverse of value:
    before: $ * $, $ / $, the remainder of $ divided by $
    execute:
        return @intrinsic("bitwise not", value)

function multiply value by factor:
	replacement:
		set value to value * factor
function divide value by divisor:
	replacement:
		set value to value / divisor
function add value to target:
	replacement:
		set target to target + value
function subtract value from target:
	replacement:
		set target to target - value
function increment value:
	replacement:
		set value to value + 1
function decrement value:
	replacement:
		set value to value - 1
# --- Clamping ---

function clamp value between low and high:
	replacement:
		if value < low:
			set value to low
		if value > high:
			set value to high

to get {a number:value} clamped between {a number:low} and {a number:high}:
    return @intrinsic("min", @intrinsic("max", value, low), high)

# --- Math functions ---

function the sine of value:
    after: default
    execute:
        return @intrinsic("sin", value)

function the cosine of value:
    after: default
    execute:
        return @intrinsic("cos", value)

function the square root of value:
    after: default
    execute:
        return @intrinsic("sqrt", value)

function the absolute value of magnitude:
    after: default
    execute:
        return @intrinsic("abs", magnitude)

function the floor of value:
    after: default
    execute:
        return @intrinsic("floor", value)

function the ceiling of value:
    after: default
    execute:
        return @intrinsic("ceil", value)

function the rounded value of number:
    after: default
    execute:
        return @intrinsic("round", number)

function value [raised to the power of|to the power of] exponent:
    after: default
    execute:
        return @intrinsic("pow", value, exponent)

function the minimum of left and right:
    after: default
    execute:
        return @intrinsic("min", left, right)

function the maximum of left and right:
    after: default
    execute:
        return @intrinsic("max", left, right)

function the product of left and right:
    after: default
    execute:
        return @intrinsic("multiply", left, right)

# --- Comparison ---

function left < right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than", left, right)

function left > right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than", left, right)

function left = right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left is right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("equal", left, right)

function left [!=|is not] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    replacement:
        the inverse of left = right

function left [is less than or equal to|<=] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("less than or equal", left, right)

function left [is greater than or equal to|>=] right:
    before: $ or $, $ and $, the inverse of $, $ | $, $ ^ $, $ & $
    execute:
        return @intrinsic("greater than or equal", left, right)

# --- Logic ---

function the inverse of value:
    before: $ or $, $ and $
    replacement:
        @intrinsic("not", value)

function {boolean:left} and {boolean:right}:
    before: $ or $
    execute:
        return @intrinsic("and", left, right)

flex function {nothing:left} and {nothing:right}:
    before: $ or $
    replacement:
        @intrinsic("discard", left)
        @intrinsic("discard", right)

function left or right:
    before: default
    execute:
        return @intrinsic("or", left, right)

# --- Control flow ---

flex function loop while condition:
    replacement:
        @intrinsic("loop while", condition)
flex function execute the body:
    replacement:
        @intrinsic("execute body")
flex section [loop |]while condition:
    replacement:
        loop while condition

flex section loop count [time|times]:
    replacement:
        set iteration to 0
        loop while iteration < count:
            execute the body
            increment iteration

flex section loop index from start to end:
    replacement:
        set index to start
        loop while index < end:
            execute the body
            increment index

flex section loop index from start through end:
    replacement:
        set index to start
        loop while index <= end:
            execute the body
            increment index

flex section loop index from start down to end:
    replacement:
        set index to start
        loop while index > end:
            execute the body
            decrement index

flex section loop index from start down through end:
    replacement:
        set index to start
        loop while index >= end:
            execute the body
            decrement index

flex section if condition:
    replacement:
        @intrinsic("if", condition)

flex section else if condition:
    replacement:
        @intrinsic("else if", condition)

flex section else:
    replacement:
        @intrinsic("else")

flex section [match|switch] [based on|on] value:
    replacement:
        @intrinsic("switch", value)

flex section case value:
    replacement:
        @intrinsic("case", value)

flex section [otherwise|default]:
    replacement:
        @intrinsic("default case")

# --- Command-line arguments ---

class:
    patterns:
        [an|] argument list
    members:
        data as a pointer to a C string
        length as an integer

to get the command line arguments:
    return @intrinsic(
        "construct",
        an argument list,
        @intrinsic("command line argument values"),
        @intrinsic("command line argument count")
    )

to get the argument at {integer:index} in {argument list:arguments}:
    if index < 0 or index >= arguments' length:
        abort the program
    set value to the item at index in arguments' data
    return a new string from value containing (the length of value) bytes
