# Drawing and hit testing share one logical clipping region.
import lib/ui_native_types.dl

class:
    patterns:
        UI clipping state
    members:
        bounds as UI bounds
        rectangle as VkRect2D

to get a UI clip restricted to {UI bounds:box} in {a pointer to native UI view:view} on {graphics frame:frame}:
    set previous to @intrinsic("construct", UI clipping state, view's hit bounds, the clipping rectangle of frame)
    set clipped to the UI intersection of box and (view's hit bounds)
    set view's hit bounds to clipped
    set horizontal and vertical to 1.0
    set x and y to 0.0
    if view's fitted:
        set horizontal to view's content bounds' width / (view's logical width as a floating-point number)
        set vertical to view's content bounds' height / (view's logical height as a floating-point number)
        set x to view's content bounds' x
        set y to view's content bounds' y
    set left to (the floor of (x + (clipped's x * horizontal))) as an integer
    set top to (the floor of (y + (clipped's y * vertical))) as an integer
    set right to (the ceiling of (x + ((clipped's x + clipped's width) * horizontal))) as an integer
    set bottom to (the ceiling of (y + ((clipped's y + clipped's height) * vertical))) as an integer
    set rectangle to previous's rectangle
    set left to the maximum of left and (rectangle's offset' x)
    set top to the maximum of top and (rectangle's offset' y)
    set right to the minimum of right and ((rectangle's offset' x) + (rectangle's extent' width as an integer))
    set bottom to the minimum of bottom and ((rectangle's offset' y) + (rectangle's extent' height as an integer))
    set rectangle's offset' x to left
    set rectangle's offset' y to top
    set rectangle's extent' width to ((the maximum of 0 and (right - left)) as a 32 bit unsigned integer)
    set rectangle's extent' height to ((the maximum of 0 and (bottom - top)) as a 32 bit unsigned integer)
    set the clipping rectangle of frame to rectangle
    return previous

to restore UI clip {UI clipping state:saved} in {a pointer to native UI view:view} on {graphics frame:frame}:
    set view's hit bounds to saved's bounds
    set the clipping rectangle of frame to saved's rectangle
