import lib/shader.dl
import lib/geometry.dl

# Shared procedural-art vocabulary for editable fragment shaders.

function a point with x {float:horizontal} and y {float:vertical}:
    replacement:
        @intrinsic(
            "construct",
            a point,
            @intrinsic("construct", an aggregate of 2 float values, horizontal, vertical)
        )

function a point with x {float:horizontal}, y {float:vertical} and z {float:depth}:
    replacement:
        @intrinsic(
            "construct",
            a point,
            @intrinsic("construct", an aggregate of 3 float values, horizontal, vertical, depth)
        )

function the dimensions measuring {float:width} by {float:height} by {float:depth}:
    replacement:
        @intrinsic(
            "construct",
            a point,
            @intrinsic("construct", an aggregate of 3 float values, width, height, depth)
        )

function the shader width:
    replacement:
        @intrinsic("shader uniform", "width")

function the shader height:
    replacement:
        @intrinsic("shader uniform", "height")

function the fractional part of number:
    execute:
        return number - the floor of number

function number saturated:
    execute:
        set result to number
        clamp result between 0.0 and 1.0
        return result

function the smooth transition from lower to upper at sample:
    execute:
        set normalized to (sample - lower) / (upper - lower)
        set normalized to normalized saturated
        return (normalized * normalized) * (3.0 - (2.0 * normalized))

function the glow from inner to outer at sample:
    execute:
        return 1.0 - the smooth transition from inner to outer at sample

function the signed flow at {a point:point} during {any:phase}:
    execute:
        set sway to the sine of (((point's x * 0.73) - (point's y * 0.41)) + phase)
        set drift to the cosine of (((point's x * 0.37) + (point's y * 0.89)) - (phase * 0.71))
        set longitude to point's x + sway * 0.58
        set latitude to point's y + drift * 0.58
        set broad to the sine of (((longitude * 1.31) + (latitude * 0.87)) + (phase * 0.43))
        set crossing to the cosine of (((longitude * -0.79) + (latitude * 1.73)) - (phase * 0.31))
        set curl to the sine of (((longitude * 2.47) - (latitude * 2.11)) + (broad * 1.8))
        set detail to the cosine of (((longitude * 4.03) + (latitude * 3.17)) + (crossing * 1.4))
        return ((broad * 0.46) + (crossing * 0.29)) + ((curl * 0.17) + (detail * 0.08))

function the flowing field at {a point:point} during {any:phase}:
    execute:
        return (the signed flow at point during phase) * 0.5 + 0.5

function the ridged field at {a point:point} during {any:phase}:
    execute:
        set wave to the absolute value of (the signed flow at point during phase)
        set ridge to 1.0 - the minimum of wave and 1.0
        return ridge * ridge

function the spark field at {a point:point} during {any:phase}:
    execute:
        set sample to a point with x (point's x * 0.19) and y (point's y * 0.19)
        set warp to the signed flow at sample during phase
        set shifted to a point with x (point's x * 0.23 + 7.0) and y (point's y * 0.23 - 5.0)
        set longitude to point's x + warp * 1.7
        set latitude to point's y + (the signed flow at shifted during (phase + 1.7)) * 1.7
        set primary to the absolute value of (the sine of ((longitude * 1.73) + (latitude * 0.31) + phase))
        set secondary to the absolute value of (the sine of ((longitude * -0.27) + (latitude * 1.91) - phase * 0.83))
        set crossing to the square root of (primary * primary + secondary * secondary)
        set brightness to the glow from 0.0 to 0.115 at crossing
        set location to a point with x (longitude * 0.11) and y (latitude * 0.11)
        set rarity to the flowing field at location during (phase + 4.0)
        return brightness * the smooth transition from 0.48 to 0.82 at rarity

function the distance from {a point:point} to segment from {a point:start} to {a point:end}:
    execute:
        set span to end's x - start's x
        set rise to end's y - start's y
        set horizontal to point's x - start's x
        set vertical to point's y - start's y
        set measure to span * span + rise * rise
        set projection to (horizontal * span + vertical * rise) / the maximum of measure and 0.000001
        set projection to projection saturated
        set longitude to start's x + span * projection
        set latitude to start's y + rise * projection
        set difference to point's x - longitude
        set deviation to point's y - latitude
        return the square root of (difference * difference + deviation * deviation)

function the ring distance from {a point:point} around {a point:center} with radius {any:radius}:
    execute:
        set difference to point's x - center's x
        set deviation to point's y - center's y
        set result to the square root of (difference * difference + deviation * deviation)
        return the absolute value of (result - radius)

function the distance from {a point:point} to capsule from {a point:start} to {a point:end} with radius {any:radius}:
    execute:
        set span to end's x - start's x
        set rise to end's y - start's y
        set depth to end's z - start's z
        set horizontal to point's x - start's x
        set vertical to point's y - start's y
        set forward to point's z - start's z
        set measure to ((span * span) + (rise * rise)) + (depth * depth)
        set projection to (((horizontal * span) + (vertical * rise)) + (forward * depth)) / the maximum of measure and 0.000001
        set projection to projection saturated
        set longitude to start's x + span * projection
        set latitude to start's y + rise * projection
        set altitude to start's z + depth * projection
        set difference to point's x - longitude
        set deviation to point's y - latitude
        set separation to point's z - altitude
        return (the square root of (difference * difference + deviation * deviation + separation * separation)) - radius

function the ellipsoid distance from {a point:point} with radii {a point:radii}:
    execute:
        set horizontal to point's x / radii's width
        set vertical to point's y / radii's height
        set forward to point's z / radii's depth
        set result to the square root of (((horizontal * horizontal) + (vertical * vertical)) + (forward * forward))
        set smallest to the minimum of radii's width and (the minimum of radii's height and radii's depth)
        return (result - 1.0) * smallest

function the torus distance from {a point:point} with major radius {any:outer} and tube radius {any:inner}:
    execute:
        set offset to (the square root of (point's x * point's x + point's y * point's y)) - outer
        return (the square root of (offset * offset + point's z * point's z)) - inner

function the nano drone field at {a point:point} with phase {any:phase}:
    execute:
        set first to (((point's x) * 43.13) + (((point's y) * 17.71) + (((point's z) * 7.19) + phase)))
        set second to (((point's x) * -13.37) + (((point's y) * 47.07) + (((point's z) * 21.41) - (phase * 0.73))))
        set third to (((point's x) * 29.79) - (((point's y) * 11.91) - (((point's z) * 59.33) + (phase * 1.31))))
        set primary to the absolute value of (the sine of first)
        set secondary to the absolute value of (the sine of second)
        set tertiary to the absolute value of (the sine of third)
        set crossing to the square root of (((primary * primary) + (secondary * secondary)) + (tertiary * tertiary))
        set core to the glow from 0.0 to 0.42 at crossing
        set aura to the glow from 0.0 to 0.70 at crossing
        return core * 4.2 + aura * 0.16
