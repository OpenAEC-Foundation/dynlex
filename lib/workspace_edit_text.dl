# Position conversion, edit validation, and single-snapshot text application.

import lib/workspace_edit_types.dl
import lib/unicode.dl
import lib/string.dl

local class:
    patterns:
        [a|] workspace offset result
    members:
        success as boolean
        offset as i32
        failure reason as string

local class:
    patterns:
        [a|] workspace edit index collection
    members:
        items as a pointer to integer
        length as i32
        capacity as i32

local class:
    patterns:
        [a|] prepared workspace text edit
    members:
        start offset as i32
        end offset as i32
        new text as string
        source index as i32

local class:
    patterns:
        [a|] prepared workspace text edit collection
    members:
        items as a pointer to prepared workspace text edit
        length as i32
        capacity as i32

local class:
    patterns:
        [a|] prepared workspace text edit result
    members:
        success as boolean
        edits as a pointer to prepared workspace text edit collection
        failure reason as string

local function {workspace offset result:result} succeeded:
    replacement:
        result's success

local function {workspace offset result:result} failed:
    replacement:
        the inverse of result's success

local function {prepared workspace text edit result:result} succeeded:
    replacement:
        result's success

local function {prepared workspace text edit result:result} failed:
    replacement:
        the inverse of result's success

local function a successful workspace offset at {integer:position}:
    replacement:
        @intrinsic(
            "construct",
            a workspace offset result,
            true,
            position as i32,
            an empty workspace edit text
        )

local function a failed workspace offset reporting {string:reason}:
    replacement:
        @intrinsic(
            "construct",
            a workspace offset result,
            false,
            0,
            reason
        )

local function the workspace UTF32 offset for position {integer:goal} in {string:line}:
    execute:
        if goal < 0:
            return a failed workspace offset reporting the string form of "Text position is negative"
        set offset to 0
        set count to 0
        loop while count < goal and offset < the length of line:
            decode the UTF8 code point in line at byte offset and set decoded to it
            if decoded failed:
                return a failed workspace offset reporting the string form of "Text is not valid UTF-8"
            set offset to the next byte offset of decoded
            set count to (count + 1)
        if count != goal:
            return a failed workspace offset reporting the string form of "Text position is outside the line"
        return a successful workspace offset at offset

local function the workspace line byte offset for {workspace edit position:requested} in {string:source} using {a pointer to text line index:lines} and encoding {integer:encoding}:
    execute:
        if requested's line < 0 or requested's character < 0:
            return a failed workspace offset reporting the string form of "Text position is negative"
        set beginning to the start of line requested's line in lines
        set ending to the content end of line requested's line in lines
        if beginning failed:
            return a failed workspace offset reporting the string form of "Text line is outside the document"
        set start to the position of beginning
        set end to the position of ending
        set line to the substring of source from start spanning (end - start) bytes
        set displacement to a failed workspace offset reporting the string form of "Unsupported position encoding"
        if encoding = the workspace UTF8 position encoding:
            set boundary to the UTF16 position of UTF8 byte offset requested's character in line
            if boundary succeeded:
                set displacement to a successful workspace offset at requested's character
            else:
                set displacement to a failed workspace offset reporting the string form of "UTF-8 position is outside a code point boundary"
        else if encoding = the workspace UTF16 position encoding:
            set converted to the UTF8 byte offset of UTF16 position requested's character in line
            if converted succeeded:
                set displacement to a successful workspace offset at the position of converted
            else:
                set displacement to a failed workspace offset reporting the string form of "UTF-16 position is outside a code point boundary"
        else if encoding = the workspace UTF32 position encoding:
            set displacement to the workspace UTF32 offset for position requested's character in line
        if displacement failed:
            return displacement
        return a successful workspace offset at start + displacement's offset

local function a new prepared workspace text edit collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a prepared workspace text edit collection,
            0 as a pointer to prepared workspace text edit,
            0,
            0
        )
        set result to allocate 1 slots of initial
        return result

local function append {prepared workspace text edit:value} to prepared workspace edits {a pointer to prepared workspace text edit collection:collection}:
    execute:
        if the length of collection = the capacity of collection:
            set growth to ((the capacity of collection) * 2)
            if growth < 4:
                set growth to 4
            set resized to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to prepared workspace text edit,
                the items of collection,
                growth * the size of a prepared workspace text edit
            )
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to ((the length of collection) + 1)

local function prepared workspace text edit at {integer:position} in {a pointer to prepared workspace text edit collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

local function free prepared workspace text edits {a pointer to prepared workspace text edit collection:collection}:
    execute:
        set position to 0
        loop while position < the length of collection:
            @intrinsic("destroy at", (the items of collection) + position)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of collection)
        @intrinsic("destroy at", collection)
        @intrinsic("call", "libc", "free", nothing, collection)

local function a new workspace edit index collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a workspace edit index collection,
            0 as a pointer to integer,
            0,
            0
        )
        set result to allocate 1 slots of initial
        return result

local function append workspace edit index {integer:value} to {a pointer to workspace edit index collection:sequence}:
    execute:
        if the length of sequence = the capacity of sequence:
            set growth to ((the capacity of sequence) * 2)
            if growth < 4:
                set growth to 4
            set resized to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to integer,
                the items of sequence,
                growth * the size of an integer
            )
            set the items of sequence to resized
            set the capacity of sequence to growth
        @intrinsic("initialize at", (the items of sequence) + (the length of sequence), value)
        set the length of sequence to ((the length of sequence) + 1)

local function workspace edit index at {integer:position} in {a pointer to workspace edit index collection:sequence}:
    execute:
        if position < 0 or position >= the length of sequence:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of sequence

local function replace workspace edit index at {integer:position} in {a pointer to workspace edit index collection:sequence} with {integer:value}:
    execute:
        if position < 0 or position >= the length of sequence:
            @intrinsic("call", "libc", "abort", nothing)
        store value into the items of sequence at position

local function free workspace edit index collection {a pointer to workspace edit index collection:sequence}:
    execute:
        @intrinsic("call", "libc", "free", nothing, the items of sequence)
        @intrinsic("destroy at", sequence)
        @intrinsic("call", "libc", "free", nothing, sequence)

local function the stable prepared workspace edit indexes for {a pointer to prepared workspace text edit collection:collection}:
    execute:
        set order to a new workspace edit index collection
        set cursor to 0
        loop while cursor < the length of collection:
            append workspace edit index cursor to order
            set position to ((the length of order) - 1)
            set searching to true
            loop while searching and position > 0:
                set previous to workspace edit index at (position - 1) in order
                set left to prepared workspace text edit at previous in collection
                set right to prepared workspace text edit at cursor in collection
                set moving to (left's start offset > right's start offset)
                if left's start offset = right's start offset:
                    set moving to (left's source index > right's source index)
                if moving:
                    replace workspace edit index at position in order with previous
                    replace workspace edit index at position - 1 in order with cursor
                    set position to (position - 1)
                else:
                    set searching to false
            set cursor to (cursor + 1)
        return order

local function the result of validating workspace text edit indexes {a pointer to prepared workspace text edit collection:collection} ordered by {a pointer to workspace edit index collection:order}:
    execute:
        set consumed to 0
        set grouping to (0 - 1)
        set replacement to false
        set position to 0
        loop while position < the length of order:
            set position to workspace edit index at position in order
            set prepared to prepared workspace text edit at position in collection
            if prepared's start offset < consumed:
                return a failed workspace text result reporting the string form of "Text edit ranges overlap"
            if prepared's start offset != grouping:
                set grouping to prepared's start offset
                set replacement to false
            set insertion to (prepared's start offset = prepared's end offset)
            if insertion and replacement:
                return a failed workspace text result reporting the string form of "Equal-position inserts must precede a replacement"
            if the inverse of insertion:
                if replacement:
                    return a failed workspace text result reporting the string form of "Text edit ranges overlap"
                set replacement to true
                set consumed to prepared's end offset
            set position to (position + 1)
        return a successful workspace text result containing an empty workspace edit text

local function the prepared workspace text edit result for {a pointer to workspace text edit collection:edits} against {string:source} using encoding {integer:encoding}:
    execute:
        set prepared to a new prepared workspace text edit collection
        scan lines in source and set indexing to it
        if indexing failed:
            free indexing
            return @intrinsic(
                "construct",
                a prepared workspace text edit result,
                false,
                prepared,
                the string form of "Text is not valid UTF-8"
            )
        set lines to the line index of indexing
        set position to 0
        set valid to true
        set reason to an empty workspace edit text
        loop while position < the length of edits and valid:
            set edit to workspace text edit at index position in edits
            set start to the workspace line byte offset for edit's start in source using lines and encoding encoding
            set end to the workspace line byte offset for edit's end in source using lines and encoding encoding
            if start failed:
                set valid to false
                set reason to start's failure reason
            else if end failed:
                set valid to false
                set reason to end's failure reason
            else if start's offset > end's offset:
                set valid to false
                set reason to the string form of "Text edit range end precedes its start"
            else:
                append @intrinsic(
                    "construct",
                    a prepared workspace text edit,
                    start's offset,
                    end's offset,
                    edit's new text,
                    position
                ) to prepared workspace edits prepared
            set position to (position + 1)
        free indexing
        if the inverse of valid:
            return @intrinsic(
                "construct",
                a prepared workspace text edit result,
                false,
                prepared,
                reason
            )
        return @intrinsic(
            "construct",
            a prepared workspace text edit result,
            true,
            prepared,
            an empty workspace edit text
        )

function the result of applying workspace text edits {a pointer to workspace text edit collection:edits} to {string:source} using encoding {integer:encoding}:
    execute:
        set preparation to the prepared workspace text edit result for edits against source using encoding encoding
        set prepared to preparation's edits
        if preparation failed:
            set reason to preparation's failure reason
            free prepared workspace text edits prepared
            return a failed workspace text result reporting reason
        set order to the stable prepared workspace edit indexes for prepared
        set validation to the result of validating workspace text edit indexes prepared ordered by order
        if validation failed:
            free workspace edit index collection order
            free prepared workspace text edits prepared
            return validation
        set length to the length of source
        set position to 0
        loop while position < the length of order:
            set change to prepared workspace text edit at (workspace edit index at position in order) in prepared
            set length to (length + the length of change's new text)
            set length to (length - (change's end offset - change's start offset))
            set position to (position + 1)
        if (length < 0) or (length > the maximum string buffer length):
            free workspace edit index collection order
            free prepared workspace text edits prepared
            return a failed workspace text result reporting the string form of "Text edit result is too large"
        set output to a new string buffer containing length bytes
        set reader to 0
        set writer to 0
        set position to 0
        loop while position < the length of order:
            set change to prepared workspace text edit at (workspace edit index at position in order) in prepared
            set span to (change's start offset - reader)
            if span > 0:
                set unchanged to the substring of source from reader spanning span bytes
                copy unchanged into the data of output at offset writer
                set writer to (writer + span)
            copy change's new text into the data of output at offset writer
            set writer to (writer + the length of change's new text)
            if change's end offset > reader:
                set reader to change's end offset
            set position to (position + 1)
        set remainder to (the length of source - reader)
        if remainder > 0:
            set tail to the substring of source from reader spanning remainder bytes
            copy tail into the data of output at offset writer
            set writer to (writer + remainder)
        free workspace edit index collection order
        free prepared workspace text edits prepared
        if writer != length:
            @intrinsic("call", "libc", "abort", nothing)
        return a successful workspace text result containing output
