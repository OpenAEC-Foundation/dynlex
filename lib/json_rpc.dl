# JSON-RPC 2.0 byte framing over an owned child process.

import lib/json.dl
import lib/process.dl
import lib/unicode.dl

class:
    patterns:
        [a|] json rpc connection
    members:
        child as process
        input_closed as boolean
        closed as boolean
        output_ended as boolean
        buffered_output as string

class:
    patterns:
        [a|] json rpc connection result
    members:
        succeeded as boolean
        connection as a pointer to json rpc connection
        error_message as string

class:
    patterns:
        [a|] json rpc operation
    members:
        succeeded as boolean
        status as i32
        error_message as string

class:
    patterns:
        [a|] json rpc receive result
    members:
        succeeded as boolean
        status as i32
        message as a pointer to json value
        error_message as string

function {json rpc connection result:result}'s error message:
    replacement:
        @intrinsic("property", result, "error_message")

function {json rpc operation:operation}'s error message:
    replacement:
        @intrinsic("property", operation, "error_message")

function {json rpc receive result:result}'s error message:
    replacement:
        @intrinsic("property", result, "error_message")

function [the|] json rpc success status:
    replacement:
        0

function [the|] json rpc end of stream status:
    replacement:
        1

function [the|] json rpc io error status:
    replacement:
        2

function [the|] json rpc malformed frame status:
    replacement:
        3

function [the|] json rpc invalid utf8 status:
    replacement:
        4

function [the|] json rpc invalid json status:
    replacement:
        5

local function an empty json rpc error:
    replacement:
        the string form of ""

local function a successful json rpc operation:
    replacement:
        @intrinsic("construct", a json rpc operation, true, the json rpc success status, an empty json rpc error)

local function a failed json rpc operation with status {integer:error_status} reporting {string:message}:
    replacement:
        @intrinsic("construct", a json rpc operation, false, error_status, message)

local function a failed json rpc operation with status {integer:error_status} reporting {cstring:message}:
    execute:
        return a failed json rpc operation with status error_status reporting the string form of message

local function a json rpc receive failure with status {integer:error_status} reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc receive result,
            false,
            error_status,
            0 as a pointer to json value,
            message
        )

local function a json rpc receive failure with status {integer:error_status} reporting {cstring:message}:
    execute:
        return a json rpc receive failure with status error_status reporting the string form of message

local function a successful json rpc receive containing value:
    replacement:
        @intrinsic(
            "construct",
            a json rpc receive result,
            true,
            the json rpc success status,
            value,
            an empty json rpc error
        )

local function a json rpc end of stream:
    replacement:
        a json rpc receive failure with status the json rpc end of stream status reporting "JSON-RPC stream ended"

function connect json rpc to {process:child}:
    execute:
        if not child launched:
            return @intrinsic(
                "construct",
                a json rpc connection result,
                false,
                0 as a pointer to json rpc connection,
                the starting error of child
            )
        set initial_connection to @intrinsic(
            "construct",
            a json rpc connection,
            child,
            false,
            false,
            false,
            the string form of ""
        )
        set connection to allocate 1 slots of initial_connection
        return @intrinsic(
            "construct",
            a json rpc connection result,
            true,
            connection,
            an empty json rpc error
        )

function open a json rpc connection using {process command:command}:
    execute:
        set child to launch command
        return connect json rpc to child

local function ascii character input folded to lowercase:
    execute:
        if input >= 65 and input <= 90:
            return input + 32
        return input as i32

local function {string:text} equals ascii header name {cstring:name}:
    execute:
        if the length of text != the length of name:
            return false
        set position to 0
        loop while position < the length of text:
            set actual to ascii character character position of text folded to lowercase
            set expected to ascii character character position of name folded to lowercase
            if actual != expected:
                return false
            set position to position + 1
        return true

local function header separator position in {string:input}:
    execute:
        set cursor to 0
        loop while cursor + 3 < the length of input:
            if character cursor of input = 13:
                if character cursor + 1 of input = 10:
                    if character cursor + 2 of input = 13:
                        if character cursor + 3 of input = 10:
                            return cursor
            set cursor to cursor + 1
        return 0 - 1

local function next crlf position in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set cursor to start
        loop while cursor + 1 < limit:
            if character cursor of input = 13 and character cursor + 1 of input = 10:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function header colon position in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set cursor to start
        loop while cursor < limit:
            if character cursor of input = 58:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function json rpc headers are ascii in {string:input} before {integer:limit}:
    execute:
        set cursor to 0
        loop while cursor < limit:
            set value to (character cursor of input as i32) bitwise and 255
            if value > 126 or (value < 32 and ((value != 9) and ((value != 10) and (value != 13)))):
                return false
            set cursor to cursor + 1
        return true

local function character value is valid in a json rpc header name:
    execute:
        if value >= 48 and value <= 57:
            return true
        if value >= 65 and value <= 90:
            return true
        if value >= 97 and value <= 122:
            return true
        if value = 33:
            return true
        if value = 35:
            return true
        if value = 36:
            return true
        if value = 37:
            return true
        if value = 38:
            return true
        if value = 39:
            return true
        if value = 42:
            return true
        if value = 43:
            return true
        if value = 45:
            return true
        if value = 46:
            return true
        if value = 94:
            return true
        if value = 95:
            return true
        if value = 96:
            return true
        if value = 124:
            return true
        if value = 126:
            return true
        return false

local function json rpc header name is valid in input from start before limit:
    execute:
        set cursor to start
        loop while cursor < limit:
            set value to (character cursor of input as i32) bitwise and 255
            if not character value is valid in a json rpc header name:
                return false
            set cursor to cursor + 1
        return cursor > start

local class:
    patterns:
        [a|] json rpc content length result
    members:
        succeeded as boolean
        length as i32
        error_message as string

local function an invalid json rpc content length reporting {string:message}:
    replacement:
        @intrinsic("construct", a json rpc content length result, false, 0, message)

local function an invalid json rpc content length reporting {cstring:message}:
    execute:
        return an invalid json rpc content length reporting the string form of message

local function parse json rpc content length in input from start before limit:
    execute:
        loop while start < limit and ((character start of input = 32) or (character start of input = 9)):
            set start to start + 1
        loop while limit > start and ((character limit - 1 of input = 32) or (character limit - 1 of input = 9)):
            set limit to limit - 1
        if start = limit:
            return an invalid json rpc content length reporting "Content-Length is empty"
        set length_value to 0
        set position to start
        loop while position < limit:
            set digit to character position of input
            if digit < 48 or digit > 57:
                return an invalid json rpc content length reporting "Content-Length is not a decimal byte count"
            set numeric_digit to digit - 48
            if length_value > (the maximum string buffer length - numeric_digit) / 10:
                return an invalid json rpc content length reporting "Content-Length exceeds the supported string size"
            set length_value to length_value * 10 + numeric_digit
            set position to position + 1
        return @intrinsic(
            "construct",
            a json rpc content length result,
            true,
            length_value,
            an empty json rpc error
        )

local function find json rpc content length in {string:input} ending at {integer:header_end}:
    execute:
        if not json rpc headers are ascii in input before header_end:
            return an invalid json rpc content length reporting "JSON-RPC headers must be ASCII"
        set found to false
        set content_length to 0
        set line_start to 0
        set header_limit to header_end + 2
        loop while line_start < header_end:
            set line_end to next crlf position in input from line_start before header_limit
            if line_end < 0 or line_end = line_start:
                return an invalid json rpc content length reporting "Malformed JSON-RPC header line"
            set colon to header colon position in input from line_start before line_end
            if colon <= line_start:
                return an invalid json rpc content length reporting "Malformed JSON-RPC header"
            if not json rpc header name is valid in input from line_start before colon:
                return an invalid json rpc content length reporting "Invalid JSON-RPC header name"
            set name to the substring of input from line_start with length colon - line_start
            set is_content_length to name equals ascii header name "content-length"
            if is_content_length:
                if found:
                    return an invalid json rpc content length reporting "JSON-RPC frame has duplicate Content-Length headers"
                set parsed to parse json rpc content length in input from colon + 1 before line_end
                if not parsed's succeeded:
                    return parsed
                set found to true
                set content_length to parsed's length
            set line_start to line_end + 2
        if not found:
            return an invalid json rpc content length reporting "JSON-RPC frame is missing Content-Length"
        return @intrinsic(
            "construct",
            a json rpc content length result,
            true,
            content_length,
            an empty json rpc error
        )

local function read more json rpc output using {a pointer to json rpc connection:connection}:
    execute:
        if connection's output_ended:
            return a failed json rpc operation with status the json rpc end of stream status reporting "JSON-RPC stream ended"
        set read_result to read the standard output of connection's child
        if not read_result's succeeded:
            set error_text to read_result's error message
            return a failed json rpc operation with status the json rpc io error status reporting error_text
        if the length of read_result's contents > the maximum string buffer length - the length of connection's buffered_output:
            return a failed json rpc operation with status the json rpc malformed frame status reporting "JSON-RPC frame exceeds the supported string size"
        set connection's buffered_output to connection's buffered_output + read_result's contents
        if read_result's end of stream:
            set connection's output_ended to true
        if the length of read_result's contents > 0:
            return a successful json rpc operation
        if connection's output_ended:
            return a failed json rpc operation with status the json rpc end of stream status reporting "JSON-RPC stream ended"
        return a failed json rpc operation with status the json rpc io error status reporting "Blocking JSON-RPC read returned no bytes"

function receive a json rpc message from {a pointer to json rpc connection:connection}:
    execute:
        if connection's closed:
            return a json rpc receive failure with status the json rpc io error status reporting "JSON-RPC connection is closed"
        set buffered_output to connection's buffered_output
        set header_end to header separator position in buffered_output
        loop while header_end < 0:
            set read_result to read more json rpc output using connection
            if not read_result's succeeded:
                if read_result's status = the json rpc end of stream status:
                    set buffered_output to connection's buffered_output
                    if the length of buffered_output = 0:
                        return a json rpc end of stream
                    return a json rpc receive failure with status the json rpc malformed frame status reporting "JSON-RPC stream ended in a header"
                set error_status to read_result's status
                set error_text to read_result's error message
                return a json rpc receive failure with status error_status reporting error_text
            set buffered_output to connection's buffered_output
            set header_end to header separator position in buffered_output
        set length_result to find json rpc content length in buffered_output ending at header_end
        if not length_result's succeeded:
            set error_text to length_result's error_message
            return a json rpc receive failure with status the json rpc malformed frame status reporting error_text
        set payload_start to header_end + 4
        set payload_length to length_result's length
        loop while the length of buffered_output - payload_start < payload_length:
            set read_result to read more json rpc output using connection
            if not read_result's succeeded:
                if read_result's status = the json rpc end of stream status:
                    return a json rpc receive failure with status the json rpc malformed frame status reporting "JSON-RPC stream ended in a payload"
                set error_status to read_result's status
                set error_text to read_result's error message
                return a json rpc receive failure with status error_status reporting error_text
            set buffered_output to connection's buffered_output
        set payload to the substring of buffered_output from payload_start with length payload_length
        set consumed to payload_start + payload_length
        set remaining to the length of buffered_output - consumed
        set connection's buffered_output to the substring of buffered_output from consumed with length remaining
        set validation to validate payload as utf8
        if the status of validation != the text position success status:
            set error_text to the string form of "JSON-RPC payload is not valid UTF-8 at byte "
            set error_text to error_text + the string form of the error byte offset of validation
            return a json rpc receive failure with status the json rpc invalid utf8 status reporting error_text
        set parsed to parse payload as json
        if not json parsing succeeded for parsed:
            set error_text to the string form of "Invalid JSON-RPC JSON at byte "
            set error_text to error_text + the string form of the json error position in parsed
            free json result parsed
            return a json rpc receive failure with status the json rpc invalid json status reporting error_text
        return a successful json rpc receive containing the value of parsed

local function new json rpc text for {any:input}:
    execute:
        set result to a new json value of kind the json text kind
        set the text of result to the string form of input
        return result

local function write all {string:contents} to json rpc connection:
    execute:
        set written to 0
        loop while written < the length of contents:
            set remaining to the substring of contents from written with length the length of contents - written
            set result to write remaining to connection's child
            if not result's succeeded:
                set error_text to result's error message
                return a failed json rpc operation with status the json rpc io error status reporting error_text
            if result's byte count = 0 as a word sized integer:
                return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC write made no progress"
            if result's byte count > (the length of contents - written) as a word sized integer:
                return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC write reported an invalid byte count"
            set byte_count to @intrinsic("cast", result's byte count, an integer)
            set written to written + byte_count
        return a successful json rpc operation

function send json rpc value {a pointer to json value:value} using {a pointer to json rpc connection:connection}:
    execute:
        if connection's closed or connection's input_closed:
            return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC input is closed"
        set payload to the compact json form of value
        set validation to validate payload as utf8
        if the status of validation != the text position success status:
            return a failed json rpc operation with status the json rpc invalid utf8 status reporting "JSON-RPC output is not valid UTF-8"
        set header to the string form of "Content-Length: "
        set header to header + the string form of the length of payload
        set header to header + the string form of "\r\n\r\n"
        set frame to header + payload
        return write all frame to json rpc connection

function send json rpc notification {any:method} with {a pointer to json value:parameters} using {a pointer to json rpc connection:connection}:
    execute:
        set message to a new json value of kind the json object kind
        set jsonrpc_name to the string form of "jsonrpc"
        set jsonrpc_value to new json rpc text for "2.0"
        append json member jsonrpc_name with jsonrpc_value to message
        set method_name to the string form of "method"
        set method_value to new json rpc text for method
        append json member method_name with method_value to message
        set parameters_name to the string form of "params"
        append json member parameters_name with parameters to message
        set result to send json rpc value message using connection
        store 0 as a pointer to json value into the items of message at 2
        free json value message
        return result

function close [the|] input of {a pointer to json rpc connection:connection}:
    execute:
        if connection's closed:
            return a failed json rpc operation with status the json rpc io error status reporting "JSON-RPC connection is closed"
        if connection's input_closed:
            return a successful json rpc operation
        set result to close the standard input of connection's child
        if not result's succeeded:
            set error_text to result's error message
            return a failed json rpc operation with status the json rpc io error status reporting error_text
        set connection's input_closed to true
        return a successful json rpc operation

function close json rpc connection {a pointer to json rpc connection:session}:
    execute:
        if session's closed:
            return a successful json rpc operation
        if not session's input_closed:
            set input_result to close the input of session
            if not input_result's succeeded:
                return input_result
        set wait_result to wait for session's child
        if not wait_result's succeeded:
            set error_text to wait_result's error message
            return a failed json rpc operation with status the json rpc io error status reporting error_text
        set session's closed to true
        return a successful json rpc operation

function free json rpc receive result {json rpc receive result:outcome}:
    execute:
        if outcome's message != (0 as a pointer to json value):
            free json value outcome's message

function free json rpc connection {a pointer to json rpc connection:session}:
    execute:
        if not session's closed:
            discard clean up session's child
        @intrinsic("destroy at", session)
        @intrinsic("call", "libc", "free", void, session)
