# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Planar region extraction and booleans, plus profile-based press-pull.
import lib/bim/brep_result.dl
import lib/bim/brep_pcurve.dl
import lib/bim/brep_bounds.dl
import lib/bim/brep_place.dl
import lib/bim/brep_intersect.dl
import lib/bim/area2.dl
import lib/bim/brep_profile.dl
import lib/bim/brep_profile_pieces.dl
import lib/bim/brep_sweep.dl
import lib/bim/brep_boolean.dl
import lib/bim/transform2.dl
import lib/bim/cross2.dl
import lib/bim/containment2.dl

class:
    patterns:
        [a|] cad presspull curve loop
    members:
        values as the type of (a cad topology list of (the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))))
class:
    patterns:
        [a|] cad planar face profile
    members:
        plane as a cad plane
        loops as the type of (a cad topology list of a cad presspull curve loop)
        outward as a cad vector3
class:
    patterns:
        [a|] cad planar face profile result
    members:
        valid as a boolean
        value as a cad planar face profile
class:
    patterns:
        [a|] cad presspull moved vertex
    members:
        key as a cad vertex key
        point as a cad vector3
class:
    patterns:
        [a|] cad presspull curve result
    members:
        valid as a boolean
        value as the type of (the cad edge curve3 of (a cad line3 with origin the cad zero vector3 and direction the cad x axis))
class:
    patterns:
        [a|] cad presspull surface result
    members:
        valid as a boolean
        value as the type of (the cad surface of the cad xy plane)
class:
    patterns:
        [a|] cad presspull parameter result
    members:
        valid as a boolean
        values as the type of (a cad topology list of a 64 bit floating-point number)
class:
    patterns:
        [a|] cad presspull span result
    members:
        valid as a boolean
        first as a 64 bit floating-point number
        second as a 64 bit floating-point number
class:
    patterns:
        [a|] cad presspull area result
    members:
        valid as a boolean
        value as a 64 bit floating-point number
class:
    patterns:
        [a|] cad presspull face result
    members:
        valid as a boolean
        value as a cad face key
class:
    patterns:
        [a|] cad presspull lifted curve
    members:
        valid as a boolean
        curve as the type of (the cad edge curve3 of (a cad line3 with origin the cad zero vector3 and direction the cad x axis))
