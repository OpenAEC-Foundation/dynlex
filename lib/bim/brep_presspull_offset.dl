# Port of cadkernel src/brep/presspull.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Local face offset and reconstruction of incident edges and vertices.
import lib/bim/brep_presspull_regions.dl

local function no cad presspull curve:
    execute:
        return @intrinsic("construct", a cad presspull curve result, false, the cad edge curve3 of (a cad line3 with origin the cad zero vector3 and direction the cad x axis))
local function the cad presspull curve {cad edge curve3:value}:
    execute:
        return @intrinsic("construct", a cad presspull curve result, true, value)
local function no cad presspull surface:
    execute:
        return @intrinsic("construct", a cad presspull surface result, false, the cad surface of the cad xy plane)
local function the cad presspull surface {cad surface:value}:
    execute:
        return @intrinsic("construct", a cad presspull surface result, true, value)
local function no cad presspull parameters:
    execute:
        return @intrinsic("construct", a cad presspull parameter result, false, a cad topology list of a 64 bit floating-point number)
local function the cad presspull parameters {cad topology list:values}:
    execute:
        return @intrinsic("construct", a cad presspull parameter result, true, values)
local function no cad presspull span:
    execute:
        return @intrinsic("construct", a cad presspull span result, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function the cad presspull adjacent surface to {cad edge:edgeValue} away from {cad face key:selectedFace} in {cad body:sourceBody}:
    execute:
        loop useIndex from 0 to the length of (edgeValue's coedges's values):
            set useNode to the cad node pointer for (the item at useIndex in (edgeValue's coedges's values)) in sourceBody
            if useNode != (0 as the type of useNode):
                set loopNode to the cad node pointer for useNode's owner in sourceBody
                if loopNode != (0 as the type of loopNode):
                    if loopNode's owner != selectedFace:
                        set faceNode to the cad node pointer for loopNode's owner in sourceBody
                        if faceNode != (0 as the type of faceNode):
                            set surfaceNode to the cad node pointer for faceNode's surface in sourceBody
                            if surfaceNode != (0 as the type of surfaceNode):
                                return the cad presspull surface (the cad clone of (@intrinsic("dereference", surfaceNode)))
        return no cad presspull surface

local function the cad presspull intersection curve of {cad plane:movedPlane} and {cad surface:otherSurface} matching {cad edge curve3:oldCurve} within {a 64 bit floating-point number:tolerance}:
    execute:
        set meetingValue to the cad meeting of (the cad surface of movedPlane) and otherSurface within tolerance
        if (meetingValue's kind != 1) or ((the length of (meetingValue's curves)) != 1):
            free cad meeting meetingValue
            return no cad presspull curve
        set curveValue to the cad clone of (the item at 0 in (meetingValue's curves))
        free cad meeting meetingValue
        if curveValue's kind != oldCurve's kind:
            return no cad presspull curve
        if curveValue's kind = 0:
            if (the cad dot of curveValue's line's direction and oldCurve's line's direction) < 0.0:
                set curveValue's line's direction to the cad negative of curveValue's line's direction
        else if curveValue's kind = 1:
            set newNormal to the cad normal of curveValue's circle's plane
            set oldNormal to the cad normal of oldCurve's circle's plane
            if (newNormal's valid = false) or (oldNormal's valid = false):
                return no cad presspull curve
            if (the cad dot of newNormal's value and oldNormal's value) < 0.0:
                set curveValue's circle's plane's yAxis to the cad negative of curveValue's circle's plane's yAxis
        else if curveValue's kind = 2:
            set newNormal to the cad normal of curveValue's ellipse's plane
            set oldNormal to the cad normal of oldCurve's ellipse's plane
            if (newNormal's valid = false) or (oldNormal's valid = false):
                return no cad presspull curve
            if (the cad dot of newNormal's value and oldNormal's value) < 0.0:
                set curveValue's ellipse's plane's yAxis to the cad negative of curveValue's ellipse's plane's yAxis
        else:
            return no cad presspull curve
        return the cad presspull curve curveValue

local function the cad presspull trigonometric parameters where {cad plane:movedPlane} meets {cad plane:curvePlane} with x radius {a 64 bit floating-point number:xRadius} and y radius {a 64 bit floating-point number:yRadius}:
    execute:
        set normalResult to the cad normal of movedPlane
        if normalResult's valid = false:
            return no cad presspull parameters
        set normalValue to normalResult's value
        set cosineCoefficient to (the cad dot of normalValue and curvePlane's xAxis) * xRadius
        set sineCoefficient to (the cad dot of normalValue and curvePlane's yAxis) * yRadius
        set planeOffset to the cad dot of normalValue and (the cad difference of movedPlane's origin and curvePlane's origin)
        set amplitude to @intrinsic("call", "libc", "hypot", a 64 bit floating-point number, cosineCoefficient, sineCoefficient)
        if (amplitude <= 1e-12) or ((the absolute value of planeOffset) > amplitude):
            return no cad presspull parameters
        set phase to @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, sineCoefficient, cosineCoefficient)
        set ratio to planeOffset / amplitude
        clamp ratio between -1.0 and 1.0
        set angle to @intrinsic("call", "libc", "acos", a 64 bit floating-point number, ratio)
        set roots to a cad topology list of a 64 bit floating-point number
        loop turn from -2 to 3:
            set fullTurn to (turn as a 64 bit floating-point number) * (the radians in a full turn)
            append ((phase - angle) + fullTurn) and ((phase + angle) + fullTurn) to roots's values
        return the cad presspull parameters roots

to get the cad presspull parameters where {cad plane:movedPlane} meets {cad edge curve3:curveValue}:
    set normalResult to the cad normal of movedPlane
    if normalResult's valid = false:
        return no cad presspull parameters
    set normalValue to normalResult's value
    if curveValue's kind = 0:
        set along to the cad dot of normalValue and curveValue's line's direction
        if (the absolute value of along) <= (1e-12 * (the cad length of curveValue's line's direction)):
            return no cad presspull parameters
        set values to a cad topology list of a 64 bit floating-point number
        append ((the cad dot of normalValue and (the cad difference of movedPlane's origin and curveValue's line's origin)) / along) to values's values
        return the cad presspull parameters values
    if curveValue's kind = 1:
        return the cad presspull trigonometric parameters where movedPlane meets curveValue's circle's plane with x radius curveValue's circle's radius and y radius curveValue's circle's radius
    if curveValue's kind = 2:
        return the cad presspull trigonometric parameters where movedPlane meets curveValue's ellipse's plane with x radius curveValue's ellipse's majorRadius and y radius curveValue's ellipse's minorRadius
    return no cad presspull parameters

local function cad presspull euclidean remainder of {a 64 bit floating-point number:value}:
    execute:
        set reduced to value mod (the radians in a full turn)
        if reduced < 0.0:
            return reduced + (the radians in a full turn)
        return reduced
local function the cad presspull span of {cad edge curve3:curveValue} from {cad vector3:startPoint} to {cad vector3:endPoint} like {cad edge:oldEdge} within {a 64 bit floating-point number:tolerance}:
    execute:
        set firstParameter to the cad parameter on curveValue nearest startPoint
        set secondParameter to the cad parameter on curveValue nearest endPoint
        if curveValue's kind is one of 1 and 2:
            set secondParameter to firstParameter + (cad presspull euclidean remainder of (secondParameter - firstParameter))
            if oldEdge's start = oldEdge's end:
                set secondParameter to firstParameter + (the radians in a full turn)
        if ((firstParameter is finite) and (secondParameter is finite)) = false:
            return no cad presspull span
        if secondParameter <= firstParameter:
            return no cad presspull span
        if (the cad distance from (the cad point on curveValue at firstParameter) to startPoint) > (tolerance * 4.0):
            return no cad presspull span
        if (the cad distance from (the cad point on curveValue at secondParameter) to endPoint) > (tolerance * 4.0):
            return no cad presspull span
        return @intrinsic("construct", a cad presspull span result, true, firstParameter, secondParameter)

local function the cad presspull boundary area of {cad face key:faceKey} in {cad body:sourceBody} within {a 64 bit floating-point number:tolerance}:
    execute:
        set boundaryResult to the cad boundary of faceKey in sourceBody within tolerance
        if boundaryResult's valid = false:
            return @intrinsic("construct", a cad presspull area result, false, 0.0 as a 64 bit floating-point number)
        set areaValue to 0.0 as a 64 bit floating-point number
        loop curveIndex from 0 to the length of (boundaryResult's curves's values):
            set areaValue to areaValue + (the cad enclosed area of (the item at curveIndex in (boundaryResult's curves's values)))
        return @intrinsic("construct", a cad presspull area result, true, areaValue)

local function the cad presspull local offset of {cad body:sourceBody} at {cad face key:faceKey} by {a 64 bit floating-point number:distance}:
    execute:
        set extractedResult to the cad planar face profile of sourceBody at faceKey
        if extractedResult's valid = false:
            return no cad body
        set outwardValue to extractedResult's value's outward
        set movedPlane to extractedResult's value's plane
        set movedPlane's origin to the cad sum of movedPlane's origin and (outwardValue scaled by distance)
        set toleranceBodies to a list containing sourceBody
        set tolerance to the cad operation tolerance of toleranceBodies
        free toleranceBodies
        if (the absolute value of distance) <= tolerance:
            return no cad body

        set boundaryKeys to an empty list of a cad edge key
        set faceUses to the cad face coedges of faceKey in sourceBody
        loop useIndex from 0 to the length of faceUses:
            set useNode to the cad node pointer for (the item at useIndex in faceUses) in sourceBody
            if useNode = (0 as the type of useNode):
                free faceUses
                free boundaryKeys
                return no cad body
            if (cad presspull boundaryKeys contains edge useNode's edge) = false:
                append useNode's edge to boundaryKeys
        free faceUses

        set vertexKeys to an empty list of a cad vertex key
        loop boundaryIndex from 0 to the length of boundaryKeys:
            set edgeNode to the cad node pointer for (the item at boundaryIndex in boundaryKeys) in sourceBody
            if edgeNode = (0 as the type of edgeNode):
                free vertexKeys
                free boundaryKeys
                return no cad body
            append cad presspull unique vertex edgeNode's start to vertexKeys
            append cad presspull unique vertex edgeNode's end to vertexKeys

        set movedValues to a cad topology list of a cad presspull moved vertex
        set allEdges to the cad edge keys of sourceBody
        for each vertexKey in vertexKeys:
            set vertexNode to the cad node pointer for vertexKey in sourceBody
            if vertexNode = (0 as the type of vertexNode):
                return no cad body
            set candidatePoints to a cad topology list of a cad vector3
            for each railKey in allEdges:
                set railNode to the cad node pointer for railKey in sourceBody
                if railNode = (0 as the type of railNode):
                    return no cad body
                set incident to (railNode's start = vertexKey) or (railNode's end = vertexKey)
                if incident and ((cad presspull boundaryKeys contains edge railKey) = false):
                    set curveNode to the cad node pointer for railNode's curve in sourceBody
                    if curveNode = (0 as the type of curveNode):
                        return no cad body
                    set parameterResult to the cad presspull parameters where movedPlane meets (@intrinsic("dereference", curveNode))
                    if parameterResult's valid = false:
                        return no cad body
                    set startsHere to railNode's start = vertexKey
                    set oldParameter to railNode's endParameter
                    set otherParameter to railNode's startParameter
                    if startsHere:
                        set oldParameter to railNode's startParameter
                        set otherParameter to railNode's endParameter
                    set foundParameter to false
                    set bestDistance to 1e300 as a 64 bit floating-point number
                    set bestParameter to 0.0 as a 64 bit floating-point number
                    for each candidateParameter in (parameterResult's values's values):
                        set allowed to (candidateParameter is finite)
                        if startsHere:
                            set allowed to allowed and (candidateParameter < (otherParameter - tolerance))
                        else:
                            set allowed to allowed and (candidateParameter > (otherParameter + tolerance))
                        if allowed:
                            set parameterDistance to the absolute value of (candidateParameter - oldParameter)
                            if parameterDistance < bestDistance:
                                set bestDistance to parameterDistance
                                set bestParameter to candidateParameter
                                set foundParameter to true
                    if foundParameter = false:
                        return no cad body
                    append (the cad point on (@intrinsic("dereference", curveNode)) at bestParameter) to candidatePoints's values
            if (the length of (candidatePoints's values)) = 0:
                return no cad body
            set movedPoint to the item at 0 in (candidatePoints's values)
            loop candidateIndex from 1 to the length of (candidatePoints's values):
                if (the cad distance from movedPoint to (the item at candidateIndex in (candidatePoints's values))) > (tolerance * 4.0):
                    return no cad body
            set planeDistance to the cad distance from movedPoint to movedPlane
            if (planeDistance's valid = false) or ((the absolute value of planeDistance's value) > (tolerance * 4.0)):
                return no cad body
            append (@intrinsic("construct", a cad presspull moved vertex, vertexKey, movedPoint)) to movedValues's values

        set outputBody to the cad clone of sourceBody
        for each movedValue in (movedValues's values):
            set outputVertex to the cad node pointer for movedValue's key in outputBody
            if outputVertex = (0 as the type of outputVertex):
                return no cad body
            set outputVertex's point to movedValue's point
            soil cad vertex movedValue's key in outputBody
        set surfaceKey to the cad body key after inserting (the cad surface of movedPlane) into outputBody
        set selectedNode to the cad node pointer for faceKey in outputBody
        if selectedNode = (0 as the type of selectedNode):
            return no cad body
        set selectedNode's surface to surfaceKey
        soil cad provenance selectedNode's provenance

        set affectedFaces to an empty list of a cad face key
        append faceKey to affectedFaces
        for each edgeKey in allEdges:
            set oldEdgeNode to the cad node pointer for edgeKey in sourceBody
            if oldEdgeNode = (0 as the type of oldEdgeNode):
                return no cad body
            set touchesMoved to (cad presspull vertexKeys contains vertex oldEdgeNode's start) or (cad presspull vertexKeys contains vertex oldEdgeNode's end)
            if touchesMoved:
                set oldCurveNode to the cad node pointer for oldEdgeNode's curve in sourceBody
                if oldCurveNode = (0 as the type of oldCurveNode):
                    return no cad body
                set nextCurveResult to the cad presspull curve (the cad clone of (@intrinsic("dereference", oldCurveNode)))
                if cad presspull boundaryKeys contains edge edgeKey:
                    set otherResult to the cad presspull adjacent surface to (@intrinsic("dereference", oldEdgeNode)) away from faceKey in sourceBody
                    if otherResult's valid = false:
                        return no cad body
                    set nextCurveResult to the cad presspull intersection curve of movedPlane and otherResult's value matching (@intrinsic("dereference", oldCurveNode)) within tolerance
                if nextCurveResult's valid = false:
                    return no cad body
                set outputStart to the cad node pointer for oldEdgeNode's start in outputBody
                set outputEnd to the cad node pointer for oldEdgeNode's end in outputBody
                if (outputStart = (0 as the type of outputStart)) or (outputEnd = (0 as the type of outputEnd)):
                    return no cad body
                set spanResult to the cad presspull span of nextCurveResult's value from outputStart's point to outputEnd's point like (@intrinsic("dereference", oldEdgeNode)) within tolerance
                if spanResult's valid = false:
                    return no cad body
                set curveKey to the cad body key after inserting nextCurveResult's value into outputBody
                set outputEdge to the cad node pointer for edgeKey in outputBody
                if outputEdge = (0 as the type of outputEdge):
                    return no cad body
                set outputEdge's curve to curveKey
                set outputEdge's startParameter to spanResult's first
                set outputEdge's endParameter to spanResult's second
                soil cad provenance outputEdge's provenance
                loop edgeUseIndex from 0 to the length of (oldEdgeNode's coedges's values):
                    set outputUse to the cad node pointer for (the item at edgeUseIndex in (oldEdgeNode's coedges's values)) in outputBody
                    if outputUse = (0 as the type of outputUse):
                        return no cad body
                    set outputUse's pcurve to no cad pcurve
                    soil cad provenance outputUse's provenance
                    set outputLoop to the cad node pointer for outputUse's owner in outputBody
                    if outputLoop = (0 as the type of outputLoop):
                        return no cad body
                    append cad presspull unique face outputLoop's owner to affectedFaces

        for each affectedKey in affectedFaces:
            set affectedNode to the cad node pointer for affectedKey in outputBody
            if affectedNode = (0 as the type of affectedNode):
                return no cad body
            set affectedSurface to the cad node pointer for affectedNode's surface in outputBody
            if affectedSurface = (0 as the type of affectedSurface):
                return no cad body
            if affectedSurface's kind = 0:
                set oldAreaResult to the cad presspull boundary area of affectedKey in sourceBody within tolerance
                set newAreaResult to the cad presspull boundary area of affectedKey in outputBody within tolerance
                if (oldAreaResult's valid = false) or (newAreaResult's valid = false):
                    return no cad body
                if ((oldAreaResult's value * newAreaResult's value) <= 0.0) or ((the absolute value of newAreaResult's value) <= (tolerance * tolerance)):
                    return no cad body
            set affectedUses to the cad face coedges of affectedKey in outputBody
            loop affectedUseIndex from 0 to the length of affectedUses:
                set affectedUse to the cad node pointer for (the item at affectedUseIndex in affectedUses) in outputBody
                if affectedUse = (0 as the type of affectedUse):
                    return no cad body
                set affectedEdge to the cad node pointer for affectedUse's edge in outputBody
                if affectedEdge = (0 as the type of affectedEdge):
                    return no cad body
                set affectedCurve to the cad node pointer for affectedEdge's curve in outputBody
                if affectedCurve = (0 as the type of affectedCurve):
                    return no cad body
                loop sampleIndex from 0 to 5:
                    set fraction to (sampleIndex as a 64 bit floating-point number) / 4.0
                    set sampleParameter to affectedEdge's startParameter + fraction * (affectedEdge's endParameter - affectedEdge's startParameter)
                    set samplePoint to the cad point on (@intrinsic("dereference", affectedCurve)) at sampleParameter
                    set sampleDistance to the cad distance from (@intrinsic("dereference", affectedSurface)) to samplePoint
                    if (sampleDistance is finite) = false:
                        return no cad body
                    if (the absolute value of sampleDistance) > (tolerance * 8.0):
                        return no cad body
            free affectedUses
        soil cad provenance outputBody's provenance
        set flaws to the cad flaws of outputBody
        set accepted to ((the length of flaws) = 0) and ((the cad worst vertex gap of outputBody) <= (tolerance * 4.0))
        free flaws
        free affectedFaces
        free allEdges
        free vertexKeys
        free boundaryKeys
        if accepted = false:
            return no cad body
        return the cad body result of outputBody

to get the cad presspull of {cad body:sourceBody} at {cad face key:faceKey} by {a number:givenDistance} in mode {integer:mode}:
    set distance to givenDistance as a 64 bit floating-point number
    if ((distance is finite) = false) or ((the absolute value of distance) <= 2.220446049250313e-16):
        return no cad body
    set worldProfile to the cad planar face profile of sourceBody at faceKey
    if worldProfile's valid = false:
        return no cad body
    if mode = cad presspull extrude mode:
        return the cad presspull of sourceBody with worldProfile's value by distance
    if mode != cad presspull offset mode:
        return no cad body
    set worldOrigin to worldProfile's value's plane's origin
    set localResult to the cad transformed sourceBody by (a cad placement at (the cad negative of worldOrigin))
    if localResult's valid = false:
        return no cad body
    set editedResult to the cad presspull local offset of localResult's value at faceKey by distance
    if editedResult's valid = false:
        return no cad body
    return the cad transformed editedResult's value by (a cad placement at worldOrigin)
to get the cad presspull of {cad body:sourceBody} at {cad face key:faceKey} by {a number:distance}:
    return the cad presspull of sourceBody at faceKey by distance in mode (cad presspull offset mode)
