# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f, src/space/nurbs.rs.
# NURBS curve construction, evaluation, fitting and refinement.
import lib/bim/nurbs3_storage.dl
import lib/bim/tessellation.dl

to get the cad nurbs curve3 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    set count to the length of points
    if degree <= 0 or count <= degree:
        return the absent cad nurbs curve
    set ownedKnots to the cad nurbs copied list of knots
    if (the length of knots) != ((count + degree) + 1):
        free ownedKnots
        set ownedKnots to the cad clamped uniform knots of degree degree for count points
    set ownedWeights to the cad nurbs copied list of weights
    if (the length of weights) != count:
        free ownedWeights
        set ownedWeights to the cad nurbs unit weights for count points
    set value to the cad owned nurbs curve of degree degree with controls (the cad nurbs copied list of points), knots ownedKnots and weights ownedWeights
    return @intrinsic("construct", a cad nurbs curve result, true, value)

to get the strict cad nurbs curve3 of degree {integer:degree} with controls {a pointer to a list:points}, knots {a pointer to a list:knots} and weights {a pointer to a list:weights}:
    set count to the length of points
    if ((((degree <= 0) or (count <= degree)) or ((the length of knots) != ((count + degree) + 1))) or ((the length of weights) != count)):
        return the absent cad nurbs curve
    if ((((cad nurbs knots knots are valid) = false) or ((cad nurbs points points are finite) = false)) or ((cad nurbs weights weights are positive) = false)):
        return the absent cad nurbs curve
    set value to the cad owned nurbs curve of degree degree with controls (the cad nurbs copied list of points), knots (the cad nurbs copied list of knots) and weights (the cad nurbs copied list of weights)
    return @intrinsic("construct", a cad nurbs curve result, true, value)

to get {cad nurbs curve3:shape} with cad periodicity {boolean:closed}:
    set result to shape
    set the closed of result to closed
    return result

to get the cad periodicity of {cad nurbs curve3:shape}:
    return the closed of shape

to get {cad nurbs curve3:shape} is cad rational:
    set first to 1.0 as a 64 bit floating-point number
    if (the length of the weights of shape) > 0:
        set first to the item at 0 in the weights of shape
    loop index from 0 to the length of the weights of shape:
        if (the absolute value of ((the item at index in the weights of shape) - first)) > 1e-12:
            return true
    return false

to get the cad domain of {cad nurbs curve3:shape}:
    return @intrinsic("construct", a cad nurbs interval, the item at (the degree of shape) in (the knots of shape), the item at (the length of the controls of shape) in (the knots of shape))

class:
    patterns:
        [a|] cad nurbs curve source
    members:
        curve as a cad nurbs curve3
        scale as a 64 bit floating-point number
        normalized as a boolean
        derivative as a boolean

local function the cad nurbs homogeneous control at {integer:index} from {cad nurbs curve source:source}:
    execute:
        set shape to the curve of source
        set weight to the item at index in (the weights of shape)
        if the normalized of source:
            set weight to weight / (the scale of source)
        return the cad nurbs homogeneous point (the item at index in (the controls of shape)) with weight weight

to get the cad spline point at {integer:index} from {cad nurbs curve source:source}:
    set current to the cad nurbs homogeneous control at index from source
    if (the derivative of source) = false:
        return current
    set shape to the curve of source
    set degree to the degree of shape
    set knots to the knots of shape
    set width to (the item at (((index + degree) + 1)) in knots) - (the item at (index + 1) in knots)
    set result to a new (the type of current)
    if width != 0.0:
        set next to the cad nurbs homogeneous control at (index + 1) from source
        set factor to (degree as a 64 bit floating-point number) / width
        loop axis from 0 to 4:
            store (((the item at axis in next) - (the item at axis in current)) * factor) at result + axis
    return result

to get the cad point on {cad nurbs curve3:shape} at knot {a number:parameter}:
    set u to the cad nurbs wrapped parameter parameter in (the cad domain of shape) with periodicity (the closed of shape)
    set source to @intrinsic("construct", a cad nurbs curve source, shape, 1.0, false, false)
    set raw to the cad de Boor value of degree (the degree of shape) with knots (the knots of shape) and (the length of the controls of shape) points from source at u
    return the cad nurbs evaluated point raw

to get the cad point on {cad nurbs curve3:shape} at {a number:parameter}:
    set unit to parameter as a 64 bit floating-point number
    clamp unit between 0.0 and 1.0
    set domain to the cad domain of shape
    return the cad point on shape at knot ((the start of domain) + ((the end of domain) - (the start of domain)) * unit)

to get the cad nurbs interior knots of {a pointer to a list:knots}:
    set result to an empty list of a 64 bit floating-point number
    loop index from 1 to (the length of knots) - 1:
        append (the item at index in knots) to result
    return result

to get the cad [derivative] of {cad nurbs curve3:shape} at knot {a number:parameter}:
    set u to the cad nurbs wrapped parameter parameter in (the cad domain of shape) with periodicity (the closed of shape)
    set scale to 0.0 as a 64 bit floating-point number
    loop index from 0 to the length of the weights of shape:
        set scale to the maximum of scale and (the item at index in the weights of shape)
    set source to @intrinsic("construct", a cad nurbs curve source, shape, scale, true, false)
    set value to the cad de Boor value of degree (the degree of shape) with knots (the knots of shape) and (the length of the controls of shape) points from source at u
    set the derivative of source to true
    set knots to the cad nurbs interior knots of (the knots of shape)
    set derivative to the cad de Boor value of degree ((the degree of shape) - 1) with knots knots and ((the length of the controls of shape) - 1) points from source at u
    free knots
    set weight to the item at 3 in value
    if weight <= 0.0:
        set nan to (0.0 as a 64 bit floating-point number) / 0.0
        return a cad vector3 with x nan, y nan and z nan
    set result to a new (a 64 bit floating-point number array of 3 items)
    loop axis from 0 to 3:
        store (((the item at axis in derivative) - ((the item at axis in value) / weight) * (the item at 3 in derivative)) / weight) at result + axis
    return the cad nurbs vector of result

local function the cad nurbs sampling interval of {cad nurbs curve3:shape} at {a number:parameter}:
    execute:
        set domain to the cad domain of shape
        set span to (the end of domain) - (the start of domain)
        set step to span * 1e-4
        set here to parameter as a 64 bit floating-point number
        if span <= 0.0:
            return @intrinsic("construct", a cad nurbs interval, 0.0, 0.0)
        if ((the start of domain) + step <= (the end of domain) - step) = false:
            @intrinsic("call", "libc", "abort", nothing)
        clamp here between ((the start of domain) + step) and ((the end of domain) - step)
        return @intrinsic("construct", a cad nurbs interval, here, step)

to get the cad tangent of {cad nurbs curve3:shape} at knot {a number:parameter}:
    set sample to the cad nurbs sampling interval of shape at parameter
    set domain to the cad domain of shape
    if ((the end of domain) - (the start of domain)) <= 0.0:
        return the cad zero vector3
    set behind to the cad point on shape at knot ((the start of sample) - (the end of sample))
    set ahead to the cad point on shape at knot ((the start of sample) + (the end of sample))
    return (the cad difference of ahead and behind) cad divided by (2.0 * (the end of sample))

to get the cad tangent of {cad nurbs curve3:shape} at {a number:parameter}:
    set unit to parameter as a 64 bit floating-point number
    clamp unit between 0.0 and 1.0
    set domain to the cad domain of shape
    return the cad tangent of shape at knot ((the start of domain) + ((the end of domain) - (the start of domain)) * unit)

# Adapter for the generic normalized-parameter tessellation protocol.
to get the cad curve point of {cad nurbs curve3:shape} at {a number:parameter}:
    return the cad point on shape at parameter

to get the cad curve tangent of {cad nurbs curve3:shape} at {a number:parameter}:
    return the cad tangent of shape at parameter

to get the cad acceleration of {cad nurbs curve3:shape} at knot {a number:parameter}:
    set sample to the cad nurbs sampling interval of shape at parameter
    set domain to the cad domain of shape
    if ((the end of domain) - (the start of domain)) <= 0.0:
        return the cad zero vector3
    set behind to the cad point on shape at knot ((the start of sample) - (the end of sample))
    set middle to the cad point on shape at knot (the start of sample)
    set ahead to the cad point on shape at knot ((the start of sample) + (the end of sample))
    return (the cad sum of (the cad difference of ahead and (middle scaled by 2.0)) and behind) cad divided by ((the end of sample) * (the end of sample))

to get {cad nurbs curve3:shape} is cad closed:
    if the closed of shape:
        return true
    set domain to the cad domain of shape
    return (the cad distance from (the cad point on shape at knot (the start of domain)) to (the cad point on shape at knot (the end of domain))) < 1e-9

local function the cad nurbs squared [distance] on {cad nurbs curve3:shape} at {a 64 bit floating-point number:parameter} to {cad vector3:point}:
    execute:
        set distance to the cad distance from (the cad point on shape at knot parameter) to point
        return distance * distance

to get the cad [parameter] on {cad nurbs curve3:shape} nearest {cad vector3:point}:
    set domain to the cad domain of shape
    set start to the start of domain
    set span to (the end of domain) - start
    set best to 0
    set distance to (1.0 as a 64 bit floating-point number) / 0.0
    loop step from 0 to 65:
        set parameter to start + (span * (step as a 64 bit floating-point number)) / 64.0
        set candidate to the cad nurbs squared distance on shape at parameter to point
        if candidate < distance:
            set best to step
            set distance to candidate
    set low to start + (span * ((the maximum of (best - 1) and 0) as a 64 bit floating-point number)) / 64.0
    set high to start + (span * ((the minimum of (best + 1) and 64) as a 64 bit floating-point number)) / 64.0
    loop round from 0 to 24:
        set third to (high - low) / 3.0
        set one to low + third
        set two to high - third
        if (the cad nurbs squared distance on shape at one to point) <= (the cad nurbs squared distance on shape at two to point):
            set high to two
        else:
            set low to one
    return 0.5 * (low + high)

# Work buffers below are private, exclusively owned lists. The source inserts
# knots in homogeneous space; periodic extraction uses width > 0 while Bezier
# extraction uses abs(width) < 1e-15. Keep that distinction.
local function insert cad nurbs homogeneous knot {a 64 bit floating-point number:knot} of degree {integer:degree} into {a pointer to a list:controls} with knots {a pointer to a list:knots} using positive [width] {boolean:positive}:
    execute:
        set span to the cad span of degree degree with knots knots and last ((the length of controls) - 1) at knot
        set next to an empty list of the type of (the item at 0 in controls)
        loop index from 0 to ((span - degree) + 1):
            append (the item at index in controls) to next
        loop index from ((span - degree) + 1) to span + 1:
            set width to (the item at (index + degree) in knots) - (the item at index in knots)
            set alpha to 0.0 as a 64 bit floating-point number
            if positive:
                if width > 0.0:
                    set alpha to (knot - (the item at index in knots)) / width
            else:
                if ((the absolute value of width) < 1e-15) = false:
                    set alpha to (knot - (the item at index in knots)) / width
            set before to the item at (index - 1) in controls
            set after to the item at index in controls
            set blended to a new (the type of before)
            loop axis from 0 to 4:
                store ((the item at axis in before) * (1.0 - alpha) + (the item at axis in after) * alpha) at blended + axis
            append blended to next
        loop index from span to the length of controls:
            append (the item at index in controls) to next
        clear controls
        loop index from 0 to the length of next:
            append (the item at index in next) to controls
        free next
        insert knot into knots at index (span + 1)

local function the cad nurbs multiplicity of {a 64 bit floating-point number:knot} in knots:
    execute:
        set result to 0
        loop index from 0 to the length of knots:
            if (the item at index in knots) = knot:
                increment result
        return result

local function the cad nurbs last occurrence of {a 64 bit floating-point number:knot} in knots:
    execute:
        set result to -1
        loop index from 0 to the length of knots:
            if (the item at index in knots) = knot:
                set result to index
        return result

to get the cad nurbs curve3 of degree {integer:degree} through control polygon {a pointer to a list:points} with periodicity {boolean:closed}:
    set weights to the cad nurbs unit weights for (the length of points) points
    set result to the cad nurbs curve3 of degree degree through control polygon points with weights weights and periodicity closed
    free weights
    return result

to get the cad nurbs curve3 of degree {integer:degree} through control polygon {a pointer to a list:points} with weights {a pointer to a list:weights} and periodicity {boolean:closed}:
    set count to the length of points
    if ((degree <= 0 or count <= degree) or (the length of weights) != count):
        return the absent cad nurbs curve
    if ((cad nurbs points points are finite) = false) or ((cad nurbs weights weights are positive) = false):
        return the absent cad nurbs curve
    if closed = false:
        set knots to the cad clamped uniform knots of degree degree for count points
        set result to the strict cad nurbs curve3 of degree degree with controls points, knots knots and weights weights
        free knots
        return result
    set homogeneous to an empty list of a 64 bit floating-point number array of 4 items
    loop index from 0 to 3 * count + degree:
        set sourceIndex to (((index + count) - degree)) mod count
        append (the cad nurbs homogeneous point (the item at sourceIndex in points) with weight (the item at sourceIndex in weights)) to homogeneous
    set knots to an empty list of a 64 bit floating-point number
    loop index from 0 to (((the length of homogeneous) + degree) + 1):
        append (index as a 64 bit floating-point number) to knots
    set from to (count + degree) as a 64 bit floating-point number
    set to to from + (count as a 64 bit floating-point number)
    loop endpoint from 0 to 2:
        set at to from
        if endpoint = 1:
            set at to to
        loop while (the cad nurbs multiplicity of at in knots) < degree:
            insert cad nurbs homogeneous knot at of degree degree into homogeneous with knots knots using positive width true
    set first to (the cad nurbs last occurrence of from in knots) - degree
    set lastKnot to the cad nurbs last occurrence of to in knots
    set last to lastKnot - degree
    set retainedPoints to an empty list of a cad vector3
    set retainedWeights to an empty list of a 64 bit floating-point number
    loop index from first to last + 1:
        set raw to the item at index in homogeneous
        append (the cad nurbs projected point raw) to retainedPoints
        append (the item at 3 in raw) to retainedWeights
    set retainedKnots to a list containing (from - from)
    loop index from first + 1 to lastKnot + 1:
        append ((the item at index in knots) - from) to retainedKnots
    append (to - from) to retainedKnots
    set result to the strict cad nurbs curve3 of degree degree with controls retainedPoints, knots retainedKnots and weights retainedWeights
    if the valid of result:
        set the closed of the value of result to true
    free homogeneous
    free knots
    free retainedPoints
    free retainedWeights
    free retainedKnots
    return result

to get the cad reversal of {cad nurbs curve3:shape}:
    set points to an empty list of a cad vector3
    set weights to an empty list of a 64 bit floating-point number
    set knots to an empty list of a 64 bit floating-point number
    set domain to the cad domain of shape
    set sum to (the start of domain) + (the end of domain)
    set index to (the length of the controls of shape) - 1
    loop while index >= 0:
        append (the item at index in the controls of shape) to points
        append (the item at index in the weights of shape) to weights
        decrement index
    set index to (the length of the knots of shape) - 1
    loop while index >= 0:
        append (sum - (the item at index in the knots of shape)) to knots
        decrement index
    set result to the strict cad nurbs curve3 of degree (the degree of shape) with controls points, knots knots and weights weights
    if the valid of result:
        set the closed of the value of result to the closed of shape
    free points
    free weights
    free knots
    return result

local function insert cad nurbs knot {a 64 bit floating-point number:knot} into {cad nurbs curve3:shape}:
    execute:
        set domain to the cad domain of shape
        if knot <= (the start of domain) or knot >= (the end of domain):
            return nothing
        set homogeneous to an empty list of a 64 bit floating-point number array of 4 items
        loop index from 0 to the length of the controls of shape:
            append (the cad nurbs homogeneous point (the item at index in the controls of shape) with weight (the item at index in the weights of shape)) to homogeneous
        insert cad nurbs homogeneous knot knot of degree (the degree of shape) into homogeneous with knots (the knots of shape) using positive width false
        clear (the controls of shape)
        clear (the weights of shape)
        for each raw in homogeneous:
            append (the cad nurbs projected point raw) to (the controls of shape)
            append (the item at 3 in raw) to (the weights of shape)
        free homogeneous

class:
    patterns:
        [a|] cad nurbs bezier parts
    members:
        segments
        breaks

local function the cad nurbs bezier parts of {cad nurbs curve3:shape}:
    execute:
        set work to the cad clone of shape
        set domain to the cad domain of work
        set start to the start of domain
        set end to the end of domain
        set missing to an empty list of a 64 bit floating-point number
        set atValues to an empty list of a 64 bit floating-point number
        set multiplicities to an empty list of an integer
        set finished to false
        loop while finished = false:
            clear missing
            clear atValues
            clear multiplicities
            loop index from 0 to the length of the knots of work:
                set knot to the item at index in the knots of work
                if (knot <= start + 1e-12 or knot >= end - 1e-12) = false:
                    set found to -1
                    loop group from 0 to the length of atValues:
                        if (found < 0) and ((the absolute value of ((the item at group in atValues) - knot)) < 1e-12):
                            set found to group
                    if found >= 0:
                        replace item at index found in multiplicities with ((the item at found in multiplicities) + 1)
                    else:
                        append knot to atValues
                        append 1 to multiplicities
            loop group from 0 to the length of atValues:
                if (the item at group in multiplicities) < (the degree of work):
                    append (the item at group in atValues) to missing
            if (the length of missing) = 0:
                set finished to true
            else:
                loop index from 0 to the length of missing:
                    insert cad nurbs knot (the item at index in missing) into work
        free missing
        free atValues
        free multiplicities
        set breaks to an empty list of a 64 bit floating-point number
        loop index from 0 to the length of the knots of work:
            set knot to the item at index in the knots of work
            if knot > start + 1e-12 and knot < end - 1e-12:
                set distinct to true
                if (the length of breaks) > 0:
                    set distinct to (the absolute value of ((the last item of breaks) - knot)) > 1e-12
                if distinct:
                    append knot to breaks
        set homogeneous to an empty list of a 64 bit floating-point number array of 4 items
        loop index from 0 to the length of the controls of work:
            append (the cad nurbs homogeneous point (the item at index in the controls of work) with weight (the item at index in the weights of work)) to homogeneous
        set segments to an empty list of the type of homogeneous
        loop index from 0 to ((the length of homogeneous) - 1) / (the degree of work):
            set segment to an empty list of a 64 bit floating-point number array of 4 items
            loop offset from 0 to (the degree of work) + 1:
                append (the item at (index * (the degree of work) + offset) in homogeneous) to segment
            append segment to segments
        free homogeneous
        return @intrinsic("construct", a cad nurbs bezier parts, segments, breaks)

local function the cad nurbs single elevation of {cad nurbs curve3:shape}:
    execute:
        set parts to the cad nurbs bezier parts of shape
        set segments to the segments of parts
        set breaks to the breaks of parts
        if (the length of segments) = 0:
            free segments
            free breaks
            return the absent cad nurbs curve
        set degree to the degree of shape
        set raised to degree + 1
        set points to an empty list of a cad vector3
        set weights to an empty list of a 64 bit floating-point number
        for each segment at part in segments:
            loop index from 0 to raised + 1:
                set alpha to (index as a 64 bit floating-point number) / (raised as a 64 bit floating-point number)
                set before to a new (a 64 bit floating-point number array of 4 items)
                set after to a new (a 64 bit floating-point number array of 4 items)
                if index > 0:
                    set before to the item at (index - 1) in segment
                if index <= degree:
                    set after to the item at index in segment
                set value to a new (a 64 bit floating-point number array of 4 items)
                loop axis from 0 to 4:
                    store ((the item at axis in before) * alpha + (the item at axis in after) * (1.0 - alpha)) at value + axis
                if part = 0 or index > 0:
                    append (the cad nurbs projected point value) to points
                    append (the item at 3 in value) to weights
            free segment
        free segments
        set domain to the cad domain of shape
        set knots to an empty list of a 64 bit floating-point number
        loop index from 0 to raised + 1:
            append (the start of domain) to knots
        loop index from 0 to the length of breaks:
            loop repetition from 0 to raised:
                append (the item at index in breaks) to knots
        loop index from 0 to raised + 1:
            append (the end of domain) to knots
        free breaks
        set result to the strict cad nurbs curve3 of degree raised with controls points, knots knots and weights weights
        if the valid of result:
            set the closed of the value of result to the closed of shape
        free points
        free knots
        free weights
        return result

to get the cad elevation of {cad nurbs curve3:shape} by {integer:count}:
    if count <= 0:
        return the absent cad nurbs curve
    set work to the cad clone of shape
    loop step from 0 to count:
        set raised to the cad nurbs single elevation of work
        if (the valid of raised) = false:
            return raised
        set work to the value of raised
    return @intrinsic("construct", a cad nurbs curve result, true, work)

to get the cad reduction of {cad nurbs curve3:shape} without control vertex {integer:index}:
    set count to the length of the controls of shape
    if ((((the closed of shape) or count <= 2) or index < 0) or index >= count):
        return the absent cad nurbs curve
    set domain to the cad domain of shape
    set degree to the degree of shape
    loop position from 0 to degree + 1:
        if (the item at position in the knots of shape) != (the start of domain):
            return the absent cad nurbs curve
    loop position from count to the length of the knots of shape:
        if (the item at position in the knots of shape) != (the end of domain):
            return the absent cad nurbs curve
    set work to the cad clone of shape
    remove item index from (the controls of work)
    remove item index from (the weights of work)
    if ((the length of the controls of work) <= degree):
        remove item ((the length of the knots of work) - 1) from (the knots of work)
        remove item 0 from (the knots of work)
        decrement degree
    else:
        set position to index + (degree + 1) / 2
        clamp position between (degree + 1) and (count - 1)
        remove item position from (the knots of work)
    return the strict cad nurbs curve3 of degree degree with controls (the controls of work), knots (the knots of work) and weights (the weights of work)

local function the cad nurbs coordinate list of points:
    execute:
        set result to an empty list of a 64 bit floating-point number array of 3 items
        loop index from 0 to the length of points:
            append (the cad nurbs coordinates of (the item at index in points)) to result
        return result

to get the cad nurbs fit through {a pointer to a list:points} with start tangent {cad spline tangent:start} and end tangent {cad spline tangent:end} using {cad spline parameterization:spacing}:
    set coordinates to the cad nurbs coordinate list of points
    set fitted to the cad open spline through coordinates with start tangent start and end tangent end using spacing
    free coordinates
    if (the valid of fitted) = false:
        free cad spline interpolation fitted
        return the absent cad nurbs curve
    set controls to an empty list of a cad vector3
    loop index from 0 to the length of the controls of fitted:
        append (the cad nurbs vector of (the item at index in the controls of fitted)) to controls
    set weights to the cad nurbs unit weights for (the length of controls) points
    set result to the strict cad nurbs curve3 of degree 3 with controls controls, knots (the knots of fitted) and weights weights
    free controls
    free weights
    free cad spline interpolation fitted
    return result

to get the cad nurbs fit through {a pointer to a list:points} using {cad spline parameterization:spacing}:
    set absent to no cad spline tangent matching [0.0, 0.0, 0.0]
    return the cad nurbs fit through points with start tangent absent and end tangent absent using spacing

to get the cad periodic nurbs fit through {a pointer to a list:points} using {cad spline parameterization:spacing}:
    set coordinates to the cad nurbs coordinate list of points
    set fitted to the cad periodic spline through coordinates using spacing
    free coordinates
    if (the valid of fitted) = false:
        free cad spline interpolation fitted
        return the absent cad nurbs curve
    set controls to an empty list of a cad vector3
    loop index from 0 to the length of the controls of fitted:
        append (the cad nurbs vector of (the item at index in the controls of fitted)) to controls
    set weights to the cad nurbs unit weights for (the length of controls) points
    # Upstream periodic fit constructs directly, without strict revalidation.
    set value to the cad owned nurbs curve of degree 3 with controls controls, knots (the cad nurbs copied list of (the knots of fitted)) and weights weights
    set the closed of value to true
    free cad spline interpolation fitted
    return @intrinsic("construct", a cad nurbs curve result, true, value)

local function refine cad nurbs samples of {cad nurbs curve3:shape} from {a 64 bit floating-point number:from} to {a 64 bit floating-point number:to} within {a 64 bit floating-point number:tolerance} at depth {integer:depth} into output:
    execute:
        set middle to (from + to) * 0.5
        set curved to the cad point on shape at knot middle
        if depth < 16:
            set start to the cad point on shape at knot from
            set end to the cad point on shape at knot to
            set chord to the cad lerp from start to end at 0.5
            if (the cad distance from chord to curved) > tolerance:
                refine cad nurbs samples of shape from from to middle within tolerance at depth (depth + 1) into output
                append curved to output
                refine cad nurbs samples of shape from middle to to within tolerance at depth (depth + 1) into output
                return nothing

to get the cad samples of {cad nurbs curve3:shape} within {a number:tolerance}:
    set domain to the cad domain of shape
    set result to a list containing (the cad point on shape at knot (the start of domain))
    refine cad nurbs samples of shape from (the start of domain) to (the end of domain) within (the maximum of (tolerance as a 64 bit floating-point number) and 1e-12) at depth 0 into result
    append (the cad point on shape at knot (the end of domain)) to result
    return result

local function refine cad nurbs angular samples of {cad nurbs curve3:shape} from {a 64 bit floating-point number:from} to {a 64 bit floating-point number:to} with angle {a 64 bit floating-point number:angle} at depth {integer:depth} into output:
    execute:
        set directions to an empty list of a cad vector3
        loop step from 0 to 9:
            set fraction to (step as a 64 bit floating-point number) * 0.125
            append (the cad tangent of shape at knot (from + (to - from) * fraction)) to directions
        set split to depth < 2 or (the cad maximum direction angle of directions) > angle
        free directions
        if split and depth < 16:
            set middle to (from + to) * 0.5
            refine cad nurbs angular samples of shape from from to middle with angle angle at depth (depth + 1) into output
            refine cad nurbs angular samples of shape from middle to to with angle angle at depth (depth + 1) into output
        else:
            append (the cad point on shape at knot to) to output

to get the cad samples of {cad nurbs curve3:shape} with maximum [angle] {a number:requested}:
    set domain to the cad domain of shape
    set angle to the cad sampling angle for (requested as a 64 bit floating-point number)
    set boundaries to a list containing (the start of domain)
    loop index from 0 to the length of the knots of shape:
        set knot to the item at index in the knots of shape
        if (((knot > (the start of domain)) and (knot < (the end of domain))) and (knot != (the last item of boundaries))):
            append knot to boundaries
    append (the end of domain) to boundaries
    set result to a list containing (the cad point on shape at knot (the start of domain))
    loop index from 1 to the length of boundaries:
        refine cad nurbs angular samples of shape from (the item at (index - 1) in boundaries) to (the item at index in boundaries) with angle angle at depth 0 into result
    free boundaries
    return result

to get the cad control points of {cad nurbs curve3:shape}:
    return the controls of shape

to get the cad knots of {cad nurbs curve3:shape}:
    return the knots of shape

to get the cad weights of {cad nurbs curve3:shape}:
    return the weights of shape

to get the cad degree of {cad nurbs curve3:shape}:
    return the degree of shape
