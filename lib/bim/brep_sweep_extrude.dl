# Port of cadkernel src/brep/sweep.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Solid and sheet extrusion, including tapered and open profiles.
import lib/bim/brep_sweep_topology.dl
import lib/bim/brep_sweep_revolve.dl
import lib/bim/brep_loft.dl
import lib/bim/brep_profile_pieces.dl
import lib/bim/brep_append.dl
import lib/bim/area2.dl
import lib/bim/offset2.dl

to get the cad extrusion of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction}:
    set normal to the cad normal of plane
    if (normal's valid) = false:
        return no cad body
    set up to the cad dot of direction and (normal's value)
    if (the absolute value of up) <= (1e-12 * (the maximum of (the cad length of direction) and 1.0)):
        return no cad body
    set ordered to the cad profile senses of profile
    if (ordered's valid) = false:
        return no cad body
    set senses to ordered's value
    set corners to a cad topology list of a cad vector2
    set handed to -0.0
    loop index from 0 to the length of profile:
        set piece to the item at index in profile
        set parameter to 1.0
        set area to the cad enclosed area of piece
        if the item at index in (senses's values):
            set parameter to 0.0
        else:
            set area to the negative of area
        append (the cad point on piece at parameter) to (corners's values)
        set handed to handed + area
    if (handed = 0.0) or (handed != handed):
        return no cad body
    set outward to (up * handed) > 0.0
    set body to an empty cad body
    set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
    set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
    set base to a cad topology list of a cad vertex key
    set top to a cad topology list of a cad vertex key
    loop index from 0 to the length of (corners's values):
        set point to the cad point at (the item at index in (corners's values)) on plane
        append (cad sweep vertex at point in body) to (base's values)
    loop index from 0 to the length of (corners's values):
        set point to the cad point at (the item at index in (corners's values)) on plane
        append (cad sweep vertex at (the cad sum of point and direction) in body) to (top's values)
    set baseEdges to cad sweep profile edges of profile on plane with senses senses and corners base in body
    if (the length of (baseEdges's values)) != (the length of profile):
        return no cad body
    set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
    set topEdges to cad sweep profile edges of profile on far with senses senses and corners top in body
    if (the length of (topEdges's values)) != (the length of profile):
        return no cad body
    set rails to a cad topology list of a cad edge key
    loop index from 0 to the length of (corners's values):
        set rail to cad sweep line from (the item at index in (base's values)) to (the item at index in (top's values)) in body
        if (rail's valid) = false:
            return no cad body
        append (rail's value) to (rails's values)
    if (cad sweep cap in body within shellKey on plane with edges baseEdges and senses senses forward (up < 0.0) along profile (outward = false)) = false:
        return no cad body
    if (cad sweep cap in body within shellKey on far with edges topEdges and senses senses forward (up > 0.0) along profile outward) = false:
        return no cad body
    loop index from 0 to the length of profile:
        set next to (index + 1) mod (the length of profile)
        set piece to the item at index in profile
        set wall to cad sweep wall of piece on plane along direction in body
        if (wall's valid) = false:
            return no cad body
        set out to cad sweep outward of piece on plane forward (the item at index in (senses's values)) counterclockwise (handed > 0.0)
        set point to the cad point at (the cad point on piece at 0.5) on plane
        set surface to the cad node pointer for (wall's surface) in body
        set forward to cad sweep sense of (@intrinsic("dereference", surface)) at point outward out
        if (forward's valid) = false:
            return no cad body
        set circuit to cad sweep circuit with base (the item at index in (baseEdges's values)), next rail (the item at next in (rails's values)), top (the item at index in (topEdges's values)) and rail (the item at index in (rails's values)) along (the item at index in (senses's values)) with spline (wall's spline)
        set uses to cad sweep reordered circuit outward outward
        if (cad sweep face in body within shellKey on (wall's surface) forward (forward's value) using uses) = false:
            return no cad body
    set lump to the cad node pointer for lumpKey in body
    append shellKey to (lump's shells's values)
    append lumpKey to (body's roots)
    return the validated cad body result of body

local function cad sweep offset area of {cad polyline2:outline}:
    execute:
        set curve to the cad curve2 of outline
        set pieces to the cad segments of curve
        set total to 0.0
        loop index from 0 to the length of pieces:
            set total to total + (the cad enclosed area of (the item at index in pieces))
        free pieces
        return the absolute value of total

# Positive angles move the far outline inward; negative angles move it outward.
# The offset distance uses the component normal to the profile plane, matching
# the wall angle for oblique extrusion vectors.
to get the tapered cad extrusion of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction} by {a number:givenAngle}:
    set angle to givenAngle as a 64 bit floating-point number
    if ((cad sweep revolution scalar angle is finite) = false) or ((the absolute value of angle) >= 1.5707963267948966):
        return no cad body
    if (the absolute value of angle) <= 1e-12:
        return the cad extrusion of profile on plane along direction
    set normal to the cad normal of plane
    if normal's valid = false:
        return no cad body
    set circular to false
    set circularCentre to the cad zero vector2
    set circularRadius to 0.0 as a 64 bit floating-point number
    if (the length of profile) > 0:
        set firstPiece to the item at 0 in profile
        if ((the length of profile) = 1) and (firstPiece's kind = 1):
            set circular to true
            set circularCentre to firstPiece's circle's centre
            set circularRadius to firstPiece's circle's radius
        else if firstPiece's kind = 2:
            set circular to true
            set circularCentre to firstPiece's arc's centre
            set circularRadius to firstPiece's arc's radius
            set totalSweep to 0.0 as a 64 bit floating-point number
            loop index from 0 to the length of profile:
                set piece to the item at index in profile
                if piece's kind != 2:
                    set circular to false
                else:
                    if (the cad distance from (piece's arc's centre) to circularCentre) > 1e-9:
                        set circular to false
                    if (the absolute value of (piece's arc's radius - circularRadius)) > 1e-9:
                        set circular to false
                    set totalSweep to totalSweep + (the cad sweep of (piece's arc))
            if (the absolute value of (totalSweep - 6.283185307179586)) >= 1e-9:
                set circular to false
            if circular:
                set ordered to the cad profile senses of profile
                if ordered's valid = false:
                    set circular to false
    if circular:
        set axis to normal's value
        set parallelError to the cad length of (the cad cross of direction and axis)
        set parallelLimit to 1e-10 * (the maximum of (the cad length of direction) and 1.0)
        # Oblique segmented circles continue through the offset/loft path.
        if parallelError <= parallelLimit:
            set signedHeight to the cad dot of direction and axis
            set radius to circularRadius
            set topRadius to radius - ((the absolute value of signedHeight) * @intrinsic("call", "libc", "tan", a 64 bit floating-point number, angle))
            if (topRadius <= 1e-12) or ((the absolute value of signedHeight) <= 1e-12):
                return no cad body
            set pivot to the cad point at circularCentre on plane
            set sectionPlane to a cad plane with origin pivot, x axis (plane's xAxis) and y axis axis
            set corners to [[0.0,0.0],[radius,0.0],[topRadius,signedHeight],[0.0,signedHeight]]
            set section to an empty list of a cad curve2
            loop index from 0 to 4:
                set start to the item at index in corners
                set finish to the item at ((index + 1) mod 4) in corners
                set firstPoint to a cad vector2 with x (the item at 0 in start) and y (the item at 1 in start)
                set lastPoint to a cad vector2 with x (the item at 0 in finish) and y (the item at 1 in finish)
                append (the cad curve2 of (a cad line2 from firstPoint to lastPoint)) to section
            set result to the cad revolution of section on sectionPlane about pivot along axis by 6.283185307179586
            free section
            return result
    set height to the absolute value of (the cad dot of direction and (normal's value))
    set tangentAngle to @intrinsic("call", "libc", "tan", a 64 bit floating-point number, angle)
    set offsetDistance to height * (the absolute value of tangentAngle)
    if ((cad sweep revolution scalar offsetDistance is finite) = false) or (offsetDistance <= 1e-12):
        return no cad body

    set ordered to the cad profile senses of profile
    if ordered's valid = false:
        return no cad body
    set senses to ordered's value
    set vertices to an empty list of a cad polyline vertex2
    set handed to -0.0
    loop index from 0 to the length of profile:
        set piece to the item at index in profile
        if (piece's kind is one of 0 and 2) = false:
            free vertices
            return no cad body
        set forward to the item at index in (senses's values)
        set parameter to 1.0
        if forward:
            set parameter to 0.0
        set bulge to 0.0
        if piece's kind = 2:
            set span to the cad sweep of (piece's arc)
            if forward = false:
                set span to the negative of span
            set bulge to @intrinsic("call", "libc", "tan", a 64 bit floating-point number, span * 0.25)
        append (a cad polyline vertex2 at (the cad point on piece at parameter) with bulge bulge) to vertices
        set area to the cad enclosed area of piece
        if forward = false:
            set area to the negative of area
        set handed to handed + area
    if (handed = 0.0) or ((cad sweep revolution scalar handed is finite) = false):
        free vertices
        return no cad body
    set source to the cad polyline2 with vertices vertices and closure true
    free vertices

    set firstPiece to the item at 0 in profile
    set firstForward to the item at 0 in (senses's values)
    set direction2 to the cad tangent of firstPiece at 0.5
    if firstForward = false:
        set direction2 to direction2 scaled by -1.0
    set tangentLength to the cad length of direction2
    if ((cad sweep revolution scalar tangentLength is finite) = false) or (tangentLength <= 1e-12):
        free cad polyline source
        return no cad body
    set tangent2 to direction2 scaled by (1.0 / tangentLength)
    set inward to a cad vector2 with x (the negative of (tangent2's y)) and y (tangent2's x)
    if handed < 0.0:
        set inward to a cad vector2 with x (tangent2's y) and y (the negative of (tangent2's x))
    set sideSign to -1.0
    if angle > 0.0:
        set sideSign to 1.0
    set middle to the cad point on firstPiece at 0.5
    set side to the cad sum of middle and (inward scaled by (offsetDistance * sideSign))
    set outlines to the cad offset polylines of source by offsetDistance toward side
    free cad polyline source
    if (the length of outlines) = 0:
        free outlines
        return no cad body
    set selected to 0
    set bestArea to -1.0
    loop index from 0 to the length of outlines:
        set candidateArea to cad sweep offset area of (the item at index in outlines)
        if candidateArea > bestArea:
            set selected to index
            set bestArea to candidateArea
    set topOutline to the cad clone of (the item at selected in outlines)
    free outlines
    set topCurve to the cad curve2 of topOutline
    set topProfile to the cad segments of topCurve
    free cad polyline topOutline
    if (the length of topProfile) != (the length of profile):
        free topProfile
        return no cad body
    if angle > 0.0:
        set coordinateScale to the maximum of offsetDistance and 1.0
        loop vertexIndex from 0 to the length of profile:
            set startPoint to the cad point on (the item at vertexIndex in profile) at 0.0
            set finishPoint to the cad point on (the item at vertexIndex in profile) at 1.0
            set coordinateScale to the maximum of coordinateScale and (the absolute value of (startPoint's x))
            set coordinateScale to the maximum of coordinateScale and (the absolute value of (startPoint's y))
            set coordinateScale to the maximum of coordinateScale and (the absolute value of (finishPoint's x))
            set coordinateScale to the maximum of coordinateScale and (the absolute value of (finishPoint's y))
        set distanceTolerance to the maximum of (the maximum of (offsetDistance * 1e-5) and (coordinateScale * 1e-10)) and 1e-9
        loop topIndex from 0 to the length of topProfile:
            set topPoint to the cad point on (the item at topIndex in topProfile) at 0.5
            set nearestDistance to 1.0 / 0.0
            loop sourceIndex from 0 to the length of profile:
                set sourceDistance to the cad distance to (the item at sourceIndex in profile) from topPoint
                set nearestDistance to the minimum of nearestDistance and sourceDistance
            if ((cad sweep revolution scalar nearestDistance is finite) = false) or ((the absolute value of (nearestDistance - offsetDistance)) > distanceTolerance):
                free topProfile
                return no cad body
        set topOrdered to the cad profile senses of topProfile
        if topOrdered's valid = false:
            free topProfile
            return no cad body
        set topArea to 0.0
        loop topIndex from 0 to the length of topProfile:
            set pieceArea to the cad enclosed area of (the item at topIndex in topProfile)
            if (the item at topIndex in (topOrdered's value's values)) = false:
                set pieceArea to the negative of pieceArea
            set topArea to topArea + pieceArea
        if ((cad sweep revolution scalar topArea is finite) = false) or ((the absolute value of topArea) >= (the absolute value of handed)):
            free topProfile
            return no cad body
    set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
    set sections to a list containing (a cad loft section on plane with profile profile)
    append (a cad loft section on far with profile topProfile) to sections
    set result to the cad loft through sections
    free sections
    free topProfile
    return result

class:
    patterns:
        [a|] cad sweep cap result
    members:
        valid as a boolean
        key as a cad face key

local function cad sweep tolerance in {cad body:body}:
    execute:
        set lowerX to 1.0 / 0.0
        set lowerY to 1.0 / 0.0
        set lowerZ to 1.0 / 0.0
        set upperX to the negative of lowerX
        set upperY to the negative of lowerY
        set upperZ to the negative of lowerZ
        set coordinateScale to 1.0
        set keys to the cad keys of (body's vertices)
        loop index from 0 to the length of keys:
            set vertex to the cad node pointer for (the item at index in keys) in (body's vertices)
            set point to vertex's point
            set lowerX to the minimum of lowerX and point's x
            set lowerY to the minimum of lowerY and point's y
            set lowerZ to the minimum of lowerZ and point's z
            set upperX to the maximum of upperX and point's x
            set upperY to the maximum of upperY and point's y
            set upperZ to the maximum of upperZ and point's z
            set coordinateScale to the maximum of coordinateScale and (the absolute value of point's x)
            set coordinateScale to the maximum of coordinateScale and (the absolute value of point's y)
            set coordinateScale to the maximum of coordinateScale and (the absolute value of point's z)
        free keys
        set extent to 1.0
        set extent to the maximum of extent and (upperX - lowerX)
        set extent to the maximum of extent and (upperY - lowerY)
        set extent to the maximum of extent and (upperZ - lowerZ)
        return (extent * 1e-8) + ((2.220446049250313e-16 * coordinateScale) * 64.0)

local function cad sweep cap on {cad plane:plane} in {cad body:body} within {a 64 bit floating-point number:tolerance}:
    execute:
        set normal to the cad normal of plane
        if normal's valid = false:
            return @intrinsic("construct", a cad sweep cap result, false, a new cad face key)
        set faceKeys to the cad face keys of body
        for each faceKey in faceKeys:
            set face to the cad node pointer for faceKey in body
            set surface to the cad node pointer for (face's surface) in body
            if surface's kind = 0:
                set candidateNormal to the cad normal of (surface's plane)
                set distance to the cad distance from (surface's plane's origin) to plane
                if (candidateNormal's valid) and (distance's valid):
                    if ((the absolute value of (the cad dot of (normal's value) and (candidateNormal's value))) > (1.0 - 1e-9)) and ((the absolute value of (distance's value)) <= tolerance):
                        free faceKeys
                        return @intrinsic("construct", a cad sweep cap result, true, faceKey)
        free faceKeys
        return @intrinsic("construct", a cad sweep cap result, false, a new cad face key)

local function cad sweep remove cap {cad face key:faceKey} from {cad body:body}:
    execute:
        set face to the cad node pointer for faceKey in body
        if face = (0 as the type of face):
            return false
        set shellKey to face's owner
        set surfaceKey to face's surface
        for each loopKey in (face's loops's values):
            set ring to the cad node pointer for loopKey in body
            if ring = (0 as the type of ring):
                return false
            for each useKey in (ring's coedges's values):
                set use to the cad node pointer for useKey in body
                if use = (0 as the type of use):
                    return false
                set edge to the cad node pointer for (use's edge) in body
                if edge = (0 as the type of edge):
                    return false
                loop removeIndex from ((the length of (edge's coedges's values)) - 1) down through 0:
                    if (the item at removeIndex in (edge's coedges's values)) = useKey:
                        remove item removeIndex from (edge's coedges's values)
                ignore the cad removal of useKey from body
            ignore the cad removal of loopKey from body
        ignore the cad removal of faceKey from body
        set shell to the cad node pointer for shellKey in body
        if shell = (0 as the type of shell):
            return false
        loop removeIndex from ((the length of (shell's faces's values)) - 1) down through 0:
            if (the item at removeIndex in (shell's faces's values)) = faceKey:
                remove item removeIndex from (shell's faces's values)
        set remaining to the cad face keys of body
        set shared to false
        loop index from 0 to the length of remaining:
            set other to the cad node pointer for (the item at index in remaining) in body
            if other's surface = surfaceKey:
                set shared to true
        free remaining
        if shared = false:
            ignore the cad removal of surfaceKey from body
        return true

local function cad sweep open taper profile of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction} by {a 64 bit floating-point number:angle}:
    execute:
        set absent to an empty list of a cad curve2
        set senses to the cad path senses of profile
        set normal to the cad normal of plane
        if (senses's valid = false) or (normal's valid = false):
            return absent
        set height to the absolute value of (the cad dot of direction and (normal's value))
        set offset to height * (the absolute value of (@intrinsic("call", "libc", "tan", a 64 bit floating-point number, angle)))
        if ((cad sweep revolution scalar offset is finite) = false) or (offset <= 1e-12):
            return absent
        set vertices to an empty list of a cad polyline vertex2
        for each piece at index in profile:
            if (piece's kind is one of 0 and 2) = false:
                free vertices
                return absent
            set forward to the item at index in (senses's value's values)
            set startParameter to 1.0
            if forward:
                set startParameter to 0.0
            set bulge to 0.0
            if piece's kind = 2:
                set signedSweep to the cad sweep of (piece's arc)
                if forward = false:
                    set signedSweep to the negative of signedSweep
                set bulge to @intrinsic("call", "libc", "tan", a 64 bit floating-point number, signedSweep * 0.25)
            append (a cad polyline vertex2 at (the cad point on piece at startParameter) with bulge bulge) to vertices
        set lastPiece to the last item of profile
        set endParameter to 0.0
        if the last item of (senses's value's values):
            set endParameter to 1.0
        append (a straight cad polyline vertex2 at (the cad point on lastPiece at endParameter)) to vertices
        set source to the cad polyline2 with vertices vertices and closure false
        free vertices
        set firstPiece to the item at 0 in profile
        set tangent to the cad tangent of firstPiece at 0.5
        if (the item at 0 in (senses's value's values)) = false:
            set tangent to tangent scaled by -1.0
        set length to the cad length of tangent
        if ((cad sweep revolution scalar length is finite) = false) or (length <= 1e-12):
            free cad polyline source
            return absent
        set left to a cad vector2 with x ((the negative of tangent's y) / length) and y (tangent's x / length)
        set sideSign to -1.0
        if angle > 0.0:
            set sideSign to 1.0
        set side to the cad sum of (the cad point on firstPiece at 0.5) and (left scaled by (offset * sideSign))
        set outlines to the cad offset polylines of source by offset toward side
        free cad polyline source
        set selected to -1
        set longest to -1.0
        for each candidate at candidateIndex in outlines:
            if candidate's closed = false:
                set pieces to the cad segments of (the cad curve2 of candidate)
                set candidateLength to 0.0
                loop pieceIndex from 0 to the length of pieces:
                    set piece to the item at pieceIndex in pieces
                    if piece's kind = 0:
                        set candidateLength to candidateLength + (the cad length of (piece's line))
                    else if piece's kind = 2:
                        set candidateLength to candidateLength + ((piece's arc's radius) * (the cad sweep of (piece's arc)))
                free pieces
                if candidateLength >= longest:
                    set longest to candidateLength
                    set selected to candidateIndex
        if selected < 0:
            free outlines
            return absent
        set topOutline to the cad clone of (the item at selected in outlines)
        free outlines
        set topProfile to the cad segments of (the cad curve2 of topOutline)
        free cad polyline topOutline
        if (the length of topProfile) != (the length of profile):
            free topProfile
            return absent
        return topProfile

local function cad sweep open taper sheet of {a pointer to a list:baseProfile} on {cad plane:basePlane} to {a pointer to a list:topProfile} on {cad plane:topPlane}:
    execute:
        if ((the length of baseProfile) = 0) or ((the length of baseProfile) != (the length of topProfile)):
            return no cad body
        set baseSenses to the cad path senses of baseProfile
        set topSenses to the cad path senses of topProfile
        if (baseSenses's valid = false) or (topSenses's valid = false):
            return no cad body
        set basePoints to a cad topology list of a cad vector2
        set topPoints to a cad topology list of a cad vector2
        loop index from 0 to the length of baseProfile:
            set baseParameter to 1.0
            if the item at index in (baseSenses's value's values):
                set baseParameter to 0.0
            set topParameter to 1.0
            if the item at index in (topSenses's value's values):
                set topParameter to 0.0
            append (the cad point on (the item at index in baseProfile) at baseParameter) to (basePoints's values)
            append (the cad point on (the item at index in topProfile) at topParameter) to (topPoints's values)
        set endParameter to 0.0
        if the last item of (baseSenses's value's values):
            set endParameter to 1.0
        append (the cad point on (the last item of baseProfile) at endParameter) to (basePoints's values)
        set endParameter to 0.0
        if the last item of (topSenses's value's values):
            set endParameter to 1.0
        append (the cad point on (the last item of topProfile) at endParameter) to (topPoints's values)
        set body to an empty cad body
        set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
        set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
        set baseVertices to a cad topology list of a cad vertex key
        set topVertices to a cad topology list of a cad vertex key
        loop index from 0 to the length of (basePoints's values):
            append (cad sweep vertex at (the cad point at (the item at index in (basePoints's values)) on basePlane) in body) to (baseVertices's values)
        loop index from 0 to the length of (topPoints's values):
            append (cad sweep vertex at (the cad point at (the item at index in (topPoints's values)) on topPlane) in body) to (topVertices's values)
        set baseEdges to a cad topology list of a cad edge key
        set topEdges to a cad topology list of a cad edge key
        loop index from 0 to the length of baseProfile:
            set next to index + 1
            set baseFrom to index
            set baseTo to next
            if (the item at index in (baseSenses's value's values)) = false:
                set baseFrom to next
                set baseTo to index
            set topFrom to index
            set topTo to next
            if (the item at index in (topSenses's value's values)) = false:
                set topFrom to next
                set topTo to index
            set baseEdge to cad sweep profile edge of (the item at index in baseProfile) on basePlane from (the item at baseFrom in (baseVertices's values)) to (the item at baseTo in (baseVertices's values)) in body
            set topEdge to cad sweep profile edge of (the item at index in topProfile) on topPlane from (the item at topFrom in (topVertices's values)) to (the item at topTo in (topVertices's values)) in body
            if (baseEdge's valid = false) or (topEdge's valid = false):
                return no cad body
            append (baseEdge's value) to (baseEdges's values)
            append (topEdge's value) to (topEdges's values)
        set rails to a cad topology list of a cad edge key
        loop index from 0 to the length of (baseVertices's values):
            set rail to cad sweep line from (the item at index in (baseVertices's values)) to (the item at index in (topVertices's values)) in body
            if rail's valid = false:
                return no cad body
            append (rail's value) to (rails's values)
        loop index from 0 to the length of baseProfile:
            set baseBuilt to the cad rational builder of (the item at index in baseProfile)
            set topBuilt to the cad rational builder of (the item at index in topProfile)
            if (baseBuilt's valid = false) or (topBuilt's valid = false):
                return no cad body
            set baseCurve to baseBuilt's value
            set topCurve to topBuilt's value
            if (the item at index in (baseSenses's value's values)) = false:
                set baseCurve to the cad reverse of baseCurve
            if (the item at index in (topSenses's value's values)) = false:
                set topCurve to the cad reverse of topCurve
            set baseLifted to the cad lift of baseCurve onto basePlane
            set topLifted to the cad lift of topCurve onto topPlane
            if (baseLifted is cad compatible with topLifted) = false:
                return no cad body
            set ruled to the cad ruled surface from baseLifted to topLifted
            if ruled's valid = false:
                return no cad body
            set surface to the cad surface of (ruled's value)
            set normal to the cad normal of surface at parameters 0.5 and 0.5
            if normal's valid = false:
                return no cad body
            set surfaceKey to the cad body key after inserting surface into body
            set uses to a cad topology list of a cad sweep use
            append (cad sweep use of (the item at index in (baseEdges's values)) forward (the item at index in (baseSenses's value's values))), (cad sweep use of (the item at (index + 1) in (rails's values)) forward true), (cad sweep use of (the item at index in (topEdges's values)) forward ((the item at index in (topSenses's value's values)) = false)) and (cad sweep use of (the item at index in (rails's values)) forward false) to (uses's values)
            set corners to [[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0]]
            loop cornerIndex from 0 to 4:
                set first to the item at cornerIndex in corners
                set last to the item at ((cornerIndex + 1) mod 4) in corners
                set p to a cad vector2 with x (the item at 0 in first) and y (the item at 1 in first)
                set q to a cad vector2 with x (the item at 0 in last) and y (the item at 1 in last)
                set use to the item at cornerIndex in (uses's values)
                set use's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from p to q))
                replace item at index cornerIndex in (uses's values) with use
            if (cad sweep face in body within shellKey on surfaceKey forward true using uses) = false:
                return no cad body
        set lump to the cad node pointer for lumpKey in body
        append shellKey to (lump's shells's values)
        append lumpKey to (body's roots)
        return the validated cad body result of body

to get the tapered cad extrusion sheet of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction} by {a number:givenAngle}:
    set angle to givenAngle as a 64 bit floating-point number
    if ((cad sweep revolution scalar angle is finite) = false) or ((the absolute value of angle) >= 1.5707963267948966):
        return no cad body
    if (the absolute value of angle) <= 1e-12:
        return the cad extrusion sheet of profile on plane along direction
    set ordered to the cad profile senses of profile
    if ordered's valid = false:
        set topProfile to cad sweep open taper profile of profile on plane along direction by angle
        if (the length of topProfile) = 0:
            free topProfile
            return no cad body
        set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
        set result to cad sweep open taper sheet of profile on plane to topProfile on far
        free topProfile
        return result
    set solid to the tapered cad extrusion of profile on plane along direction by angle
    if solid's valid = false:
        return no cad body
    set body to solid's value
    set tolerance to cad sweep tolerance in body
    set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
    set baseCap to cad sweep cap on plane in body within tolerance
    set farCap to cad sweep cap on far in body within tolerance
    if (baseCap's valid = false) or (farCap's valid = false):
        return no cad body
    if baseCap's key = farCap's key:
        return no cad body
    if (cad sweep remove cap (baseCap's key) from body) = false:
        return no cad body
    if (cad sweep remove cap (farCap's key) from body) = false:
        return no cad body
    return the validated cad body result of body

to get the cad extrusion sheet of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction}:
    set length to the cad length of direction
    if (length <= 1e-12) or ((length <= 1.7976931348623157e308) = false):
        return no cad body
    set ordered to the cad profile senses of profile
    set closed to ordered's valid
    if closed = false:
        set ordered to the cad path senses of profile
    if (ordered's valid) = false:
        return no cad body
    set senses to ordered's value
    set corners to a cad topology list of a cad vector2
    loop index from 0 to the length of profile:
        set parameter to 1.0
        if the item at index in (senses's values):
            set parameter to 0.0
        append (the cad point on (the item at index in profile) at parameter) to (corners's values)
    if closed = false:
        set parameter to 0.0
        if the last item of (senses's values):
            set parameter to 1.0
        append (the cad point on (the last item of profile) at parameter) to (corners's values)
    if ((the length of profile) = 0) or ((the length of (corners's values)) < 2):
        return no cad body
    set body to an empty cad body
    set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
    set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
    set base to a cad topology list of a cad vertex key
    set top to a cad topology list of a cad vertex key
    loop index from 0 to the length of (corners's values):
        set point to the cad point at (the item at index in (corners's values)) on plane
        append (cad sweep vertex at point in body) to (base's values)
    loop index from 0 to the length of (corners's values):
        set point to the cad point at (the item at index in (corners's values)) on plane
        append (cad sweep vertex at (the cad sum of point and direction) in body) to (top's values)
    set far to a cad plane with origin (the cad sum of (plane's origin) and direction), x axis (plane's xAxis) and y axis (plane's yAxis)
    set baseEdges to a cad topology list of a cad edge key
    set topEdges to a cad topology list of a cad edge key
    loop index from 0 to the length of profile:
        set next to index + 1
        if closed:
            set next to next mod (the length of (corners's values))
        set from to index
        set to to next
        if (the item at index in (senses's values)) = false:
            set from to next
            set to to index
        set piece to the item at index in profile
        set near to cad sweep profile edge of piece on plane from (the item at from in (base's values)) to (the item at to in (base's values)) in body
        if (near's valid) = false:
            return no cad body
        append (near's value) to (baseEdges's values)
        set distant to cad sweep profile edge of piece on far from (the item at from in (top's values)) to (the item at to in (top's values)) in body
        if (distant's valid) = false:
            return no cad body
        append (distant's value) to (topEdges's values)
    set rails to a cad topology list of a cad edge key
    loop index from 0 to the length of (corners's values):
        set rail to cad sweep line from (the item at index in (base's values)) to (the item at index in (top's values)) in body
        if (rail's valid) = false:
            return no cad body
        append (rail's value) to (rails's values)
    loop index from 0 to the length of profile:
        set next to index + 1
        if closed:
            set next to next mod (the length of (corners's values))
        set piece to the item at index in profile
        set wall to cad sweep wall of piece on plane along direction in body
        if (wall's valid) = false:
            return no cad body
        set tangent to the cad vector at (the cad tangent of piece at 0.5) on plane
        set factor to -1.0
        if the item at index in (senses's values):
            set factor to 1.0
        set out to the cad cross of (tangent scaled by factor) and direction
        set point to the cad point at (the cad point on piece at 0.5) on plane
        set surface to the cad node pointer for (wall's surface) in body
        set forward to cad sweep sense of (@intrinsic("dereference", surface)) at point outward out
        if (forward's valid) = false:
            return no cad body
        set circuit to cad sweep circuit with base (the item at index in (baseEdges's values)), next rail (the item at next in (rails's values)), top (the item at index in (topEdges's values)) and rail (the item at index in (rails's values)) along (the item at index in (senses's values)) with spline (wall's spline)
        if (cad sweep face in body within shellKey on (wall's surface) forward (forward's value) using circuit) = false:
            return no cad body
    set lump to the cad node pointer for lumpKey in body
    append shellKey to (lump's shells's values)
    append lumpKey to (body's roots)
    return the validated cad body result of body

to get the cad extrusion sheets of {a pointer to a list:profiles} on {cad plane:plane} along {cad vector3:direction}:
    set combined to an empty cad body
    loop index from 0 to the length of profiles:
        set pieces to the cad extrusion profile pieces of (the item at index in profiles)
        set sheet to the cad extrusion sheet of pieces on plane along direction
        free pieces
        if sheet's valid = false:
            return no cad body
        if (append cad body (sheet's value) into combined) = false:
            return no cad body
    if (the length of (combined's roots)) = 0:
        return no cad body
    return the validated cad body result of combined

to get the tapered cad extrusion sheets of {a pointer to a list:profiles} on {cad plane:plane} along {cad vector3:direction} by {a number:givenAngle}:
    set combined to an empty cad body
    set angle to givenAngle as a 64 bit floating-point number
    loop index from 0 to the length of profiles:
        set pieces to the cad extrusion profile pieces of (the item at index in profiles)
        set wallAngle to angle
        if index > 0:
            set wallAngle to the negative of angle
        set sheet to the tapered cad extrusion sheet of pieces on plane along direction by wallAngle
        free pieces
        if sheet's valid = false:
            return no cad body
        if (append cad body (sheet's value) into combined) = false:
            return no cad body
    if (the length of (combined's roots)) = 0:
        return no cad body
    return the validated cad body result of combined
