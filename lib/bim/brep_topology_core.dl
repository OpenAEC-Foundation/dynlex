# SPDX-License-Identifier: MPL-2.0
# Native foundation from src/brep/{mod,topology}.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Nominal topology keys, owned nodes and body storage with adjacency queries.
import lib/bim/arena.dl
import lib/bim/brep_geometry.dl
import lib/bim/curve2.dl

class:
    patterns:
        [a|] cad source reference
    members:
        index as a 32 bit unsigned integer
class:
    patterns:
        [a|] cad source result
    members:
        valid as a boolean
        value as a cad source reference
class:
    patterns:
        [a|] cad provenance
    members:
        kind as an integer
        reference as a cad source reference

to get a cad source reference for {a 32 bit unsigned integer:index}:
    return @intrinsic("construct", a cad source reference, index)
to get the cad index of {cad source reference:value}:
    return value's index
to get {cad source reference:first} = {cad source reference:second}:
    return first's index = second's index
to hash cad source reference {cad source reference:value} into state: hash cad unsigned integer value's index into state
to get the cad clone of {cad source reference:value}:
    return value
to get the clean cad provenance of {cad source reference:reference}:
    return @intrinsic("construct", a cad provenance, 1, reference)
to get the dirty cad provenance of {cad source reference:reference}:
    return @intrinsic("construct", a cad provenance, 2, reference)
to get the synthesized cad provenance:
    return @intrinsic("construct", a cad provenance, 0, a new cad source reference)
to get the cad source of {cad provenance:value}:
    return @intrinsic("construct", a cad source result, value's kind != 0, value's reference)
to get cad {cad provenance:value} is reusable:
    return value's kind = 1
to soil cad provenance {cad provenance:value}:
    if value's kind = 1:
        set value's kind to 2
to get {cad provenance:first} = {cad provenance:second}:
    if first's kind != second's kind:
        return false
    return (first's kind = 0) or (first's reference = second's reference)
to get the cad clone of {cad provenance:value}:
    return value

# A Vec-like owner. Each list is copied explicitly by node/body Clone.
class:
    patterns:
        [a|] cad topology list
    members:
        values
        references as a pointer to an integer
    retain:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 2147483647:
                abort the program
            @intrinsic("store at", owner, count + 1)
    release:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                free (the values of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, count - 1)

local function a cad topology reference counter:
    execute:
        set result to the checked allocation from (0 as a pointer) resized to 1 items of an integer
        @intrinsic("initialize at", result, 0)
        return result
to get a cad topology list of {type:kind}:
    return @intrinsic("construct", a cad topology list, an empty list of kind, a cad topology reference counter)
to get the cad clone of {cad topology list:original}:
    set result to a cad topology list of the type of (the item at 0 in original's values)
    loop index from 0 to the length of original's values:
        append (the item at index in original's values) to result's values
    return result
local function cad topology lists {cad topology list:first} and {cad topology list:second} are equal:
    execute:
        if (the length of first's values) != (the length of second's values):
            return false
        loop index from 0 to the length of first's values:
            if ((the item at index in first's values) = (the item at index in second's values)) = false:
                return false
        return true

class:
    patterns:
        [a|] cad pcurve result
    members:
        valid as a boolean
        value as the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))
to get no cad pcurve:
    return @intrinsic("construct", a cad pcurve result, false, a new (the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))))
to get the cad pcurve of {cad curve2:value}:
    return @intrinsic("construct", a cad pcurve result, true, value)
to get the cad clone of {cad pcurve result:original}:
    if original's valid:
        return the cad pcurve of (the cad clone of original's value)
    return no cad pcurve
to get {cad pcurve result:first} = {cad pcurve result:second}:
    if first's valid != second's valid:
        return false
    return (first's valid = false) or (first's value = second's value)

# Nominal key records make every adjacency field statically kind-specific.

class:
    patterns:
        [a|] cad vertex key
    members:
        index as a 32 bit unsigned integer
        generation as a 32 bit unsigned integer

local function the cad arena key of {cad vertex key:key}:
    execute:
        return @intrinsic("construct", a cad key, key's index, key's generation, 0 as a pointer to a cad vertex)
local function the cad vertex key from {cad key:key}:
    execute:
        return @intrinsic("construct", a cad vertex key, key's index, key's generation)
to get the cad slot of {cad vertex key:key}:
    return key's index
to get {cad vertex key:first} = {cad vertex key:second}:
    return (first's index = second's index) and (first's generation = second's generation)
to get {cad vertex key:first} != {cad vertex key:second}:
    return (first = second) = false
to get the cad clone of {cad vertex key:key}:
    return key
to get the cad payload clone of {cad vertex key:key}:
    return key
to get the cad debug text of {cad vertex key:key}:
    return the cad debug text of (the cad arena key of key)
to hash cad key {cad vertex key:key} into state: hash cad key (the cad arena key of key) into state

