# Port of cadkernel src/brep/sweep.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Complete and partial revolutions of planar profiles.
import lib/bim/brep_sweep_topology.dl
import lib/bim/brep_revolve_rational.dl
import lib/bim/brep_profile_pieces.dl
import lib/bim/area2.dl

local function no cad sweep projection bounds:
    execute:
        return @intrinsic("construct", a cad sweep projection bounds, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function cad sweep projection bounds between {a 64 bit floating-point number:first} and {a 64 bit floating-point number:second}:
    execute:
        if ((first is finite) and (second is finite)) = false:
            return no cad sweep projection bounds
        return @intrinsic("construct", a cad sweep projection bounds, true, the minimum of first and second, the maximum of first and second)

local function cad sweep revolution angle from {a 64 bit floating-point number:y} over {a 64 bit floating-point number:x}:
    execute:
        return @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, y, x)

local function cad sweep revolution positive remainder of {a 64 bit floating-point number:value}:
    execute:
        set result to value mod (the radians in a full turn)
        if result < 0.0:
            set result to result + (the radians in a full turn)
        return result

local function cad sweep trigonometric value with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine} at {a 64 bit floating-point number:parameter}:
    execute:
        return (centre + (cosine * (the cosine of parameter))) + (sine * (the sine of parameter))

local function cad sweep trigonometric bounds with centre {a 64 bit floating-point number:centre}, cosine {a 64 bit floating-point number:cosine}, sine {a 64 bit floating-point number:sine}, start {a 64 bit floating-point number:start} and sweep {a 64 bit floating-point number:sweep}:
    execute:
        set finish to start + sweep
        if (((((centre is finite) and (cosine is finite)) and (sine is finite)) and (start is finite)) and ((sweep is finite) and (sweep > 0.0))) = false:
            return no cad sweep projection bounds
        if (finish is finite) = false:
            return no cad sweep projection bounds
        set first to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at start
        set last to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at finish
        set interval to cad sweep projection bounds between first and last
        if (interval's valid) = false:
            return interval
        set maximumParameter to cad sweep revolution angle from sine over cosine
        loop offsetIndex from 0 to 2:
            set extreme to maximumParameter + ((offsetIndex as a 64 bit floating-point number) * (the radians in a half turn))
            set offset to cad sweep revolution positive remainder of (extreme - start)
            if (sweep >= ((the radians in a full turn) - 1e-12)) or (offset <= (sweep + 1e-12)):
                set measured to cad sweep trigonometric value with centre centre, cosine cosine, sine sine at extreme
                if (measured is finite) = false:
                    return no cad sweep projection bounds
                set interval's low to the minimum of (interval's low) and measured
                set interval's high to the maximum of (interval's high) and measured
        return interval

local function cad sweep projection of {cad vector3:point} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        return the cad dot of (the cad difference of point and origin) and direction

local function cad sweep projection bounds of {cad curve2:piece} on {cad plane:plane} from {cad vector3:origin} along {cad vector3:direction}:
    execute:
        if (piece's kind) = 0:
            set first to cad sweep projection of (the cad point at (piece's line's start) on plane) from origin along direction
            set second to cad sweep projection of (the cad point at (piece's line's end) on plane) from origin along direction
            return cad sweep projection bounds between first and second
        if (piece's kind) = 2:
            set arc to piece's arc
            set centre to cad sweep projection of (the cad point at (arc's centre) on plane) from origin along direction
            set cosineVector to the cad vector at (a cad vector2 with x (arc's radius) and y 0.0) on plane
            set sineVector to the cad vector at (a cad vector2 with x 0.0 and y (arc's radius)) on plane
            set cosine to the cad dot of cosineVector and direction
            set sine to the cad dot of sineVector and direction
            return cad sweep trigonometric bounds with centre centre, cosine cosine, sine sine, start (arc's startAngle) and sweep (the cad sweep of arc)
        return no cad sweep projection bounds

local function no cad sweep revolution turn:
    execute:
        return @intrinsic("construct", a cad sweep revolution turn, false, the cad zero vector3, the cad zero vector3, the cad zero vector3, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number, false)

local function cad sweep complete revolution turn of {a pointer to a list:profile} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a 64 bit floating-point number:angle}:
    execute:
        set rational to false
        loop index from 0 to the length of profile:
            set kind to (the item at index in profile)'s kind
            if kind is one of 3 and 5:
                set rational to true
            else if 0 != kind != 2:
                return no cad sweep revolution turn
        if rational:
            set built to the cad rational revolution turn of profile on plane about pivot along axis by angle
            if built's valid = false:
                return no cad sweep revolution turn
            return @intrinsic("construct", a cad sweep revolution turn, true, built's pivot, built's axis, built's radial, built's spin, built's tolerance, built's angle, built's full)
        set normalResult to the cad normal of plane
        set directionResult to the cad normalization of axis
        if ((normalResult's valid) and (directionResult's valid)) = false:
            return no cad sweep revolution turn
        set direction to directionResult's value
        set turnAngle to angle
        if turnAngle < 0.0:
            set direction to the cad negative of direction
            set turnAngle to 0.0 - turnAngle
        if ((turnAngle is finite) = false) or ((turnAngle <= 0.0) or (turnAngle > ((the radians in a full turn) + 1e-12))):
            return no cad sweep revolution turn
        set full to (the absolute value of ((the radians in a full turn) - turnAngle)) <= 1e-9
        set planeDistance to the cad distance from pivot to plane
        if (planeDistance's valid) = false:
            return no cad sweep revolution turn
        if ((the absolute value of (the cad dot of direction and (normalResult's value))) > 1e-9) or ((the absolute value of (planeDistance's value)) > 1e-9):
            return no cad sweep revolution turn
        set radialResult to the cad normalization of (the cad cross of (normalResult's value) and direction)
        if (radialResult's valid) = false:
            return no cad sweep revolution turn
        set radial to radialResult's value
        set spin to (the cad dot of (normalResult's value) and (the cad cross of direction and radial)) > 0.0
        set foundFirst to false
        set scaleOrigin to the cad zero vector3
        for each pieceItem in profile:
            if ((pieceItem's kind) != 0) and ((pieceItem's kind) != 2):
                return no cad sweep revolution turn
            if foundFirst = false:
                set scaleOrigin to the cad point at (the cad point on pieceItem at 0.0) on plane
                set foundFirst to true
        if foundFirst = false:
            return no cad sweep revolution turn
        set radialBounds to no cad sweep projection bounds
        set heightBounds to no cad sweep projection bounds
        for each piece in profile:
            set pieceRadial to cad sweep projection bounds of piece on plane from pivot along radial
            set pieceHeight to cad sweep projection bounds of piece on plane from scaleOrigin along direction
            if ((pieceRadial's valid) and (pieceHeight's valid)) = false:
                return no cad sweep revolution turn
            if radialBounds's valid:
                set radialBounds's low to the minimum of (radialBounds's low) and (pieceRadial's low)
                set radialBounds's high to the maximum of (radialBounds's high) and (pieceRadial's high)
            else:
                set radialBounds to pieceRadial
            if heightBounds's valid:
                set heightBounds's low to the minimum of (heightBounds's low) and (pieceHeight's low)
                set heightBounds's high to the maximum of (heightBounds's high) and (pieceHeight's high)
            else:
                set heightBounds to pieceHeight
        set radialMagnitude to the maximum of (the absolute value of (radialBounds's low)) and (the absolute value of (radialBounds's high))
        set profileScale to the maximum of radialMagnitude and ((heightBounds's high) - (heightBounds's low))
        set tolerance to 1e-9 * (the maximum of profileScale and 1.0)
        if profileScale <= tolerance:
            return no cad sweep revolution turn
        set reachesNegative to (radialBounds's low) < (the negative of tolerance)
        set reachesPositive to (radialBounds's high) > tolerance
        if reachesNegative and reachesPositive:
            return no cad sweep revolution turn
        if (reachesNegative or reachesPositive) = false:
            return no cad sweep revolution turn
        if reachesPositive = false:
            set radial to the cad negative of radial
            set spin to spin = false
        return @intrinsic("construct", a cad sweep revolution turn, true, pivot, direction, radial, spin, tolerance, turnAngle, full)

local function cad sweep revolution station at {cad vector2:uv} on {cad plane:plane} for {cad sweep revolution turn:turn}:
    execute:
        set offset to the cad difference of (the cad point at uv on plane) and (turn's pivot)
        return @intrinsic("construct", a cad sweep revolution station, the cad dot of offset and (turn's radial), the cad dot of offset and (turn's axis))

local function cad sweep revolution circle at {a 64 bit floating-point number:height} for {cad sweep revolution turn:turn}:
    execute:
        set centre to the cad sum of (turn's pivot) and ((turn's axis) scaled by height)
        return the cad orthonormal plane with origin centre, x axis (turn's radial) and normal (turn's axis)

local function no cad sweep revolution piece:
    execute:
        return @intrinsic("construct", a cad sweep revolution piece, false, 2, a new cad surface key, 0, false)

local function collapsed cad sweep revolution piece:
    execute:
        return @intrinsic("construct", a cad sweep revolution piece, true, 0, a new cad surface key, 0, false)

local function cad sweep revolution piece on {cad surface:surface} flat {boolean:flat} in {cad body:body}:
    execute:
        set surfaceKey to the cad body key after inserting surface into body
        return @intrinsic("construct", a cad sweep revolution piece, true, 1, surfaceKey, surface's kind, flat)

local function cad sweep revolution surface of {cad curve2:piece} on {cad plane:plane} for {cad sweep revolution turn:turn} in {cad body:body}:
    execute:
        if ((piece's kind) = 3) or ((piece's kind) = 5):
            set rationalTurn to @intrinsic("construct", a cad rational revolution turn, turn's valid, turn's pivot, turn's axis, turn's radial, turn's spin, turn's tolerance, turn's angle, turn's full)
            set made to the cad rational revolution surface of piece on plane for rationalTurn
            if made's collapsed:
                return collapsed cad sweep revolution piece
            if made's valid = false:
                return no cad sweep revolution piece
            return cad sweep revolution piece on (the cad surface of made's value) flat false in body
        set radialBounds to cad sweep projection bounds of piece on plane from (turn's pivot) along (turn's radial)
        if radialBounds's valid = false:
            return no cad sweep revolution piece
        set reachesNegative to (radialBounds's low) < (the negative of (turn's tolerance))
        set reachesPositive to (radialBounds's high) > (turn's tolerance)
        if (reachesNegative or reachesPositive) = false:
            return collapsed cad sweep revolution piece
        if (piece's kind) = 0:
            set first to cad sweep revolution station at (piece's line's start) on plane for turn
            set second to cad sweep revolution station at (piece's line's end) on plane for turn
            set frameResult to cad sweep revolution circle at (first's height) for turn
            if frameResult's valid = false:
                return no cad sweep revolution piece
            if (the absolute value of ((second's height) - (first's height))) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (frameResult's value)) flat true in body
            if (the absolute value of ((second's radius) - (first's radius))) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (a cad cylinder with base (frameResult's value) and radius (first's radius))) flat false in body
            set halfAngle to @intrinsic("call", "libc", "atan", a 64 bit floating-point number, ((first's radius) - (second's radius)) / ((second's height) - (first's height)))
            return cad sweep revolution piece on (the cad surface of (a cad cone with base (frameResult's value), radius (first's radius) and half angle halfAngle)) flat false in body
        if (piece's kind) = 2:
            set centreStation to cad sweep revolution station at (piece's arc's centre) on plane for turn
            set frameResult to cad sweep revolution circle at (centreStation's height) for turn
            if frameResult's valid = false:
                return no cad sweep revolution piece
            if (the absolute value of (centreStation's radius)) <= (turn's tolerance):
                return cad sweep revolution piece on (the cad surface of (a cad sphere with frame (frameResult's value) and radius (piece's arc's radius))) flat false in body
            return cad sweep revolution piece on (the cad surface of (a cad torus with frame (frameResult's value), major radius (the absolute value of (centreStation's radius)) and minor radius (piece's arc's radius))) flat false in body
        return no cad sweep revolution piece

local function cad sweep revolution turned {cad vector3:vector} by {a 64 bit floating-point number:angle} for {cad sweep revolution turn:turn}:
    execute:
        set cosine to the cosine of angle
        set sine to the sine of angle
        set first to vector scaled by cosine
        set second to (the cad cross of (turn's axis) and vector) scaled by sine
        set third to (turn's axis) scaled by ((the cad dot of (turn's axis) and vector) * (1.0 - cosine))
        return the cad sum of (the cad sum of first and second) and third

local function cad sweep revolution moved {cad vector3:point} by {a 64 bit floating-point number:angle} for {cad sweep revolution turn:turn}:
    execute:
        return the cad sum of (turn's pivot) and (cad sweep revolution turned (the cad difference of point and (turn's pivot)) by angle for turn)

local function no cad sweep revolved arc parameters:
    execute:
        return @intrinsic("construct", a cad sweep revolved arc parameters, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)

local function cad sweep revolved parameters of {cad arc2:arc} on {cad plane:plane} for {cad sweep revolution turn:turn}:
    execute:
        set arcSweep to the cad sweep of arc
        set midpoint to (arc's startAngle) + arcSweep * 0.5
        set offset to the cad vector at (a cad vector2 with x ((arc's radius) * (the cosine of midpoint)) and y ((arc's radius) * (the sine of midpoint))) on plane
        set tangent to the cad vector at (a cad vector2 with x ((the negative of (arc's radius)) * (the sine of midpoint)) and y ((arc's radius) * (the cosine of midpoint))) on plane
        set radial to the cad dot of offset and (turn's radial)
        set height to the cad dot of offset and (turn's axis)
        set radialTangent to the cad dot of tangent and (turn's radial)
        set heightTangent to the cad dot of tangent and (turn's axis)
        set orientation to radial * heightTangent - height * radialTangent
        if (((arcSweep is finite) and (radial is finite)) and ((height is finite) and ((orientation is finite) and (orientation != 0.0)))) = false:
            return no cad sweep revolved arc parameters
        set middleAngle to cad sweep revolution angle from height over radial
        set direction to the negative of (1.0 as a 64 bit floating-point number)
        if orientation > 0.0:
            set direction to 1.0
        set beginning to middleAngle - ((direction * arcSweep) * 0.5)
        set ending to middleAngle + ((direction * arcSweep) * 0.5)
        set centreStation to cad sweep revolution station at (arc's centre) on plane for turn
        if (centreStation's radius) < (the negative of (turn's tolerance)):
            return @intrinsic("construct", a cad sweep revolved arc parameters, true, (the radians in a half turn) as a 64 bit floating-point number, (the radians in a half turn) - beginning, (the radians in a half turn) - ending)
        return @intrinsic("construct", a cad sweep revolved arc parameters, true, 0.0 as a 64 bit floating-point number, beginning, ending)

local function cad sweep ring on {cad face key:faceKey} in {cad body:body} using {cad topology list:uses}:
    execute:
        set ringKey to the cad body key after inserting (a cad loop owned by faceKey with provenance (the synthesized cad provenance)) into body
        for each usage in (uses's values):
            set coedgeKey to the cad body key after inserting (a cad coedge on (usage's edge) forward (usage's forward) with pcurve (usage's pcurve) owned by ringKey with provenance (the synthesized cad provenance)) into body
            set edgeNode to the cad node pointer for (usage's edge) in body
            set ringNode to the cad node pointer for ringKey in body
            if (edgeNode = (0 as the type of edgeNode)) or (ringNode = (0 as the type of ringNode)):
                return false
            append coedgeKey to (edgeNode's coedges's values)
            append coedgeKey to (ringNode's coedges's values)
        set faceNode to the cad node pointer for faceKey in body
        if faceNode = (0 as the type of faceNode):
            return false
        append ringKey to (faceNode's loops's values)
        return true

local function cad sweep optional vertex at {cad vector3:point} in {cad body:body} present {boolean:present}:
    execute:
        if present:
            return @intrinsic("construct", a cad sweep optional vertex, true, cad sweep vertex at point in body)
        return @intrinsic("construct", a cad sweep optional vertex, false, a new cad vertex key)

local function cad sweep partial revolution of {a pointer to a list:profile} on {cad plane:plane} with senses {cad topology list:senses}, corners {cad topology list:corners} and stations {cad topology list:stations} for {cad sweep revolution turn:turn} handed {a 64 bit floating-point number:handed}:
    execute:
        set farPlane to a cad plane with origin (cad sweep revolution moved (plane's origin) by (turn's angle) for turn), x axis (cad sweep revolution turned (plane's xAxis) by (turn's angle) for turn) and y axis (cad sweep revolution turned (plane's yAxis) by (turn's angle) for turn)
        set body to an empty cad body
        set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
        set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
        set nearCorners to a cad topology list of a cad vertex key
        set farCorners to a cad topology list of a cad vertex key
        loop index from 0 to the length of (corners's values):
            set point to the cad point at (the item at index in (corners's values)) on plane
            append (cad sweep vertex at point in body) to (nearCorners's values)
        loop index from 0 to the length of (corners's values):
            set station to the item at index in (stations's values)
            if station's radius <= (turn's tolerance):
                append (the item at index in (nearCorners's values)) to (farCorners's values)
            else:
                set point to the cad point at (the item at index in (corners's values)) on farPlane
                append (cad sweep vertex at point in body) to (farCorners's values)
        set nearEdges to cad sweep profile edges of profile on plane with senses senses and corners nearCorners in body
        if (the length of (nearEdges's values)) != (the length of profile):
            return no cad body
        set pieces to a cad topology list of a cad sweep revolution piece
        set farEdges to a cad topology list of a cad edge key
        loop index from 0 to the length of profile:
            set piece to the item at index in profile
            set built to cad sweep revolution surface of piece on plane for turn in body
            if built's valid = false:
                return no cad body
            append built to (pieces's values)
            if built's kind = 0:
                append (the item at index in (nearEdges's values)) to (farEdges's values)
            else:
                set next to (index + 1) mod (the length of profile)
                set fromKey to the item at index in (farCorners's values)
                set toKey to the item at next in (farCorners's values)
                if (the item at index in (senses's values)) = false:
                    set fromKey to the item at next in (farCorners's values)
                    set toKey to the item at index in (farCorners's values)
                set copied to cad sweep profile edge of piece on farPlane from fromKey to toKey in body
                if copied's valid = false:
                    return no cad body
                append copied's value to (farEdges's values)
        set rails to a cad topology list of a cad sweep edge result
        loop index from 0 to the length of (stations's values):
            set station to the item at index in (stations's values)
            if station's radius <= (turn's tolerance):
                append (@intrinsic("construct", a cad sweep edge result, false, a new cad edge key)) to (rails's values)
            else:
                set frame to cad sweep revolution circle at (station's height) for turn
                if frame's valid = false:
                    return no cad body
                set curve to the cad edge curve3 of (a cad circle3 with plane (frame's value) and radius (station's radius))
                set edgeKey to cad sweep edge on curve from 0.0 to (turn's angle) between (the item at index in (nearCorners's values)) and (the item at index in (farCorners's values)) in body
                append (@intrinsic("construct", a cad sweep edge result, true, edgeKey)) to (rails's values)
        set outward to (turn's spin) = (handed > 0.0)
        if (cad sweep cap in body within shellKey on plane with edges nearEdges and senses senses forward ((turn's spin) = false) along profile (outward = false)) = false:
            return no cad body
        if (cad sweep cap in body within shellKey on farPlane with edges farEdges and senses senses forward (turn's spin) along profile outward) = false:
            return no cad body
        loop index from 0 to the length of profile:
            set pieceShape to the item at index in (pieces's values)
            if pieceShape's kind = 1:
                set next to (index + 1) mod (the length of profile)
                set piece to the item at index in profile
                set out to cad sweep outward of piece on plane forward (the item at index in (senses's values)) counterclockwise (handed > 0.0)
                set baseSample to the cad point at (the cad point on piece at 0.5) on plane
                set half to (turn's angle) * 0.5
                set samplePoint to cad sweep revolution moved baseSample by half for turn
                set sampleOut to cad sweep revolution turned out by half for turn
                set surfaceNode to the cad node pointer for (pieceShape's surface) in body
                if surfaceNode = (0 as the type of surfaceNode):
                    return no cad body
                set forwardResult to cad sweep sense of (@intrinsic("dereference", surfaceNode)) at samplePoint outward sampleOut
                if forwardResult's valid = false:
                    return no cad body
                set circuit to a cad topology list of a cad sweep use
                append (cad sweep use of (the item at index in (nearEdges's values)) forward (the item at index in (senses's values))) to (circuit's values)
                set nextRail to the item at next in (rails's values)
                if nextRail's valid:
                    append (cad sweep use of (nextRail's value) forward true) to (circuit's values)
                append (cad sweep use of (the item at index in (farEdges's values)) forward ((the item at index in (senses's values)) = false)) to (circuit's values)
                set firstRail to the item at index in (rails's values)
                if firstRail's valid:
                    append (cad sweep use of (firstRail's value) forward false) to (circuit's values)
                # The pinned partial-solid trim requires all four rational boundary uses.
                if ((pieceShape's surfaceKind) = 5) and (((nextRail's valid) = false) or ((firstRail's valid) = false)):
                    return no cad body
                if (((pieceShape's surfaceKind) = 3) or ((pieceShape's surfaceKind) = 4)) and ((piece's kind) = 2):
                    set parameters to cad sweep revolved parameters of (piece's arc) on plane for turn
                    if parameters's valid = false:
                        return no cad body
                    set start to parameters's start
                    set end to parameters's end
                    if (the item at index in (senses's values)) = false:
                        set start to parameters's end
                        set end to parameters's start
                    set near to parameters's around
                    set far to near + (turn's angle)
                    set uv to [[near,start],[near,end],[far,end],[far,start]]
                    set uvIndex to 0
                    loop useIndex from 0 to the length of (circuit's values):
                        set first to the item at uvIndex in uv
                        set last to the item at ((uvIndex + 1) mod 4) in uv
                        if (useIndex = 1) and (nextRail's valid = false):
                            increment uvIndex
                            set first to the item at uvIndex in uv
                            set last to the item at ((uvIndex + 1) mod 4) in uv
                        set p to a cad vector2 with x (the item at 0 in first) and y (the item at 1 in first)
                        set q to a cad vector2 with x (the item at 0 in last) and y (the item at 1 in last)
                        set use to the item at useIndex in (circuit's values)
                        set use's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from p to q))
                        replace item at index useIndex in (circuit's values) with use
                        increment uvIndex
                if (pieceShape's surfaceKind) = 5:
                    set start to 0.0
                    set end to 1.0
                    if (the item at index in (senses's values)) = false:
                        set start to 1.0
                        set end to 0.0
                    set uv to [[start,0.0],[end,0.0],[end,1.0],[start,1.0]]
                    set uvIndex to 0
                    loop useIndex from 0 to the length of (circuit's values):
                        set first to the item at uvIndex in uv
                        set last to the item at ((uvIndex + 1) mod 4) in uv
                        set p to a cad vector2 with x (the item at 0 in first) and y (the item at 1 in first)
                        set q to a cad vector2 with x (the item at 0 in last) and y (the item at 1 in last)
                        set use to the item at useIndex in (circuit's values)
                        set use's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from p to q))
                        replace item at index useIndex in (circuit's values) with use
                        increment uvIndex
                set reordered to cad sweep reordered circuit outward outward
                if (cad sweep face in body within shellKey on (pieceShape's surface) forward (forwardResult's value) using reordered) = false:
                    return no cad body
        set lumpNode to the cad node pointer for lumpKey in body
        append shellKey to (lumpNode's shells's values)
        append lumpKey to (body's roots)
        return the validated cad body result of body

to get the cad revolution of {a pointer to a list:profile} on {cad plane:plane} about {cad vector3:pivot} along {cad vector3:axis} by {a number:angle}:
    set ordered to the cad profile senses of profile
    if ordered's valid = false:
        return no cad body
    set senses to ordered's value
    set handed to -0.0
    set corners to a cad topology list of a cad vector2
    loop index from 0 to the length of profile:
        set piece to the item at index in profile
        set parameter to 1.0
        set area to the cad enclosed area of piece
        if the item at index in (senses's values):
            set parameter to 0.0
        else:
            set area to the negative of area
        append (the cad point on piece at parameter) to (corners's values)
        set handed to handed + area
    if (handed = 0.0) or (handed != handed):
        return no cad body
    set turn to cad sweep complete revolution turn of profile on plane about pivot along axis by (angle as a 64 bit floating-point number)
    if turn's valid = false:
        return no cad body
    set stations to a cad topology list of a cad sweep revolution station
    loop index from 0 to the length of (corners's values):
        append (cad sweep revolution station at (the item at index in (corners's values)) on plane for turn) to (stations's values)
    if turn's full = false:
        return cad sweep partial revolution of profile on plane with senses senses, corners corners and stations stations for turn handed handed
    set outward to (turn's spin) != (handed > 0.0)
    set body to an empty cad body
    set lumpKey to the cad body key after inserting (a cad lump with provenance (the synthesized cad provenance)) into body
    set shellKey to the cad body key after inserting (a cad shell owned by lumpKey with provenance (the synthesized cad provenance)) into body
    set pieces to a cad topology list of a cad sweep revolution piece
    loop index from 0 to the length of profile:
        set builtPiece to cad sweep revolution surface of (the item at index in profile) on plane for turn in body
        if builtPiece's valid = false:
            return no cad body
        append builtPiece to (pieces's values)
    set count to the length of profile
    set hasRim to a cad topology list of a boolean
    set hasSeam to a cad topology list of a boolean
    loop index from 0 to count:
        set previous to ((index + count) - 1) mod count
        set herePiece to the item at index in (pieces's values)
        set beforePiece to the item at previous in (pieces's values)
        set rimNeeded to ((the item at index in (stations's values))'s radius) > (turn's tolerance)
        set rimNeeded to rimNeeded and (((herePiece's kind) = 1) or ((beforePiece's kind) = 1))
        append rimNeeded to (hasRim's values)
        append (((herePiece's kind) = 1) and ((herePiece's flat) = false)) to (hasSeam's values)
    set vertices to a cad topology list of a cad sweep optional vertex
    loop index from 0 to count:
        set previous to ((index + count) - 1) mod count
        set needed to the item at index in (hasRim's values)
        set needed to needed or (the item at index in (hasSeam's values))
        set needed to needed or (the item at previous in (hasSeam's values))
        set point to the cad point at (the item at index in (corners's values)) on plane
        append (cad sweep optional vertex at point in body present needed) to (vertices's values)
    set rims to a cad topology list of a cad sweep edge result
    loop index from 0 to count:
        if (the item at index in (hasRim's values)) = false:
            append (@intrinsic("construct", a cad sweep edge result, false, a new cad edge key)) to (rims's values)
        else:
            set corner to the item at index in (vertices's values)
            set frameResult to cad sweep revolution circle at ((the item at index in (stations's values))'s height) for turn
            if ((corner's valid) and (frameResult's valid)) = false:
                return no cad body
            set circle to the cad edge curve3 of (a cad circle3 with plane (frameResult's value) and radius ((the item at index in (stations's values))'s radius))
            set edgeKey to cad sweep edge on circle from 0.0 to (the radians in a full turn) between (corner's value) and (corner's value) in body
            append (@intrinsic("construct", a cad sweep edge result, true, edgeKey)) to (rims's values)
    set seams to a cad topology list of a cad sweep edge result
    loop index from 0 to count:
        if (the item at index in (hasSeam's values)) = false:
            append (@intrinsic("construct", a cad sweep edge result, false, a new cad edge key)) to (seams's values)
        else:
            set next to (index + 1) mod count
            set firstCorner to the item at index in (vertices's values)
            set lastCorner to the item at next in (vertices's values)
            if ((firstCorner's valid) and (lastCorner's valid)) = false:
                return no cad body
            set fromKey to firstCorner's value
            set toKey to lastCorner's value
            if (the item at index in (senses's values)) = false:
                set fromKey to lastCorner's value
                set toKey to firstCorner's value
            set seamResult to cad sweep profile edge of (the item at index in profile) on plane from fromKey to toKey in body
            if seamResult's valid = false:
                return no cad body
            append seamResult to (seams's values)
    loop index from 0 to count:
        set pieceShape to the item at index in (pieces's values)
        if (pieceShape's kind) = 1:
            set next to (index + 1) mod count
            set sourcePiece to the item at index in profile
            set out to cad sweep outward of sourcePiece on plane forward (the item at index in (senses's values)) counterclockwise (handed > 0.0)
            set samplePoint to the cad point at (the cad point on sourcePiece at 0.5) on plane
            set halfwayOut to cad sweep revolution turned out by (the radians in a half turn) for turn
            set halfwayOn to cad sweep revolution moved samplePoint by (the radians in a half turn) for turn
            set surfaceNode to the cad node pointer for (pieceShape's surface) in body
            if surfaceNode = (0 as the type of surfaceNode):
                return no cad body
            set forwardResult to cad sweep sense of (@intrinsic("dereference", surfaceNode)) at halfwayOn outward halfwayOut
            if forwardResult's valid = false:
                return no cad body
            set faceKey to the cad body key after inserting (a cad face on (pieceShape's surface) forward (forwardResult's value) owned by shellKey with provenance (the synthesized cad provenance)) into body
            set firstRim to the item at index in (rims's values)
            set lastRim to the item at next in (rims's values)
            if pieceShape's flat:
                if (firstRim's valid) and (lastRim's valid):
                    set firstUse to a cad topology list of a cad sweep use
                    set lastUse to a cad topology list of a cad sweep use
                    append (cad sweep use of (firstRim's value) forward outward) to (firstUse's values)
                    append (cad sweep use of (lastRim's value) forward (outward = false)) to (lastUse's values)
                    if ((the item at index in (stations's values))'s radius) >= ((the item at next in (stations's values))'s radius):
                        if (cad sweep ring on faceKey in body using firstUse) = false:
                            return no cad body
                        if (cad sweep ring on faceKey in body using lastUse) = false:
                            return no cad body
                    else:
                        if (cad sweep ring on faceKey in body using lastUse) = false:
                            return no cad body
                        if (cad sweep ring on faceKey in body using firstUse) = false:
                            return no cad body
                else if firstRim's valid:
                    set uses to a cad topology list of a cad sweep use
                    append (cad sweep use of (firstRim's value) forward outward) to (uses's values)
                    if (cad sweep ring on faceKey in body using uses) = false:
                        return no cad body
                else if lastRim's valid:
                    set uses to a cad topology list of a cad sweep use
                    append (cad sweep use of (lastRim's value) forward (outward = false)) to (uses's values)
                    if (cad sweep ring on faceKey in body using uses) = false:
                        return no cad body
            else:
                set seam to the item at index in (seams's values)
                if seam's valid = false:
                    return no cad body
                set circuit to a cad topology list of a cad sweep use
                set arcParameters to no cad sweep revolved arc parameters
                if ((pieceShape's surfaceKind) = 4) and ((sourcePiece's kind) = 2):
                    set arcParameters to cad sweep revolved parameters of (sourcePiece's arc) on plane for turn
                    if arcParameters's valid = false:
                        return no cad body
                set beginning, ending, near and far to 0.0
                if arcParameters's valid:
                    set beginning to arcParameters's start
                    set ending to arcParameters's end
                    if (the item at index in (senses's values)) = false:
                        set beginning to arcParameters's end
                        set ending to arcParameters's start
                    set near to arcParameters's around
                    set far to near + (the radians in a full turn)
                set splineStart to 0.0
                set splineEnd to 1.0
                if (the item at index in (senses's values)) = false:
                    set splineStart to 1.0
                    set splineEnd to 0.0
                if firstRim's valid:
                    set usage to cad sweep use of (firstRim's value) forward true
                    if arcParameters's valid:
                        set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x near and y beginning) to (a cad vector2 with x far and y beginning)))
                    if (pieceShape's surfaceKind) = 5:
                        set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x splineStart and y 0.0) to (a cad vector2 with x splineStart and y 1.0)))
                    append usage to (circuit's values)
                set usage to cad sweep use of (seam's value) forward (the item at index in (senses's values))
                if arcParameters's valid:
                    set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x far and y beginning) to (a cad vector2 with x far and y ending)))
                if (pieceShape's surfaceKind) = 5:
                    set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x splineStart and y 1.0) to (a cad vector2 with x splineEnd and y 1.0)))
                append usage to (circuit's values)
                if lastRim's valid:
                    set usage to cad sweep use of (lastRim's value) forward false
                    if arcParameters's valid:
                        set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x far and y ending) to (a cad vector2 with x near and y ending)))
                    if (pieceShape's surfaceKind) = 5:
                        set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x splineEnd and y 1.0) to (a cad vector2 with x splineEnd and y 0.0)))
                    append usage to (circuit's values)
                set usage to cad sweep use of (seam's value) forward ((the item at index in (senses's values)) = false)
                if arcParameters's valid:
                    set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x near and y ending) to (a cad vector2 with x near and y beginning)))
                if (pieceShape's surfaceKind) = 5:
                    set usage's pcurve to the cad pcurve of (the cad curve2 of (a cad line2 from (a cad vector2 with x splineEnd and y 0.0) to (a cad vector2 with x splineStart and y 0.0)))
                append usage to (circuit's values)
                set reordered to cad sweep reordered circuit outward outward
                if (cad sweep ring on faceKey in body using reordered) = false:
                    return no cad body
            set shellNode to the cad node pointer for shellKey in body
            if shellNode = (0 as the type of shellNode):
                return no cad body
            append faceKey to (shellNode's faces's values)
    set lumpNode to the cad node pointer for lumpKey in body
    if lumpNode = (0 as the type of lumpNode):
        return no cad body
    append shellKey to (lumpNode's shells's values)
    append lumpKey to (body's roots)
    return the validated cad body result of body
