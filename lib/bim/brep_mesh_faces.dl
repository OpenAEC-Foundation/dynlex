            if (the cad triangle count of nurbsMesh) > 0:
                free cad mesh outputMesh
                return nurbsMesh
            free cad mesh nurbsMesh
    if (surfaceValue's kind is one of 3 and 4) and (cad mesh face faceValue is whole periodic in bodyValue):
        free cad mesh outputMesh
        return the cad whole surface mesh on surfaceValue forward faceValue's forward with maximum angle maxAngle within tolerance
    if surfaceValue's kind is one of 1 and 2:
        set periodicBand to the cad periodic band mesh of faceKey in bodyValue on surfaceValue forward faceValue's forward with maximum angle maxAngle within tolerance
        if periodicBand's valid:
            free cad mesh outputMesh
            return periodicBand's value
    if surfaceValue's kind = 2:
        set singularCone to the cad singular cone mesh of faceKey in bodyValue on surfaceValue forward faceValue's forward with maximum angle maxAngle within tolerance
        if singularCone's valid:
            free cad mesh outputMesh
            return singularCone's value
    set boundaryVertices to an empty list of a cad mesh boundary vertex
    set ringValues to cad mesh rings of faceKey in bodyValue within angle maxAngle and tolerance tolerance collecting boundaryVertices
    if (the length of ringValues) = 0:
        cad mesh release rings ringValues
        free boundaryVertices
        return outputMesh
    set constrainedResult to the cad constrained mesh of rings ringValues
    cad mesh release rings ringValues
    if constrainedResult's valid = false:
        free boundaryVertices
        return outputMesh
    set parameterTriangles to the cad constrained triangles of constrainedResult's value
    for each parameterTriangle in parameterTriangles:
        set firstPoint to the cad mesh point at parameterTriangle's first on surfaceValue among boundaryVertices within tolerance
        set secondPoint to the cad mesh point at parameterTriangle's second on surfaceValue among boundaryVertices within tolerance
        set thirdPoint to the cad mesh point at parameterTriangle's third on surfaceValue among boundaryVertices within tolerance
        set firstNormalResult to the cad normal of surfaceValue at parameters parameterTriangle's first's x and parameterTriangle's first's y
        set secondNormalResult to the cad normal of surfaceValue at parameters parameterTriangle's second's x and parameterTriangle's second's y
        set thirdNormalResult to the cad normal of surfaceValue at parameters parameterTriangle's third's x and parameterTriangle's third's y
        if (firstNormalResult's valid) and ((secondNormalResult's valid) and (thirdNormalResult's valid)):
            set firstNormal to firstNormalResult's value
            set secondNormal to secondNormalResult's value
            set thirdNormal to thirdNormalResult's value
            if faceValue's forward:
                cad mesh append triangle from firstPoint through secondPoint to thirdPoint with normals firstNormal secondNormal thirdNormal into (the address of outputMesh)
            else:
                cad mesh append triangle from firstPoint through thirdPoint to secondPoint with normals (the cad negative of firstNormal) (the cad negative of thirdNormal) (the cad negative of secondNormal) into (the address of outputMesh)
    free parameterTriangles
    free boundaryVertices
    free cad constrained mesh result constrainedResult
    return outputMesh

to get the cad mesh result of {cad face key:faceKey} in {cad body:bodyValue} with maximum angle {a number:requestedAngle} within {a number:requestedTolerance}:
