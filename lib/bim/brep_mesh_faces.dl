    if ((tolerance > 0.0) and ((the absolute value of tolerance) <= 1.7976931348623157e308)) = false:
        set tolerance to 1e-9
    set meshValue to the cad mesh of faceKey in bodyValue with maximum angle maxAngle within tolerance
