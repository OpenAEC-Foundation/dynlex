# Native import surface for src/brep/mesh.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Owned triangle mesh storage and basic mesh operations.
import lib/bim/brep_topology.dl

class:
    patterns:
        [a|] cad mesh triangle
    members:
        first as an integer
        second as an integer
        third as an integer

class:
    patterns:
        [a|] cad mesh
    members:
        positions
        normals
        triangles
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                abort the program
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the positions of @intrinsic("lifecycle value"))
                free (the normals of @intrinsic("lifecycle value"))
                free (the triangles of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad mesh scalar result
    members:
        valid as a boolean
        value as a 64 bit floating-point number

class:
    patterns:
        [a|] cad mesh surface properties
    members:
        area as a 64 bit floating-point number
        centroid as a cad vector3

class:
    patterns:
        [a|] cad mesh surface properties result
    members:
        valid as a boolean
        value as a cad mesh surface properties

class:
    patterns:
        [a|] cad mesh boundary vertex
    members:
        parameters as a cad vector2
        position as a cad vector3

class:
    patterns:
        [a|] cad mesh point result
    members:
        valid as a boolean
        value as a cad vector3

class:
    patterns:
        [a|] cad mesh result
    members:
        valid as a boolean
        value as a cad mesh

class:
    patterns:
        [a|] cad mesh nurbs patch
    members:
        valid as a boolean
        singular as a boolean
        low as a cad vector2
        high as a cad vector2

to get an empty cad mesh:
    set storedPositions to an empty list of a cad vector3
    set storedNormals to an empty list of a cad vector3
    set storedTriangles to an empty list of a cad mesh triangle
    allocate one slot of 0 and set storageOwner to it
    return @intrinsic("construct", a cad mesh, storedPositions, storedNormals, storedTriangles, storageOwner)

function free cad mesh {cad mesh:meshValue}:
    replacement:
        set meshValue to a new (the type of meshValue)

to get the cad triangle count of {cad mesh:meshValue}:
    return the length of meshValue's triangles

to get cad {cad mesh:meshValue} is empty:
    return (the length of meshValue's triangles) = 0

to cad mesh append triangle from {cad vector3:firstPoint} through {cad vector3:secondPoint} to {cad vector3:thirdPoint} with normals {cad vector3:firstNormal} {cad vector3:secondNormal} {cad vector3:thirdNormal} into {a pointer to a cad mesh:meshValue}:
    set baseIndex to the length of the positions of meshValue
    append firstPoint to (the positions of meshValue)
    append secondPoint to (the positions of meshValue)
    append thirdPoint to (the positions of meshValue)
    append firstNormal to (the normals of meshValue)
    append secondNormal to (the normals of meshValue)
    append thirdNormal to (the normals of meshValue)
    append (@intrinsic("construct", a cad mesh triangle, baseIndex, baseIndex + 1, baseIndex + 2)) to (the triangles of meshValue)

to absorb cad mesh {cad mesh:sourceMesh} into {a pointer to a cad mesh:destinationMesh}:
    set offset to the length of the positions of destinationMesh
    loop positionIndex from 0 to the length of sourceMesh's positions:
        append (the item at positionIndex in sourceMesh's positions) to (the positions of destinationMesh)
    loop normalIndex from 0 to the length of sourceMesh's normals:
        append (the item at normalIndex in sourceMesh's normals) to (the normals of destinationMesh)
    for each triangleValue in sourceMesh's triangles:
        append (@intrinsic("construct", a cad mesh triangle, triangleValue's first + offset, triangleValue's second + offset, triangleValue's third + offset)) to (the triangles of destinationMesh)
