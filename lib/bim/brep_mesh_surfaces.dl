# Native import surface for src/brep/mesh.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Mesh construction for swept and lofted planar surfaces.
import lib/bim/brep_mesh_data.dl
import lib/bim/planar3.dl
import lib/bim/constrained2.dl
import lib/bim/tessellation.dl

class:
    patterns:
        [a|] cad surface mesh
    members:
        mesh as a cad mesh
        edges
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                abort the program
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                set meshOwner to the owner of (the mesh of @intrinsic("lifecycle value"))
                if meshOwner != (0 as a pointer to an integer):
                    set meshReferences to the value at meshOwner
                    if meshReferences = 1:
                        free ((the mesh of @intrinsic("lifecycle value"))'s positions)
                        free ((the mesh of @intrinsic("lifecycle value"))'s normals)
                        free ((the mesh of @intrinsic("lifecycle value"))'s triangles)
                        @intrinsic("call", "libc", "free", nothing, meshOwner)
                    else:
                        store (meshReferences - 1) at meshOwner
                set edgeValues to the edges of @intrinsic("lifecycle value")
                loop edgeIndex from 0 to the length of edgeValues:
                    free (the item at edgeIndex in edgeValues)
                free edgeValues
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad surface mesh result
    members:
        valid as a boolean
        value as a cad surface mesh

function free cad surface mesh {cad surface mesh:value}:
    replacement:
        set value to a new (the type of value)

function free cad surface mesh result {cad surface mesh result:value}:
    replacement:
        set value to a new (the type of value)

local function the cad owned surface mesh from {cad mesh:meshValue} with edges {a pointer to a list:edgeValues}:
    execute:
        set nestedMeshOwner to meshValue's owner
        if nestedMeshOwner != (0 as a pointer to an integer):
            set nestedMeshReferences to the value at nestedMeshOwner
            if nestedMeshReferences = 2147483647:
                abort the program
            store (nestedMeshReferences + 1) at nestedMeshOwner
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad surface mesh, meshValue, edgeValues, storageOwner)

local function no cad surface mesh result:
    execute:
        set emptyMesh to an empty cad mesh
        set emptyEdges to an empty list of the type of (an empty list of a cad vector3)
        set surfaceValue to the cad owned surface mesh from emptyMesh with edges emptyEdges
        return @intrinsic("construct", a cad surface mesh result, false, surfaceValue)

local function append cad surface mesh triangle from {cad vector3:firstPoint} through {cad vector3:secondPoint} to {cad vector3:thirdPoint} into {a pointer to a cad mesh:meshValue}:
    execute:
        set normalResult to the cad normalization of (the cad cross of (the cad difference of secondPoint and firstPoint) and (the cad difference of thirdPoint and firstPoint))
        if normalResult's valid:
            cad mesh append triangle from firstPoint through secondPoint to thirdPoint with normals normalResult's value normalResult's value normalResult's value into meshValue

local function append cad surface mesh band from {a pointer to a list:lowerPoints} to {a pointer to a list:upperPoints} closed {boolean:closedValue} into {a pointer to a cad mesh:meshValue}:
    execute:
        set pointCount to the minimum of (the length of lowerPoints) and (the length of upperPoints)
        set spanCount to the maximum of (pointCount - 1) and 0
        if closedValue:
            set spanCount to pointCount
        loop pointIndex from 0 to spanCount:
            set nextIndex to pointIndex + 1
            if nextIndex = pointCount:
                set nextIndex to 0
            set lowerFirst to the item at pointIndex in lowerPoints
            set lowerLast to the item at nextIndex in lowerPoints
            set upperFirst to the item at pointIndex in upperPoints
            set upperLast to the item at nextIndex in upperPoints
            append cad surface mesh triangle from lowerFirst through lowerLast to upperLast into meshValue
            append cad surface mesh triangle from lowerFirst through upperLast to upperFirst into meshValue

local function append cad surface mesh cap on {cad plane:planeValue} around {a pointer to a list:ringPoints} reversed {boolean:reversedValue} into {a pointer to a cad mesh:meshValue}:
    execute:
        set parameterRing to an empty list of a cad vector2
        set validRing to true
        loop pointIndex from 0 to the length of ringPoints:
            set projected to the cad projection of (the item at pointIndex in ringPoints) onto planeValue
            if projected's valid:
                append projected's value to parameterRing
            else:
                set validRing to false
        if (validRing = false) or ((the length of parameterRing) < 3):
            free parameterRing
            return nothing
        set parameterRings to an empty list of the type of parameterRing
        append parameterRing to parameterRings
        set constrainedResult to the cad constrained mesh of rings parameterRings
        free parameterRing
        free parameterRings
        if constrainedResult's valid = false:
            free cad constrained mesh result constrainedResult
            return nothing
        set capTriangles to the cad constrained triangles of constrainedResult's value
        for each triangleValue in capTriangles:
            set firstPoint to the cad point at triangleValue's first on planeValue
            set secondPoint to the cad point at triangleValue's second on planeValue
            set thirdPoint to the cad point at triangleValue's third on planeValue
            if reversedValue:
                append cad surface mesh triangle from firstPoint through thirdPoint to secondPoint into meshValue
            else:
                append cad surface mesh triangle from firstPoint through secondPoint to thirdPoint into meshValue
        free capTriangles
        free cad constrained mesh result constrainedResult

local function cad surface mesh open samples of {cad planar curve3:curveValue} within angle {a 64 bit floating-point number:maxAngle}:
    execute:
        set pointValues to the cad angular samples of curveValue within maxAngle
        if curveValue is cad closed:
            if (the length of pointValues) > 1:
                if (the cad distance from (the item at 0 in pointValues) to (the last item of pointValues)) <= 1e-9:
                    remove the last item from pointValues
        return pointValues

local function the cad surface mesh copy of {a pointer to a list:pointValues}:
    execute:
        set copiedPoints to an empty list of a cad vector3
        loop pointIndex from 0 to the length of pointValues:
            append (the item at pointIndex in pointValues) to copiedPoints
        return copiedPoints

local function the cad surface mesh resampling of {a pointer to a list:pointValues} to {integer:requestedCount} points closed {boolean:closedValue}:
    execute:
        set chainPoints to the cad surface mesh copy of pointValues
        if closedValue and ((the length of chainPoints) > 0):
            append (the item at 0 in chainPoints) to chainPoints
        set walkedValues to a list containing 0.0
        loop pointIndex from 1 to the length of chainPoints:
            set walkedDistance to (the last item of walkedValues) + (the cad distance from (the item at (pointIndex - 1) in chainPoints) to (the item at pointIndex in chainPoints))
            append walkedDistance to walkedValues
        set outputPoints to an empty list of a cad vector3
        if (the length of walkedValues) = 0:
            free chainPoints
            free walkedValues
            return outputPoints
        set totalLength to the last item of walkedValues
        if totalLength <= 0.0:
            free outputPoints
            set outputPoints to the cad surface mesh copy of pointValues
            free chainPoints
            free walkedValues
            return outputPoints
        set divisorValue to the maximum of (requestedCount - 1) and 1
        if closedValue:
            set divisorValue to requestedCount
        loop sampleIndex from 0 to requestedCount:
            set wantedDistance to (totalLength * (sampleIndex as a 64 bit floating-point number)) / (divisorValue as a 64 bit floating-point number)
            set segmentIndex to 0
            loop while ((segmentIndex + 1) < (the length of walkedValues)) and ((the item at (segmentIndex + 1) in walkedValues) <= wantedDistance):
                set segmentIndex to segmentIndex + 1
            if segmentIndex >= ((the length of chainPoints) - 1):
                set segmentIndex to (the length of chainPoints) - 2
            set segmentLength to (the item at (segmentIndex + 1) in walkedValues) - (the item at segmentIndex in walkedValues)
            set segmentUnit to 0.0
            if segmentLength > 0.0:
                set segmentUnit to (wantedDistance - (the item at segmentIndex in walkedValues)) / segmentLength
            append (the cad lerp from (the item at segmentIndex in chainPoints) to (the item at (segmentIndex + 1) in chainPoints) at segmentUnit) to outputPoints
        free chainPoints
        free walkedValues
        return outputPoints

local function the cad surface mesh from {a pointer to a list:sectionValues} closed {boolean:closedValue}:
    execute:
        set outputMesh to an empty cad mesh
        set edgeValues to an empty list of the type of (an empty list of a cad vector3)
        loop sectionIndex from 1 to the length of sectionValues:
            append cad surface mesh band from (the item at (sectionIndex - 1) in sectionValues) to (the item at sectionIndex in sectionValues) closed closedValue into (the address of outputMesh)
        if (the length of sectionValues) = 0:
            return the cad owned surface mesh from outputMesh with edges edgeValues
        set firstSection to the cad surface mesh copy of (the item at 0 in sectionValues)
        set lastSection to the cad surface mesh copy of (the last item of sectionValues)
        if closedValue and ((the length of firstSection) > 0):
            append (the item at 0 in firstSection) to firstSection
            append (the item at 0 in lastSection) to lastSection
        append firstSection and lastSection to edgeValues
        if closedValue = false:
            set firstSide to an empty list of a cad vector3
            set lastSide to an empty list of a cad vector3
            for each sectionValue in sectionValues:
                if (the length of sectionValue) > 0:
                    append (the item at 0 in sectionValue) to firstSide
                    append (the last item of sectionValue) to lastSide
            if (the length of firstSide) >= 2:
                append firstSide to edgeValues
            else:
                free firstSide
            if (the length of lastSide) >= 2:
                append lastSide to edgeValues
            else:
                free lastSide
        return the cad owned surface mesh from outputMesh with edges edgeValues

local function free cad surface mesh sections {a pointer to a list:sectionValues}:
    execute:
        loop sectionIndex from 0 to the length of sectionValues:
            free (the item at sectionIndex in sectionValues)
        free sectionValues

to get the cad swept surface of {cad planar curve3:profileValue} along {cad planar curve3:pathValue} with maximum angle {a number:requestedAngle}:
    if pathValue is cad closed:
        return no cad surface mesh result
    set maxAngle to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
    set closedValue to profileValue is cad closed
    set outlinePoints to cad surface mesh open samples of profileValue within angle maxAngle
    set trackPoints to cad surface mesh open samples of pathValue within angle maxAngle
    if ((the length of outlinePoints) < 2) or ((the length of trackPoints) < 2):
        free outlinePoints
        free trackPoints
        return no cad surface mesh result
    set trackOrigin to the item at 0 in trackPoints
    set sectionValues to an empty list of the type of (an empty list of a cad vector3)
    loop trackIndex from 0 to the length of trackPoints:
        set shiftValue to the cad difference of (the item at trackIndex in trackPoints) and trackOrigin
        set sectionPoints to an empty list of a cad vector3
        loop outlineIndex from 0 to the length of outlinePoints:
            append (the cad sum of (the item at outlineIndex in outlinePoints) and shiftValue) to sectionPoints
        append sectionPoints to sectionValues
    set surfaceValue to the cad surface mesh from sectionValues closed closedValue
    if closedValue:
        append cad surface mesh cap on profileValue's plane around (the item at 0 in sectionValues) reversed true into (the address of surfaceValue's mesh)
        set farOrigin to the cad sum of profileValue's plane's origin and (the cad difference of (the item at ((the length of trackPoints) - 1) in trackPoints) and trackOrigin)
        set farPlane to a cad plane with origin farOrigin, x axis profileValue's plane's xAxis and y axis profileValue's plane's yAxis
        append cad surface mesh cap on farPlane around (the last item of sectionValues) reversed false into (the address of surfaceValue's mesh)
    free outlinePoints
    free trackPoints
    free cad surface mesh sections sectionValues
    return @intrinsic("construct", a cad surface mesh result, true, surfaceValue)

to get the cad lofted surface through {a pointer to a list:profileValues} with maximum angle {a number:requestedAngle}:
    if (the length of profileValues) < 2:
        return no cad surface mesh result
    set maxAngle to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
    set closedValue to true
    set sampledValues to an empty list of the type of (an empty list of a cad vector3)
    set largestCount to 0
    for each profileValue in profileValues:
        if (profileValue is cad closed) = false:
            set closedValue to false
        set sampledPoints to cad surface mesh open samples of profileValue within angle maxAngle
        set largestCount to the maximum of largestCount and (the length of sampledPoints)
        append sampledPoints to sampledValues
    if largestCount < 2:
        free cad surface mesh sections sampledValues
        return no cad surface mesh result
    loop sampledIndex from 0 to the length of sampledValues:
        if (the length of (the item at sampledIndex in sampledValues)) < 2:
            free cad surface mesh sections sampledValues
            return no cad surface mesh result
    set sectionValues to an empty list of the type of (an empty list of a cad vector3)
    loop sampledIndex from 0 to the length of sampledValues:
        append (the cad surface mesh resampling of (the item at sampledIndex in sampledValues) to largestCount points closed closedValue) to sectionValues
    set surfaceValue to the cad surface mesh from sectionValues closed closedValue
    if closedValue:
        set firstProfile to the item at 0 in profileValues
        set lastProfile to the last item of profileValues
        append cad surface mesh cap on firstProfile's plane around (the item at 0 in sectionValues) reversed true into (the address of surfaceValue's mesh)
        append cad surface mesh cap on lastProfile's plane around (the last item of sectionValues) reversed false into (the address of surfaceValue's mesh)
    free cad surface mesh sections sampledValues
    free cad surface mesh sections sectionValues
    return @intrinsic("construct", a cad surface mesh result, true, surfaceValue)
