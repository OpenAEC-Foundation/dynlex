# Native import surface for src/brep/mesh.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Silhouette extraction and affine transformation of silhouette sources.
import lib/bim/brep_mesh_wireframe.dl
import lib/bim/brep_mesh_surfaces.dl
import lib/bim/pair_index.dl
import lib/bim/brep_place.dl

class:
    patterns:
        [a|] cad silhouette side
    members:
        firstPosition as a cad vector3
        secondPosition as a cad vector3
        firstNormal as a cad vector3
        secondNormal as a cad vector3

class:
    patterns:
        [a|] cad silhouette triangle
    members:
        firstPosition as a cad vector3
        secondPosition as a cad vector3
        thirdPosition as a cad vector3
        firstNormal as a cad vector3
        secondNormal as a cad vector3
        thirdNormal as a cad vector3

class:
    patterns:
        [a|] cad open silhouette side
    members:
        active as a boolean
        firstPosition as a cad vector3
        secondPosition as a cad vector3
        normal as a cad vector3

class:
    patterns:
        [a|] cad silhouette source
    members:
        sides
        triangles
        cones
        precision as a 64 bit floating-point number
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                abort the program
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the sides of @intrinsic("lifecycle value"))
                free (the triangles of @intrinsic("lifecycle value"))
                free (the cones of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad silhouette source result
    members:
        valid as a boolean
        value as a cad silhouette source

function free cad silhouette source {cad silhouette source:value}:
    replacement:
        set value to a new (the type of value)

function free cad silhouette source result {cad silhouette source result:value}:
    replacement:
        set value to a new (the type of value)

local function the cad owned silhouette source with sides {a pointer to a list:sideValues}, triangles {a pointer to a list:triangleValues}, cones {a pointer to a list:coneValues} and precision {a 64 bit floating-point number:precisionValue}:
    execute:
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad silhouette source, sideValues, triangleValues, coneValues, precisionValue, storageOwner)

local function no cad silhouette source result:
    execute:
        set sourceValue to the cad owned silhouette source with sides (an empty list of a cad silhouette side), triangles (an empty list of a cad silhouette triangle), cones (an empty list of a cad cone silhouette) and precision 1e-12
        return @intrinsic("construct", a cad silhouette source result, false, sourceValue)

local function the cad silhouette point hash of {cad vector3:pointValue} relative to {cad vector3:originValue} within {a 64 bit floating-point number:precisionValue}:
    execute:
        set xValue to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (pointValue's x - originValue's x) / precisionValue)
        set yValue to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (pointValue's y - originValue's y) / precisionValue)
        set zValue to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (pointValue's z - originValue's z) / precisionValue)
        set boundValue to 9.0e18
        set xInteger to (the maximum of (the minimum of xValue and boundValue) and (the negative of boundValue)) as a 64 bit integer
        set yInteger to (the maximum of (the minimum of yValue and boundValue) and (the negative of boundValue)) as a 64 bit integer
        set zInteger to (the maximum of (the minimum of zValue and boundValue) and (the negative of boundValue)) as a 64 bit integer
        set hashValue to (xInteger as a 64 bit unsigned integer) bitwise xor (1469598103934665603 as a 64 bit unsigned integer)
        set hashValue to hashValue * (1099511628211 as a 64 bit unsigned integer)
        set hashValue to hashValue bitwise xor (yInteger as a 64 bit unsigned integer)
        set hashValue to hashValue * (1099511628211 as a 64 bit unsigned integer)
        set hashValue to hashValue bitwise xor (zInteger as a 64 bit unsigned integer)
        set hashValue to hashValue * (1099511628211 as a 64 bit unsigned integer)
        return hashValue as a 64 bit integer

local function cad silhouette remember side from {cad vector3:firstPosition} to {cad vector3:secondPosition} with normal {cad vector3:normalValue} in group {a 64 bit integer:groupValue} relative to {cad vector3:originValue} within {a 64 bit floating-point number:precisionValue} using {cad pair index:sideTable}, open {a pointer to a list:openValues} and output {a pointer to a list:sideValues}:
    execute:
        set firstKey to the cad silhouette point hash of firstPosition relative to originValue within precisionValue
        set secondKey to the cad silhouette point hash of secondPosition relative to originValue within precisionValue
        set storedFirst to firstPosition
        set storedSecond to secondPosition
        if firstKey > secondKey:
            set keySwap to firstKey
            set firstKey to secondKey
            set secondKey to keySwap
            set pointSwap to storedFirst
            set storedFirst to storedSecond
            set storedSecond to pointSwap
        set groupMix to (groupValue as a 64 bit unsigned integer) * (11400714819323198485 as a 64 bit unsigned integer)
        set firstKey to ((firstKey as a 64 bit unsigned integer) bitwise xor groupMix) as a 64 bit integer
        set secondKey to ((secondKey as a 64 bit unsigned integer) bitwise xor (groupMix shifted right by 1)) as a 64 bit integer
        set previousIndex to the cad pair value for key firstKey and secondKey in sideTable
        if previousIndex >= 0:
            set previousValue to the item at previousIndex in openValues
            if previousValue's active:
                append (@intrinsic("construct", a cad silhouette side, previousValue's firstPosition, previousValue's secondPosition, previousValue's normal, normalValue)) to sideValues
                set previousValue's active to false
                replace item at index previousIndex in openValues with previousValue
                return nothing
        set newIndex to the length of openValues
        append (@intrinsic("construct", a cad open silhouette side, true, storedFirst, storedSecond, normalValue)) to openValues
        put cad pair value newIndex for key firstKey and secondKey in sideTable

local function the cad silhouette normal at {integer:vertexIndex} in {cad mesh:meshValue} otherwise {cad vector3:fallbackValue}:
    execute:
        if 0 <= vertexIndex < (the length of meshValue's normals):
            set normalResult to the cad normalization of (the item at vertexIndex in meshValue's normals)
            if normalResult's valid:
                return normalResult's value
        return fallbackValue

local function the cad silhouette source from {cad mesh:meshValue} with groups {a pointer to a list:groupValues}, included {a pointer to a list:includedValues} within {a 64 bit floating-point number:requestedPrecision}:
    execute:
        set sideValues to an empty list of a cad silhouette side
        set triangleValues to an empty list of a cad silhouette triangle
        set openValues to an empty list of a cad open silhouette side
        set precisionValue to the maximum of requestedPrecision and 1e-12
        set originValue to the cad zero vector3
        if (the length of meshValue's positions) > 0:
            set originValue to the item at 0 in meshValue's positions
        set sideCapacity to ((the length of meshValue's triangles) * 3) as an integer
        set sideTable to a cad pair index with room for sideCapacity entries
        loop triangleIndex from 0 to the length of meshValue's triangles:
            if (triangleIndex < (the length of groupValues)) and (the item at triangleIndex in includedValues):
                set triangleValue to the item at triangleIndex in meshValue's triangles
                if (((triangleValue's first >= 0) and (triangleValue's second >= 0)) and (triangleValue's third >= 0)) and (((triangleValue's first < (the length of meshValue's positions)) and (triangleValue's second < (the length of meshValue's positions))) and (triangleValue's third < (the length of meshValue's positions))):
                    set firstPosition to the item at triangleValue's first in meshValue's positions
                    set secondPosition to the item at triangleValue's second in meshValue's positions
                    set thirdPosition to the item at triangleValue's third in meshValue's positions
                    set geometricResult to the cad normalization of (the cad cross of (the cad difference of secondPosition and firstPosition) and (the cad difference of thirdPosition and firstPosition))
                    if geometricResult's valid:
                        set firstNormal to the cad silhouette normal at triangleValue's first in meshValue otherwise geometricResult's value
                        set secondNormal to the cad silhouette normal at triangleValue's second in meshValue otherwise geometricResult's value
                        set thirdNormal to the cad silhouette normal at triangleValue's third in meshValue otherwise geometricResult's value
                        set firstChange to the cad length of (the cad difference of firstNormal and secondNormal)
                        set secondChange to the cad length of (the cad difference of secondNormal and thirdNormal)
                        set thirdChange to the cad length of (the cad difference of thirdNormal and firstNormal)
                        if ((firstChange > 1e-10) or (secondChange > 1e-10)) or (thirdChange > 1e-10):
                            append (@intrinsic("construct", a cad silhouette triangle, firstPosition, secondPosition, thirdPosition, firstNormal, secondNormal, thirdNormal)) to triangleValues
                        else:
                            set groupValue to the item at triangleIndex in groupValues
                            cad silhouette remember side from firstPosition to secondPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
                            cad silhouette remember side from secondPosition to thirdPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
                            cad silhouette remember side from thirdPosition to firstPosition with normal geometricResult's value in group groupValue relative to originValue within precisionValue using sideTable, open openValues and output sideValues
        free openValues
        return the cad owned silhouette source with sides sideValues, triangles triangleValues, cones (an empty list of a cad cone silhouette) and precision precisionValue

to get the cad silhouette source of {cad body mesh:meshValue}:
    set groupValues to an empty list of a 64 bit integer
    set includedValues to an empty list of a boolean
    loop triangleIndex from 0 to the length of meshValue's mesh's triangles:
        set groupValue to (0 as a 64 bit integer) - (1 as a 64 bit integer)
        set includedValue to true
        if triangleIndex < (the length of meshValue's triangleFaces):
            set triangleFace to the item at triangleIndex in meshValue's triangleFaces
            set groupValue to (the cad slot of triangleFace) as a 64 bit integer
            loop coneIndex from 0 to the length of meshValue's analyticCones:
                if (the item at coneIndex in meshValue's analyticCones)'s face = triangleFace:
                    set includedValue to false
        append groupValue to groupValues
        append includedValue to includedValues
    set sourceValue to the cad silhouette source from meshValue's mesh with groups groupValues, included includedValues within meshValue's precision
    loop coneIndex from 0 to the length of meshValue's analyticCones:
        append (the item at coneIndex in meshValue's analyticCones)'s cone to sourceValue's cones
    free groupValues
    free includedValues
    return sourceValue

to get the cad silhouette source of {cad surface mesh:meshValue} within {a number:requestedPrecision}:
    set groupValues to an empty list of a 64 bit integer
    set includedValues to an empty list of a boolean
    loop triangleIndex from 0 to the length of meshValue's mesh's triangles:
        append (0 as a 64 bit integer) to groupValues
        append true to includedValues
    set precisionValue to requestedPrecision as a 64 bit floating-point number
    if ((precisionValue > 0.0) and (precisionValue is finite)) = false:
        set precisionValue to 1e-12
    set sourceValue to the cad silhouette source from meshValue's mesh with groups groupValues, included includedValues within precisionValue
    free groupValues
    free includedValues
    return sourceValue

local function the cad cone silhouette point on {cad cone silhouette:coneValue} at angle {a 64 bit floating-point number:angleValue} and v {a 64 bit floating-point number:vValue}:
    execute:
        set radialValue to coneValue's radius - (coneValue's slope * vValue)
        set pointValue to the cad sum of coneValue's origin and (coneValue's xAxis scaled by (radialValue * (the cosine of angleValue)))
        set pointValue to the cad sum of pointValue and (coneValue's yAxis scaled by (radialValue * (the sine of angleValue)))
        return the cad sum of pointValue and (coneValue's axis scaled by vValue)

local function append cad cone silhouette {cad cone silhouette:coneValue} viewed along {cad vector3:viewValue} into {a pointer to a list:outputPoints}:
    execute:
        set sineCoefficient to the negative of (the cad dot of (the cad cross of coneValue's xAxis and coneValue's axis) and viewValue)
        set cosineCoefficient to the cad dot of (the cad cross of coneValue's yAxis and coneValue's axis) and viewValue
        set constantValue to the cad dot of ((the cad cross of coneValue's xAxis and coneValue's yAxis) scaled by coneValue's slope) and viewValue
        set amplitudeValue to the square root of ((sineCoefficient * sineCoefficient) + (cosineCoefficient * cosineCoefficient))
        set scaleValue to the maximum of amplitudeValue and (the absolute value of constantValue)
        set toleranceValue to (the maximum of scaleValue and 1.0) * 1e-12
        if (0.0 <= amplitudeValue <= (the largest 64 bit floating-point number)) = false:
            return nothing
        if (amplitudeValue <= toleranceValue) or ((the absolute value of constantValue) > (amplitudeValue + toleranceValue)):
            return nothing
        set phaseValue to @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, sineCoefficient, cosineCoefficient)
        set ratioValue to (the negative of constantValue) / amplitudeValue
        set ratioValue to ratioValue clamped between -1.0 and 1.0
        set offsetValue to @intrinsic("call", "libc", "acos", a 64 bit floating-point number, ratioValue)
        set firstAngle to phaseValue - offsetValue
        append (the cad cone silhouette point on coneValue at angle firstAngle and v coneValue's lowV) and (the cad cone silhouette point on coneValue at angle firstAngle and v coneValue's highV) to outputPoints
        if (the absolute value of offsetValue) > toleranceValue:
            set secondAngle to phaseValue + offsetValue
            append (the cad cone silhouette point on coneValue at angle secondAngle and v coneValue's lowV) and (the cad cone silhouette point on coneValue at angle secondAngle and v coneValue's highV) to outputPoints

to get the cad silhouette of {cad silhouette source:sourceValue} viewed along {cad vector3:viewDirection}:
    set outputPoints to an empty list of a cad vector3
    set viewResult to the cad normalization of viewDirection
    if viewResult's valid = false:
        return outputPoints
    set viewValue to viewResult's value
    set seedValue to the cad x axis
    if (the absolute value of viewValue's x) >= 0.8:
        set seedValue to the cad y axis
    set tangentResult to the cad normalization of (the cad cross of viewValue and seedValue)
    if tangentResult's valid = false:
        return outputPoints
    set tangentValue to tangentResult's value
    set bitangentValue to the cad cross of viewValue and tangentValue
    set perturbedValue to the cad sum of viewValue and (the cad sum of (tangentValue scaled by 1e-7) and (bitangentValue scaled by 6.180339887e-8))
    set contourResult to the cad normalization of perturbedValue
    if contourResult's valid = false:
        return outputPoints
    set contourView to contourResult's value
    for each sideValue in sourceValue's sides:
        set firstValue to the cad dot of sideValue's firstNormal and contourView
        set secondValue to the cad dot of sideValue's secondNormal and contourView
        if (firstValue >= 0.0) != (secondValue >= 0.0):
            append sideValue's firstPosition and sideValue's secondPosition to outputPoints
    for each triangleValue in sourceValue's triangles:
        set positionValues to a list containing triangleValue's firstPosition
        append triangleValue's secondPosition and triangleValue's thirdPosition to positionValues
        set normalValues to a list containing triangleValue's firstNormal
        append triangleValue's secondNormal and triangleValue's thirdNormal to normalValues
        set dotValues to an empty list of a 64 bit floating-point number
        loop vertexIndex from 0 to 3:
            append (the cad dot of (the item at vertexIndex in normalValues) and contourView) to dotValues
        set crossingValues to an empty list of a cad vector3
        loop edgeIndex from 0 to 3:
            set nextIndex to (edgeIndex + 1) mod 3
            set firstDot to the item at edgeIndex in dotValues
            set secondDot to the item at nextIndex in dotValues
            if (firstDot >= 0.0) != (secondDot >= 0.0):
                set crossingUnit to firstDot / (firstDot - secondDot)
                append (the cad lerp from (the item at edgeIndex in positionValues) to (the item at nextIndex in positionValues) at crossingUnit) to crossingValues
        if (the length of crossingValues) = 2:
            append (the item at 0 in crossingValues) and (the item at 1 in crossingValues) to outputPoints
        free positionValues
        free normalValues
        free dotValues
        free crossingValues
    loop coneIndex from 0 to the length of sourceValue's cones:
        append cad cone silhouette (the item at coneIndex in sourceValue's cones) viewed along contourView into outputPoints
    return outputPoints

local function the cad silhouette affine point {cad vector3:pointValue} with x vector {cad vector3:xVector}, y vector {cad vector3:yVector}, z vector {cad vector3:zVector} and origin {cad vector3:originValue}:
    execute:
        set movedValue to the cad sum of originValue and (xVector scaled by pointValue's x)
        set movedValue to the cad sum of movedValue and (yVector scaled by pointValue's y)
        return the cad sum of movedValue and (zVector scaled by pointValue's z)

local function the cad silhouette affine normal {cad vector3:normalValue} with x vector {cad vector3:xVector}, y vector {cad vector3:yVector} and z vector {cad vector3:zVector}:
    execute:
        set movedValue to the cad sum of (xVector scaled by normalValue's x) and (yVector scaled by normalValue's y)
        set movedValue to the cad sum of movedValue and (zVector scaled by normalValue's z)
        return the cad normalization of movedValue

to get the cad affine transformation of {cad silhouette source:sourceValue} with x vector {cad vector3:xVector}, y vector {cad vector3:yVector}, z vector {cad vector3:zVector} and origin {cad vector3:originValue}:
    if (((cad xVector is finite) and (cad yVector is finite)) and (cad zVector is finite)) and (cad originValue is finite) = false:
        return no cad silhouette source result
    set xLength to the cad length of xVector
    set yLength to the cad length of yVector
    set zLength to the cad length of zVector
    if ((xLength > 0.0) and (yLength > 0.0)) and (zLength > 0.0) = false:
        return no cad silhouette source result
    set xUnit to xVector cad divided by xLength
    set yUnit to yVector cad divided by yLength
    set zUnit to zVector cad divided by zLength
    set determinantValue to the cad dot of xUnit and (the cad cross of yUnit and zUnit)
    if (the absolute value of determinantValue) <= 1e-12:
        return no cad silhouette source result
    set normalX to (the cad cross of yUnit and zUnit) cad divided by (determinantValue * xLength)
    set normalY to (the cad cross of zUnit and xUnit) cad divided by (determinantValue * yLength)
    set normalZ to (the cad cross of xUnit and yUnit) cad divided by (determinantValue * zLength)
    set sideValues to an empty list of a cad silhouette side
    for each sideValue in sourceValue's sides:
        set firstNormalResult to the cad silhouette affine normal sideValue's firstNormal with x vector normalX, y vector normalY and z vector normalZ
        set secondNormalResult to the cad silhouette affine normal sideValue's secondNormal with x vector normalX, y vector normalY and z vector normalZ
        if (firstNormalResult's valid) and (secondNormalResult's valid):
            set firstPosition to the cad silhouette affine point sideValue's firstPosition with x vector xVector, y vector yVector, z vector zVector and origin originValue
            set secondPosition to the cad silhouette affine point sideValue's secondPosition with x vector xVector, y vector yVector, z vector zVector and origin originValue
            append (@intrinsic("construct", a cad silhouette side, firstPosition, secondPosition, firstNormalResult's value, secondNormalResult's value)) to sideValues
        else:
            free sideValues
            return no cad silhouette source result
    set triangleValues to an empty list of a cad silhouette triangle
    for each triangleValue in sourceValue's triangles:
        set firstNormalResult to the cad silhouette affine normal triangleValue's firstNormal with x vector normalX, y vector normalY and z vector normalZ
        set secondNormalResult to the cad silhouette affine normal triangleValue's secondNormal with x vector normalX, y vector normalY and z vector normalZ
        set thirdNormalResult to the cad silhouette affine normal triangleValue's thirdNormal with x vector normalX, y vector normalY and z vector normalZ
        if ((firstNormalResult's valid) and (secondNormalResult's valid)) and (thirdNormalResult's valid):
            set firstPosition to the cad silhouette affine point triangleValue's firstPosition with x vector xVector, y vector yVector, z vector zVector and origin originValue
            set secondPosition to the cad silhouette affine point triangleValue's secondPosition with x vector xVector, y vector yVector, z vector zVector and origin originValue
            set thirdPosition to the cad silhouette affine point triangleValue's thirdPosition with x vector xVector, y vector yVector, z vector zVector and origin originValue
            append (@intrinsic("construct", a cad silhouette triangle, firstPosition, secondPosition, thirdPosition, firstNormalResult's value, secondNormalResult's value, thirdNormalResult's value)) to triangleValues
        else:
            free sideValues
            free triangleValues
            return no cad silhouette source result
    set coneValues to an empty list of a cad cone silhouette
    for each coneValue in sourceValue's cones:
        set movedOrigin to the cad silhouette affine point coneValue's origin with x vector xVector, y vector yVector, z vector zVector and origin originValue
        set movedX to the cad silhouette affine point coneValue's xAxis with x vector xVector, y vector yVector, z vector zVector and origin the cad zero vector3
        set movedY to the cad silhouette affine point coneValue's yAxis with x vector xVector, y vector yVector, z vector zVector and origin the cad zero vector3
        set movedAxis to the cad silhouette affine point coneValue's axis with x vector xVector, y vector yVector, z vector zVector and origin the cad zero vector3
        append (@intrinsic("construct", a cad cone silhouette, movedOrigin, movedX, movedY, movedAxis, coneValue's radius, coneValue's slope, coneValue's lowV, coneValue's highV)) to coneValues
    set stretchValue to the square root of ((xLength * xLength) + ((yLength * yLength) + (zLength * zLength)))
    set transformedValue to the cad owned silhouette source with sides sideValues, triangles triangleValues, cones coneValues and precision (sourceValue's precision * stretchValue)
    return @intrinsic("construct", a cad silhouette source result, true, transformedValue)

to get the cad transformation of {cad silhouette source:sourceValue} by {cad placement:placeValue}:
    return the cad affine transformation of sourceValue with x vector (placeValue's xAxis), y vector (placeValue's yAxis), z vector (placeValue's zAxis) and origin (placeValue's origin)
