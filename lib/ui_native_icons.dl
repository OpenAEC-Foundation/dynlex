# SVGs are rasterized once per displayed size, then reused as coverage textures.
import lib/ui_svg_raster.dl
import lib/ui_native_shapes.dl
import lib/ui_native_icon_types.dl

to draw UI icon {C string:name} in {UI bounds:box} in {UI paint:ink} using {a pointer to UI icon cache:cache} on {graphics frame:frame}:
    if frame's drawable = false:
        return nothing
    require condition (box's width = box's height) reporting "An SVG icon requires a square viewport"
    set entry to the cached UI icon name sized (box's width) in cache
    if entry = @intrinsic("construct", a pointer to UI icon texture):
        set item to a new UI icon texture
        set item's name to name
        set item's logical size to box's width
        set item's next to cache's first
        set cache's first to storage for one slot initialized with item
        set entry to cache's first
    set size to the maximum of 1 and (((box's width * cache's scale) + 0.5) as an integer)
    if entry's texture's width != size:
        if entry's texture is loaded:
            release entry's texture
        set pixels to the coverage of SVG (the UI icon named name) at pixel size size using (cache's library)
        set resource to a graphics texture resource from (the data of pixels) with width size height size channels (1 as a 32 bit unsigned integer) in (frame's window as a pointer to DynlexGraphics)
        require condition (resource != @intrinsic("construct", a pointer to DynlexGraphicsTexture)) reporting "Uploading an SVG icon failed"
        set entry's texture to @intrinsic("construct", a graphics texture, resource as a pointer, size, size)
    draw (entry's texture) from x (box's x), y (box's y) to x (box's x + box's width), y (box's y + box's height) in color red (ink's red), green (ink's green) and blue (ink's blue) in frame

to get the cached UI icon {C string:name} sized {floating-point number:size} in {a pointer to UI icon cache:cache}:
    set entry to cache's first
    loop while entry != @intrinsic("construct", a pointer to UI icon texture):
        if (entry's name = name) and (entry's logical size = size):
            return entry
        set entry to entry's next
    return entry

to release UI icons {a pointer to UI icon cache:cache}:
    set entry to cache's first
    loop while entry != @intrinsic("construct", a pointer to UI icon texture):
        set next to entry's next
        release entry's texture
        deallocate entry
        set entry to next
    set cache's first to @intrinsic("construct", a pointer to UI icon texture)
