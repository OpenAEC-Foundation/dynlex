import std.dl
import vector.dl

class:
    patterns:
        [a|] quaternion
    members:
        w, x, y, z

function a new quaternion with w {a number:scalar}, x {a number:horizontal}, y {a number:vertical} and z {a number:depth}:
    replacement:
        @intrinsic("construct", a quaternion, scalar, horizontal, vertical, depth)

function {quaternion:left} + {a number:right}:
    execute:
        return a new quaternion with w the w of left + right, x the x of left + right, y the y of left + right and z the z of left + right

function {quaternion:left} * {a number:factor}:
    execute:
        set scalar to (the w of left) * factor
        set horizontal to (the x of left) * factor
        set vertical to (the y of left) * factor
        set depth to (the z of left) * factor
        return a new quaternion with w scalar, x horizontal, y vertical and z depth

function the string form of {quaternion:value}:
    execute:
        set result to the string form of "["
        set separator to the string form of ", "
        set result to (result + the string form of the w of value)
        set result to (result + separator)
        set result to (result + the string form of the x of value)
        set result to (result + separator)
        set result to (result + the string form of the y of value)
        set result to (result + separator)
        set result to (result + the string form of the z of value)
        set result to (result + the string form of "]")
        return result

function the identity quaternion:
    execute:
        return a new quaternion with w 1.0, x 0.0, y 0.0 and z 0.0

function the quaternion product of {quaternion:left} and {quaternion:right}:
    execute:
        set leftScalar to the w of left
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightScalar to the w of right
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set scalar to (((leftScalar * rightScalar) - (leftHorizontal * rightHorizontal)) - (leftVertical * rightVertical)) - (leftDepth * rightDepth)
        set horizontal to (((leftScalar * rightHorizontal) + (leftHorizontal * rightScalar)) + (leftVertical * rightDepth)) - (leftDepth * rightVertical)
        set vertical to (((leftScalar * rightVertical) - (leftHorizontal * rightDepth)) + (leftVertical * rightScalar)) + (leftDepth * rightHorizontal)
        set depth to (((leftScalar * rightDepth) + (leftHorizontal * rightVertical)) - (leftVertical * rightHorizontal)) + (leftDepth * rightScalar)
        return a new quaternion with w scalar, x horizontal, y vertical and z depth

function {quaternion:left} * {quaternion:right}:
    before: $ + $, $ - $
    execute:
        return the quaternion product of left and right

function the dot product of {quaternion:left} and {quaternion:right}:
    execute:
        set leftScalar to the w of left
        set leftHorizontal to the x of left
        set leftVertical to the y of left
        set leftDepth to the z of left
        set rightScalar to the w of right
        set rightHorizontal to the x of right
        set rightVertical to the y of right
        set rightDepth to the z of right
        set scalar to leftScalar * rightScalar
        set horizontal to leftHorizontal * rightHorizontal
        set vertical to leftVertical * rightVertical
        set depth to leftDepth * rightDepth
        return ((scalar + horizontal) + vertical) + depth

function the length of {quaternion:value}:
    execute:
        set squared to the dot product of value and value
        return the square root of squared

function {quaternion:value} normalized:
    execute:
        set magnitude to the length of value
        if magnitude = 0.0:
            set scalar to 1.0 as (the type of ((the w of value) / magnitude))
            set horizontal to 0.0 as (the type of ((the x of value) / magnitude))
            set vertical to 0.0 as (the type of ((the y of value) / magnitude))
            set depth to 0.0 as (the type of ((the z of value) / magnitude))
            return a new quaternion with w scalar, x horizontal, y vertical and z depth
        set scalar to (the w of value) / magnitude
        set horizontal to (the x of value) / magnitude
        set vertical to (the y of value) / magnitude
        set depth to (the z of value) / magnitude
        return a new quaternion with w scalar, x horizontal, y vertical and z depth

function the conjugate of {quaternion:value}:
    execute:
        return a new quaternion with w the w of value, x the negative of the x of value, y the negative of the y of value and z the negative of the z of value

function the inverse of {quaternion:value}:
    execute:
        set squared to the dot product of value and value
        if squared = 0.0:
            set scalar to 1.0 as (the type of ((the w of value) / squared))
            set horizontal to 0.0 as (the type of ((the x of value) / squared))
            set vertical to 0.0 as (the type of ((the y of value) / squared))
            set depth to 0.0 as (the type of ((the z of value) / squared))
            return a new quaternion with w scalar, x horizontal, y vertical and z depth
        set conjugate to the conjugate of value
        return a new quaternion with w the w of conjugate / squared, x the x of conjugate / squared, y the y of conjugate / squared and z the z of conjugate / squared

local function the half angle for {a 32 bit floating-point number:angle}:
    execute:
        return angle * (0.008726646259971648 as a 32 bit floating-point number)

local function the half angle for {a 64 bit floating-point number:angle}:
    execute:
        return angle * 0.008726646259971648

local function the half angle for {integer:angle}:
    execute:
        return (angle as a floating-point number) * 0.008726646259971648

function a quaternion for rotation around {vector:axis} by {a number:angle} degrees:
    execute:
        set unit to axis normalized
        set half to the half angle for angle
        set sine to the sine of half
        set cosine to the cosine of half
        set horizontal to (the x of unit) * sine
        set vertical to (the y of unit) * sine
        set depth to (the z of unit) * sine
        return (a new quaternion with w cosine, x horizontal, y vertical and z depth) normalized

local function a quaternion from {vector:value}:
    execute:
        set zero to 0.0 as (the type of the x of value)
        return a new quaternion with w zero, x the x of value, y the y of value and z the z of value

local function a vector from {quaternion:value}:
    execute:
        return a new vector with x the x of value, y the y of value and z the z of value

function {vector:value} rotated around {vector:axis} by {a number:angle} degrees:
    execute:
        set rotation to a quaternion for rotation around axis by angle degrees
        set point to a quaternion from value
        set inverse to the inverse of rotation
        set result to (rotation * point) * inverse
        return a vector from result

function {vector:value} rotated by {quaternion:rotation}:
    execute:
        set point to a quaternion from value
        set inverse to the inverse of rotation
        set result to (rotation * point) * inverse
        return a vector from result

function {quaternion:value} rotated around {vector:axis} by {a number:angle} degrees:
    execute:
        set rotation to a quaternion for rotation around axis by angle degrees
        return rotation * value
