# DynLex Filesystem I/O Library

import lib/std.dl

class:
    patterns:
        [a|] file action
    members:
        succeeded as boolean
        error_message as string

class:
    patterns:
        [a|] file read action
    members:
        contents as string
        succeeded as boolean
        error_message as string

class:
    patterns:
        [a|] directory enumeration
    members:
        handle as pointer
        succeeded as boolean
        error_message as string
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != @intrinsic("cast", 0, a pointer to byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_directory_retain", void, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != @intrinsic("cast", 0, a pointer to byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_directory_release", void, handle)

class:
    patterns:
        [a|] directory entry result
    members:
        succeeded as boolean
        has_entry as boolean
        name as string
        regular_file as boolean
        directory as boolean
        symbolic_link as boolean
        other as boolean
        error_message as string

class:
    patterns:
        [a|] file input stream
    members:
        handle as pointer
        succeeded as boolean
        error_message as string
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != @intrinsic("cast", 0, a pointer to byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != @intrinsic("cast", 0, a pointer to byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, handle)

class:
    patterns:
        [a|] file chunk read result
    members:
        succeeded as boolean
        data as string
        count as a word sized integer
        end_of_file as boolean
        error_message as string

class:
    patterns:
        [a|] temporary directory result
    members:
        succeeded as boolean
        directory_path as string
        error_message as string

local class:
    patterns:
        [a|] filesystem path
    members:
        data as pointer to byte
        length as a word sized integer
        storage as string
        valid as boolean

function {file action:action} succeeded:
    execute:
        return action's succeeded

function {file read action:action} succeeded:
    execute:
        return action's succeeded

function [the|] error message of {file action:action}:
    execute:
        return action's error_message

function [the|] error message of {file read action:action}:
    execute:
        return action's error_message

local function an empty filesystem error message:
    execute:
        return the string form of ""

local function clear the filesystem error:
    replacement:
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_clear_error", void)

local function the current filesystem error message:
    execute:
        set message_length to @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_error_message", a word sized integer, @intrinsic("cast", 0, a pointer to byte), @intrinsic("cast", 0, a word sized integer))
        set error_text to a new string buffer with length @intrinsic("cast", message_length, an integer)
        if message_length > @intrinsic("cast", 0, a word sized integer):
            discard @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_error_message", a word sized integer, the data of error_text, message_length + 1)
        return error_text

local function a new file action which succeeded:
    replacement:
        @intrinsic("construct", a file action, true, an empty filesystem error message)

local function a new file action which failed reporting message:
    replacement:
        @intrinsic("construct", a file action, false, message)

local function a new file action which failed:
    execute:
        return a new file action which failed reporting the current filesystem error message

local function a new file action which succeeded if outcome:
    execute:
        if outcome:
            return a new file action which succeeded
        return a new file action which failed

local function a new file read action containing contents which succeeded:
    replacement:
        @intrinsic("construct", a file read action, contents, true, an empty filesystem error message)

local function a failed file read action reporting message:
    replacement:
        @intrinsic("construct", a file read action, the string form of "", false, message)

local function a failed file read action:
    execute:
        return a failed file read action reporting the current filesystem error message

local function a failed directory enumeration reporting message:
    replacement:
        @intrinsic(
            "construct",
            a directory enumeration,
            @intrinsic("cast", 0, a pointer to byte),
            false,
            message
        )

local function a failed directory entry result reporting message:
    replacement:
        @intrinsic(
            "construct",
            a directory entry result,
            false,
            false,
            the string form of "",
            false,
            false,
            false,
            false,
            message
        )

local function a failed file input stream reporting message:
    replacement:
        @intrinsic(
            "construct",
            a file input stream,
            @intrinsic("cast", 0, a pointer to byte),
            false,
            message
        )

local function a failed file chunk read result reporting message:
    replacement:
        @intrinsic(
            "construct",
            a file chunk read result,
            false,
            the string form of "",
            @intrinsic("cast", 0, a word sized integer),
            false,
            message
        )

local function a failed temporary directory result reporting message:
    replacement:
        @intrinsic("construct", a temporary directory result, false, the string form of "", message)

local class:
    patterns:
        [a|] filesystem stream transfer
    members:
        count as a word sized integer
        end_of_file as boolean
        succeeded as boolean
        error message as string

local function a new successful filesystem stream transfer of count bytes with end state end_of_file:
    replacement:
        @intrinsic("construct", a filesystem stream transfer, count, end_of_file, true, an empty filesystem error message)

local function a failed filesystem stream transfer of count bytes reporting message:
    replacement:
        @intrinsic("construct", a filesystem stream transfer, count, false, false, message)

local function an invalid filesystem path:
    execute:
        set empty_storage to @intrinsic("construct", a string, @intrinsic("cast", 0, a pointer to byte), 0, @intrinsic("cast", 0, a pointer to integer))
        return @intrinsic("construct", a filesystem path, @intrinsic("cast", 0, a pointer to byte), @intrinsic("cast", 0, a word sized integer), empty_storage, false)

local function an invalid filesystem path error message:
    execute:
        return the string form of "Invalid filesystem path"

local function invalid file contents error message:
    execute:
        return the string form of "Invalid file contents"

local function a filesystem path for {cstring:input}:
    execute:
        if input = @intrinsic("cast", 0, a pointer to byte):
            return an invalid filesystem path
        set empty_storage to @intrinsic("construct", a string, @intrinsic("cast", 0, a pointer to byte), 0, @intrinsic("cast", 0, a pointer to integer))
        return @intrinsic("construct", a filesystem path, input, @intrinsic("cast", the length of input, a word sized integer), empty_storage, true)

local function a filesystem path for {string:input}:
    execute:
        if not input is valid:
            return an invalid filesystem path
        if input's length = 0:
            return an invalid filesystem path
        set zero_byte to @intrinsic("call", "libc", "memchr", a pointer to byte, the data of input, 0, @intrinsic("cast", input's length, a word sized integer))
        if zero_byte != @intrinsic("cast", 0, a pointer to byte):
            return an invalid filesystem path
        set storage to a new string buffer with length input's length
        discard @intrinsic("call", "libc", "memcpy", a pointer to byte, the data of storage, the data of input, @intrinsic("cast", input's length, a word sized integer))
        return @intrinsic("construct", a filesystem path, the data of storage, @intrinsic("cast", storage's length, a word sized integer), storage, true)

local function allocate a filesystem buffer with size byte_count:
    execute:
        return @intrinsic("call", "libc", "calloc", a pointer to byte, byte_count, @intrinsic("cast", 1, a word sized integer))

local function resize filesystem buffer input to size byte_count:
    execute:
        return @intrinsic("call", "libc", "realloc", a pointer to byte, input, byte_count)

local function transfer up to count bytes into buffer from stream:
    execute:
        set transferred to @intrinsic("cast", 0, a word sized integer)
        set end_of_file to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_read",
            an integer,
            stream,
            buffer,
            count,
            the address of transferred,
            the address of end_of_file
        )
        if outcome != 0:
            return a failed filesystem stream transfer of transferred bytes reporting the current filesystem error message
        return a new successful filesystem stream transfer of transferred bytes with end state (end_of_file != 0)

local function transfer count bytes from buffer to stream:
    execute:
        set transferred to @intrinsic("cast", 0, a word sized integer)
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_write",
            an integer,
            stream,
            buffer,
            count,
            the address of transferred
        )
        if outcome != 0:
            return a failed filesystem stream transfer of transferred bytes reporting the current filesystem error message
        return a new successful filesystem stream transfer of transferred bytes with end state false

local function transfer bytes from source_stream to destination_stream:
    execute:
        set buffer_size to @intrinsic("cast", 4096, a word sized integer)
        set buffer to allocate a filesystem buffer with size buffer_size
        if buffer = @intrinsic("cast", 0, a pointer to byte):
            return a failed filesystem stream transfer of 0 bytes reporting the current filesystem error message

        set transferred to @intrinsic("cast", 0, a word sized integer)
        set is_copying to true
        set succeeded to true
        set error_message to an empty filesystem error message
        loop while is_copying:
            set read_result to transfer up to buffer_size bytes into buffer from source_stream
            if not read_result's succeeded:
                set error_message to read_result's error message
                set succeeded to false
                set is_copying to false
            if is_copying and read_result's count > @intrinsic("cast", 0, a word sized integer):
                set write_result to transfer read_result's count bytes from buffer to destination_stream
                set transferred to transferred + write_result's count
                if not write_result's succeeded:
                    set error_message to write_result's error message
                    set succeeded to false
                    set is_copying to false
            if is_copying and read_result's end_of_file:
                set is_copying to false

        @intrinsic("call", "libc", "free", void, buffer)
        if succeeded:
            return a new successful filesystem stream transfer of transferred bytes with end state true
        return a failed filesystem stream transfer of transferred bytes reporting error_message

local function store {string:contents} at {filesystem path:path} with mode:
    execute:
        if not contents is valid:
            return a new file action which failed reporting invalid file contents error message
        clear the filesystem error
        set stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to byte,
            path's data,
            path's length,
            mode
        )
        if stream = @intrinsic("cast", 0, a pointer to byte):
            return a new file action which failed

        set expected to @intrinsic("cast", contents's length, a word sized integer)
        set write_result to a new successful filesystem stream transfer of 0 bytes with end state false
        if expected > @intrinsic("cast", 0, a word sized integer):
            set write_result to transfer expected bytes from the data of contents to stream
        set succeeded to write_result's succeeded and write_result's count = expected
        set error_message to an empty filesystem error message
        if not succeeded:
            set error_message to write_result's error message
        set finish_result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            stream
        )
        if finish_result != 0:
            if succeeded:
                set error_message to the current filesystem error message
            set succeeded to false
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, stream)
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, stream)
        if succeeded:
            return a new file action which succeeded
        return a new file action which failed reporting error_message

local function perform reading of path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a failed file read action reporting an invalid filesystem path error message
        clear the filesystem error
        set stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to byte,
            prepared_path's data,
            prepared_path's length,
            1
        )
        if stream = @intrinsic("cast", 0, a pointer to byte):
            return a failed file read action
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, stream)

        set capacity to @intrinsic("cast", 4096, a word sized integer)
        set maximum_length to @intrinsic("cast", the maximum string buffer length, a word sized integer)
        set length to @intrinsic("cast", 0, a word sized integer)
        set buffer to allocate a filesystem buffer with size (capacity + 1)
        if buffer = @intrinsic("cast", 0, a pointer to byte):
            set error_message to the current filesystem error message
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, stream)
            return a failed file read action reporting error_message

        set is_reading to true
        set succeeded to true
        set error_message to an empty filesystem error message
        loop while is_reading:
            set available to capacity - length
            set read_result to transfer up to available bytes into buffer + length from stream
            set length to length + read_result's count
            if not read_result's succeeded:
                set error_message to read_result's error message
                set succeeded to false
                set is_reading to false
            if is_reading and read_result's end_of_file:
                set is_reading to false
            if is_reading and length = capacity:
                if capacity = maximum_length:
                    set extra_byte to 0 as a byte
                    set extra_result to transfer up to 1 bytes into the address of extra_byte from stream
                    if not extra_result's succeeded:
                        set error_message to extra_result's error message
                        set succeeded to false
                    else:
                        if extra_result's count > @intrinsic("cast", 0, a word sized integer):
                            set error_message to the string form of "File contents exceed the maximum string length"
                            set succeeded to false
                    set is_reading to false
                else:
                    set next_capacity to maximum_length
                    if capacity <= maximum_length / 2:
                        set next_capacity to capacity * 2
                    set resized to resize filesystem buffer buffer to size (next_capacity + 1)
                    if resized = @intrinsic("cast", 0, a pointer to byte):
                        set error_message to the current filesystem error message
                        set succeeded to false
                        set is_reading to false
                    else:
                        set buffer to resized
                        set capacity to next_capacity

        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, stream)

        if not succeeded:
            @intrinsic("call", "libc", "free", void, buffer)
            return a failed file read action reporting error_message

        set result_contents to a new string buffer with length @intrinsic("cast", length, an integer)
        discard @intrinsic("call", "libc", "memcpy", a pointer to byte, the data of result_contents, buffer, length)
        @intrinsic("call", "libc", "free", void, buffer)
        return a new file read action containing result_contents which succeeded

local function perform writing of {string:contents} to path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a new file action which failed reporting an invalid filesystem path error message
        return store contents at prepared_path with 2

local function perform appending of {string:contents} to path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a new file action which failed reporting an invalid filesystem path error message
        return store contents at prepared_path with 3

local function perform deletion of path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a new file action which failed reporting an invalid filesystem path error message
        clear the filesystem error
        set result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_remove_tree",
            an integer,
            prepared_path's data,
            prepared_path's length
        )
        return a new file action which succeeded if (result = 0)

local function perform renaming of source to destination:
    execute:
        set source_path to a filesystem path for source
        set destination_path to a filesystem path for destination
        if (not source_path's valid) or (not destination_path's valid):
            return a new file action which failed reporting an invalid filesystem path error message
        clear the filesystem error
        set result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_rename",
            an integer,
            source_path's data,
            source_path's length,
            destination_path's data,
            destination_path's length
        )
        return a new file action which succeeded if (result = 0)

local function perform copying of source to destination:
    execute:
        set source_path to a filesystem path for source
        set destination_path to a filesystem path for destination
        if (not source_path's valid) or (not destination_path's valid):
            return a new file action which failed reporting an invalid filesystem path error message
        clear the filesystem error
        set source_stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to byte,
            source_path's data,
            source_path's length,
            1
        )
        if source_stream = @intrinsic("cast", 0, a pointer to byte):
            return a new file action which failed
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, source_stream)
        set staging_stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_file_open",
            a pointer to byte
        )
        if staging_stream = @intrinsic("cast", 0, a pointer to byte):
            set error_message to the current filesystem error message
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, source_stream)
            return a new file action which failed reporting error_message
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, staging_stream)

        set staged to transfer bytes from source_stream to staging_stream
        set error_message to staged's error message
        set staging_succeeded to staged's succeeded
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, source_stream)
        set staging_flush_result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            staging_stream
        )
        if staging_flush_result != 0:
            if staging_succeeded:
                set error_message to the current filesystem error message
            set staging_succeeded to false
        if not staging_succeeded:
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, staging_stream)
            return a new file action which failed reporting error_message

        set rewind_result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_rewind",
            an integer,
            staging_stream
        )
        if rewind_result != 0:
            set error_message to the current filesystem error message
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, staging_stream)
            return a new file action which failed reporting error_message

        set destination_stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to byte,
            destination_path's data,
            destination_path's length,
            2
        )
        if destination_stream = @intrinsic("cast", 0, a pointer to byte):
            set error_message to the current filesystem error message
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, staging_stream)
            return a new file action which failed reporting error_message
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", void, destination_stream)

        set succeeded to true
        set copied to transfer bytes from staging_stream to destination_stream
        if (not copied's succeeded) or (copied's count != staged's count):
            set error_message to copied's error message
            set succeeded to false
        set destination_finish_result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            destination_stream
        )
        if destination_finish_result != 0:
            if succeeded:
                set error_message to the current filesystem error message
            set succeeded to false
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, destination_stream)
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", void, staging_stream)
        if succeeded:
            return a new file action which succeeded
        return a new file action which failed reporting error_message

local function perform directory creation at path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a new file action which failed reporting an invalid filesystem path error message
        clear the filesystem error
        set result to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_create_directories",
            an integer,
            prepared_path's data,
            prepared_path's length
        )
        return a new file action which succeeded if (result = 0)

flex function read path:
    replacement:
        set the subject to perform reading of path

flex function write {string:contents} to path:
    replacement:
        set the subject to perform writing of contents to path

flex function append {string:contents} to path:
    replacement:
        set the subject to perform appending of contents to path

flex function delete path:
    replacement:
        set the subject to perform deletion of path

flex function rename source to destination:
    replacement:
        set the subject to perform renaming of source to destination

flex function copy source to destination:
    replacement:
        set the subject to perform copying of source to destination

flex function create directory at path:
    replacement:
        set the subject to perform directory creation at path

function create directory tree at path:
    execute:
        return perform directory creation at path

function remove filesystem tree at path:
    execute:
        return perform deletion of path

function open directory at path:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a failed directory enumeration reporting an invalid filesystem path error message
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_open",
            a pointer to byte,
            prepared_path's data,
            prepared_path's length
        )
        if handle = @intrinsic("cast", 0, a pointer to byte):
            return a failed directory enumeration reporting the current filesystem error message
        return @intrinsic(
            "construct",
            a directory enumeration,
            handle,
            true,
            an empty filesystem error message
        )

function read next directory entry from {directory enumeration:enumeration}:
    execute:
        if not enumeration's succeeded:
            return a failed directory entry result reporting enumeration's error_message
        set kind to 0
        set name_length to @intrinsic("cast", 0, a word sized integer)
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_next",
            an integer,
            enumeration's handle,
            the address of kind,
            the address of name_length
        )
        if outcome < 0:
            return a failed directory entry result reporting the current filesystem error message
        if outcome = 0:
            return @intrinsic(
                "construct",
                a directory entry result,
                true,
                false,
                the string form of "",
                false,
                false,
                false,
                false,
                an empty filesystem error message
            )
        if name_length > @intrinsic("cast", the maximum string buffer length, a word sized integer):
            return a failed directory entry result reporting the string form of "Directory entry name is too large"
        set name to a new string buffer with length @intrinsic("cast", name_length, an integer)
        set copied to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_copy_name",
            an integer,
            enumeration's handle,
            the data of name,
            name_length + 1
        )
        if copied != 0:
            return a failed directory entry result reporting the current filesystem error message
        return @intrinsic(
            "construct",
            a directory entry result,
            true,
            true,
            name,
            kind = 1,
            kind = 2,
            kind = 3,
            kind = 4,
            an empty filesystem error message
        )

function open file at path for streaming reads:
    execute:
        set prepared_path to a filesystem path for path
        if not prepared_path's valid:
            return a failed file input stream reporting an invalid filesystem path error message
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to byte,
            prepared_path's data,
            prepared_path's length,
            1
        )
        if handle = @intrinsic("cast", 0, a pointer to byte):
            return a failed file input stream reporting the current filesystem error message
        return @intrinsic(
            "construct",
            a file input stream,
            handle,
            true,
            an empty filesystem error message
        )

function read up to {integer:byte_limit} bytes from {file input stream:stream}:
    execute:
        if not stream's succeeded:
            return a failed file chunk read result reporting stream's error_message
        if byte_limit < 0:
            return a failed file chunk read result reporting the string form of "File read size must not be negative"
        if byte_limit > the maximum string buffer length:
            return a failed file chunk read result reporting the string form of "File read size exceeds the maximum string length"
        set requested_length to byte_limit as an integer
        set buffer to a new string buffer with length requested_length
        set read_count to @intrinsic("cast", 0, a word sized integer)
        set end_of_file to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_read",
            an integer,
            stream's handle,
            the data of buffer,
            requested_length as a word sized integer,
            the address of read_count,
            the address of end_of_file
        )
        if outcome != 0:
            return a failed file chunk read result reporting the current filesystem error message
        set contents to buffer
        if read_count < requested_length as a word sized integer:
            set contents to the substring of buffer from 0 with length read_count as an integer
        return @intrinsic(
            "construct",
            a file chunk read result,
            true,
            contents,
            read_count,
            end_of_file != 0,
            an empty filesystem error message
        )

function create a temporary directory:
    execute:
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_create",
            a pointer to byte
        )
        if handle = @intrinsic("cast", 0, a pointer to byte):
            return a failed temporary directory result reporting the current filesystem error message
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_retain",
            void,
            handle
        )
        set path_length to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_path_length",
            a word sized integer,
            handle
        )
        if path_length > @intrinsic("cast", the maximum string buffer length, a word sized integer):
            @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_filesystem_temporary_directory_release",
                void,
                handle
            )
            return a failed temporary directory result reporting the string form of "Temporary directory path is too large"
        set path to a new string buffer with length path_length as an integer
        set copied to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_copy_path",
            an integer,
            handle,
            the data of path,
            path_length + 1
        )
        set error_message to an empty filesystem error message
        if copied != 0:
            set error_message to the current filesystem error message
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_release",
            void,
            handle
        )
        if copied != 0:
            return a failed temporary directory result reporting error_message
        return @intrinsic(
            "construct",
            a temporary directory result,
            true,
            path,
            an empty filesystem error message
        )

function path is a regular file:
    execute:
        set entry to the file system entry at path
        return ((entry's succeeded) and (entry's found)) and (entry's regular file)

function path is readable:
    execute:
        set entry to the file system entry at path
        if not entry's succeeded:
            return false
        if not entry's found:
            return false
        if not entry's regular file:
            return false
        set stream to open file at path for streaming reads
        return stream's succeeded
