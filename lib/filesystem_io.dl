# DynLex Filesystem I/O Library

import lib/std.dl

class:
    patterns:
        [a|] file action
    members:
        success as a boolean
        error message as a string

class:
    patterns:
        [a|] file read action
    members:
        contents as a string
        success as a boolean
        error message as a string

class:
    patterns:
        [a|] directory enumeration
    members:
        handle as a pointer
        success as a boolean
        error message as a string
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_directory_retain", nothing, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_directory_release", nothing, handle)

class:
    patterns:
        [a|] directory entry result
    members:
        success as a boolean
        presence as a boolean
        name as a string
        regular file kind as a boolean
        directory kind as a boolean
        symbolic link kind as a boolean
        other kind as a boolean
        error message as a string

class:
    patterns:
        [a|] file input stream
    members:
        handle as a pointer
        success as a boolean
        error message as a string
    retain:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, handle)
    release:
        set handle to the handle of @intrinsic("lifecycle value")
        if handle != (0 as a pointer to a byte):
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, handle)

class:
    patterns:
        [a|] file chunk read result
    members:
        success as a boolean
        data as a string
        count as a word sized integer
        end of file as a boolean
        error message as a string

class:
    patterns:
        [a|] temporary directory result
    members:
        success as a boolean
        directory path as a string
        error message as a string

local class:
    patterns:
        [a|] filesystem path
    members:
        data as a pointer to a byte
        length as a word sized integer
        storage as a string
        validity as a boolean

local function {filesystem path:path} is invalid:
    replacement:
        the inverse of path's validity

function {file action:action} succeeded:
    execute:
        return action's success

function {file action:action} failed:
    replacement:
        the inverse of action's success

function {file read action:action} succeeded:
    execute:
        return action's success

function {file read action:action} failed:
    replacement:
        the inverse of action's success

function {directory enumeration:enumeration} succeeded:
    replacement:
        enumeration's success

function {directory enumeration:enumeration} failed:
    replacement:
        the inverse of enumeration's success

function {directory entry result:entry} lookup succeeded:
    replacement:
        entry's success

function {directory entry result:entry} lookup failed:
    replacement:
        the inverse of entry's success

function {directory entry result:entry} was found:
    replacement:
        entry's presence

function {directory entry result:entry} was absent:
    replacement:
        the inverse of entry's presence

function {directory entry result:entry} is a regular file:
    replacement:
        entry's regular file kind

function {directory entry result:entry} is not a regular file:
    replacement:
        the inverse of entry's regular file kind

function {directory entry result:entry} is a directory:
    replacement:
        entry's directory kind

function {directory entry result:entry} is a symbolic link:
    replacement:
        entry's symbolic link kind

function {directory entry result:entry} has another filesystem kind:
    replacement:
        entry's other kind

function {file input stream:stream} succeeded:
    replacement:
        stream's success

function {file input stream:stream} failed:
    replacement:
        the inverse of stream's success

function {file chunk read result:reading} succeeded:
    replacement:
        reading's success

function {file chunk read result:reading} failed:
    replacement:
        the inverse of reading's success

function {file chunk read result:reading} reached the end of file:
    replacement:
        reading's end of file

function {file chunk read result:reading} has not reached the end of file:
    replacement:
        the inverse of reading's end of file

function {temporary directory result:result} succeeded:
    replacement:
        result's success

function {temporary directory result:result} failed:
    replacement:
        the inverse of result's success

function the error message of {file action:action}:
    execute:
        return action's error message

function the error message of {file read action:action}:
    execute:
        return action's error message

local function an empty filesystem failure text:
    execute:
        return the string form of ""

local function clear the filesystem error:
    replacement:
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_clear_error", nothing)

local function the current filesystem failure text:
    execute:
        set size to @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_error_message", a word sized integer, 0 as a pointer to a byte, 0 as a word sized integer)
        set message to a new string buffer containing (size as an integer) bytes
        if size > (0 as a word sized integer):
            ignore @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_error_message", a word sized integer, the data of message, size + 1)
        return message

local function a successful file action:
    replacement:
        @intrinsic("construct", a file action, true, an empty filesystem failure text)

local function a failed file action reporting message:
    replacement:
        @intrinsic("construct", a file action, false, message)

local function a failed file action:
    execute:
        return a failed file action reporting the current filesystem failure text

local function a file action reflecting outcome:
    execute:
        if outcome:
            return a successful file action
        return a failed file action

local function a successful file read action containing contents:
    replacement:
        @intrinsic("construct", a file read action, contents, true, an empty filesystem failure text)

local function a failed file read action reporting message:
    replacement:
        @intrinsic("construct", a file read action, the string form of "", false, message)

local function a failed file read action:
    execute:
        return a failed file read action reporting the current filesystem failure text

local function a failed directory enumeration reporting message:
    replacement:
        @intrinsic(
            "construct",
            a directory enumeration,
            0 as a pointer to a byte,
            false,
            message
        )

local function a failed directory entry result reporting message:
    replacement:
        @intrinsic(
            "construct",
            a directory entry result,
            false,
            false,
            the string form of "",
            false,
            false,
            false,
            false,
            message
        )

local function a failed file input stream reporting message:
    replacement:
        @intrinsic(
            "construct",
            a file input stream,
            0 as a pointer to a byte,
            false,
            message
        )

local function a failed file chunk read result reporting message:
    replacement:
        @intrinsic(
            "construct",
            a file chunk read result,
            false,
            the string form of "",
            0 as a word sized integer,
            false,
            message
        )

local function a failed temporary directory result reporting message:
    replacement:
        @intrinsic("construct", a temporary directory result, false, the string form of "", message)

local class:
    patterns:
        [a|] filesystem stream transfer
    members:
        count as a word sized integer
        end of file as a boolean
        success as a boolean
        error message as a string

local function {filesystem stream transfer:transfer} failed:
    replacement:
        the inverse of transfer's success

local function {filesystem stream transfer:transfer} succeeded:
    replacement:
        transfer's success

local function a successful filesystem stream transfer of count bytes that reached the end of file:
    replacement:
        @intrinsic("construct", a filesystem stream transfer, count, true, true, an empty filesystem failure text)

local function a successful filesystem stream transfer of count bytes without reaching the end of file:
    replacement:
        @intrinsic("construct", a filesystem stream transfer, count, false, true, an empty filesystem failure text)

local function a failed filesystem stream transfer of count bytes reporting message:
    replacement:
        @intrinsic("construct", a filesystem stream transfer, count, false, false, message)

local function an invalid filesystem path:
    execute:
        set storage to @intrinsic("construct", a string, 0 as a pointer to a byte, 0, 0 as a pointer to an integer)
        return @intrinsic("construct", a filesystem path, 0 as a pointer to a byte, 0 as a word sized integer, storage, false)

local function an invalid filesystem path error message:
    execute:
        return the string form of "Invalid filesystem path"

local function the invalid file contents error message:
    execute:
        return the string form of "Invalid file contents"

local function a filesystem path for {C string:input}:
    execute:
        if input = (0 as a pointer to a byte):
            return an invalid filesystem path
        set storage to @intrinsic("construct", a string, 0 as a pointer to a byte, 0, 0 as a pointer to an integer)
        return @intrinsic("construct", a filesystem path, input, (the length of input) as a word sized integer, storage, true)

local function a filesystem path for {string:input}:
    execute:
        if input is invalid:
            return an invalid filesystem path
        if input's length = 0:
            return an invalid filesystem path
        set terminator to @intrinsic("call", "libc", "memchr", a pointer to a byte, the data of input, 0, input's length as a word sized integer)
        if terminator != (0 as a pointer to a byte):
            return an invalid filesystem path
        set storage to a new string buffer containing input's length bytes
        ignore @intrinsic("call", "libc", "memcpy", a pointer to a byte, the data of storage, the data of input, input's length as a word sized integer)
        return @intrinsic("construct", a filesystem path, the data of storage, storage's length as a word sized integer, storage, true)

local function a filesystem buffer of count bytes:
    execute:
        return @intrinsic("call", "libc", "calloc", a pointer to a byte, count, 1 as a word sized integer)

local function {a pointer to a byte:buffer} resized to {word sized integer:count} bytes:
    execute:
        return @intrinsic("call", "libc", "realloc", a pointer to a byte, buffer, count)

local function the result of transferring up to count bytes into buffer from stream:
    execute:
        set transferred to 0 as a word sized integer
        set ending to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_read",
            an integer,
            stream,
            buffer,
            count,
            the address of transferred,
            the address of ending
        )
        if outcome != 0:
            return a failed filesystem stream transfer of transferred bytes reporting the current filesystem failure text
        if ending != 0:
            return a successful filesystem stream transfer of transferred bytes that reached the end of file
        return a successful filesystem stream transfer of transferred bytes without reaching the end of file

local function the result of transferring count bytes from buffer to stream:
    execute:
        set transferred to 0 as a word sized integer
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_write",
            an integer,
            stream,
            buffer,
            count,
            the address of transferred
        )
        if outcome != 0:
            return a failed filesystem stream transfer of transferred bytes reporting the current filesystem failure text
        return a successful filesystem stream transfer of transferred bytes without reaching the end of file

local function the result of transferring bytes from origin to target:
    execute:
        set capacity to 4096 as a word sized integer
        set buffer to a filesystem buffer of capacity bytes
        if buffer = (0 as a pointer to a byte):
            return a failed filesystem stream transfer of 0 bytes reporting the current filesystem failure text

        set transferred to 0 as a word sized integer
        set copying to true
        set succeeded to true
        set message to an empty filesystem failure text
        loop while copying:
            set reading to the result of transferring up to capacity bytes into buffer from origin
            if reading failed:
                set message to reading's error message
                set succeeded to false
                set copying to false
            if copying and reading's count > (0 as a word sized integer):
                set writing to the result of transferring reading's count bytes from buffer to target
                set transferred to (transferred + writing's count)
                if writing failed:
                    set message to writing's error message
                    set succeeded to false
                    set copying to false
            if copying and reading's end of file:
                set copying to false

        @intrinsic("call", "libc", "free", nothing, buffer)
        if succeeded:
            return a successful filesystem stream transfer of transferred bytes that reached the end of file
        return a failed filesystem stream transfer of transferred bytes reporting message

local function the result of storing {string:contents} at {filesystem path:path} with mode:
    execute:
        if contents is invalid:
            return a failed file action reporting the invalid file contents error message
        clear the filesystem error
        set stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to a byte,
            path's data,
            path's length,
            mode
        )
        if stream = (0 as a pointer to a byte):
            return a failed file action

        set expected to contents's length as a word sized integer
        set writing to a successful filesystem stream transfer of 0 bytes without reaching the end of file
        if expected > (0 as a word sized integer):
            set writing to the result of transferring expected bytes from the data of contents to stream
        set failed to writing failed or writing's count != expected
        set message to an empty filesystem failure text
        if failed:
            set message to writing's error message
        set completion to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            stream
        )
        if completion != 0:
            if writing succeeded and writing's count = expected:
                set message to the current filesystem failure text
            set failed to true
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, stream)
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
        if failed:
            return a failed file action reporting message
        return a successful file action

local function the result of reading the file at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file read action reporting an invalid filesystem path error message
        clear the filesystem error
        set stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to a byte,
            prepared's data,
            prepared's length,
            1
        )
        if stream = (0 as a pointer to a byte):
            return a failed file read action
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, stream)

        set capacity to 4096 as a word sized integer
        set maximum to (the maximum string buffer length) as a word sized integer
        set total to 0 as a word sized integer
        set buffer to a filesystem buffer of (capacity + 1) bytes
        if buffer = (0 as a pointer to a byte):
            set message to the current filesystem failure text
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
            return a failed file read action reporting message

        set continuing to true
        set failed to false
        set message to an empty filesystem failure text
        loop while continuing:
            set available to (capacity - total)
            set chunk to (the result of transferring up to available bytes into buffer + total from stream)
            set total to (total + chunk's count)
            if chunk failed:
                set message to chunk's error message
                set failed to true
                set continuing to false
            if continuing and chunk's end of file:
                set continuing to false
            if continuing and total = capacity:
                if capacity = maximum:
                    set extra to 0 as a byte
                    set remainder to the result of transferring up to 1 bytes into the address of extra from stream
                    if remainder failed:
                        set message to remainder's error message
                        set failed to true
                    else:
                        if remainder's count > (0 as a word sized integer):
                            set message to the string form of "File contents exceed the maximum string length"
                            set failed to true
                    set continuing to false
                else:
                    set limit to maximum
                    if capacity <= maximum / 2:
                        set limit to (capacity * 2)
                    set resized to buffer resized to (limit + 1) bytes
                    if resized = (0 as a pointer to a byte):
                        set message to the current filesystem failure text
                        set failed to true
                        set continuing to false
                    else:
                        set buffer to resized
                        set capacity to limit

        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)

        if failed:
            @intrinsic("call", "libc", "free", nothing, buffer)
            return a failed file read action reporting message

        set contents to a new string buffer containing (total as an integer) bytes
        ignore @intrinsic("call", "libc", "memcpy", a pointer to a byte, the data of contents, buffer, total)
        @intrinsic("call", "libc", "free", nothing, buffer)
        return a successful file read action containing contents

local function the result of writing {string:contents} to the file at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file action reporting an invalid filesystem path error message
        return the result of storing contents at prepared with 2

local function the result of appending {string:contents} to the file at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file action reporting an invalid filesystem path error message
        return the result of storing contents at prepared with 3

local function the result of deleting the filesystem entry at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file action reporting an invalid filesystem path error message
        clear the filesystem error
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_remove_tree",
            an integer,
            prepared's data,
            prepared's length
        )
        return a file action reflecting (outcome = 0)

local function the result of renaming the filesystem entry at source to destination:
    execute:
        set origin to a filesystem path for source
        set target to a filesystem path for destination
        if origin is invalid or target is invalid:
            return a failed file action reporting an invalid filesystem path error message
        clear the filesystem error
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_rename",
            an integer,
            origin's data,
            origin's length,
            target's data,
            target's length
        )
        return a file action reflecting (outcome = 0)

local function the result of copying the filesystem entry at source to destination:
    execute:
        set origin to a filesystem path for source
        set target to a filesystem path for destination
        if origin is invalid or target is invalid:
            return a failed file action reporting an invalid filesystem path error message
        clear the filesystem error
        set input to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to a byte,
            origin's data,
            origin's length,
            1
        )
        if input = (0 as a pointer to a byte):
            return a failed file action
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, input)
        set stream to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_file_open",
            a pointer to a byte
        )
        if stream = (0 as a pointer to a byte):
            set message to the current filesystem failure text
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, input)
            return a failed file action reporting message
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, stream)

        set transfer to the result of transferring bytes from input to stream
        set message to transfer's error message
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, input)
        set flush to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            stream
        )
        if flush != 0:
            if transfer succeeded:
                set message to the current filesystem failure text
        if transfer failed or flush != 0:
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
            return a failed file action reporting message

        set rewind to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_rewind",
            an integer,
            stream
        )
        if rewind != 0:
            set message to the current filesystem failure text
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
            return a failed file action reporting message

        set output to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to a byte,
            target's data,
            target's length,
            2
        )
        if output = (0 as a pointer to a byte):
            set message to the current filesystem failure text
            @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
            return a failed file action reporting message
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_retain", nothing, output)

        set succeeded to true
        set copied to the result of transferring bytes from stream to output
        if copied failed or copied's count != transfer's count:
            set message to copied's error message
            set succeeded to false
        set completion to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_finish",
            an integer,
            output
        )
        if completion != 0:
            if succeeded:
                set message to the current filesystem failure text
            set succeeded to false
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, output)
        @intrinsic("call", "dynlex_runtime", "dynlex_filesystem_file_release", nothing, stream)
        if succeeded:
            return a successful file action
        return a failed file action reporting message

local function the result of creating a directory at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file action reporting an invalid filesystem path error message
        clear the filesystem error
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_create_directories",
            an integer,
            prepared's data,
            prepared's length
        )
        return a file action reflecting (outcome = 0)

flex function read the file at path:
    replacement:
        set the subject to the result of reading the file at path

flex function write {string:contents} to the file at path:
    replacement:
        set the subject to the result of writing contents to the file at path

flex function append {string:contents} to the file at path:
    replacement:
        set the subject to the result of appending contents to the file at path

flex function delete the filesystem entry at path:
    replacement:
        set the subject to the result of deleting the filesystem entry at path

flex function rename the filesystem entry at source to destination:
    replacement:
        set the subject to the result of renaming the filesystem entry at source to destination

flex function copy the filesystem entry at source to destination:
    replacement:
        set the subject to the result of copying the filesystem entry at source to destination

flex function create a directory at path:
    replacement:
        set the subject to the result of creating a directory at path

flex function create a directory tree at path:
    replacement:
        set the subject to the result of creating a directory at path

flex function remove the filesystem tree at path:
    replacement:
        set the subject to the result of deleting the filesystem entry at path

local function the result of opening a directory at path:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed directory enumeration reporting an invalid filesystem path error message
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_open",
            a pointer to a byte,
            prepared's data,
            prepared's length
        )
        if handle = (0 as a pointer to a byte):
            return a failed directory enumeration reporting the current filesystem failure text
        return @intrinsic(
            "construct",
            a directory enumeration,
            handle,
            true,
            an empty filesystem failure text
        )

local function the result of reading the next directory entry from {directory enumeration:enumeration}:
    execute:
        if enumeration failed:
            return a failed directory entry result reporting enumeration's error message
        set kind to 0
        set size to 0 as a word sized integer
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_next",
            an integer,
            enumeration's handle,
            the address of kind,
            the address of size
        )
        if outcome < 0:
            return a failed directory entry result reporting the current filesystem failure text
        if outcome = 0:
            return @intrinsic(
                "construct",
                a directory entry result,
                true,
                false,
                the string form of "",
                false,
                false,
                false,
                false,
                an empty filesystem failure text
            )
        if size > ((the maximum string buffer length) as a word sized integer):
            return a failed directory entry result reporting the string form of "Directory entry name is too large"
        set name to a new string buffer containing (size as an integer) bytes
        set copied to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_directory_copy_name",
            an integer,
            enumeration's handle,
            the data of name,
            size + 1
        )
        if copied != 0:
            return a failed directory entry result reporting the current filesystem failure text
        return @intrinsic(
            "construct",
            a directory entry result,
            true,
            true,
            name,
            kind = 1,
            kind = 2,
            kind = 3,
            kind = 4,
            an empty filesystem failure text
        )

local function the result of opening a file at path for streaming reads:
    execute:
        set prepared to a filesystem path for path
        if prepared is invalid:
            return a failed file input stream reporting an invalid filesystem path error message
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_open",
            a pointer to a byte,
            prepared's data,
            prepared's length,
            1
        )
        if handle = (0 as a pointer to a byte):
            return a failed file input stream reporting the current filesystem failure text
        return @intrinsic(
            "construct",
            a file input stream,
            handle,
            true,
            an empty filesystem failure text
        )

local function the result of reading up to {integer:limit} bytes from {file input stream:stream}:
    execute:
        if stream failed:
            return a failed file chunk read result reporting stream's error message
        if limit < 0:
            return a failed file chunk read result reporting the string form of "File read size must not be negative"
        if limit > the maximum string buffer length:
            return a failed file chunk read result reporting the string form of "File read size exceeds the maximum string length"
        set requested to limit as an integer
        set buffer to a new string buffer containing requested bytes
        set count to 0 as a word sized integer
        set ending to 0
        set outcome to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_file_read",
            an integer,
            stream's handle,
            the data of buffer,
            requested as a word sized integer,
            the address of count,
            the address of ending
        )
        if outcome != 0:
            return a failed file chunk read result reporting the current filesystem failure text
        set contents to buffer
        if count < requested as a word sized integer:
            set contents to the substring of buffer from 0 spanning (count as an integer) bytes
        return @intrinsic(
            "construct",
            a file chunk read result,
            true,
            contents,
            count,
            ending != 0,
            an empty filesystem failure text
        )

local function the result of creating a temporary directory:
    execute:
        set handle to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_create",
            a pointer to a byte
        )
        if handle = (0 as a pointer to a byte):
            return a failed temporary directory result reporting the current filesystem failure text
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_retain",
            nothing,
            handle
        )
        set size to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_path_length",
            a word sized integer,
            handle
        )
        if size > ((the maximum string buffer length) as a word sized integer):
            @intrinsic(
                "call",
                "dynlex_runtime",
                "dynlex_filesystem_temporary_directory_release",
                nothing,
                handle
            )
            return a failed temporary directory result reporting the string form of "Temporary directory path is too large"
        set path to a new string buffer containing (size as an integer) bytes
        set copied to @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_copy_path",
            an integer,
            handle,
            the data of path,
            size + 1
        )
        set message to an empty filesystem failure text
        if copied != 0:
            set message to the current filesystem failure text
        @intrinsic(
            "call",
            "dynlex_runtime",
            "dynlex_filesystem_temporary_directory_release",
            nothing,
            handle
        )
        if copied != 0:
            return a failed temporary directory result reporting message
        return @intrinsic(
            "construct",
            a temporary directory result,
            true,
            path,
            an empty filesystem failure text
        )

flex function open the directory at path:
    replacement:
        set the subject to the result of opening a directory at path

flex function read the next directory entry from {directory enumeration:enumeration}:
    replacement:
        set the subject to the result of reading the next directory entry from enumeration

flex function open the file at path for streaming reads:
    replacement:
        set the subject to the result of opening a file at path for streaming reads

flex function read up to {integer:limit} bytes from {file input stream:stream}:
    replacement:
        set the subject to the result of reading up to limit bytes from stream

flex function create a temporary directory:
    replacement:
        set the subject to the result of creating a temporary directory
