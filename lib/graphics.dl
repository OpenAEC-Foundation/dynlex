# DynLex cross-platform graphics library.
#
# Native executables use Vulkan on Windows and Linux and Vulkan through
# MoltenVK on macOS. Browser shader previews use WebGPU. GLFW is an internal
# native window and Vulkan-surface dependency; it is not part of this API.

import lib/std.dl
import lib/texture.dl
import lib/graphics_window.dl
import lib/graphics_native_types.dl
import lib/graphics_transform.dl
import lib/graphics_mesh.dl
import lib/graphics_frames.dl
import lib/graphics_shader_drawing.dl
import lib/graphics_pipelines.dl
import lib/graphics_context.dl

# Key values follow the stable GLFW input ABI used inside the native runtime.
# Naming them by user intent keeps the window-system implementation private.

function the escape key:
	replacement:
		256

function the A key:
	replacement:
		65

function the D key:
	replacement:
		68

function the E key:
	replacement:
		69

function the Q key:
	replacement:
		81

function the S key:
	replacement:
		83

function the W key:
	replacement:
		87

function the 0 key:
	replacement:
		48

function the 1 key:
	replacement:
		49

function the 2 key:
	replacement:
		50

function the 3 key:
	replacement:
		51

function the 4 key:
	replacement:
		52

function the 5 key:
	replacement:
		53

function the 6 key:
	replacement:
		54

function the 7 key:
	replacement:
		55

function the 8 key:
	replacement:
		56

function the 9 key:
	replacement:
		57

function the right arrow key:
	replacement:
		262

function the left arrow key:
	replacement:
		263

function the down arrow key:
	replacement:
		264

function the up arrow key:
	replacement:
		265

class:
	patterns:
		[a|] cursor position
	members:
		x as a floating-point number
		y as a floating-point number

class:
	patterns:
		[a|] mouse button
	members:
		number as an integer

class:
	patterns:
		[a|] graphics frame
	members:
		window as a pointer
		drawable as a boolean

class:
	patterns:
		[a|] shader program
	members:
		resource as a pointer

local function a graphics frame for {pointer:window} in drawable state {boolean:drawable}:
	replacement:
		@intrinsic("construct", a graphics frame, window, drawable)

local function a shader program with resource {pointer:resource}:
	replacement:
		@intrinsic("construct", a shader program, resource)

function the left mouse button:
	execute:
		return @intrinsic("construct", a mouse button, 0)

function the right mouse button:
	execute:
		return @intrinsic("construct", a mouse button, 1)

function the middle mouse button:
	execute:
		return @intrinsic("construct", a mouse button, 2)

function a mouse button numbered {integer:number}:
	execute:
		return @intrinsic("construct", a mouse button, number)

local function [the GLFW window of] {pointer:window}:
	execute:
		set state to window as a pointer to DynlexGraphics
		return state's window

local function [the initialized graphics window at] {a pointer to DynlexGraphics:state}:
	execute:
		create the Vulkan graphics context in state
		create the built-in graphics pipelines in state
		set state's projection to an identity graphics matrix
		set state's camera to an identity graphics matrix
		set state's model to an identity graphics matrix
		set graphics vertex color to red 255 green 255 blue 255 alpha 255 in state
		return state as a pointer

function a new window with width {integer:width} and height {integer:height}:
	execute:
		set resource to a graphics window resource with width width height height visible true fullscreen false
		return the initialized graphics window at resource

function a new hidden window with width {integer:width} and height {integer:height}:
	execute:
		set resource to a graphics window resource with width width height height visible false fullscreen false
		return the initialized graphics window at resource

function a new fullscreen window:
	execute:
		set resource to a graphics window resource with width 0 height 0 visible true fullscreen true
		return the initialized graphics window at resource

function close [the|] {pointer:window}:
	execute:
		release all graphics meshes in (window as a pointer to DynlexGraphics)
		release all graphics textures in (window as a pointer to DynlexGraphics)
		release all graphics pipelines in (window as a pointer to DynlexGraphics)
		destroy the Vulkan graphics context in (window as a pointer to DynlexGraphics)
		destroy graphics window resource (window as a pointer to DynlexGraphics)

function set the title of {pointer:window} to {C string:title}:
	execute:
		@intrinsic("call", "glfw", "glfwSetWindowTitle", nothing, the GLFW window of window, title)

function show {pointer:window}:
	execute:
		@intrinsic("call", "glfw", "glfwShowWindow", nothing, the GLFW window of window)

function hide {pointer:window}:
	execute:
		@intrinsic("call", "glfw", "glfwHideWindow", nothing, the GLFW window of window)

function {pointer:window} is visible:
	execute:
		return @intrinsic("call", "glfw", "glfwGetWindowAttrib", an integer, the GLFW window of window, 131076) != 0

function the cursor position of {pointer:window}:
	execute:
		set x to 0.0 as a floating-point number
		set y to 0.0 as a floating-point number
		@intrinsic("call", "glfw", "glfwGetCursorPos", nothing, the GLFW window of window, the address of x, the address of y)
		return @intrinsic("construct", a cursor position, x, y)

function {mouse button:button} is pressed in {pointer:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetMouseButton", an integer, the GLFW window of window, button's number) != 0

function {mouse button:button} is released in {pointer:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetMouseButton", an integer, the GLFW window of window, button's number) = 0

function capture the mouse cursor in {pointer:window}:
	execute:
		@intrinsic("call", "glfw", "glfwSetInputMode", nothing, the GLFW window of window, 208897, 212995)

function release the mouse cursor in {pointer:window}:
	execute:
		@intrinsic("call", "glfw", "glfwSetInputMode", nothing, the GLFW window of window, 208897, 212993)

function preserve mouse clicks in {pointer:window}:
	execute:
		@intrinsic("call", "glfw", "glfwSetInputMode", nothing, the GLFW window of window, 208899, 1)

function [set the application state of] {pointer:window} [to] {pointer:data}:
	execute:
		set state to window as a pointer to DynlexGraphics
		set state's application_state to data

function [the application state of] {pointer:window}:
	execute:
		set state to window as a pointer to DynlexGraphics
		return state's application_state

local function [set the graphics scroll handler in] {a pointer to DynlexGraphics:context} [to] {pointer:handler}:
	execute:
		set context's scroll_callback to handler

flex function register the graphics scroll callback named {fixed C string:callback} [of|for] {pointer:window}:
	replacement:
		set the graphics scroll handler in (window as a pointer to DynlexGraphics) to ((the function named callback) as a pointer)

function key {integer:number} is down in {pointer:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetKey", an integer, the GLFW window of window, number) != 0

function key {integer:number} is up in {pointer:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetKey", an integer, the GLFW window of window, number) = 0

function {pointer:window} should close:
	execute:
		return @intrinsic("call", "glfw", "glfwWindowShouldClose", an integer, the GLFW window of window) != 0

function {pointer:window} remains open:
	execute:
		return @intrinsic("call", "glfw", "glfwWindowShouldClose", an integer, the GLFW window of window) = 0

function request that {pointer:window} close:
	execute:
		@intrinsic("call", "glfw", "glfwSetWindowShouldClose", nothing, the GLFW window of window, 1)

function the framebuffer width of {pointer:window}:
	execute:
		set horizontal to 0
		set vertical to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", nothing, the GLFW window of window, the address of horizontal, the address of vertical)
		return horizontal

function the framebuffer height of {pointer:window}:
	execute:
		set horizontal to 0
		set vertical to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", nothing, the GLFW window of window, the address of horizontal, the address of vertical)
		return vertical

function the time since start for {pointer:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetTime", a floating-point number)

function the Vulkan API version of {pointer:window}:
	execute:
		set state to window as a pointer to DynlexGraphics
		return state's physical_properties' apiVersion

function Vulkan portability is enabled for {pointer:window}:
	execute:
		set state to window as a pointer to DynlexGraphics
		return state's portability_enabled

function the graphics device name of {pointer:window}:
	execute:
		set state to window as a pointer to DynlexGraphics
		return the string form of ((state's physical_properties' deviceName + 0) as a C string)

function a new graphics frame in {pointer:window}:
	execute:
		return a new graphics frame in window with background red 0.0, green 0.0, blue 0.0 and alpha 1.0

function a new graphics frame in {pointer:window} with background red {floating-point number:red}, green {floating-point number:green}, blue {floating-point number:blue} and alpha {floating-point number:alpha}:
	execute:
		set drawable to begin a Vulkan frame cleared to red red green green blue blue alpha alpha in (window as a pointer to DynlexGraphics)
		return a graphics frame for window in drawable state drawable

flex function display {graphics frame:frame}:
	replacement:
		if frame's drawable:
			present the Vulkan frame in (frame's window as a pointer to DynlexGraphics)
		else:
			@intrinsic("call", "glfw", "glfwPollEvents", nothing)
		set frame's drawable to false

function use screen coordinates in {graphics frame:frame}:
	execute:
		if frame's drawable:
			set width to the framebuffer width of frame's window
			set height to the framebuffer height of frame's window
			set state to frame's window as a pointer to DynlexGraphics
			set state's projection to a graphics orthographic projection from left 0.0 right (width as a floating-point number) top 0.0 bottom (height as a floating-point number) near -1.0 far 1.0

function use perspective with a vertical field of view of {floating-point number:angle} degrees, a near plane of {floating-point number:near} and a far plane of {floating-point number:far} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			set state to frame's window as a pointer to DynlexGraphics
			set extent to state's swapchain_extent
			set aspect to (extent's width as a floating-point number) / (extent's height as a floating-point number)
			set state's projection to a graphics perspective projection with angle angle aspect aspect near near far far

function enable depth testing in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set state's depth_testing to true

function disable depth testing in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set state's depth_testing to false

function reset the camera in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set state's camera to an identity graphics matrix

function move the camera in {graphics frame:frame} by x {floating-point number:horizontal}, y {floating-point number:vertical} and z {floating-point number:depth}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set translation to a graphics translation by x horizontal y vertical z depth
		set state's camera to the graphics product of state's camera and translation

function rotate the camera in {graphics frame:frame} by {floating-point number:angle} degrees around x {floating-point number:horizontal}, y {floating-point number:vertical} and z {floating-point number:depth}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set rotation to a graphics rotation of angle degrees around x horizontal y vertical z depth
		set state's camera to the graphics product of state's camera and rotation

function reset the model in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set state's model to an identity graphics matrix

function move the model in {graphics frame:frame} by x {floating-point number:horizontal}, y {floating-point number:vertical} and z {floating-point number:depth}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set translation to a graphics translation by x horizontal y vertical z depth
		set state's model to the graphics product of state's model and translation

function [scale the model in] {graphics frame:frame} [by x] {floating-point number:horizontal}[, y] {floating-point number:vertical} [and z] {floating-point number:depth}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set scale to a graphics scale by x horizontal y vertical z depth
		set state's model to the graphics product of state's model and scale

function rotate the model in {graphics frame:frame} by {floating-point number:angle} degrees around x {floating-point number:horizontal}, y {floating-point number:vertical} and z {floating-point number:depth}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		set rotation to a graphics rotation of angle degrees around x horizontal y vertical z depth
		set state's model to the graphics product of state's model and rotation

function save the model transform in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		require condition (state's model_stack_size < (the length of state's model_stack)) reporting "The graphics model transform stack is full"
		store state's model into state's model_stack at state's model_stack_size
		set state's model_stack_size to state's model_stack_size + 1

function restore the model transform in {graphics frame:frame}:
	execute:
		set state to frame's window as a pointer to DynlexGraphics
		require condition (state's model_stack_size > 0) reporting "The graphics model transform stack is empty"
		set state's model_stack_size to state's model_stack_size - 1
		set state's model to the item at state's model_stack_size in state's model_stack

function draw a rectangle at x {a value:horizontal} and y {a value:vertical} with width {a value:width} and height {a value:height} in color red {integer:red}, green {integer:green} and blue {integer:blue} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			draw a graphics quad from left (horizontal as a floating-point number) top (vertical as a floating-point number) right ((horizontal + width) as a floating-point number) bottom ((vertical + height) as a floating-point number) with texture (0 as a pointer to DynlexGraphicsTexture) tinted red red green green blue blue in (frame's window as a pointer to DynlexGraphics)

function draw {graphics texture:texture} from x {a value:left}, y {a value:top} to x {a value:right}, y {a value:bottom} in color red {integer:red}, green {integer:green} and blue {integer:blue} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			require condition (texture is loaded) reporting "Drawing a textured rectangle requires a loaded texture"
			draw a graphics quad from left (left as a floating-point number) top (top as a floating-point number) right (right as a floating-point number) bottom (bottom as a floating-point number) with texture (texture's resource as a pointer to DynlexGraphicsTexture) tinted red red green green blue blue in (frame's window as a pointer to DynlexGraphics)

function start triangles in {graphics frame:frame}:
	execute:
		if frame's drawable:
			begin a graphics triangle stream with texture (0 as a pointer to DynlexGraphicsTexture) in (frame's window as a pointer to DynlexGraphics)

function start triangles using {graphics texture:texture} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			require condition (texture is loaded) reporting "Textured triangles require a loaded texture"
			begin a graphics triangle stream with texture (texture's resource as a pointer to DynlexGraphicsTexture) in (frame's window as a pointer to DynlexGraphics)

function use vertex color red {integer:red}, green {integer:green} and blue {integer:blue} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			set graphics vertex color to red red green green blue blue alpha 255 in (frame's window as a pointer to DynlexGraphics)

function use texture coordinates x {floating-point number:horizontal} and y {floating-point number:vertical} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			set graphics texture coordinates to x horizontal y vertical in (frame's window as a pointer to DynlexGraphics)

function add a vertex at x {a value:horizontal} and y {a value:vertical} to {graphics frame:frame}:
	execute:
		if frame's drawable:
			append a graphics vertex at x (horizontal as a floating-point number) y (vertical as a floating-point number) z 0.0 in (frame's window as a pointer to DynlexGraphics)

function add a vertex at x {a value:horizontal}, y {a value:vertical} and z {a value:depth} to {graphics frame:frame}:
	execute:
		if frame's drawable:
			append a graphics vertex at x (horizontal as a floating-point number) y (vertical as a floating-point number) z (depth as a floating-point number) in (frame's window as a pointer to DynlexGraphics)

function finish triangles in {graphics frame:frame}:
	execute:
		if frame's drawable:
			finish the graphics triangle stream in (frame's window as a pointer to DynlexGraphics)

function a shader program for {pointer:window} using vertex shader at {C string:vertex} and fragment shader at {C string:fragment}:
	execute:
		set resource to a custom graphics pipeline using vertex file vertex and fragment file fragment in (window as a pointer to DynlexGraphics)
		return a shader program with resource (resource as a pointer)

function use {shader program:program} in {graphics frame:frame}:
	execute:
		if frame's drawable:
			set state to frame's window as a pointer to DynlexGraphics
			set pipeline to program's resource as a pointer to DynlexGraphicsPipeline
			if pipeline != (0 as a pointer to DynlexGraphicsPipeline):
				require condition (pipeline's owner = state) reporting "The shader pipeline belongs to a different window"
			set state's active_pipeline to pipeline

function set uniform binding {integer:binding} in {graphics frame:frame} to value:
	execute:
		if frame's drawable:
			set graphics uniform binding binding to value in (frame's window as a pointer to DynlexGraphics)

function draw a fullscreen surface in {graphics frame:frame}:
	execute:
		if frame's drawable:
			draw a fullscreen graphics shader in (frame's window as a pointer to DynlexGraphics)

flex function release {shader program:program}:
	replacement:
		if program's resource != 0 as a pointer to a byte:
			release the custom graphics pipeline (program's resource as a pointer to DynlexGraphicsPipeline)
		set program's resource to 0 as a pointer to a byte
