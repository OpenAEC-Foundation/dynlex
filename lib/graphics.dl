# DynLex Graphics Library (GLFW + OpenGL)

import lib/std.dl

# GL constants
# GL_COLOR_BUFFER_BIT = 0x4000 = 16384
# GL_PROJECTION = 0x1701 = 5889
# GL_MODELVIEW = 0x1700 = 5888
# GLFW_PRESS = 1
# GLFW_KEY_ESCAPE = 256
# GLFW_KEY_RIGHT = 262
# GLFW_KEY_LEFT = 263
# GLFW_KEY_DOWN = 264
# GLFW_KEY_UP = 265

class:
	patterns:
		glfw video mode
	members:
		width as i32
		height as i32
		red_bits as i32
		green_bits as i32
		blue_bits as i32
		refresh_rate as i32

exposed function resize the graphics viewport of {cstring:raw_window} to {integer:width} and {integer:height}:
	execute:
		@intrinsic("call", "GL", "glViewport", void, 0, 0, width, height)

function register [the|] graphics viewport resize callback [of|for] window:
	execute:
		discard @intrinsic("call", "glfw", "glfwSetFramebufferSizeCallback", a pointer to a byte, window, the function named "resize the graphics viewport of $ to $ and $")

function a new window with width w and height h:
	execute:
		set glfw_initialized to @intrinsic("call", "glfw", "glfwInit", an integer)
		if glfw_initialized = 0:
			print "failed to initialize GLFW" as line
			return 0 as a pointer to byte
		# Request OpenGL 4.6 compatibility profile (needed for SPIR-V shader support)
		# GLFW_CONTEXT_VERSION_MAJOR = 0x00022002 = 139266
		# GLFW_CONTEXT_VERSION_MINOR = 0x00022003 = 139267
		# GLFW_OPENGL_PROFILE = 0x00022008 = 139272
		# GLFW_OPENGL_COMPAT_PROFILE = 0x00032002 = 204802
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139266, 4)
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139267, 6)
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139272, 204802)
		set new_window to @intrinsic("call", "glfw", "glfwCreateWindow", a pointer to a byte, w, h, "DynLex", 0 as a pointer to a byte, 0 as a pointer to a byte)
		if new_window = 0 as a pointer to byte:
			print "failed to create GLFW window with OpenGL 4.6 compatibility profile" as line
			@intrinsic("call", "glfw", "glfwTerminate", void)
			return 0 as a pointer to byte
		@intrinsic("call", "glfw", "glfwMakeContextCurrent", void, new_window)
		@intrinsic("call", "GL", "glViewport", void, 0, 0, w, h)
		register the graphics viewport resize callback of new_window
		@intrinsic("call", "GL", "glMatrixMode", void, 5889)
		@intrinsic("call", "GL", "glLoadIdentity", void)
		set wf to w as a 64 bit float
		set hf to h as a 64 bit float
		set neg to 0.0 - 1.0
		@intrinsic("call", "GL", "glOrtho", void, 0.0, wf, hf, 0.0, neg, 1.0)
		@intrinsic("call", "GL", "glMatrixMode", void, 5888)
		@intrinsic("call", "GL", "glLoadIdentity", void)
		return new_window

function a new fullscreen window:
	execute:
		set fullscreen_hints_ready to initialize fullscreen window hints
		if not fullscreen_hints_ready:
			return 0 as a pointer to byte
		set monitor to the primary monitor
		set video_mode to the primary video mode of monitor
		set w to the width of video_mode
		set h to the height of video_mode
		set new_window to @intrinsic("call", "glfw", "glfwCreateWindow", a pointer to a byte, w, h, "DynLex", monitor, 0 as a pointer to a byte)
		if new_window = 0 as a pointer to byte:
			print "failed to create fullscreen GLFW window with OpenGL 4.6 compatibility profile" as line
			@intrinsic("call", "glfw", "glfwTerminate", void)
			return 0 as a pointer to byte
		@intrinsic("call", "glfw", "glfwMakeContextCurrent", void, new_window)
		@intrinsic("call", "GL", "glViewport", void, 0, 0, w, h)
		register the graphics viewport resize callback of new_window
		@intrinsic("call", "GL", "glMatrixMode", void, 5889)
		@intrinsic("call", "GL", "glLoadIdentity", void)
		set wf to w as a 64 bit float
		set hf to h as a 64 bit float
		set neg to 0.0 - 1.0
		@intrinsic("call", "GL", "glOrtho", void, 0.0, wf, hf, 0.0, neg, 1.0)
		@intrinsic("call", "GL", "glMatrixMode", void, 5888)
		@intrinsic("call", "GL", "glLoadIdentity", void)
		return new_window

function initialize fullscreen window hints:
	execute:
		set glfw_initialized to @intrinsic("call", "glfw", "glfwInit", an integer)
		if glfw_initialized = 0:
			print "failed to initialize GLFW" as line
			return false
		# Request OpenGL 4.6 compatibility profile (needed for SPIR-V shader support)
		# GLFW_CONTEXT_VERSION_MAJOR = 0x00022002 = 139266
		# GLFW_CONTEXT_VERSION_MINOR = 0x00022003 = 139267
		# GLFW_OPENGL_PROFILE = 0x00022008 = 139272
		# GLFW_OPENGL_COMPAT_PROFILE = 0x00032002 = 204802
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139266, 4)
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139267, 6)
		@intrinsic("call", "glfw", "glfwWindowHint", void, 139272, 204802)
		return true

function [the|] primary monitor:
	execute:
		return @intrinsic("call", "glfw", "glfwGetPrimaryMonitor", a pointer to a byte)

function [the|] primary video mode [of|] monitor:
	replacement:
		the value at (@intrinsic("call", "glfw", "glfwGetVideoMode", a pointer to a byte, monitor) as a pointer to glfw video mode)

function clear [the|] screen:
	execute:
		@intrinsic("call", "GL", "glClear", void, 16384)

function [display|show] [the|] frame [of|in] window:
	execute:
		@intrinsic("call", "glfw", "glfwSwapBuffers", void, window)
		@intrinsic("call", "glfw", "glfwPollEvents", void)

function draw [a|] rectangle at x y [with|] size w h [and|in|with] color r g b:
	execute:
		@intrinsic("call", "GL", "glColor3ub", void, r, g, b)
		@intrinsic("call", "GL", "glRecti", void, x, y, x + w, y + h)

function [the|] [last|] pressed key [of|in] window:
	execute:
		if @intrinsic("call", "glfw", "glfwGetKey", an integer, window, 265) = 1:
			return 1
		if @intrinsic("call", "glfw", "glfwGetKey", an integer, window, 262) = 1:
			return 2
		if @intrinsic("call", "glfw", "glfwGetKey", an integer, window, 264) = 1:
			return 3
		if @intrinsic("call", "glfw", "glfwGetKey", an integer, window, 263) = 1:
			return 4
		if @intrinsic("call", "glfw", "glfwGetKey", an integer, window, 256) = 1:
			return 5
		return 0

function [the|] window should close:
	execute:
		return @intrinsic("call", "glfw", "glfwWindowShouldClose", an integer, window)

function query [the|] framebuffer [width] of {cstring:window}:
	execute:
		set framebuffer_width to 0
		set framebuffer_height to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", void, window, address of framebuffer_width, address of framebuffer_height)
		return framebuffer_width

function query [the|] framebuffer [height] of {cstring:window}:
	execute:
		set framebuffer_width to 0
		set framebuffer_height to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", void, window, address of framebuffer_width, address of framebuffer_height)
		return framebuffer_height

function sleep [for|] ms milliseconds:
	execute:
		@intrinsic("call", "libc", "usleep", void, ms * 1000)

function close [the|] window:
	execute:
		@intrinsic("call", "glfw", "glfwDestroyWindow", void, window)
		@intrinsic("call", "glfw", "glfwTerminate", void)

# --- Shader support (OpenGL 4.6 / SPIR-V) ---

# GL_FRAGMENT_SHADER = 0x8B30 = 35632
# GL_VERTEX_SHADER = 0x8B31 = 35633
# GL_SHADER_BINARY_FORMAT_SPIR_V = 0x9551 = 38225
# GL_COMPILE_STATUS = 0x8B81 = 35713
# GL_LINK_STATUS = 0x8B82 = 35714

function [a|] fragment shader from path:
	execute:
		set new_shader to @intrinsic("call", "GL", "glCreateShader", an integer, 35632)
		set data to @intrinsic("call", "libc", "fopen", a pointer to a byte, path, "rb")
		discard @intrinsic("call", "libc", "fseek", an integer, data, 0, 2)
		set size to @intrinsic("call", "libc", "ftell", a 64 bit integer, data)
		discard @intrinsic("call", "libc", "fseek", an integer, data, 0, 0)
		set buf to @intrinsic("call", "libc", "malloc", a pointer to a byte, size)
		discard @intrinsic("call", "libc", "fread", a 64 bit integer, buf, 1, size, data)
		discard @intrinsic("call", "libc", "fclose", an integer, data)
		@intrinsic("call", "GL", "glShaderBinary", void, 1, address of new_shader, 38225, buf, size as an integer)
		@intrinsic("call", "GL", "glSpecializeShader", void, new_shader, "main", 0, 0 as a pointer to a byte, 0 as a pointer to a byte)
		@intrinsic("call", "libc", "free", void, buf)
		return new_shader

function [a|] vertex shader from path:
	execute:
		set new_shader to @intrinsic("call", "GL", "glCreateShader", an integer, 35633)
		set data to @intrinsic("call", "libc", "fopen", a pointer to a byte, path, "rb")
		discard @intrinsic("call", "libc", "fseek", an integer, data, 0, 2)
		set size to @intrinsic("call", "libc", "ftell", a 64 bit integer, data)
		discard @intrinsic("call", "libc", "fseek", an integer, data, 0, 0)
		set buf to @intrinsic("call", "libc", "malloc", a pointer to a byte, size)
		discard @intrinsic("call", "libc", "fread", a 64 bit integer, buf, 1, size, data)
		discard @intrinsic("call", "libc", "fclose", an integer, data)
		@intrinsic("call", "GL", "glShaderBinary", void, 1, address of new_shader, 38225, buf, size as an integer)
		@intrinsic("call", "GL", "glSpecializeShader", void, new_shader, "main", 0, 0 as a pointer to a byte, 0 as a pointer to a byte)
		@intrinsic("call", "libc", "free", void, buf)
		return new_shader

function [a|] shader program with vertex vert and fragment frag:
	execute:
		set prog to @intrinsic("call", "GL", "glCreateProgram", an integer)
		@intrinsic("call", "GL", "glAttachShader", void, prog, vert)
		@intrinsic("call", "GL", "glAttachShader", void, prog, frag)
		@intrinsic("call", "GL", "glLinkProgram", void, prog)
		return prog

function use shader program prog:
	execute:
		@intrinsic("call", "GL", "glUseProgram", void, prog)

function [the|] time since start:
	execute:
		return @intrinsic("call", "glfw", "glfwGetTime", a float)

function set [the|] uniform name of prog to value:
	execute:
		set loc to @intrinsic("call", "GL", "glGetUniformLocation", an integer, prog, name)
		@intrinsic("call", "GL", "glUniform1f", void, loc, value as a 32 bit float)

function set [the|] uniform at location to value:
	execute:
		@intrinsic("call", "GL", "glUniform1f", void, location, value as a 32 bit float)

# --- UBO (Uniform Buffer Object) support for SPIR-V shaders ---
# GL_UNIFORM_BUFFER = 0x8A11 = 35345
# GL_DYNAMIC_DRAW = 0x88E8 = 35048

function [a|] uniform buffer:
	execute:
		set buf to 0
		@intrinsic("call", "GL", "glGenBuffers", void, 1, address of buf)
		@intrinsic("call", "GL", "glBindBuffer", void, 35345, buf)
		@intrinsic("call", "GL", "glBufferData", void, 35345, 4 as a 64 bit integer, 0 as a pointer to a byte, 35048)
		return buf

function bind uniform buffer buf to binding:
	execute:
		@intrinsic("call", "GL", "glBindBufferBase", void, 35345, binding, buf)

function update uniform buffer buf with value:
	execute:
		set fval to value as a 32 bit float
		@intrinsic("call", "GL", "glBindBuffer", void, 35345, buf)
		@intrinsic("call", "GL", "glBufferSubData", void, 35345, 0 as a 64 bit integer, 4 as a 64 bit integer, address of fval)

function draw [a|] fullscreen quad:
	execute:
		# Draw a fullscreen triangle strip (covers screen with 2D quad)
		# GL_TRIANGLE_STRIP = 0x0005 = 5
		# Use glVertex2d (takes double) since DynLex floats are f64
		@intrinsic("call", "GL", "glBegin", void, 5)
		@intrinsic("call", "GL", "glVertex2d", void, 0.0 - 1.0, 0.0 - 1.0)
		@intrinsic("call", "GL", "glVertex2d", void, 1.0, 0.0 - 1.0)
		@intrinsic("call", "GL", "glVertex2d", void, 0.0 - 1.0, 1.0)
		@intrinsic("call", "GL", "glVertex2d", void, 1.0, 1.0)
		@intrinsic("call", "GL", "glEnd", void)
