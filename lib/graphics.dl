# DynLex Graphics Library (GLFW + OpenGL)

import lib/std.dl
import lib/texture.dl

# External GLFW and OpenGL constants are named compile-time values. Keeping
# their ABI values in one place makes intrinsic calls readable and prevents
# callers from having to repeat external enum numbers.

function the GLFW press status:
	replacement:
		1

function the GLFW release status:
	replacement:
		0

function the GLFW escape key:
	replacement:
		256

function the GLFW A key:
	replacement:
		65

function the GLFW D key:
	replacement:
		68

function the GLFW E key:
	replacement:
		69

function the GLFW Q key:
	replacement:
		81

function the GLFW S key:
	replacement:
		83

function the GLFW W key:
	replacement:
		87

function the GLFW 0 key:
	replacement:
		48

function the GLFW 1 key:
	replacement:
		49

function the GLFW 2 key:
	replacement:
		50

function the GLFW 3 key:
	replacement:
		51

function the GLFW 4 key:
	replacement:
		52

function the GLFW 5 key:
	replacement:
		53

function the GLFW 6 key:
	replacement:
		54

function the GLFW 7 key:
	replacement:
		55

function the GLFW 8 key:
	replacement:
		56

function the GLFW 9 key:
	replacement:
		57

function the GLFW right key:
	replacement:
		262

function the GLFW left key:
	replacement:
		263

function the GLFW down key:
	replacement:
		264

function the GLFW up key:
	replacement:
		265

function the GLFW first mouse button:
	replacement:
		0

function the GLFW second mouse button:
	replacement:
		1

function the GLFW third mouse button:
	replacement:
		2

function the GLFW cursor input mode:
	replacement:
		208897

function the GLFW normal cursor mode:
	replacement:
		212993

function the GLFW disabled cursor mode:
	replacement:
		212995

function the GLFW context version major hint:
	replacement:
		139266

function the GLFW context version minor hint:
	replacement:
		139267

function the GLFW OpenGL profile hint:
	replacement:
		139272

function the GLFW OpenGL compatibility profile:
	replacement:
		204802

function the GLFW visible window hint:
	replacement:
		131076

function the GL color buffer bit:
	replacement:
		16384

function the GL projection matrix mode:
	replacement:
		5889

function the GL modelview matrix mode:
	replacement:
		5888

function the GL fragment shader type:
	replacement:
		35632

function the GL vertex shader type:
	replacement:
		35633

function the GL SPIR-V shader binary format:
	replacement:
		38225

function the GL compile status:
	replacement:
		35713

function the GL link status:
	replacement:
		35714

function the GL uniform buffer target:
	replacement:
		35345

function the GL dynamic draw usage:
	replacement:
		35048

function the GL triangle strip primitive:
	replacement:
		5

class:
	patterns:
		[a|] GLFW video mode
	members:
		width as an integer
		height as an integer
		red bits as an integer
		green bits as an integer
		blue bits as an integer
		refresh rate as an integer

class:
	patterns:
		[a|] cursor position
	members:
		x as a floating-point number
		y as a floating-point number

class:
	patterns:
		[a|] mouse button
	members:
		number as an integer

function the left mouse button:
	execute:
		return @intrinsic("construct", a mouse button, the GLFW first mouse button)

function the right mouse button:
	execute:
		return @intrinsic("construct", a mouse button, the GLFW second mouse button)

function the middle mouse button:
	execute:
		return @intrinsic("construct", a mouse button, the GLFW third mouse button)

function a mouse button numbered {integer:number}:
	execute:
		return @intrinsic("construct", a mouse button, number)

function the cursor position of {C string:window}:
	execute:
		set x to 0.0 as a floating-point number
		set y to 0.0 as a floating-point number
		@intrinsic("call", "glfw", "glfwGetCursorPos", nothing, window, the address of x, the address of y)
		return @intrinsic("construct", a cursor position, x, y)

function {mouse button:button} is pressed in {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetMouseButton", an integer, window, button's number) = the GLFW press status

function {mouse button:button} is released in {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetMouseButton", an integer, window, button's number) = the GLFW release status

function capture the mouse cursor in {C string:window}:
	execute:
		@intrinsic("call", "glfw", "glfwSetInputMode", nothing, window, the GLFW cursor input mode, the GLFW disabled cursor mode)

function release the mouse cursor in {C string:window}:
	execute:
		@intrinsic("call", "glfw", "glfwSetInputMode", nothing, window, the GLFW cursor input mode, the GLFW normal cursor mode)

# GLFW stores one caller-owned void pointer on every window. These wrappers
# keep that pointer available to callbacks without exposing GLFW's raw ABI to
# application code. The pointer is borrowed; callers own its lifetime.
function set the application state of {C string:window} to {pointer:data}:
	execute:
		@intrinsic("call", "glfw", "glfwSetWindowUserPointer", nothing, window, data)

function the application state of {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetWindowUserPointer", a pointer to a byte, window)

exposed function resize the graphics viewport of {C string:window} to {integer:width} and {integer:height}:
	execute:
		@intrinsic("call", "GL", "glViewport", nothing, 0, 0, width, height)

function register the graphics viewport resize callback [of|for] window:
	execute:
		ignore @intrinsic("call", "glfw", "glfwSetFramebufferSizeCallback", a pointer to a byte, window, the function named "resize the graphics viewport of $ to $ and $")

# Registering the same window again replaces its existing scroll callback, as
# specified by GLFW. The callback name is fixed at compile time so its exposed
# function can be compiled with the exact GLFWscrollfun ABI: a window pointer
# followed by two C doubles (DynLex floating-point numbers).
flex function register the graphics scroll callback named {fixed C string:callback} [of|for] window:
	replacement:
		ignore @intrinsic("call", "glfw", "glfwSetScrollCallback", a pointer to a byte, window, the function named callback)

function a new window with width {integer:width} and height {integer:height}:
	execute:
		return the result of creating a graphics window with width width and height height on monitor 0 as a pointer to a byte in fullscreen state false with visibility 1 and failure message "failed to create GLFW window with OpenGL 4.6 compatibility profile"

function a new hidden window with width {integer:width} and height {integer:height}:
	execute:
		return the result of creating a graphics window with width width and height height on monitor 0 as a pointer to a byte in fullscreen state false with visibility 0 and failure message "failed to create GLFW window with OpenGL 4.6 compatibility profile"

function a new fullscreen window:
	execute:
		return the result of creating a graphics window with width 0 and height 0 on monitor 0 as a pointer to a byte in fullscreen state true with visibility 1 and failure message "failed to create fullscreen GLFW window with OpenGL 4.6 compatibility profile"

local function the result of creating a graphics window with width {integer:width} and height {integer:height} on monitor {pointer:monitor} in fullscreen state {boolean:fullscreen} with visibility {integer:visibility} and failure message {C string:failure}:
	execute:
		set initialized to the result of initializing GLFW
		if initialized = false:
			return 0 as a pointer to a byte
		set {actual monitor} to monitor
		set {actual width} to width
		set {actual height} to height
		if fullscreen:
			set actual monitor to the primary monitor
			set mode to the primary video mode of actual monitor
			set actual width to the width of mode
			set actual height to the height of mode
		@intrinsic("call", "glfw", "glfwDefaultWindowHints", nothing)
		# Request OpenGL 4.6 compatibility profile (needed for SPIR-V shader support)
		@intrinsic("call", "glfw", "glfwWindowHint", nothing, the GLFW context version major hint, 4)
		@intrinsic("call", "glfw", "glfwWindowHint", nothing, the GLFW context version minor hint, 6)
		@intrinsic("call", "glfw", "glfwWindowHint", nothing, the GLFW OpenGL profile hint, the GLFW OpenGL compatibility profile)
		@intrinsic("call", "glfw", "glfwWindowHint", nothing, the GLFW visible window hint, visibility)
		set handle to @intrinsic("call", "glfw", "glfwCreateWindow", a pointer to a byte, actual width, actual height, "DynLex", actual monitor, 0 as a pointer to a byte)
		if handle = 0 as a pointer to a byte:
			print failure as a line
			@intrinsic("call", "glfw", "glfwTerminate", nothing)
			return 0 as a pointer to a byte
		@intrinsic("call", "glfw", "glfwMakeContextCurrent", nothing, handle)
		@intrinsic("call", "GL", "glViewport", nothing, 0, 0, actual width, actual height)
		register the graphics viewport resize callback of handle
		@intrinsic("call", "GL", "glMatrixMode", nothing, the GL projection matrix mode)
		@intrinsic("call", "GL", "glLoadIdentity", nothing)
		set horizontal to actual width as a floating-point number
		set vertical to actual height as a floating-point number
		set negative to (0.0 - 1.0)
		@intrinsic("call", "GL", "glOrtho", nothing, 0.0, horizontal, vertical, 0.0, negative, 1.0)
		@intrinsic("call", "GL", "glMatrixMode", nothing, the GL modelview matrix mode)
		@intrinsic("call", "GL", "glLoadIdentity", nothing)
		return handle

local function the result of initializing GLFW:
	execute:
		set initialized to @intrinsic("call", "glfw", "glfwInit", an integer)
		if initialized = 0:
			print "failed to initialize GLFW" as a line
			return false
		return true

function the primary monitor:
	execute:
		return @intrinsic("call", "glfw", "glfwGetPrimaryMonitor", a pointer to a byte)

function the primary video mode of monitor:
	replacement:
		the value at (@intrinsic("call", "glfw", "glfwGetVideoMode", a pointer to a byte, monitor) as a pointer to a GLFW video mode)

function clear the screen:
	execute:
		@intrinsic("call", "GL", "glClear", nothing, the GL color buffer bit)

function [display|show] the frame [of|in] window:
	execute:
		@intrinsic("call", "glfw", "glfwSwapBuffers", nothing, window)
		@intrinsic("call", "glfw", "glfwPollEvents", nothing)

function draw a rectangle at x {a value:horizontal} and y {a value:vertical} with width {a value:width} and height {a value:height} in color red {a value:red}, green {a value:green} and blue {a value:blue}:
	execute:
		@intrinsic("call", "GL", "glColor3ub", nothing, red, green, blue)
		@intrinsic("call", "GL", "glRecti", nothing, horizontal, vertical, horizontal + width, vertical + height)

function key {integer:number} is down in {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetKey", an integer, window, number) = the GLFW press status

function key {integer:number} is up in {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetKey", an integer, window, number) = the GLFW release status

function the window should close:
	execute:
		return @intrinsic("call", "glfw", "glfwWindowShouldClose", an integer, window) != 0

function the window remains open:
	execute:
		return @intrinsic("call", "glfw", "glfwWindowShouldClose", an integer, window) = 0

function the framebuffer width of {C string:window}:
	execute:
		set horizontal to 0
		set vertical to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", nothing, window, the address of horizontal, the address of vertical)
		return horizontal

function the framebuffer height of {C string:window}:
	execute:
		set horizontal to 0
		set vertical to 0
		@intrinsic("call", "glfw", "glfwGetFramebufferSize", nothing, window, the address of horizontal, the address of vertical)
		return vertical

function sleep for duration milliseconds:
	execute:
		@intrinsic("call", "libc", "usleep", nothing, duration * 1000)

function close [the|] {C string:window}:
	execute:
		@intrinsic("call", "glfw", "glfwDestroyWindow", nothing, window)
		@intrinsic("call", "glfw", "glfwTerminate", nothing)

# --- Shader support (OpenGL 4.6 / SPIR-V) ---

function a fragment shader from path:
	execute:
		set handle to @intrinsic("call", "GL", "glCreateShader", an integer, the GL fragment shader type)
		set data to @intrinsic("call", "libc", "fopen", a pointer to a byte, path, "rb")
		ignore @intrinsic("call", "libc", "fseek", an integer, data, 0 as a C long integer, 2)
		set length to @intrinsic("call", "libc", "ftell", a C long integer, data)
		set size to length as a word sized integer
		ignore @intrinsic("call", "libc", "fseek", an integer, data, 0 as a C long integer, 0)
		set buffer to @intrinsic("call", "libc", "malloc", a pointer to a byte, size)
		ignore @intrinsic("call", "libc", "fread", a word sized integer, buffer, 1 as a word sized integer, size, data)
		ignore @intrinsic("call", "libc", "fclose", an integer, data)
		@intrinsic("call", "GL", "glShaderBinary", nothing, 1, the address of handle, the GL SPIR-V shader binary format, buffer, size as an integer)
		@intrinsic("call", "GL", "glSpecializeShader", nothing, handle, "main", 0, 0 as a pointer to a byte, 0 as a pointer to a byte)
		@intrinsic("call", "libc", "free", nothing, buffer)
		return handle

function a vertex shader from path:
	execute:
		set handle to @intrinsic("call", "GL", "glCreateShader", an integer, the GL vertex shader type)
		set data to @intrinsic("call", "libc", "fopen", a pointer to a byte, path, "rb")
		ignore @intrinsic("call", "libc", "fseek", an integer, data, 0 as a C long integer, 2)
		set length to @intrinsic("call", "libc", "ftell", a C long integer, data)
		set size to length as a word sized integer
		ignore @intrinsic("call", "libc", "fseek", an integer, data, 0 as a C long integer, 0)
		set buffer to @intrinsic("call", "libc", "malloc", a pointer to a byte, size)
		ignore @intrinsic("call", "libc", "fread", a word sized integer, buffer, 1 as a word sized integer, size, data)
		ignore @intrinsic("call", "libc", "fclose", an integer, data)
		@intrinsic("call", "GL", "glShaderBinary", nothing, 1, the address of handle, the GL SPIR-V shader binary format, buffer, size as an integer)
		@intrinsic("call", "GL", "glSpecializeShader", nothing, handle, "main", 0, 0 as a pointer to a byte, 0 as a pointer to a byte)
		@intrinsic("call", "libc", "free", nothing, buffer)
		return handle

function a shader program combining {a value:vertex} and {a value:fragment}:
	execute:
		set handle to @intrinsic("call", "GL", "glCreateProgram", an integer)
		@intrinsic("call", "GL", "glAttachShader", nothing, handle, vertex)
		@intrinsic("call", "GL", "glAttachShader", nothing, handle, fragment)
		@intrinsic("call", "GL", "glLinkProgram", nothing, handle)
		return handle

function use {integer:program} as the shader program:
	execute:
		@intrinsic("call", "GL", "glUseProgram", nothing, program)

function the time since start:
	execute:
		return @intrinsic("call", "glfw", "glfwGetTime", a floating-point number)

function set the uniform named name in program to value:
	execute:
		set location to @intrinsic("call", "GL", "glGetUniformLocation", an integer, program, name)
		@intrinsic("call", "GL", "glUniform1f", nothing, location, value as a 32 bit floating-point number)

function set the uniform at location to value:
	execute:
		@intrinsic("call", "GL", "glUniform1f", nothing, location, value as a 32 bit floating-point number)

# --- UBO (Uniform Buffer Object) support for SPIR-V shaders ---

class:
	patterns:
		[a|] uniform buffer
	members:
		handle as an integer

function a new uniform buffer:
	execute:
		set handle to 0
		@intrinsic("call", "GL", "glGenBuffers", nothing, 1, the address of handle)
		@intrinsic("call", "GL", "glBindBuffer", nothing, the GL uniform buffer target, handle)
		@intrinsic("call", "GL", "glBufferData", nothing, the GL uniform buffer target, 4 as a 64 bit integer, 0 as a pointer to a byte, the GL dynamic draw usage)
		return @intrinsic("construct", a uniform buffer, handle)

function bind {uniform buffer:buffer} to binding {integer:binding}:
	execute:
		@intrinsic("call", "GL", "glBindBufferBase", nothing, the GL uniform buffer target, binding, buffer's handle)

function update {uniform buffer:buffer} with value:
	execute:
		set number to value as a 32 bit floating-point number
		@intrinsic("call", "GL", "glBindBuffer", nothing, the GL uniform buffer target, buffer's handle)
		@intrinsic("call", "GL", "glBufferSubData", nothing, the GL uniform buffer target, 0 as a 64 bit integer, 4 as a 64 bit integer, the address of number)

function delete {uniform buffer:buffer}:
	execute:
		set handle to buffer's handle
		@intrinsic("call", "GL", "glDeleteBuffers", nothing, 1, the address of handle)

function draw a fullscreen quad:
	execute:
		# Draw a fullscreen triangle strip (covers screen with 2D quad)
		# Use glVertex2d (takes double) since DynLex floating-point numbers use 64 bits
		@intrinsic("call", "GL", "glBegin", nothing, the GL triangle strip primitive)
		@intrinsic("call", "GL", "glVertex2d", nothing, 0.0 - 1.0, 0.0 - 1.0)
		@intrinsic("call", "GL", "glVertex2d", nothing, 1.0, 0.0 - 1.0)
		@intrinsic("call", "GL", "glVertex2d", nothing, 0.0 - 1.0, 1.0)
		@intrinsic("call", "GL", "glVertex2d", nothing, 1.0, 1.0)
		@intrinsic("call", "GL", "glEnd", nothing)
