function write compact json {a pointer to json value:value} into {a pointer to byte:output} starting at {integer:write_position}:
    execute:
        if value = (0 as a pointer to json value):
            @intrinsic("call", "libc", "abort", void)
        if the kind of value = the json null kind:
            set text to the string form of "null"
            copy text into output at offset write_position
            return write_position + the length of text
        if the kind of value = the json boolean kind:
            set text to the string form of "false"
            if the boolean of value:
                set text to the string form of "true"
            copy text into output at offset write_position
            return write_position + the length of text
        if the kind of value = the json number kind:
            set text to the text of value
            copy text into output at offset write_position
            return write_position + the length of text
        if the kind of value = the json text kind:
            return write escaped json the text of value into output starting at write_position
        if the kind of value = the json array kind:
            store 91 as a byte into output at write_position
            set write_position to write_position + 1
            set item_index to 0
            loop while item_index < the length of value:
                if item_index > 0:
                    store 44 as a byte into output at write_position
                    set write_position to write_position + 1
                set write_position to write compact json item item_index of the items of value into output starting at write_position
                set item_index to item_index + 1
            store 93 as a byte into output at write_position
            return write_position + 1
        if the kind of value = the json object kind:
            store 123 as a byte into output at write_position
            set write_position to write_position + 1
            set member_index to 0
            loop while member_index < the length of value:
                if member_index > 0:
                    store 44 as a byte into output at write_position
                    set write_position to write_position + 1
                set write_position to write escaped json item member_index of the names of value into output starting at write_position
                store 58 as a byte into output at write_position
                set write_position to write_position + 1
                set write_position to write compact json item member_index of the items of value into output starting at write_position
                set member_index to member_index + 1
            store 125 as a byte into output at write_position
            return write_position + 1
        @intrinsic("call", "libc", "abort", void)
        return write_position

function [the|] compact json form of {a pointer to json value:value}:
    execute:
        set result_length to the compact json length of value
        set result to a new string buffer with length result_length
        set final_position to write compact json value into the data of result starting at 0
        if final_position != result_length:
