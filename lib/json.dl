function free json value {a pointer to json value:node}:
    execute:
        if node = (0 as a pointer to json value):
            @intrinsic("return")
        if (the kind of node = the json text kind) or (the kind of node = the json number kind):
            @intrinsic("call", "libc", "free", void, the data of the text of node)
        if (the kind of node = the json array kind) or (the kind of node = the json object kind):
            set item_index to 0
            loop while item_index < the length of node:
                free json value item item_index of the items of node
                set item_index to item_index + 1
        if the kind of node = the json object kind:
            set name_index to 0
            loop while name_index < the length of node:
                set name to item name_index of the names of node
                @intrinsic("call", "libc", "free", void, the data of name)
                set name_index to name_index + 1
        @intrinsic("call", "libc", "free", void, the items of node)
        @intrinsic("call", "libc", "free", void, the names of node)
        @intrinsic("call", "libc", "free", void, node)

function free json result {json result:outcome}:
    execute:
        free json value @intrinsic("property", outcome, "value")
