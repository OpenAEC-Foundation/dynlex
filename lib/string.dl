# DynLex String Library

import lib/array.dl

class:
    patterns:
        [a|] string
    members:
        data as pointer to byte
        length as i32

function cstring:
    replacement:
        @intrinsic("type", "string")

function new string from data ptr with length len:
    replacement:
        @intrinsic("construct", a string, ptr, len)

function character index of str:
    replacement:
        @intrinsic("load at", the data of str, index)

function the length of str:
    execute:
        set len to 0
        set ch to character len of str
        loop while ch is not 0:
            set len to len + 1
            set ch to character len of str
        return len

# --- Conversions to string ---

function {integer:value} as a string:
    execute:
        set buf to @intrinsic("call", "libc", "malloc", a pointer to a byte, 21)
        set len to @intrinsic("call", "libc", "snprintf", an integer, buf, 21, "%ld", value as a 64 bit integer)
        return new string from data buf with length len

function {float:value} as a string:
    execute:
        set buf to @intrinsic("call", "libc", "malloc", a pointer to a byte, 32)
        set len to @intrinsic("call", "libc", "snprintf", an integer, buf, 32, "%g", value as a 64 bit float)
        return new string from data buf with length len

function {boolean:value} as a string:
    execute:
        set buf to @intrinsic("call", "libc", "malloc", a pointer to a byte, 2)
        set len to @intrinsic("call", "libc", "snprintf", an integer, buf, 2, "%ld", value as a 64 bit integer)
        return new string from data buf with length len

function {cstring:value} as a string:
    execute:
        set len to @intrinsic("call", "libc", "strlen", an integer, value)
        return new string from data value with length len

# --- Line suffix ---

function value as [a|] line:
    execute:
        return value as a string + new string from data "\n" with length 1

# --- Output ---

function print {string:msg}:
    execute:
        @intrinsic("call", "libc", "printf", an integer, "%s", the data of msg)

function print msg:
    execute:
        print msg as a string

# --- Concatenation ---

function {string:left} + {string:right}:
    before: $ or $, $ and $, not $, $ < $, $ > $, $ = $, $ != $, $ <= $, $ >= $
    execute:
        set left_len to the length of left
        set right_len to the length of right
        set total to left_len + right_len
        set result to @intrinsic("call", "libc", "malloc", a pointer to a byte, total + 1)
        @intrinsic("call", "libc", "memcpy", a pointer to a byte, result, the data of left, left_len)
        @intrinsic("call", "libc", "memcpy", a pointer to a byte, result + left_len, the data of right, right_len + 1)
        return new string from data result with length total
