# JSON-RPC 2.0 framing, JSON validation, and wire limits.

import lib/json.dl
import lib/list.dl
import lib/unicode.dl

class:
    patterns:
        [a|] json rpc limits
    members:
        maximum_header_length as i32
        maximum_payload_length as i32
        maximum_buffered_output_length as i32
        maximum_queue_length as i32
        maximum_standard_error_length as i32
        graceful_close_timeout_milliseconds as i32
        termination_timeout_milliseconds as i32

class:
    patterns:
        [a|] json rpc operation
    members:
        succeeded as boolean
        status as i32
        error_message as string

class:
    patterns:
        [a|] json rpc receive result
    members:
        succeeded as boolean
        status as i32
        message as a pointer to json value
        error_message as string

class:
    patterns:
        [a|] json rpc frame header result
    members:
        succeeded as boolean
        complete as boolean
        status as i32
        header_length as i32
        payload_length as i32
        error_message as string

function [the|] json rpc success status:
    replacement:
        0

function [the|] json rpc end of stream status:
    replacement:
        1

function [the|] json rpc io error status:
    replacement:
        2

function [the|] json rpc malformed frame status:
    replacement:
        3

function [the|] json rpc invalid utf8 status:
    replacement:
        4

function [the|] json rpc invalid json status:
    replacement:
        5

function [the|] json rpc limit exceeded status:
    replacement:
        6

function [the|] json rpc invalid message status:
    replacement:
        7

function [the|] json rpc child exit error status:
    replacement:
        8

function {json rpc operation:operation}'s error message:
    replacement:
        @intrinsic("property", operation, "error_message")

function {json rpc receive result:result}'s error message:
    replacement:
        @intrinsic("property", result, "error_message")

function [the|] default json rpc limits:
    replacement:
        @intrinsic(
            "construct",
            a json rpc limits,
            8192,
            16777216,
            33554432,
            1024,
            65536,
            1000,
            1000
        )

function an empty json rpc error:
    replacement:
        the string form of ""

function a successful json rpc operation:
    replacement:
        @intrinsic("construct", a json rpc operation, true, the json rpc success status, an empty json rpc error)

function a failed json rpc operation with status {integer:error_status} reporting {string:message}:
    replacement:
        @intrinsic("construct", a json rpc operation, false, error_status, message)

function a failed json rpc operation with status {integer:error_status} reporting {cstring:message}:
    execute:
        return a failed json rpc operation with status error_status reporting the string form of message

function a failed json rpc receive with status {integer:error_status} reporting {string:message}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc receive result,
            false,
            error_status,
            0 as a pointer to json value,
            message
        )

function a failed json rpc receive with status {integer:error_status} reporting {cstring:message}:
    execute:
        return a failed json rpc receive with status error_status reporting the string form of message

function a successful json rpc receive containing {a pointer to json value:value}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc receive result,
            true,
            the json rpc success status,
            value,
            an empty json rpc error
        )

function validate {json rpc limits:limits} as json rpc limits:
    execute:
        if limits's maximum_header_length < 16:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC header limit must be at least 16 bytes"
        if limits's maximum_payload_length < 1:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC payload limit must be positive"
        if limits's maximum_buffered_output_length < limits's maximum_header_length:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC buffer limit must not be smaller than the header limit"
        if limits's maximum_queue_length < 1:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC queue limit must be positive"
        if limits's maximum_standard_error_length < 0:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC standard error limit must not be negative"
        if limits's graceful_close_timeout_milliseconds < 0:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC graceful close timeout must not be negative"
        if limits's termination_timeout_milliseconds < 0:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The JSON-RPC termination timeout must not be negative"
        return a successful json rpc operation

local function ascii character input folded to lowercase:
    execute:
        if input >= 65 and input <= 90:
            return input + 32
        return input as i32

local function {string:text} equals ascii text {cstring:expected}:
    execute:
        if the length of text != the length of expected:
            return false
        set cursor to 0
        loop while cursor < the length of text:
            set actual_character to ascii character character cursor of text folded to lowercase
            set expected_character to ascii character character cursor of expected folded to lowercase
            if actual_character != expected_character:
                return false
            set cursor to cursor + 1
        return true

local function character value is valid in a json rpc header name:
    execute:
        if value >= 48 and value <= 57:
            return true
        if value >= 65 and value <= 90:
            return true
        if value >= 97 and value <= 122:
            return true
        if value = 33 or ((value = 35) or ((value = 36) or ((value = 37) or (value = 38)))):
            return true
        if value = 39 or ((value = 42) or ((value = 43) or ((value = 45) or (value = 46)))):
            return true
        if value = 94 or ((value = 95) or ((value = 96) or ((value = 124) or (value = 126)))):
            return true
        return false

local function json rpc header name is valid in {string:input} from {integer:start} before {integer:limit}:
    execute:
        if start >= limit:
            return false
        set cursor to start
        loop while cursor < limit:
            set value to (character cursor of input as i32) bitwise and 255
            if not character value is valid in a json rpc header name:
                return false
            set cursor to cursor + 1
        return true

local function next json rpc colon in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set cursor to start
        loop while cursor < limit:
            if character cursor of input = 58:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function next json rpc crlf in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set cursor to start
        loop while cursor + 1 < limit:
            if character cursor of input = 13 and character cursor + 1 of input = 10:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function json rpc header separator in {string:input}:
    execute:
        set cursor to 0
        loop while cursor < the length of input:
            set value to (character cursor of input as i32) bitwise and 255
            if value = 10:
                if cursor = 0 or character cursor - 1 of input != 13:
                    return 0 - 2
            else if value = 13:
                if cursor + 1 >= the length of input:
                    return 0 - 1
                if character cursor + 1 of input != 10:
                    return 0 - 2
                if cursor + 3 < the length of input:
                    if character cursor + 2 of input = 13 and character cursor + 3 of input = 10:
                        return cursor
                set cursor to cursor + 1
            else if value > 126 or ((value < 32) and (value != 9)):
                return 0 - 2
            set cursor to cursor + 1
        return 0 - 1

local function trim json rpc whitespace in {string:input} from {integer:start} before {integer:limit}:
    execute:
        loop while start < limit and ((character start of input = 32) or (character start of input = 9)):
            set start to start + 1
        return start

local function trim trailing json rpc whitespace in {string:input} from {integer:start} before {integer:limit}:
    execute:
        loop while limit > start and ((character limit - 1 of input = 32) or (character limit - 1 of input = 9)):
            set limit to limit - 1
        return limit

local function invalid json rpc frame header with status {integer:error_status} reporting {string:message}:
    replacement:
        @intrinsic("construct", a json rpc frame header result, false, false, error_status, 0, 0, message)

local function invalid json rpc frame header with status {integer:error_status} reporting {cstring:message}:
    execute:
        return invalid json rpc frame header with status error_status reporting the string form of message

local function incomplete json rpc frame header:
    replacement:
        @intrinsic(
            "construct",
            a json rpc frame header result,
            true,
            false,
            the json rpc success status,
            0,
            0,
            an empty json rpc error
        )

local function complete json rpc frame header of length {integer:header_length} with payload length {integer:payload_length}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc frame header result,
            true,
            true,
            the json rpc success status,
            header_length,
            payload_length,
            an empty json rpc error
        )

local function parse json rpc decimal in {string:input} from {integer:start} before {integer:limit} with maximum {integer:maximum}:
    execute:
        set start to trim json rpc whitespace in input from start before limit
        set limit to trim trailing json rpc whitespace in input from start before limit
        if start = limit:
            return 0 - 1
        set result to 0
        set cursor to start
        loop while cursor < limit:
            set digit to character cursor of input
            if digit < 48 or digit > 57:
                return 0 - 1
            set numeric_digit to digit - 48
            if result > (maximum - numeric_digit) / 10:
                return 0 - 2
            set result to result * 10 + numeric_digit
            set cursor to cursor + 1
        return result

local function content type segment in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set start to trim json rpc whitespace in input from start before limit
        set limit to trim trailing json rpc whitespace in input from start before limit
        return the substring of input from start with length limit - start

local function json rpc content type is utf8 in {string:input} from {integer:start} before {integer:limit}:
    execute:
        set separator to start
        loop while separator < limit and character separator of input != 59:
            set separator to separator + 1
        set media_type to content type segment in input from start before separator
        if not media_type equals ascii text "application/vscode-jsonrpc":
            return false
        if separator = limit:
            return true
        set parameter_start to separator + 1
        set parameter_end to parameter_start
        loop while parameter_end < limit and character parameter_end of input != 59:
            set parameter_end to parameter_end + 1
        if parameter_end < limit:
            return false
        set equals_position to parameter_start
        loop while equals_position < parameter_end and character equals_position of input != 61:
            set equals_position to equals_position + 1
        if equals_position = parameter_end:
            return false
        set parameter_name to content type segment in input from parameter_start before equals_position
        if not parameter_name equals ascii text "charset":
            return false
        set charset to content type segment in input from equals_position + 1 before parameter_end
        if the length of charset >= 2:
            if character 0 of charset = 34 and character the length of charset - 1 of charset = 34:
                set charset to the substring of charset from 1 with length the length of charset - 2
        return (charset equals ascii text "utf-8") or (charset equals ascii text "utf8")

function inspect json rpc frame header in {string:input} with {json rpc limits:limits}:
    execute:
        set separator to json rpc header separator in input
        if separator = (0 - 2):
            return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC headers must use CRLF and contain no control characters"
        if separator < 0:
            if the length of input >= limits's maximum_header_length:
                return invalid json rpc frame header with status the json rpc limit exceeded status reporting "JSON-RPC header exceeds its configured limit"
            return incomplete json rpc frame header
        set header_length to separator + 4
        if header_length > limits's maximum_header_length:
            return invalid json rpc frame header with status the json rpc limit exceeded status reporting "JSON-RPC header exceeds its configured limit"
        if separator = 0:
            return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC header is empty"
        set found_length to false
        set found_type to false
        set payload_length to 0
        set line_start to 0
        loop while line_start < separator:
            set line_end to next json rpc crlf in input from line_start before separator + 2
            if line_end <= line_start:
                return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC header contains an empty or unterminated field"
            set colon to next json rpc colon in input from line_start before line_end
            if colon < 0 or (not json rpc header name is valid in input from line_start before colon):
                return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC header field name is invalid"
            set name to the substring of input from line_start with length colon - line_start
            if name equals ascii text "content-length":
                if found_length:
                    return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC frame contains duplicate Content-Length fields"
                set parsed_length to parse json rpc decimal in input from colon + 1 before line_end with maximum limits's maximum_payload_length
                if parsed_length = (0 - 2):
                    return invalid json rpc frame header with status the json rpc limit exceeded status reporting "JSON-RPC payload exceeds its configured limit"
                if parsed_length < 0:
                    return invalid json rpc frame header with status the json rpc malformed frame status reporting "Content-Length must be a nonnegative decimal byte count"
                set found_length to true
                set payload_length to parsed_length
            else if name equals ascii text "content-type":
                if found_type:
                    return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC frame contains duplicate Content-Type fields"
                if not json rpc content type is utf8 in input from colon + 1 before line_end:
                    return invalid json rpc frame header with status the json rpc malformed frame status reporting "Content-Type must specify application/vscode-jsonrpc with UTF-8"
                set found_type to true
            set line_start to line_end + 2
        if not found_length:
            return invalid json rpc frame header with status the json rpc malformed frame status reporting "JSON-RPC frame is missing Content-Length"
        return complete json rpc frame header of length header_length with payload length payload_length

local function json rpc method name is reserved in {string:method}:
    execute:
        if the length of method < 4:
            return false
        return character 0 of method = 114 and character 1 of method = 112 and character 2 of method = 99 and character 3 of method = 46

function json rpc number {a pointer to json value:value} is an integer identifier:
    execute:
        if the kind of value != the json number kind:
            return false
        set text to the text of value
        if the length of text = 0:
            return false
        set cursor to 0
        if character 0 of text = 45:
            set cursor to 1
        if cursor >= the length of text:
            return false
        if character cursor of text = 48:
            return cursor + 1 = the length of text
        if character cursor of text < 49 or character cursor of text > 57:
            return false
        set cursor to cursor + 1
        loop while cursor < the length of text:
            if character cursor of text < 48 or character cursor of text > 57:
                return false
            set cursor to cursor + 1
        return true

function json rpc identifier {a pointer to json value:value} is valid:
    execute:
        if the kind of value = the json text kind:
            return the text of value is valid utf8
        return json rpc number value is an integer identifier

local function validate json rpc json node {a pointer to json value:value} at depth {integer:depth} seen in {a pointer to list:seen}:
    execute:
        if value = (0 as a pointer to json value):
            return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains a null child pointer"
        if depth > 128:
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "JSON output nesting exceeds 128 levels"
        if seen contains value:
            return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains a cycle or shared child"
        append value to seen
        set kind to the kind of value
        if kind < the json null kind or kind > the json object kind:
            return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains an invalid value kind"
        if kind = the json text kind:
            if not the text of value is valid utf8:
                return a failed json rpc operation with status the json rpc invalid utf8 status reporting "JSON output contains invalid UTF-8 text"
        if kind = the json number kind:
            set parsed_number to parse the text of value as json
            if not json parsing succeeded for parsed_number:
                free json result parsed_number
                return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains an invalid number"
            set parsed_value to the value of parsed_number
            set number_is_valid to the kind of parsed_value = the json number kind
            free json result parsed_number
            if not number_is_valid:
                return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains an invalid number"
        if kind = the json array kind or kind = the json object kind:
            if the length of value < 0 or the length of value > value's capacity:
                return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output has invalid collection bounds"
            set cursor to 0
            loop while cursor < the length of value:
                if kind = the json object kind:
                    set name to item cursor of the names of value
                    if not name is valid utf8:
                        return a failed json rpc operation with status the json rpc invalid utf8 status reporting "JSON output contains an invalid UTF-8 member name"
                    set previous to 0
                    loop while previous < cursor:
                        if item previous of the names of value = name:
                            return a failed json rpc operation with status the json rpc invalid json status reporting "JSON output contains duplicate object member names"
                        set previous to previous + 1
                set child_result to validate json rpc json node item cursor of the items of value at depth depth + 1 seen in seen
                if not child_result's succeeded:
                    return child_result
                set cursor to cursor + 1
        return a successful json rpc operation

local function validate json rpc error object {a pointer to json value:error_value}:
    execute:
        if not error_value is a json object:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC error must be an object"
        if not error_value has json member named "code":
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC error is missing code"
        if not error_value has json member named "message":
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC error is missing message"
        set code to json member named "code" in error_value
        set message to json member named "message" in error_value
        if not json rpc number code is an integer identifier:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC error code must be an integer"
        if the kind of message != the json text kind:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC error message must be text"
        return a successful json rpc operation

function validate outbound json rpc message {a pointer to json value:message}:
    execute:
        set seen to an empty list of a pointer to json value
        set json_validation to validate json rpc json node message at depth 0 seen in seen
        free list seen
        if not json_validation's succeeded:
            return json_validation
        if not message is a json object:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC batches and non-object messages are unsupported"
        if not message has json member named "jsonrpc":
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC message is missing jsonrpc"
        set version to json member named "jsonrpc" in message
        if the kind of version != the json text kind or the text of version != "2.0":
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC version must be exactly 2.0"
        set has_method to message has json member named "method"
        set has_result to message has json member named "result"
        set has_error to message has json member named "error"
        if has_method:
            if has_result or has_error:
                return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC request must not contain result or error"
            set method to json member named "method" in message
            if the kind of method != the json text kind:
                return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC method must be text"
            if json rpc method name is reserved in the text of method:
                return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC method names beginning with rpc. are reserved"
            if message has json member named "params":
                set parameters to json member named "params" in message
                if (not parameters is a json object) and (not parameters is a json array):
                    return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC params must be an object or array"
            if message has json member named "id":
                if not json rpc identifier json member named "id" in message is valid:
                    return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC request ID must be an integer or string"
            return a successful json rpc operation
        if not message has json member named "id":
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC response is missing id"
        if not json rpc identifier json member named "id" in message is valid:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC response ID must be an integer or string"
        if has_result = has_error:
            return a failed json rpc operation with status the json rpc invalid message status reporting "JSON-RPC response must contain exactly one of result or error"
        if has_error:
            return validate json rpc error object json member named "error" in message
        return a successful json rpc operation

function free json rpc receive result {json rpc receive result:outcome}:
    execute:
        if outcome's message != (0 as a pointer to json value):
            free json value outcome's message
