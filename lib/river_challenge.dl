# Wolf, sheep, and hay river-crossing challenge vocabulary.

import lib/std.dl

class:
    patterns:
        [a|] river passenger
    members:
        identifier as i32

function [the|] sheep:
    replacement:
        @intrinsic("construct", a river passenger, 1 as a 32 bit integer)

function [the|] wolf:
    replacement:
        @intrinsic("construct", a river passenger, 2 as a 32 bit integer)

function [the|] hay:
    replacement:
        @intrinsic("construct", a river passenger, 3 as a 32 bit integer)

set river_farmer_side to 0
set river_boat_cargo to 0 as a 32 bit integer
set river_sheep_side to 0
set river_wolf_side to 0
set river_hay_side to 0
set river_challenge_running to true

local function stop the river crossing with message:
    globals:
        river_challenge_running
    execute:
        print message as line
        set river_challenge_running to false

local function require valid {river passenger:passenger}:
    execute:
        if (the identifier of passenger < 1) or (the identifier of passenger > 3):
            @intrinsic("call", "libc", "abort", void)

local function [the|] river side of {river passenger:passenger}:
    globals:
        river_sheep_side
        river_wolf_side
        river_hay_side
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            return river_sheep_side
        else if the identifier of passenger = 2:
            return river_wolf_side
        else:
            return river_hay_side

local function move {river passenger:passenger} to river side {integer:side}:
    globals:
        river_sheep_side
        river_wolf_side
        river_hay_side
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            set river_sheep_side to side
        else if the identifier of passenger = 2:
            set river_wolf_side to side
        else:
            set river_hay_side to side

local function report loading {river passenger:passenger}:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            print "RIVER|COMMAND|LOAD|SHEEP" as line
        else if the identifier of passenger = 2:
            print "RIVER|COMMAND|LOAD|WOLF" as line
        else:
            print "RIVER|COMMAND|LOAD|HAY" as line

local function report loaded {river passenger:passenger}:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            print "RIVER|ACTION|LOAD|SHEEP" as line
        else if the identifier of passenger = 2:
            print "RIVER|ACTION|LOAD|WOLF" as line
        else:
            print "RIVER|ACTION|LOAD|HAY" as line

local function report unloading {river passenger:passenger}:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            print "RIVER|COMMAND|UNLOAD|SHEEP" as line
        else if the identifier of passenger = 2:
            print "RIVER|COMMAND|UNLOAD|WOLF" as line
        else:
            print "RIVER|COMMAND|UNLOAD|HAY" as line

local function report unloaded {river passenger:passenger}:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            print "RIVER|ACTION|UNLOAD|SHEEP" as line
        else if the identifier of passenger = 2:
            print "RIVER|ACTION|UNLOAD|WOLF" as line
        else:
            print "RIVER|ACTION|UNLOAD|HAY" as line

local function stop because {river passenger:passenger} is missing:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            stop the river crossing with "RIVER|ERROR|there is no sheep to pickup"
        else if the identifier of passenger = 2:
            stop the river crossing with "RIVER|ERROR|there is no wolf to pickup"
        else:
            stop the river crossing with "RIVER|ERROR|there is no hay to pickup"

local function stop because {river passenger:passenger} is not aboard:
    execute:
        require valid passenger
        if the identifier of passenger = 1:
            stop the river crossing with "RIVER|ERROR|the sheep is not in the boat"
        else if the identifier of passenger = 2:
            stop the river crossing with "RIVER|ERROR|the wolf is not in the boat"
        else:
            stop the river crossing with "RIVER|ERROR|the hay is not in the boat"

local function check the river crossing:
    globals:
        river_farmer_side
        river_sheep_side
        river_wolf_side
        river_hay_side
        river_challenge_running
    execute:
        if river_challenge_running:
            if (river_wolf_side = river_sheep_side) and ((river_wolf_side != -1) and (river_farmer_side != river_wolf_side)):
                print "RIVER|DANGER|WOLF|SHEEP" as line
                stop the river crossing with "RIVER|ERROR|the wolf ate the sheep"
            else if (river_sheep_side = river_hay_side) and ((river_sheep_side != -1) and (river_farmer_side != river_sheep_side)):
                print "RIVER|DANGER|SHEEP|HAY" as line
                stop the river crossing with "RIVER|ERROR|the sheep ate the hay"
            else if (river_sheep_side = 1) and ((river_wolf_side = 1) and (river_hay_side = 1)):
                print "RIVER|SUCCESS" as line
                set river_challenge_running to false

function:
    patterns:
        get {river passenger:passenger} in [the|] boat
        get {river passenger:passenger} in
        put {river passenger:passenger} in [the|] boat
        load {river passenger:passenger}
        take {river passenger:passenger} aboard
    globals:
        river_farmer_side
        river_boat_cargo
        river_challenge_running
    execute:
        if river_challenge_running:
            report loading passenger
            if river_boat_cargo != 0:
                stop the river crossing with "RIVER|ERROR|the boat is already carrying something"
            else if the river side of passenger != river_farmer_side:
                stop because passenger is missing
            else:
                set river_boat_cargo to the identifier of passenger
                move passenger to river side -1
                report loaded passenger

function:
    patterns:
        get {river passenger:passenger} out of [the|] boat
        get {river passenger:passenger} out
        put {river passenger:passenger} out
        unload {river passenger:passenger}
        let {river passenger:passenger} out
    globals:
        river_farmer_side
        river_boat_cargo
        river_challenge_running
    execute:
        if river_challenge_running:
            report unloading passenger
            if river_boat_cargo != the identifier of passenger:
                stop because passenger is not aboard
            else:
                set river_boat_cargo to 0 as a 32 bit integer
                move passenger to river side river_farmer_side
                report unloaded passenger
                check the river crossing

function:
    patterns:
        row to the other side
        row to the other bank
        row across the river
        row across the water
        cross to the other side
        cross the river
        cross the water
        row back
        cross back
    globals:
        river_farmer_side
        river_challenge_running
    execute:
        if river_challenge_running:
            print "RIVER|COMMAND|CROSS" as line
            if river_farmer_side = 0:
                set river_farmer_side to 1
                print "RIVER|ACTION|CROSS|FAR" as line
            else:
                set river_farmer_side to 0
                print "RIVER|ACTION|CROSS|HOME" as line
            check the river crossing
