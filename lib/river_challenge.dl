# Wolf, sheep, and hay river-crossing challenge vocabulary.

import lib/std.dl

class:
    patterns:
        [a|] river passenger
    members:
        identifier as a 32 bit integer

local class:
    patterns:
        [a|] river crossing
    members:
        farmer side as an integer
        cargo as a 32 bit integer
        sheep side as an integer
        wolf side as an integer
        hay side as an integer
        activity as a boolean

[the|] sheep means: @intrinsic("construct", a river passenger, 1 as a 32 bit integer)
[the|] wolf means: @intrinsic("construct", a river passenger, 2 as a 32 bit integer)
[the|] hay means: @intrinsic("construct", a river passenger, 3 as a 32 bit integer)
local function [a|] new river crossing:
    replacement:
        @intrinsic("construct", a river crossing, 0, 0 as a 32 bit integer, 0, 0, 0, true)

set challenge to a new river crossing

local function stop the river crossing with message:
    globals:
        challenge
    execute:
        print line message
        set challenge's activity to false

local function ensure {river passenger:passenger} is valid:
    execute:
        if passenger's identifier is not one of 1, 2 and 3:
            abort the program

local function [the|] river side of {river passenger:passenger}:
    globals:
        challenge
    execute:
        ensure passenger is valid
        if passenger's identifier = 1:
            return challenge's sheep side
        else if passenger's identifier = 2:
            return challenge's wolf side
        else:
            return challenge's hay side

local function place {river passenger:passenger} on the river side numbered {integer:side}:
    globals:
        challenge
    execute:
        ensure passenger is valid
        if passenger's identifier = 1:
            set challenge's sheep side to side
        else if passenger's identifier = 2:
            set challenge's wolf side to side
        else:
            set challenge's hay side to side

local function the river passenger name of {river passenger:passenger}:
    execute:
        ensure passenger is valid
        return the item at (passenger's identifier - 1) in ["sheep", "wolf", "hay"]

local function the river passenger code of {river passenger:passenger}:
    execute:
        ensure passenger is valid
        return the item at (passenger's identifier - 1) in ["SHEEP", "WOLF", "HAY"]

local function report river event {C string:phase} {C string:action} for {river passenger:passenger}:
    execute:
        set code to the river passenger code of passenger
        print line formatted "RIVER|{phase}|{action}|{code}"

local function stop because {river passenger:passenger} is missing:
    execute:
        set name to the river passenger name of passenger
        stop the river crossing with formatted "RIVER|ERROR|there is no {name} to pick up"

local function stop because {river passenger:passenger} is not aboard:
    execute:
        set name to the river passenger name of passenger
        stop the river crossing with formatted "RIVER|ERROR|the {name} is not in the boat"

local function check the river crossing:
    globals:
        challenge
    execute:
        if challenge's activity:
            if (challenge's wolf side = challenge's sheep side) and ((challenge's wolf side != -1) and (challenge's farmer side != challenge's wolf side)):
                print line "RIVER|DANGER|WOLF|SHEEP"
                stop the river crossing with "RIVER|ERROR|the wolf ate the sheep"
            else if (challenge's sheep side = challenge's hay side) and ((challenge's sheep side != -1) and (challenge's farmer side != challenge's sheep side)):
                print line "RIVER|DANGER|SHEEP|HAY"
                stop the river crossing with "RIVER|ERROR|the sheep ate the hay"
            else if (challenge's sheep side = 1) and ((challenge's wolf side = 1) and (challenge's hay side = 1)):
                print line "RIVER|SUCCESS"
                set challenge's activity to false

function:
    patterns:
        get {river passenger:passenger} in [the|] boat
        get {river passenger:passenger} in
        put {river passenger:passenger} in [the|] boat
        load {river passenger:passenger}
        take {river passenger:passenger} aboard
    globals:
        challenge
    execute:
        if challenge's activity:
            report river event "COMMAND" "LOAD" for passenger
            if challenge's cargo != 0:
                stop the river crossing with "RIVER|ERROR|the boat is already carrying something"
            else if the river side of passenger != challenge's farmer side:
                stop because passenger is missing
            else:
                set challenge's cargo to passenger's identifier
                place passenger on the river side numbered -1
                report river event "ACTION" "LOAD" for passenger

function:
    patterns:
        get {river passenger:passenger} out of [the|] boat
        get {river passenger:passenger} out
        put {river passenger:passenger} out
        unload {river passenger:passenger}
        let {river passenger:passenger} out
        leave {river passenger:passenger}
        leave {river passenger:passenger} at [the|] other side
    globals:
        challenge
    execute:
        if challenge's activity:
            report river event "COMMAND" "UNLOAD" for passenger
            if challenge's cargo != passenger's identifier:
                stop because passenger is not aboard
            else:
                set challenge's cargo to 0 as a 32 bit integer
                place passenger on the river side numbered challenge's farmer side
                report river event "ACTION" "UNLOAD" for passenger
                check the river crossing

function:
    patterns:
        row to the other side
        row to the other bank
        row across the river
        row across the water
        cross to the other side
        cross the river
        cross the water
        row back
        cross back
    globals:
        challenge
    execute:
        if challenge's activity:
            print line "RIVER|COMMAND|CROSS"
            if challenge's farmer side = 0:
                set challenge's farmer side to 1
                print line "RIVER|ACTION|CROSS|FAR"
            else:
                set challenge's farmer side to 0
                print line "RIVER|ACTION|CROSS|HOME"
            check the river crossing
