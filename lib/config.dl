dynlex options:
    import: "import"
    comment: "#"
    open section: ":"
    section: "section"
    function: "function"
    class:
        name: "class"
        members: "members"
    macro: "macro"
    local: "local"
    child sections:
        execute: "execute"
        replacement: "replacement"
        patterns: "patterns"
        globals: "globals"
        before: "before"
        after: "after"
    messages:
        could not import main file: "couldn't import main file: {path}"
        failed to import source file: "failed to import source file: {path}"
        invalid indentation amount: "Invalid indentation! expected {expected}, but found {found}"
        invalid indentation character: "Invalid indentation! expected only {expected}, but found {found}"
        invalid indentation increase: "Invalid indentation! expected at max {expected}, but found {found}"
        missing body section: "Code without body section"
        unknown section: "Unknown section: {section}"
        unexpected class line: "unexpected line in class definition"
        explicit parameter ambiguity: "Explicit parameter '{parameter}' may be ambiguous with a callable single-word function pattern of the same name."
        explicit parameter ambiguity related parameter: "Parameter is declared here"
        explicit parameter ambiguity related function: "Single-word function pattern with the same name appears here"
        ambiguous single word reference:
            message: "Ambiguous single-word reference '{token}' resolved as a function call, but the same token is also used as a parameter in an enclosing pattern.{suggestion}"
            suggestion fallback: " If this was meant as an argument, rename the variable; otherwise add an extra possible pattern."
            related parameter: "Enclosing parameter candidate appears here"
            related matched pattern: "Matched function pattern appears here"
            related suggestion: "Suggested alternative pattern appears here"
            quick fix: "Use '{spelling}'"
        duplicate pattern definition: "Duplicate pattern definition"
        duplicate pattern definition related existing: "Conflicts with this definition"
        unresolved pattern definition: "This pattern definition couldn't be resolved: {pattern}"
        unresolved pattern:
            message: "This pattern couldn't be resolved"
            related unused parameter candidate: "'{parameter}' isn't a parameter because it is not used:"
            quick fix unused parameter candidate: "Wrap '{parameter}' in curly braces"
        unknown type constraint: "Type constraint '{type_constraint}' does not refer to a known type"
        precedence target not found: "Precedence target not found: {target}"
        precedence cycle detected: "Cycle detected in precedence declarations"
        invalid pattern parse unmatched bracket: "Unmatched '{character}' in pattern"
        invalid pattern parse capture format: "Capture element must have format {type:name}"
        listing section cannot create sections: "you can't create sections in a listing section"
        patterns section cannot create sections: "you can't create sections in a {section_type} section"
        unmatched closing character: "unmatched closing character found: '{character}'"
        unmatched string character: "unmatched string character found: '\"'"
        unknown intrinsic: "unknown intrinsic: \"{intrinsic}\""
        intrinsic wrong argument count: "intrinsic \"{intrinsic}\" expects {expected} argument(s), got {found}"
        pattern whitespace should be single space: "all whitespace in patterns should be a single space"
        invalid reserved placeholder use: "Invalid use of reserved internal placeholder character in source code"
        variable has no type: "Variable '{name}' has no type (never assigned a value)"
        function has no deduced return type: "Function '{function}' has no deduced return type"
        variable type change:
            message: "Variable '{name}' cannot change type from {from_type} to {to_type}"
            related origin: "Variable '{name}' first became {type} here"
            quick fix float literal: "Change '{original}' to '{replacement}'"
        expression type inference failed:
            message: "Expression '{expression}' parses successfully without types, but not with types"
            with detail: "Expression '{expression}' parses successfully without types, but not with types: {detail}"
        too many ambiguous operand groupings: "Too many ambiguous operand groupings"
        ambiguous operand grouping: "Expression '{expression}' has multiple valid operand groupings. Using '{chosen}' instead of '{alternative}'."
        unknown variable: "Unknown variable: {name}"
        unresolved pending expression: "Unresolved pending expression"
        spirv target not available: "SPIR-V target not available: {error}"
        llvm verification failed: "LLVM verification failed: {error}"
        failed to open output file: "Failed to open output file: {error}"
        failed to get target: "Failed to get target: {error}"
        failed to create target machine: "Failed to create target machine"
        failed to open object file: "Could not open object file: {error}"
        target machine cannot emit object file: "Target machine cannot emit object file"
        linking failed:
            message: "Linking failed with exit code {exit_code}"
            missing libraries: "Missing libraries: {libraries}"
            install hint: "Search online for installation instructions for your system."
        select condition must be compile time known: "select condition must be compile-time known"
        class has no properties: "{type} is not a class and has no properties"
        class missing property: "{type} doesn't have property \"{property}\""
        unknown shader input: "Unknown shader input: {name}"
        shader input unavailable: "Shader input '{name}' is unavailable in this compilation mode"
        shader output unavailable: "Shader output is unavailable in this compilation mode"
        spirv output open failed: "Could not open SPIR-V output file: {error}"
        spirv target cannot emit object file: "SPIR-V target cannot emit object file"
        spirv patch failed: "{error}"
        array literal element type mismatch: "Array literal elements must have matching or compatible numeric types"
        compile time type value used at runtime: "compile-time type values cannot be used as runtime values"
        load at requires pointer: "load at requires a pointer argument"
        call return type must be type reference: "call return type must be a compile-time type reference"
        call return type must be concrete runtime type: "call return type must be a concrete runtime type"
        call arguments cannot be type values: "call arguments cannot be compile-time type values"
        build info key must be string literal: "build info key must be a compile-time string literal"
        unknown build info key: "Unknown build info key '{key}'"
        build target must be string literal: "build target must be a compile-time string literal"
        unknown build target: "Unknown build target '{target}'"
        shader stage must be string literal: "shader stage must be a compile-time string literal"
        unknown shader stage: "Unknown shader stage '{stage}'"
        size of type invalid: "size of 'type' is invalid"
        vector size invalid: "vector size must be a compile-time integer greater than 0"
        matrix dimensions invalid: "matrix dimensions must be compile-time integers greater than 0"
        pointer to type invalid: "pointer to 'type' is invalid"
        undeduced argument type in trial inference: "Undeduced argument type encountered during trial pattern-call inference"
        variable usage warning:
            pattern argument assigned before read: "Pattern argument '{name}' is assigned before being read"
            variable read before assigned: "Variable '{name}' may be read before being assigned"
            related argument definition: "Defined as argument here"
            related assignment: "Assigned here"
        incompatible operand types: "Incompatible operand types '{left_type}' and '{right_type}'"
        logical operator operands invalid: "Logical operator '{operator}' requires boolean operands, got '{left_type}' and '{right_type}'"
        logical operator operand invalid: "Logical operator '{operator}' requires a boolean operand, got '{value_type}'"
        bitwise operator operands invalid: "Bitwise operator '{operator}' requires integer operands, got '{left_type}' and '{right_type}'"
        bitwise operator operand invalid: "Bitwise operator '{operator}' requires an integer operand, got '{value_type}'"
        invalid cast source type: "Invalid cast source type '{source_type}'"
        unsupported cast: "Unsupported cast from '{from_type}' to '{to_type}'"
        no overload matches call:
            message: "No overload matches call '{call}' for argument types [{argument_types}]"
            with overloads: "No overload matches call '{call}' for argument types [{argument_types}]. Available overloads: {overloads}"
        recursive type inference did not converge: "Recursive type inference did not converge for function '{function}'"
