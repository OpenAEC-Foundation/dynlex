# Internal snapshot, normalized-change, and commit-plan storage.

import lib/workspace_edit_state.dl

class:
    patterns:
        [a|] workspace resource snapshot
    members:
        active as boolean
        original path as string
        original identity as string
        path as string
        identity as string
        relative path as string
        first change index as i32
        disk exists as boolean
        disk kind as i32
        disk content as string
        disk modification time supported as boolean
        disk modification time as a file system timestamp
        filesystem exists as boolean
        filesystem kind as i32
        exists as boolean
        kind as i32
        content as string
        descendants scanned as boolean
        open document as a pointer to workspace open document
        open snapshot present as boolean
        open path as string
        open identity as string
        open text as string
        open version as i32
        virtual version as i32

class:
    patterns:
        [a|] workspace resource snapshot collection
    members:
        items as a pointer to a pointer to workspace resource snapshot
        length as i32
        capacity as i32

class:
    patterns:
        [a|] normalized workspace change
    members:
        source change as a pointer to workspace edit change
        path as string
        identity as string
        relative path as string
        old path as string
        old identity as string
        old relative path as string
        new path as string
        new identity as string
        new relative path as string

class:
    patterns:
        [a|] normalized workspace change collection
    members:
        items as a pointer to a pointer to normalized workspace change
        length as i32
        capacity as i32

class:
    patterns:
        [a|] planned workspace operation
    members:
        protocol index as i32
        kind as i32
        skip as boolean
        path as string
        identity as string
        old path as string
        old identity as string
        new path as string
        new identity as string
        text as string
        directory as boolean
        overwrite target as boolean
        open document as a pointer to workspace open document

class:
    patterns:
        [a|] planned workspace operation collection
    members:
        items as a pointer to a pointer to planned workspace operation
        length as i32
        capacity as i32

class:
    patterns:
        [a|] workspace edit plan
    members:
        validity as boolean
        outcome as workspace edit result
        resources as a pointer to workspace resource snapshot collection
        normalized changes as a pointer to normalized workspace change collection
        operations as a pointer to planned workspace operation collection

function the workspace regular file resource kind:
    replacement:
        1

function the workspace directory resource kind:
    replacement:
        2

function {a pointer to workspace edit plan:plan} is valid:
    replacement:
        the validity of plan

function {a pointer to workspace edit plan:plan} is invalid:
    replacement:
        the inverse of the validity of plan

local function a new workspace resource snapshot collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a workspace resource snapshot collection,
            0 as a pointer to a pointer to workspace resource snapshot,
            0,
            0
        )
        set result to allocate 1 slots of initial
        return result

function append workspace resource snapshot {a pointer to workspace resource snapshot:value} to {a pointer to workspace resource snapshot collection:collection}:
    execute:
        if the length of collection = the capacity of collection:
            set growth to ((the capacity of collection) * 2)
            if growth < 4:
                set growth to 4
            set resized to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to a pointer to workspace resource snapshot,
                the items of collection,
                growth * the size of a pointer to workspace resource snapshot
            )
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to ((the length of collection) + 1)

function workspace resource snapshot at {integer:position} in {a pointer to workspace resource snapshot collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

local function a new normalized workspace change collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a normalized workspace change collection,
            0 as a pointer to a pointer to normalized workspace change,
            0,
            0
        )
        set result to allocate 1 slots of initial
        return result

function append normalized workspace change {a pointer to normalized workspace change:value} to {a pointer to normalized workspace change collection:collection}:
    execute:
        if the length of collection = the capacity of collection:
            set growth to ((the capacity of collection) * 2)
            if growth < 4:
                set growth to 4
            set resized to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to a pointer to normalized workspace change,
                the items of collection,
                growth * the size of a pointer to normalized workspace change
            )
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to ((the length of collection) + 1)

function normalized workspace change at {integer:position} in {a pointer to normalized workspace change collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

local function a new planned workspace operation collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a planned workspace operation collection,
            0 as a pointer to a pointer to planned workspace operation,
            0,
            0
        )
        set result to allocate 1 slots of initial
        return result

function append planned workspace operation {a pointer to planned workspace operation:value} to {a pointer to planned workspace operation collection:collection}:
    execute:
        if the length of collection = the capacity of collection:
            set growth to ((the capacity of collection) * 2)
            if growth < 4:
                set growth to 4
            set resized to @intrinsic(
                "call",
                "libc",
                "realloc",
                a pointer to a pointer to planned workspace operation,
                the items of collection,
                growth * the size of a pointer to planned workspace operation
            )
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to ((the length of collection) + 1)

function planned workspace operation at {integer:position} in {a pointer to planned workspace operation collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

function a new valid workspace edit plan:
    execute:
        set resources to a new workspace resource snapshot collection
        set changes to a new normalized workspace change collection
        set operations to a new planned workspace operation collection
        set initial to @intrinsic(
            "construct",
            a workspace edit plan,
            true,
            a successful workspace edit result,
            resources,
            changes,
            operations
        )
        set result to allocate 1 slots of initial
        return result

function invalidate workspace edit plan {a pointer to workspace edit plan:plan} with {workspace edit result:failure}:
    execute:
        set the validity of plan to false
        set the outcome of plan to failure

function free {a pointer to workspace edit plan:plan}:
    execute:
        if plan = (0 as a pointer to workspace edit plan):
            @intrinsic("return")
        set resources to the resources of plan
        set position to 0
        loop while position < the length of resources:
            set resource to workspace resource snapshot at position in resources
            @intrinsic("destroy at", resource)
            @intrinsic("call", "libc", "free", nothing, resource)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of resources)
        @intrinsic("destroy at", resources)
        @intrinsic("call", "libc", "free", nothing, resources)
        set changes to the normalized changes of plan
        set position to 0
        loop while position < the length of changes:
            set change to normalized workspace change at position in changes
            @intrinsic("destroy at", change)
            @intrinsic("call", "libc", "free", nothing, change)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of changes)
        @intrinsic("destroy at", changes)
        @intrinsic("call", "libc", "free", nothing, changes)
        set operations to the operations of plan
        set position to 0
        loop while position < the length of operations:
            set operation to planned workspace operation at position in operations
            @intrinsic("destroy at", operation)
            @intrinsic("call", "libc", "free", nothing, operation)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of operations)
        @intrinsic("destroy at", operations)
        @intrinsic("call", "libc", "free", nothing, operations)
        @intrinsic("destroy at", plan)
        @intrinsic("call", "libc", "free", nothing, plan)
