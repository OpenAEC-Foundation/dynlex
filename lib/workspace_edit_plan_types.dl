# Internal snapshot, normalized-change, and commit-plan storage.

import lib/workspace_edit_state.dl

class:
    patterns:
        [a|] workspace resource snapshot
    members:
        activity as a boolean
        original path as a string
        original identity as a string
        path as a string
        identity as a string
        relative path as a string
        first change index as a 32 bit integer
        disk presence as a boolean
        disk kind as a 32 bit integer
        disk content as a string
        disk modification time support as a boolean
        disk modification time as a file system timestamp
        filesystem presence as a boolean
        filesystem kind as a 32 bit integer
        presence as a boolean
        kind as a 32 bit integer
        content as a string
        descendant scan completion as a boolean
        open document as a pointer to a workspace open document
        open snapshot presence as a boolean
        open path as a string
        open identity as a string
        open text as a string
        open version as a 32 bit integer
        virtual version as a 32 bit integer

class:
    patterns:
        [a|] workspace resource snapshot collection
    members:
        items as a pointer to a pointer to a workspace resource snapshot
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] normalized workspace change
    members:
        source change as a pointer to a workspace edit change
        path as a string
        identity as a string
        relative path as a string
        old path as a string
        old identity as a string
        old relative path as a string
        new path as a string
        new identity as a string
        new relative path as a string

class:
    patterns:
        [a|] normalized workspace change collection
    members:
        items as a pointer to a pointer to a normalized workspace change
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] planned workspace operation
    members:
        protocol index as a 32 bit integer
        kind as a 32 bit integer
        skip as a boolean
        path as a string
        identity as a string
        old path as a string
        old identity as a string
        new path as a string
        new identity as a string
        text as a string
        directory as a boolean
        overwrite target as a boolean
        open document as a pointer to a workspace open document

class:
    patterns:
        [a|] planned workspace operation collection
    members:
        items as a pointer to a pointer to a planned workspace operation
        length as a 32 bit integer
        capacity as a 32 bit integer

class:
    patterns:
        [a|] workspace edit plan
    members:
        validity as a boolean
        outcome as a workspace edit result
        resources as a pointer to a workspace resource snapshot collection
        normalized changes as a pointer to a normalized workspace change collection
        operations as a pointer to a planned workspace operation collection

function the workspace regular file resource kind:
    replacement:
        1

function the workspace directory resource kind:
    replacement:
        2

function {a pointer to a workspace edit plan:plan} is valid:
    replacement:
        the validity of plan

function {a pointer to a workspace edit plan:plan} is invalid:
    replacement:
        the inverse of the validity of plan

local function a new workspace resource snapshot collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a workspace resource snapshot collection,
            0 as a pointer to a pointer to a workspace resource snapshot,
            0,
            0
        )
        allocate one slot of initial and set result to it
        return result

function append workspace resource snapshot {a pointer to a workspace resource snapshot:value} to {a pointer to a workspace resource snapshot collection:collection}:
    execute:
        set required to the collection length after adding one item to the length of collection
        set growth to the collection capacity from the capacity of collection expanded to hold required items
        if growth > the capacity of collection:
            set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a workspace resource snapshot
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to required

function the workspace resource snapshot at {integer:position} in {a pointer to a workspace resource snapshot collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

local function a new normalized workspace change collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a normalized workspace change collection,
            0 as a pointer to a pointer to a normalized workspace change,
            0,
            0
        )
        allocate one slot of initial and set result to it
        return result

function append normalized workspace change {a pointer to a normalized workspace change:value} to {a pointer to a normalized workspace change collection:collection}:
    execute:
        set required to the collection length after adding one item to the length of collection
        set growth to the collection capacity from the capacity of collection expanded to hold required items
        if growth > the capacity of collection:
            set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a normalized workspace change
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to required

function the normalized workspace change at {integer:position} in {a pointer to a normalized workspace change collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

local function a new planned workspace operation collection:
    execute:
        set initial to @intrinsic(
            "construct",
            a planned workspace operation collection,
            0 as a pointer to a pointer to a planned workspace operation,
            0,
            0
        )
        allocate one slot of initial and set result to it
        return result

function append planned workspace operation {a pointer to a planned workspace operation:value} to {a pointer to a planned workspace operation collection:collection}:
    execute:
        set required to the collection length after adding one item to the length of collection
        set growth to the collection capacity from the capacity of collection expanded to hold required items
        if growth > the capacity of collection:
            set resized to the checked allocation from ((the items of collection) as a pointer) resized to growth items of a pointer to a planned workspace operation
            set the items of collection to resized
            set the capacity of collection to growth
        @intrinsic("initialize at", (the items of collection) + (the length of collection), value)
        set the length of collection to required

function the planned workspace operation at {integer:position} in {a pointer to a planned workspace operation collection:collection}:
    execute:
        if position < 0 or position >= the length of collection:
            @intrinsic("call", "libc", "abort", nothing)
        return the item at position in the items of collection

function a new valid workspace edit plan:
    execute:
        set resources to a new workspace resource snapshot collection
        set changes to a new normalized workspace change collection
        set operations to a new planned workspace operation collection
        set initial to @intrinsic(
            "construct",
            a workspace edit plan,
            true,
            a successful workspace edit result,
            resources,
            changes,
            operations
        )
        allocate one slot of initial and set result to it
        return result

function invalidate {a pointer to a workspace edit plan:plan} with {workspace edit result:failure}:
    execute:
        set the validity of plan to false
        set the outcome of plan to failure

function free {a pointer to a workspace edit plan:plan}:
    execute:
        if plan = (0 as a pointer to a workspace edit plan):
            @intrinsic("return")
        set resources to the resources of plan
        set position to 0
        loop while position < the length of resources:
            set resource to the workspace resource snapshot at position in resources
            @intrinsic("destroy at", resource)
            @intrinsic("call", "libc", "free", nothing, resource)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of resources)
        @intrinsic("destroy at", resources)
        @intrinsic("call", "libc", "free", nothing, resources)
        set changes to the normalized changes of plan
        set position to 0
        loop while position < the length of changes:
            set change to the normalized workspace change at position in changes
            @intrinsic("destroy at", change)
            @intrinsic("call", "libc", "free", nothing, change)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of changes)
        @intrinsic("destroy at", changes)
        @intrinsic("call", "libc", "free", nothing, changes)
        set operations to the operations of plan
        set position to 0
        loop while position < the length of operations:
            set operation to the planned workspace operation at position in operations
            @intrinsic("destroy at", operation)
            @intrinsic("call", "libc", "free", nothing, operation)
            set position to (position + 1)
        @intrinsic("call", "libc", "free", nothing, the items of operations)
        @intrinsic("destroy at", operations)
        @intrinsic("call", "libc", "free", nothing, operations)
        @intrinsic("destroy at", plan)
        @intrinsic("call", "libc", "free", nothing, plan)
