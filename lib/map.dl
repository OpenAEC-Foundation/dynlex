# DynLex Map Library

import lib/list.dl

class:
    patterns:
        [a|] map
    members:
        keys
        values

to get an empty map from {type:domain} to {type:range}:
    set keys to an empty list of domain
    set values to an empty list of range
    set initial to @intrinsic("construct", a map, keys, values)
    set result to storage for one slot initialized with initial
    return result

to get the number of entries in {a pointer to a map:mapping}:
    return the length of the keys of mapping

to get the index of key in {a pointer to a map:mapping}:
    set cursor to 0
    loop while cursor < the length of the keys of mapping:
        if the item at cursor in the keys of mapping = key:
            return cursor
        increment cursor
    return -1

to get {a pointer to a map:mapping} contains key {a value:key}:
    return the index of key in mapping >= 0

to get the value for key in {a pointer to a map:mapping}:
    set position to the index of key in mapping
    if position < 0:
        abort the program
    return the item at position in the values of mapping

to put value for key in {a pointer to a map:mapping}:
    set position to the index of key in mapping
    if position >= 0:
        store value into the data of the values of mapping at position
    else:
        append key to the keys of mapping
        append value to the values of mapping

to remove key from {a pointer to a map:mapping}:
    set position to the index of key in mapping
    if position >= 0:
        remove item position from the keys of mapping
        remove item position from the values of mapping

to clear {a pointer to a map:mapping}:
    clear the keys of mapping
    clear the values of mapping

to free {a pointer to a map:mapping}:
    free (the keys of mapping)
    free (the values of mapping)
    deallocate mapping
