import lib/vulkan_pipeline.dl

function [create the graphics uniform layout in] {a pointer to DynlexGraphicsPipeline:pipeline}:
    execute:
        set state to pipeline's owner
        set vertex to @intrinsic("construct", a graphics SPIR-V module, pipeline's vertex_code, pipeline's vertex_word_count)
        set fragment to @intrinsic("construct", a graphics SPIR-V module, pipeline's fragment_code, pipeline's fragment_word_count)
        set vertexBindings to the graphics uniform bindings of vertex
        set fragmentBindings to the graphics uniform bindings of fragment
        set descriptors to a new (VkDescriptorSetLayoutBinding array of 32 items)
        set binding to 0 as a 32 bit unsigned integer
        loop while binding < (the length of vertexBindings):
            if (the item at binding in vertexBindings) or (the item at binding in fragmentBindings):
                set index to pipeline's binding_count
                store binding into pipeline's bindings at index
                set descriptor to a new VkDescriptorSetLayoutBinding
                set descriptor's binding to binding
                set descriptor's descriptorType to 6
                set descriptor's descriptorCount to 1 as a 32 bit unsigned integer
                set descriptor's stageFlags to 17 as a 32 bit unsigned integer
                store descriptor into descriptors at index
                set pipeline's binding_count to index + 1
            increment binding
        set layout to a new VkPipelineLayoutCreateInfo
        set layout's sType to 30
        if pipeline's binding_count > 0:
            set creation to a new VkDescriptorSetLayoutCreateInfo
            set creation's sType to 32
            set creation's bindingCount to pipeline's binding_count
            set creation's pBindings to descriptors + 0
            require Vulkan status @intrinsic("call", "vulkan", "vkCreateDescriptorSetLayout", an integer, state's device, the address of creation, 0 as a pointer, the address of (pipeline's descriptor_layout)) for "Creating a uniform descriptor layout"
            set layout's setLayoutCount to 1 as a 32 bit unsigned integer
            set layout's pSetLayouts to the address of (pipeline's descriptor_layout)
        require Vulkan status @intrinsic("call", "vulkan", "vkCreatePipelineLayout", an integer, state's device, the address of layout, 0 as a pointer, the address of (pipeline's layout)) for "Creating a shader pipeline layout"
        if pipeline's binding_count = 0:
            return nothing
        set alignment to state's physical_properties' limits' minUniformBufferOffsetAlignment
        set pipeline's uniform_stride to alignment if alignment > 4, else (4 as a 64 bit unsigned integer)
        set layouts to [pipeline's descriptor_layout, pipeline's descriptor_layout]
        set allocation to a new VkDescriptorSetAllocateInfo
        set allocation's sType to 34
        set allocation's descriptorPool to state's descriptor_pool
        set allocation's descriptorSetCount to (the length of layouts) as a 32 bit unsigned integer
        set allocation's pSetLayouts to layouts + 0
        require Vulkan status @intrinsic("call", "vulkan", "vkAllocateDescriptorSets", an integer, state's device, the address of allocation, pipeline's descriptor_sets + 0) for "Allocating uniform descriptor sets"
        set pipeline's descriptor_sets_allocated to true
        set frame to 0 as a 32 bit unsigned integer
        loop while frame < (the length of pipeline's descriptor_sets):
            set size to pipeline's uniform_stride * pipeline's binding_count
            set buffer to a Vulkan buffer of size bytes with usage (16 as a 32 bit unsigned integer) and memory flags (6 as a 32 bit unsigned integer) in state
            store buffer's handle into pipeline's uniform_buffers at frame
            store buffer's memory into pipeline's uniform_memory at frame
            set mapped to Vulkan memory buffer's memory mapped for size bytes in state
            store (mapped as a pointer to a byte) into pipeline's uniform_maps at frame
            set buffers to a new (VkDescriptorBufferInfo array of 32 items)
            set writes to a new (VkWriteDescriptorSet array of 32 items)
            set index to 0 as a 32 bit unsigned integer
            loop while index < pipeline's binding_count:
                set information to the address of (the item at index in buffers)
                set information's buffer to buffer's handle
                set information's offset to pipeline's uniform_stride * index
                set information's range to 4 as a 64 bit unsigned integer
                set write to the address of (the item at index in writes)
                set write's sType to 35
                set write's dstSet to the item at frame in (pipeline's descriptor_sets)
                set write's dstBinding to the item at index in (pipeline's bindings)
                set write's descriptorCount to 1 as a 32 bit unsigned integer
                set write's descriptorType to 6
                set write's pBufferInfo to information
                increment index
            @intrinsic("call", "vulkan", "vkUpdateDescriptorSets", nothing, state's device, pipeline's binding_count, writes + 0, 0, 0 as a pointer)
            increment frame

function [build the custom graphics pipeline in] {a pointer to DynlexGraphicsPipeline:pipeline}:
    execute:
        set vertex to @intrinsic("construct", a graphics SPIR-V module, pipeline's vertex_code, pipeline's vertex_word_count)
        set fragment to @intrinsic("construct", a graphics SPIR-V module, pipeline's fragment_code, pipeline's fragment_word_count)
        set attribute to a new VkVertexInputAttributeDescription
        set attribute's format to 109
        set pipeline's pipeline to a Vulkan pipeline for vertex vertex fragment fragment layout pipeline's layout topology 4 stride (16 as a 32 bit unsigned integer) attributes (the address of attribute) count (1 as a 32 bit unsigned integer) depth false in pipeline's owner

function [a custom graphics pipeline using vertex file] {C string:vertexPath} [and fragment file] {C string:fragmentPath} [in] {a pointer to DynlexGraphics:state}:
    execute:
        set pipeline to @intrinsic("call", "libc", "calloc", a pointer to DynlexGraphicsPipeline, 1 as a word sized integer, the size of DynlexGraphicsPipeline)
        require condition (pipeline != (0 as a pointer to DynlexGraphicsPipeline)) reporting "Could not allocate a graphics pipeline"
        set pipeline's owner to state
        set vertex to a graphics SPIR-V module loaded from vertexPath
        set fragment to a graphics SPIR-V module loaded from fragmentPath
        set pipeline's vertex_code to vertex's words
        set pipeline's vertex_word_count to vertex's count
        set pipeline's fragment_code to fragment's words
        set pipeline's fragment_word_count to fragment's count
        create the graphics uniform layout in pipeline
        build the custom graphics pipeline in pipeline
        set pipeline's next to state's pipelines
        set state's pipelines to pipeline
        return pipeline

function [destroy the custom graphics pipeline resources in] {a pointer to DynlexGraphicsPipeline:pipeline}:
    execute:
        set state to pipeline's owner
        @intrinsic("call", "vulkan", "vkDestroyPipeline", nothing, state's device, pipeline's pipeline, 0 as a pointer)
        @intrinsic("call", "vulkan", "vkDestroyPipelineLayout", nothing, state's device, pipeline's layout, 0 as a pointer)
        if pipeline's descriptor_sets_allocated:
            require Vulkan status @intrinsic("call", "vulkan", "vkFreeDescriptorSets", an integer, state's device, state's descriptor_pool, (the length of pipeline's descriptor_sets) as a 32 bit unsigned integer, pipeline's descriptor_sets + 0) for "Releasing uniform descriptor sets"
            set frame to 0
            loop while frame < (the length of pipeline's uniform_memory):
                @intrinsic("call", "vulkan", "vkUnmapMemory", nothing, state's device, the item at frame in (pipeline's uniform_memory))
                @intrinsic("call", "vulkan", "vkDestroyBuffer", nothing, state's device, the item at frame in (pipeline's uniform_buffers), 0 as a pointer)
                @intrinsic("call", "vulkan", "vkFreeMemory", nothing, state's device, the item at frame in (pipeline's uniform_memory), 0 as a pointer)
                increment frame
            @intrinsic("call", "vulkan", "vkDestroyDescriptorSetLayout", nothing, state's device, pipeline's descriptor_layout, 0 as a pointer)
        @intrinsic("call", "libc", "free", nothing, pipeline's vertex_code)
        @intrinsic("call", "libc", "free", nothing, pipeline's fragment_code)
        @intrinsic("call", "libc", "free", nothing, pipeline)

function [release the custom graphics pipeline] {a pointer to DynlexGraphicsPipeline:pipeline}:
    execute:
        set state to pipeline's owner
        require condition (state's frame_active = false) reporting "A graphics pipeline cannot be released during an active frame"
        require Vulkan status @intrinsic("call", "vulkan", "vkDeviceWaitIdle", an integer, state's device) for "Waiting to release a shader pipeline"
        if state's active_pipeline = pipeline:
            set state's active_pipeline to 0 as a pointer to DynlexGraphicsPipeline
        set link to the address of (state's pipelines)
        loop while @intrinsic("dereference", link) != pipeline:
            set link to the address of (link's next)
        @intrinsic("store at", link, pipeline's next)
        destroy the custom graphics pipeline resources in pipeline
