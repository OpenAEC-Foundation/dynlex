    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return reply to json rpc request request_node with result_node using session

function reply to lsp server request {a pointer to json value:request_node} with error code {integer:error_code} message {any:error_text} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return reply to json rpc request request_node with error code error_code message error_text using session

function reply to lsp server request {a pointer to json value:request_node} with error code {integer:error_code} message {any:error_text} and data {a pointer to json value:data_node} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return reply to json rpc request request_node with error code error_code message error_text and data data_node using session

local function lsp diagnostic report index for {string:document_uri} in {a pointer to lsp client:state}:
    execute:
        set reports to state's diagnostic_reports
        set cursor to 0
        loop while cursor < the length of reports:
            set report_state to @intrinsic("cast", item cursor of reports, a pointer to lsp diagnostic report)
            if report_state's uri = document_uri:
                return cursor
            set cursor to cursor + 1
        return 0 - 1

local function update lsp diagnostics from {a pointer to json value:envelope_node} using {a pointer to lsp client:state}:
    execute:
        if not envelope_node has json member named "params":
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP publishDiagnostics notification is missing params"
        set parameters to json member named "params" in envelope_node
        if not parameters is a json object:
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP publishDiagnostics params must be an object"
        if not parameters has json member named "uri":
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP publishDiagnostics params are missing uri"
        if not parameters has json member named "diagnostics":
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP publishDiagnostics params are missing diagnostics"
        set uri_node to json member named "uri" in parameters
        set diagnostics_node to json member named "diagnostics" in parameters
        if the kind of uri_node != the json text kind:
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP diagnostic uri must be text"
        if not diagnostics_node is a json array:
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP diagnostics must be an array"
        set diagnostic_cursor to 0
        loop while diagnostic_cursor < the number of json items in diagnostics_node:
            set diagnostic_node to json value at index diagnostic_cursor in diagnostics_node
            if not lsp diagnostic is valid in diagnostic_node:
                return a failed json rpc operation with status the lsp invalid response status reporting "LSP diagnostics contain an invalid Diagnostic"
            set diagnostic_cursor to diagnostic_cursor + 1
        set has_version to false
        set document_version to 0
        if parameters has json member named "version":
            set version_node to json member named "version" in parameters
            if not lsp integer value is valid in version_node:
                return a failed json rpc operation with status the lsp invalid response status reporting "LSP diagnostic version must be an integer"
            set version_number to the number of version_node
            set has_version to true
            set document_version to version_number as i32
        set document_uri to the text of uri_node
        set copied_diagnostics to duplicate json rpc node diagnostics_node
        set report_index to lsp diagnostic report index for document_uri in state
        if report_index >= 0:
            set reports to state's diagnostic_reports
            set report to @intrinsic("cast", item report_index of reports, a pointer to lsp diagnostic report)
            free json value report's diagnostics
            set report's has_version to has_version
            set report's version to document_version
            set report's diagnostics to copied_diagnostics
            return a successful json rpc operation
        set initial_report to @intrinsic("construct", an lsp diagnostic report, document_uri, has_version, document_version, copied_diagnostics)
        set report to allocate 1 slots of initial_report
        set reports to state's diagnostic_reports
        append report to reports
        return a successful json rpc operation

local function queue lsp notification {a pointer to json value:envelope_node} using {a pointer to lsp client:state}:
    execute:
        set notifications to state's notifications
        set session to state's rpc_session
        set connection to session's connection
        set maximum_queue_length to connection's limits's maximum_queue_length
        if the length of notifications >= maximum_queue_length:
            free json value envelope_node
            return a failed json rpc operation with status the json rpc limit exceeded status reporting "The LSP notification queue is full"
        append envelope_node to notifications
        return a successful json rpc operation

local function dispatch next lsp notification using {a pointer to lsp client:state}:
    execute:
        set session to state's rpc_session
        set queued to take next json rpc notification from session
        if not queued's succeeded:
            return a successful json rpc operation
        set envelope_node to queued's message
        set method_name to json text named "method" in envelope_node
        if method_name = "textDocument/publishDiagnostics":
            set updated to update lsp diagnostics from envelope_node using state
            if updated's succeeded:
                free json rpc queued message queued
                return updated
            set queued_result to queue lsp notification envelope_node using state
            if not queued_result's succeeded:
                return queued_result
            set update_text to updated's error message
            return a failed json rpc operation with status updated's status reporting update_text
        return queue lsp notification envelope_node using state

function pump one lsp message using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        set pending_notifications to session's notifications
        if the length of pending_notifications > 0:
            return dispatch next lsp notification using state
        set pumped to pump one json rpc message using session
        if not pumped's succeeded:
            return pumped
        return dispatch next lsp notification using state

function pump one lsp message using {a pointer to lsp client:state} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        if timeout_ms < 0:
            return a failed json rpc operation with status the json rpc timeout status reporting "LSP pump timeout must not be negative"
        set session to state's rpc_session
        set pending_notifications to session's notifications
        if the length of pending_notifications > 0:
            return dispatch next lsp notification using state
        set pumped to pump one json rpc message using session waiting up to timeout_ms milliseconds
        if not pumped's succeeded:
            return pumped
        return dispatch next lsp notification using state

function take next lsp server request from {a pointer to lsp client:state}:
    execute:
        set session to state's rpc_session
        return take next json rpc server request from session

function take next lsp protocol diagnostic from {a pointer to lsp client:state}:
    execute:
        set session to state's rpc_session
        return take next json rpc diagnostic from session

function take next lsp notification from {a pointer to lsp client:state}:
    execute:
        set notifications to state's notifications
        if the length of notifications = 0:
            return @intrinsic(
                "construct",
                a json rpc queued message,
                false,
                the json rpc queue empty status,
                an empty lsp json node,
                the string form of "LSP notification queue is empty"
            )
        set envelope_node to @intrinsic("cast", item 0 of notifications, a pointer to json value)
        remove item 0 from notifications
        return @intrinsic(
            "construct",
            a json rpc queued message,
            true,
            the json rpc success status,
            envelope_node,
            an empty lsp text
        )

function reject lsp server request {a pointer to json value:request_node} as method not found using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return reply to json rpc request request_node with error code the json rpc method not found code message "Method not found" using session

function lsp diagnostics for uri {any:document_uri} in {a pointer to lsp client:state}:
    execute:
        set uri_text to the string form of document_uri
        set report_index to lsp diagnostic report index for uri_text in state
        if report_index < 0:
            return @intrinsic("construct", an lsp diagnostics result, false, false, 0, an empty lsp json node)
        set reports to state's diagnostic_reports
        set report to @intrinsic("cast", item report_index of reports, a pointer to lsp diagnostic report)
        return @intrinsic("construct", an lsp diagnostics result, true, report's has_version, report's version, report's diagnostics)

function lsp standard error from {a pointer to lsp client:state}:
    execute:
        set session to state's rpc_session
        set connection to session's connection
        return connection's standard_error

function shutdown lsp client {a pointer to lsp client:state} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        if timeout_ms < 0:
            return a failed json rpc operation with status the json rpc timeout status reporting "LSP shutdown timeout must not be negative"
        set state's lifecycle to the lsp shutdown lifecycle
        set session to state's rpc_session
        set sent to send json rpc request "shutdown" using session
        if not sent's succeeded:
            set send_text to sent's error message
            return a failed json rpc operation with status sent's status reporting send_text
        set request_id to sent's request id
        set response to await json rpc response for request_id using session waiting up to timeout_ms milliseconds
        if not response's succeeded:
            set response_text to response's error message
            set response_status to response's status
            free json rpc response response
            return a failed json rpc operation with status response_status reporting response_text
        if not response's result is json null:
            free json rpc response response
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP shutdown result must be null"
        free json rpc response response
        set exited to send json rpc session notification "exit" using session
        if not exited's succeeded:
            set exit_text to exited's error message
            return a failed json rpc operation with status exited's status reporting exit_text
        set connection to session's connection
        set closed to close json rpc connection connection
        set state's lifecycle to the lsp stopped lifecycle
        if not closed's succeeded:
            set close_text to closed's error message
            return a failed json rpc operation with status closed's status reporting close_text
        return a successful json rpc operation

local function free lsp documents in {a pointer to list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set document to @intrinsic("cast", item cursor of values, a pointer to lsp document)
            @intrinsic("destroy at", document)
            @intrinsic("call", "libc", "free", void, document)
            set cursor to cursor + 1
        free list values

local function free lsp diagnostic reports in {a pointer to list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set report to @intrinsic("cast", item cursor of values, a pointer to lsp diagnostic report)
            free json value report's diagnostics
            @intrinsic("destroy at", report)
            @intrinsic("call", "libc", "free", void, report)
            set cursor to cursor + 1
        free list values

local function free lsp notifications in {a pointer to list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set envelope_node to @intrinsic("cast", item cursor of values, a pointer to json value)
            free json value envelope_node
            set cursor to cursor + 1
        free list values

function free lsp client {a pointer to lsp client:state}:
    execute:
        set server_capabilities to state's server_capabilities
        if server_capabilities != (an empty lsp json node):
            free json value server_capabilities
        set documents to state's documents
        set reports to state's diagnostic_reports
        set notifications to state's notifications
        free lsp documents in documents
        free lsp diagnostic reports in reports
        free lsp notifications in notifications
        set owned_session to state's rpc_session
        free json rpc session owned_session
        @intrinsic("call", "libc", "free", void, state)
