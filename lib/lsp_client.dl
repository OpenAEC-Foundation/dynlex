        set session to state's rpc_session
        return send json rpc request method_name and identifier id_node using session

function send lsp notification {any:method_name} with {a pointer to json value:parameter_node} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return send json rpc session notification method_name with parameter_node using session

function send lsp notification {any:method_name} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed json rpc operation with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return send json rpc session notification method_name using session

function await lsp response for {string:identifier_text} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp response with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return await json rpc response for identifier_text using session

function await lsp response for {string:identifier_text} using {a pointer to lsp client:state} waiting up to {integer:timeout_ms} milliseconds:
