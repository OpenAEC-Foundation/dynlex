# Language Server Protocol lifecycle, capability negotiation, and dispatch.

import lib/lsp_types.dl
import lib/lsp_json.dl

local function an empty LSP text:
    replacement:
        the string form of ""

local function an empty LSP JSON node:
    replacement:
        0 as a pointer to a JSON value

local function an empty LSP client pointer:
    replacement:
        0 as a pointer to an LSP client

local function a successful LSP client result containing {a pointer to an LSP client:state}:
    replacement:
        @intrinsic("construct", an LSP client result, true, the JSON-RPC success status, state, an empty LSP text)

local function a failed LSP client result with status {integer:status} reporting {string:error}:
    replacement:
        @intrinsic("construct", an LSP client result, false, status, an empty LSP client pointer, error)

local function a failed LSP client result with status {integer:code} reporting {C string:error}:
    execute:
        return a failed LSP client result with status code reporting the string form of error

local function the LSP synchronization number in {a pointer to a JSON value:node}:
    execute:
        if JSON-RPC number node is not an integer identifier:
            return 0 - 1
        set candidate to the number of node
        if candidate < 0.0 or candidate > 2.0:
            return 0 - 1
        return candidate as a 32 bit integer

local function {a pointer to a JSON value:node} contains a valid LSP integer:
    execute:
        if JSON-RPC number node is not an integer identifier:
            return false
        set number to the number of node
        return number >= -2147483648.0 and number <= 2147483647.0

local function {a pointer to a JSON value:node} contains an invalid LSP integer:
    execute:
        return (node contains a valid LSP integer) = false

local function {a pointer to a JSON value:node} contains a valid unsigned LSP integer:
    execute:
        if JSON-RPC number node is not an integer identifier:
            return false
        set number to the number of node
        return number >= 0.0 and number <= 2147483647.0

local function {a pointer to a JSON value:position} is a valid LSP position:
    execute:
        if position is not a JSON object:
            return false
        if (position lacks JSON member named "line") or (position lacks JSON member named "character"):
            return false
        set line to the JSON member named "line" in position
        set character to the JSON member named "character" in position
        return line contains a valid unsigned LSP integer and character contains a valid unsigned LSP integer

local function {a pointer to a JSON value:position} is an invalid LSP position:
    execute:
        return (position is a valid LSP position) = false

local function {a pointer to a JSON value:range} is a valid LSP range:
    execute:
        if range is not a JSON object:
            return false
        if (range lacks JSON member named "start") or (range lacks JSON member named "end"):
            return false
        set start to the JSON member named "start" in range
        set end to the JSON member named "end" in range
        if (start is an invalid LSP position) or (end is an invalid LSP position):
            return false
        set beginning to the number of the JSON member named "line" in start
        set ending to the number of the JSON member named "line" in end
        if beginning > ending:
            return false
        if beginning = ending:
            set first to the number of the JSON member named "character" in start
            set last to the number of the JSON member named "character" in end
            if first > last:
                return false
        return true

local function {a pointer to a JSON value:range} is an invalid LSP range:
    execute:
        return (range is a valid LSP range) = false

local function {a pointer to a JSON value:information} is valid LSP diagnostic related information:
    execute:
        if information is not a JSON object:
            return false
        if (information lacks JSON member named "location") or (information lacks JSON member named "message"):
            return false
        set message to the JSON member named "message" in information
        if the kind of message != the JSON text kind:
            return false
        set location to the JSON member named "location" in information
        if location is not a JSON object:
            return false
        if (location lacks JSON member named "uri") or (location lacks JSON member named "range"):
            return false
        set uri to the JSON member named "uri" in location
        if the kind of uri != the JSON text kind:
            return false
        return the JSON member named "range" in location is a valid LSP range

local function {a pointer to a JSON value:information} is invalid LSP diagnostic related information:
    execute:
        return (information is valid LSP diagnostic related information) = false

local function {a pointer to a JSON value:diagnostic} is a valid LSP diagnostic:
    execute:
        if diagnostic is not a JSON object:
            return false
        if (diagnostic lacks JSON member named "range") or (diagnostic lacks JSON member named "message"):
            return false
        if the JSON member named "range" in diagnostic is an invalid LSP range:
            return false
        set message to the JSON member named "message" in diagnostic
        if the kind of message != the JSON text kind:
            return false
        if diagnostic has JSON member named "severity":
            set severity to the JSON member named "severity" in diagnostic
            if severity contains an invalid LSP integer:
                return false
            set number to the number of severity
            if number < 1.0 or number > 4.0:
                return false
        if diagnostic has JSON member named "code":
            set code to the JSON member named "code" in diagnostic
            if the kind of code = the JSON number kind:
                if code contains an invalid LSP integer:
                    return false
            else if the kind of code != the JSON text kind:
                return false
        if diagnostic has JSON member named "codeDescription":
            set description to the JSON member named "codeDescription" in diagnostic
            if description is not a JSON object:
                return false
            if description lacks JSON member named "href":
                return false
            set link to the JSON member named "href" in description
            if the kind of link != the JSON text kind:
                return false
        if diagnostic has JSON member named "source":
            set source to the JSON member named "source" in diagnostic
            if the kind of source != the JSON text kind:
                return false
        if diagnostic has JSON member named "tags":
            set tags to the JSON member named "tags" in diagnostic
            if tags is not a JSON array:
                return false
            set cursor to 0
            loop while cursor < the number of JSON items in tags:
                set tag to the JSON value at index cursor in tags
                if tag contains an invalid LSP integer:
                    return false
                set number to the number of tag
                if number < 1.0 or number > 2.0:
                    return false
                set cursor to (cursor + 1)
        if diagnostic has JSON member named "relatedInformation":
            set related to the JSON member named "relatedInformation" in diagnostic
            if related is not a JSON array:
                return false
            set cursor to 0
            loop while cursor < the number of JSON items in related:
                set information to the JSON value at index cursor in related
                if information is invalid LSP diagnostic related information:
                    return false
                set cursor to (cursor + 1)
        return true

local function {a pointer to a JSON value:diagnostic} is an invalid LSP diagnostic:
    execute:
        return (diagnostic is a valid LSP diagnostic) = false

local function the result of configuring LSP server capabilities {a pointer to a JSON value:capabilities} for {a pointer to an LSP client:state}:
    execute:
        if capabilities is not a JSON object:
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP initialize result capabilities must be an object"
        if capabilities has JSON member named "positionEncoding":
            set encoding to the JSON member named "positionEncoding" in capabilities
            if the kind of encoding != the JSON text kind:
                return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP positionEncoding must be text"
            set name to the text of encoding
            if name != "utf-16":
                return a failed JSON-RPC operation with status the LSP invalid response status reporting "The LSP client supports only UTF-16 positions"
        set kind to the LSP no synchronization kind
        set opens to false
        set saves to false
        set includes to false
        if capabilities has JSON member named "textDocumentSync":
            set synchronization to the JSON member named "textDocumentSync" in capabilities
            if the kind of synchronization = the JSON number kind:
                set kind to the LSP synchronization number in synchronization
                if kind < 0:
                    return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync must be 0, 1, or 2"
                set opens to kind != the LSP no synchronization kind
            else if synchronization is a JSON object:
                if synchronization has JSON member named "openClose":
                    set opening to the JSON member named "openClose" in synchronization
                    if the kind of opening != the JSON boolean kind:
                        return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.openClose must be boolean"
                    set opens to the boolean of opening
                if synchronization has JSON member named "willSave":
                    set anticipating to the JSON member named "willSave" in synchronization
                    if the kind of anticipating != the JSON boolean kind:
                        return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.willSave must be boolean"
                if synchronization has JSON member named "willSaveWaitUntil":
                    set waiting to the JSON member named "willSaveWaitUntil" in synchronization
                    if the kind of waiting != the JSON boolean kind:
                        return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.willSaveWaitUntil must be boolean"
                if synchronization has JSON member named "change":
                    set change to the JSON member named "change" in synchronization
                    set kind to the LSP synchronization number in change
                    if kind < 0:
                        return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.change must be 0, 1, or 2"
                if synchronization has JSON member named "save":
                    set saving to the JSON member named "save" in synchronization
                    if the kind of saving = the JSON boolean kind:
                        set saves to the boolean of saving
                    else if saving is a JSON object:
                        set saves to true
                        if saving has JSON member named "includeText":
                            set content to the JSON member named "includeText" in saving
                            if the kind of content != the JSON boolean kind:
                                return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.save.includeText must be boolean"
                            set includes to the boolean of content
                    else:
                        return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync.save must be boolean or object"
            else:
                return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP textDocumentSync must be a number or object"
        set state's synchronization's kind to kind
        set state's synchronization's open and close notifications to opens
        set state's synchronization's save notifications to saves
        set state's synchronization's saved text inclusion to includes
        return a successful JSON-RPC operation

local function a newly allocated LSP client owning {a pointer to a JSON-RPC session:session}:
    execute:
        set documents to an empty list of a pointer to an LSP document
        set reports to an empty list of a pointer to an LSP diagnostic report
        set notifications to an empty list of a pointer to a JSON value
        set synchronization to @intrinsic(
            "construct",
            an LSP synchronization,
            the LSP no synchronization kind,
            false,
            false,
            false
        )
        set initial to @intrinsic(
            "construct",
            an LSP client,
            session,
            the LSP created lifecycle,
            synchronization,
            an empty LSP JSON node,
            documents,
            reports,
            notifications
        )
        allocate one slot of initial and set storage to it
        return storage

local function an LSP start failure after freeing {a pointer to an LSP client:state} with status {integer:code} reporting {string:error}:
    execute:
        free state
        return a failed LSP client result with status code reporting error

local function an LSP start failure after freeing {a pointer to an LSP client:state} with status {integer:code} reporting {C string:error}:
    execute:
        return an LSP start failure after freeing state with status code reporting the string form of error

local function the result of initializing an LSP client over {a pointer to a JSON-RPC connection:connection} using {a pointer to a JSON value:parameters} within {integer:timeout} milliseconds:
    execute:
        set session to a JSON-RPC session for connection
        set state to a newly allocated LSP client owning session
        set sent to the result of sending JSON-RPC request "initialize" with parameters using session
        free parameters
        if sent failed:
            set error to sent's error message
            return an LSP start failure after freeing state with status sent's status reporting error
        set identifier to sent's request id
        set response to the JSON-RPC response for identifier using session waiting up to timeout milliseconds
        if response failed:
            set error to response's error message
            set code to response's status
            if code = the JSON-RPC remote error status:
                set error to response's remote error message
            free response
            return an LSP start failure after freeing state with status code reporting error
        set payload to response's result
        if payload is not a JSON object:
            free response
            return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP initialize result must be an object"
        if payload has JSON member named "serverInfo":
            set server to the JSON member named "serverInfo" in payload
            if server is not a JSON object:
                free response
                return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP serverInfo must be an object"
            if server lacks JSON member named "name":
                free response
                return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP serverInfo is missing name"
            set name to the JSON member named "name" in server
            if the kind of name != the JSON text kind:
                free response
                return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP serverInfo.name must be text"
            if server has JSON member named "version":
                set version to the JSON member named "version" in server
                if the kind of version != the JSON text kind:
                    free response
                    return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP serverInfo.version must be text"
        if payload lacks JSON member named "capabilities":
            free response
            return an LSP start failure after freeing state with status the LSP invalid response status reporting "LSP initialize result is missing capabilities"
        set offered to the JSON member named "capabilities" in payload
        set configured to the result of configuring LSP server capabilities offered for state
        if configured failed:
            set error to configured's error message
            set code to configured's status
            free response
            return an LSP start failure after freeing state with status code reporting error
        set state's capabilities to a copy of JSON-RPC node offered
        free response
        set parameters to a new JSON-RPC object
        set initialized to the result of sending JSON-RPC session notification "initialized" with parameters using session
        free parameters
        if initialized failed:
            set error to initialized's error message
            return an LSP start failure after freeing state with status initialized's status reporting error
        set state's lifecycle to the LSP running lifecycle
        return a successful LSP client result containing state

local function the result of starting an LSP client using {process command:command} with {a pointer to a JSON value:capabilities}, parameters {a pointer to a JSON value:parameters}, and a limit of {integer:timeout} milliseconds:
    execute:
        if timeout < 0:
            free parameters
            return a failed LSP client result with status the JSON-RPC timeout status reporting "LSP startup timeout must not be negative"
        if capabilities is not a JSON object:
            free parameters
            return a failed LSP client result with status the JSON-RPC invalid message status reporting "LSP client capabilities must be an object"
        set opened to the result of opening a JSON-RPC connection using command
        if opened failed:
            set error to opened's error message
            free parameters
            return a failed LSP client result with status the JSON-RPC I/O error status reporting error
        set connection to opened's connection
        return the result of initializing an LSP client over connection using parameters within timeout milliseconds

function the result of starting an LSP client using {process command:command} rooted at {a value:root} with {a pointer to a JSON value:capabilities} waiting up to {integer:timeout} milliseconds:
    execute:
        set address to the string form of root
        if address is invalid UTF-8:
            return a failed LSP client result with status the JSON-RPC invalid UTF-8 status reporting "LSP root URI must be valid UTF-8"
        set parameters to the LSP initialization parameters rooted at address with capabilities
        return the result of starting an LSP client using command with capabilities, parameters parameters, and a limit of timeout milliseconds

function the result of starting an LSP client using {process command:command} rooted at {a value:root} with {a pointer to a JSON value:capabilities} and initialization options {a pointer to a JSON value:options} waiting up to {integer:timeout} milliseconds:
    execute:
        set address to the string form of root
        if address is invalid UTF-8:
            return a failed LSP client result with status the JSON-RPC invalid UTF-8 status reporting "LSP root URI must be valid UTF-8"
        set parameters to the LSP initialization parameters rooted at address with capabilities and initialization options options
        return the result of starting an LSP client using command with capabilities, parameters parameters, and a limit of timeout milliseconds

function the result of starting an LSP client using {process command:command} with {a pointer to a JSON value:capabilities} waiting up to {integer:timeout} milliseconds:
    execute:
        set parameters to the LSP initialization parameters with capabilities
        return the result of starting an LSP client using command with capabilities, parameters parameters, and a limit of timeout milliseconds

function the result of starting an LSP client using {process command:command} with {a pointer to a JSON value:capabilities} and initialization options {a pointer to a JSON value:options} waiting up to {integer:timeout} milliseconds:
    execute:
        set parameters to the LSP initialization parameters with capabilities and initialization options options
        return the result of starting an LSP client using command with capabilities, parameters parameters, and a limit of timeout milliseconds

function the result of starting an LSP client using {process command:command} rooted at {a value:root} waiting up to {integer:timeout} milliseconds:
    execute:
        set capabilities to the default LSP client capabilities
        set outcome to the result of starting an LSP client using command rooted at root with capabilities waiting up to timeout milliseconds
        free capabilities
        return outcome

function the result of starting an LSP client using {process command:command} waiting up to {integer:timeout} milliseconds:
    execute:
        set capabilities to the default LSP client capabilities
        set outcome to the result of starting an LSP client using command with capabilities waiting up to timeout milliseconds
        free capabilities
        return outcome

local function a failed LSP send with status {integer:status} reporting {string:error}:
    replacement:
        @intrinsic(
            "construct",
            a JSON-RPC send result,
            false,
            status,
            an empty LSP text,
            an empty LSP JSON node,
            error
        )

local function a failed LSP send with status {integer:code} reporting {C string:error}:
    execute:
        return a failed LSP send with status code reporting the string form of error

local function a failed LSP response with status {integer:status} reporting {string:error}:
    replacement:
        @intrinsic(
            "construct",
            a JSON-RPC response,
            false,
            status,
            an empty LSP JSON node,
            an empty LSP JSON node,
            0,
            an empty LSP text,
            an empty LSP text,
            an empty LSP JSON node,
            error
        )

local function a failed LSP response with status {integer:code} reporting {C string:error}:
    execute:
        return a failed LSP response with status code reporting the string form of error

function the result of sending an LSP request {a value:method} with {a pointer to a JSON value:parameters} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC request method with parameters using session

function the result of sending an LSP request {a value:method} with {a pointer to a JSON value:parameters} identified by {a pointer to a JSON value:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC request method with parameters identified by identifier using session

function the result of sending an LSP request {a value:method} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC request method using session

function the result of sending an LSP request {a value:method} identified by {a pointer to a JSON value:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC request method identified by identifier using session

function the result of sending an LSP notification {a value:method} with {a pointer to a JSON value:parameters} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC session notification method with parameters using session

function the result of sending an LSP notification {a value:method} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of sending JSON-RPC session notification method using session

function the LSP response for {string:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP response with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the JSON-RPC response for identifier using session

function the LSP response for {string:identifier} using {a pointer to an LSP client:state} waiting up to {integer:timeout} milliseconds:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP response with status the LSP invalid state status reporting "LSP client is not running"
        if timeout < 0:
            return a failed LSP response with status the JSON-RPC timeout status reporting "LSP response timeout must not be negative"
        set session to state's session
        return the JSON-RPC response for identifier using session waiting up to timeout milliseconds

function the LSP response for {a pointer to a JSON value:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP response with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the JSON-RPC response for identifier using session

function the LSP response for {a pointer to a JSON value:identifier} using {a pointer to an LSP client:state} waiting up to {integer:timeout} milliseconds:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP response with status the LSP invalid state status reporting "LSP client is not running"
        if timeout < 0:
            return a failed LSP response with status the JSON-RPC timeout status reporting "LSP response timeout must not be negative"
        set session to state's session
        return the JSON-RPC response for identifier using session waiting up to timeout milliseconds

function the result of cancelling LSP request {string:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of cancelling JSON-RPC request identifier using session

function the result of cancelling LSP request {a pointer to a JSON value:identifier} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of cancelling JSON-RPC request identifier using session

function the result of replying to {a pointer to a JSON value:request} from the LSP server with {a pointer to a JSON value:result} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of replying to request with result using session

function the result of replying to {a pointer to a JSON value:request} from the LSP server with error code {integer:number} message {a value:error} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of replying to request with error code number message error using session

function the result of replying to {a pointer to a JSON value:request} from the LSP server with error code {integer:number} message {a value:error} and data {a pointer to a JSON value:payload} using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of replying to request with error code number message error and data payload using session

local function the LSP diagnostic report index for {string:uri} in {a pointer to an LSP client:state}:
    execute:
        set reports to state's reports
        set cursor to 0
        loop while cursor < the length of reports:
            set entry to @intrinsic("cast", the item at cursor in reports, a pointer to an LSP diagnostic report)
            if entry's uri = uri:
                return cursor
            set cursor to (cursor + 1)
        return 0 - 1

local function the result of updating LSP diagnostics from {a pointer to a JSON value:envelope} using {a pointer to an LSP client:state}:
    execute:
        if envelope lacks JSON member named "params":
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP publishDiagnostics notification is missing params"
        set parameters to the JSON member named "params" in envelope
        if parameters is not a JSON object:
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP publishDiagnostics params must be an object"
        if parameters lacks JSON member named "uri":
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP publishDiagnostics params are missing uri"
        if parameters lacks JSON member named "diagnostics":
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP publishDiagnostics params are missing diagnostics"
        set uri to the JSON member named "uri" in parameters
        set items to the JSON member named "diagnostics" in parameters
        if the kind of uri != the JSON text kind:
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP diagnostic uri must be text"
        if items is not a JSON array:
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP diagnostics must be an array"
        set cursor to 0
        loop while cursor < the number of JSON items in items:
            set diagnostic to the JSON value at index cursor in items
            if diagnostic is an invalid LSP diagnostic:
                return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP diagnostics contain an invalid Diagnostic"
            set cursor to (cursor + 1)
        set versioning to false
        set version to 0
        if parameters has JSON member named "version":
            set value to the JSON member named "version" in parameters
            if value contains an invalid LSP integer:
                return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP diagnostic version must be an integer"
            set number to the number of value
            set versioning to true
            set version to number as a 32 bit integer
        set address to the text of uri
        set copied to a copy of JSON-RPC node items
        set index to the LSP diagnostic report index for address in state
        if index >= 0:
            set reports to state's reports
            set report to @intrinsic("cast", the item at index in reports, a pointer to an LSP diagnostic report)
            free report's diagnostics
            set report's version presence to versioning
            set report's version to version
            set report's diagnostics to copied
            return a successful JSON-RPC operation
        set initial to @intrinsic("construct", an LSP diagnostic report, address, versioning, version, copied)
        allocate one slot of initial and set report to it
        set reports to state's reports
        append report to reports
        return a successful JSON-RPC operation

local function the result of queueing LSP notification {a pointer to a JSON value:envelope} using {a pointer to an LSP client:state}:
    execute:
        set notifications to state's notifications
        set session to state's session
        set connection to session's connection
        set maximum to connection's limits's maximum queue length
        if the length of notifications >= maximum:
            free envelope
            return a failed JSON-RPC operation with status the JSON-RPC limit exceeded status reporting "The LSP notification queue is full"
        append envelope to notifications
        return a successful JSON-RPC operation

local function the result of dispatching the next LSP notification using {a pointer to an LSP client:state}:
    execute:
        set session to state's session
        set queued to the next JSON-RPC notification from session
        if queued failed:
            return a successful JSON-RPC operation
        set envelope to queued's message
        set method to the JSON text named "method" in envelope
        if method = "textDocument/publishDiagnostics":
            set updated to the result of updating LSP diagnostics from envelope using state
            if updated succeeded:
                free queued
                return updated
            set retained to the result of queueing LSP notification envelope using state
            if retained failed:
                return retained
            set error to updated's error message
            return a failed JSON-RPC operation with status updated's status reporting error
        return the result of queueing LSP notification envelope using state

function the result of pumping one LSP message using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        set pending to session's notifications
        if the length of pending > 0:
            return the result of dispatching the next LSP notification using state
        set pumped to the result of pumping one JSON-RPC message using session
        if pumped failed:
            return pumped
        return the result of dispatching the next LSP notification using state

function the result of pumping one LSP message using {a pointer to an LSP client:state} waiting up to {integer:timeout} milliseconds:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        if timeout < 0:
            return a failed JSON-RPC operation with status the JSON-RPC timeout status reporting "LSP pump timeout must not be negative"
        set session to state's session
        set pending to session's notifications
        if the length of pending > 0:
            return the result of dispatching the next LSP notification using state
        set pumped to the result of pumping one JSON-RPC message using session waiting up to timeout milliseconds
        if pumped failed:
            return pumped
        return the result of dispatching the next LSP notification using state

function the next LSP server request from {a pointer to an LSP client:state}:
    execute:
        set session to state's session
        return the next JSON-RPC server request from session

function the next LSP protocol diagnostic from {a pointer to an LSP client:state}:
    execute:
        set session to state's session
        return the next JSON-RPC diagnostic from session

function the next LSP notification from {a pointer to an LSP client:state}:
    execute:
        set notifications to state's notifications
        if the length of notifications = 0:
            return @intrinsic(
                "construct",
                a JSON-RPC queued message,
                false,
                the JSON-RPC queue empty status,
                an empty LSP JSON node,
                the string form of "LSP notification queue is empty"
            )
        set envelope to @intrinsic("cast", the item at 0 in notifications, a pointer to a JSON value)
        remove item 0 from notifications
        return @intrinsic(
            "construct",
            a JSON-RPC queued message,
            true,
            the JSON-RPC success status,
            envelope,
            an empty LSP text
        )

function the result of rejecting {a pointer to a JSON value:request} from the LSP server as method not found using {a pointer to an LSP client:state}:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed LSP send with status the LSP invalid state status reporting "LSP client is not running"
        set session to state's session
        return the result of replying to request with error code the JSON-RPC method not found code message "Method not found" using session

function the LSP diagnostics for uri {a value:uri} in {a pointer to an LSP client:state}:
    execute:
        set address to the string form of uri
        set index to the LSP diagnostic report index for address in state
        if index < 0:
            return @intrinsic("construct", an LSP diagnostics result, false, false, 0, an empty LSP JSON node)
        set reports to state's reports
        set report to @intrinsic("cast", the item at index in reports, a pointer to an LSP diagnostic report)
        return @intrinsic("construct", an LSP diagnostics result, true, report's version presence, report's version, report's diagnostics)

function the LSP standard error from {a pointer to an LSP client:state}:
    execute:
        set session to state's session
        set connection to session's connection
        return connection's standard error

function the result of shutting down {a pointer to an LSP client:state} waiting up to {integer:timeout} milliseconds:
    execute:
        if state's lifecycle != the LSP running lifecycle:
            return a failed JSON-RPC operation with status the LSP invalid state status reporting "LSP client is not running"
        if timeout < 0:
            return a failed JSON-RPC operation with status the JSON-RPC timeout status reporting "LSP shutdown timeout must not be negative"
        set state's lifecycle to the LSP shutdown lifecycle
        set session to state's session
        set sent to the result of sending JSON-RPC request "shutdown" using session
        if sent failed:
            set error to sent's error message
            return a failed JSON-RPC operation with status sent's status reporting error
        set identifier to sent's request id
        set response to the JSON-RPC response for identifier using session waiting up to timeout milliseconds
        if response failed:
            set error to response's error message
            set code to response's status
            free response
            return a failed JSON-RPC operation with status code reporting error
        if response's result is not JSON null:
            free response
            return a failed JSON-RPC operation with status the LSP invalid response status reporting "LSP shutdown result must be null"
        free response
        set exited to the result of sending JSON-RPC session notification "exit" using session
        if exited failed:
            set error to exited's error message
            return a failed JSON-RPC operation with status exited's status reporting error
        set connection to session's connection
        set closed to the result of closing connection
        set state's lifecycle to the LSP stopped lifecycle
        if closed failed:
            set error to closed's error message
            return a failed JSON-RPC operation with status closed's status reporting error
        return a successful JSON-RPC operation

local function free LSP documents in {a pointer to a list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set document to @intrinsic("cast", the item at cursor in values, a pointer to an LSP document)
            @intrinsic("destroy at", document)
            @intrinsic("call", "libc", "free", nothing, document)
            set cursor to (cursor + 1)
        free values

local function free LSP diagnostic reports in {a pointer to a list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set report to @intrinsic("cast", the item at cursor in values, a pointer to an LSP diagnostic report)
            free report's diagnostics
            @intrinsic("destroy at", report)
            @intrinsic("call", "libc", "free", nothing, report)
            set cursor to (cursor + 1)
        free values

local function free LSP notifications in {a pointer to a list:values}:
    execute:
        set cursor to 0
        loop while cursor < the length of values:
            set envelope to @intrinsic("cast", the item at cursor in values, a pointer to a JSON value)
            free envelope
            set cursor to (cursor + 1)
        free values

function free {a pointer to an LSP client:state}:
    execute:
        set capabilities to state's capabilities
        if capabilities != (an empty LSP JSON node):
            free capabilities
        set documents to state's documents
        set reports to state's reports
        set notifications to state's notifications
        free LSP documents in documents
        free LSP diagnostic reports in reports
        free LSP notifications in notifications
        set session to state's session
        free session
        @intrinsic("call", "libc", "free", nothing, state)
