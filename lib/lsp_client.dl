# Language Server Protocol lifecycle, capability negotiation, and dispatch.

import lib/lsp_types.dl
import lib/lsp_json.dl

local function an empty lsp text:
    replacement:
        the string form of ""

local function an empty lsp json node:
    replacement:
        0 as a pointer to json value

local function an empty lsp client pointer:
    replacement:
        0 as a pointer to lsp client

local function a successful lsp client result containing {a pointer to lsp client:state}:
    replacement:
        @intrinsic("construct", an lsp client result, true, the json rpc success status, state, an empty lsp text)

local function a failed lsp client result with status {integer:error_status} reporting {string:error_text}:
    replacement:
        @intrinsic("construct", an lsp client result, false, error_status, an empty lsp client pointer, error_text)

local function a failed lsp client result with status {integer:error_status} reporting {cstring:error_text}:
    execute:
        return a failed lsp client result with status error_status reporting the string form of error_text

local function lsp synchronization number {a pointer to json value:node}:
    execute:
        if not json rpc number node is an integer identifier:
            return 0 - 1
        set numeric_value to the number of node
        if numeric_value < 0.0 or numeric_value > 2.0:
            return 0 - 1
        return numeric_value as i32

local function lsp integer value is valid in {a pointer to json value:node}:
    execute:
        if not json rpc number node is an integer identifier:
            return false
        set numeric_value to the number of node
        return numeric_value >= -2147483648.0 and numeric_value <= 2147483647.0

local function lsp unsigned integer value is valid in {a pointer to json value:node}:
    execute:
        if not json rpc number node is an integer identifier:
            return false
        set numeric_value to the number of node
        return numeric_value >= 0.0 and numeric_value <= 2147483647.0

local function lsp position is valid in {a pointer to json value:position_node}:
    execute:
        if not position_node is a json object:
            return false
        if (not position_node has json member named "line") or (not position_node has json member named "character"):
            return false
        set line_node to json member named "line" in position_node
        set character_node to json member named "character" in position_node
        return lsp unsigned integer value is valid in line_node and lsp unsigned integer value is valid in character_node

local function lsp range is valid in {a pointer to json value:range_node}:
    execute:
        if not range_node is a json object:
            return false
        if (not range_node has json member named "start") or (not range_node has json member named "end"):
            return false
        set start_node to json member named "start" in range_node
        set end_node to json member named "end" in range_node
        if (not lsp position is valid in start_node) or (not lsp position is valid in end_node):
            return false
        set start_line to the number of json member named "line" in start_node
        set end_line to the number of json member named "line" in end_node
        if start_line > end_line:
            return false
        if start_line = end_line:
            set start_character to the number of json member named "character" in start_node
            set end_character to the number of json member named "character" in end_node
            if start_character > end_character:
                return false
        return true

local function lsp diagnostic related information is valid in {a pointer to json value:information_node}:
    execute:
        if not information_node is a json object:
            return false
        if (not information_node has json member named "location") or (not information_node has json member named "message"):
            return false
        set message_node to json member named "message" in information_node
        if the kind of message_node != the json text kind:
            return false
        set location_node to json member named "location" in information_node
        if not location_node is a json object:
            return false
        if (not location_node has json member named "uri") or (not location_node has json member named "range"):
            return false
        set uri_node to json member named "uri" in location_node
        if the kind of uri_node != the json text kind:
            return false
        return lsp range is valid in json member named "range" in location_node

local function lsp diagnostic is valid in {a pointer to json value:diagnostic_node}:
    execute:
        if not diagnostic_node is a json object:
            return false
        if (not diagnostic_node has json member named "range") or (not diagnostic_node has json member named "message"):
            return false
        if not lsp range is valid in json member named "range" in diagnostic_node:
            return false
        set message_node to json member named "message" in diagnostic_node
        if the kind of message_node != the json text kind:
            return false
        if diagnostic_node has json member named "severity":
            set severity_node to json member named "severity" in diagnostic_node
            if not lsp integer value is valid in severity_node:
                return false
            set severity to the number of severity_node
            if severity < 1.0 or severity > 4.0:
                return false
        if diagnostic_node has json member named "code":
            set code_node to json member named "code" in diagnostic_node
            if the kind of code_node = the json number kind:
                if not lsp integer value is valid in code_node:
                    return false
            else if the kind of code_node != the json text kind:
                return false
        if diagnostic_node has json member named "codeDescription":
            set description_node to json member named "codeDescription" in diagnostic_node
            if not description_node is a json object:
                return false
            if not description_node has json member named "href":
                return false
            set href_node to json member named "href" in description_node
            if the kind of href_node != the json text kind:
                return false
        if diagnostic_node has json member named "source":
            set source_node to json member named "source" in diagnostic_node
            if the kind of source_node != the json text kind:
                return false
        if diagnostic_node has json member named "tags":
            set tags_node to json member named "tags" in diagnostic_node
            if not tags_node is a json array:
                return false
            set tag_cursor to 0
            loop while tag_cursor < the number of json items in tags_node:
                set tag_node to json value at index tag_cursor in tags_node
                if not lsp integer value is valid in tag_node:
                    return false
                set tag_value to the number of tag_node
                if tag_value < 1.0 or tag_value > 2.0:
                    return false
                set tag_cursor to tag_cursor + 1
        if diagnostic_node has json member named "relatedInformation":
            set information_nodes to json member named "relatedInformation" in diagnostic_node
            if not information_nodes is a json array:
                return false
            set information_cursor to 0
            loop while information_cursor < the number of json items in information_nodes:
                set information_node to json value at index information_cursor in information_nodes
                if not lsp diagnostic related information is valid in information_node:
                    return false
                set information_cursor to information_cursor + 1
        return true

local function configure lsp server capabilities {a pointer to json value:capability_node} for {a pointer to lsp client:state}:
    execute:
        if not capability_node is a json object:
            return a failed json rpc operation with status the lsp invalid response status reporting "LSP initialize result capabilities must be an object"
        if capability_node has json member named "positionEncoding":
            set encoding_node to json member named "positionEncoding" in capability_node
            if the kind of encoding_node != the json text kind:
                return a failed json rpc operation with status the lsp invalid response status reporting "LSP positionEncoding must be text"
            set encoding_text to the text of encoding_node
            if not (encoding_text = "utf-16"):
                return a failed json rpc operation with status the lsp invalid response status reporting "The LSP client supports only UTF-16 positions"
        set synchronization_kind to the lsp no synchronization kind
        set synchronization_open_close to false
        set synchronization_save to false
        set synchronization_save_include_text to false
        if capability_node has json member named "textDocumentSync":
            set synchronization_node to json member named "textDocumentSync" in capability_node
            if the kind of synchronization_node = the json number kind:
                set synchronization_kind to lsp synchronization number synchronization_node
                if synchronization_kind < 0:
                    return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync must be 0, 1, or 2"
            else if synchronization_node is a json object:
                if synchronization_node has json member named "openClose":
                    set open_close_node to json member named "openClose" in synchronization_node
                    if the kind of open_close_node != the json boolean kind:
                        return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.openClose must be boolean"
                    set synchronization_open_close to the boolean of open_close_node
                if synchronization_node has json member named "willSave":
                    set will_save_node to json member named "willSave" in synchronization_node
                    if the kind of will_save_node != the json boolean kind:
                        return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.willSave must be boolean"
                if synchronization_node has json member named "willSaveWaitUntil":
                    set wait_until_node to json member named "willSaveWaitUntil" in synchronization_node
                    if the kind of wait_until_node != the json boolean kind:
                        return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.willSaveWaitUntil must be boolean"
                if synchronization_node has json member named "change":
                    set change_node to json member named "change" in synchronization_node
                    set synchronization_kind to lsp synchronization number change_node
                    if synchronization_kind < 0:
                        return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.change must be 0, 1, or 2"
                if synchronization_node has json member named "save":
                    set save_node to json member named "save" in synchronization_node
                    if the kind of save_node = the json boolean kind:
                        set synchronization_save to the boolean of save_node
                    else if save_node is a json object:
                        set synchronization_save to true
                        if save_node has json member named "includeText":
                            set include_text_node to json member named "includeText" in save_node
                            if the kind of include_text_node != the json boolean kind:
                                return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.save.includeText must be boolean"
                            set synchronization_save_include_text to the boolean of include_text_node
                    else:
                        return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync.save must be boolean or object"
            else:
                return a failed json rpc operation with status the lsp invalid response status reporting "LSP textDocumentSync must be a number or object"
        set state's synchronization_kind to synchronization_kind
        set state's synchronization_open_close to synchronization_open_close
        set state's synchronization_save to synchronization_save
        set state's synchronization_save_include_text to synchronization_save_include_text
        return a successful json rpc operation

local function allocate lsp client owning {a pointer to json rpc session:session}:
    execute:
        set documents to an empty list of a pointer to lsp document
        set reports to an empty list of a pointer to lsp diagnostic report
        set notifications to an empty list of a pointer to json value
        set initial_state to @intrinsic(
            "construct",
            an lsp client,
            session,
            the lsp created lifecycle,
            the lsp no synchronization kind,
            false,
            false,
            false,
            an empty lsp json node,
            documents,
            reports,
            notifications
        )
        return allocate 1 slots of initial_state

local function finish failed lsp start for {a pointer to lsp client:state} with status {integer:error_status} reporting {string:error_text}:
    execute:
        free lsp client state
        return a failed lsp client result with status error_status reporting error_text

local function finish failed lsp start for {a pointer to lsp client:state} with status {integer:error_status} reporting {cstring:error_text}:
    execute:
        return finish failed lsp start for state with status error_status reporting the string form of error_text

local function initialize lsp client over {a pointer to json rpc connection:connection} with {a pointer to json value:capability_node} root {string:root_uri} including root {boolean:has_root} waiting {integer:milliseconds}:
    execute:
        set session to start a json rpc session with connection
        set state to allocate lsp client owning session
        if has_root:
            set parameters to lsp initialize parameters for root uri root_uri with capabilities capability_node
        else:
            set parameters to lsp initialize parameters with capabilities capability_node
        set sent to send json rpc request "initialize" with parameters using session
        free json value parameters
        if not sent's succeeded:
            set send_text to sent's error message
            return finish failed lsp start for state with status sent's status reporting send_text
        set request_id to sent's request id
        set response to await json rpc response for request_id using session waiting up to milliseconds milliseconds
        if not response's succeeded:
            set response_text to response's error message
            set response_status to response's status
            free json rpc response response
            return finish failed lsp start for state with status response_status reporting response_text
        set result_node to response's result
        if not result_node is a json object:
            free json rpc response response
            return finish failed lsp start for state with status the lsp invalid response status reporting "LSP initialize result must be an object"
        if result_node has json member named "serverInfo":
            set server_info to json member named "serverInfo" in result_node
            if not server_info is a json object:
                free json rpc response response
                return finish failed lsp start for state with status the lsp invalid response status reporting "LSP serverInfo must be an object"
            if not server_info has json member named "name":
                free json rpc response response
                return finish failed lsp start for state with status the lsp invalid response status reporting "LSP serverInfo is missing name"
            set server_name to json member named "name" in server_info
            if the kind of server_name != the json text kind:
                free json rpc response response
                return finish failed lsp start for state with status the lsp invalid response status reporting "LSP serverInfo.name must be text"
            if server_info has json member named "version":
                set server_version to json member named "version" in server_info
                if the kind of server_version != the json text kind:
                    free json rpc response response
                    return finish failed lsp start for state with status the lsp invalid response status reporting "LSP serverInfo.version must be text"
        if not result_node has json member named "capabilities":
            free json rpc response response
            return finish failed lsp start for state with status the lsp invalid response status reporting "LSP initialize result is missing capabilities"
        set server_capabilities to json member named "capabilities" in result_node
        set configured to configure lsp server capabilities server_capabilities for state
        if not configured's succeeded:
            set configuration_text to configured's error message
            set configuration_status to configured's status
            free json rpc response response
            return finish failed lsp start for state with status configuration_status reporting configuration_text
        set state's server_capabilities to duplicate json rpc node server_capabilities
        free json rpc response response
        set initialized_parameters to a new json rpc object
        set initialized to send json rpc session notification "initialized" with initialized_parameters using session
        free json value initialized_parameters
        if not initialized's succeeded:
            set initialized_text to initialized's error message
            return finish failed lsp start for state with status initialized's status reporting initialized_text
        set state's lifecycle to the lsp running lifecycle
        return a successful lsp client result containing state

function start lsp client using {process command:command} at root uri {any:root_uri} with capabilities {a pointer to json value:capability_node} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        if timeout_ms < 0:
            return a failed lsp client result with status the json rpc timeout status reporting "LSP startup timeout must not be negative"
        if not capability_node is a json object:
            return a failed lsp client result with status the json rpc invalid message status reporting "LSP client capabilities must be an object"
        set root_text to the string form of root_uri
        if not root_text is valid utf8:
            return a failed lsp client result with status the json rpc invalid utf8 status reporting "LSP root URI must be valid UTF-8"
        set opened to open a json rpc connection using command
        if not opened's succeeded:
            set open_text to opened's error message
            return a failed lsp client result with status the json rpc io error status reporting open_text
        set connection to opened's connection
        return initialize lsp client over connection with capability_node root root_text including root true waiting timeout_ms

function start lsp client using {process command:command} with capabilities {a pointer to json value:capability_node} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        if timeout_ms < 0:
            return a failed lsp client result with status the json rpc timeout status reporting "LSP startup timeout must not be negative"
        if not capability_node is a json object:
            return a failed lsp client result with status the json rpc invalid message status reporting "LSP client capabilities must be an object"
        set opened to open a json rpc connection using command
        if not opened's succeeded:
            set open_text to opened's error message
            return a failed lsp client result with status the json rpc io error status reporting open_text
        set connection to opened's connection
        set no_root to an empty lsp text
        return initialize lsp client over connection with capability_node root no_root including root false waiting timeout_ms

function start lsp client using {process command:command} at root uri {any:root_uri} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        set capabilities to the default lsp client capabilities
        set result to start lsp client using command at root uri root_uri with capabilities capabilities waiting up to timeout_ms milliseconds
        free json value capabilities
        return result

function start lsp client using {process command:command} waiting up to {integer:timeout_ms} milliseconds:
    execute:
        set capabilities to the default lsp client capabilities
        set result to start lsp client using command with capabilities capabilities waiting up to timeout_ms milliseconds
        free json value capabilities
        return result

local function a failed lsp send with status {integer:error_status} reporting {string:error_text}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc send result,
            false,
            error_status,
            an empty lsp text,
            an empty lsp json node,
            error_text
        )

local function a failed lsp send with status {integer:error_status} reporting {cstring:error_text}:
    execute:
        return a failed lsp send with status error_status reporting the string form of error_text

local function a failed lsp response with status {integer:error_status} reporting {string:error_text}:
    replacement:
        @intrinsic(
            "construct",
            a json rpc response,
            false,
            error_status,
            an empty lsp json node,
            an empty lsp json node,
            0,
            an empty lsp text,
            an empty lsp text,
            an empty lsp json node,
            error_text
        )

local function a failed lsp response with status {integer:error_status} reporting {cstring:error_text}:
    execute:
        return a failed lsp response with status error_status reporting the string form of error_text

function send lsp request {any:method_name} with {a pointer to json value:parameter_node} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return send json rpc request method_name with parameter_node using session

function send lsp request {any:method_name} with {a pointer to json value:parameter_node} and identifier {a pointer to json value:id_node} using {a pointer to lsp client:state}:
    execute:
        if state's lifecycle != the lsp running lifecycle:
            return a failed lsp send with status the lsp invalid state status reporting "LSP client is not running"
        set session to state's rpc_session
        return send json rpc request method_name with parameter_node and identifier id_node using session

function send lsp request {any:method_name} using {a pointer to lsp client:state}:
    execute:
