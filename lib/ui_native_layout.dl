# Retained geometry: explicit regions compose with ordinary rows and columns.
import lib/ui_native_theme.dl
import lib/ui_native_ribbon_layout.dl

to get a UI layout for {UI reference:node} inside {UI reference:parent} with [width] {integer:available} using {UI theme:theme}:
    if (((node's kind >= 6) and (node's kind <= 10)) or ((node's kind = 25) or (node's kind = 26))) or ((node's kind = 36) or (node's kind = 37)):
        return @intrinsic("construct", a pointer to UI layout)
    set record to a new UI layout
    set record's node to node
    set record's parent to parent
    set record's bounds to UI box at (node's left) (node's top) sized (node's width) (node's height)
    set result to storage for one slot initialized with record
    if (node's kind >= 28) and (node's kind <= 34):
        arrange ribbon UI layout result using theme
        return result
    if node's kind = 2:
        set width to ((the length of (node's text)) * 9) + 36
        set height to 44
        if (node's variant != "") or (parent's kind = 12):
            set width to available
            set height to 48
        set result's bounds' width to width as a floating-point number
        set result's bounds' height to height as a floating-point number
        return result
    if node's kind = 3:
        require condition (((node's columns > 0) and (node's rows > 0)) and (node's count <= node's rows)) reporting "Invalid UI table dimensions"
        set result's bounds' width to (node's columns * theme's cell width) as a floating-point number
        set result's bounds' height to (node's rows * theme's cell height) as a floating-point number
        return result
    if ((node's kind = 20) or (node's kind = 16)) or (node's kind = 38):
        return result
    set height to 0
    if node's kind = 11:
        set height to 24
    if (node's kind = 13) or (node's kind = 15):
        set height to 20
    if node's kind = 14:
        set height to 56
    if node's kind = 24:
        set height to 40
    if node's kind = 17:
        set height to 48
    if node's kind = 19:
        set height to 36
    if node's kind = 21:
        set height to 78
    if node's kind = 27:
        set height to 28
    if height > 0:
        set result's bounds' width to available as a floating-point number
        set result's bounds' height to height as a floating-point number
        return result
    set padding to 0
    set gap to 24
    set width to available
    if node's width > 0:
        set width to node's width
    if node's kind = 12:
        set gap to 8
        if node's variant = "card":
            set padding to 24
    set {inner width} to width - padding * 2
    set horizontal to padding as a floating-point number
    set vertical to padding as a floating-point number
    set index to 0
    set last to @intrinsic("construct", a pointer to UI layout)
    loop while index < node's count:
        set item to the UI child at index in node
        set child to a UI layout for item inside node with width inner width using theme
        if child != @intrinsic("construct", a pointer to UI layout):
            if last = @intrinsic("construct", a pointer to UI layout):
                set result's first to child
            else:
                set last's next to child
            if node's kind = 18:
                set child's bounds to UI box at (index * (inner width / node's count)) 28 sized ((inner width / node's count) - 4) 36
            else if item's width > 0:
                set child's bounds' x to item's left as a floating-point number
                set child's bounds' y to item's top as a floating-point number
            else if item's kind = 22:
                set child's bounds' x to 0.0
                set child's bounds' y to 0.0
            else if node's kind = 1:
                set child's bounds' x to horizontal
                set child's bounds' y to padding as a floating-point number
                set horizontal to horizontal + (child's bounds' width + 12)
            else:
                set child's bounds' x to padding as a floating-point number
                set child's bounds' y to vertical
                set vertical to vertical + (child's bounds' height + gap)
            set last to child
        increment index
    if node's height = 0:
        set result's bounds' height to vertical
    if node's kind = 18:
        set result's bounds' height to 72.0
    if node's kind = 1:
        set result's bounds' width to horizontal
        set result's bounds' height to 44.0
    return result

to release UI layout {a pointer to UI layout:layout}:
    set child to layout's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set next to child's next
        release UI layout child
        set child to next
    deallocate layout
