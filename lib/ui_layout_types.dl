# Renderer-independent data used to arrange UI descriptions.
import lib/ui_components.dl
import lib/ui_geometry.dl

class:
    patterns:
        UI theme
    members:
        table ink as UI paint
        button ink as UI paint
        border as an integer
        cell width as an integer
        cell height as an integer
        background as UI paint
        surface as UI paint
        outline as UI paint
        text as UI paint
        muted as UI paint
        accent as UI paint
        dark as a boolean

class:
    patterns:
        UI layout
    members:
        node as UI reference
        parent as UI reference
        bounds as UI bounds
        hover as a floating-point number
        transition as a floating-point number
        painted as a boolean
        extent as a floating-point number
        order as an integer
        first as a pointer to UI layout
        next as a pointer to UI layout
