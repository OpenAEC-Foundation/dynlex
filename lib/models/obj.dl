# DynLex OBJ Model Library
#
# Scope:
# - Loads Wavefront OBJ files with vertex positions, UVs, materials and texture bindings
# - Supports triangulated `f v/t` faces
# - Loads `map_Kd` textures from PPM P6 files

class:
    patterns:
        [an|a|] obj vertex
    members:
        x as a float
        y as a float
        z as a float
        has_color as i32
        color_r as a float
        color_g as a float
        color_b as a float

class:
    patterns:
        [an|a|] obj texcoord
    members:
        u as a float
        v as a float

class:
    patterns:
        [an|a|] obj triangle
    members:
        a as i32
        b as i32
        c as i32
        ta as i32
        tb as i32
        tc as i32
        material as i32

class:
    patterns:
        [an|a|] obj material
    members:
        name as a pointer to byte
        color_r as a float
        color_g as a float
        color_b as a float
        texture_path as a pointer to byte
        texture_id as i32

class:
    patterns:
        [an|a|] obj material set
    members:
        materials as a pointer to obj material
        material_count as i32

class:
    patterns:
        [an|a|] obj mesh
        [a|] model mesh
    members:
        vertices as a pointer to obj vertex
        vertex_count as i32
        texcoords as a pointer to obj texcoord
        texcoord_count as i32
        triangles as a pointer to obj triangle
        triangle_count as i32
        materials as a pointer to obj material
        material_count as i32

function a new obj vertex from x y z:
    replacement:
        @intrinsic("construct", an obj vertex, x, y, z, 0, 0.0, 0.0, 0.0)

function a new obj colored vertex from x y z and color r g b:
    replacement:
        @intrinsic("construct", an obj vertex, x, y, z, 1, r, g, b)

function a new obj texcoord from u v:
    replacement:
        @intrinsic("construct", an obj texcoord, u, v)

function a new obj triangle from a b c and uv indices ta tb tc in material material_index:
    replacement:
        @intrinsic("construct", an obj triangle, a, b, c, ta, tb, tc, material_index)

function a new obj material with name material_name and color r g b and texture path texture_name and texture id texture_id:
    replacement:
        @intrinsic("construct", an obj material, material_name, r, g, b, texture_name, texture_id)

function a new obj material set with materials material_ptr and count material_total:
    replacement:
        @intrinsic("construct", an obj material set, material_ptr, material_total)

function a new obj mesh with vertices verts count vertex_total and texcoords tex count tex_total and triangles tris count triangle_total and materials material_ptr count material_total:
    replacement:
        @intrinsic("construct", an obj mesh, verts, vertex_total, tex, tex_total, tris, triangle_total, material_ptr, material_total)

function an empty obj material set:
    execute:
        return a new obj material set with materials (0 as a pointer to obj material) and count 0

function an empty obj mesh:
    execute:
        return a new obj mesh with vertices (0 as a pointer to obj vertex) count 0 and texcoords (0 as a pointer to obj texcoord) count 0 and triangles (0 as a pointer to obj triangle) count 0 and materials (0 as a pointer to obj material) count 0

function a duplicated obj cstring from source:
    execute:
        if source = 0 as a pointer to byte:
            return 0 as a pointer to byte

        set source_length to @intrinsic("call", "libc", "strlen", a 64 bit integer, source)
        set copy to @intrinsic("call", "libc", "malloc", a pointer to byte, source_length + 1)
        if copy = 0 as a pointer to byte:
            return 0 as a pointer to byte

        discard @intrinsic("call", "libc", "memcpy", a pointer to byte, copy, source, source_length + 1)
        return copy

function a loaded obj texture from ppm path:
    execute:
        set file to @intrinsic("call", "libc", "fopen", a pointer to byte, path, "rb")
        if file = 0 as a pointer to byte:
            return 0

        set width to 0
        set height to 0
        set max_value to 0

        set header_read to @intrinsic("call", "libc", "fscanf", an integer, file, "P6 %d %d %d", address of width, address of height, address of max_value)
        if (header_read != 3) or ((width <= 0) or ((height <= 0) or (max_value != 255))):
            discard @intrinsic("call", "libc", "fclose", an integer, file)
            return 0

        discard @intrinsic("call", "libc", "fgetc", an integer, file)

        set pixel_count to width * height
        multiply pixel_count by 3
        set pixels to @intrinsic("call", "libc", "malloc", a pointer to byte, pixel_count)
        if pixels = 0 as a pointer to byte:
            discard @intrinsic("call", "libc", "fclose", an integer, file)
            return 0

        set bytes_read to @intrinsic("call", "libc", "fread", a 64 bit integer, pixels, 1 as a 64 bit integer, pixel_count as a 64 bit integer, file)
        discard @intrinsic("call", "libc", "fclose", an integer, file)

        set expected_byte_count to pixel_count as a 64 bit integer
        if bytes_read != expected_byte_count:
            @intrinsic("call", "libc", "free", void, pixels)
            return 0

        set texture_id to 0 as a 32 bit integer
        @intrinsic("call", "GL", "glGenTextures", void, 1, address of texture_id)
        @intrinsic("call", "GL", "glBindTexture", void, 3553, texture_id)
        @intrinsic("call", "GL", "glTexParameteri", void, 3553, 10241, 9729)
        @intrinsic("call", "GL", "glTexParameteri", void, 3553, 10240, 9729)
        @intrinsic("call", "GL", "glTexParameteri", void, 3553, 10242, 10497)
        @intrinsic("call", "GL", "glTexParameteri", void, 3553, 10243, 10497)
        @intrinsic("call", "GL", "glTexImage2D", void, 3553, 0, 6407, width, height, 0, 6407, 5121, pixels)

        @intrinsic("call", "libc", "free", void, pixels)
        return texture_id as an integer

function the index of obj material named material_name in materials count material_count:
    execute:
        set material_lookup_i to 0
        while material_lookup_i < material_count:
            set material_entry to item material_lookup_i of materials
            if @intrinsic("call", "libc", "strcmp", an integer, material_entry's name, material_name) = 0:
                return material_lookup_i
            increment material_lookup_i
        return -1

function a loaded obj material set from mtl_path:
    execute:
        if mtl_path = 0 as a pointer to byte:
            return an empty obj material set

        set file to @intrinsic("call", "libc", "fopen", a pointer to byte, mtl_path, "rb")
        if file = 0 as a pointer to byte:
            return an empty obj material set

        set material_capacity to 16
        set material_count to 0
        set materials to @intrinsic("call", "libc", "malloc", a pointer to obj material, material_capacity * the size of an obj material)
        if materials = 0 as a pointer to obj material:
            discard @intrinsic("call", "libc", "fclose", an integer, file)
            return an empty obj material set

        set line to @intrinsic("call", "libc", "malloc", a pointer to byte, 4096)
        set material_name_buffer to @intrinsic("call", "libc", "malloc", a pointer to byte, 512)
        set texture_name_buffer to @intrinsic("call", "libc", "malloc", a pointer to byte, 2048)

        if (line = 0 as a pointer to byte) or ((material_name_buffer = 0 as a pointer to byte) or (texture_name_buffer = 0 as a pointer to byte)):
            if line != 0 as a pointer to byte:
                @intrinsic("call", "libc", "free", void, line)
            if material_name_buffer != 0 as a pointer to byte:
                @intrinsic("call", "libc", "free", void, material_name_buffer)
            if texture_name_buffer != 0 as a pointer to byte:
                @intrinsic("call", "libc", "free", void, texture_name_buffer)
            @intrinsic("call", "libc", "free", void, materials)
            discard @intrinsic("call", "libc", "fclose", an integer, file)
            return an empty obj material set

        set current_material to -1
        set kd_r to 0.8
        set kd_g to 0.8
        set kd_b to 0.8

        set has_line to @intrinsic("call", "libc", "fgets", a pointer to byte, line, 4096, file)
        while has_line != 0 as a pointer to byte:
            if @intrinsic("call", "libc", "sscanf", an integer, line, "newmtl %511s", material_name_buffer) = 1:
                if material_count >= material_capacity:
                    multiply material_capacity by 2
                    set materials to @intrinsic("call", "libc", "realloc", a pointer to obj material, materials, material_capacity * the size of an obj material)

                set new_name to a duplicated obj cstring from material_name_buffer
                set new_material to a new obj material with name new_name and color 0.8 0.8 0.8 and texture path (0 as a pointer to byte) and texture id 0
                store new_material into materials at material_count
                set current_material to material_count
                increment material_count
            else:
                if (current_material >= 0) and (@intrinsic("call", "libc", "sscanf", an integer, line, "Kd %lf %lf %lf", address of kd_r, address of kd_g, address of kd_b) = 3):
                    set existing to item current_material of materials
                    set updated to a new obj material with name existing's name and color kd_r kd_g kd_b and texture path existing's texture_path and texture id existing's texture_id
                    store updated into materials at current_material
                else:
                    if (current_material >= 0) and (@intrinsic("call", "libc", "sscanf", an integer, line, "map_Kd %2047s", texture_name_buffer) = 1):
                        set existing to item current_material of materials
                        set new_texture_path to a duplicated obj cstring from texture_name_buffer
                        set new_texture_id to a loaded obj texture from ppm new_texture_path

                        if existing's texture_path != 0 as a pointer to byte:
                            @intrinsic("call", "libc", "free", void, existing's texture_path)

                        set updated to a new obj material with name existing's name and color existing's color_r existing's color_g existing's color_b and texture path new_texture_path and texture id new_texture_id
                        store updated into materials at current_material

            set has_line to @intrinsic("call", "libc", "fgets", a pointer to byte, line, 4096, file)

        discard @intrinsic("call", "libc", "fclose", an integer, file)
        @intrinsic("call", "libc", "free", void, line)
        @intrinsic("call", "libc", "free", void, material_name_buffer)
        @intrinsic("call", "libc", "free", void, texture_name_buffer)

        if material_count = 0:
            @intrinsic("call", "libc", "free", void, materials)
            set materials to (0 as a pointer to obj material)
        else:
            set materials to @intrinsic("call", "libc", "realloc", a pointer to obj material, materials, material_count * the size of an obj material)

        return a new obj material set with materials materials and count material_count

function a loaded obj mesh from path:
    execute:
        set scan_file to @intrinsic("call", "libc", "fopen", a pointer to byte, path, "rb")
        if scan_file = 0 as a pointer to byte:
            return an empty obj mesh

        set scan_line to @intrinsic("call", "libc", "malloc", a pointer to byte, 4096)
        set mtllib_buffer to @intrinsic("call", "libc", "malloc", a pointer to byte, 2048)
        set mtl_path to (0 as a pointer to byte)

        if (scan_line != 0 as a pointer to byte) and (mtllib_buffer != 0 as a pointer to byte):
            set has_scan_line to @intrinsic("call", "libc", "fgets", a pointer to byte, scan_line, 4096, scan_file)
            while has_scan_line != 0 as a pointer to byte:
                if @intrinsic("call", "libc", "sscanf", an integer, scan_line, "mtllib %2047s", mtllib_buffer) = 1:
                    if mtl_path != 0 as a pointer to byte:
                        @intrinsic("call", "libc", "free", void, mtl_path)
                    set mtl_path to a duplicated obj cstring from mtllib_buffer

                set has_scan_line to @intrinsic("call", "libc", "fgets", a pointer to byte, scan_line, 4096, scan_file)

        discard @intrinsic("call", "libc", "fclose", an integer, scan_file)

        if scan_line != 0 as a pointer to byte:
            @intrinsic("call", "libc", "free", void, scan_line)
        if mtllib_buffer != 0 as a pointer to byte:
            @intrinsic("call", "libc", "free", void, mtllib_buffer)

        set loaded_materials to a loaded obj material set from mtl_path
        if mtl_path != 0 as a pointer to byte:
            @intrinsic("call", "libc", "free", void, mtl_path)

        set materials to loaded_materials's materials
        set material_count to loaded_materials's material_count

        set file to @intrinsic("call", "libc", "fopen", a pointer to byte, path, "rb")
        if file = 0 as a pointer to byte:
            if materials != 0 as a pointer to obj material:
                @intrinsic("call", "libc", "free", void, materials)
            return an empty obj mesh

        set vertex_capacity to 1024
        set texcoord_capacity to 1024
        set triangle_capacity to 2048

        set vertex_count to 0
        set texcoord_count to 0
        set triangle_count to 0

        set vertices to @intrinsic("call", "libc", "malloc", a pointer to obj vertex, vertex_capacity * the size of an obj vertex)
        set texcoords to @intrinsic("call", "libc", "malloc", a pointer to obj texcoord, texcoord_capacity * the size of an obj texcoord)
        set triangles to @intrinsic("call", "libc", "malloc", a pointer to obj triangle, triangle_capacity * the size of an obj triangle)

        set line to @intrinsic("call", "libc", "malloc", a pointer to byte, 4096)
        set usemtl_name to @intrinsic("call", "libc", "malloc", a pointer to byte, 512)

        set current_material to -1

        set vx to 0.0
        set vy to 0.0
        set vz to 0.0
        set vr to 0.0
        set vg to 0.0
        set vb to 0.0

        set tu to 0.0
        set tv to 0.0

        set ia to 0
        set ib to 0
        set ic to 0
        set ita to 0
        set itb to 0
        set itc to 0
        set ina to 0
        set inb to 0
        set inc to 0

        set has_line to @intrinsic("call", "libc", "fgets", a pointer to byte, line, 4096, file)
        while has_line != 0 as a pointer to byte:
            if @intrinsic("call", "libc", "sscanf", an integer, line, "v %lf %lf %lf %lf %lf %lf", address of vx, address of vy, address of vz, address of vr, address of vg, address of vb) = 6:
                if vertex_count >= vertex_capacity:
                    multiply vertex_capacity by 2
                    set vertices to @intrinsic("call", "libc", "realloc", a pointer to obj vertex, vertices, vertex_capacity * the size of an obj vertex)

                store a new obj colored vertex from vx vy vz and color vr vg vb into vertices at vertex_count
                increment vertex_count
            else:
                if @intrinsic("call", "libc", "sscanf", an integer, line, "v %lf %lf %lf", address of vx, address of vy, address of vz) = 3:
                    if vertex_count >= vertex_capacity:
                        multiply vertex_capacity by 2
                        set vertices to @intrinsic("call", "libc", "realloc", a pointer to obj vertex, vertices, vertex_capacity * the size of an obj vertex)

                    store a new obj vertex from vx vy vz into vertices at vertex_count
                    increment vertex_count
                else:
                    if @intrinsic("call", "libc", "sscanf", an integer, line, "vt %lf %lf", address of tu, address of tv) = 2:
                        if texcoord_count >= texcoord_capacity:
                            multiply texcoord_capacity by 2
                            set texcoords to @intrinsic("call", "libc", "realloc", a pointer to obj texcoord, texcoords, texcoord_capacity * the size of an obj texcoord)

                        store a new obj texcoord from tu tv into texcoords at texcoord_count
                        increment texcoord_count
                    else:
                        if @intrinsic("call", "libc", "sscanf", an integer, line, "usemtl %511s", usemtl_name) = 1:
                            set current_material to the index of obj material named usemtl_name in materials count material_count
                        else:
                            set face_with_uv_and_normal to @intrinsic("call", "libc", "sscanf", an integer, line, "f %d/%d/%d %d/%d/%d %d/%d/%d", address of ia, address of ita, address of ina, address of ib, address of itb, address of inb, address of ic, address of itc, address of inc)
                            if face_with_uv_and_normal = 9:
                                if ia > 0:
                                    decrement ia
                                if ib > 0:
                                    decrement ib
                                if ic > 0:
                                    decrement ic
                                if ita > 0:
                                    decrement ita
                                if itb > 0:
                                    decrement itb
                                if itc > 0:
                                    decrement itc

                                if triangle_count >= triangle_capacity:
                                    multiply triangle_capacity by 2
                                    set triangles to @intrinsic("call", "libc", "realloc", a pointer to obj triangle, triangles, triangle_capacity * the size of an obj triangle)

                                store @intrinsic("construct", an obj triangle, ia, ib, ic, ita, itb, itc, current_material) into triangles at triangle_count
                                increment triangle_count
                            else:
                                set face_with_uv to @intrinsic("call", "libc", "sscanf", an integer, line, "f %d/%d %d/%d %d/%d", address of ia, address of ita, address of ib, address of itb, address of ic, address of itc)
                                if face_with_uv = 6:
                                    if ia > 0:
                                        decrement ia
                                    if ib > 0:
                                        decrement ib
                                    if ic > 0:
                                        decrement ic
                                    if ita > 0:
                                        decrement ita
                                    if itb > 0:
                                        decrement itb
                                    if itc > 0:
                                        decrement itc

                                    if triangle_count >= triangle_capacity:
                                        multiply triangle_capacity by 2
                                        set triangles to @intrinsic("call", "libc", "realloc", a pointer to obj triangle, triangles, triangle_capacity * the size of an obj triangle)

                                    store @intrinsic("construct", an obj triangle, ia, ib, ic, ita, itb, itc, current_material) into triangles at triangle_count
                                    increment triangle_count
                                else:
                                    set face_with_normal to @intrinsic("call", "libc", "sscanf", an integer, line, "f %d//%d %d//%d %d//%d", address of ia, address of ina, address of ib, address of inb, address of ic, address of inc)
                                    if face_with_normal = 6:
                                        if ia > 0:
                                            decrement ia
                                        if ib > 0:
                                            decrement ib
                                        if ic > 0:
                                            decrement ic

                                        if triangle_count >= triangle_capacity:
                                            multiply triangle_capacity by 2
                                            set triangles to @intrinsic("call", "libc", "realloc", a pointer to obj triangle, triangles, triangle_capacity * the size of an obj triangle)

                                        store @intrinsic("construct", an obj triangle, ia, ib, ic, -1, -1, -1, current_material) into triangles at triangle_count
                                        increment triangle_count
                                    else:
                                        set plain_face to @intrinsic("call", "libc", "sscanf", an integer, line, "f %d %d %d", address of ia, address of ib, address of ic)
                                        if plain_face = 3:
                                            if ia > 0:
                                                decrement ia
                                            if ib > 0:
                                                decrement ib
                                            if ic > 0:
                                                decrement ic

                                            if triangle_count >= triangle_capacity:
                                                multiply triangle_capacity by 2
                                                set triangles to @intrinsic("call", "libc", "realloc", a pointer to obj triangle, triangles, triangle_capacity * the size of an obj triangle)

                                            store @intrinsic("construct", an obj triangle, ia, ib, ic, -1, -1, -1, current_material) into triangles at triangle_count
                                            increment triangle_count

            set has_line to @intrinsic("call", "libc", "fgets", a pointer to byte, line, 4096, file)

        discard @intrinsic("call", "libc", "fclose", an integer, file)

        @intrinsic("call", "libc", "free", void, line)
        @intrinsic("call", "libc", "free", void, usemtl_name)

        if vertex_count = 0:
            @intrinsic("call", "libc", "free", void, vertices)
            set vertices to (0 as a pointer to obj vertex)
        else:
            set vertices to @intrinsic("call", "libc", "realloc", a pointer to obj vertex, vertices, vertex_count * the size of an obj vertex)

        if texcoord_count = 0:
            @intrinsic("call", "libc", "free", void, texcoords)
            set texcoords to (0 as a pointer to obj texcoord)
        else:
            set texcoords to @intrinsic("call", "libc", "realloc", a pointer to obj texcoord, texcoords, texcoord_count * the size of an obj texcoord)

        if triangle_count = 0:
            @intrinsic("call", "libc", "free", void, triangles)
            set triangles to (0 as a pointer to obj triangle)
        else:
            set triangles to @intrinsic("call", "libc", "realloc", a pointer to obj triangle, triangles, triangle_count * the size of an obj triangle)

        return a new obj mesh with vertices vertices count vertex_count and texcoords texcoords count texcoord_count and triangles triangles count triangle_count and materials materials count material_count

function a clamped obj color channel from value:
    execute:
        set channel_value to value
        if channel_value < 0.0:
            set channel_value to 0.0
        if channel_value > 1.0:
            set channel_value to 1.0
        return channel_value

function a wrapped obj uv coordinate from value:
    execute:
        set wrapped_value to value
        while wrapped_value < 0.0:
            add 1.0 to wrapped_value
        while wrapped_value >= 1.0:
            subtract 1.0 from wrapped_value
        return wrapped_value

function draw obj mesh mesh at x y z with scale model_scale and color r g b:
    execute:
        draw obj mesh mesh at x y z with scale model_scale and color r g b and render mode 0

function draw obj mesh mesh at x y z with scale model_scale and color r g b and render mode render_mode:
    execute:
        if mesh's triangle_count > 0:
            set vertices to mesh's vertices
            set texcoords to mesh's texcoords
            set triangles to mesh's triangles
            set materials to mesh's materials

            @intrinsic("call", "GL", "glPushMatrix", void)
            @intrinsic("call", "GL", "glTranslated", void, x, y, z)
            @intrinsic("call", "GL", "glScaled", void, model_scale, model_scale, model_scale)

            set render_mode_value to render_mode
            if render_mode_value < 0:
                set render_mode_value to 0
            if render_mode_value > 2:
                set render_mode_value to 2

            set base_red to r as a float
            set base_green to g as a float
            set base_blue to b as a float
            divide base_red by 255.0
            divide base_green by 255.0
            divide base_blue by 255.0

            set tri_index to 0
            set active_material to -2147483647
            set current_texture_id to 0
            set fallback_red to base_red
            set fallback_green to base_green
            set fallback_blue to base_blue
            set drawing to false

            while tri_index < mesh's triangle_count:
                set tri to item tri_index of triangles

                if tri's material != active_material:
                    if drawing:
                        @intrinsic("call", "GL", "glEnd", void)

                    set active_material to tri's material
                    set current_texture_id to 0
                    set fallback_red to base_red
                    set fallback_green to base_green
                    set fallback_blue to base_blue

                    if (active_material >= 0) and (active_material < mesh's material_count):
                        set material to item active_material of materials
                        set fallback_red to a clamped obj color channel from material's color_r
                        set fallback_green to a clamped obj color channel from material's color_g
                        set fallback_blue to a clamped obj color channel from material's color_b
                        set current_texture_id to material's texture_id

                        if render_mode_value = 0:
                            if current_texture_id > 0:
                                @intrinsic("call", "GL", "glEnable", void, 3553)
                                @intrinsic("call", "GL", "glBindTexture", void, 3553, current_texture_id as a 32 bit integer)
                                @intrinsic("call", "GL", "glColor3ub", void, 255, 255, 255)
                            else:
                                @intrinsic("call", "GL", "glDisable", void, 3553)
                                set red_value to material's color_r * 255.0
                                set green_value to material's color_g * 255.0
                                set blue_value to material's color_b * 255.0
                                set red to red_value as an integer
                                set green to green_value as an integer
                                set blue to blue_value as an integer

                                if red < 0:
                                    set red to 0
                                if green < 0:
                                    set green to 0
                                if blue < 0:
                                    set blue to 0

                                if red > 255:
                                    set red to 255
                                if green > 255:
                                    set green to 255
                                if blue > 255:
                                    set blue to 255

                                @intrinsic("call", "GL", "glColor3ub", void, red, green, blue)
                        else:
                            @intrinsic("call", "GL", "glDisable", void, 3553)
                            @intrinsic("call", "GL", "glColor3d", void, fallback_red, fallback_green, fallback_blue)
                    else:
                        @intrinsic("call", "GL", "glDisable", void, 3553)
                        if render_mode_value = 0:
                            @intrinsic("call", "GL", "glColor3ub", void, r, g, b)
                        else:
                            @intrinsic("call", "GL", "glColor3d", void, fallback_red, fallback_green, fallback_blue)

                    @intrinsic("call", "GL", "glBegin", void, 4)
                    set drawing to true

                set ia to tri's a
                set ib to tri's b
                set ic to tri's c

                set va to item ia of vertices
                set vb to item ib of vertices
                set vc to item ic of vertices

                set edge_ax to vb's x - va's x
                set edge_ay to vb's y - va's y
                set edge_az to vb's z - va's z
                set edge_bx to vc's x - va's x
                set edge_by to vc's y - va's y
                set edge_bz to vc's z - va's z

                set triangle_normal_x to (edge_ay * edge_bz) - (edge_az * edge_by)
                set triangle_normal_y to (edge_az * edge_bx) - (edge_ax * edge_bz)
                set triangle_normal_z to (edge_ax * edge_by) - (edge_ay * edge_bx)

                set normal_length_squared to triangle_normal_x * triangle_normal_x
                set normal_length_squared to normal_length_squared + (triangle_normal_y * triangle_normal_y)
                set normal_length_squared to normal_length_squared + (triangle_normal_z * triangle_normal_z)

                set shade_factor to 0.7
                if normal_length_squared > 0.000000000001:
                    set normal_length to the square root of normal_length_squared
                    if normal_length > 0.000001:
                        divide triangle_normal_x by normal_length
                        divide triangle_normal_y by normal_length
                        divide triangle_normal_z by normal_length

                        set shade_factor to triangle_normal_x * 0.45
                        set shade_factor to shade_factor + (triangle_normal_y * 0.85)
                        set shade_factor to shade_factor + (triangle_normal_z * 0.30)

                if shade_factor < 0.2:
                    set shade_factor to 0.2
                if shade_factor > 1.0:
                    set shade_factor to 1.0

                if render_mode_value = 0:
                    if current_texture_id > 0:
                        set shaded_red to shade_factor
                        set shaded_green to shade_factor
                        set shaded_blue to shade_factor
                    else:
                        set shaded_red to fallback_red * shade_factor
                        set shaded_green to fallback_green * shade_factor
                        set shaded_blue to fallback_blue * shade_factor
                    @intrinsic("call", "GL", "glColor3d", void, shaded_red, shaded_green, shaded_blue)

                    if current_texture_id > 0:
                        if ((tri's ta >= 0) and ((tri's tb >= 0) and (tri's tc >= 0))):
                            if (tri's ta < mesh's texcoord_count) and ((tri's tb < mesh's texcoord_count) and (tri's tc < mesh's texcoord_count)):
                                set tca to item tri's ta of texcoords
                                set tcb to item tri's tb of texcoords
                                set tcc to item tri's tc of texcoords
                                @intrinsic("call", "GL", "glTexCoord2d", void, tca's u, tca's v)
                                @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                                @intrinsic("call", "GL", "glTexCoord2d", void, tcb's u, tcb's v)
                                @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                                @intrinsic("call", "GL", "glTexCoord2d", void, tcc's u, tcc's v)
                                @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                            else:
                                @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                                @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                                @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                        else:
                            @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                            @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                            @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                    else:
                        @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                        @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                        @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                else:
                    if render_mode_value = 1:
                        if ((tri's ta >= 0) and ((tri's tb >= 0) and (tri's tc >= 0))):
                            if (tri's ta < mesh's texcoord_count) and ((tri's tb < mesh's texcoord_count) and (tri's tc < mesh's texcoord_count)):
                                set tca to item tri's ta of texcoords
                                set tcb to item tri's tb of texcoords
                                set tcc to item tri's tc of texcoords

                                set uv_u_a to a wrapped obj uv coordinate from tca's u
                                set uv_v_a to a wrapped obj uv coordinate from tca's v
                                set uv_u_b to a wrapped obj uv coordinate from tcb's u
                                set uv_v_b to a wrapped obj uv coordinate from tcb's v
                                set uv_u_c to a wrapped obj uv coordinate from tcc's u
                                set uv_v_c to a wrapped obj uv coordinate from tcc's v

                                set uv_blue_a to 1.0 - ((uv_u_a + uv_v_a) / 2.0)
                                set uv_blue_b to 1.0 - ((uv_u_b + uv_v_b) / 2.0)
                                set uv_blue_c to 1.0 - ((uv_u_c + uv_v_c) / 2.0)

                                @intrinsic("call", "GL", "glColor3d", void, uv_u_a, uv_v_a, uv_blue_a)
                                @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                                @intrinsic("call", "GL", "glColor3d", void, uv_u_b, uv_v_b, uv_blue_b)
                                @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                                @intrinsic("call", "GL", "glColor3d", void, uv_u_c, uv_v_c, uv_blue_c)
                                @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                            else:
                                @intrinsic("call", "GL", "glColor3d", void, 1.0, 0.0, 1.0)
                                @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                                @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                                @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                        else:
                            @intrinsic("call", "GL", "glColor3d", void, 1.0, 0.0, 1.0)
                            @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)
                            @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)
                            @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)
                    else:
                        if va's has_color != 0:
                            set vertex_red_a to a clamped obj color channel from va's color_r
                            set vertex_green_a to a clamped obj color channel from va's color_g
                            set vertex_blue_a to a clamped obj color channel from va's color_b
                            @intrinsic("call", "GL", "glColor3d", void, vertex_red_a, vertex_green_a, vertex_blue_a)
                        else:
                            @intrinsic("call", "GL", "glColor3d", void, fallback_red, fallback_green, fallback_blue)
                        @intrinsic("call", "GL", "glVertex3d", void, va's x, va's y, va's z)

                        if vb's has_color != 0:
                            set vertex_red_b to a clamped obj color channel from vb's color_r
                            set vertex_green_b to a clamped obj color channel from vb's color_g
                            set vertex_blue_b to a clamped obj color channel from vb's color_b
                            @intrinsic("call", "GL", "glColor3d", void, vertex_red_b, vertex_green_b, vertex_blue_b)
                        else:
                            @intrinsic("call", "GL", "glColor3d", void, fallback_red, fallback_green, fallback_blue)
                        @intrinsic("call", "GL", "glVertex3d", void, vb's x, vb's y, vb's z)

                        if vc's has_color != 0:
                            set vertex_red_c to a clamped obj color channel from vc's color_r
                            set vertex_green_c to a clamped obj color channel from vc's color_g
                            set vertex_blue_c to a clamped obj color channel from vc's color_b
                            @intrinsic("call", "GL", "glColor3d", void, vertex_red_c, vertex_green_c, vertex_blue_c)
                        else:
                            @intrinsic("call", "GL", "glColor3d", void, fallback_red, fallback_green, fallback_blue)
                        @intrinsic("call", "GL", "glVertex3d", void, vc's x, vc's y, vc's z)

                increment tri_index

            if drawing:
                @intrinsic("call", "GL", "glEnd", void)

            @intrinsic("call", "GL", "glDisable", void, 3553)
            @intrinsic("call", "GL", "glPopMatrix", void)

function free obj mesh mesh:
    execute:
        if mesh's vertices != 0 as a pointer to obj vertex:
            @intrinsic("call", "libc", "free", void, mesh's vertices)

        if mesh's texcoords != 0 as a pointer to obj texcoord:
            @intrinsic("call", "libc", "free", void, mesh's texcoords)

        if mesh's triangles != 0 as a pointer to obj triangle:
            @intrinsic("call", "libc", "free", void, mesh's triangles)

        if mesh's materials != 0 as a pointer to obj material:
            set material_index to 0
            while material_index < mesh's material_count:
                set material to item material_index of mesh's materials

                if material's name != 0 as a pointer to byte:
                    @intrinsic("call", "libc", "free", void, material's name)

                if material's texture_path != 0 as a pointer to byte:
                    @intrinsic("call", "libc", "free", void, material's texture_path)

                if material's texture_id > 0:
                    set texture_id to material's texture_id as a 32 bit integer
                    @intrinsic("call", "GL", "glDeleteTextures", void, 1, address of texture_id)

                increment material_index

            @intrinsic("call", "libc", "free", void, mesh's materials)
