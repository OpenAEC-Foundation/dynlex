# DynLex Array Library

import lib/std.dl

function allocate count bytes:
    execute:
        return @intrinsic("call", "libc", "calloc", a pointer to a byte, count, 1)

function allocate count bytes as output_type:
    replacement:
        @intrinsic("call", "libc", "calloc", output_type, count, 1)

function allocate count items:
    replacement:
        allocate count bytes

function:
    patterns:
        allocate count slots of {type:element_type}
    replacement:
        allocate (count * the size of element_type) bytes as a pointer to element_type

function allocate count slots of value:
    execute:
        set array to allocate count slots of the type of value
        set i to 0
        loop while i < count:
            store value into array at i
            set i to i + 1
        return array

function store value into array at index:
    execute:
        @intrinsic("store at", array, index, value)

function item index of array:
    execute:
        return @intrinsic("load at", array, index)
