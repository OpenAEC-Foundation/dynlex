# DynLex Random Library

import lib/std.dl

function a random number:
    execute:
        return @intrinsic("call", "libc", "rand", an integer)

function the current time:
    execute:
        return @intrinsic("call", "libc", "time", a 64 bit integer, 0)

function seed the random number generator with value:
    execute:
        @intrinsic("call", "libc", "srand", nothing, value)
