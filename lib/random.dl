# DynLex Random Library

import lib/std.dl

expression a random number:
    execute:
        return @intrinsic("call", "libc", "rand", an integer)

expression current time:
    execute:
        return @intrinsic("call", "libc", "time", a 64 bit integer, 0)

expression seed random with value:
    execute:
        @intrinsic("call", "libc", "srand", void, value)
