import interface.dl
import actions.dl
import programs/commands.dl
import games/river/rendering.dl
import games/river/inspection/controller.dl
import startup.dl

# Replies have explicit owners and purposes. Platform services do not decide UI state.
to get receive website reply {a pointer to JSON value:response} for {integer:job} indexed {integer:index} in {a pointer to website state:state}:
    if job = 1:
        receive website environment response in state
        return true
    if job = 2:
        if response is not JSON null:
            apply location response to state
    if job = 3:
        require condition ((the JSON number named "status" in response) = 200.0) reporting "The shader catalog could not be loaded"
        parse (the JSON text named "text" in response) as JSON and set parsed to it
        set catalog to the value of parsed
        require condition (catalog's length = (the length of (the site's shaders))) reporting "The shader catalog is inconsistent with its descriptions"
        set cursor to 0
        loop while cursor < catalog's length:
            set entry to the JSON value at index cursor in catalog
            set scene to state's shaders + cursor
            set description to the item at cursor in (the site's shaders)
            require condition ((the JSON text named "id" in entry) = description's id) reporting "The shader catalog order is inconsistent"
            set scene's geometry to description's geometry
            set scene's program to a copy of JSON-RPC node (the JSON member named "program" in entry)
            set payload to the compact JSON form of (scene's program)
            request "graphics" with JSON data payload for purpose 4 indexed cursor in state
            increment cursor
        free catalog
    if job = 4:
        set resource to ((the JSON number named "resource" in response) as an integer) as a pointer
        set (state's shaders + index)'s resource to resource
        initialize loaded website shader data in (state's shaders + index) using (state's view)
        request a UI redraw in (state's view)
    if job = 5:
        receive website release response in state
    if job = 6:
        receive website compilation response for index in state
    if job = 7:
        receive website execution response for index in state
    if job = 8:
        receive website language reply response at step index in state
    if job = 9:
        if receive website shader source response in state:
            run website program 2 in state
    if job = 10:
        receive the website shader preview response in state
    if job = 11:
        receive website river audio response in state
    if job = 12:
        receive website river idle deadline in state
    if job = 13:
        receive website river voice index in state
    if (job >= 14) and (job <= 20):
        receive website account reply response for purpose job indexed index in state
    if (job = 21) or (job = 22):
        receive website Farm graphics response for purpose job in state
    if job = 23:
        receive website Farm deadline index in state
    if job = 24:
        receive website execution deadline index in state
    return false

to read website input {a pointer to UI view:view}:
    read website Farm input view
    if view's input kind = 7:
        set state to the website state in (view's instance)
        set index to 0
        loop while index < the length of (the site's shaders):
            set (state's shaders + index)'s active to false
            increment index
        set state's shader editor's preview's active to false
        set state's river's active to false
        pause website Farm in state
        if state's route = "/river-character-sheet.html":
            pause website river inspection (the address of (state's river inspection's clock)) at (view's seconds)
            refresh website river inspection the address of (state's river inspection)
        flush website account save in state
    if (view's input kind != 11) and (view's input kind != 12):
        return nothing
    set state to the website state in (view's instance)
    parse (view's message) as JSON and set parsed to it
    set document to the value of parsed
    if view's input kind = 12:
        set kind to the JSON text named "type" in document
        if kind = "location":
            apply location document to state
        else if kind = "program-output":
            receive website program output document in state
        else if kind = "program-started":
            receive website execution start document in state
        else if (kind = "firebase-auth") or (kind = "connectivity"):
            receive website account notification document in state
        else:
            require condition false reporting "The website received an unknown platform notification"
        free document
        return nothing
    set pending to state's requests
    set previous to @intrinsic("construct", a pointer to website request)
    loop while pending != @intrinsic("construct", a pointer to website request):
        if pending's id = view's input code:
            if previous = @intrinsic("construct", a pointer to website request):
                set state's requests to pending's next
            else:
                set previous's next to pending's next
            set retained to false
            if pending's cancelled:
                if view's modifiers = 0:
                    discard website reply document for purpose (pending's purpose) in state
            else if view's modifiers = 0:
                set retained to receive website reply document for (pending's purpose) indexed (pending's index) in state
            else:
                set view's instance's status to "An error occurred. Check the log."
                if pending's purpose = 5:
                    set state's release loading to false
                    set the text of "Release status" in (view's instance) to "An error occurred. Check the log."
                if (pending's purpose = 6) or (pending's purpose = 7):
                    fail website program (pending's index) in state
                if pending's purpose = 8:
                    fail UI source workspace (state's language)
                    present website source colors in state
                if pending's purpose = 9:
                    fail the website shader source in state
                if pending's purpose = 10:
                    fail website program 2 in state
                if (pending's purpose = 11) or ((pending's purpose = 12) or (pending's purpose = 13)):
                    fail website river audio after purpose (pending's purpose) indexed (pending's index) in state
                if (pending's purpose >= 14) and (pending's purpose <= 20):
                    if ((pending's purpose = 14) or ((pending's purpose = 15) or (pending's purpose = 20))) or (pending's index = state's account's generation):
                        fail website account purpose (pending's purpose) in state
                if (pending's purpose = 21) or (pending's purpose = 22):
                    fail website Farm graphics (the string form of "The Farm graphics service failed") in state
                if pending's purpose = 23:
                    set state's farm's clock request to 0
                    pause website Farm in state
                if pending's purpose = 24:
                    fail website execution deadline (pending's index) in state
            deallocate pending
            if retained = false:
                free document
            return nothing
        set previous to pending
        set pending to pending's next
    require condition false reporting "The website received a reply without a request"

to close the website {a pointer to UI view:view}:
    set instance to view's instance
    set state to the website state in instance
    close website Farm in state
    free website river trace the address of (state's river's trace)
    free state's river's coding
    free state's progress's document
    free state's account's configuration
    free state's account's revision
    free UI source workspace (state's language)
    close view
    close instance
    set pending to state's requests
    loop while pending != @intrinsic("construct", a pointer to website request):
        set next to pending's next
        deallocate pending
        set pending to next
    free state's environment
    set index to 0
    loop while index < the length of (the site's shaders):
        set program to (state's shaders + index)'s program
        if program != @intrinsic("construct", a pointer to JSON value):
            free program
        increment index
    if state's shader editor's preview's program != @intrinsic("construct", a pointer to JSON value):
        free state's shader editor's preview's program
    if state's shader editor's pending program != @intrinsic("construct", a pointer to JSON value):
        free state's shader editor's pending program
    if state's release != @intrinsic("construct", a pointer to website release):
        free state's release
    destroy the value at state
    deallocate state
    destroy the value at view
    deallocate view
    destroy the value at instance
    deallocate instance

function open the DynLex website using {a pointer to UI driver:driver} with {a pointer to UI service provider:services}:
    globals:
        dynlex website
        river character page
    execute:
        set instance to storage for one slot initialized with (an instance of dynlex website)
        set state to storage for one slot initialized with (a new website state)
        set state's services to services
        set instance's state to state as a pointer
        show page "/index.html" in instance
        set view to storage for one slot initialized with (a UI view of instance sized 1280 by 900 using fonts "assets/fonts/Inter-400.ttf" and "assets/fonts/Inter-600.ttf" with driver)
        set state's view to view
        set state's farm's names to UI floating controls attached to (the control labeled "Farm scene" in instance) in view
        set state's shader editor's description to the custom website shader
        store 1.0 into (state's shader weights) at 0
        set state's route to "/index.html"
        set view's close action to (the function named "close the website $") as a pointer
        open website appearance in state
        open website source editors in state
        initialize the website river in state
        initialize the website Farm in state
        connect website river inspection (the address of (state's river inspection)) within (river character page's content) in view
        open website progress in state
        open website account with (the website account configuration) in state
        bind (the control labeled "River scene" in instance) in instance to (the function named "paint the website river $") for event 1
        bind (the control labeled "Farm scene" in instance) in instance to (the function named "paint the website Farm $") for event 1
        bind website links in (instance's description) for instance
        bind website program commands in state
        bind (the control labeled "IDE source" in instance) in instance to (the function named "notice website source edit $") for event 0
        bind (the control labeled "Shader source" in instance) in instance to (the function named "notice website source edit $") for event 0
        bind (the control labeled "IDE modes" in instance) in instance to (the function named "notice website editor mode $") for event 0
        bind (the control labeled "IDE shader preview" in instance) in instance to (the function named "paint the website shader preview $") for event 1
        bind (the control labeled "Live shader" in instance) in instance to (the function named "paint the website shader $") for event 1
        watch UI input in view using (the function named "read website input $")
        update UI frames in view using (the function named "advance the website frame $")
        request website environment in state
        run view
