import ../packages/dynlex-ui/ui/shaders.dl
import ../state.dl
import ../editor/shader.dl
import ../editor/language.dl
import events.dl
import deadlines.dl

to stop website [program] {integer:index} in {a pointer to website state:state}:
    set program to state's programs + index
    if index = 2:
        set editor to the address of (state's shader editor)
        if editor's source request != 0:
            ignore cancel website request (editor's source request) in state
            set editor's source request to 0
            set editor's source failed to true
            set the text of "IDE status" in (state's view's instance) to "Stopped."
            set the text of "Run program ▶" in (state's view's instance) to "Retry source load ↻"
        if editor's pending program != @intrinsic("construct", a pointer to JSON value):
            free editor's pending program
            set editor's pending program to @intrinsic("construct", a pointer to JSON value)
        set editor's preview's paused to true
        set editor's preview's active to false
        set the text of "Pause preview" in (state's view's instance) to "Resume preview"
    if program's phase = 0:
        return nothing
    if program's phase != 3:
        ignore cancel website request (program's request) in state
    set program's phase to 0
    set program's request to 0
    set description to the item at index in (the website program descriptions)
    set the text of (description's status) in (state's view's instance) to "Stopped."
    notify website program index with result 4 in state

to get [prepare website program] {integer:index} in {a pointer to website state:state}:
    if (index = 2) and (the website editor uses shaders in state):
        if state's shader editor's source request != 0:
            set the text of "IDE status" in (state's view's instance) to "Loading shader source…"
            return false
        if state's shader editor's source failed:
            load the website shader source in state
            return false
    set other to 0
    loop while other < the length of (the website program descriptions):
        stop website program other in state
        increment other
    return true

to get [the source editor of website program] {integer:index} in {a pointer to website state:state}:
    set description to the item at index in (the website program descriptions)
    set instance to state's view's instance
    set editor to the active UI editor within (the control labeled (description's source) in instance) in instance
    require condition (editor != @intrinsic("construct", UI reference)) reporting "The program source has no active editor"
    return the UI source editor labeled (editor's text) in (state's language)

to run website [program] {integer:index} in {a pointer to website state:state}:
    if prepare website program index in state:
        set editor to the source editor of website program index in state
        set source to the UI main source of editor in (state's language) at (state's view's seconds) seconds
        compile website program index from source source using editor in state

to run website [program] {integer:index} [from source] {string:source} in {a pointer to website state:state}:
    if prepare website program index in state:
        set editor to the source editor of website program index in state
        ignore (the UI main source of editor in (state's language) at (state's view's seconds) seconds)
        compile website program index from source source using editor in state

to [compile website program] {integer:index} [from source] {string:source} [using] {a pointer to UI source editor:source editor} in {a pointer to website state:state}:
    set program to state's programs + index
    set description to the item at index in (the website program descriptions)
    set instance to state's view's instance
    set program's source to source
    set program's result to 0
    set program's executing to false
    set program's output to ""
    increment state's invocation
    set program's invocation to state's invocation
    set program's phase to 1
    if (index != 2) or ((the website editor uses shaders in state) = false):
        set the text of (description's output) in instance to ""
    set the text of (description's status) in instance to "Compiling…"
    if program's started != (0 as a pointer):
        @intrinsic("call pointer", program's started, nothing, index, state)
    set name to source editor's document's project's entry's filename
    set target to "cpu"
    set stages to a new JSON value of kind the JSON array kind
    if (index = 2) and (the website editor uses shaders in state):
        set target to "shader"
        free stages
        set stages to the shader stages for (state's shader editor's description's geometry)
        set state's shader editor's preview's paused to false
        set state's shader editor's preview's active to false
        set the text of "Pause preview" in instance to "Pause preview"
    set sources to the UI source files of (source editor's document's project) with main source source
    request "compiler" containing (a JSON object containing [
        JSON text "operation" is "compile", JSON text "target" is target, JSON text "entry" is name,
        JSON flag "traced" is (description's traced),
        JSON child "stages" is stages,
        JSON child "sources" is sources
    ]) for purpose 6 indexed index in state
    set program's request to state's requests' id

to get the website [diagnostic] text in {a pointer to JSON value:response} after {integer:prefix} lines of {string:entry}:
    set result to the string form of ""
    set diagnostics to the JSON member named "diagnostics" in response
    set index to 0
    loop while index < diagnostics's length:
        set diagnostic to the JSON value at index index in diagnostics
        set file to the JSON text named "file" in diagnostic
        set line to (the JSON number named "line" in diagnostic) as an integer
        if file = entry:
            set line to the maximum of 1 and (line - prefix)
        set column to (the JSON number named "column" in diagnostic) as an integer
        set message to the JSON text named "message" in diagnostic
        set result to formatted "{result}{file}:{line}:{column}: {message}\n"
        increment index
    return result

to receive website compilation {a pointer to JSON value:response} for {integer:index} in {a pointer to website state:state}:
    set program to state's programs + index
    require condition (program's phase = 1) reporting "A compilation reply arrived outside the compilation phase"
    set description to the item at index in (the website program descriptions)
    set instance to state's view's instance
    set program's request to 0
    set program's compile milliseconds to the JSON number named "milliseconds" in response
    set the text of "Compilation measurement" in instance to (formatted "LAST COMPILE / {program's compile milliseconds} MS")
    if (the JSON number named "status" in response) != 0.0:
        set program's phase to 0
        set name to the string form of (description's filename)
        if index = 2:
            set name to the website source filename in state
        set program's output to the website diagnostic text in response after (the website prefix line count of description) lines of ("/workspace/" + name)
        if (index != 2) or ((the website editor uses shaders in state) = false):
            set the text of (description's output) in instance to (program's output)
        set the text of (description's status) in instance to "Compilation failed."
        if (index = 2) and (the website editor uses shaders in state):
            set the text of "IDE diagnostics" in instance to (program's output)
        notify website program index with result 2 in state
        return nothing
    if (index = 2) and (the website editor uses shaders in state):
        receive website shader compilation response in state
        return nothing
    set program's phase to 2
    set the text of (description's status) in instance to "Running…"
    request "program" containing (a JSON object containing [
        JSON number "artifact" is (the JSON number named "artifact" in response),
        JSON number "invocation" is (program's invocation), JSON number "outputLimit" is 1048576
    ]) for purpose 7 indexed index in state
    set program's request to state's requests' id
    start website loading budget for index in state

to receive website execution {a pointer to JSON value:response} for {integer:index} in {a pointer to website state:state}:
    set program to state's programs + index
    require condition (program's phase = 2) reporting "An execution reply arrived outside the running phase"
    set program's phase to 0
    set program's request to 0
    set description to the item at index in (the website program descriptions)
    set elapsed to the JSON number named "milliseconds" in response
    set status to formatted "Compiled in {program's compile milliseconds} ms · ran in {elapsed} ms"
    set the text of (description's status) in (state's view's instance) to status
    notify website program index with result 1 in state

to receive website [program] output {a pointer to JSON value:message} in {a pointer to website state:state}:
    set invocation to (the JSON number named "invocation" in message) as an integer
    require condition ((invocation > 0) and (invocation <= state's invocation)) reporting "Program output has an unknown invocation"
    set index to 0
    loop while index < the length of (the website program descriptions):
        set program to state's programs + index
        if (program's invocation = invocation) and (program's phase = 2):
            set program's output to program's output + (the JSON text named "output" in message)
            set description to the item at index in (the website program descriptions)
            if description's show output:
                set the text of (description's output) in (state's view's instance) to (program's output)
            return nothing
        increment index
    # Output emitted immediately before cancellation can already be queued.

to fail website [program] {integer:index} in {a pointer to website state:state}:
    set program to state's programs + index
    if index = 2:
        if state's shader editor's pending program != @intrinsic("construct", a pointer to JSON value):
            free state's shader editor's pending program
            set state's shader editor's pending program to @intrinsic("construct", a pointer to JSON value)
    set program's phase to 0
    set program's request to 0
    set description to the item at index in (the website program descriptions)
    set the text of (description's status) in (state's view's instance) to "An error occurred. Check the log."
    notify website program index with result 3 in state

to discard website reply {a pointer to JSON value:response} for purpose {integer:job} in {a pointer to website state:state}:
    # Only these operations create transferable resources. Other callbacks can
    # return null, arrays or arbitrary service data and own no host resources.
    if job = 6:
        if response has JSON member named "artifact":
            request "compiler" containing (a JSON object containing [JSON text "operation" is "release", JSON number "artifact" is (the JSON number named "artifact" in response)]) for purpose 0 indexed 0 in state
    if ((job = 4) or (job = 10)) or (job = 22):
        close UI shader (((the JSON number named "resource" in response) as an integer) as a pointer) in (state's view)
    if job = 11:
        set decoded to the JSON member named "buffers" in response
        set buffers to a new JSON value of kind the JSON array kind
        set index to 0
        loop while index < decoded's length:
            set member to JSON number "" is (the JSON number named "id" in (the JSON value at index index in decoded))
            add (member's value) to the JSON array buffers
            increment index
        request "audio" containing (a JSON object containing [JSON text "operation" is "unload", JSON child "buffers" is buffers]) for purpose 0 indexed 0 in state

to select website editor mode {integer:mode} in {a pointer to website state:state}:
    stop website program 2 in state
    set instance to state's view's instance
    set the value of "IDE modes" in instance to mode
    set the value of "IDE result" in instance to mode
    set caption to "Recompile shader ↻" if (mode = 1), else "Run program ▶"
    set the text of "Run program ▶" in instance to caption
    set the text of "IDE status" in instance to "Ready."
    set the text of "IDE diagnostics" in instance to "Checking source…"
    set the text of "IDE analysis" in instance to "Analyzing…"
