import appearance.dl

appearance inline link appearance:
    text is UI ink 146 64 14

appearance inline code appearance:
    font is "assets/fonts/JetBrainsMono-400.ttf"
    font size is 15
    text is UI ink 146 64 14

appearance subheading appearance:
    use heading appearance
    font size is 25

appearance code block appearance:
    use code appearance
    height is 0

# The source is data on the example's container. Both actions read that source.
code example {C string:name} containing {C string:source} means: ((a UI component 41 labeled name styled "" at 0 0 sized 0 by 0 containing [paragraph source using code block appearance, link "Copy code" to "action:copy-example" using link appearance, link "Open in IDE ↗" to "action:open-example" using link appearance]) with initial text source) wearing stack appearance
