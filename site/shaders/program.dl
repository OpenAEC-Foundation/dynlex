# The same shader program descriptions feed packaged scenes and edited previews.
import catalog.dl
import lib/json_builders.dl
import lib/json_rpc_values.dl
import ../packages/dynlex-ui/ui/shader_programs.dl

to get the shader stages for {shader geometry:geometry}:
    set result to a JSON array containing [a new JSON-RPC text for "fragment"]
    if geometry's kind != 0:
        add (a new JSON-RPC text for "vertex") to the JSON array result
    return result

to get [the error supplying website shader inputs from] {a pointer to JSON value:stage}:
    set inputs to the JSON member named "vertexInputs" in stage
    set index to 0
    loop while index < inputs's length:
        set input to the JSON value at index index in inputs
        if ((the JSON number named "location" in input) != 0.0) or ((the JSON text named "format" in input) != "float32x4"):
            return "The selected preview geometry cannot supply this shader vertex input"
        increment index
    return ""

to get [the error supplying website shader uniforms from] {a pointer to JSON value:uniforms}:
    set index to 0
    loop while index < uniforms's length:
        set uniform to the JSON value at index index in uniforms
        set name to the JSON text named "name" in uniform
        if ((name != "time") and (name != "width")) and ((name != "height") and (name != "render_pass")):
            return "The preview supplies time, width, height and render_pass uniforms"
        set kind to the JSON member named "type" in uniform
        if ((the JSON text named "scalar" in kind) != "float32") or (((the JSON number named "rows" in kind) != 1.0) or ((the JSON number named "columns" in kind) != 1.0)):
            return "Preview uniforms require float32 scalar inputs"
        increment index
    return ""

to get [a linked render pass for] {live shader:shader} [drawing geometry] {boolean:mesh} [using] {a pointer to JSON value:stages} [stored as] {C string:kind}:
    set fragment to the JSON member named "fragment" in stages
    set uniforms to a new JSON-RPC array
    set error to the error from merging UI shader bindings from fragment into uniforms
    if mesh and (error = ""):
        set source to the JSON member named "vertex" in stages
        set error to the error from merging UI shader bindings from source into uniforms
        if error = "":
            set error to the error supplying website shader inputs from source
    if error = "":
        set error to the error supplying website shader uniforms from uniforms
    if error != "":
        free uniforms
        return a failed UI shader linkage reporting error
    set vertex to a new JSON-RPC null
    set buffers to a new JSON-RPC array
    set indices to a new JSON-RPC null
    set draws to a new JSON-RPC array
    set blend to "opaque"
    set depth to false
    set layer to 0
    if mesh:
        free vertex
        set vertex to the linked UI shader stage (the JSON member named "vertex" in stages) stored as kind
        set source to a new JSON-RPC null
        if shader's geometry's kind = 1:
            set depth to true
        if shader's geometry's kind = 2:
            free source
            set source to a new JSON-RPC text for (shader's geometry's path)
            set blend to "additive"
            set layer to 1
        add (a JSON object containing [
            JSON number "arrayStride" is 16, JSON text "stepMode" is "vertex", JSON child "source" is source,
            JSON child "attributes" is (a JSON array containing [a JSON object containing [JSON number "shaderLocation" is 0, JSON number "offset" is 0, JSON text "format" is "float32x4"]])
        ]) to the JSON array buffers
    else:
        set draw to a UI shader draw counting 3 instanced 1 starting at 0 with vertex offset 0 and instance offset 0 indexed false
        add (the JSON form of UI shader draw draw) to the JSON array draws
    return a successful UI shader linkage to (a JSON object containing [
        JSON child "fragment" is (the linked UI shader stage fragment stored as kind), JSON child "vertex" is vertex,
        JSON child "vertexBuffers" is buffers, JSON child "indices" is indices, JSON child "draws" is draws,
        JSON flag "depth" is depth, JSON text "blend" is blend,
        JSON text "topology" is "triangle-list", JSON number "renderPass" is layer, JSON child "uniforms" is uniforms
    ])

to get the linkage of {live shader:shader} using {a pointer to JSON value:stages} stored as {C string:kind}:
    set passes to a new JSON-RPC array
    if (shader's geometry's kind = 0) or (shader's geometry's kind = 2):
        set linked to a linked render pass for shader drawing geometry false using stages stored as kind
        if linked failed:
            free passes
            return linked
        add (linked's program) to the JSON array passes
    if shader's geometry's kind != 0:
        set linked to a linked render pass for shader drawing geometry true using stages stored as kind
        if linked failed:
            free passes
            return linked
        add (linked's program) to the JSON array passes
    return a successful UI shader linkage to (a JSON object containing [JSON text "operation" is "shader", JSON child "passes" is passes])
