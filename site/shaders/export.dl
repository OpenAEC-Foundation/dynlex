# Build metadata comes from the same DynLex descriptions used by the application.
import program.dl

to get the JSON description of {shader geometry:geometry}:
    if geometry's kind = 0:
        return a new JSON value of kind the JSON null kind
    if geometry's kind = 2:
        return a JSON object containing [
            JSON text "kind" is "points",
            JSON text "path" is (geometry's path),
            JSON text "metadata" is (geometry's metadata)
        ]
    return a JSON object containing [
        JSON text "kind" is "terrain",
        JSON number "referenceWidth" is (geometry's reference width),
        JSON number "near" is (geometry's near),
        JSON number "far" is (geometry's far),
        JSON number "terrainRows" is (geometry's terrain rows),
        JSON number "terrainNear" is (geometry's terrain near columns),
        JSON number "terrainFar" is (geometry's terrain far columns),
        JSON number "waterRows" is (geometry's water rows),
        JSON number "waterNear" is (geometry's water near columns),
        JSON number "waterFar" is (geometry's water far columns)
    ]

set result to a new JSON value of kind the JSON array kind
set index to 0
set shaders to the site's shaders
loop while index < the length of shaders:
    set entry to the item at index in shaders
    set description to a JSON object containing [
        JSON text "id" is (entry's id),
        JSON text "title" is (entry's title),
        JSON text "source" is (entry's source),
        JSON number "duration" is (entry's duration),
        JSON child "geometry" is (the JSON description of (entry's geometry)),
        JSON child "stages" is (the shader stages for (entry's geometry))
    ]
    add description to the JSON array result
    increment index
print line the compact JSON form of result
free result
