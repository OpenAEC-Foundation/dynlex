import packages/dynlex-ui/ui/application.dl
import packages/dynlex-ui/platform/browser/requests.dl
import lib/json_builders.dl
import downloads/release.dl
import programs/types.dl
import editor/types.dl
import games/river/playback.dl
import games/progress/types.dl
import account/types.dl

class:
    patterns:
        website request
    members:
        id as an integer
        purpose as an integer
        index as an integer
        next as a pointer to website request
        cancelled as a boolean

class:
    patterns:
        website state
    members:
        view as a pointer to UI view
        requests as a pointer to website request
        route as a string
        fragment as a string
        environment as a pointer to JSON value
        shaders as website shader view array of (the length of (the site's shaders)) items
        shader index as an integer
        shader weights as a floating-point number array of (the length of (the site's shaders)) items
        release as a pointer to website release
        release loading as a boolean
        download started as a boolean
        programs as website program state array of (the length of (the website program descriptions)) items
        invocation as an integer
        language as a pointer to UI source workspace
        editor entry as a string
        shader editor as website shader editor
        river as website river playback
        progress as website progress store
        account as website account state

[the|] website state in {a pointer to UI instance:instance} means: instance's state as a pointer to website state

to get the website editor uses shaders in {a pointer to website state:state}:
    return (the value of "IDE modes" in (state's view's instance)) = 1

to get the website source filename label in {a pointer to website state:state}:
    return "Shader filename" if (the website editor uses shaders in state), else "IDE filename"

to get the website source filename in {a pointer to website state:state}:
    return (the UI value for (the control labeled (the website source filename label in state) in (state's view's instance)) in (state's view's instance))'s text

to get the website source editor in {a pointer to website state:state}:
    return the active UI editor within (the control labeled "IDE modes" in (state's view's instance)) in (state's view's instance)

to get the website source text in {a pointer to website state:state}:
    return (the UI value for (the website source editor in state) in (state's view's instance))'s text

to request {C string:service} containing {a pointer to JSON value:payload} for purpose {integer:job} indexed {integer:index} in {a pointer to website state:state}:
    set data to the compact JSON form of payload
    free payload
    request service with JSON data data for purpose job indexed index in state

to request {C string:service} with JSON data {string:data} for purpose {integer:job} indexed {integer:index} in {a pointer to website state:state}:
    set id to a browser UI request named service containing data in (state's view)
    set pending to @intrinsic("construct", website request, id, job, index, state's requests, false)
    set state's requests to storage for one slot initialized with pending

to get cancel website request {integer:id} in {a pointer to website state:state}:
    set pending to state's requests
    set previous to @intrinsic("construct", a pointer to website request)
    set found to false
    loop while (pending != @intrinsic("construct", a pointer to website request)) and (found = false):
        set found to pending's id = id
        if found = false:
            set previous to pending
            set pending to pending's next
    require condition found reporting "The cancelled website request has no owner"
    set active to cancel browser UI request id
    if active:
        if previous = @intrinsic("construct", a pointer to website request):
            set state's requests to pending's next
        else:
            set previous's next to pending's next
        deallocate pending
    else:
        # The reply is already in the input queue and still owns its result.
        set pending's cancelled to true
    return active

to get the parent of {UI reference:target} within {UI reference:root}:
    set index to 0
    loop while index < root's count:
        set child to the UI child at index in root
        if child = target:
            return root
        set found to the parent of target within child
        if found != @intrinsic("construct", UI reference):
            return found
        increment index
    return @intrinsic("construct", UI reference)
