import downloads/controller.dl
import editor/entry.dl
import games/farm/controller.dl
import editor/theme.dl
import games/river/inspection/controller.dl

# Resolve anchors from retained layout coordinates, including their parent regions.
to get the top of {a pointer to UI layout:target} inside {a pointer to UI layout:layout} below {floating-point number:origin}:
    if target = layout:
        return origin + layout's bounds' y
    set child to layout's first
    loop while child != @intrinsic("construct", a pointer to UI layout):
        set found to the top of target inside child below (origin + layout's bounds' y)
        if found >= 0.0:
            return found
        set child to child's next
    return -1.0

to apply location {a pointer to JSON value:location} to {a pointer to website state:state}:
    set path to the JSON text named "path" in location
    if path has "/" at offset (path's length - 1):
        set path to path + "index.html"
    if (state's route = "/river-character-sheet.html") and (path != state's route):
        leave website river inspection the address of (state's river inspection)
    if path != "/index.html":
        leave website Farm in state
    set pages to the site's pages
    set index to 0
    set found to false
    set selected to the item at 0 in pages
    loop while index < the length of pages:
        set entry to the item at index in pages
        if path = entry's path:
            set selected to entry
            set found to true
        else if (found = false) and (entry's path = "/404.html"):
            set selected to entry
        increment index
    show page (selected's path) in (state's view's instance)
    request "document" containing (a JSON object containing [JSON text "action" is "metadata", JSON text "title" is (selected's title), JSON text "description" is (selected's description), JSON text "path" is (selected's path)]) for purpose 0 indexed 0 in state
    set view to state's view
    apply website appearance for path in state
    reflow the UI document in view
    set fragment to the JSON text named "hash" in location
    if fragment's length > 0:
        set page to the UI layout for element (view's instance's page) in (view's layout)
        set target to the UI layout labeled fragment in page
        if target != @intrinsic("construct", a pointer to UI layout):
            set header to the UI layout labeled "Site header" in (view's layout)
            set top to (the top of target inside (view's layout) below 0.0) - header's bounds' height
            set view's layout's scroll target to the maximum of 0.0 and top
    else if (path != state's route) or (state's fragment's length > 0):
        set view's layout's scroll target to 0.0
    set state's route to path
    set state's fragment to fragment
    if path = "/river-character-sheet.html":
        open website river inspection the address of (state's river inspection)
    if path = "/ide/index.html":
        apply website editor entry (the JSON member named "search" in location) in state
    if path = "/download.html":
        if state's release = @intrinsic("construct", a pointer to website release):
            load website downloads in state
        else:
            refresh website downloads in state
    request a UI redraw in view

to navigate to {string:destination} in {a pointer to website state:state}:
    set service to "location"
    set payload to a JSON object containing [JSON text "action" is "push", JSON text "url" is destination]
    if (destination has "https:" at offset 0) or (destination has "http:" at offset 0):
        set service to "open"
        free payload
        set payload to a JSON object containing [JSON text "url" is destination, JSON flag "newTab" is true]
    request service containing payload for purpose 2 indexed 0 in state
