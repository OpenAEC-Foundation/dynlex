import lib/json_edit.dl

to get new website coding progress for {C string:game}:
    set result to a new JSON value of kind the JSON object kind
    set keys to ["passenger", "deliveries", "rescue", "watering", "planting", "eggs"]
    set index to 0 if (game = "river"), else 3
    set end to index + 3
    loop while index < end:
        set goal to a JSON object containing [JSON number "count" is 0, JSON child "seen" is (a new JSON value of kind the JSON array kind)]
        add a JSON member named (the string form of (the item at index in keys)) with value goal to result
        increment index
    return result

to get [the website coding progress error in] {a pointer to JSON value:coding} for {C string:game}:
    set template to new website coding progress for game
    set error to the string form of ""
    set index to 0
    loop while (index < template's length) and (error's length = 0):
        set name to (template's members + index)'s name
        if (JSON field name in coding has kind the JSON object kind) = false:
            set error to "A coding goal is missing: " + name
        else:
            set goal to the JSON member named name in coding
            if ((JSON field "count" in goal is a safe integer) and (JSON field "seen" in goal has kind the JSON array kind)) = false:
                set error to "A coding goal has invalid count or seen keys: " + name
            else:
                if (the JSON number named "count" in goal) < 0.0:
                    set error to "A coding goal has a negative count: " + name
                set seen to the JSON member named "seen" in goal
                set position to 0
                loop while position < seen's length:
                    if (the JSON value at index position in seen)'s kind != the JSON text kind:
                        set error to "A coding goal contains an invalid seen key: " + name
                    increment position
        increment index
    free template
    return error

to get [record website coding goal] {C string:name} amount {an integer:amount} using key {string:key} uniquely {boolean:unique} in {a pointer to JSON value:coding}:
    if amount <= 0:
        return false
    require condition (amount <= 9007199254740991) reporting "A coding goal needs an exact quantity"
    set quantity to amount as a 64 bit integer
    set goal to the JSON member named name in coding
    set seen to the JSON member named "seen" in goal
    if unique:
        set index to 0
        loop while index < seen's length:
            if (the JSON text at index index in seen) = key:
                return false
            increment index
    set count to (the JSON number named "count" in goal) as a 64 bit integer
    require condition (count <= 9007199254740991 - quantity) reporting "The coding goal count cannot be incremented exactly"
    if unique:
        set item to a new JSON value of kind the JSON text kind
        set item's text to key
        add item to the JSON array seen
    set JSON member (JSON number "count" is (count + quantity)) in goal
    return true

to get [record website coding goal] {C string:name} using key {C string:key} in {a pointer to JSON value:coding}:
    return record website coding goal name amount 1 using key (the string form of key) uniquely true in coding

to get [record website coding goal] {C string:name} using key {string:key} in {a pointer to JSON value:coding}:
    return record website coding goal name amount 1 using key key uniquely true in coding

to get [record website coding goal] {C string:name} amount {an integer:amount} in {a pointer to JSON value:coding}:
    return record website coding goal name amount amount using key (the string form of "") uniquely false in coding

the website coding count of {C string:name} in {a pointer to JSON value:coding} means: (the JSON number named "count" in (the JSON member named name in coding)) as a 64 bit integer
