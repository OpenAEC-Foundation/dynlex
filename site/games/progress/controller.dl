import ../../state.dl

to [report website progress failure] {string:detail} in {a pointer to website state:state}:
    set state's progress's status to 2
    set the text of "Game save status" in (state's view's instance) to "An error occurred. Check the log."
    request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is ("Game progress: " + detail)]) for purpose 0 indexed 0 in state

to get [call website progress service] {C string:service} with {a pointer to JSON value:payload} in {a pointer to website state:state}:
    set json to the compact JSON form of payload
    free payload
    set result to a UI call named service containing json through (state's services) in (state's view)
    if result's success = false:
        report website progress failure (the string form of "A platform storage or clock call failed") in state
        return 0 as a pointer to JSON value
    parse (result's contents) as JSON and set parsed to it
    require condition (parsed succeeded) reporting "An immediate platform provider returned invalid JSON"
    return parsed's value

to get [read website progress key] {string:key} in {a pointer to website state:state}:
    return call website progress service "storage" with (a JSON object containing [JSON text "action" is "get", JSON text "key" is key]) in state

to get [write website progress key] {string:key} containing {string:text} in {a pointer to website state:state}:
    set result to call website progress service "storage" with (a JSON object containing [JSON text "action" is "set", JSON text "key" is key, JSON text "value" is text]) in state
    set success to result != (0 as a pointer to JSON value)
    free result
    return success

to [refresh website progress controls in] {a pointer to website state:state}:
    set store to the address of (state's progress)
    set resume to false
    if store's status = 1:
        set resume to (the JSON member named "lastGame" in (store's document)) is not JSON null
    set the value of "Game resume" in (state's view's instance) to (0 if resume, else -1)

to [apply website progress to the games in] {a pointer to website state:state}:
    set games to the JSON member named "games" in (state's progress's document)
    load website source "River source" from (the string form of (the website river starter source)) in state
    set state's river's solved to false
    free state's river's coding
    set state's river's coding to new website coding progress for "river"
    if games has JSON member named "river":
        set data to the JSON member named "data" in (the JSON member named "river" in games)
        load website source "River source" from (the JSON text named "source" in data) in state
        set state's river's solved to the JSON boolean named "solved" in data
        free state's river's coding
        set state's river's coding to a copy of JSON node (the JSON member named "coding" in data)
    refresh website progress controls in state

    if state's progress's loaded != (0 as a pointer):
        @intrinsic("call pointer", state's progress's loaded, nothing, state)

# Enumerate every guest, account and backup file before opening the active profile.
to [open website progress in] {a pointer to website state:state}:
    set store to the address of (state's progress)
    require condition (store's status = 0) reporting "The website progress store was opened twice"
    refresh website progress controls in state
    set keys to call website progress service "storage" with (a JSON object containing [JSON text "action" is "keys"]) in state
    if keys = (0 as a pointer to JSON value):
        return nothing
    set index to 0
    loop while (index < keys's length) and (store's status != 2):
        set key to the JSON text at index index in keys
        if (key = "dynlex.games.guest") or ((key has "dynlex.games.user:" at offset 0) or (key has "dynlex.games.backup:" at offset 0)):
            set response to read website progress key key in state
            if response != (0 as a pointer to JSON value):
                set value to the JSON member named "value" in response
                # Another tab may remove a key after the enumeration.
                if value is not JSON null:
                    set result to website progress from (value's text)
                    if result's error's length > 0:
                        report website progress failure (key + ": " + result's error) in state
                    else:
                        set migrated to the compact JSON form of (result's document)
                        if migrated != value's text:
                            ignore write website progress key key containing migrated in state
                        free result's document
                free response
        increment index
    free keys
    if store's status = 2:
        return nothing
    set response to read website progress key (the string form of "dynlex.games.profile") in state
    if response = (0 as a pointer to JSON value):
        return nothing
    set value to the JSON member named "value" in response
    set store's profile to (the string form of "guest") if (value is JSON null), else (value's text)
    free response
    if (store's profile != "guest") and (((store's profile has "user:" at offset 0) = false) or (store's profile's length <= 5)):
        report website progress failure (the string form of "The stored account profile is invalid") in state
        return nothing
    set response to read website progress key ("dynlex.games." + store's profile) in state
    if response = (0 as a pointer to JSON value):
        return nothing
    set value to the JSON member named "value" in response
    if value is JSON null:
        set store's document to empty website progress
    else:
        set result to website progress from (value's text)
        if result's error's length > 0:
            report website progress failure result's error in state
        else:
            set store's document to result's document
    free response
    if store's status = 2:
        return nothing
    set store's status to 1
    apply website progress to the games in state

# A queued snapshot transfers ownership even when writes have been blocked.
to [save website game] {C string:game} containing {a pointer to JSON value:data} in {a pointer to website state:state}:
    set store to the address of (state's progress)
    if store's status != 1:
        free data
        return nothing
    if (website progress (store's document) needs game data data) = false:
        free data
        return nothing
    set clock to call website progress service "clock" with (a new JSON value of kind the JSON null kind) in state
    if clock = (0 as a pointer to JSON value):
        free data
        return nothing
    set result to website progress saving game data data at ((the JSON number named "milliseconds" in clock) as a 64 bit integer) in (store's document)
    free clock
    free data
    if result's error's length > 0:
        report website progress failure result's error in state
        return nothing
    set written to write website progress key ("dynlex.games." + store's profile) containing (the compact JSON form of (result's document)) in state
    if written:
        free store's document
        set store's document to result's document
        set the text of "Game save status" in (state's view's instance) to "Progress saved in this browser"
        refresh website progress controls in state
        if store's saved != (0 as a pointer):
            @intrinsic("call pointer", store's saved, nothing, state)
    else:
        free result's document

to [save website river progress in] {a pointer to website state:state}:
    if state's progress's status != 1:
        return nothing
    set editor to the UI source editor labeled "River source" in (state's language)
    save website game "river" containing (a JSON object containing [
        JSON text "source" is (the UI main source of editor in (state's language) at (state's view's seconds) seconds),
        JSON flag "solved" is (state's river's solved), JSON child "coding" is (a copy of JSON node (state's river's coding))
    ]) in state
