import types.dl

class:
    patterns:
        website river words
    members:
        valid as a boolean
        fields as a string array of 4 items
        count as an integer

to get [the website river words in] {string:line}:
    set result to a new website river words
    set start and position to 0
    loop while position <= line's length:
        set ending to position = line's length
        if ending = false:
            set ending to (the character at position in line) = 124
        if ending:
            if result's count = 4:
                return result
            store (the substring of line from start spanning (position - start) bytes) into (result's fields) at (result's count)
            increment result's count
            set start to position + 1
        increment position
    set result's valid to true
    return result

to get [the website river passenger named] {string:name}:
    if name = "SHEEP":
        return 1
    if name = "WOLF":
        return 2
    if name = "HAY":
        return 3
    return 0

to get [the website river bank named] {string:name}:
    if name = "HOME":
        return 0
    if name = "FAR":
        return 1
    return -1

to get [the website river action named] {string:name}:
    if name = "LOAD":
        return 1
    if name = "UNLOAD":
        return 2
    if name = "CROSS":
        return 3
    return 0

to get [the website river event in] {website river words:words}:
    set result to a new website river event
    set fields to words' fields
    set {type} to the item at 1 in fields
    if ({type} = "ACTION") and (words' count = 4):
        set kind to the website river action named (the item at 2 in fields)
        set subject to the website river passenger named (the item at 3 in fields)
        if kind = 3:
            set subject to the website river bank named (the item at 3 in fields)
            if subject < 0:
                return result
        else if subject = 0:
            return result
        set result's kind to kind
        set result's subject to subject
    if ({type} = "DANGER") and (words' count = 4):
        set predator to the website river passenger named (the item at 2 in fields)
        set prey to the website river passenger named (the item at 3 in fields)
        if (predator = 0) or (prey = 0):
            return result
        set result's kind to 4
        set result's subject to predator
        set result's other to prey
    if ({type} = "ERROR") and (words' count = 3):
        set result's message to the item at 2 in fields
        if result's message's length > 0:
            set result's kind to 5
    if ({type} = "SUCCESS") and (words' count = 2):
        set result's kind to 6
    return result

to get [append website river instruction] {website river instruction:instruction} to {a pointer to website river trace:trace}:
    set entry to storage for one slot initialized with instruction
    if trace's first = @intrinsic("construct", a pointer to website river instruction):
        set trace's first to entry
    else:
        set trace's last's next to entry
    set trace's last to entry
    increment trace's count
    return entry

to [read website river output] {website execution output:output} into {a pointer to website river trace:trace}:
    set current to @intrinsic("construct", a pointer to website river instruction)
    set record to output's first
    loop while record != @intrinsic("construct", a pointer to website execution record):
        set instruction to a new website river instruction
        set instruction's source to record's source
        set instruction's branch to record's branch
        if record's branch != -1:
            ignore append website river instruction instruction to trace
        else:
            set words to the website river words in (record's text)
            if (words' valid = false) or ((words' count < 2) or ((the item at 0 in (words' fields)) != "RIVER")):
                set trace's error to "Unexpected river output: " + record's text
                return nothing
            set {type} to the item at 1 in (words' fields)
            if {type} = "COMMAND":
                set kind to the website river action named (the item at 2 in (words' fields))
                set subject to the website river passenger named (the item at 3 in (words' fields))
                set valid to false
                if kind = 3:
                    set valid to words' count = 3
                else if (kind = 1) or (kind = 2):
                    set valid to (words' count = 4) and (subject > 0)
                if valid = false:
                    set trace's error to "Unknown river command: " + record's text
                    return nothing
                set instruction's kind to kind
                set instruction's subject to subject
                set current to append website river instruction instruction to trace
            else:
                if current = @intrinsic("construct", a pointer to website river instruction):
                    set trace's error to "A river event appeared before a command: " + record's text
                    return nothing
                set event to the website river event in words
                if event's kind = 0:
                    set trace's error to "Unknown river event: " + record's text
                    return nothing
                set entry to storage for one slot initialized with event
                if current's first = @intrinsic("construct", a pointer to website river event):
                    set current's first to entry
                else:
                    set current's last's next to entry
                set current's last to entry
                if event's kind = 5:
                    set trace's outcome to 2
                    set trace's message to event's message
                if event's kind = 6:
                    set trace's outcome to 1
                    set trace's message to "Everyone made it across."
        set record to record's next
    if trace's count = 0:
        set trace's error to "The river program produced no commands"

to get [website river trace from] {string:stdout} dropping {integer:prefix} source lines:
    set trace to a new website river trace
    set output to website execution from stdout dropping prefix source lines
    if output's error's length > 0:
        set trace's error to output's error
    else:
        read website river output output into (the address of trace)
    free website execution the address of output
    return trace

to [free website river trace] {a pointer to website river trace:trace}:
    set instruction to trace's first
    loop while instruction != @intrinsic("construct", a pointer to website river instruction):
        set next to instruction's next
        set event to instruction's first
        loop while event != @intrinsic("construct", a pointer to website river event):
            set following to event's next
            destroy the value at event
            deallocate event
            set event to following
        destroy the value at instruction
        deallocate instruction
        set instruction to next
    set trace's first to @intrinsic("construct", a pointer to website river instruction)
    set trace's last to @intrinsic("construct", a pointer to website river instruction)
    set trace's count to 0
