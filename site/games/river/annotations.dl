import ../../state.dl
import ../source.dl
import ../annotations.dl

to get [the website river source error in] {website river trace:trace} for {string:source}:
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The River source snapshot is not valid UTF-8"
    set lines to the line index of scanned
    set error to the string form of ""
    set instruction to trace's first
    loop while instruction != @intrinsic("construct", a pointer to website river instruction):
        if instruction's source's known:
            set span to the website source span of (instruction's source) in source indexed by lines
            if span's valid = false:
                set error to "An execution source range does not belong to the compiled plan"
        set instruction to instruction's next
    free lines
    return error

to [refresh website river annotations in] {a pointer to website state:state}:
    set river to the address of (state's river)
    set instance to state's view's instance
    set editor to the UI source editor labeled "River source" in (state's language)
    set value to the UI text state for (editor's document's project's entry) in editor in instance
    if river's shown = @intrinsic("construct", a pointer to website river instruction):
        if clear UI text marks in layer "execution" in value:
            if editor's document = editor's document's project's entry:
                invalidate instance
        set river's marked position to 0
        set river's marked failure to false
        return nothing
    if (river's marked position = river's shown position) and (river's marked failure = river's failed):
        return nothing
    set program to state's programs + (the website program for source "River source")
    mark UI text (program's source) in layer "execution" at priority 10 in value
    set ink to UI ink 104 153 178
    if river's shown's branch != -1:
        set ink to (UI ink 80 153 114) if (river's shown's branch = 1), else (UI ink 196 153 66)
    if river's failed:
        set ink to UI ink 201 88 63
    ignore add website execution mark from (river's shown's source) in (program's source) using ink to layer "execution" in value
    if editor's document = editor's document's project's entry:
        invalidate instance
    set river's marked position to river's shown position
    set river's marked failure to river's failed
