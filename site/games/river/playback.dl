# The game clock is independent of windows, platform requests and painting.
import model.dl
import trace.dl
import audio_types.dl
import ../progress/goals.dl
import content.dl

class:
    patterns:
        website river playback
    members:
        trace as website river trace
        scene as website river scene
        target as website river scene
        instruction as a pointer to website river instruction
        shown as a pointer to website river instruction
        event as a pointer to website river event
        position as an integer
        shown position as an integer
        marked position as an integer
        marked failure as a boolean
        stage as an integer
        elapsed as a floating-point number
        duration as a floating-point number
        seconds as a floating-point number
        speed as an integer
        playing as a boolean
        failed as a boolean
        paused as a boolean
        reduced motion as a boolean
        stepping as a boolean
        active as a boolean
        last seconds as a floating-point number
        artwork as an integer
        coding as a pointer to JSON value
        solved as a boolean
        changed as a boolean
        message as a string
        audio as website river audio

# Clear all references into the owned trace together. Presentation preferences,
# assets, sound buffers and saved achievements belong to longer-lived state.
to [clear website river plan in] {a pointer to website river playback:playback}:
    free website river trace the address of (playback's trace)
    set playback's trace to a new website river trace
    set playback's scene to the initial website river scene
    set playback's target to playback's scene
    set playback's instruction and playback's shown to @intrinsic("construct", a pointer to website river instruction)
    set playback's event to @intrinsic("construct", a pointer to website river event)
    set playback's position, playback's shown position and playback's marked position to 0
    set playback's stage to 0
    set playback's elapsed, playback's duration and playback's seconds to 0.0
    set playback's last seconds to 0.0
    set playback's playing, playback's failed and playback's paused to false
    set playback's stepping, playback's active and playback's changed to false
    set playback's marked failure to false

# Validate the entire output before presenting any of it. User programs can print
# arbitrary text, including strings that resemble the game's event protocol.
to get [the website river trace error in] {website river trace:trace}:
    if trace's error's length > 0:
        return trace's error
    set scene to the initial website river scene
    set instruction to trace's first
    loop while instruction != @intrinsic("construct", a pointer to website river instruction):
        set event to instruction's first
        loop while event != @intrinsic("construct", a pointer to website river event):
            set next to the website river scene after (the value at event) from scene
            if next's error's length > 0:
                return next's error
            set scene to next's scene
            set event to event's next
        set instruction to instruction's next
    return the string form of ""

to [prepare website river instruction in] {a pointer to website river playback:playback}:
    set instruction to playback's instruction
    if instruction = @intrinsic("construct", a pointer to website river instruction):
        if playback's trace's outcome = 2:
            set playback's stage to 2
            set playback's duration to 0.0 if (playback's reduced motion), else 2.4
        else:
            set playback's stage to 0
            set playback's playing to false
            set playback's paused to true
            if playback's trace's outcome = 0:
                set playback's message to "Everyone is safe so far, but the crossing is not complete."
        return nothing
    increment playback's position
    set playback's stage to 1
    set playback's event to instruction's first
    set playback's duration to 0.5 if (instruction's kind = 0), else 0.0
    if playback's reduced motion:
        set playback's duration to 0.0
    if playback's event != @intrinsic("construct", a pointer to website river event):
        prepare website river event in playback

to [prepare website river event in] {a pointer to website river playback:playback}:
    set event to playback's event
    set transition to the website river scene after (the value at event) from (playback's scene)
    require condition (transition's error's length = 0) reporting "The validated river replay became inconsistent"
    set playback's target to transition's scene
    set kind to event's kind
    set playback's duration to 0.0
    if (kind = 1) or (kind = 2):
        set playback's duration to 0.56
    if kind = 3:
        set playback's duration to 1.0
    if kind = 4:
        set playback's duration to 1.5
    if kind = 6:
        set playback's duration to 0.52
    if playback's reduced motion:
        set playback's duration to 0.0

to [begin website river replay in] {a pointer to website river playback:playback} stepping {boolean:stepping}:
    require condition (playback's trace's first != @intrinsic("construct", a pointer to website river instruction)) reporting "A river replay requires instructions"
    set playback's scene to the initial website river scene
    set playback's target to playback's scene
    set playback's instruction to playback's trace's first
    set playback's shown to playback's instruction
    set playback's shown position to 1
    set playback's position to 0
    set playback's elapsed and playback's seconds to 0.0
    set playback's playing to true
    set playback's failed to false
    set playback's paused to false
    set playback's stepping to stepping
    set playback's active to false
    set playback's message to "Every line changes what the next line can do."
    prepare website river instruction in playback

to [commit website river event in] {a pointer to website river playback:playback}:
    set event to playback's event
    set playback's scene to playback's target
    if event's kind = 1:
        if record website coding goal "passenger" using key "loaded" in (playback's coding):
            set playback's changed to true
    if (event's kind = 2) and (playback's scene's bank = 1):
        set names to ["SHEEP", "WOLF", "HAY"]
        if record website coding goal "deliveries" using key (the item at (event's subject - 1) in names) in (playback's coding):
            set playback's changed to true
    if event's kind = 5:
        set playback's failed to true
        set playback's message to event's message
    if event's kind = 6:
        if record website coding goal "rescue" using key "solved" in (playback's coding):
            set playback's changed to true
        if playback's solved = false:
            set playback's changed to true
        set playback's solved to true
        set playback's message to "Everyone reached the far bank safely."

to [advance website river playback] {a pointer to website river playback:playback} by {floating-point number:delta}:
    require condition (delta >= 0.0) reporting "A river clock cannot run backwards"
    if (playback's playing = false) or playback's paused:
        return nothing
    set remaining to delta * playback's speed
    loop while playback's playing and (playback's paused = false):
        if playback's stage = 1:
            set playback's shown to playback's instruction
            set playback's shown position to playback's position
        set needed to the maximum of 0.0 and (playback's duration - playback's elapsed)
        if remaining < needed:
            set playback's elapsed to playback's elapsed + remaining
            set playback's seconds to playback's seconds + remaining
            return nothing
        set playback's seconds to playback's seconds + needed
        set remaining to remaining - needed
        set playback's elapsed to 0.0
        if playback's stage = 2:
            set playback's scene to the initial website river scene
            set playback's target to playback's scene
            set playback's playing to false
            set playback's paused to true
            set playback's stage to 0
            return nothing
        if playback's event != @intrinsic("construct", a pointer to website river event):
            commit website river event in playback
            set playback's event to playback's event's next
        if playback's event != @intrinsic("construct", a pointer to website river event):
            prepare website river event in playback
        else:
            set playback's instruction to playback's instruction's next
            prepare website river instruction in playback
            if playback's stepping and (playback's instruction != @intrinsic("construct", a pointer to website river instruction)):
                set playback's paused to true
