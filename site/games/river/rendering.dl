import ../../state.dl
import assets.dl
import character_rendering.dl
import decorations.dl
import ../../packages/dynlex-ui/ui/clipping.dl

# World coordinates stay independent of the responsive surface size.
to get [the website river boat box in] {website river scene:scene} across {UI bounds:world}:
    set width to world's width * (0.19 if (world's width / world's height < 1.5), else 0.148)
    set height to width * 941.0 / 1672.0
    set x to 0.4 if (scene's bank = 0), else 0.6
    return UI box at (world's x + world's width * x - width / 2.0) (world's y + world's height * 0.69 - height / 2.0) sized width height

to get [the website river passenger box for] {integer:subject} in {website river scene:scene} across {UI bounds:world}:
    set bank to the item at (subject - 1) in (scene's passengers)
    set width to world's width * (0.1 if (world's width / world's height < 1.5), else 0.074)
    set home to [0.17, 0.23, 0.29]
    set far to [0.83, 0.77, 0.71]
    set heights to [0.49, 0.68, 0.54]
    set x to the item at (subject - 1) in (home if (bank = 0), else far)
    set y to the item at (subject - 1) in heights
    if bank = -1:
        set boat to the website river boat box in scene across world
        set width to width * 0.8
        set direction to 1.0 if (scene's heading = 1), else -1.0
        set lifts to [0.810667, 0.94, 0.796]
        set x to boat's x + boat's width * (0.5 + 0.22 * direction)
        set y to boat's y + boat's height * 0.625 + (0.5 - (the item at (subject - 1) in lifts)) * width
    else:
        set x to world's x + world's width * x
        set y to world's y + world's height * y
    return UI box at (x - width / 2.0) (y - width / 2.0) sized width width

to get [website river box between] {UI bounds:first} and {UI bounds:second} at {floating-point number:phase}:
    return UI box at (first's x + (second's x - first's x) * phase) (first's y + (second's y - first's y) * phase) sized (first's width + (second's width - first's width) * phase) (first's height + (second's height - first's height) * phase)

# Solve x(t) before sampling y(t); time is not the Bezier parameter.
to get [the website river easing at] {floating-point number:phase} crossing {boolean:crossing}:
    set x1 to 0.45 if crossing, else 0.2
    set y1 to 0.05 if crossing, else 0.8
    set x2 to 0.55 if crossing, else 0.2
    set y2 to 0.95 if crossing, else 1.0
    set low to 0.0
    set high to 1.0
    set index to 0
    loop while index < 20:
        set t to (low + high) / 2.0
        set x to 3.0 * (1.0 - t) * (1.0 - t) * t * x1 + 3.0 * (1.0 - t) * t * t * x2 + t * t * t
        if x < phase:
            set low to t
        else:
            set high to t
        increment index
    set t to (low + high) / 2.0
    return 3.0 * (1.0 - t) * (1.0 - t) * t * y1 + 3.0 * (1.0 - t) * t * t * y2 + t * t * t

to [paint the website river] {a pointer to UI canvas frame:painting}:
    set state to the website state in (painting's instance)
    set river to the address of (state's river)
    set world to painting's bounds
    set frame to painting's frame
    if river's artwork != 1:
        set text to "Loading the river…" if (river's artwork = 0), else "Artwork unavailable · use Retry artwork"
        draw UI text text centered in world with (frame's view's small) in (UI ink 221 232 219) on frame
        return nothing
    set clip to a UI clip restricted to world in (frame's view) on frame
    set landscape to UI image from (the string form of "assets/games/river/painted-river.webp") in (frame's view)
    draw UI image landscape in world rounded by 8.0 fitting 1 on frame
    set scene to river's scene
    set target to scene
    set kind to 0
    set progress and movement to 0.0
    if (river's stage = 1) and (river's event != @intrinsic("construct", a pointer to website river event)):
        set kind to river's event's kind
        set target to river's target
        if river's duration > 0.0:
            set progress to the minimum of 1.0 and (river's elapsed / river's duration)
            set movement to the website river easing at progress crossing (kind = 3)
        if painting's instance's reduced motion:
            set movement to 0.0
    set boat to website river box between (the website river boat box in scene across world) and (the website river boat box in target across world) at movement
    if kind = 6:
        set amount to progress / 0.72 if (progress < 0.72), else ((progress - 0.72) / 0.28)
        set scale to (0.75 + 0.33 * amount) if (progress < 0.72), else (1.08 - 0.08 * amount)
        set rise to (8.0 - 13.0 * amount) if (progress < 0.72), else (-5.0 + 5.0 * amount)
        set boat's x to boat's x + boat's width * (1.0 - scale) / 2.0
        set boat's y to boat's y + boat's height * (1.0 - scale) / 2.0 + rise
        set boat's width to boat's width * scale
        set boat's height to boat's height * scale
    set heading to target's heading if (kind = 3), else scene's heading
    set flipped to heading = 0
    paint website river sprite 1 in boat flipped flipped opacity 255 on frame
    paint website river expressions for 0 in boat using (the website river expression for 0 during river) flipped flipped outlining false on frame
    set subject to 1
    loop while subject <= 3:
        set box to website river box between (the website river passenger box for subject in scene across world) and (the website river passenger box for subject in target across world) at movement
        set opacity to 255
        if subject = scene's prey:
            set opacity to 0
        if (kind = 4) and (subject = target's prey):
            if river's elapsed > 0.65:
                set opacity to 0
        set scuffle to (kind = 4) and ((river's elapsed < 0.65) and ((subject = target's predator) or (subject = target's prey)))
        if scuffle and (painting's instance's reduced motion = false):
            begin website river scuffle in box at (river's elapsed) on frame
        paint website river sprite (subject + 1) in box flipped false opacity opacity on frame
        if opacity > 0:
            paint website river expressions for subject in box using (the website river expression for subject during river) flipped false outlining false on frame
        if scuffle and (painting's instance's reduced motion = false):
            restore the model transform in frame
        increment subject
    set hull to UI box at (boat's x) (boat's y + boat's height * 0.63) sized (boat's width) (boat's height * 0.37)
    set {hull clip} to a UI clip restricted to hull in (frame's view) on frame
    paint website river sprite 1 in boat flipped flipped opacity 255 on frame
    restore UI clip {hull clip} in (frame's view) on frame
    if (kind = 4) or (scene's predator != 0):
        set danger to target if (kind = 4), else scene
        paint website river dust in world for danger at (river's elapsed if (kind = 4), else (1.5 + river's elapsed)) on frame
    if (kind = 6) or scene's complete:
        paint website river celebration in world appearing (progress if (kind = 6), else 1.0) on frame
    if river's playing:
        set fraction to (river's position - 1.0 + progress) / river's trace's count
        draw a rounded UI box (UI box at (world's x) (world's y + world's height - 3.0) sized (world's width * fraction) 3.0) with radius 1.5 in (UI ink 242 206 123) on frame
    restore UI clip clip in (frame's view) on frame
