# This policy belongs to DynLex. The host only decodes and controls sound voices.
import audio.dl

to [advance the website river audio in] {a pointer to website state:state} visible {boolean:visible}:
    set river to the address of (state's river)
    set audio to the address of (river's audio)
    set view to state's view
    set audio's audible to (visible and view's active) and (audio's muted = false)
    if audio's status != 2:
        return nothing
    set slot to 0
    loop while slot < 2:
        if (audio's voices + slot)'s id = 0:
            play website river sound slot in slot slot at offset 0.0 in state
        increment slot
    set event to @intrinsic("construct", a pointer to website river event)
    if river's playing and ((river's stage = 1) and (river's shown = river's instruction)):
        set event to river's event
    if event != audio's effect:
        stop website river voice 2 in state
        set audio's effect to event
        if event != @intrinsic("construct", a pointer to website river event):
            set cue to -1
            if (event's kind = 1) or (event's kind = 2):
                set cue to 2
            if event's kind = 3:
                set cue to 5
            if event's kind = 4:
                set cue to 4
            if cue >= 0:
                set sound to the item at cue in (the website river sounds)
                play website river sound cue in slot 2 at offset (river's elapsed * sound's pitch) in state
    if river's scene's complete:
        if audio's celebrated = false:
            play website river sound 6 in slot 4 at offset 0.0 in state
            set audio's celebrated to true
    else:
        set audio's celebrated to false
    set phase to (state's programs + (the website program for source "River source"))'s phase
    if audio's audible and ((phase = 0) and (river's playing = false)):
        if ((audio's voices + 3)'s id = 0) and (audio's idle request = 0):
            set delay to 4000 if (audio's idle first), else (8000 + ((a random number) mod 5001))
            request "timer" containing (a JSON object containing [JSON number "milliseconds" is delay]) for purpose 12 indexed 0 in state
            set audio's idle request to state's requests' id
    else:
        stop website river idle sound in state
    set slot to 0
    loop while slot < 5:
        set voice to audio's voices + slot
        if voice's id != 0:
            set sound to the item at (voice's cue) in (the website river sounds)
            set volume to sound's volume if (audio's audible), else 0.0
            set rate to sound's pitch
            if slot = 2:
                set rate to 0.0 if (river's active = false), else (sound's pitch * river's speed)
            if (volume != voice's volume) or (rate != voice's rate):
                set voice's volume to volume
                set voice's rate to rate
                set fade to 0.45 if (slot < 2), else 0.0
                request "audio" containing (a JSON object containing [JSON text "operation" is "state", JSON number "voice" is (voice's id), JSON number "volume" is volume, JSON number "rate" is rate, JSON number "fade" is fade]) for purpose 0 indexed 0 in state
        increment slot
    set bellow to ((audio's voices + 3)'s id != 0) or (((audio's voices + 2)'s id != 0) and ((audio's voices + 2)'s cue = 4))
    set audio's mouth to UI value (audio's mouth) approaching (1.0 if bellow, else 0.0) at speed 18.0 in view

to get [the website river audio is visible in] {a pointer to website state:state}:
    set view to state's view
    set visible to false
    if (state's route = "/index.html") and (((the value of "Challenge views" in (view's instance)) = 1) and ((the value of "Game content" in (view's instance)) = 0)):
        set panel to the UI layout labeled "river challenge" in (view's layout)
        set box to panel's painted bounds
        set overlap to the UI intersection of box and (UI box at 0 0 sized (view's width) (view's height))
        set visible to ((box's width > 0.0) and (box's height > 0.0)) and ((overlap's width * overlap's height) >= (box's width * box's height * 0.12))
    return visible

to [advance the website river audio in] {a pointer to website state:state}:
    advance the website river audio in state visible (the website river audio is visible in state)
