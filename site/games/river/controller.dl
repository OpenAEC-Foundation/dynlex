import ../../programs/controller.dl
import assets.dl
import annotations.dl
import audio_policy.dl
import ../progress/controller.dl

# Commands change the model here; surfaces only draw its current snapshots.
to [refresh website river controls in] {a pointer to website state:state}:
    refresh website river annotations in state
    set river to the address of (state's river)
    set instance to state's view's instance
    set program to state's programs + (the website program for source "River source")
    set busy to (program's phase = 1) or (program's phase = 2)
    set the "Run plan ▶" control in instance enabled (busy = false)
    set the "Stop plan ■" control in instance enabled (program's phase != 0)
    set the "One instruction" control in instance enabled (busy = false)
    set the "River play" control in instance enabled ((busy = false) and (river's trace's count > 0))
    set {audio caption} to "Audio off ♪" if (river's audio's muted), else "Audio on ♪"
    if river's audio's status = 1:
        set {audio caption} to "Loading audio…"
    if river's audio's status = 3:
        set {audio caption} to "Retry audio ↻"
    set the text of "River audio" in instance to {audio caption}
    set caption to the string form of "Replay ▶"
    if river's playing:
        set caption to "Play ▶" if (river's paused), else "Pause Ⅱ"
    set the text of "River play" in instance to caption
    set the text of "River speed" in instance to formatted "{river's speed}× speed"
    set passengers to the minimum of 1 and (the website coding count of "passenger" in (river's coding))
    set deliveries to the minimum of 3 and (the website coding count of "deliveries" in (river's coding))
    set rescues to the minimum of 1 and (the website coding count of "rescue" in (river's coding))
    set the text of "River passenger count" in instance to formatted "{passengers} / 1"
    set the text of "River delivery count" in instance to formatted "{deliveries} / 3"
    set the text of "River rescue count" in instance to formatted "{rescues} / 1"
    set the text of "River message" in instance to (river's message)
    if busy = false:
        set world to "THE RIVER / WAITING FOR A PLAN"
        if (river's trace's count > 0) and (river's position > 0):
            set world to "THE RIVER / PLAN ENDED"
        if river's playing:
            set world to "THE RIVER / PAUSED" if (river's paused), else "THE RIVER / FOLLOWING YOUR PLAN"
        if river's scene's complete:
            set world to "THE RIVER / EVERYONE MADE IT"
        if river's failed:
            set world to "THE RIVER / EDIT AND TRY AGAIN"
            set the text of "River diagnostics" in instance to (river's trace's message)
            set the text of "River status" in instance to "Try again."
        if river's artwork = 0:
            set world to "THE RIVER / LOADING ARTWORK"
        if river's artwork = 2:
            set world to "THE RIVER / ARTWORK UNAVAILABLE · RETRY ARTWORK"
        set the text of "River world state" in instance to world
    set instruction to river's shown
    if instruction != @intrinsic("construct", a pointer to website river instruction):
        set line to instruction's source's start line + 1
        set caption to formatted "Instruction {river's shown position} / {river's trace's count} · line {line}"
        if instruction's branch != -1:
            set caption to caption + (" · condition is true" if (instruction's branch = 1), else " · condition is false")
        set the text of "River execution" in instance to caption

function [notice website river start] {integer:index} in {a pointer to website state:state}:
    execute:
        set river to the address of (state's river)
        stop website river effects in state
        clear website river plan in river
        set river's message to "Reading your plan."
        set the text of "River execution" in (state's view's instance) to "Compiling the plan…"
        set the text of "River world state" in (state's view's instance) to "THE RIVER / READING YOUR PLAN"
        refresh website river controls in state

function [notice website river finish] {integer:index} in {a pointer to website state:state}:
    execute:
        set program to state's programs + index
        set river to the address of (state's river)
        set river's active to false
        set river's reduced motion to state's view's instance's reduced motion
        if program's result = 1:
            set description to the item at index in (the website program descriptions)
            set trace to website river trace from (program's output) dropping (the website prefix line count of description) source lines
            set error to the website river trace error in trace
            if error's length = 0:
                set error to the website river source error in trace for (program's source)
            if error's length > 0:
                request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is ("River plan: " + error)]) for purpose 0 indexed 0 in state
                set the text of "River diagnostics" in (state's view's instance) to "The plan did not produce valid River instructions. Check the log."
                set river's message to "Use the River commands to give the farmer a plan."
                free website river trace the address of trace
            else:
                set river's trace to trace
                begin website river replay in river stepping (river's stepping)
                set program's phase to 3
                animate UI view (state's view)
        else:
            set river's playing to false
            set river's paused to true
            set river's message to "Playback stopped. Replay your plan or edit it."
            if program's result = 2:
                set river's message to "Check the compiler diagnostics and try again."
            if program's result = 3:
                set river's message to "An error occurred. Check the log."
        refresh website river controls in state

to [initialize the website river in] {a pointer to website state:state}:
    for each label in ["River passenger hint", "River delivery hint", "River rescue hint"]:
        set the value of label in (state's view's instance) to -1
    set state's river's coding to new website coding progress for "river"
    set state's river's scene to the initial website river scene
    set state's river's speed to 1
    set state's river's message to "The farmer can take one passenger at a time."
    set program to state's programs + (the website program for source "River source")
    set program's started to (the function named "notice website river start $ in $") as a pointer
    set program's finished to (the function named "notice website river finish $ in $") as a pointer
    bind (the control labeled "River source" in (state's view's instance)) in (state's view's instance) to (the function named "notice website river source edit $") for event 0
    refresh website river controls in state

to [notice website river source edit] {a pointer to UI instance:instance}:
    set state to the website state in instance
    stop website program (the website program for source "River source") in state
    notice website river start (the website program for source "River source") in state
    set state's river's message to "Your previous result was cleared because the plan changed."
    set the text of "River diagnostics" in instance to ""
    set the text of "River execution" in instance to "Ready for the new plan."
    set the text of "River status" in instance to "Edited · Ctrl / ⌘ + Enter runs your plan"
    refresh website river controls in state
    save website river progress in state

to get [follow website river action] {string:destination} in {a pointer to website state:state}:
    set instance to state's view's instance
    set river to the address of (state's river)
    set index to the website program for source "River source"
    set program to state's programs + index
    if destination = "action:river":
        set the value of "Challenge views" in instance to 1
        if (river's audio's status = 0) or (river's audio's status = 3):
            load the website river audio in state
        refresh website river controls in state
        return true
    if destination = "action:challenge-gallery":
        set river's active to false
        set the value of "Challenge views" in instance to 0
        return true
    if destination = "action:river-play":
        if river's playing:
            set river's paused to river's paused = false
            set river's stepping to false
            set river's active to false
        else:
            set river's reduced motion to instance's reduced motion
            begin website river replay in river stepping false
            set program's phase to 3
        refresh website river controls in state
        return true
    if destination = "action:river-step":
        if river's playing:
            set river's paused to false
            set river's stepping to true
            set river's active to false
        else if river's trace's count > 0:
            set river's reduced motion to instance's reduced motion
            begin website river replay in river stepping true
            set program's phase to 3
        else:
            run website program index in state
            set river's stepping to true
        refresh website river controls in state
        return true
    if destination = "action:river-speed":
        set river's speed to 1 if (river's speed = 4), else (river's speed * 2)
        refresh website river controls in state
        return true
    if destination = "action:river-reset":
        stop website river effects in state
        stop website program index in state
        set river's scene to the initial website river scene
        set river's target to river's scene
        set river's instruction to @intrinsic("construct", a pointer to website river instruction)
        set river's shown to @intrinsic("construct", a pointer to website river instruction)
        set river's stage to 0
        set river's failed to false
        set river's position to 0
        set river's message to "The farmer can take one passenger at a time."
        set the text of "River execution" in instance to "Write a plan. Run it, or take one instruction at a time."
        set the text of "River diagnostics" in instance to ""
        set the text of "River status" in instance to "Ready."
        refresh website river controls in state
        return true
    if destination = "action:river-audio":
        if river's audio's status = 3:
            load the website river audio in state
        else:
            set river's audio's muted to river's audio's muted = false
        refresh website river controls in state
        return true
    if destination = "action:river-retry-art":
        for each path in (the website river artwork):
            reload UI image from (the string form of path) in (state's view)
        set river's active to false
        return true
    set actions to ["action:river-hint-passenger", "action:river-hint-deliveries", "action:river-hint-rescue"]
    set groups to ["River passenger hint", "River delivery hint", "River rescue hint"]
    set cursor to 0
    loop while cursor < the length of actions:
        if destination = (the item at cursor in actions):
            set label to the item at cursor in groups
            set the value of label in instance to (0 if (the value of label in instance) = -1, else -1)
            return true
        increment cursor
    return false

to [advance the website river in] {a pointer to website state:state}:
    set view to state's view
    set river to the address of (state's river)
    set visible to false
    if (state's route = "/index.html") and ((the value of "Challenge views" in (view's instance)) = 1):
        set canvas to the UI layout labeled "River scene" in (view's layout)
        set visible to ((canvas's painted bounds' y + canvas's painted bounds' height) > 0.0) and (canvas's painted bounds' y < view's height)
        set river's artwork to the website river artwork status in view
    set active to (visible and view's active) and (((river's artwork = 1) and river's playing) and (river's paused = false))
    if active:
        if river's active:
            advance website river playback river by (the maximum of 0.0 and (view's seconds - river's last seconds))
        if river's playing and (river's paused = false):
            animate UI view view
    set river's active to active
    set river's last seconds to view's seconds
    if river's changed:
        save website river progress in state
        set river's changed to false
    if (state's programs + (the website program for source "River source"))'s phase = 3:
        if river's playing = false:
            set (state's programs + (the website program for source "River source"))'s phase to 0
            set caption to "Solved." if (river's scene's complete), else "Plan ended."
            if river's trace's outcome = 2:
                set caption to "Try again."
            set the text of "River status" in (view's instance) to caption
    refresh website river controls in state
    advance the website river audio in state
