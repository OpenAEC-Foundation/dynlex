import character_art.dl
import playback.dl
import sprites.dl
import ../../packages/dynlex-ui/ui/images.dl

to get the website river expression for {integer:subject} during {a pointer to website river playback:river}:
    set pose to the website river expression for subject at (river's seconds)
    if subject = 1:
        set pose's mouth to river's audio's mouth
    if subject = 2:
        if (river's stage = 1) and (river's event != @intrinsic("construct", a pointer to website river event)):
            if (river's event's kind = 4) and (river's elapsed >= 0.65):
                set pose's licking to true
                set pose's tongue phase to (river's elapsed - 0.65) / 0.85
    return pose

# Blinks and expressions are composited over the original painted body.
to [paint website river expressions for] {integer:subject} in {UI bounds:actor} using {website river expression pose:expression} flipped {boolean:flipped} outlining {boolean:outlining} on {UI frame:frame}:
    for each eye in (the website river eye overlays):
        if eye's subject = subject:
            set box to actor
            set box's x to box's x + box's width * eye's horizontal offset
            set box's y to box's y + box's height * eye's vertical offset
            set opacity to expression's right blink if (eye's side = 1), else (expression's left blink)
            paint website river blink (eye's sprite) across box flipped flipped centered (eye's x) (eye's y) radius (eye's horizontal radius) (eye's vertical radius) solid (eye's solid) opacity opacity outlining outlining on frame
    if subject = 1:
        set mouth to expression's mouth
        if mouth > 0.01:
            set box to UI box at (actor's x + actor's width * 0.515) (actor's y + actor's height * 0.485) sized (actor's width * 0.09) (actor's height * 0.07 * mouth)
            draw a rounded UI box box with radius (box's height * 0.45) in (UI ink 33 23 24) on frame
            if outlining:
                draw a rounded UI outline box with radius 0.0 width 1.0 in (UI ink 231 106 164) on frame
            set box's x to box's x + box's width * 0.16
            set box's y to box's y + box's height * 0.62
            set box's width to box's width * 0.68
            set box's height to box's height * 0.34
            draw a rounded UI box box with radius (box's height / 2.0) in (UI ink 185 93 104) on frame
    if subject = 2:
        if expression's licking:
            set pose to the website wolf tongue at (expression's tongue phase)
            set width to actor's width * 0.052
            set height to width * (40.0 / 39.0)
            save the model transform in frame
            move the model in frame by x (actor's x + actor's width * (pose's x / 100.0)), y (actor's y + actor's height * (pose's y / 100.0)) and z 0.0
            rotate the model in frame by (pose's angle) degrees around x 0.0, y 0.0 and z 1.0
            set box to UI box at (-0.5 * width) (-0.5 * height) sized (width * pose's extension) height
            paint website river sprite 8 in box flipped false opacity ((255.0 * pose's extension) as an integer) on frame
            if outlining:
                draw a rounded UI outline box with radius 0.0 width 1.0 in (UI ink 231 106 164) on frame
            restore the model transform in frame

to begin website river scuffle in {UI bounds:box} at {floating-point number:seconds} on {UI frame:frame}:
    save the model transform in frame
    set wave to 0.0 - (the cosine of (seconds * 20.9439510239))
    move the model in frame by x ((box's x + box's width / 2.0) + wave * 4.0), y (((box's y + box's height / 2.0) - 0.5) - wave * 2.5) and z 0.0
    rotate the model in frame by (0.5 + wave * 8.5) degrees around x 0.0, y 0.0 and z 1.0
    move the model in frame by x ((0.0 - box's x) - box's width / 2.0), y ((0.0 - box's y) - box's height / 2.0) and z 0.0
