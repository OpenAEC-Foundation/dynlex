import graphics_controller.dl
import role_controls.dl
import clock.dl
import land_controls.dl
import input.dl
import frame.dl

to [reset website Farm tools in] {a pointer to website state:state}:
    cancel website Farm area drawing in state
    set session to the address of (state's farm)
    set session's selected flag, session's flag color and session's selected area to ""
    set session's pointer mode to 0
    set session's pointer entity to ""
    set session's pointer moved to false
    set session's pointer name to false
    set session's pointer selection to a new website Farm entity selection
    set session's pointer square and session's pointer origin to a new website Farm square selection
    set session's pointer start and session's pointer previous to a new UI point
    set instance to state's view's instance
    set the text of "Farm role name" in instance to ""
    set the text of "Farm area name" in instance to ""

to [reload website Farm progress in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    if session's document = (0 as a pointer to website farm document):
        return nothing
    pause website Farm in state
    stop website program (the website program for source "Farm source") in state
    set program to state's programs + (the website program for source "Farm source")
    set program's source and program's output to ""
    set session's pending actor and session's pending role to ""
    set session's rebuilding and session's rebuild failed to false
    set session's rebuild stopped to false
    reset website Farm tools in state
    free website farm document (session's document)
    set session's document to 0 as a pointer to website farm document
    open website Farm document in state
    if session's renderer != (0 as a pointer to website Farm renderer):
        update website Farm renderer (session's renderer) from (session's document's world) over 0.0 seconds instantly true
    request a UI redraw in (state's view)

to [pause website Farm in] {a pointer to website state:state}:
    set state's farm's playing to false
    set state's farm's held key to 0
    stop website Farm clock in state
    set state's farm's focused to false
    release website Farm gesture in state cancelled true

to [leave website Farm in] {a pointer to website state:state}:
    pause website Farm in state
    if state's farm's names != (0 as a pointer to UI floating controls):
        hide website Farm names in (state's farm's names)
    stop website program (the website program for source "Farm source") in state

to [initialize the website Farm in] {a pointer to website state:state}:
    set state's progress's loaded to (the function named "reload website Farm progress in $") as a pointer
    set program to state's programs + (the website program for source "Farm source")
    set program's started to (the function named "notice website Farm start $ in $") as a pointer
    set program's finished to (the function named "notice website Farm finish $ in $") as a pointer
    set instance to state's view's instance
    set the "Give this role to Ada" control in instance enabled false
    for each label in ["Farm view notices", "Farm preparation notices", "Farm preparation retry", "Farm vocabulary panel"]:
        set the value of label in instance to -1
    set the text of "Farm action examples" in instance to (the website Farm action guide)
    set the text of "Farm condition examples" in instance to (the website Farm condition guide)
    set the text of "Farm destination examples" in instance to (the website Farm destination guide)
    set the text of "Farm supply examples" in instance to (the website Farm supply guide)
    set the "Retry Farm view" control in instance enabled false
    set the "Retry saved roles" control in instance enabled false
    bind (the control labeled "Farm source" in instance) in instance to (the function named "notice website Farm source edit $") for event 0
    for each label in ["Farm people", "Farm role", "Farm flags", "Farm flag color", "Farm areas", "Farm speed", "Farm action", "Farm supply"]:
        bind (the control labeled label in instance) in instance to (the function named "notice website Farm field $") for event 0

to [close website Farm in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    pause website Farm in state
    if session's names != (0 as a pointer to UI floating controls):
        close UI floating controls (session's names)
        set session's names to 0 as a pointer to UI floating controls
    stop website program (the website program for source "Farm source") in state
    if session's graphics request != 0:
        ignore cancel website request (session's graphics request) in state
        set session's graphics request to 0
    if session's renderer != (0 as a pointer to website Farm renderer):
        close website Farm renderer (session's renderer)
        set session's renderer to 0 as a pointer to website Farm renderer
    if session's graphics resource != (0 as a pointer):
        close UI shader (session's graphics resource) in (state's view)
        set session's graphics resource to 0 as a pointer
    if session's document != (0 as a pointer to website farm document):
        free website farm document (session's document)
        set session's document to 0 as a pointer to website farm document
    set session's graphics phase to 0

to get [follow website Farm action] {string:destination} [in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    if destination = "action:farm":
        open website Farm document in state
        set session's rebuild stopped to false
        prepare website Farm saved roles in state
        set the value of "Challenge views" in (state's view's instance) to 2
        if session's graphics phase = 0:
            load website Farm graphics in state
        start website Farm clock in state
        save website Farm progress in state
        request a UI redraw in (state's view)
        return true
    if (destination has "action:farm-" at offset 0) = false:
        return false
    require condition (session's document != (0 as a pointer to website farm document)) reporting "A Farm action requires an open challenge"
    if follow website Farm role action destination in state:
        return true
    if follow website Farm land action destination in state:
        return true
    set document to session's document
    set world to document's world
    if destination = "action:farm-vocabulary":
        set instance to state's view's instance
        set shown to (the value of "Farm vocabulary panel" in instance) = -1
        set the value of "Farm vocabulary panel" in instance to (0 if shown, else -1)
        set the text of "Show Farm vocabulary" in instance to ("Hide Farm vocabulary" if shown, else "Show Farm vocabulary")
        return true
    if destination = "action:farm-retry-roles":
        set session's rebuild failed to false
        set session's rebuild stopped to false
        prepare website Farm saved roles in state
        return true
    if destination = "action:farm-play":
        set session's playing to session's playing = false
        if session's playing = false:
            stop website Farm clock in state
        prepare website Farm saved roles in state
        start website Farm clock in state
        refresh website Farm controls in state
        request a UI redraw in (state's view)
        return true
    if destination = "action:farm-step":
        if the website Farm has pending saved roles in state:
            prepare website Farm saved roles in state
            return true
        pause website Farm in state
        advance the website farm world world using roles (document's roles) with workers running true
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-reset":
        pause website Farm in state
        stop website program (the website program for source "Farm source") in state
        reset website Farm tools in state
        free website farm document document
        set session's document to the initial website farm document
        set session's rebuilding and session's rebuild failed to false
        set session's rebuild stopped to false
        show website Farm role (session's document's role id) in state
        set the text of "Farm worker name" in (state's view's instance) to "Ada"
        if session's renderer != (0 as a pointer to website Farm renderer):
            reset website Farm renderer (session's renderer)
        update website Farm world view in state instantly true
        return true
    if destination = "action:farm-retry-view":
        load website Farm graphics in state
        return true
    if destination = "action:farm-overview":
        show the whole Farm through (the address of (session's renderer's camera)) over 0.65 seconds
        animate UI view (state's view)
        return true
    if destination = "action:farm-focus":
        set actor to the website farm actor identified by (document's selected) in world
        focus website Farm camera (the address of (session's renderer's camera)) on actor in world around (session's renderer's landscape) over 0.65 seconds
        animate UI view (state's view)
        return true
    if destination = "action:farm-barn":
        walk website Farm player to (world's barn) adjacently true following animal (the string form of "") in state
        update website Farm world view in state instantly false
        start website Farm clock in state
        return true
    if destination = "action:farm-deliver":
        ignore (deliver the website farm order in world)
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-act":
        set selected to the website Farm choice in "Farm action" in state
        for each tool in (the website farm tools):
            if tool's key = selected:
                perform website Farm manual instruction (the website Farm instruction for tool tool) in state
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-grab":
        set kind to the website farm item number named (the website Farm choice in "Farm supply" in state)
        set instruction to the website Farm instruction named "collect"
        set instruction's argument to kind
        set instruction's amount to (the item at kind in (the website farm items))'s capacity
        set instruction's target to 0
        perform website Farm manual instruction instruction in state
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-hint":
        set chosen to the website Farm choice in "Farm goal" in state
        for each goal in (the website Farm goal descriptions):
            if (the item at 0 in goal) = chosen:
                set the text of "Farm goal hint" in (state's view's instance) to (the item at 2 in goal)
        return true
    return false

to [notice website Farm field] {a pointer to UI instance:instance}:
    set state to the website state in instance
    set session to the address of (state's farm)
    set label to instance's event target's text
    if label = "Farm people":
        if session's rebuilding = false:
            stop website program (the website program for source "Farm source") in state
        choose website Farm person (the website Farm choice in "Farm people" in state) in state
    if label = "Farm role":
        if session's rebuilding = false:
            stop website program (the website program for source "Farm source") in state
        show website Farm role (the website Farm choice in "Farm role" in state) in state
    if label = "Farm flags":
        set session's selected flag to the website Farm choice in "Farm flags" in state
    if label = "Farm flag color":
        set session's flag color to the website Farm choice in "Farm flag color" in state
    if label = "Farm areas":
        set session's selected area to the website Farm choice in "Farm areas" in state
    if label = "Farm speed":
        stop website Farm clock in state
        set session's document's speed to 1 + (the value of "Farm speed" in instance)
        start website Farm clock in state
    refresh website Farm controls in state
    save website Farm progress in state
