# Each fixed cube face/mip is drawn once. The renderer then empties its draw list.
import ../lighting.dl
import lib/shader.dl

set parameters to the shader uniform named "environment" at binding 0 as @intrinsic("vector", 4)
set count to the shader uniform named "samples" at binding 1 as a 32 bit integer
set width to the element at 0 in parameters
set height to the element at 1 in parameters
set face to (the element at 2 in parameters) as an integer
set roughness to the element at 3 in parameters
set direction to the UI scene cube direction on face face at ((the fragment x coordinate) / width) ((the fragment y coordinate) / height)
set color to the website Farm sky reflection along direction at roughness roughness using count samples
set the fragment color with a red channel of (the x of color), a green channel of (the y of color), a blue channel of (the z of color) and an alpha channel of 1.0
