import ../materials.dl
import ../rain_motion.dl
import ../../../packages/dynlex-ui/ui/scene_shader.dl

set camera to the shader uniform named "camera" at binding 0 as (@intrinsic("matrix", 4, 4, @intrinsic("type", "float", 32)))
set light to the shader uniform named "light" at binding 1 as (@intrinsic("matrix", 4, 4, @intrinsic("type", "float", 32)))
set eye to the shader uniform named "eye_time" at binding 2 as @intrinsic("vector", 4)
set settings to the shader uniform named "shadow_settings" at binding 8 as @intrinsic("vector", 4)
set point to the UI scene shader world position
set normal to the UI scene shader normal
set flags to the UI scene shader flags
if (the element at 0 in flags) = (2 as a 32 bit unsigned integer):
    set normal to the website Farm water normal from normal at point at time (the element at 3 in eye)
else if (the element at 0 in flags) = (3 as a 32 bit unsigned integer):
    set seed to the element at 0 in (the UI scene shader coordinates)
    set height to the website Farm rain height from seed at (the element at 3 in eye) seconds
    set point to a new vector with x (the x of point), y ((the y of point) + (height - seed)) and z (the z of point)
set normal to the UI scene shader world normal from normal
set clip to the UI scene shader clip position of point through camera
set shadow to the UI scene shader clip position of (point + normal * (the element at 3 in settings)) through light
set paint to the UI scene shader color
set vertex to the UI scene shader vertex color
set color to @intrinsic("construct", @intrinsic("vector", 4), (the element at 0 in paint) * (the x of vertex), (the element at 1 in paint) * (the y of vertex), (the element at 2 in paint) * (the z of vertex), the element at 3 in paint)
set emission to the UI scene shader emission
set the smooth shader interpolant named "world_position" at location 0 to point
set the smooth shader interpolant named "world_normal" at location 1 to normal
set the smooth shader interpolant named "local_position" at location 2 to (the UI scene shader position)
set the smooth shader interpolant named "color" at location 3 to color
set the flat shader interpolant named "emission" at location 4 to (a new vector with x (the element at 0 in emission), y (the element at 1 in emission) and z (the element at 2 in emission))
set the flat shader interpolant named "surface" at location 5 to (the UI scene shader surface)
set the flat shader interpolant named "flags" at location 6 to flags
set the smooth shader interpolant named "shadow_position" at location 7 to shadow
set the smooth shader interpolant named "view_depth" at location 8 to (the element at 3 in clip)
set the output position with x (the element at 0 in clip), y (the element at 1 in clip), z (the element at 2 in clip) and w (the element at 3 in clip)
