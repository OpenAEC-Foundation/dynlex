import lib/shader.dl
import lib/vector.dl

to get [the website Farm shadow at] {@intrinsic("vector", 4):position} [using] {@intrinsic("vector", 4):settings}:
    set point to (a new vector with x (the element at 0 in position), y (the element at 1 in position) and z (the element at 2 in position)) / (the element at 3 in position)
    set x to (the x of point) * 0.5 + 0.5
    set y to (the y of point) * 0.5 + 0.5
    set depth to (the z of point) + (the element at 2 in settings)
    set amount to 1.0
    if ((0.0 <= x <= 1.0) and (0.0 <= y <= 1.0)) and (depth <= 1.0):
        set image to the shader depth image named "shadow" at binding 9
        set filter to the shader comparison sampler named "shadow_filter" at binding 10
        set noise to (the fragment x coordinate) * 0.06711056 + (the fragment y coordinate) * 0.00583715
        set noise to noise - (the floor of noise)
        set noise to noise * 52.9829189
        set noise to noise - (the floor of noise)
        set angle to noise * 6.283185307179586
        set radius to 1.0 / (the element at 1 in settings)
        set amount to 0.0
        loop index from 0 to 5:
            set distance to (the square root of (((index as a 32 bit floating-point number) + 0.5) / 5.0)) * radius
            set direction to (index as a 32 bit floating-point number) * 2.399963229728653 + angle
            set horizontal to x + (the cosine of direction) * distance
            set vertical to y + (the sine of direction) * distance
            set coordinates to @intrinsic("construct", @intrinsic("vector", 2), horizontal, vertical)
            set amount to amount + (the visibility from image using filter at coordinates with depth depth)
        set amount to amount * 0.2
    return amount
