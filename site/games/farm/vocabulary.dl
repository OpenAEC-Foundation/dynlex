# Farm vocabulary is application data. The language and browser exports derive
# from these same tables; numeric protocol identifiers are their row positions.
import lib/std.dl
import lib/check.dl

class:
    patterns:
        website farm item description
    members:
        key as a C string
        phrase as a C string
        label as a C string
        capacity as an integer
        quantity as an integer
        aliases as a C string

class:
    patterns:
        website farm destination description
    members:
        key as a C string
        literal as a C string
        kind as a C string

class:
    patterns:
        website farm command description
    members:
        key as a C string
        patterns as a C string
        operands as a C string
        argument as an integer
        amount as an integer
        target as an integer
        subject as a C string
        instant as a boolean
        guide spelling as an integer
        guide argument as an integer

class:
    patterns:
        website farm flag description
    members:
        key as a C string
        color as a C string

class:
    patterns:
        website farm item alias
    members:
        phrase as a C string
        identifier as an integer
        amount as an integer

class:
    patterns:
        website farm target alias
    members:
        phrase as a C string
        key as a C string

[the website farm subject target] means: -1
[the website farm absent target] means: -2
[the website farm all items] means: -1
[the website farm subject items] means: -2

[farm item] {C string:key} [is] {C string:phrase} [labeled] {C string:label} [with capacity] {integer:capacity} [selecting] {integer:quantity} [and aliases] {C string:aliases} means: @intrinsic("construct", website farm item description, key, phrase, label, capacity, quantity, aliases)
[farm destination] {C string:key} [is] {C string:literal} [of kind] {C string:kind} means: @intrinsic("construct", website farm destination description, key, literal, kind)
[farm command] {C string:key} [written] {C string:patterns} [taking] {C string:operands} [with argument] {integer:argument} [amount] {integer:amount} [target] {integer:target} [remembering] {C string:subject} [instantly] {boolean:instant} means: @intrinsic("construct", website farm command description, key, patterns, operands, argument, amount, target, subject, instant, 0, argument)
{website farm command description:entry} [illustrated with spelling] {integer:spelling} [and argument] {integer:argument} means: @intrinsic("construct", website farm command description, entry's key, entry's patterns, entry's operands, entry's argument, entry's amount, entry's target, entry's subject, entry's instant, spelling, argument)
[farm flag] {C string:key} [is] {C string:color} means: @intrinsic("construct", website farm flag description, key, color)
[farm item alias] {C string:phrase} [selects] {integer:identifier} [with amount] {integer:amount} means: @intrinsic("construct", website farm item alias, phrase, identifier, amount)
[farm target alias] {C string:phrase} [selects] {C string:key} means: @intrinsic("construct", website farm target alias, phrase, key)

