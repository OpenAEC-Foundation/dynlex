the website farm actions means: [
    farm command "step" written "step {farm direction:direction}" taking "direction" with argument (0) amount (-1) target (-2) remembering "" instantly false,
    farm command "turn" written "turn {farm direction:direction}" taking "direction" with argument (2) amount (-1) target (-2) remembering "" instantly false,
    farm command "walk" written "walk to {farm target:target}" taking "target" with argument (0) amount (-1) target (0) remembering "target" instantly false,
    farm command "chop" written "chop {farm target:target} down" taking "target" with argument (0) amount (-1) target (22) remembering "target" instantly false,
    farm command "plow" written "plow {farm target:target}" taking "target" with argument (0) amount (-1) target (20) remembering "target" instantly false,
    farm command "plant" written "plant {farm item:items}\nplant {farm item:items} in {farm target:target}" taking "items-target" with argument (6) amount (-1) target (20) remembering "items" instantly false,
    farm command "water" written "water {farm target:target}" taking "target" with argument (0) amount (-1) target (21) remembering "target" instantly false,
    farm command "harvest" written "harvest {farm target:target}" taking "target" with argument (0) amount (-1) target (21) remembering "target" instantly false,
    farm command "fertilize" written "fertilize {farm target:target}" taking "target" with argument (0) amount (-1) target (20) remembering "target" instantly false,
    farm command "fill" written "fill {farm item:items}" taking "items" with argument (2) amount (-1) target (-2) remembering "items" instantly false,
    farm command "store" written "store {farm item:items}" taking "items" with argument (-1) amount (-1) target (0) remembering "items" instantly false,
    farm command "give" written "give {farm item:items} to {farm target:target}" taking "items-target" with argument (5) amount (-1) target (26) remembering "items" instantly false,
    farm command "drop" written "put down {farm item:items}" taking "items" with argument (-1) amount (-1) target (-2) remembering "items" instantly false,
    farm command "collect" written "[grab|take|collect|pick up] {farm item:items}\n[grab|take|collect|pick up] {farm item:items} from {farm target:target}" taking "items-target" with argument (-1) amount (-1) target (-2) remembering "items" instantly false,
    farm command "dig" written "dig {farm feature:feature}\ndig {farm feature:feature} in {farm target:target}" taking "feature-target" with argument (0) amount (-1) target (20) remembering "" instantly false,
    farm command "feed" written "feed {farm target:target}" taking "target" with argument (0) amount (-1) target (9) remembering "target" instantly false,
    farm command "add" written "add {farm item:items} to {farm target:target}" taking "items-target" with argument (11) amount (-1) target (11) remembering "items" instantly false,
    farm command "wait" written "wait" taking "none" with argument (0) amount (-1) target (-2) remembering "" instantly false,
    farm command "focusTarget" written "set the subject to {farm target:target}" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly true,
    farm command "focusItems" written "set the subject to {farm item:items}" taking "items" with argument (-1) amount (-1) target (-2) remembering "items" instantly true
]

the website farm conditions means: [
    farm command "exists" written "there [is|are] {farm target:target}\nthere's {farm target:target}\n{farm target:target} [is|are] [still|] there\n{farm target:target}'s still there" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false illustrated with spelling 3 and argument 0,
    farm command "reach" written "i can reach {farm target:target}" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "full" written "{farm item:items} [is|are] full" taking "items" with argument (-1) amount (-1) target (-2) remembering "items" instantly false,
    farm command "empty" written "{farm item:items} [is|are] empty" taking "items" with argument (-1) amount (-1) target (-2) remembering "items" instantly false,
    farm command "rain" written "it's raining" taking "none" with argument (0) amount (-1) target (-2) remembering "" instantly false,
    farm command "dry" written "{farm target:target} [is|are] dry" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "ripe" written "{farm target:target} [is|are] ripe" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "bare" written "{farm target:target} [is|are] empty" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "unplowed" written "{farm target:target} [needs|need] plowing" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "ready" written "{farm target:target} [is|are] ready" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "hungry" written "{farm target:target} [is|are] hungry" taking "target" with argument (0) amount (-1) target (-2) remembering "target" instantly false,
    farm command "carrying" written "i am carrying {farm item:items}" taking "items" with argument (0) amount (-1) target (-2) remembering "items" instantly false,
    farm command "notCarrying" written "i am not carrying {farm item:items}" taking "items" with argument (0) amount (-1) target (-2) remembering "items" instantly false,
    farm command "role" written "i am a {farm role:role}" taking "role" with argument (0) amount (-1) target (-2) remembering "" instantly false,
    farm command "canStep" written "i can step {farm direction:direction}" taking "direction" with argument (0) amount (-1) target (-2) remembering "" instantly false,
    farm command "stockAtLeast" written "there are at least {a farm number:count} {farm item:items} in {farm target:target}" taking "stock" with argument (0) amount (-1) target (0) remembering "" instantly false illustrated with spelling 0 and argument 5,
    farm command "stockFewer" written "there are fewer than {a farm number:count} {farm item:items} in {farm target:target}" taking "stock" with argument (0) amount (-1) target (0) remembering "" instantly false illustrated with spelling 0 and argument 5
]


# Toolbar choices override only the operands explicitly supplied here.
class:
    patterns:
        website farm tool description
    members:
        key as a C string
        command as a C string
        selects as a boolean
        argument as an integer
        targets as a boolean
        target as an integer

[farm tool] {C string:key} [runs] {C string:command} means: @intrinsic("construct", website farm tool description, key, command, false, 0, false, 0)
[farm tool] {C string:key} [runs] {C string:command} [selecting] {integer:argument} means: @intrinsic("construct", website farm tool description, key, command, true, argument, false, 0)
[farm tool] {C string:key} [runs] {C string:command} [on] {integer:target} means: @intrinsic("construct", website farm tool description, key, command, false, 0, true, target)
[farm tool] {C string:key} [runs] {C string:command} [selecting] {integer:argument} [on] {integer:target} means: @intrinsic("construct", website farm tool description, key, command, true, argument, true, target)

the website farm tools means: [
    farm tool "chop" runs "chop",
    farm tool "plow" runs "plow",
    farm tool "carrots" runs "plant",
    farm tool "wheat" runs "plant" selecting 7,
    farm tool "water" runs "water",
    farm tool "harvest" runs "harvest",
    farm tool "fill" runs "fill",
    farm tool "pickup" runs "collect",
    farm tool "dig" runs "dig",
    farm tool "feedCow" runs "feed",
    farm tool "feedChickens" runs "feed" on 24,
    farm tool "milk" runs "collect" selecting 10,
    farm tool "eggs" runs "collect" selecting 9,
    farm tool "compost" runs "add",
    farm tool "takeCompost" runs "collect" selecting 12 on 11,
    farm tool "fertilize" runs "fertilize",
    farm tool "store" runs "store",
    farm tool "drop" runs "drop",
    farm tool "left" runs "turn" selecting 2,
    farm tool "right" runs "turn" selecting 3
]
