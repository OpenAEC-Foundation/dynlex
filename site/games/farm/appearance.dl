import ../../appearance.dl

appearance farm panel appearance:
    background is UI ink 20 35 31
    text is UI ink 236 241 224
    padding is 24
    gap is 20
    corner radius is 16
    when viewport is below 700:
        padding is 12

appearance farm card appearance:
    background is UI ink 27 45 39
    border is UI ink 57 78 61
    border width is 1
    corner radius is 10
    padding is 16
    gap is 12

appearance farm body appearance:
    font size is 14
    text is UI ink 212 224 201
    line spacing is 1.5

appearance farm signal appearance:
    font is "assets/fonts/JetBrainsMono-400.ttf"
    font size is 11
    text is UI ink 179 200 166
    line spacing is 1.4

appearance farm heading appearance:
    font is "assets/fonts/SpaceGrotesk-700.ttf"
    font size is 24
    text is UI ink 241 229 186

appearance farm action appearance:
    use link appearance
    background is UI ink 49 73 55
    text is UI ink 235 240 221
    font size is 12
    padding is 10
    minimum height is 40
    text is centered

appearance farm primary appearance:
    use farm action appearance
    background is UI ink 222 184 99
    text is UI ink 31 40 27

appearance farm field appearance:
    background is UI ink 15 30 25
    text is UI ink 235 240 221
    border is UI ink 71 96 71
    border width is 1
    corner radius is 6
    font size is 14
    minimum height is 40
    padding is 10

appearance farm code appearance:
    use code appearance
    background is UI ink 15 30 25
    height is 360
    font size is 14
    padding is 14
    when viewport is below 700:
        height is 280

appearance farm stage appearance:
    aspect ratio is 4 by 3
    background is UI ink 184 200 166
    corner radius is 8

appearance farm columns appearance:
    columns are 2
    stack below 980
    gap is 20

appearance farm controls appearance:
    columns are 2
    gap is 8

appearance farm diagnostics appearance:
    use farm signal appearance
    text is UI ink 255 189 157

appearance farm vocabulary tabs appearance:
    text is UI ink 235 240 221
    font size is 13
    gap is 8
    when viewport is below 700:
        font size is 12
        gap is 4

appearance farm example appearance:
    use farm signal appearance
    font size is 12
    line spacing is 1.8
