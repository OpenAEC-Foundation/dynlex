import navigation.dl
import lib/text.dl
import lib/unicode.dl

to [notify website farm] {a pointer to website farm world:world} [saying] {a value:message}:
    insert (the string form of message) into (world's notices) at index 0
    if the length of (world's notices) > 4:
        remove the last item from world's notices

to get [relocate website farm entity] {a value:id} [to] {website farm point:position} [in] {a pointer to website farm world:world}:
    set index to 0
    loop while index < the length of (world's workers):
        set actor to the item at index in (world's workers)
        if actor's id = id:
            if (website farm land at (position's x) (position's y) is walkable in world except actor actor) = false:
                return false
            set actor's x to position's x
            set actor's y to position's y
            set actor's target to a new website farm movement target
            set actor's status to "Placed here. Continuing my role."
            return true
        increment index
    set index to 0
    loop while index < the length of (world's chickens):
        set animal to (world's chickens' data) + index
        if animal's id = id:
            if (website farm land at (position's x) (position's y) is walkable in world except actor (0 as a pointer to website farm actor) except animal id) = false:
                return false
            set animal's x to position's x
            set animal's y to position's y
            return true
        increment index
    return false

to get [website farm flag] {integer:color} [can stand at] {website farm point:point} [in] {a pointer to website farm world:world}:
    if (website farm land at (point's x) (point's y) is unlocked in world) = false:
        return false
    set tile to the website farm square at (point's x) (point's y) in world
    if (tile's terrain = 1) or (tile's tree's present):
        return false
    set index to 0
    loop while index < the length of (world's flags):
        set flag to the item at index in (world's flags)
        if (flag's color != color) and ((flag's x = point's x) and (flag's y = point's y)):
            return false
        increment index
    if (the website farm pen at (point's x) (point's y)) != -1:
        return false
    if ((point's x = world's barn's x) and (point's y = world's barn's y)) or ((point's x = world's compost's x) and (point's y = world's compost's y)):
        return false
    return true

to get [move website farm flag] {integer:color} [to] {website farm point:point} [in] {a pointer to website farm world:world}:
    set index to 0
    loop while index < the length of (world's flags):
        set flag to (world's flags' data) + index
        if flag's color = color:
            if (website farm flag color can stand at point in world) = false:
                return false
            set flag's x to point's x
            set flag's y to point's y
            return true
        increment index
    return false

to get [add website farm flag] {integer:color} [in] {a pointer to website farm world:world}:
    set index to 0
    loop while index < the length of (world's flags):
        if (the item at index in (world's flags))'s color = color:
            return false
        increment index
    set nearest to -1
    set distance to 2147483647
    loop index from 0 to the website farm square count:
        set tile to world's tiles + index
        set point to the website farm position of tile
        if website farm flag color can stand at point in world:
            set candidate to the website farm distance from (the website farm position of (world's player)) to point
            if candidate < distance:
                set nearest to index
                set distance to candidate
    if nearest = -1:
        return false
    set tile to world's tiles + nearest
    append (@intrinsic("construct", website farm flag, color, the next website farm entity in world, tile's x, tile's y)) to world's flags
    return true

to [remove website farm flag] {integer:color} [from] {a pointer to website farm world:world}:
    set index to (the length of (world's flags)) - 1
    loop while index >= 0:
        if (the item at index in (world's flags))'s color = color:
            remove item index from world's flags
        decrement index

# Match the original text-entry trimming rules, including non-ASCII spaces and
# U+FEFF. Callers validate UTF-8 before this scan.
function the trimmed website farm name {string:text}:
    execute:
        set spaces to [9, 10, 11, 12, 13, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288, 65279]
        set cursor, start and end to 0
        set found to false
        loop while cursor < text's length:
            decode the next UTF-8 code point in text at byte cursor and set decoded to it
            set point to the code point of decoded
            set whitespace to false
            for each space in spaces:
                if point = space:
                    set whitespace to true
            if whitespace = false:
                if found = false:
                    set start to cursor
                    set found to true
                set end to the next byte offset of decoded
            set cursor to the next byte offset of decoded
        return the substring of text from start spanning (end - start) bytes

class:
    patterns:
        website farm area result
    members:
        area as website farm area
        error as a string

to get [the website farm area bounds from] {website farm point:start} [to] {website farm point:end} [in] {a pointer to website farm world:world}:
    set result to a new website farm area result
    set result's area's left to the minimum of (start's x) and (end's x)
    set result's area's top to the minimum of (start's y) and (end's y)
    set result's area's right to the maximum of (start's x) and (end's x)
    set result's area's bottom to the maximum of (start's y) and (end's y)
    if ((website farm land at (start's x) (start's y) is unlocked in world) and (website farm land at (end's x) (end's y) is unlocked in world)) = false:
        set result's error to "Choose a rectangle on available land."
    return result

to get [the website farm area name] {string:input} [for] {string:id} [in] {a pointer to website farm world:world}:
    set result to a new website farm area result
    set validation to the UTF-16 position of UTF-8 byte offset (input's length) in input
    if validation failed:
        set result's error to "Give your area a name of 1–40 characters."
        return result
    set name to the trimmed website farm name input
    set length to the UTF-16 position of UTF-8 byte offset (name's length) in name
    if ((name is empty) or (the position of length > 40)) or ((name contains "\r") or (name contains "\n")):
        set result's error to "Give your area a name of 1–40 characters."
        return result
    set index to 0
    loop while index < the length of (world's areas):
        set area to the item at index in (world's areas)
        if (area's name = name) and (area's id != id):
            set result's error to "An area already has that name."
            return result
        increment index
    set result's area's name to name
    return result

to get [add website farm area named] {string:input} [identified by] {string:id} [from] {website farm point:start} [to] {website farm point:end} [in] {a pointer to website farm world:world}:
    set result to the website farm area name input for (the string form of "") in world
    if result's error is not empty:
        return result
    set name to result's area's name
    set result to the website farm area bounds from start to end in world
    if result's error is not empty:
        return result
    set flags to the website farm flags
    set color to (the length of (world's areas)) % (the length of flags)
    set index to 0
    set found to false
    loop while (index < the length of flags) and (found = false):
        set candidate to the item at index in flags
        set used to false
        set cursor to 0
        loop while cursor < the length of (world's areas):
            if (the item at cursor in (world's areas))'s color = candidate's color:
                set used to true
            increment cursor
        if used = false:
            set color to index
            set found to true
        increment index
    set description to the item at color in flags
    set result's area's id to id
    set result's area's name to name
    set result's area's color to the string form of (description's color)
    append (result's area) to world's areas
    return result

to get [the website farm area identified by] {string:id} [in] {a pointer to website farm world:world}:
    loop index from 0 to (the length of world's areas):
        set area to world's areas' data + index
        if area's id = id:
            return area
    require condition false reporting "An area control must identify an existing Farm area"
    return 0 as a pointer to website farm area

to get [rename website farm area] {string:id} [to] {string:input} [in] {a pointer to website farm world:world}:
    set result to the website farm area name input for id in world
    if result's error is empty:
        set area to the website farm area identified by id in world
        set area's name to result's area's name
    return result's error

to get [reshape website farm area] {string:id} [from] {website farm point:start} [to] {website farm point:end} [in] {a pointer to website farm world:world}:
    set result to the website farm area bounds from start to end in world
    if result's error is not empty:
        return result
    set index to 0
    loop while index < the length of (world's areas):
        set area to (world's areas' data) + index
        if area's id = id:
            set area's left to result's area's left
            set area's right to result's area's right
            set area's top to result's area's top
            set area's bottom to result's area's bottom
            set result's area to the value at area
            return result
        increment index
    require condition false reporting "A reshape needs an existing Farm area."
    return result

to [remove website farm area] {string:id} [from] {a pointer to website farm world:world}:
    set index to (the length of (world's areas)) - 1
    loop while index >= 0:
        if (the item at index in (world's areas))'s id = id:
            remove item index from world's areas
        decrement index
