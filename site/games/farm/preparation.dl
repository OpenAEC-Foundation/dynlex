import simulation.dl
import ../source.dl

to get [the website farm source error in] {website farm plan:plan} [for] {string:source}:
    scan lines in source and set scanned to it
    require condition (scanned succeeded) reporting "The Farm source snapshot is not valid UTF-8"
    set lines to the line index of scanned
    set error to the string form of ""
    for each instruction in (plan's code):
        if instruction's source's known:
            set span to the website source span of (instruction's source) in source indexed by lines
            if span's valid = false:
                set error to "An execution source range does not belong to the compiled role"
    free lines
    return error

# Source mapping can change ranges and instruction operands during a language
# migration. Worker positions and loop frames remain meaningful only when the
# control-flow structure is unchanged.
to get [website farm plan] {website farm plan:plan} [has the same control flow as] {website farm plan:other}:
    if (the length of (plan's code)) != the length of (other's code):
        return false
    set index to 0
    loop while index < the length of (plan's code):
        set left to the item at index in (plan's code)
        set right to the item at index in (other's code)
        if left's operation != right's operation:
            return false
        if left's operation = the website farm loop operation:
            if left's count != right's count:
                return false
        if left's operation != the website farm action operation:
            if left's destination != right's destination:
                return false
        increment index
    return true

to get [rebuild website farm role] {a pointer to website farm role:role} [using plan] {website farm plan:plan} [in] {a pointer to website farm world:world}:
    require condition (role's prepared) reporting "Rebuilding a Farm role needs its saved program."
    if plan's error is not empty:
        return plan's error
    set error to the website farm source error in plan for (role's applied)
    if error is not empty:
        return error
    if (website farm plan plan has the same control flow as (role's program)) = false:
        return the string form of "Upgrading a saved role changed its control flow."
    set replacement to a copy of website farm plan plan
    free website farm plan the address of (role's program)
    set role's program to replacement
    set role's needs rebuilding to false
    for each worker in (world's workers):
        if worker's role = role's id:
            set worker's routine's traced to false
            set worker's routine's source and worker's routine's condition source to a new website execution range
            set worker's routine's branch and worker's routine's condition branch to -1
            set worker's routine's message to ""
    return the string form of ""

to [apply website farm plan] {website farm plan:plan} [from] {string:source} [to] {a pointer to website farm role:role} [for] {a pointer to website farm actor:actor} [in] {a pointer to website farm world:world}:
    require condition (plan's error is empty) reporting "Applying a Farm role needs a valid program."
    require condition (actor's id != "player") reporting "The player cannot be assigned an automated Farm role."
    set replacement to a copy of website farm plan plan
    free website farm plan the address of (role's program)
    set role's program to replacement
    set role's prepared to true
    set role's applied to source
    set role's needs rebuilding to false
    assign website farm role role to actor
    set index to 0
    loop while index < the length of (world's workers):
        set worker to the item at index in (world's workers)
        if (worker != actor) and (worker's role = role's id):
            assign website farm role role to worker
        increment index
