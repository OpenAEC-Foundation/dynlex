import scene_control.dl

to [read website Farm input] {a pointer to UI view:view}:
    set state to the website state in (view's instance)
    set session to the address of (state's farm)
    if session's document = (0 as a pointer to website farm document):
        return nothing
    if view's input kind = 7:
        set session's focused to false
        release website Farm gesture in state cancelled true
        return nothing
    if (state's route != "/index.html") or ((the value of "Challenge views" in (view's instance)) != 2):
        return nothing
    set cursor to the UI cursor in view
    set inside to (cursor's x >= session's viewport's x) and (cursor's x < session's viewport's x + session's viewport's width)
    set inside to inside and ((cursor's y >= session's viewport's y) and (cursor's y < session's viewport's y + session's viewport's height))
    set name to the website Farm name at cursor in state
    if inside:
        set hit to the UI hit at cursor in view
        if hit != (0 as a pointer to UI layout):
            if (hit's node != (the control labeled "Farm scene" in (view's instance))) and (name = (0 as a pointer to UI floating control)):
                set inside to false
    if (view's input kind = 2) and (view's input code = 1):
        set session's focused to inside
        set session's held key to 0
    if session's renderer != (0 as a pointer to website Farm renderer):
        if (view's input kind = 5) and inside:
            zoom website Farm camera (the address of (session's renderer's camera)) by wheel (view's scroll y)
            set session's renderer's dirty to true
            set view's scroll x and view's scroll y to 0.0
            set view's input handled to true
            animate UI view view
        if view's input kind = 2:
            set button to view's input code / 2
            set pressed to (view's input code % 2) = 1
            if inside and pressed:
                release website Farm gesture in state cancelled true
                set session's pointer start and session's pointer previous to cursor
                set session's pointer moved to false
                set session's pointer name to false
                set session's pointer entity to ""
                if button = 0:
                    set session's pointer mode to 4 if session's drawing != 0, else 1
                    set ray to the UI scene ray at cursor through (session's renderer's camera's orbit's camera) in (session's viewport)
                    set session's pointer square to the website Farm square from ray in (session's renderer's landscape)
                    set session's pointer origin to session's pointer square
                    set session's pointer selection to the website Farm entity from ray in (session's renderer's landscape) with (session's renderer's characters) and (session's renderer's flags)
                    if (name != (0 as a pointer to UI floating control)) and (session's drawing = 0):
                        set character to the website Farm character named (name's key) in (session's renderer's characters)
                        require condition (character != (0 as a pointer to website Farm character)) reporting "The pressed Farm name has no scene person"
                        set session's pointer name to true
                        set session's pointer selection's entity to name's key
                        set session's pointer selection's object to character's object
                        set session's pointer selection's hit's hit to true
                    set id to session's pointer selection's entity
                    if ((id starts with "worker-") or (id starts with "chicken-")) or (id starts with "flag-"):
                        set session's pointer entity to id
                else if button = 1:
                    set session's pointer mode to 2
                else if button = 2:
                    set session's pointer mode to 3
            else if pressed = false:
                set owns to ((button = 0) and ((session's pointer mode = 1) or (session's pointer mode = 4))) or (((button = 1) and (session's pointer mode = 2)) or ((button = 2) and (session's pointer mode = 3)))
                if owns:
                    move website Farm gesture to cursor in state
                    release website Farm gesture in state cancelled false
            animate UI view view
        if (view's input kind = 1) and (session's pointer mode != 0):
            move website Farm gesture to cursor in state
            animate UI view view
    if (view's input kind = 3) and (view's input code = 258):
        set session's focused to false
        set session's held key to 0
    if session's focused:
        set direction to the website Farm direction for key (view's input code)
        if ((view's input kind = 3) or (view's input kind = 9)) and (direction >= 0):
            if view's input kind = 3:
                stop website Farm clock in state
                set session's held key to view's input code
                step website Farm player toward direction in state
                update website Farm world view in state instantly false
                start website Farm clock in state
            consume the UI key in view
        if (view's input kind = 6) and (view's input code = session's held key):
            set session's held key to 0
            stop website Farm clock in state
            start website Farm clock in state
        if (view's input kind = 3) and (view's input code = 256):
            cancel website Farm area drawing in state
            release website Farm gesture in state cancelled true
            consume the UI key in view
