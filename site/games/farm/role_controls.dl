import program_callbacks.dl

to get [follow website Farm role action] {string:destination} [in] {a pointer to website state:state}:
    set document to state's farm's document
    set actor to the website farm actor identified by (document's selected) in (document's world)
    set role to the website Farm viewed role in state
    set instance to state's view's instance
    set index to the website program for source "Farm source"
    if destination = "action:farm-apply":
        run website program index in state
        return true
    if destination = "action:farm-stop":
        stop website program index in state
        return true
    if destination = "action:farm-add-role":
        set name to the trimmed website farm name ((the UI value for (the control labeled "Farm role name" in instance) in instance)'s text)
        if name is empty:
            set the text of "Farm status" in instance to "Give the new role a name."
            return true
        stop website program index in state
        set role to a website farm role identified by (an unused website Farm role identity in document) named name containing ""
        append role to (document's roles)
        set the text of "Farm role name" in instance to ""
        show website Farm role (role's id) in state
        save website Farm progress in state
        return true
    if destination = "action:farm-copy-role":
        stop website program index in state
        set copy to a copy of website farm role role identified by (an unused website Farm role identity in document) among (document's roles)
        show website Farm role (copy's id) in state
        save website Farm progress in state
        return true
    if destination = "action:farm-delete-role":
        stop website program index in state
        set id to role's id
        for each worker in (document's world's workers):
            if worker's role = id:
                clear the website farm role of worker
        loop position from 0 to (the length of document's roles):
            if (the item at position in (document's roles)) = role:
                remove item position from (document's roles)
        free website farm role role
        set id to the string form of ""
        if (the length of document's roles) > 0:
            set id to (the item at 0 in (document's roles))'s id
        show website Farm role id in state
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-rename-worker":
        set name to the trimmed website farm name ((the UI value for (the control labeled "Farm worker name" in instance) in instance)'s text)
        if name is empty:
            set the text of "Farm status" in instance to "Give the worker a name."
        else:
            set actor's name to name
            update website Farm world view in state instantly false
        return true
    if destination = "action:farm-pause-worker":
        set actor's paused to actor's paused = false
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-step-worker":
        if the website Farm has pending saved roles in state:
            prepare website Farm saved roles in state
            return true
        step website farm worker actor in (document's world) using roles (document's roles)
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-idle":
        clear the website farm role of actor
        update website Farm world view in state instantly false
        return true
    if destination = "action:farm-select-player":
        stop website program index in state
        choose website Farm person (the string form of "player") in state
        return true
    return false
