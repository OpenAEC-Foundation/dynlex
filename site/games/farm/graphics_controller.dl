import session.dl

to [fail website Farm graphics] {string:detail} [in] {a pointer to website state:state}:
    set state's farm's graphics phase to 4
    set state's farm's graphics request to 0
    request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is detail]) for purpose 0 indexed 0 in state
    refresh website Farm controls in state

to [load website Farm graphics in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    require condition ((session's graphics phase = 0) or (session's graphics phase = 4)) reporting "Farm graphics are already loading or ready"
    set session's graphics phase to 1
    request "fetch" containing (a JSON object containing [JSON text "url" is "assets/games/farm/program.json"]) for purpose 21 indexed 0 in state
    set session's graphics request to state's requests' id
    refresh website Farm controls in state

to [receive website Farm graphics] {a pointer to JSON value:response} [for purpose] {integer:job} [in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    set session's graphics request to 0
    if job = 21:
        if (the JSON number named "status" in response) != 200.0:
            fail website Farm graphics (the string form of "The Farm scene program could not be fetched") in state
            return nothing
        parse (the JSON text named "text" in response) as JSON and set parsed to it
        if parsed failed:
            fail website Farm graphics (the string form of "The Farm scene program is invalid JSON") in state
            return nothing
        set session's graphics phase to 2
        request "graphics" containing (parsed's value) for purpose 22 indexed 0 in state
        set session's graphics request to state's requests' id
    else:
        set session's graphics resource to ((the JSON number named "resource" in response) as an integer) as a pointer
        set session's graphics phase to 3
        request a UI redraw in (state's view)
    refresh website Farm controls in state

to [paint the website Farm] {a pointer to UI canvas frame:painting}:
    set state to the website state in (painting's instance)
    set session to the address of (state's farm)
    if (session's renderer = (0 as a pointer to website Farm renderer)) and (session's graphics resource != (0 as a pointer)):
        set session's renderer to a website Farm renderer for (session's document's world) in (painting's bounds) using shader (session's graphics resource) in (state's view)
        set session's graphics resource to 0 as a pointer
        refresh website Farm controls in state
    set session's viewport to painting's bounds
    if session's renderer != (0 as a pointer to website Farm renderer):
        set width to the maximum of 1 and ((painting's bounds' width * state's view's pixel scale) as an integer)
        set height to the maximum of 1 and ((painting's bounds' height * state's view's pixel scale) as an integer)
        set texture to the rendered website Farm (session's renderer) sized width by height in (painting's bounds)
        draw UI texture texture in (painting's bounds) in (UI ink 255 255 255) with opacity 255 on (painting's frame)
        project website Farm names in state
    else:
        set text to "Preparing the Farm…" if (session's graphics phase != 4), else "An error occurred. Check the log."
        draw UI text text centered in (painting's bounds) with (state's view's small) in (UI ink 54 74 45) on (painting's frame)
