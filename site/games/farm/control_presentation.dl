import control_choices.dl
import annotations.dl
import scene_names.dl

to [refresh website Farm controls in] {a pointer to website state:state}:
    set session to the address of (state's farm)
    set document to session's document
    set world to document's world
    if session's renderer != (0 as a pointer to website Farm renderer):
        supply website Farm navigation (the website Farm navigation shown for document) in (session's renderer)
    if session's names != (0 as a pointer to UI floating controls):
        refresh website Farm names in state
    set actor to the website farm actor identified by (document's selected) in world
    set role to the website Farm viewed role in state
    set instance to state's view's instance
    refresh website Farm choices in state
    set the text of "Farm person name" in instance to (actor's name)
    set the text of "Farm person kind" in instance to ("FARMER · YOU" if actor's id = "player", else "WORKER")
    set status to actor's status
    if actor's paused:
        set status to "Paused. " + status
    set the text of "Farm person status" in instance to status
    set the text of "Farm hands" in instance to (the website Farm hands of actor)
    set the value of "Farm person controls" in instance to (1 if actor's id = "player", else 0)
    set the text of "Pause worker" in instance to ("Resume worker" if actor's paused, else "Pause worker")
    set code to false
    if role != (0 as a pointer to website farm role):
        set code to (role's source trimmed) is not empty
        set the text of "Farm code title" in instance to (role's name + ".dl")
        set caption to the string form of "WRITE YOUR CODE"
        if code:
            set caption to "UNAPPLIED EDITS" if role's prepared, else "READY TO ASSIGN"
            if role's source = role's applied:
                set count to 0
                for each worker in (world's workers):
                    if worker's role = role's id:
                        increment count
                set noun to "worker" if count = 1, else "workers"
                set caption to formatted "{count} {noun} using this code"
            if role's needs rebuilding:
                set caption to "UPDATING SAVED ROLE" if session's rebuilding and (session's pending role = role's id), else "SAVED ROLE NEEDS UPDATING"
        set the text of "Farm code state" in instance to caption
    else:
        set the text of "Farm code title" in instance to "Create a role to start"
        set the text of "Farm code state" in instance to "WRITE YOUR CODE"
    set program to state's programs + (the website program for source "Farm source")
    set busy to (program's phase = 1) or (program's phase = 2)
    set the "Stop reading the role" control in instance enabled busy
    set pending to the website Farm has pending saved roles in state
    set the value of "Farm preparation notices" in instance to (0 if pending, else -1)
    set retry to (pending and (busy = false)) and (session's rebuild failed or session's rebuild stopped)
    set the value of "Farm preparation retry" in instance to (0 if retry, else -1)
    set the "Retry saved roles" control in instance enabled retry
    set the "Give this role to Ada" control in instance enabled ((code and (busy = false)) and (actor's id != "player"))
    set the text of "Give this role to Ada" in instance to ((the string form of "Apply to everyone in this role") if (role != (0 as a pointer to website farm role)) and (actor's role = document's role id), else ("Give this role to " + actor's name))
    set the "Farm source" control in instance enabled (role != (0 as a pointer to website farm role))
    set the "Create role" control in instance enabled (session's rebuilding = false)
    set the "Copy role" control in instance enabled ((role != (0 as a pointer to website farm role)) and (session's rebuilding = false))
    set the "Delete role" control in instance enabled ((role != (0 as a pointer to website farm role)) and (session's rebuilding = false))
    set the "Remove role" control in instance enabled (actor's role is not empty)
    set ready to false
    if actor's role is not empty:
        set assigned to the website farm role identified by (actor's role) in (document's roles)
        set ready to (assigned's prepared and (pending = false)) and ((actor's held = false) and ((actor's routine's position) < (the length of assigned's program's code)))
    set {worker controls} to the control labeled "Farm worker controls" in instance
    set UI control (the UI element labeled "One instruction" in worker controls) enabled ready in instance
    set the text of "Start farm ▶" in instance to ("Pause farm Ⅱ" if session's playing, else "Start farm ▶")
    set the "Start farm ▶" control in instance enabled ((pending = false) or session's playing)
    set the "One turn" control in instance enabled (pending = false)
    set the value of "Farm speed" in instance to (document's speed - 1)
    set the text of "Farm turn" in instance to (formatted "TURN {world's tick}")
    set day to world's tick / 100 + 1
    set turns to (100 if world's raining, else 75) - world's tick % 100
    set the text of "Farm day" in instance to (formatted "DAY {day} · {turns} turns of rain" if world's raining, else formatted "DAY {day} · rain in {turns} turns")
    set the text of "Farm weather" in instance to ("RAINING" if world's raining, else "CLEAR SKIES")
    if (the length of world's notices) > 0:
        set the text of "Farm message" in instance to (the item at 0 in (world's notices))
    set stock to the string form of ""
    loop index from 0 to (the length of (the website farm items)):
        set item to the item at index in (the website farm items)
        if stock is not empty:
            set stock to stock + " · "
        set stock to stock + (formatted "{item's label} {the item at index in (world's stock)}")
    set the text of "Farm stock" in instance to stock
    set order to the current website farm order in world
    set first to the item at (order's first item) in (the website farm items)
    set second to the item at (order's second item) in (the website farm items)
    set the text of "Farm order title" in instance to (order's title)
    set the text of "Farm order items" in instance to (formatted "{first's label} {the item at (order's first item) in (world's stock)} / {order's first count}\n{second's label} {the item at (order's second item) in (world's stock)} / {order's second count}")
    set the text of "Farm order reward" in instance to (the website farm order reward in world)
    set the text of "Farm order count" in instance to (formatted "{world's orders} orders delivered")
    set the "Deliver order" control in instance enabled (website farm world world can deliver its order)
    set the "Add flag" control in instance enabled (session's flag color is not empty)
    set the "Remove flag" control in instance enabled (session's selected flag is not empty)
    for each label in ["Farm action", "Farm supply"]:
        set node to the control labeled label in instance
        set value to the UI value for node in instance
        set available to false
        if value's number >= 0:
            set available to (the UI option at (value's number) from node using value)'s enabled
        if label = "Farm action":
            set the "Do this" control in instance enabled available
        else:
            set the "Take supply" control in instance enabled available
    for each label in ["Reshape area", "Rename area", "Delete area"]:
        set the label control in instance enabled (session's selected area is not empty)
    set the "Cancel drawing" control in instance enabled (session's drawing != 0)
    set the "Retry Farm view" control in instance enabled (session's graphics phase = 4)
    set notice to -1
    if (session's graphics phase = 1) or (session's graphics phase = 2):
        set notice to 0
    if session's graphics phase = 4:
        set notice to 1
    set the value of "Farm view notices" in instance to notice
    set the "Whole farm" control in instance enabled (session's renderer != (0 as a pointer to website Farm renderer))
    set the "View selection" control in instance enabled (session's renderer != (0 as a pointer to website Farm renderer))
    set count to the minimum of 4 and (the website coding count of "watering" in (world's coding))
    set planted to the minimum of 4 and (the website coding count of "planting" in (world's coding))
    set eggs to the minimum of 6 and (the website coding count of "eggs" in (world's coding))
    set the text of "Farm goal progress" in instance to (formatted "Watering {count}/4 · Planting {planted}/4 · Eggs {eggs}/6")
    refresh website Farm annotations in state
