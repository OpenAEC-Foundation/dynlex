import ../documentation.dl
import ../editor/types.dl
import ../editor/appearance.dl

website page IDE page at "/ide/index.html" titled "DynLex Studio" described "Write, compile and run DynLex programs in the browser.":
    region "Studio" using IDE workspace appearance:
        paragraph "DYNLEX / STUDIO" using IDE signal appearance
        paragraph "Working ideas." using title appearance
        region "Studio tools" using IDE tools appearance:
            link "Run program ▶" to "action:run-ide" using primary link appearance
            link "Stop program ■" to "action:stop-ide" using IDE link appearance
            link "Save source ↓" to "action:save-source" using IDE link appearance
            link "Switch to light" to "action:toggle-ide-theme" using IDE link appearance
        view group "Studio appearance notice" using no UI appearance:
            paragraph "Studio appearance error" containing "An error occurred. Check the log." using IDE signal appearance
        region "Studio workspace" using columns appearance:
            tab group "IDE modes" using IDE tabs appearance:
                tab "Program":
                    source pane "IDE source" containing "import lib/std.dl\n\nprint line \"Hello from DynLex.\"" using IDE code appearance
                tab "Shader":
                    source pane "Shader source" containing the default website shader source using IDE code appearance
            region "Studio result" using IDE card appearance:
                view group "IDE result" using stack appearance:
                    region "Program result" using stack appearance:
                        paragraph "Output" using subheading appearance
                        paragraph "IDE output" containing "Run the program to see its output." using output appearance
                    region "Shader result" using stack appearance:
                        paragraph "Last successful build" using subheading appearance
                        surface "IDE shader preview" using IDE preview appearance
                        region "Preview playback" using cards appearance:
                            link "Pause preview" to "action:toggle-preview" using IDE link appearance
                            link "Reset time ↺" to "action:reset-preview" using IDE link appearance
                paragraph "IDE status" containing "Ready." using IDE signal appearance
                paragraph "Problems" using subheading appearance
                paragraph "IDE diagnostics" containing "The language service checks your code as you type." using output appearance
                paragraph "IDE analysis" containing "Language service waiting." using IDE signal appearance
                link "Read the language reference →" to "/wiki/index.html" using IDE link appearance
