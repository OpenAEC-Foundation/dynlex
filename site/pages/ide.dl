import ../documentation.dl

appearance IDE code appearance:
    use code appearance
    height is 560

website page IDE page at "/ide/index.html" titled "DynLex Studio" described "Write, compile and run DynLex programs in the browser.":
    region "Studio" using content appearance:
        paragraph "DYNLEX / STUDIO" using signal appearance
        paragraph "Working ideas." using title appearance
        region "Studio tools" using cards appearance:
            link "Run program ▶" to "action:run-ide" using primary link appearance
            link "Stop program ■" to "action:stop-ide" using link appearance
            link "Save main.dl ↓" to "action:save-source" using link appearance
        region "Studio workspace" using columns appearance:
            region "Studio editor" using document stack appearance:
                paragraph "main.dl" using signal appearance
                editor "IDE source" containing "import lib/std.dl\n\nprint line \"Hello from DynLex.\"" using IDE code appearance
            region "Studio result" using card appearance:
                paragraph "Output" using subheading appearance
                paragraph "IDE output" containing "Run the program to see its output." using output appearance
                paragraph "IDE status" containing "Ready." using signal appearance
                paragraph "Problems" using subheading appearance
                paragraph "IDE diagnostics" containing "The language service checks your code as you type." using output appearance
                paragraph "IDE analysis" containing "Language service waiting." using signal appearance
                link "Read the language reference →" to "/wiki/index.html" using link appearance
