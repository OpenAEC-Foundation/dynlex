                paragraph "Passage 11" using heading appearance:
                    link "Sections" to "/wiki/sections/index.html" using inline link appearance
                paragraph "Passage 12" using body appearance:
                    words "Learn the main DynLex section forms such as "
                    words "function" using inline code appearance
                    words ", "
                    words "while" using inline code appearance
                    words ", and "
                    words "if" using inline code appearance
                    words "."
            region "index block 13" using card appearance:
                paragraph "Passage 14" using heading appearance:
                    link "Terms" to "/wiki/terms.html" using inline link appearance
                paragraph "Passage 15" using body appearance:
                    words "Look up words such as "
