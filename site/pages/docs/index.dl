import ../../documentation.dl

website page documentation index page at "/wiki/index.html" titled "DynLex Wiki" described "DynLex is a programming language that lets you write code in clear words.":
    region "Documentation" using content appearance:
        paragraph "DynLex Wiki" using signal appearance
        paragraph "Learn DynLex" using title appearance
        paragraph "DynLex is a programming language that lets you write code in clear words." using body appearance
        paragraph "Start with the first guide, then move into the section pages and the terms page whenever you need a word explained." using body appearance
        region "index block 1" using card appearance:
            paragraph "TL;DR" using signal appearance
            paragraph "Passage 2" using body appearance:
                words "• Start with "
