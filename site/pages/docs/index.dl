                words " and "
                link "Sections" to "/wiki/sections/index.html" using inline link appearance
                words " as quick lookups."
        region "index block 5" using cards appearance:
            region "index block 6" using card appearance:
                paragraph "Passage 7" using heading appearance:
                    link "Core Rules" to "/wiki/core-rules.html" using inline link appearance
                paragraph "Read the short, practical rules first. Great for quick troubleshooting." using body appearance
            region "index block 8" using card appearance:
                paragraph "Passage 9" using heading appearance:
                    link "Getting Started" to "/wiki/getting-started.html" using inline link appearance
                paragraph "Write your first file, run it, and learn the smallest useful steps first." using body appearance
