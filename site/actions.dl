import navigation.dl
import shaders/hero.dl
import programs/controller.dl
import editor/language.dl
import games/river/controller.dl
import games/farm/controller.dl
import account/controller.dl

to follow website link {a pointer to UI instance:instance}:
    set state to the website state in instance
    set destination to (the UI value for (instance's event target) in instance)'s destination
    if destination = "action:toggle-ide-theme":
        toggle website editor theme in state
        return nothing
    if follow website account action destination in state:
        return nothing
    if destination = "action:resume-game":
        set destination to "action:" + (the JSON text named "lastGame" in (state's progress's document))
    if (destination = "action:river") or (destination = "action:challenge-gallery"):
        leave website Farm in state
    if destination = "action:farm":
        stop website river effects in state
        stop website program (the website program for source "River source") in state
    if follow website Farm action destination in state:
        return nothing
    if follow website river action destination in state:
        return nothing
    if destination = "action:next-shader":
        advance to the next website shader in state
        return nothing
    if destination = "action:toggle-preview":
        toggle the website shader preview in state
        return nothing
    if destination = "action:reset-preview":
        reset the website shader preview in state
        return nothing
    set descriptions to the website program descriptions
    set index to 0
    loop while index < the length of descriptions:
        set description to the item at index in descriptions
        if destination = description's run action:
            run website program index in state
            return nothing
        if destination = description's stop action:
            stop website program index in state
            return nothing
        increment index
    if destination = "action:save-source":
        set source to the website source text in state
        set name to the website source filename in state
        request "download" containing (a JSON object containing [JSON text "name" is name, JSON text "type" is "text/plain;charset=utf-8", JSON text "content" is source]) for purpose 0 indexed 0 in state
        return nothing
    if destination = "action:open-example":
        select website editor mode 0 in state
        set parent to the parent of (instance's event target) within (instance's description)
        load website source "IDE source" from (the string form of (parent's content)) in state
        navigate to (the string form of "/ide/index.html") in state
        return nothing
    if (destination has "action:download" at offset 0) or (destination = "action:retry-downloads"):
        follow website download destination in state
        return nothing
    if destination has "action:" at offset 0:
        if destination = "action:copy-example":
            set parent to the parent of (instance's event target) within (instance's description)
            set source to the string form of (parent's content)
            @intrinsic("call pointer", state's view's driver's copy, nothing, state's view, the data of source, source's length)
            return nothing
        require condition false reporting "This website action has not been registered"
    navigate to destination in state

to notice website editor mode {a pointer to UI instance:instance}:
    set state to the website state in instance
    set selected to the value of "IDE modes" in instance
    select website editor mode selected in state
    if selected = 1:
        if state's shader editor's preview's resource = (0 as a pointer):
            run website program 2 in state
        else:
            toggle the website shader preview in state

to bind website links in {UI reference:node} for {a pointer to UI instance:instance}:
    if node's kind = 43:
        bind node in instance to (the function named "follow website link $") for event 0
    set index to 0
    loop while index < node's count:
        bind website links in (the UI child at index in node) for instance
        increment index
