# Shared IDE links are data; decoding and execution policy live in DynLex.
import ../programs/controller.dl
import lib/base64.dl
import lib/unicode.dl

to get the website query text named {C string:name} in {a pointer to JSON value:query}:
    if query has JSON member named name:
        return the JSON text named name in query
    return the string form of ""

to get {string:name} is a website source filename:
    if (name's length < 4) or ((name has ".dl" at offset (name's length - 3)) = false):
        return false
    set index to 0
    loop while index < name's length:
        set character to (the character at index in name) as an integer
        set letter to ((65 <= character <= 90) or (97 <= character <= 122)) or (48 <= character <= 57)
        if letter = false:
            if (index = 0) or (((character != 46) and (character != 45)) and (character != 95)):
                return false
        increment index
    return true

to reject website source link in {a pointer to website state:state}:
    set the text of "IDE status" in (state's view's instance) to "An error occurred. Check the log."
    request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is "The IDE source link has an invalid mode, scene, filename or source encoding."]) for purpose 0 indexed 0 in state

to apply website editor entry {a pointer to JSON value:query} in {a pointer to website state:state}:
    set signature to a JSON object containing [
        JSON text "code64" is (the website query text named "code64" in query),
        JSON text "code" is (the website query text named "code" in query),
        JSON text "name" is (the website query text named "name" in query),
        JSON text "autorun" is (the website query text named "autorun" in query),
        JSON text "mode" is (the website query text named "mode" in query),
        JSON text "scene" is (the website query text named "scene" in query)
    ]
    set key to the compact JSON form of signature
    free signature
    if key = state's editor entry:
        return nothing
    set state's editor entry to key
    set requested to the website query text named "mode" in query
    if ((requested != "") and (requested != "program")) and (requested != "shader"):
        reject website source link in state
        return nothing
    set mode to 1 if (requested = "shader"), else 0
    set scene to the website query text named "scene" in query
    if scene's length > 0:
        if mode != 1:
            reject website source link in state
            return nothing
        set descriptions to the site's shaders
        set index to 0
        loop while index < the length of descriptions:
            set description to the item at index in descriptions
            if description's id = scene:
                select website editor mode 1 in state
                set state's shader editor's description to description
                load the website shader source in state
                return nothing
            increment index
        reject website source link in state
        return nothing
    set name to the website query text named "name" in query
    if name's length = 0:
        set name to "shader.dl" if (mode = 1), else "main.dl"
    if (name is a website source filename) = false:
        reject website source link in state
        return nothing
    set encoded to the website query text named "code64" in query
    set source to the website query text named "code" in query
    if encoded's length > 0:
        set decoded to the Base64 URL decoding of encoded
        if decoded's success = false:
            reject website source link in state
            return nothing
        if decoded's value is invalid UTF-8:
            reject website source link in state
            return nothing
        set source to decoded's value
    set instance to state's view's instance
    select website editor mode mode in state
    set state's shader editor's description to the custom website shader
    set state's shader editor's source failed to false
    if mode = 1:
        configure the website shader source named name in state
    else:
        configure the website source editor "IDE source" named name prefixed by "" using UI CPU analysis in state
    if (source's length > 0) or (encoded's length > 0):
        load website source ((the website source editor in state)'s node's text) from source in state
    else if mode = 1:
        load website source "Shader source" from (the string form of (the default website shader source)) in state
    set the text of "IDE status" in instance to "Ready."
    if mode = 0:
        set the text of "IDE output" in instance to "Run the program to see its output."
    set the text of "IDE analysis" in instance to "Analyzing…"
    set autorun to the website query text named "autorun" in query
    if (mode = 1) or ((autorun = "1") or (autorun = "true")):
        run website program 2 in state
