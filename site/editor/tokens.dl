# The compiler supplies token classes; this theme supplies their colors.
import ../state.dl
import ../packages/dynlex-ui/ui/text_colors.dl
import lib/unicode.dl

to get the website token ink for {string:name}:
    if name = "comment":
        return UI ink 149 161 152
    if (name = "string") or (name = "number"):
        return UI ink 230 196 124
    if (name = "keyword") or (name = "section"):
        return UI ink 204 167 236
    if (name = "type") or (name = "patternDefinition"):
        return UI ink 104 211 190
    if name = "variable":
        return UI ink 159 199 245
    return UI ink 245 245 244

to apply website semantic tokens {a pointer to JSON value:tokens} in {a pointer to website state:state}:
    set language to the address of (state's language)
    set instance to state's view's instance
    set node to the website source editor in state
    if (the UI value for node in instance)'s text != language's snapshot:
        return nothing
    if language's uri != (the website source URI in state):
        return nothing
    if language's profile != (the website analysis profile in state):
        return nothing
    color UI text (language's snapshot) in node in instance
    scan lines in (language's snapshot) and set scanned to it
    require condition (scanned succeeded) reporting "The editor source is not valid UTF-8"
    set lines to the line index of scanned
    set data to the JSON member named "data" in tokens
    require condition ((data's length mod 5) = 0) reporting "A semantic token response is incomplete"
    set index, row and column to 0
    loop while index < data's length:
        set delta to ((the JSON value at index index in data)'s number) as an integer
        if delta > 0:
            set column to 0
        set row to row + delta
        set column to column + (((the JSON value at index (index + 1) in data)'s number) as an integer)
        set length to ((the JSON value at index (index + 2) in data)'s number) as an integer
        set kind to ((the JSON value at index (index + 3) in data)'s number) as an integer
        set start to the start of line row in lines
        set end to the content end of line row in lines
        require condition ((start succeeded) and (end succeeded)) reporting "A semantic token is outside its source"
        set text to the substring of (language's snapshot) from (start's position) spanning (end's position - start's position) bytes
        set first to the UTF-8 byte offset of UTF-16 position column in text
        set last to the UTF-8 byte offset of UTF-16 position (column + length) in text
        require condition ((first succeeded) and (last succeeded)) reporting "A semantic token splits a Unicode character"
        set name to (the JSON value at index kind in (language's token types))'s text
        add UI text color (the website token ink for name) from (start's position + first's position) to (start's position + last's position) in node in instance
        set index to index + 5
    free lines
