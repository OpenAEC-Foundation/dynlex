import ../state.dl
import configuration.dl
import ../shaders/program.dl
import ../shaders/rendering.dl
import ../packages/dynlex-ui/ui/texture_shapes.dl
import ../programs/events.dl

to load the website shader source in {a pointer to website state:state}:
    set editor to the address of (state's shader editor)
    require condition (editor's source request = 0) reporting "The shader source is already loading"
    set editor's source failed to false
    set instance to state's view's instance
    load website source "Shader source" from "" in state
    configure the website shader source named ((the string form of (editor's description's id)) + ".dl") in state
    set the text of "IDE status" in instance to "Loading shader source…"
    set path to "assets/shaders/" + ((the string form of (editor's description's id)) + ".dl")
    request "fetch" containing (a JSON object containing [JSON text "url" is path]) for purpose 9 indexed 0 in state
    set editor's source request to state's requests' id

to fail the website shader source in {a pointer to website state:state}:
    set state's shader editor's source request to 0
    set state's shader editor's source failed to true
    set the text of "IDE status" in (state's view's instance) to "An error occurred. Check the log."
    set the text of "Run program ▶" in (state's view's instance) to "Retry source load ↻"

to get receive website shader source {a pointer to JSON value:response} in {a pointer to website state:state}:
    set state's shader editor's source request to 0
    if (the JSON number named "status" in response) != 200.0:
        fail the website shader source in state
        request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is "The requested shader source could not be loaded."]) for purpose 0 indexed 0 in state
        return false
    load website source "Shader source" from (the JSON text named "text" in response) in state
    set the text of "Run program ▶" in (state's view's instance) to "Recompile shader ↻"
    return true

to receive website shader compilation {a pointer to JSON value:response} in {a pointer to website state:state}:
    set editor to the address of (state's shader editor)
    require condition (editor's pending program = @intrinsic("construct", a pointer to JSON value)) reporting "A shader program is already being linked"
    set linked to the linkage of (editor's description) using (the JSON member named "stages" in response) stored as "source"
    if linked failed:
        set the text of "IDE status" in (state's view's instance) to "Shader linking failed. Check the log."
        request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is (linked's error)]) for purpose 0 indexed 0 in state
        set (state's programs + 2)'s phase to 0
        notify website program 2 with result 2 in state
        return nothing
    set editor's pending program to linked's program
    set passes to the JSON member named "passes" in (editor's pending program)
    set index to 0
    loop while index < passes's length:
        set uniforms to the JSON member named "uniforms" in (the JSON value at index index in passes)
        set cursor to 0
        loop while cursor < uniforms's length:
            set name to the JSON text named "name" in (the JSON value at index cursor in uniforms)
            if ((name != "time") and (name != "width")) and ((name != "height") and (name != "render_pass")):
                set the text of "IDE status" in (state's view's instance) to "The shader uses an unsupported preview input."
                request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is ("The shader preview has no value provider for " + name)]) for purpose 0 indexed 0 in state
                free editor's pending program
                set editor's pending program to @intrinsic("construct", a pointer to JSON value)
                set (state's programs + 2)'s phase to 0
                notify website program 2 with result 2 in state
                return nothing
            increment cursor
        increment index
    set program to state's programs + 2
    set program's phase to 2
    request "graphics" with JSON data (the compact JSON form of (editor's pending program)) for purpose 10 indexed 2 in state
    set program's request to state's requests' id

to receive the website shader preview {a pointer to JSON value:response} in {a pointer to website state:state}:
    set editor to the address of (state's shader editor)
    set rendering to the address of (editor's preview)
    require condition (editor's pending program != @intrinsic("construct", a pointer to JSON value)) reporting "A shader preview has no linked description"
    if rendering's resource != (0 as a pointer):
        close UI shader (rendering's resource) in (state's view)
    if rendering's program != @intrinsic("construct", a pointer to JSON value):
        free rendering's program
    set rendering's resource to ((the JSON number named "resource" in response) as an integer) as a pointer
    set rendering's program to editor's pending program
    set editor's pending program to @intrinsic("construct", a pointer to JSON value)
    set rendering's geometry to editor's description's geometry
    initialize loaded website shader data in rendering using (state's view)
    set rendering's seconds to 0.0
    set rendering's active to false
    set rendering's mesh width to 0
    set rendering's texture to a new UI texture
    set program to state's programs + 2
    set program's phase to (0 if (rendering's paused), else 3)
    set program's request to 0
    set the text of "IDE status" in (state's view's instance) to (formatted "Shader compiled in {program's compile milliseconds} ms")
    set caption to "Resume preview" if (rendering's paused), else "Pause preview"
    set the text of "Pause preview" in (state's view's instance) to caption
    notify website program 2 with result 1 in state
    request a UI redraw in (state's view)

to toggle the website shader preview in {a pointer to website state:state}:
    set rendering to the address of (state's shader editor's preview)
    if rendering's resource = (0 as a pointer):
        set the text of "IDE status" in (state's view's instance) to "Compile the shader to start its preview."
        return nothing
    set rendering's paused to (rendering's paused = false)
    set rendering's active to false
    set program to state's programs + 2
    if (program's phase = 0) or (program's phase = 3):
        set program's phase to (0 if (rendering's paused), else 3)
    set caption to "Resume preview" if (rendering's paused), else "Pause preview"
    set the text of "Pause preview" in (state's view's instance) to caption
    request a UI redraw in (state's view)

to reset the website shader preview in {a pointer to website state:state}:
    set state's shader editor's preview's seconds to 0.0
    set state's shader editor's preview's active to false
    request a UI redraw in (state's view)

to paint the website shader preview {a pointer to UI canvas frame:painting}:
    set state to the website state in (painting's instance)
    set rendering to the address of (state's shader editor's preview)
    if rendering's resource = (0 as a pointer):
        return nothing
    set width to the maximum of 1 and ((painting's bounds' width * state's view's pixel scale) as an integer)
    set height to the maximum of 1 and ((painting's bounds' height * state's view's pixel scale) as an integer)
    set layout to the UI layout labeled "IDE shader preview" in (state's view's layout)
    draw UI texture (the rendered website shader rendering sized width by height in (state's view)) in (painting's bounds) rounded by (layout's appearance's radius) in (UI ink 255 255 255) on (painting's frame)

to advance the website shader preview in {a pointer to website state:state}:
    set view to state's view
    set visible to false
    if (state's route = "/ide/index.html") and (the website editor uses shaders in state):
        set canvas to the UI layout labeled "IDE shader preview" in (view's layout)
        set visible to ((canvas's painted bounds' y + canvas's painted bounds' height) > 0.0) and (canvas's painted bounds' y < view's height)
    advance website shader (the address of (state's shader editor's preview)) visible visible in view
