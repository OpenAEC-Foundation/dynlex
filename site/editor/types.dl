import lib/sections.dl
import lib/json.dl
import ../shaders/types.dl

import ../packages/dynlex-ui/ui/source_tools.dl

class:
    patterns:
        website shader editor
    members:
        description as live shader
        source request as an integer
        source failed as a boolean
        preview as website shader view
        pending program as a pointer to JSON value

the default website shader source means: "import lib/shader_art.dl\n\nset red to 0.5 + 0.5 * (the sine of (the shader time))\nset green to the fragment y coordinate / (the shader height)\nset blue to the fragment x coordinate / (the shader width)\nset the fragment color with a red channel of red, a green channel of green, a blue channel of blue and an alpha channel of 1.0\n"

the custom website shader means: @intrinsic("construct", live shader, "custom", "Custom shader", "shader.dl", 11, full screen)
