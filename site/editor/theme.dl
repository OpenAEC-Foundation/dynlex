# Theme choice is application data; colors and editor behavior are shared UI.
import ../state.dl
import colors.dl

to apply website appearance for {string:path} in {a pointer to website state:state}:
    set view to state's view
    set colors to the website colors for (state's editor light)
    use UI palette colors in (view's instance)
    set view's theme to the UI theme for (view's instance's description)
    set view's theme's background to UI ink 250 250 249
    if path = "/ide/index.html":
        set view's theme's dark to state's editor light = false
        set view's theme's background to UI palette color "Studio background" in colors
        set view's theme's surface and view's theme's button ink to UI palette color "Studio surface" in colors
        set view's theme's text to UI palette color "Studio text" in colors
        set view's theme's muted to UI palette color "Studio muted" in colors
        set view's theme's outline to UI palette color "Studio border" in colors
        set view's theme's accent to UI palette color "Studio accent" in colors
    set the text of "Switch to light" in (view's instance) to ("Switch to dark" if state's editor light, else "Switch to light")
    request a UI redraw in view

to report website appearance failure {string:detail} in {a pointer to website state:state}:
    set the value of "Studio appearance notice" in (state's view's instance) to 0
    request "log" containing (a JSON object containing [JSON text "level" is "error", JSON text "message" is ("Studio appearance: " + detail)]) for purpose 0 indexed 0 in state

to get call website appearance storage with {a pointer to JSON value:payload} in {a pointer to website state:state}:
    set operation to the JSON text named "action" in payload
    set json to the compact JSON form of payload
    free payload
    set result to a UI call named "storage" containing json through (state's services) in (state's view)
    if result's success = false:
        report website appearance failure (("Could not " + operation + " the stored editor theme. ") + result's contents) in state
        return 0 as a pointer to JSON value
    parse (result's contents) as JSON and set parsed to it
    require condition (parsed succeeded) reporting "An immediate platform provider returned invalid JSON"
    return parsed's value

to open website appearance in {a pointer to website state:state}:
    apply website appearance for (state's route) in state
    set result to call website appearance storage with (a JSON object containing [JSON text "action" is "get", JSON text "key" is "dynlex-web-theme"]) in state
    if result = (0 as a pointer to JSON value):
        return nothing
    set saved to the JSON member named "value" in result
    if saved is not JSON null:
        if saved's kind != the JSON text kind:
            free result
            report website appearance failure (the string form of "The stored editor theme is not text") in state
            return nothing
        if (saved's text != "light") and (saved's text != "dark"):
            free result
            report website appearance failure (the string form of "The stored editor theme must be light or dark") in state
            return nothing
        set state's editor light to saved's text = "light"
    free result
    set the value of "Studio appearance notice" in (state's view's instance) to -1
    apply website appearance for (state's route) in state

to toggle website editor theme in {a pointer to website state:state}:
    set state's editor light to state's editor light = false
    apply website appearance for (state's route) in state
    set chosen to "light" if state's editor light, else "dark"
    set result to call website appearance storage with (a JSON object containing [JSON text "action" is "set", JSON text "key" is "dynlex-web-theme", JSON text "value" is chosen]) in state
    if result != (0 as a pointer to JSON value):
        free result
        set the value of "Studio appearance notice" in (state's view's instance) to -1

to present website source colors in {a pointer to website state:state}:
    if (state's route = "/ide/index.html") and (state's editor light):
        present UI source workspace (state's language) using (the light UI source token theme)
    else:
        present UI source workspace (state's language) using (the default UI source token theme)
