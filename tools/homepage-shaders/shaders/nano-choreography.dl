# DynLex entrypoint flags: --emit-spirv --shader-stage=fragment

import lib/shader_art.dl

# NANO CHOREOGRAPHY
# A raymarched crystal and motorcycle give way to a model-derived volumetric
# Vitruvian point cloud. Both passes are compiled from this DynLex source.

class:
    patterns:
        motorcycle motion
    members:
        progress, spin, yaw

class:
    patterns:
        spatial bound
    members:
        center, radius

class:
    patterns:
        ray traversal
    members:
        depth, end, step, active

class:
    patterns:
        surface result
    members:
        hit, position, glow

function [a|] planar coordinate:
    replacement:
        a point

function [a|] spatial coordinate:
    replacement:
        a point

function [a|] radiant color:
    replacement:
        a color

function a planar coordinate with x {float:x} and y {float:y}:
    replacement:
        @intrinsic(
            "construct",
            a point,
            @intrinsic("construct", an aggregate of 2 float values, x, y)
        )

function a spatial coordinate with x {float:x}, y {float:y} and z {float:z}:
    replacement:
        @intrinsic(
            "construct",
            a point,
            @intrinsic("construct", an aggregate of 3 float values, x, y, z)
        )

function a radiant color with red {float:red}, green {float:green} and blue {float:blue}:
    replacement:
        @intrinsic(
            "construct",
            a color,
            @intrinsic("construct", an aggregate of 3 float values, red, green, blue)
        )

function a motorcycle motion at {float:progress} with spin {float:spin} and yaw {float:yaw}:
    replacement:
        @intrinsic("construct", motorcycle motion, progress, spin, yaw)

function a spatial bound centered at {spatial coordinate:center} with radius {float:radius}:
    replacement:
        @intrinsic("construct", spatial bound, center, radius)

function a ray traversal from {float:depth} to {float:end}:
    replacement:
        @intrinsic("construct", ray traversal, depth, end, 0, true)

function an empty surface result at {spatial coordinate:position}:
    replacement:
        @intrinsic("construct", surface result, false, position, 0.0)

function {ray traversal:traversal} continues:
    execute:
        return traversal's active

function {surface result:surface} was hit:
    execute:
        return surface's hit

function the scene window from {float:opening} to {float:closing} at {float:moment}:
    execute:
        set arrival to the smooth transition from opening to (opening + 0.55) at moment
        set departure to 1.0 - the smooth transition from (closing - 0.55) to closing at moment
        return arrival * departure

function the crystal distance at {spatial coordinate:position} rotated by {float:yaw} and {float:pitch}:
    execute:
        set sine to the sine of yaw
        set cosine to the cosine of yaw
        set turned to a spatial coordinate with x ((position's x * cosine) + (position's z * sine)), y position's y and z ((position's z * cosine) - (position's x * sine))
        set sine to the sine of pitch
        set cosine to the cosine of pitch
        set vertical to (turned's y * cosine) - (turned's z * sine)
        set the z coordinate of turned to (turned's z * cosine) + (turned's y * sine)
        set the y coordinate of turned to vertical
        set octahedron to ((((the absolute value of (turned's x)) + (the absolute value of (turned's y))) + (the absolute value of (turned's z))) - 1.08) * 0.577
        set core to the ellipsoid distance from (a point with x turned's x, y turned's y and z turned's z) with radii (the dimensions measuring 0.82 by 1.14 by 0.82)
        return the maximum of octahedron and core

function the motorcycle distance at {spatial coordinate:position} with {motorcycle motion:motion}:
    execute:
        # Translation through depth makes the motorcycle race toward the lens.
        set center to a spatial coordinate with x ((0.0 - 1.26) + (motion's progress * 1.18)), y ((0.0 - 0.19) + (motion's progress * 0.12)) and z (2.80 - (motion's progress * 4.90))
        set translated to a spatial coordinate with x (position's x - center's x), y (position's y - center's y) and z (position's z - center's z)
        set sine to the sine of (motion's yaw)
        set cosine to the cosine of (motion's yaw)
        set local to a spatial coordinate with x ((translated's x * cosine) + (translated's z * sine)), y translated's y and z ((translated's z * cosine) - (translated's x * sine))

        # Deep tires, hubs, and rotating crossed spokes establish real volume.
        set depth to 0.13
        set back to a spatial coordinate with x (local's x + 0.72), y (local's y + 0.42) and z local's z
        set front to a spatial coordinate with x (local's x - 0.72), y (local's y + 0.42) and z local's z
        set sample to a point with x (local's x), y (local's y) and z (local's z)
        set aft to a point with x (back's x), y (back's y) and z (back's z)
        set fore to a point with x (front's x), y (front's y) and z (front's z)
        set dimensions to the dimensions measuring 0.095 by 0.095 by depth
        set distance to the minimum of (the torus distance from aft with major radius 0.30 and tube radius 0.055) and (the torus distance from fore with major radius 0.30 and tube radius 0.055)
        set distance to the minimum of distance and (the ellipsoid distance from aft with radii dimensions)
        set distance to the minimum of distance and (the ellipsoid distance from fore with radii dimensions)

        set spoke to a planar coordinate with x ((the cosine of (motion's spin)) * 0.265) and y ((the sine of (motion's spin)) * 0.265)
        set crossing to a planar coordinate with x spoke's y and y spoke's x
        set distance to the minimum of distance and (the distance from aft to capsule from (a point with x (0.0 - spoke's x), y (0.0 - spoke's y) and z 0.0) to (a point with x spoke's x, y spoke's y and z 0.0) with radius 0.018)
        set distance to the minimum of distance and (the distance from aft to capsule from (a point with x (0.0 - spoke's y), y spoke's x and z 0.0) to (a point with x spoke's y, y (0.0 - spoke's x) and z 0.0) with radius 0.018)
        set distance to the minimum of distance and (the distance from fore to capsule from (a point with x (0.0 - crossing's x), y (0.0 - crossing's y) and z 0.0) to (a point with x crossing's x, y crossing's y and z 0.0) with radius 0.018)
        set distance to the minimum of distance and (the distance from fore to capsule from (a point with x (0.0 - crossing's y), y crossing's x and z 0.0) to (a point with x crossing's y, y (0.0 - crossing's x) and z 0.0) with radius 0.018)

        # Twin-cradle frame, fork, tank, engine, saddle, and handlebars.
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.72, y -0.42 and z 0.0) to (a point with x -0.18, y 0.08 and z 0.0) with radius 0.045)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.18, y 0.08 and z 0.0) to (a point with x 0.72, y -0.42 and z 0.0) with radius 0.045)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.72, y -0.42 and z 0.0) to (a point with x -0.34, y -0.42 and z 0.0) with radius 0.045)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.34, y -0.42 and z 0.0) to (a point with x -0.18, y 0.08 and z 0.0) with radius 0.045)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.55, y -0.28 and z -0.07) to (a point with x 0.77, y 0.28 and z -0.07) with radius 0.032)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.55, y -0.28 and z 0.07) to (a point with x 0.77, y 0.28 and z 0.07) with radius 0.032)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.75, y 0.28 and z -0.28) to (a point with x 0.75, y 0.28 and z 0.28) with radius 0.028)
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x + 0.08), y (local's y - 0.03) and z local's z) with radii (the dimensions measuring 0.34 by 0.22 by 0.25))
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x - 0.02), y (local's y + 0.22) and z local's z) with radii (the dimensions measuring 0.34 by 0.18 by 0.22))
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x + 0.40), y (local's y - 0.24) and z local's z) with radii (the dimensions measuring 0.31 by 0.075 by 0.22))
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x - 0.78), y (local's y - 0.08) and z local's z) with radii (the dimensions measuring 0.085 by 0.085 by 0.105))

        # A sculpted rider leans into the acceleration instead of floating above it.
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x + 0.10), y (local's y - 0.78) and z local's z) with radii (the dimensions measuring 0.15 by 0.17 by 0.15))
        set distance to the minimum of distance and (the ellipsoid distance from (a point with x (local's x + 0.18), y (local's y - 0.48) and z local's z) with radii (the dimensions measuring 0.24 by 0.35 by 0.18))
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.02, y 0.59 and z -0.11) to (a point with x 0.37, y 0.30 and z -0.15) with radius 0.075)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.02, y 0.59 and z 0.11) to (a point with x 0.37, y 0.30 and z 0.15) with radius 0.075)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.37, y 0.30 and z -0.15) to (a point with x 0.73, y 0.27 and z -0.22) with radius 0.055)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x 0.37, y 0.30 and z 0.15) to (a point with x 0.73, y 0.27 and z 0.22) with radius 0.055)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.14, y 0.24 and z -0.10) to (a point with x -0.40, y -0.18 and z -0.13) with radius 0.095)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.14, y 0.24 and z 0.10) to (a point with x -0.40, y -0.18 and z 0.13) with radius 0.095)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.40, y -0.18 and z -0.13) to (a point with x -0.62, y -0.34 and z -0.10) with radius 0.075)
        set distance to the minimum of distance and (the distance from sample to capsule from (a point with x -0.40, y -0.18 and z 0.13) to (a point with x -0.62, y -0.34 and z 0.10) with radius 0.075)
        return distance

if this is a vertex shader:
    # Each volumetric point is expanded to one tiny triangle in the source data.
    set point to a spatial coordinate with x the vertex x, y the vertex y and z the vertex z
    set encoding to the vertex w
    set group to the floor of (encoding / 3.0)
    set corner to encoding - (group * 3.0)
    set time to the shader time
    set frame to a planar coordinate with x (the maximum of (the shader width) and 1.0) and y (the maximum of (the shader height) and 1.0)
    set pass to the shader render pass
    set aspect to frame's x / frame's y
    set moment to (the fractional part of (time / 11.0)) * 11.0
    set visibility to the scene window from 7.18 to 11.0 at moment
    set wave to the smooth transition from -1.12 to 1.08 at (point's y + ((the sine of ((point's x * 11.0) + (time * 1.7))) * 0.08))
    set visibility to visibility * wave
    set yaw to (the sine of (time * 0.31)) * 0.34
    set sine to the sine of yaw
    set cosine to the cosine of yaw
    set turned to a spatial coordinate with x ((point's x * cosine) + (point's z * sine)), y point's y and z ((point's z * cosine) - (point's x * sine))
    set depth to 3.25 + (turned's z * 0.52)
    set size to ((1.04 + (group * 0.018)) / (frame's x)) * (0.96 + (pass * 0.04))
    set scale to 1.66 / (the maximum of aspect and 1.0)
    set offset to (the smooth transition from 1.0 to 1.52 at aspect) * 0.40
    set triangle to a planar coordinate with x (0.0 - size) and y (0.0 - size)
    if corner >= 1.0:
        set the x coordinate of triangle to size
    if corner >= 2.0:
        set the x coordinate of triangle to 0.0
        set the y coordinate of triangle to size * 1.45
    set clip to a planar coordinate with x (((turned's x * scale) + (offset * depth)) + (triangle's x * depth)) and y (((point's y * 1.86) - 0.04) + (triangle's y * depth))
    if visibility < 0.001:
        set the x coordinate of clip to depth * 3.0
    set the output position with x clip's x, y clip's y, z (depth * 0.42) and w depth
else:
    set pixel to a planar coordinate with x the fragment x coordinate and y the fragment y coordinate
    set time to the shader time
    set frame to a planar coordinate with x (the maximum of (the shader width) and 1.0) and y (the maximum of (the shader height) and 1.0)
    set pass to the shader render pass
    set aspect to frame's x / frame's y
    set screen to a planar coordinate with x (((pixel's x / (frame's x)) * 2.0 - 1.0) * aspect) and y ((pixel's y / (frame's y)) * 2.0 - 1.0)
    set radial to the square root of ((screen's x * screen's x) + (screen's y * screen's y))
    set moment to (the fractional part of (time / 11.0)) * 11.0

    if pass > 0.5:
        set wave to ((the sine of (((screen's x * 19.0) - (screen's y * 13.0)) + (time * 4.2))) * 0.5) + 0.5
        set scan to ((the sine of ((screen's y * 47.0) - (time * 6.8))) * 0.5) + 0.5
        set color to a radiant color with red (0.035 + (wave * 0.14)), green (0.14 + (scan * 0.12)) and blue (0.34 + (wave * 0.20))
        set the fragment color with red color's red, green color's green, blue color's blue and alpha 1.0
    else:
        set camera to a spatial coordinate with x 0.0, y 0.02 and z -4.2
        set ray to a spatial coordinate with x screen's x, y screen's y and z 1.72
        set length to the square root of (((ray's x * ray's x) + (ray's y * ray's y)) + (ray's z * ray's z))
        set the x coordinate of ray to ray's x / length
        set the y coordinate of ray to ray's y / length
        set the z coordinate of ray to ray's z / length

        set crystal to the scene window from 0.0 to 3.65 at moment
        set motorcycle to the scene window from 3.35 to 7.55 at moment
        set vitruvian to the scene window from 7.18 to 11.0 at moment
        set progress to the smooth transition from 3.25 to 7.35 at moment
        set motion to a motorcycle motion at progress with spin (time * 9.4) and yaw ((0.0 - 1.18) + (progress * 0.08))

        # Continuous fields become a deep chamber and high-speed particle wake.
        set chamber to the flowing field at (a point with x ((screen's x * 2.2) + (time * 0.021)) and y ((screen's y * 2.2) - (time * 0.014))) during 1.9
        set ridges to the ridged field at (a point with x ((screen's x * 4.1) - (time * 0.017)) and y ((screen's y * 4.1) + (time * 0.011))) during 5.4
        set drones to the spark field at (a point with x ((screen's x * 27.0) + (time * 0.24)) and y ((screen's y * 27.0) - (time * 0.13))) during 9.7
        set particles to the spark field at (a point with x ((screen's x * 7.0) + (time * 8.4)) and y (screen's y * 46.0)) during 14.2
        set core to the glow from 0.0 to 0.66 at (the absolute value of (screen's y))
        set trails to (particles * core) * motorcycle
        set color to a radiant color with red ((((0.003 + (chamber * 0.012)) + (ridges * 0.018)) + (drones * 0.18)) + (trails * 0.32)), green ((((0.006 + (chamber * 0.024)) + (ridges * 0.015)) + (drones * 0.46)) + (trails * 0.78)) and blue ((((0.024 + (chamber * 0.082)) + (ridges * 0.071)) + (drones * 1.02)) + (trails * 1.46))

        set bound to a spatial bound centered at (a spatial coordinate with x 0.0, y 0.0 and z 0.82) with radius 1.24
        if moment >= 3.5 and moment < 7.4:
            set bound's center to a spatial coordinate with x ((0.0 - 1.26) + (progress * 1.18)), y ((0.0 - 0.19) + (progress * 0.12)) and z (2.80 - (progress * 4.90))
            set bound's radius to 1.36
        set center to a spatial coordinate with x (bound's center's x - camera's x), y (bound's center's y - camera's y) and z (bound's center's z - camera's z)
        set depth to ((center's x * ray's x) + (center's y * ray's y)) + (center's z * ray's z)
        set nearest to a spatial coordinate with x (camera's x + (ray's x * depth)), y (camera's y + (ray's y * depth)) and z (camera's z + (ray's z * depth))
        set miss to a spatial coordinate with x (nearest's x - bound's center's x), y (nearest's y - bound's center's y) and z (nearest's z - bound's center's z)
        set separation to ((miss's x * miss's x) + (miss's y * miss's y)) + (miss's z * miss's z)
        set radius to bound's radius * bound's radius
        set traversal to a ray traversal from 0.08 to 0.08
        if (moment >= 7.4 or depth <= 0.0) or separation >= radius:
            set traversal's active to false
        else:
            set span to the square root of (radius - separation)
            set traversal's depth to the maximum of (depth - span) and 0.08
            set traversal's end to depth + span
        set surface to an empty surface result at camera

        while traversal's step < 44 and traversal continues:
            set sample to a spatial coordinate with x (camera's x + (ray's x * traversal's depth)), y (camera's y + (ray's y * traversal's depth)) and z (camera's z + (ray's z * traversal's depth))
            set distance to 12.0
            if moment < 3.5:
                set yaw to time * 0.72
                set pitch to (the sine of (time * 0.47)) * 0.52
                set location to a spatial coordinate with x sample's x, y sample's y and z (sample's z - 0.82)
                set distance to the crystal distance at location rotated by yaw and pitch
            else:
                set distance to the motorcycle distance at sample with motion
            set magnitude to the absolute value of distance
            set proximity to the glow from 0.012 to 0.115 at magnitude
            set fade to 1.0 - the smooth transition from (traversal's end - 0.35) to traversal's end at traversal's depth
            set surface's glow to surface's glow + ((proximity * fade) * 0.0035)
            if magnitude < 0.009:
                set surface's hit to true
                set surface's position to sample
                set traversal's active to false
            else:
                set traversal's depth to traversal's depth + (the maximum of (magnitude * 0.64) and 0.014)
                if traversal's depth > traversal's end:
                    set traversal's active to false
            increment traversal's step

        set light to 0.0
        if surface was hit:
            set drones to the nano drone field at (a point with x (surface's position's x), y (surface's position's y) and z (surface's position's z)) with phase (time * 1.7)
            set pulse to ((the sine of ((surface's position's z * 13.0) - (time * 4.2))) * 0.5) + 0.5
            set scan to the glow from 0.0 to 0.045 at (the absolute value of ((the fractional part of ((surface's position's y * 2.7) - (time * 0.31))) - 0.5))
            set light to (drones * (1.82 + (pulse * 1.06))) + (scan * 0.02)

        set crystal to (light + (surface's glow * 1.8)) * crystal
        set motorcycle to (light + (surface's glow * 2.1)) * motorcycle
        set hue to ((surface's position's x * 5.3) + (surface's position's y * 3.7)) + (surface's position's z * 4.1)
        subtract time * 0.7 from hue
        set hue to ((the sine of hue) * 0.5) + 0.5
        set the red channel of color to (color's red + (crystal * 0.36)) + (motorcycle * (0.72 + (hue * 0.96)))
        set the green channel of color to (color's green + (crystal * 0.78)) + (motorcycle * (0.92 - (hue * 0.58)))
        set the blue channel of color to (color's blue + (crystal * 1.46)) + (motorcycle * (1.18 - (hue * 0.28)))
        set aura to the glow from 0.28 to 1.26 at radial
        set the red channel of color to color's red + ((aura * vitruvian) * 0.018)
        set the green channel of color to color's green + ((aura * vitruvian) * 0.052)
        set the blue channel of color to color's blue + ((aura * vitruvian) * 0.12)
        set vignette to 0.18 + ((1.0 - the smooth transition from 0.52 to 1.62 at radial) * 0.82)
        set the red channel of color to the square root of ((color's red * vignette) / (1.0 + color's red))
        set the green channel of color to the square root of ((color's green * vignette) / (1.0 + color's green))
        set the blue channel of color to the square root of ((color's blue * vignette) / (1.0 + color's blue))
        set the fragment color with red color's red, green color's green, blue color's blue and alpha 1.0
