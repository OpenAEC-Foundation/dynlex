import lib/state_machine.dl

state machine publication:
    initial state: draft
    state draft:
        on "submit": review
    state review:
        on "approve": published
        on "reject": draft
    state published:
        on "withdraw": draft

set first to an instance of publication
set second to an instance of publication
print first's current's name as a line
send "submit" to the address of first
print first's current's name as a line
send "approve" to the address of first
print first's current's name as a line
print second's current's name as a line
send "withdraw" to the address of first
print first's current's name as a line
