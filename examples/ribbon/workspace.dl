# Application chrome uses window coordinates; slide artwork scales independently.
import examples/ribbon/slide.dl

class:
    patterns:
        ribbon demo state
    members:
        view as a pointer to native UI view

to paint the ribbon workspace on {a pointer to UI canvas frame:canvas}:
    set state to canvas's instance's state as a pointer to ribbon demo state
    set view to state's view
    set frame to canvas's frame
    set ink to UI ink 47 51 59
    set muted to UI ink 107 113 122
    set orange to UI ink 184 65 38
    set width to canvas's bounds' width
    set height to canvas's bounds' height
    set strip to the UI layout labeled "Main ribbon" in (view's layout)
    set top to (strip's bounds' y + strip's bounds' height) + 14.0
    draw a rounded UI box (UI box at 20 14 sized 30 30) with radius 6.0 in orange on frame
    draw UI text "P" at 30 35 with (view's strong) in (UI ink 255 255 255) on frame
    draw UI text "Quarterly story" at 64 26 with (view's strong) in ink on frame
    draw UI text "Saved to this device" at 64 44 with (view's small) in muted on frame
    draw a flat UI box (UI box at 0 top sized 210 ((height - top) - 30.0)) in (UI ink 250 250 251) on frame
    draw a flat UI box (UI box at 209 top sized 1 ((height - top) - 30.0)) in (UI ink 224 227 232) on frame
    draw UI text "Slides" at 22 (top + 28.0) with (view's strong) in ink on frame
    set spacing to the minimum of 138.0 and (((height - top) - 80.0) / 3.0)
    set scale to the minimum of 1.0 and ((spacing - 18.0) / 94.0)
    set index to 0
    loop while index < 3:
        save the model transform in frame
        move the model in frame by x 0.0, y ((top + 54.0) + ((index as a floating-point number) * spacing)) and z 0.0
        scale the model in frame by x scale, y scale and z 1.0
        set border to UI ink 224 227 232
        if index = 0:
            set border to orange
        draw UI text (the string form of (index + 1)) at 10 14 with (view's small) in muted on frame
        draw a rounded UI box (UI box at 30 0 sized 160 94) with radius 4.0 in border on frame
        draw a flat UI box (UI box at 33 3 sized 154 88) in (UI ink 255 255 255) on frame
        draw a flat UI box (UI box at 45 21 sized 62 5) in (UI ink 71 76 83) on frame
        draw a flat UI box (UI box at 45 33 sized 46 3) in (UI ink 184 190 197) on frame
        if index = 0:
            draw a rounded UI box (UI box at 129 20 sized 40 53) with radius 20.0 in (UI ink 204 108 70) on frame
        else if index = 1:
            draw a flat UI box (UI box at 45 50 sized 30 21) in (UI ink 225 233 228) on frame
            draw a flat UI box (UI box at 82 50 sized 30 21) in (UI ink 246 219 204) on frame
            draw a flat UI box (UI box at 119 50 sized 30 21) in (UI ink 225 233 241) on frame
        else:
            draw a flat UI box (UI box at 105 56 sized 14 17) in (UI ink 225 233 228) on frame
            draw a flat UI box (UI box at 126 44 sized 14 29) in (UI ink 204 108 70) on frame
            draw a flat UI box (UI box at 147 30 sized 14 43) in (UI ink 72 99 116) on frame
        restore the model transform in frame
        increment index
    set stage to UI box at 230 (top + 4.0) sized (width - 230.0) ((height - top) - 56.0)
    draw a flat UI box stage in (UI ink 237 239 242) on frame
    set area to UI box at (stage's x + 60.0) (stage's y + 22.0) sized (stage's width - 122.0) (stage's height - 42.0)
    set scale to the minimum of (area's width / 928.0) and (area's height / 464.0)
    set paper to UI box at (area's x + ((area's width - (928.0 * scale)) / 2.0)) (area's y + ((area's height - (464.0 * scale)) / 2.0)) sized (928.0 * scale) (464.0 * scale)
    draw a UI shadow under paper with radius 0.0 softness 8.0 strength 18 in (UI ink 57 66 81) on frame
    draw a flat UI box paper in (UI ink 255 255 255) on frame
    save the model transform in frame
    move the model in frame by x (paper's x), y (paper's y) and z 0.0
    scale the model in frame by x scale, y scale and z 1.0
    paint the example slide using view on frame
    restore the model transform in frame
    draw UI text "Click to add notes" at 242 (height - 35.0) with (view's small) in muted on frame
    draw a flat UI box (UI box at 0 (height - 22.0) sized width 1) in (UI ink 223 226 231) on frame
    draw UI text "Slide 1 of 3" at 18 (height - 5.0) with (view's small) in muted on frame
    draw UI text "English (United States)" at 123 (height - 5.0) with (view's small) in muted on frame
    draw a flat UI box (UI box at (width - 189.0) (height - 11.0) sized 102 2) in (UI ink 190 196 204) on frame
    draw a UI disc at (a UI point at (width - 131.0) and (height - 10.0)) with radius 4.0 from muted to muted opacity 255 on frame
    draw UI text "100%" at (width - 66.0) (height - 5.0) with (view's small) in muted on frame
