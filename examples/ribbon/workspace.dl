# The slide and application chrome are an illustration; the ribbon is real UI.
import lib/ui_native.dl

class:
    patterns:
        ribbon demo state
    members:
        view as a pointer to native UI view

to paint the ribbon workspace on {a pointer to UI canvas frame:canvas}:
    set state to canvas's instance's state as a pointer to ribbon demo state
    set view to state's view
    set frame to canvas's frame
    set ink to UI ink 47 51 59
    set muted to UI ink 107 113 122
    set orange to UI ink 184 65 38
    draw a rounded UI box (UI box at 20 14 sized 30 30) with radius 6.0 in orange on frame
    draw UI text "P" at 30 35 with (view's strong) in (UI ink 255 255 255) on frame
    draw UI text "Quarterly story" at 64 26 with (view's strong) in ink on frame
    draw UI text "Saved to this device" at 64 44 with (view's small) in muted on frame
    draw UI icon "save" in (UI box at 225 20 sized 19 19) in muted on frame
    draw UI icon "undo" in (UI box at 263 20 sized 19 19) in muted on frame
    draw UI icon "redo" in (UI box at 301 20 sized 19 19) in muted on frame
    draw a rounded UI box (UI box at 456 13 sized 332 32) with radius 6.0 in (UI ink 232 234 238) on frame
    draw UI icon "search" in (UI box at 469 22 sized 15 15) in muted on frame
    draw UI text "Search commands, tools, and more" at 495 34 with (view's small) in muted on frame
    draw a rounded UI box (UI box at 1000 14 sized 106 30) with radius 5.0 in (UI ink 255 255 255) on frame
    draw UI icon "play" in (UI box at 1011 22 sized 15 15) in ink on frame
    draw UI text "Present" at 1035 34 with (view's small) in ink on frame
    draw a rounded UI box (UI box at 1116 14 sized 92 30) with radius 5.0 in orange on frame
    draw UI icon "share" in (UI box at 1127 21 sized 16 16) in (UI ink 255 255 255) on frame
    draw UI text "Share" at 1153 34 with (view's small) in (UI ink 255 255 255) on frame
    draw a UI disc at (a UI point at 1240.0 and 29.0) with radius 15.0 from (UI ink 224 230 240) to (UI ink 224 230 240) opacity 255 on frame
    draw UI text "JD" at 1233 34 with (view's small) in (UI ink 67 84 111) on frame
    draw a flat UI box (UI box at 0 238 sized 210 532) in (UI ink 250 250 251) on frame
    draw a flat UI box (UI box at 209 238 sized 1 532) in (UI ink 224 227 232) on frame
    draw UI text "Slides" at 22 266 with (view's strong) in ink on frame
    set index to 0
    loop while index < 3:
        set top to (index * 138) + 292
        set border to UI ink 224 227 232
        if index = 0:
            set border to orange
        draw UI text (the string form of (index + 1)) at 10 (top + 14) with (view's small) in muted on frame
        draw a rounded UI box (UI box at 30 top sized 160 94) with radius 4.0 in border on frame
        draw a flat UI box (UI box at 33 (top + 3) sized 154 88) in (UI ink 255 255 255) on frame
        draw a flat UI box (UI box at 45 (top + 21) sized 62 5) in (UI ink 71 76 83) on frame
        draw a flat UI box (UI box at 45 (top + 33) sized 46 3) in (UI ink 184 190 197) on frame
        if index = 0:
            draw a rounded UI box (UI box at 129 (top + 20) sized 40 53) with radius 20.0 in (UI ink 204 108 70) on frame
        else if index = 1:
            draw a flat UI box (UI box at 45 (top + 50) sized 30 21) in (UI ink 225 233 228) on frame
            draw a flat UI box (UI box at 82 (top + 50) sized 30 21) in (UI ink 246 219 204) on frame
            draw a flat UI box (UI box at 119 (top + 50) sized 30 21) in (UI ink 225 233 241) on frame
        else:
            draw a flat UI box (UI box at 105 (top + 56) sized 14 17) in (UI ink 225 233 228) on frame
            draw a flat UI box (UI box at 126 (top + 44) sized 14 29) in (UI ink 204 108 70) on frame
            draw a flat UI box (UI box at 147 (top + 30) sized 14 43) in (UI ink 72 99 116) on frame
        increment index
    draw a flat UI box (UI box at 230 242 sized 1050 506) in (UI ink 237 239 242) on frame
    set paper to UI box at 290 264 sized 928 464
    draw a UI shadow under paper with radius 0.0 softness 8.0 strength 18 in (UI ink 57 66 81) on frame
    draw a flat UI box paper in (UI ink 255 255 255) on frame
    draw UI text "STUDIO / QUARTERLY UPDATE" at 338 320 with (view's small) in orange on frame
    draw UI text "A brighter way" at 334 410 with (view's display) in ink on frame
    draw UI text "forward." at 334 467 with (view's display) in ink on frame
    draw UI text "Good ideas. Clear direction. Lasting impact." at 338 515 with (view's typeface) in muted on frame
    draw a flat UI box (UI box at 338 550 sized 54 3) in orange on frame
    draw UI text "NOVEMBER 2026" at 338 679 with (view's small) in muted on frame
    draw a rounded UI box (UI box at 866 342 sized 120 252) with radius 60.0 in (UI ink 220 231 225) on frame
    draw a rounded UI box (UI box at 1003 394 sized 120 252) with radius 60.0 in (UI ink 246 218 201) on frame
    draw a UI disc at (a UI point at 1063.0 and 402.0) with radius 60.0 from (UI ink 205 109 71) to (UI ink 205 109 71) opacity 255 on frame
    draw a flat UI box (UI box at 866 604 sized 120 42) in (UI ink 65 91 108) on frame
    draw UI text "01 / OUR NEXT CHAPTER" at 866 679 with (view's small) in muted on frame
    draw UI text "Click to add notes" at 242 765 with (view's small) in muted on frame
    draw a flat UI box (UI box at 0 778 sized 1280 1) in (UI ink 223 226 231) on frame
    draw UI text "Slide 1 of 3" at 18 795 with (view's small) in muted on frame
    draw UI text "English (United States)" at 123 795 with (view's small) in muted on frame
    draw UI icon "layout" in (UI box at 1002 783 sized 14 14) in orange on frame
    draw UI icon "grid" in (UI box at 1035 783 sized 14 14) in muted on frame
    draw a flat UI box (UI box at 1091 789 sized 102 2) in (UI ink 190 196 204) on frame
    draw a UI disc at (a UI point at 1149.0 and 790.0) with radius 4.0 from muted to muted opacity 255 on frame
    draw UI text "100%" at 1214 795 with (view's small) in muted on frame
