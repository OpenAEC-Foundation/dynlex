import lib/ui_ribbon.dl
import lib/ui_resizing.dl

window ribbon studio:
    canvas "Editor" at 0 0 sized 1280 by 800
    icon command "Save presentation" with icon "save" at 218 14 sized 32 by 30
    icon command "Undo" with icon "undo" at 256 14 sized 32 by 30
    icon command "Redo" with icon "redo" at 294 14 sized 32 by 30
    search command "Search" at 360 13 sized 428
    command "Present" with icon "play" at 1000 14 sized 106 by 30
    accent command "Share" with icon "share" at 1116 14 sized 92 by 30
    profile command "JD" at 1225 14
    icon command "Normal view" with icon "layout" at 997 779 sized 24 by 21
    icon command "Slide sorter" with icon "grid" at 1030 779 sized 24 by 21
    ribbon "Main ribbon" at 12 56 sized 1256 by 168:
        tab "File":
            ribbon group "Presentation":
                large tool "New" with icon "slide"
                large tool "Open" with icon "layout"
                large tool "Save" with icon "save"
                large tool "Export" with icon "share"
            ribbon group "Share":
                tool column:
                    tool "Share presentation" with icon "share"
                    tool "Copy link" with icon "link"
                    tool "Version history" with icon "clock"
        tab "Home":
            ribbon group "Clipboard":
                large menu "Paste" with icon "paste":
                    menu item "Paste"
                    menu item "Keep source formatting"
                    menu item "Use destination theme"
                    menu item "Paste as picture"
                tool column:
                    tool "Cut" with icon "cut"
                    tool "Copy" with icon "copy"
                    tool "Format painter" with icon "brush"
            ribbon group "Slides":
                large menu "New slide" with icon "slide":
                    menu item "Title slide"
                    menu item "Title and content"
                    menu item "Two content"
                    menu item "Blank"
                tool column:
                    tool menu "Layout" with icon "layout":
                        menu item "Title slide"
                        menu item "Title and content"
                        menu item "Section header"
                        menu item "Two content"
                        menu item "Comparison"
                        menu item "Blank"
                    tool "Reset" with icon "reset"
                    tool menu "Section" with icon "grid":
                        menu item "Add section"
                        menu item "Rename section"
                        menu item "Remove section"
            ribbon group "Font":
                tool column:
                    tool row:
                        tool field "Aptos (Body)" sized 142:
                            menu item "Aptos (Body)"
                            menu item "Aptos Display"
                            menu item "Arial"
                            menu item "Calibri"
                            menu item "Georgia"
                            menu item "Noto Sans"
                        tool field "20" sized 48:
                            menu item "8"
                            menu item "10"
                            menu item "12"
                            menu item "14"
                            menu item "16"
                            menu item "18"
                            menu item "20"
                            menu item "24"
                            menu item "28"
                            menu item "32"
                            menu item "36"
                            menu item "48"
                            menu item "72"
                    tool row:
                        icon tool "Bold" with icon "bold"
                        icon tool "Italic" with icon "italic"
                        icon tool "Underline" with icon "underline"
                        icon tool "Font color" with icon "colors"
                        icon tool "Text highlight" with icon "brush"
            ribbon group "Paragraph":
                tool column:
                    tool row:
                        icon tool "Align left" with icon "align-left"
                        icon tool "Align center" with icon "align-center"
                        icon tool "Bullets" with icon "list"
                    tool menu "Line spacing" with icon "list":
                        menu item "1.0"
                        menu item "1.15"
                        menu item "1.5"
                        menu item "2.0"
                        menu item "Line spacing options"
                    tool menu "Text direction" with icon "text":
                        menu item "Horizontal"
                        menu item "Rotate all text 90°"
                        menu item "Rotate all text 270°"
            ribbon group "Drawing":
                large menu "Shapes" with icon "shapes":
                    menu item "Rectangle"
                    menu item "Rounded rectangle"
                    menu item "Ellipse"
                    menu item "Triangle"
                    menu item "Arrow"
                    menu item "Line"
                large menu "Arrange" with icon "layout":
                    menu item "Bring to front"
                    menu item "Send to back"
                    menu item "Align left"
                    menu item "Align center"
                    menu item "Group"
                    menu item "Ungroup"
            ribbon group "Editing":
                tool column:
                    tool "Find" with icon "find"
                    tool "Replace" with icon "replace"
                    tool menu "Select" with icon "eye":
                        menu item "Select all"
                        menu item "Selection pane"
        tab "Insert":
            ribbon group "Slides":
                large menu "New slide" with icon "slide":
                    menu item "Title slide"
                    menu item "Title and content"
                    menu item "Two content"
                    menu item "Blank"
            ribbon group "Tables":
                large menu "Table" with icon "table":
                    menu item "2 × 2 table"
                    menu item "3 × 3 table"
                    menu item "4 × 4 table"
                    menu item "Insert table"
            ribbon group "Images":
                large menu "Pictures" with icon "picture":
                    menu item "This device"
                    menu item "Stock images"
                    menu item "Online pictures"
                large menu "Screenshot" with icon "layout":
                    menu item "Available windows"
                    menu item "Screen clipping"
            ribbon group "Illustrations":
                large menu "Shapes" with icon "shapes":
                    menu item "Rectangle"
                    menu item "Rounded rectangle"
                    menu item "Ellipse"
                    menu item "Triangle"
                    menu item "Arrow"
                    menu item "Line"
                large menu "Icons" with icon "star":
                    menu item "Arrows"
                    menu item "Business"
                    menu item "Communication"
                    menu item "Nature"
                large menu "Chart" with icon "chart":
                    menu item "Column"
                    menu item "Line"
                    menu item "Pie"
                    menu item "Bar"
                    menu item "Area"
            ribbon group "Text":
                large tool "Text box" with icon "text"
                tool column:
                    tool "Header & footer" with icon "layout"
                    tool "Slide number" with icon "slide"
            ribbon group "Media":
                large menu "Video" with icon "video":
                    menu item "This device"
                    menu item "Online video"
                large menu "Audio" with icon "audio":
                    menu item "Audio on this device"
                    menu item "Record audio"
            ribbon group "Links":
                large menu "Link" with icon "link":
                    menu item "Insert link"
                    menu item "Recent links"
                large tool "Comment" with icon "comment"
        tab "Design":
            ribbon group "Themes":
                theme preview "Office" in "orange"
                theme preview "Facet" in "green"
                theme preview "Integral" in "blue"
                theme preview "Ion" in "purple"
                theme preview "Retrospect" in "gold"
            ribbon group "Variants":
                large menu "Colors" with icon "colors":
                    menu item "Office"
                    menu item "Blue green"
                    menu item "Warm tones"
                    menu item "Grayscale"
                large menu "Fonts" with icon "text":
                    menu item "Aptos"
                    menu item "Arial"
                    menu item "Calibri"
                    menu item "Georgia"
                large menu "Effects" with icon "star":
                    menu item "Office"
                    menu item "Subtle shadows"
                    menu item "Soft edges"
            ribbon group "Customize":
                large menu "Slide size" with icon "layout":
                    menu item "Widescreen (16:9)"
                    menu item "Standard (4:3)"
                    menu item "Custom slide size"
                large menu "Background" with icon "background":
                    menu item "Solid fill"
                    menu item "Gradient fill"
                    menu item "Picture fill"
                large tool "Designer" with icon "theme"
        tab "Transitions":
            ribbon group "Preview":
                large tool "Preview" with icon "play"
            ribbon group "Transition to this slide":
                large tool "None" with icon "slide"
                large tool "Morph" with icon "shapes"
                large tool "Fade" with icon "transition"
                large tool "Push" with icon "chevron"
                large tool "Wipe" with icon "layout"
                large tool "Split" with icon "grid"
            ribbon group "Timing":
                tool column:
                    tool "Sound: none" with icon "audio"
                    tool "Duration: 02.00" with icon "clock"
                    tool "Apply to all" with icon "check"
            ribbon group "Advance slide":
                tool column:
                    tool "On mouse click" with icon "check"
                    tool "After: 00:00" with icon "clock"
        tab "Animations":
            ribbon group "Preview":
                large tool "Preview" with icon "play"
            ribbon group "Animation":
                large tool "Appear" with icon "star"
                large tool "Fade" with icon "transition"
                large tool "Fly in" with icon "chevron"
                large tool "Float in" with icon "shapes"
                large menu "Zoom" with icon "zoom":
                    menu item "50%"
                    menu item "75%"
                    menu item "100%"
                    menu item "150%"
                    menu item "200%"
                    menu item "Fit to window"
            ribbon group "Advanced animation":
                large tool "Add animation" with icon "star"
                tool column:
                    tool "Animation pane" with icon "list"
                    tool "Trigger" with icon "play"
                    tool "Animation painter" with icon "brush"
            ribbon group "Timing":
                tool column:
                    tool "Start: on click" with icon "play"
                    tool "Duration: 00.50" with icon "clock"
                    tool "Delay: 00.00" with icon "clock"
        tab "Slide Show":
            ribbon group "Start slide show":
                large tool "From beginning" with icon "play"
                large tool "Current slide" with icon "slide"
                large menu "Custom show" with icon "layout":
                    menu item "All slides"
                    menu item "Create custom show"
            ribbon group "Set up":
                large tool "Set up show" with icon "layout"
                large tool "Hide slide" with icon "eye"
                large tool "Rehearse" with icon "clock"
                large tool "Record" with icon "video"
            ribbon group "Monitors":
                tool column:
                    tool "Presenter view" with icon "check"
                    tool "Monitor: automatic" with icon "layout"
        tab "Review":
            ribbon group "Proofing":
                large tool "Spelling" with icon "check"
                large tool "Thesaurus" with icon "text"
            ribbon group "Accessibility":
                large tool "Check access" with icon "eye"
            ribbon group "Language":
                large tool "Translate" with icon "text"
                large menu "Language" with icon "colors":
                    menu item "English (United States)"
                    menu item "English (United Kingdom)"
                    menu item "Dutch"
            ribbon group "Comments":
                large tool "New comment" with icon "comment"
                tool column:
                    tool "Show comments" with icon "comment"
                    tool "Previous" with icon "undo"
                    tool "Next" with icon "redo"
        tab "View":
            ribbon group "Presentation views":
                large tool "Normal" with icon "layout"
                large tool "Outline" with icon "list"
                large tool "Slide sorter" with icon "grid"
                large tool "Reading view" with icon "eye"
            ribbon group "Master views":
                large tool "Slide master" with icon "slide"
                large tool "Notes master" with icon "text"
            ribbon group "Show":
                tool column:
                    tool "Ruler" with icon "ruler"
                    tool "Gridlines" with icon "grid"
                    tool "Guides" with icon "layout"
            ribbon group "Zoom":
                large menu "Zoom" with icon "zoom":
                    menu item "50%"
                    menu item "75%"
                    menu item "100%"
                    menu item "150%"
                    menu item "200%"
                    menu item "Fit to window"
                large tool "Fit to window" with icon "layout"
    style:
        the interface uses an "office" theme
        the interface adapts from 1280 by 800 pixels
        the window is at least 960 by 600 pixels
        pin "Editor" to all edges
        pin "Main ribbon" to the left and right
        pin "Search" to the left and right
        pin "Present" to the top right
        pin "Share" to the top right
        pin "JD" to the top right
        pin "Normal view" to the bottom right
        pin "Slide sorter" to the bottom right
    code:
        set the value of "Main ribbon" in this window to 1
