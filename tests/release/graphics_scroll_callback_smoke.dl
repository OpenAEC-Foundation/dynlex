import lib/graphics.dl

exposed function first scroll callback for {pointer:window} at horizontal offset {floating-point number:x} and vertical offset {floating-point number:y}:
    execute:
        ignore window
        ignore x
        ignore y

exposed function second scroll callback for {pointer:window} at horizontal offset {floating-point number:x} and vertical offset {floating-point number:y}:
    execute:
        ignore window
        ignore x
        ignore y

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
    return 1

register the graphics scroll callback named "first scroll callback for $ at horizontal offset $ and vertical offset $" for window
register the graphics scroll callback named "first scroll callback for $ at horizontal offset $ and vertical offset $" for window
register the graphics scroll callback named "second scroll callback for $ at horizontal offset $ and vertical offset $" for window
close the window
return 0
