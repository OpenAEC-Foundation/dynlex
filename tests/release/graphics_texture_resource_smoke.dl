import lib/graphics.dl

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
    return 1

set texture to a graphics texture loaded from PPM file at "tests/release/texture_comments_crlf.ppm" for window
if texture is loaded = false:
    close window
    return 1
if (texture's width != 3) or (texture's height != 2):
    release texture
    close window
    return 1

set frame to a new graphics frame in window
use screen coordinates in frame
draw texture from x 16, y 16 to x 112, y 48 in color red 255, green 255 and blue 255 in frame
display frame

release texture
if texture is loaded:
    close window
    return 1
release texture
close window
return 0
