import lib/graphics.dl

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
    return 1

set sentinel to 0
@intrinsic("call", "GL", "glGenTextures", nothing, 1, the address of sentinel)
@intrinsic("call", "GL", "glBindTexture", nothing, 3553, sentinel)
@intrinsic("call", "GL", "glPixelStorei", nothing, 3317, 8)
set enabled_before to @intrinsic("call", "GL", "glIsEnabled", an integer, 3553)

set texture to a loaded graphics texture from PPM file at "tests/release/texture_comments_crlf.ppm"
if texture's handle = 0:
    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
    close the window
    return 1
if (texture's width != 3) or (texture's height != 2):
    release texture
    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
    close the window
    return 1

set current to 0
set alignment to 0
set enabled_after to 0
@intrinsic("call", "GL", "glGetIntegerv", nothing, 32873, the address of current)
@intrinsic("call", "GL", "glGetIntegerv", nothing, 3317, the address of alignment)
set enabled_after to @intrinsic("call", "GL", "glIsEnabled", an integer, 3553)
if (current != sentinel) or ((alignment != 8) or (enabled_after != enabled_before)):
    release texture
    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
    close the window
    return 1

clear the screen
bind texture
@intrinsic("call", "GL", "glBegin", nothing, 7)
@intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 0.0)
@intrinsic("call", "GL", "glVertex2i", nothing, 16, 16)
@intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 0.0)
@intrinsic("call", "GL", "glVertex2i", nothing, 112, 16)
@intrinsic("call", "GL", "glTexCoord2d", nothing, 1.0, 1.0)
@intrinsic("call", "GL", "glVertex2i", nothing, 112, 48)
@intrinsic("call", "GL", "glTexCoord2d", nothing, 0.0, 1.0)
@intrinsic("call", "GL", "glVertex2i", nothing, 16, 48)
@intrinsic("call", "GL", "glEnd", nothing)
@intrinsic("call", "GL", "glPixelStorei", nothing, 3333, 1)
set pixels to @intrinsic("call", "libc", "calloc", a pointer to a byte, 18 as a word sized integer, 1 as a word sized integer)
if pixels = 0 as a pointer to a byte:
    release texture
    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
    close the window
    return 1
@intrinsic("call", "GL", "glGetTexImage", nothing, 3553, 0, 6407, 5121, pixels)
set index to 0
set valid to true
while index < 18:
    if the item at index in pixels != 65 + index:
        set valid to false
    increment index
@intrinsic("call", "libc", "free", nothing, pixels)
@intrinsic("call", "GL", "glPixelStorei", nothing, 3333, 4)
set before to @intrinsic("call", "GL", "glGetError", an integer)
release texture
if texture is loaded:
    @intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
    close the window
    return 1
release texture
set after to @intrinsic("call", "GL", "glGetError", an integer)
@intrinsic("call", "GL", "glDeleteTextures", nothing, 1, the address of sentinel)
close the window

if (before != 0) or ((after != 0) or (valid = false)):
    return 1
return 0
