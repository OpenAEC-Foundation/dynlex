import lib/graphics.dl
import lib/font.dl

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
    return 1

set typeface to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 32
@intrinsic("call", "GL", "glBindTexture", nothing, 3553, typeface's texture)
set horizontal_wrap to 0
set vertical_wrap to 0
@intrinsic("call", "GL", "glGetTexParameteriv", nothing, 3553, 10242, the address of horizontal_wrap)
@intrinsic("call", "GL", "glGetTexParameteriv", nothing, 3553, 10243, the address of vertical_wrap)
clear the screen
draw "A A" as text at x 16 and y 48 using typeface in color red 255, green 255 and blue 255
set error to @intrinsic("call", "GL", "glGetError", an integer)

set bytes to ((128 * 64) * 3) as a word sized integer
set pixels to @intrinsic(
    "call", "libc", "calloc", a pointer to a byte, bytes, 1 as a word sized integer
)
@intrinsic("call", "GL", "glReadPixels", nothing, 0, 0, 128, 64, 6407, 5121, pixels)
set lit to 0
set position to 0
loop while position < bytes:
    if the item at position in pixels != 0:
        increment lit
    increment position
@intrinsic("call", "libc", "free", nothing, pixels)
close the window

if ((error != 0) or (lit <= 10)) or ((horizontal_wrap != 33069) or (vertical_wrap != 33069)):
    return 1
return 0
