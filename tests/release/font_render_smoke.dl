import lib/graphics.dl
import lib/font.dl

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
    return 1

set typeface to a font loaded from "tests/games/fonts/LiberationMono-Regular.ttf" at size 32 for window
if typeface's texture is loaded = false:
    release typeface
    close window
    return 1

set frame to a new graphics frame in window
use screen coordinates in frame
draw "A A" as text at x 16 and y 48 using typeface in color red 255, green 255 and blue 255 in frame
display frame

release typeface
close window
return 0
