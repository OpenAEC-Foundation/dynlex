import lib/graphics.dl

set window to a new hidden window with width 128 and height 64
if window = 0 as a pointer to a byte:
	return 1

set visible to @intrinsic("call", "glfw", "glfwGetWindowAttrib", an integer, window, the GLFW visible window hint)
set failed to visible != 0
close the window

if failed:
	return 1
return 0
