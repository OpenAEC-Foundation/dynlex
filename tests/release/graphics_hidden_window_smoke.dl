import lib/graphics.dl

set hidden to a new hidden window with width 128 and height 64
if hidden = 0 as a pointer to a byte:
	return 1

set failed to hidden is visible
set version to the Vulkan API version of hidden
set device to the graphics device name of hidden
set portability to Vulkan portability is enabled for hidden
ignore portability
if version <= 0:
	set failed to true
if the length of device <= 0:
	set failed to true
close hidden

set window to a new window with width 128 and height 64
if window = 0 as a pointer to a byte:
	return 1

if window is visible = false:
	set failed to true
close window

if failed:
	return 1
return 0
