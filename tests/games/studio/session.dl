import tests/games/three_dimensional.dl
import lib/ui_geometry.dl

class:
    patterns:
        spatial session
    members:
        camera as spatial camera
        origin as spatial camera
        view as a pointer
        painter as a pointer
        background as UI paint
        paused as a boolean
        elapsed as a floating-point number
        minimum altitude as a floating-point number

to get a new spatial study from {spatial camera:camera}:
    set result to a new spatial session
    set result's camera and result's origin to camera
    set result's background to UI ink 20 26 36
    return result

to restart {a pointer to spatial session:session}:
    set session's camera to session's origin
    set session's elapsed to 0.0

to move {a pointer to spatial session:session} forward {floating-point number:longitudinal} sideways {floating-point number:lateral} vertically {floating-point number:climb} turning {floating-point number:rotation} after {floating-point number:elapsed time} seconds:
    if session's paused:
        return nothing
    set delta to the minimum of 0.1 and elapsed time
    add delta to session's elapsed
    set camera to the address of (session's camera)
    set radians to camera's yaw * 0.017453292519943295
    set speed to camera's movement * delta * 60.0
    set x to ((the cosine of radians) * lateral) - ((the sine of radians) * longitudinal)
    set z to (-(the sine of radians) * lateral) - ((the cosine of radians) * longitudinal)
    increase the x coordinate of camera's position by x * speed
    increase the z coordinate of camera's position by z * speed
    increase the y coordinate of camera's position by climb * speed
    set the y coordinate of camera's position to the maximum of (session's minimum altitude) and (camera's position's y)
    add (rotation * camera's turning * delta * 60.0) to camera's yaw
