import tests/games/studio/interface.dl

to explore {a pointer to spatial session:session} named {C string:name} in {UI reference:description}:
    set interface to an instance of description with state session
    set view to a native view of (the address of interface) sized 1280 by 780 using fonts "tests/games/fonts/NotoSans-Regular.ttf" and "tests/games/fonts/NotoSans-SemiBold.ttf"
    set session's view to (the address of view) as a pointer
    set the text of "Scene name" in (the address of interface) to name
    navigate session using the address of view
    close the address of view
    close the address of interface

to navigate {a pointer to spatial session:session} using {a pointer to native UI view:view}:
    set previous to the time since start for view's window
    set pause and reset to false
    loop while view's window remains open:
        poll window events
        set window to view's window
        set now to the time since start for window
        set pressed to key (the P key) is down in window
        if pressed and not pause:
            set session's paused to not session's paused
        set pause to pressed
        set pressed to key (the R key) is down in window
        if pressed and not reset:
            restart session
        set reset to pressed
        if key (the escape key) is down in window:
            request that window close
        set forward, sideways, vertical and turn to 0.0
        if key (the W key) is down in window:
            add 1.0 to forward
        if key (the S key) is down in window:
            subtract 1.0 from forward
        if key (the D key) is down in window:
            add 1.0 to sideways
        if key (the A key) is down in window:
            subtract 1.0 from sideways
        if key (the E key) is down in window:
            add 1.0 to vertical
        if key (the Q key) is down in window:
            subtract 1.0 from vertical
        if key (the left arrow key) is down in window:
            add 1.0 to turn
        if key (the right arrow key) is down in window:
            subtract 1.0 from turn
        move session forward forward sideways sideways vertically vertical turning turn after (now - previous) seconds
        set previous to now
        set status to "EXPLORING"
        if session's paused:
            set status to "PAUSED"
        set the text of "View status" in (view's instance) to status
        render view
        sleep for 4 milliseconds
