import tests/games/shader_values.dl

# Concentric rings with animated color wave — hypnotic pattern
# DynLex entrypoint flags: --emit-spirv --shader-stage=fragment

set pixel to a planar position with x the fragment x coordinate and y the fragment y coordinate
set time to the shader time

# Center and normalize
set position to a planar position with x (pixel's x / 400.0 - 1.0) and y (pixel's y / 300.0 - 1.0)

# Distance from center
set distance to the square root of ((position's x * position's x) + (position's y * position's y))

# Concentric rings with smooth color bands (animated)
set ring to the sine of (distance * 30.0 - time * 4.0)

# Angle for directional color variation
set angle to 0.0
if distance > 0.001:
    set angle to position's x / distance

set color to a light color with red (the sine of (ring + angle * 3.0) * 0.5 + 0.5), green (the sine of (ring * 1.5 + 1.0) * 0.5 + 0.5), blue (the sine of (ring * 2.0 + 2.0) * 0.5 + 0.5) and alpha 1.0

# Darken edges with vignette
set vignette to 1.0 - distance * 0.5
if vignette < 0.0:
    set vignette to 0.0

set the red channel of color to color's red * vignette
set the green channel of color to color's green * vignette
set the blue channel of color to color's blue * vignette

set the fragment color with red color's red, green color's green, blue color's blue and alpha color's alpha
