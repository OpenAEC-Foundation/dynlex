# The drawn pose follows the current move, including a turn made mid-tick.
import tests/games/snake/rules.dl

class:
    patterns:
        snake position
    members:
        column as a floating-point number
        row as a floating-point number

a snake position at {floating-point number:column} and {floating-point number:row} means: @intrinsic("construct", snake position, column, row)

to get the impact compression in {a pointer to snake match:match}:
    if (not match's impact) or match's reduced motion:
        return 0.0
    set phase to match's impact time / the snake impact duration
    return 0.38 * (the sine of (phase * 3.141592653589793))

to get the snake's travel in {a pointer to snake match:match}:
    if match's phase = the menu screen:
        return 0.0
    if match's impact:
        if match's reduced motion:
            return 1.0
        set phase to match's impact time / the snake impact duration
        set rebound to the maximum of 0.0 and ((phase - 0.2) / 0.8)
        return 1.0 - (0.25 * (the sine of (rebound * 3.141592653589793)))
    return match's progress

to get the wrapped snake coordinate {floating-point number:value}:
    set width to the snake board width as a floating-point number
    return value - ((the floor of (value / width)) * width)

to get the snake position {integer:index} in {a pointer to snake match:match}:
    set distance to index as a floating-point number
    set reach to the maximum of 0.0 and (1.0 - (distance / 8.0))
    set distance to distance * (1.0 - ((the impact compression in match) * reach))
    set behind to distance - (the snake's travel in match)
    set first to the item at 0 in (match's body)
    set second to the next snake cell in match
    set amount to -behind
    if behind >= 0.0:
        set behind to the minimum of behind and ((match's length - 1) as a floating-point number)
        set slot to behind as an integer
        set first to the item at slot in (match's body)
        set second to first
        if slot < match's length - 1:
            set second to the item at (slot + 1) in (match's body)
        set amount to behind - (slot as a floating-point number)
    set horizontal to (second's column - first's column) as a floating-point number
    set vertical to (second's row - first's row) as a floating-point number
    if match's wrap edges:
        if horizontal > 1.0:
            set horizontal to horizontal - (the snake board width as a floating-point number)
        if horizontal < -1.0:
            set horizontal to horizontal + (the snake board width as a floating-point number)
        if vertical > 1.0:
            set vertical to vertical - (the snake board width as a floating-point number)
        if vertical < -1.0:
            set vertical to vertical + (the snake board width as a floating-point number)
    set column to (first's column as a floating-point number) + (horizontal * amount)
    set row to (first's row as a floating-point number) + (vertical * amount)
    if match's wrap edges:
        set column to the wrapped snake coordinate column
        set row to the wrapped snake coordinate row
    return a snake position at column and row
