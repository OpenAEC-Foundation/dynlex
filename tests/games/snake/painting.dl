import tests/games/snake/projection.dl
import lib/ui_native_types.dl

to get the accent for {a pointer to snake match:match}:
    if match's palette = 1:
        return UI ink 255 202 112
    if match's palette = 2:
        return UI ink 184 166 255
    return UI ink 117 242 201

# A composed opening trail; starting a run replaces it with the playable snake.
to arrange the opening trail in {a pointer to snake match:match}:
    set match's length to 30
    set index to 0
    loop while index < match's length:
        set column to 18 - index
        set row to 7
        if index >= 7:
            set column to 12
            set row to index + 1
        if index >= 11:
            set column to 22 - index
            set row to 11
        if index >= 17:
            set column to 6
            set row to index - 5
        if index >= 20:
            set column to index - 13
            set row to 14
        store a snake cell at column and row into match's body at index
        increment index
    set match's food to a snake cell at 18 and 12

to get the snake [ink] at {integer:index} for {a pointer to snake match:match}:
    set ink to the accent for match
    set fade to 0.5 + (0.5 * (1.0 - ((index as a floating-point number) / (match's length as a floating-point number))))
    set ink's red to ((ink's red as a floating-point number) * fade) as an integer
    set ink's green to ((ink's green as a floating-point number) * fade) as an integer
    set ink's blue to ((ink's blue as a floating-point number) * fade) as an integer
    return ink

to paint snake for {a pointer to UI instance:instance} on {a pointer to UI canvas frame:canvas}:
    set match to instance's state as a pointer to snake match
    set frame to canvas's frame
    set box to canvas's bounds
    set scale to (box's width - 16.0) / ((the snake board width + 1) as a floating-point number)
    draw a UI shadow under box with radius 22.0 softness 12.0 strength 110 in (UI ink 0 0 0) on frame
    draw a rounded UI surface box with radius 22.0 from (UI ink 71 94 119) to (UI ink 25 42 64) opacity 255 feathered by 0.75 on frame
    set inside to UI box at (box's x + 1.0) (box's y + 1.0) sized (box's width - 2.0) (box's height - 2.0)
    draw a rounded UI surface inside with radius 21.0 from (UI ink 14 27 41) to (UI ink 8 16 28) opacity 255 feathered by 0.5 on frame
    if match's show grid:
        set index to 0
        loop while index <= the snake board width:
            set offset to 8.0 + (((index as a floating-point number) + 0.5) * scale)
            set vertical to box's x + offset
            set horizontal to box's y + offset
            draw a UI stroke from (a UI point at vertical and (box's y + 20.0)) to (a UI point at vertical and ((box's y + box's height) - 20.0)) with width 0.55 opacity 18 from (UI ink 64 93 118) to (UI ink 41 64 87) on frame
            draw a UI stroke from (a UI point at (box's x + 20.0) and horizontal) to (a UI point at ((box's x + box's width) - 20.0) and horizontal) with width 0.55 opacity 18 from (UI ink 64 93 118) to (UI ink 41 64 87) on frame
            increment index
    set food to the painted position of (a snake position at (match's food's column as a floating-point number) and (match's food's row as a floating-point number)) in box
    set pulse to 0.0
    if match's reduced motion = false:
        set pulse to (the sine of (canvas's seconds * 3.0)) * 1.5
    if match's phase != the completed screen:
        set halo to UI box at (food's x - 10.0) (food's y - 10.0) sized 20 20
        draw a rounded UI surface halo with radius 10.0 from (UI ink 255 146 92) to (UI ink 249 105 80) opacity 28 feathered by (10.0 + pulse) on frame
        draw a UI disc at food with radius 7.0 from (UI ink 255 203 136) to (UI ink 241 101 80) opacity 255 on frame
        draw a UI disc at (a UI point at (food's x - 1.6) and (food's y - 2.1)) with radius 2.1 from (UI ink 255 249 220) to (UI ink 255 208 160) opacity 220 on frame
    set count to match's length
    if ((match's phase = the playing screen) or (match's phase = the paused screen)) and ((the next snake cell in match) is the same cell as match's food):
        increment count
    set index to 0
    loop while index < count - 1:
        set point to the painted snake point index for match in box
        set neighbor to the painted snake point (index + 1) for match in box
        set distance to (the absolute value of (point's x - neighbor's x)) + (the absolute value of (point's y - neighbor's y))
        if distance < scale * 2.0:
            draw a UI stroke from (a UI point at (point's x) and (point's y + 3.0)) to (a UI point at (neighbor's x) and (neighbor's y + 3.0)) with width 18.0 opacity 110 from (UI ink 0 4 10) to (UI ink 0 4 10) on frame
        increment index
    set index to count - 1
    loop while index >= 0:
        set point to the painted snake point index for match in box
        set ink to the snake ink at index for match
        set top to UI ink between ink and (UI ink 230 255 251) at 0.25
        set bottom to UI ink between ink and (UI ink 16 77 78) at 0.27
        set neighbor to point
        set distance to 0.0
        draw a UI disc at point with radius 8.0 from top to bottom opacity 255 on frame
        if index < count - 1:
            set neighbor to the painted snake point (index + 1) for match in box
            set distance to (the absolute value of (point's x - neighbor's x)) + (the absolute value of (point's y - neighbor's y))
            if distance < scale * 2.0:
                draw a glossy UI stroke from point to neighbor with width 16.0 from ink to (the snake ink at (index + 1) for match) on frame
        decrement index
    set head to the painted snake point 0 for match in box
    set {eye x} to 0.0
    set {eye y} to 0.0
    set {eye spacing x} to 3.6
    set {eye spacing y} to 0.0
    if match's direction = 0:
        set eye y to -3.0
    else if match's direction = 2:
        set eye y to 3.0
    else:
        set eye spacing x to 0.0
        set eye spacing y to 3.6
        set eye x to 3.0
        if match's direction = 3:
            set eye x to -3.0
    set {first eye} to a UI point at ((head's x + eye x) - eye spacing x) and ((head's y + eye y) - eye spacing y)
    set {second eye} to a UI point at ((head's x + eye x) + eye spacing x) and ((head's y + eye y) + eye spacing y)
    draw a UI disc at first eye with radius 2.5 from (UI ink 7 25 34) to (UI ink 10 36 42) opacity 255 on frame
    draw a UI disc at second eye with radius 2.5 from (UI ink 7 25 34) to (UI ink 10 36 42) opacity 255 on frame
