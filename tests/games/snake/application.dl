import tests/games/snake/interface.dl

class:
    patterns:
        snake keyboard
    members:
        north as a boolean
        east as a boolean
        south as a boolean
        west as a boolean
        pause as a boolean
        back as a boolean

to read snake input from {a pointer to native UI view:view} using {a pointer to snake keyboard:keyboard}:
    set match to the snake match in (view's instance)
    set window to view's window
    set north to (key (the up arrow key) is down in window) or (key (the W key) is down in window)
    set east to (key (the right arrow key) is down in window) or (key (the D key) is down in window)
    set south to (key (the down arrow key) is down in window) or (key (the S key) is down in window)
    set west to (key (the left arrow key) is down in window) or (key (the A key) is down in window)
    if north and (keyboard's north = false):
        turn match toward 0
    if east and (keyboard's east = false):
        turn match toward 1
    if south and (keyboard's south = false):
        turn match toward 2
    if west and (keyboard's west = false):
        turn match toward 3
    set keyboard's north to north
    set keyboard's east to east
    set keyboard's south to south
    set keyboard's west to west
    set pause to (key (the space key) is down in window) or (key (the P key) is down in window)
    if pause and (keyboard's pause = false):
        if (view's instance's page's text = "playing") or (view's instance's page's text = "paused"):
            pause or resume match
            if match's phase = the paused screen:
                show page "paused" in (view's instance)
            else:
                show page "playing" in (view's instance)
    set keyboard's pause to pause
    set back to key (the escape key) is down in window
    if back and (keyboard's back = false):
        if view's instance's page's text = "settings":
            leave snake settings in (view's instance)
        else if match's phase = the playing screen:
            pause or resume match
            show page "paused" in (view's instance)
        else if match's phase = the paused screen:
            pause or resume match
            show page "playing" in (view's instance)
        else if match's phase = the menu screen:
            request that window close
        else:
            return to the snake menu in (view's instance)
    set keyboard's back to back

to refresh the snake interface in {a pointer to native UI view:view}:
    set match to the snake match in (view's instance)
    set view's theme's accent to the accent for match
    set status to "READY TO PLAY"
    if match's phase = the playing screen:
        set status to "IN THE FLOW"
    if match's phase = the paused screen:
        set status to "PAUSED"
    if view's instance's page's text = "settings":
        set status to "MAKE IT YOURS"
    if (match's phase = the finished screen) or (match's phase = the completed screen):
        set status to "RUN COMPLETE"
    set the text of "Session status" in (view's instance) to status
    set the text of "Score" in (view's instance) to match's score
    set the text of "Session best" in (view's instance) to match's best score
    set the text of "Length" in (view's instance) to match's length
    set pace to "CLASSIC"
    if match's pace = 0:
        set pace to "RELAXED"
    if match's pace = 2:
        set pace to "SWIFT"
    set the text of "Board mode" in (view's instance) to (the string form of pace) + " / 24 x 24"
    set seconds to match's elapsed as an integer
    set the text of "Time" in (view's instance) to (the string form of seconds) + "s"
    if (match's phase = the finished screen) or (match's phase = the completed screen):
        if match's impact and (match's impact time < the snake impact duration):
            show page "impact" in (view's instance)
        else:
            show page "finished" in (view's instance)
        set outcome to "Game over"
        if match's phase = the completed screen:
            set outcome to "Board cleared"
        set the text of "Outcome" in (view's instance) to outcome

to play snake using {a pointer to native UI view:view}:
    set keyboard to a new snake keyboard
    set {last frame} to the time since start for view's window
    loop while view's window remains open:
        poll window events
        set now to the time since start for view's window
        read snake input from view using the address of keyboard
        update (the snake match in (view's instance)) after (now - last frame) seconds
        set last frame to now
        refresh the snake interface in view
        render view
        sleep for 4 milliseconds
