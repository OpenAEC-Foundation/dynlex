import lib/graphics.dl

# Shader gallery — press any arrow key to cycle through shaders
#
# Build:
#   ./build/dynlex tests/games/passthrough_vertex.dl --emit-spirv --shader-stage=vertex -o tests/games/passthrough.spv
#   ./build/dynlex tests/games/mandelbrot_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/mandelbrot.spv
#   ./build/dynlex tests/games/plasma_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/plasma.spv
#   ./build/dynlex tests/games/julia_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/julia.spv
#   ./build/dynlex tests/games/rings_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/rings.spv
#   ./build/dynlex tests/games/shader_gallery.dl -o tests/games/shader_gallery
# Run:
#   ./tests/games/shader_gallery

set window to a new window with width 800 and height 600

# Load vertex shader (shared by all programs)
set vertex to a vertex shader from "tests/games/passthrough.spv"

# Load all fragment shaders
set fragments to [
    a fragment shader from "tests/games/mandelbrot.spv",
    a fragment shader from "tests/games/plasma.spv",
    a fragment shader from "tests/games/julia.spv",
    a fragment shader from "tests/games/rings.spv"
]

# Create shader programs
set programs to [
    a shader program combining vertex and (the item at 0 in fragments),
    a shader program combining vertex and (the item at 1 in fragments),
    a shader program combining vertex and (the item at 2 in fragments),
    a shader program combining vertex and (the item at 3 in fragments)
]

set timer to a new uniform buffer
bind timer to binding 0

set current to 0
set ready to true
use (the item at 0 in programs) as the shader program

while the window remains open:
    set pressed to key (the GLFW up key) is down in window or key (the GLFW right key) is down in window or key (the GLFW down key) is down in window or key (the GLFW left key) is down in window
    if pressed:
        if ready:
            set current to (current + 1)
            if current > 3:
                set current to 0
            use (the item at current in programs) as the shader program
            set ready to false
    else:
        set ready to true

    # Pass time uniform via UBO (required for SPIR-V shaders)
    set time to the time since start
    update timer with time

    clear the screen
    draw a fullscreen quad
    display the frame of window

delete timer
close the window
