import lib/graphics.dl

# Shader gallery — press any arrow key to cycle through shaders
#
# Build:
#   ./build/dynlex tests/games/passthrough_vertex.dl --emit-spirv --shader-stage=vertex -o tests/games/passthrough.spv
#   ./build/dynlex tests/games/mandelbrot_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/mandelbrot.spv
#   ./build/dynlex tests/games/plasma_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/plasma.spv
#   ./build/dynlex tests/games/julia_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/julia.spv
#   ./build/dynlex tests/games/rings_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/rings.spv
#   ./build/dynlex tests/games/shader_gallery.dl -o tests/games/shader_gallery
# Run:
#   ./tests/games/shader_gallery

set window to a new window with width 800 and height 600

set programs to [
    a shader program for window using vertex shader at "tests/games/passthrough.spv" and fragment shader at "tests/games/mandelbrot.spv",
    a shader program for window using vertex shader at "tests/games/passthrough.spv" and fragment shader at "tests/games/plasma.spv",
    a shader program for window using vertex shader at "tests/games/passthrough.spv" and fragment shader at "tests/games/julia.spv",
    a shader program for window using vertex shader at "tests/games/passthrough.spv" and fragment shader at "tests/games/rings.spv"
]

set current to 0
set ready to true

while window remains open:
    set pressed to key (the up arrow key) is down in window or key (the right arrow key) is down in window or key (the down arrow key) is down in window or key (the left arrow key) is down in window
    if pressed:
        if ready:
            set current to (current + 1)
            if current > 3:
                set current to 0
            set ready to false
    else:
        set ready to true

    set time to the time since start for window
    set frame to a new graphics frame in window
    use (the item at current in programs) in frame
    set uniform binding 0 in frame to time
    draw a fullscreen surface in frame
    display frame

set index to 0
while index < 4:
    release the item at index in programs
    increment index
close the window
