import lib/graphics.dl

# Shader gallery — press any arrow key to cycle through shaders
#
# Build:
#   ./build/dynlex tests/games/passthrough_vertex.dl --emit-spirv --shader-stage=vertex -o tests/games/passthrough.spv
#   ./build/dynlex tests/games/mandelbrot_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/mandelbrot.spv
#   ./build/dynlex tests/games/plasma_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/plasma.spv
#   ./build/dynlex tests/games/julia_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/julia.spv
#   ./build/dynlex tests/games/rings_shader.dl --emit-spirv --shader-stage=fragment -o tests/games/rings.spv
#   ./build/dynlex tests/games/shader_gallery.dl -o tests/games/shader_gallery
# Run:
#   ./tests/games/shader_gallery

set window to a new window with width 800 and height 600

# Load vertex shader (shared by all programs)
set vert to a vertex shader from "tests/games/passthrough.spv"

# Load all fragment shaders
set frag0 to a fragment shader from "tests/games/mandelbrot.spv"
set frag1 to a fragment shader from "tests/games/plasma.spv"
set frag2 to a fragment shader from "tests/games/julia.spv"
set frag3 to a fragment shader from "tests/games/rings.spv"

# Create shader programs
set prog0 to a shader program with vertex vert and fragment frag0
set prog1 to a shader program with vertex vert and fragment frag1
set prog2 to a shader program with vertex vert and fragment frag2
set prog3 to a shader program with vertex vert and fragment frag3

set time_ubo to a uniform buffer
bind uniform buffer time_ubo to 0

set current to 0
set was_pressed to 0
use shader program prog0

while not the window should close:
    set key to the pressed key of window
    if key > 0:
        if key < 5:
            if was_pressed = 0:
                set current to current + 1
                if current > 3:
                    set current to 0
                if current = 0:
                    use shader program prog0
                if current = 1:
                    use shader program prog1
                if current = 2:
                    use shader program prog2
                if current = 3:
                    use shader program prog3
                set was_pressed to 1
    if key = 0:
        set was_pressed to 0

    # Pass time uniform via UBO (required for SPIR-V shaders)
    set t to the time since start
    update uniform buffer time_ubo with t

    clear the screen
    draw a fullscreen quad
    display the frame of window

close the window
