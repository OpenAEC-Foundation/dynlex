import lib/graphics.dl
import lib/models/fbx.dl
import tests/games/three_dimensional.dl

# FBX Model Viewer (via pre-converted OBJ)
#
# Input pipeline:
#   1) ./build/fbx_to_obj tests/games/model/assets/source/city.fbx tests/games/model/assets/generated/city.obj --triangle-step 1
#   2) ./build/dynlex tests/games/model/viewer.dl -o tests/games/model/viewer
#   3) ./tests/games/model/viewer
#
# Controls:
#   W/S: move forward/backward
#   A/D: strafe right/left
#   Q/E: move down/up
#   Left/Right: yaw left/right
#   1: textured/material mode
#   2: UV debug mode
#   3: vertex-color mode

function position the model viewer camera from {spatial camera:view} in {graphics frame:frame}:
    execute:
        reset the camera in frame
        rotate the camera in frame by (0.0 - view's yaw) degrees around x 0.0, y 1.0 and z 0.0
        move the camera in frame by x (0.0 - view's position's x), y (0.0 - view's position's y) and z (0.0 - view's position's z)

function the configured model path:
    replacement:
        @intrinsic("call", "libc", "getenv", a pointer to a byte, "DYNLEX_MODEL_PATH")

set window to a new window with width 1400 and height 900
if window = 0 as a pointer to a byte:
    print "failed to create viewer window" as a line
else:
    set path to "tests/games/model/assets/generated/city.obj"
    set override to the configured model path
    if override != 0 as a pointer to a byte:
        set path to override

    set mesh to a loaded FBX mesh from path for window

    if mesh's vertex count <= 0:
        print "failed to load mesh. convert city.fbx to city.obj first" as a line

    set bounds to a bounding box from (a position with x 0.0, y 0.0 and z 0.0) to (a position with x 0.0, y 0.0 and z 0.0)

    if mesh's vertex count > 0:
        set anchor to the item at 0 in mesh's vertices
        set bounds's minimum to a position with x anchor's x, y anchor's y and z anchor's z
        set bounds's maximum to a position with x anchor's x, y anchor's y and z anchor's z

        set index to 1
        while index < mesh's vertex count:
            set vertex to the item at index in mesh's vertices
            if vertex's x < bounds's minimum's x:
                set the x coordinate of bounds's minimum to vertex's x
            if vertex's y < bounds's minimum's y:
                set the y coordinate of bounds's minimum to vertex's y
            if vertex's z < bounds's minimum's z:
                set the z coordinate of bounds's minimum to vertex's z

            if vertex's x > bounds's maximum's x:
                set the x coordinate of bounds's maximum to vertex's x
            if vertex's y > bounds's maximum's y:
                set the y coordinate of bounds's maximum to vertex's y
            if vertex's z > bounds's maximum's z:
                set the z coordinate of bounds's maximum to vertex's z

            increment index

    set extent to the dimensions measuring (bounds's maximum's x - bounds's minimum's x) by (bounds's maximum's y - bounds's minimum's y) by (bounds's maximum's z - bounds's minimum's z)
    set span to extent's width
    if extent's height > span:
        set span to extent's height
    if extent's depth > span:
        set span to extent's depth

    set scale to 1.0
    if span > 0.0001:
        set scale to (160.0 / span)

    set center to a position with x ((bounds's minimum's x + bounds's maximum's x) / 2.0), y bounds's minimum's y and z ((bounds's minimum's z + bounds's maximum's z) / 2.0)
    set offset to a position with x (0.0 - center's x * scale), y (0.0 - center's y * scale) and z (0.0 - center's z * scale)

    set message to the string form of "mesh vertices: "
    set message to (message + (the string form of (mesh's vertex count)))
    set message to (message + (the string form of ", triangles: "))
    set message to (message + (the string form of (mesh's triangle count)))
    print message as a line

    set message to the string form of "bounds x: "
    set message to (message + (the string form of (bounds's minimum's x)))
    set message to (message + (the string form of " .. "))
    set message to (message + (the string form of (bounds's maximum's x)))
    print message as a line

    set message to the string form of "bounds y: "
    set message to (message + (the string form of (bounds's minimum's y)))
    set message to (message + (the string form of " .. "))
    set message to (message + (the string form of (bounds's maximum's y)))
    print message as a line

    set message to the string form of "bounds z: "
    set message to (message + (the string form of (bounds's minimum's z)))
    set message to (message + (the string form of " .. "))
    set message to (message + (the string form of (bounds's maximum's z)))
    print message as a line

    set message to the string form of "model scale: "
    set message to (message + (the string form of scale))
    print message as a line
    print "render modes: 1=textured/material, 2=uv debug, 3=vertex colors" as a line

    set altitude to ((extent's height * scale) * 0.8)
    if altitude < 50.0:
        set altitude to 50.0
    set distance to ((span * scale) * 1.8)
    if distance < 180.0:
        set distance to 180.0
    set pace to ((span * scale) * 0.005)
    if pace < 1.4:
        set pace to 1.4
    set view to a camera at (a position with x 0.0, y altitude and z distance) facing 0.0 degrees with speed pace and turn rate 1.6
    set mode to 0

    while window remains open:
        set radians to (view's yaw * 0.0174533)
        set forward to a position with x (0.0 - (the sine of radians)), y 0.0 and z (0.0 - (the cosine of radians))
        set rightward to a position with x (0.0 - forward's z), y 0.0 and z forward's x

        if key (the W key) is down in window:
            increase the x coordinate of view's position by forward's x * view's movement
            increase the z coordinate of view's position by forward's z * view's movement
        if key (the S key) is down in window:
            decrease the x coordinate of view's position by forward's x * view's movement
            decrease the z coordinate of view's position by forward's z * view's movement

        # Requested mapping: A moves right, D moves left
        if key (the A key) is down in window:
            increase the x coordinate of view's position by rightward's x * view's movement
            increase the z coordinate of view's position by rightward's z * view's movement
        if key (the D key) is down in window:
            decrease the x coordinate of view's position by rightward's x * view's movement
            decrease the z coordinate of view's position by rightward's z * view's movement

        if key (the Q key) is down in window:
            decrease the y coordinate of view's position by 1.1
        if key (the E key) is down in window:
            increase the y coordinate of view's position by 1.1

        # Left rotates left, right rotates right
        if key (the left arrow key) is down in window:
            add view's turning to view's yaw
        if key (the right arrow key) is down in window:
            subtract view's turning from view's yaw

        if key (the 1 key) is down in window:
            if mode != 0:
                set mode to 0
                print "render mode: textured/material" as a line
        if key (the 2 key) is down in window:
            if mode != 1:
                set mode to 1
                print "render mode: uv debug" as a line
        if key (the 3 key) is down in window:
            if mode != 2:
                set mode to 2
                print "render mode: vertex colors" as a line

        if view's position's y < 4.0:
            set the y coordinate of view's position to 4.0

        set frame to a new graphics frame in window with background red 0.74, green 0.84, blue 0.95 and alpha 1.0
        use perspective with a vertical field of view of 88.0 degrees, a near plane of 0.8 and a far plane of 24000.0 in frame
        enable depth testing in frame
        position the model viewer camera from view in frame
        draw mesh at x offset's x, y offset's y and z offset's z scaled by scale in (a normalized OBJ color from byte values 152, 176 and 196) with mode as its render mode in frame

        display frame

    free mesh
    close the window
