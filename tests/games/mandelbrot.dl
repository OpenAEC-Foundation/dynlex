import lib/graphics.dl

# Mandelbrot host program
# Loads SPIR-V vertex and fragment shaders, renders a fullscreen quad
#
# Build:
#   ./build/dynlex tests/games/passthrough_vertex.dl --emit-spirv --shader-stage=vertex -o tests/games/passthrough.spv
#   ./build/dynlex tests/games/mandelbrot_shader.dl --emit-spirv -o tests/games/mandelbrot.spv
#   ./build/dynlex tests/games/mandelbrot.dl -o tests/games/mandelbrot
# Run:
#   ./tests/games/mandelbrot

set window to a new window with width 800 and height 600

# Load both SPIR-V shaders
set vert to a vertex shader from "tests/games/passthrough.spv"
set frag to a fragment shader from "tests/games/mandelbrot.spv"

# Link shader program
set prog to a shader program with vertex vert and fragment frag
use shader program prog

while not the window should close:
    clear the screen
    draw a fullscreen quad
    display the frame of window

close the window
