import tests/games/geometry_dash/painting.dl

to explore routes using {a pointer to native UI view:view}:
    set session to the route in (view's instance)
    set previous to the time since start for view's window
    set pause and reset to false
    loop while view's window remains open:
        poll window events
        set window to view's window
        set now to the time since start for window
        set pressed to (key (the P key) is down in window) or (key (the escape key) is down in window)
        if pressed and not pause:
            if session's phase != 0:
                set session's paused to not session's paused
        set pause to pressed
        set pressed to key (the R key) is down in window
        if pressed and not reset:
            restart session
        set reset to pressed
        if key (the Q key) is down in window:
            request that window close
        set held to (key (the up arrow key) is down in window) or (key (the space key) is down in window)
        set cursor to the UI cursor in view
        if (cursor's y > 100.0) and (cursor's y < 710.0):
            if session's phase = 1 and not session's paused:
                set held to held or (a mouse button numbered 0 is pressed in window)
        if held and ((session's phase = 0) and not session's paused):
            begin session
        set session's held to held
        update session after (now - previous) seconds
        set previous to now
        refresh the route in (view's instance)
        render view
        sleep for 4 milliseconds
