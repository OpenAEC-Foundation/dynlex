import lib/array.dl
import tests/games/geometry_dash/generator.dl
import tests/games/geometry_dash/physics.dl

function report the simulation with {runner state:body}:
	replacement:
		ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "DEBUG_SIM_BASELINE_OK highest_y=%ld\n", body's y as a 64 bit integer)

set plan to a route plan with 24 steps
fill plan using seed 1337

set body to a runner at height the player's ground height moving with velocity 0.0
set highest to body's y
set index to 0
loop while index < plan's count:
	set body's velocity to 0.0
	start a jump for body
	set elapsed to 0
	set duration to the item at index in plan's jumps
	loop while elapsed < duration:
		apply gravity to body
		if body's y < highest:
			set highest to body's y
		add the frame time in milliseconds to elapsed
	clamp body to the ground
	increment index

set body's y to highest
report the simulation with body
