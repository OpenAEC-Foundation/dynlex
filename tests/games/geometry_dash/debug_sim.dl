import tests/games/geometry_dash/session.dl

set session to a new route session
begin the address of session
set action to 0
set highest to session's player's y
loop while session's phase = 1:
    set session's held to false
    if action < session's course's jumps:
        set planned to the item at action in (session's course's actions)
        if session's tick = planned's tick:
            set session's held to true
            increment action
    update (the address of session) after the dash tick seconds
    set message to formatted "Collision at tick {session's tick}, cube {session's player's x}, {session's player's y}"
    require condition (not session's player's dead) reporting (the data of message)
    set highest to the minimum of highest and (session's player's y)
require condition (session's phase = 3) reporting "The reference did not complete the level"
print line formatted "DEBUG_SIM_BASELINE_OK jumps={action} highest_y={highest}"
close the address of session
