import lib/graphics.dl
import tests/games/geometry_dash/physics.dl

class:
	patterns:
		screen position
	members:
		x, y

class:
	patterns:
		screen color
	members:
		red, green, blue

function a screen position with x {integer:x} and y {integer:y}:
	replacement:
		@intrinsic("construct", screen position, x, y)

function a screen color with red {integer:red}, green {integer:green} and blue {integer:blue}:
	replacement:
		@intrinsic("construct", screen color, red, green, blue)

function draw the static world:
	execute:
		clear the screen
		draw a rectangle at x 0 and y 0 with width the window width and height the world height in color red 18, green 18 and blue 24
		draw a rectangle at x 0 and y 0 with width the window width and height the ceiling height in color red 92, green 58 and blue 34
		draw a rectangle at x 0 and y the ground height with width the window width and height (the world height - the ground height) in color red 40, green 28 and blue 18

function draw a runner at {screen position:position} with {screen color:color}:
	execute:
		draw a rectangle at x position's x and y position's y with width the player size and height the player size in color red color's red, green color's green and blue color's blue
