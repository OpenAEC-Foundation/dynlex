import lib/random.dl
import tests/games/geometry_dash/physics.dl

to get an empty dash level:
    set result to a new dash level
    set result's objects to storage for 256 slots initialized with a new dash obstacle
    set result's actions to storage for 32 slots initialized with a new dash action
    return result

to generate {a pointer to dash level:course} using seed {integer:seed}:
    seed the random number generator with seed
    set course's count to 0
    set course's jumps to 32
    set body to a fresh cube
    set clock and elevation to 0
    set support to 0
    add (a dash obstacle of kind (the solid tile) at -200.0 (the dash floor) sized 1000.0 by 400.0) to course
    loop index from 0 to (course's jumps):
        set waiting to 22 + ((a random number) mod 25)
        if index = 0:
            set waiting to 150
        if index mod 8 = 0 and index > 0:
            add 32 to waiting
        add waiting to clock
        add ((waiting as a floating-point number) * the dash speed) to body's x
        set action to a new dash action
        set action's tick to clock
        set motif to (a random number) mod 6
        if index < 3:
            set motif to index
        if (index mod 16 >= 8) and (index mod 16 <= 10):
            set motif to 4
        if (index mod 16 >= 11) and (index mod 16 <= 13):
            set motif to 5
        set target to elevation
        if motif = 4 and elevation < 3:
            increment target
        if motif = 5 and elevation > 0:
            decrement target
        set top to the dash floor - ((target as a floating-point number) * the cube size)
        set launch to body's x
        set body's velocity to -the dash impulse
        set flight to 0
        set landed to false
        loop while not landed:
            apply dash gravity to the address of body
            add the dash speed to body's x
            increment flight
            if (body's velocity > 0.0) and (body's y + the cube size >= top):
                set landed to true
        set previous to the item at support in (course's objects)
        if (target != elevation) or (motif = 3):
            set previous's width to ((launch + the cube size) + 10.0) - previous's x
            store previous into course's objects at support
            set support to course's count
            add (a dash obstacle of kind (the solid tile) at (body's x - 22.0) top sized 140.0 by ((the dash height - top) + 160.0)) to course
        else:
            set previous's width to ((body's x + the cube size) + 100.0) - previous's x
            store previous into course's objects at support
            set spikes to 1 + (motif mod 3)
            set width to 28.0
            set center to launch + (the cube size / 2.0) + (((flight as a floating-point number) * the dash speed) / 2.0)
            set left to center - (((spikes as a floating-point number) * width) / 2.0)
            loop spike from 0 to spikes:
                add (a dash obstacle of kind (the spike tile) at (left + ((spike as a floating-point number) * width)) (top - 32.0) sized width by 32.0) to course
        # Overhead solids belong to the collision world, not just the artwork.
        if index mod 4 = 3:
            add (a dash obstacle of kind (the solid tile) at (launch + 60.0) (top - 256.0) sized 112.0 by 36.0) to course
        set body's y to top - the cube size
        set body's velocity to 0.0
        add flight to clock
        set elevation to target
        set action's landing to clock
        set action's level to elevation
        set action's motif to motif
        store action into course's actions at index
    set final to the item at support in (course's objects)
    set final's width to ((body's x + 800.0) - final's x)
    store final into course's objects at support
    set course's duration to clock + 120
    set course's finish to body's x + (120.0 * the dash speed)

to get {dash level:course} accepts a reference offset of {integer:offset}:
    set body to a fresh cube
    set action to 0
    loop clock from 0 to (course's duration):
        set held to false
        if action < course's jumps:
            set planned to the item at action in (course's actions)
            if clock = planned's tick + offset:
                if not body's grounded:
                    return false
                set held to true
                increment action
        step (the address of body) through course holding jump held
        if body's dead:
            return false
    return (action = course's jumps) and (body's x >= course's finish - 0.01)

to verify {dash level:course}:
    loop offset from (-the jump timing margin) to (the jump timing margin + 1):
        set message to formatted "The generated reference route failed at timing offset {offset}"
        require condition (course accepts a reference offset of offset) reporting (the data of message)
