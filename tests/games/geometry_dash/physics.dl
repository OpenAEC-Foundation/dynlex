import lib/std.dl

class:
	patterns:
		runner state
	members:
		y, velocity

function a runner at height {float:y} moving with velocity {float:velocity}:
	replacement:
		@intrinsic("construct", runner state, y, velocity)

function the window width:
	execute:
		return 1000

function the world height:
	execute:
		return 420

function the ground height:
	execute:
		return 340

function the ceiling height:
	execute:
		return 48

function the player size:
	execute:
		return 32

function the player horizontal position:
	execute:
		return 180

function the reference horizontal offset:
	execute:
		return 84

function the scroll speed:
	execute:
		return 7

function the frame time in milliseconds:
	execute:
		return 16

function the gravity strength:
	execute:
		return 1.15

function the jump speed:
	execute:
		return 15.5

function the player's ground height:
	execute:
		return (the ground height - the player size) as a float

function start a jump for {runner state:body}:
	execute:
		set body's velocity to the negative of the jump speed

function apply gravity to {runner state:body}:
	execute:
		add the gravity strength to body's velocity
		add body's velocity to body's y

function clamp {runner state:body} to the ground:
	execute:
		set floor to the player's ground height
		if body's y > floor:
			set body's y to floor
			set body's velocity to 0.0
