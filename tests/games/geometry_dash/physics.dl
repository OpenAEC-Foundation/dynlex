import lib/std.dl

class:
	patterns:
		[a|] runner state
	members:
		y, velocity

a runner at height {floating-point number:y} moving with velocity {floating-point number:velocity} means: @intrinsic("construct", a runner state, y, velocity)
to get the window width:
	return 1000

to get the world height:
	return 420

to get the ground height:
	return 340

to get the ceiling height:
	return 48

to get the player size:
	return 32

to get the player horizontal position:
	return 180

to get the reference horizontal offset:
	return 84

to get the scroll speed:
	return 7

to get the frame time in milliseconds:
	return 16

to get the gravity strength:
	return 1.15

to get the jump speed:
	return 15.5

to get the player's ground height:
	return (the ground height - the player size) as a floating-point number

to start a jump for {runner state:body}:
	set body's velocity to the negative of the jump speed

to apply gravity to {runner state:body}:
	add the gravity strength to body's velocity
	add body's velocity to body's y

to clamp {runner state:body} to the ground:
	set floor to the player's ground height
	if body's y > floor:
		set body's y to floor
		set body's velocity to 0.0
