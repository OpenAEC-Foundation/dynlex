import lib/array.dl
import tests/games/geometry_dash/generator.dl
import tests/games/geometry_dash/physics.dl

function report {route plan:plan} whose average is {integer:average}, minimum is {integer:minimum}, maximum is {integer:maximum}, peak is {integer:peak} and longest staircase is {integer:staircase}:
	replacement:
		ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "INSPECT avg_jump=%ld min_jump=%ld max_jump=%ld highest_level=%ld longest_staircase=%ld\n", average as a 64 bit integer, minimum as a 64 bit integer, maximum as a 64 bit integer, peak as a 64 bit integer, staircase as a 64 bit integer)

set plan to a route plan with 24 steps
fill plan using seed 1337

set minimum to the item at 0 in plan's jumps
set maximum to the item at 0 in plan's jumps
set total to 0
set peak to 0
set run to 0
set longest to 0
set index to 0
loop while index < plan's count:
	set jump to the item at index in plan's jumps
	set level to the item at index in plan's levels
	add jump to total
	if jump < minimum:
		set minimum to jump
	if jump > maximum:
		set maximum to jump
	if level > peak:
		set peak to level
	if index > 0 and level > the item at (index - 1) in plan's levels:
		increment run
		if run > longest:
			set longest to run
	else:
		set run to 0
	increment index

set average to total / plan's count
report plan whose average is average, minimum is minimum, maximum is maximum, peak is peak and longest staircase is longest
