import tests/games/geometry_dash/generator.dl

set course to an empty dash level
generate (the address of course) using seed 1337
verify course
set solids and spikes to 0
set highest to the dash floor
loop index from 0 to (course's count):
    set obstacle to the item at index in (course's objects)
    if obstacle's kind = the solid tile:
        increment solids
        set highest to the minimum of highest and (obstacle's y)
    else:
        increment spikes
set seconds to (course's duration as a floating-point number) * the dash tick
print line formatted "INSPECT jumps={course's jumps} solids={solids} spikes={spikes} seconds={seconds} top={highest} timing_margin_ticks={the jump timing margin}"
close the address of course
