import lib/graphics.dl
import lib/array.dl
import tests/games/geometry_dash/generator.dl
import tests/games/geometry_dash/physics.dl
import tests/games/geometry_dash/scene.dl

set count to 24
set levels to allocate count slots of an integer
set jump_ms to allocate count slots of an integer
set slide_ms to allocate count slots of an integer
fill plan levels jump_ms slide_ms with count count using seed 1337

set window to a new window with width the window width and height the world height
set player_y to the player ground y
set player_velocity to 0.0
set reference_y to the player ground y
set reference_velocity to 0.0
set reference_step to 0
set reference_phase_ms to 0
set reference_is_sliding to true
set scroll_offset to 0

loop while not the window should close:
	set key to the pressed key of window
	if key = 1 and player_y >= the player ground y:
		start a jump on player_velocity

	apply gravity to player_y and player_velocity
	clamp player_y and player_velocity to the ground

	set scroll_offset to scroll_offset + the scroll speed

	if reference_step < count:
		if reference_is_sliding:
			set reference_phase_ms to reference_phase_ms + the frame time in milliseconds
			if reference_phase_ms >= item reference_step of slide_ms:
				set reference_phase_ms to 0
				set reference_is_sliding to false
				start a jump on reference_velocity
		else:
			apply gravity to reference_y and reference_velocity
			clamp reference_y and reference_velocity to the ground
			set reference_phase_ms to reference_phase_ms + the frame time in milliseconds
			if reference_phase_ms >= item reference_step of jump_ms:
				set reference_phase_ms to 0
				set reference_is_sliding to true
				set reference_step to reference_step + 1

	draw static world in window

	set simulated_surface_y to the player ground y
	set accumulated_distance to the reference x offset - scroll_offset
	set i to 0
	loop while i < count:
		set step_slide_ms to item i of slide_ms
		set step_jump_ms to item i of jump_ms
		set landing_y to simulated_surface_y
		set landing_velocity to 0.0
		start a jump on landing_velocity
		set elapsed_ms to 0
		loop while elapsed_ms < step_jump_ms:
			apply gravity to landing_y and landing_velocity
			set elapsed_ms to elapsed_ms + the frame time in milliseconds
		clamp landing_y and landing_velocity to the ground
		set platform_top_y to landing_y as an integer + the player size
		set platform_height to the ground y - platform_top_y
		set platform_width to 72 + the scroll speed * step_slide_ms / the frame time in milliseconds
		set platform_x to the player x + accumulated_distance
		if platform_height > 0:
			draw rectangle at platform_x platform_top_y size platform_width platform_height with color 210 120 50
		set simulated_surface_y to landing_y
		set accumulated_distance to accumulated_distance + the scroll speed * (step_slide_ms + step_jump_ms) / the frame time in milliseconds
		set i to i + 1

	draw runner at the player x player_y as an integer with color 80 220 255
	draw runner at the player x + the reference x offset reference_y as an integer with color 255 220 80
	display the frame of window
	sleep for the frame time in milliseconds milliseconds

close the window
