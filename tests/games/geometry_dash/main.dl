import lib/font.dl
import tests/games/geometry_dash/generator.dl

# Window and world setup
set window_width to 1000
set window_height to 420
set ground_y to 340
set ceiling_y to 64
set player_size to 32
set player_x to 180

# Obstacle generation
set obstacle_spacing to 180
set obstacle_width to 48
set first_obstacle_offset to 700
set obstacle_scan_count to 16
set obstacle_edge_margin to 120

# Physics and timing
set gravity to 1.15
set jump_velocity to 0.0 - 15.5
set scroll_speed to 7
set frame_sleep_ms to 16
set player_ground_y to (ground_y - player_size) as a float

# Trajectory plan
set trajectory_count to 96
set trajectory_max_level to 4
set step_unit to 24
set trajectory_seed to current time
set trajectory_levels to allocate trajectory_count slots of an integer
set trajectory_jump_ms to allocate trajectory_count slots of an integer
set trajectory_slide_ms to allocate trajectory_count slots of an integer
generate trajectory trajectory_count into trajectory_levels, trajectory_jump_ms, trajectory_slide_ms using trajectory_seed, step_unit, trajectory_max_level

# Boot resources
set window to a new window with width window_width and height window_height
set font to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 24

# Game state
set player_y to player_ground_y
set y_velocity to 0.0
set distance to 0
set score to 0
set game_over to 0
set jump_lock to 0
set rhythm_index to 0
set rhythm_elapsed_ms to 0
set rhythm_jumped to 0
set jump_grace_ms to 120
set jump_buffer_ms to 0
set jump_buffer_max_ms to 220

loop while not the window should close:
	set key to the pressed key of window
	set jump_input to key = 1 or key = 2 or key = 4
	if jump_input:
		set jump_buffer_ms to jump_buffer_max_ms
	else if jump_buffer_ms > 0:
		set jump_buffer_ms to jump_buffer_ms - frame_sleep_ms
		if jump_buffer_ms < 0:
			set jump_buffer_ms to 0

	if key = 5:
		@intrinsic("call", "glfw", "glfwSetWindowShouldClose", void, window, 1)

	if not game_over:
		# Detect if player is standing on a jumpable surface (ground or platform top)
		set standing_on_surface to 0
		if player_y >= player_ground_y:
			set standing_on_surface to 1
		else:
			set player_draw_y to player_y as an integer
			set player_bottom to player_draw_y + player_size
			set first_obstacle to (distance - obstacle_edge_margin - first_obstacle_offset) / obstacle_spacing
			if first_obstacle < 0:
				set first_obstacle to 0
			set i to 0
			loop while i < obstacle_scan_count:
				set obstacle_index to first_obstacle + i
				set world_x to obstacle_index * obstacle_spacing + first_obstacle_offset
				set obstacle_x to world_x - distance

				if obstacle_x > 0 - obstacle_edge_margin and obstacle_x < window_width + obstacle_edge_margin:
					set plan_i to obstacle_index mod trajectory_count
					set obstacle_level to item plan_i of trajectory_levels
					set obstacle_height to 54 + obstacle_level * step_unit
					set obstacle_y to ground_y - obstacle_height
					if player_x < obstacle_x + obstacle_width and player_x + player_size > obstacle_x:
						if player_bottom >= obstacle_y - 2 and player_bottom <= obstacle_y + 6:
							set standing_on_surface to 1

				set i to i + 1

		# Rhythm schedule for jump windows
		set rhythm_elapsed_ms to rhythm_elapsed_ms + frame_sleep_ms
		set expected_slide_ms to item rhythm_index of trajectory_slide_ms
		set expected_jump_ms to item rhythm_index of trajectory_jump_ms

		if jump_buffer_ms > 0 and standing_on_surface and not rhythm_jumped:
			if rhythm_elapsed_ms >= expected_slide_ms - jump_grace_ms and rhythm_elapsed_ms <= expected_slide_ms + jump_grace_ms:
				set y_velocity to jump_velocity
				set rhythm_jumped to 1
				set jump_buffer_ms to 0

		# Missed scheduled jump while still on a slide surface
		if standing_on_surface and not rhythm_jumped and rhythm_elapsed_ms > expected_slide_ms + jump_grace_ms:
			set game_over to 1

		# Advance rhythm step once jump+airtime budget elapsed
		if rhythm_jumped and rhythm_elapsed_ms >= expected_slide_ms + expected_jump_ms:
			set rhythm_index to rhythm_index + 1
			if rhythm_index >= trajectory_count:
				set rhythm_index to 0
			set rhythm_elapsed_ms to 0
			set rhythm_jumped to 0

		# Update motion and progress
		set previous_player_y to player_y
		set y_velocity to y_velocity + gravity
		set player_y to player_y + y_velocity
		set distance to distance + scroll_speed
		set score to distance / 25
		if score > 999:
			set score to 999

		# Ground + ceiling collision
		if player_y > player_ground_y:
			set player_y to player_ground_y
			set y_velocity to 0.0
		if player_y < ceiling_y as a float:
			set player_y to ceiling_y as a float
			set y_velocity to 0.0

		# Obstacle collision pass
		set collided to 0
		set first_obstacle to (distance - obstacle_edge_margin - first_obstacle_offset) / obstacle_spacing
		if first_obstacle < 0:
			set first_obstacle to 0
		set i to 0
		loop while i < obstacle_scan_count:
			set obstacle_index to first_obstacle + i
			set world_x to obstacle_index * obstacle_spacing + first_obstacle_offset
			set obstacle_x to world_x - distance

			if obstacle_x > 0 - obstacle_edge_margin and obstacle_x < window_width + obstacle_edge_margin:
				set plan_i to obstacle_index mod trajectory_count
				set obstacle_level to item plan_i of trajectory_levels
				set obstacle_height to 54 + obstacle_level * step_unit
				set phase to plan_i mod 6
				set top_obstacle_height to 0
				if phase = 1:
					set top_obstacle_height to 30
				else if phase = 3:
					set top_obstacle_height to 54
				else if phase = 5:
					set top_obstacle_height to 40

				set obstacle_y to ground_y - obstacle_height
				set top_obstacle_bottom to ceiling_y + top_obstacle_height
				set player_draw_y to player_y as an integer
				set previous_player_draw_y to previous_player_y as an integer
				set player_bottom to player_draw_y + player_size
				set previous_player_bottom to previous_player_draw_y + player_size

				if player_x < obstacle_x + obstacle_width and player_x + player_size > obstacle_x:
					# Bottom platform collision + landing
					if player_draw_y < ground_y and player_bottom > obstacle_y:
						if y_velocity >= 0.0 and previous_player_bottom <= obstacle_y + 2:
							set player_y to (obstacle_y - player_size) as a float
							set y_velocity to 0.0
						else:
							set collided to 1

					# Ceiling obstacle collision / head bump
					if top_obstacle_height > 0 and player_draw_y < top_obstacle_bottom and player_bottom > ceiling_y:
						if y_velocity < 0.0 and previous_player_draw_y >= top_obstacle_bottom - 2:
							set player_y to top_obstacle_bottom as a float
							set y_velocity to 0.0
						else:
							set collided to 1

			set i to i + 1

		if collided:
			set game_over to 1
	else:
		if jump_input and not jump_lock:
			set player_y to player_ground_y
			set y_velocity to 0.0
			set distance to 0
			set score to 0
			set game_over to 0
			set jump_lock to 1
			set rhythm_index to 0
			set rhythm_elapsed_ms to 0
			set rhythm_jumped to 0
			set jump_buffer_ms to 0
		if not jump_input:
			set jump_lock to 0

	# Render
	clear screen
	draw rectangle at 0 0 size window_width window_height with color 13 15 28
	draw rectangle at 0 0 size window_width 120 with color 20 30 54
	draw rectangle at 0 120 size window_width 120 with color 16 24 44

	# Parallax blocks
	set stripe_shift to distance mod 200
	set sx to 0 - stripe_shift
	loop while sx < window_width:
		draw rectangle at sx 240 size 60 18 with color 30 56 100
		draw rectangle at sx + 70 220 size 32 38 with color 25 45 82
		draw rectangle at sx + 120 250 size 46 14 with color 36 63 112
		set sx to sx + 200

	# Ground / ceiling
	draw rectangle at 0 ground_y size window_width (window_height - ground_y) with color 40 40 50
	draw rectangle at 0 ground_y size window_width 6 with color 100 220 255
	draw rectangle at 0 0 size window_width ceiling_y with color 26 24 34
	draw rectangle at 0 ceiling_y size window_width 6 with color 200 120 160

	# Platforms
	set first_obstacle to (distance - obstacle_edge_margin - first_obstacle_offset) / obstacle_spacing
	if first_obstacle < 0:
		set first_obstacle to 0
	set i to 0
	loop while i < obstacle_scan_count:
		set obstacle_index to first_obstacle + i
		set world_x to obstacle_index * obstacle_spacing + first_obstacle_offset
		set obstacle_x to world_x - distance
		if obstacle_x > 0 - obstacle_edge_margin and obstacle_x < window_width + obstacle_edge_margin:
			set plan_i to obstacle_index mod trajectory_count
			set obstacle_level to item plan_i of trajectory_levels
			set obstacle_height to 54 + obstacle_level * step_unit
			set phase to plan_i mod 6
			set top_obstacle_height to 0
			if phase = 1:
				set top_obstacle_height to 30
			else if phase = 3:
				set top_obstacle_height to 54
			else if phase = 5:
				set top_obstacle_height to 40

			set obstacle_y to ground_y - obstacle_height
			draw rectangle at obstacle_x obstacle_y size obstacle_width obstacle_height with color 230 80 100
			draw rectangle at obstacle_x obstacle_y size obstacle_width 6 with color 255 200 120
			if top_obstacle_height > 0:
				draw rectangle at obstacle_x ceiling_y size obstacle_width top_obstacle_height with color 220 90 190
				draw rectangle at obstacle_x ceiling_y + top_obstacle_height - 6 size obstacle_width 6 with color 255 190 220
		set i to i + 1

	# Player
	set player_draw_y to player_y as an integer
	if game_over:
		draw rectangle at player_x player_draw_y size player_size player_size with color 255 120 120
	else:
		draw rectangle at player_x player_draw_y size player_size player_size with color 100 240 255
		draw rectangle at player_x + 6 player_draw_y + 6 size 8 8 with color 13 15 28

	# HUD
	draw text "SCORE" at 20 32 using font and color 200 220 255
	draw number score at 108 32 using font and color 255 255 255
	if not game_over:
		draw text "FOLLOW THE RHYTHM" at 20 66 using font and color 155 175 230
	else:
		draw rectangle at 220 110 size 560 170 with color 65 20 35
		draw text "CRASHED" at 430 170 using font and color 255 255 255
		draw text "PRESS JUMP TO RESTART" at 300 220 using font and color 255 210 210

	display the frame of window
	sleep for frame_sleep_ms milliseconds

close the window
print score as line
