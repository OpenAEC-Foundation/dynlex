import lib/array.dl
import tests/games/geometry_dash/generator.dl

function report step {integer:index} of {route plan:plan}:
	replacement:
		set step to the item at index in (plan's steps)
		ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "step=%ld level=%ld jump_ms=%ld slide_ms=%ld\n", index as a 64 bit integer, step's level as a 64 bit integer, step's jump duration as a 64 bit integer, step's slide duration as a 64 bit integer)
set plan to a route plan with 24 steps
fill plan using seed 1337

set index to 0
loop while index < plan's count:
	report step index of plan
	increment index
