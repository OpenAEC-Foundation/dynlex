import tests/games/shader_values.dl

# Julia set fragment shader — animated beautiful fractal
# DynLex entrypoint flags: --emit-spirv --shader-stage=fragment

set pixel to a planar position with x the fragment x coordinate and y the fragment y coordinate
set time to the shader time

# Map pixel to complex plane [-2, 2] x [-1.5, 1.5]
set orbit to a complex number with real (pixel's x / 200.0 - 2.0) and imaginary (pixel's y / 200.0 - 1.5)

# Animate Julia constant — orbits around interesting values
set constant to a complex number with real (0.0 - 0.8 + 0.2 * the sine of (time * 0.7)) and imaginary (0.156 + 0.15 * the cosine of (time * 0.5))

set iteration to 0
set limit to 200
set magnitude to (orbit's real part * orbit's real part) + (orbit's imaginary part * orbit's imaginary part)

while iteration < limit and magnitude < 4.0:
    set square to a complex number with real (orbit's real part * orbit's real part) and imaginary (orbit's imaginary part * orbit's imaginary part)
    set next to (square's real part - square's imaginary part) + constant's real part
    set the imaginary part of orbit to ((2.0 * orbit's real part) * orbit's imaginary part) + constant's imaginary part
    set the real part of orbit to next
    set iteration to iteration + 1
    set magnitude to (orbit's real part * orbit's real part) + (orbit's imaginary part * orbit's imaginary part)

if iteration = limit:
    set the fragment color with red 0.0, green 0.0, blue 0.0 and alpha 1.0
else:
    # Smooth coloring using sqrt for gradient
    set progress to (iteration as a float) / (limit as a float)
    set shade to the square root of progress
    set color to a light color with red shade, green (progress * progress), blue (the sine of (progress * 6.283) * 0.5 + 0.5) and alpha 1.0
    set the fragment color with red color's red, green color's green, blue color's blue and alpha color's alpha
