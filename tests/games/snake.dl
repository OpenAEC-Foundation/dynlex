# Snake Game in DynLex

import lib/font.dl
import lib/random.dl

# Game constants
set grid_size to 20
set cell_size to 20
set window_size to grid_size * cell_size
set max_length to grid_size * grid_size

# Direction constants
set dir_up to 1
set dir_right to 2
set dir_down to 3
set dir_left to 4

# Initialize
seed random with current time
set window to a new window with width window_size and height window_size
set font to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 24

# Snake body arrays
set snake_x to allocate max_length slots of an integer
set snake_y to allocate max_length slots of an integer

# Initialize snake at center, moving right
set snake_length to 3
store 10 into snake_x at 0
store 10 into snake_y at 0
store 9 into snake_x at 1
store 10 into snake_y at 1
store 8 into snake_x at 2
store 10 into snake_y at 2

set direction to dir_right
set food_x to 15
set food_y to 10
set game_over to false
set score to 0

# Main game loop
loop while not the window should close:
	set key to the pressed key of window

	# Update direction
	if key = 1:
		set direction to dir_up
	else if key = 2:
		set direction to dir_right
	else if key = 3:
		set direction to dir_down
	else if key = 4:
		set direction to dir_left
	else if key = 5:
		set game_over to true

	if not game_over:
		# Calculate new head position
		set new_x to item 0 of snake_x
		set new_y to item 0 of snake_y

		if direction = dir_up:
			set new_y to new_y - 1
		else if direction = dir_right:
			set new_x to new_x + 1
		else if direction = dir_down:
			set new_y to new_y + 1
		else if direction = dir_left:
			set new_x to new_x - 1

		# Check wall collision
		if new_x < 0 or new_x >= grid_size or new_y < 0 or new_y >= grid_size:
			set game_over to true

		# Check self collision
		if not game_over:
			set i to 0
			loop while i < snake_length:
				if item i of snake_x = new_x and item i of snake_y = new_y:
					set game_over to true
				set i to i + 1

		# Move snake
		if not game_over:
			# Grow if food eaten
			if new_x = food_x and new_y = food_y:
				set score to score + 1
				set food_x to a random number mod grid_size
				set food_y to a random number mod grid_size
				set snake_length to snake_length + 1

			# Shift body segments backward
			set i to snake_length - 1
			loop while i > 0:
				store item i - 1 of snake_x into snake_x at i
				store item i - 1 of snake_y into snake_y at i
				set i to i - 1

			store new_x into snake_x at 0
			store new_y into snake_y at 0

	# Render
	clear screen

	if not game_over:
		draw rectangle at 0 0 size window_size window_size with color 30 30 30

		# Draw food
		set fx to food_x * cell_size
		set fy to food_y * cell_size
		draw rectangle at fx fy size cell_size cell_size with color 200 0 0

		# Draw snake (head = bright green, body = dark green)
		set i to 0
		loop while i < snake_length:
			set px to item i of snake_x * cell_size
			set py to item i of snake_y * cell_size
			if i = 0:
				draw rectangle at px py size cell_size cell_size with color 0 200 0
			else:
				draw rectangle at px py size cell_size cell_size with color 0 150 0
			set i to i + 1

		# Draw score
		draw text "SCORE" at 4 20 using font and color 200 200 200
		draw number score at 100 20 using font and color 255 255 100
	else:
		draw rectangle at 0 0 size window_size window_size with color 80 20 20
		draw text "GAME OVER" at 60 180 using font and color 255 255 255
		draw text "SCORE" at 120 220 using font and color 200 200 200
		draw number score at 196 220 using font and color 255 255 100

	display the frame of window
	sleep for 150 milliseconds

close the window
print score as line
