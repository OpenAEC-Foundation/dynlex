# Snake Game in DynLex

import lib/font.dl
import lib/random.dl

class:
	patterns:
		[a|] board layout
	members:
		cells, scale, capacity, extent

class:
	patterns:
		[a|] grid position
	members:
		x, y

class:
	patterns:
		[a|] snake game
	members:
		body, length, direction, food, running, score

function a board with {integer:count} cells of {integer:scale} pixels each:
	replacement:
		@intrinsic("construct", a board layout, count, scale, count * count, count * scale)

function a grid position at x {integer:x} and y {integer:y}:
	replacement:
		@intrinsic("construct", a grid position, x, y)

function a snake game with {a pointer to a grid position:body} moving {integer:direction} toward {grid position:food}:
	replacement:
		@intrinsic("construct", a snake game, body, 3, direction, food, true, 0)

function {snake game:game} is running:
	execute:
		return game's running

function {grid position:position} is outside {board layout:board}:
	execute:
		if position's x < 0:
			return true
		if position's x >= board's cells:
			return true
		if position's y < 0:
			return true
		return position's y >= board's cells

function {grid position:position} overlaps {grid position:other}:
	execute:
		if position's x != other's x:
			return false
		return position's y = other's y

# Game constants
set board to a board with 20 cells of 20 pixels each

# Direction constants
set upward to 1
set rightward to 2
set downward to 3
set leftward to 4

# Initialize
seed the random number generator with the current time
set window to a new window with width board's extent and height board's extent
set typeface to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 24

# Snake body
allocate board's capacity slots of (a grid position at x 0 and y 0) and set body to it

# Initialize snake at center, moving right
store a grid position at x 10 and y 10 into body at 0
store a grid position at x 9 and y 10 into body at 1
store a grid position at x 8 and y 10 into body at 2
set game to a snake game with body moving rightward toward (a grid position at x 15 and y 10)

# Main game loop
loop while the window remains open:
	set key to the pressed key of window

	# Update direction
	if key = 1:
		set game's direction to upward
	else if key = 2:
		set game's direction to rightward
	else if key = 3:
		set game's direction to downward
	else if key = 4:
		set game's direction to leftward
	else if key = 5:
		set game's running to false

	if game is running:
		# Calculate new head position
		set head to the item at 0 in game's body

		if game's direction = upward:
			decrement head's y
		else if game's direction = rightward:
			increment head's x
		else if game's direction = downward:
			increment head's y
		else if game's direction = leftward:
			decrement head's x

		# Check wall collision
		if head is outside board:
			set game's running to false

		# Check self collision
		if game is running:
			set index to 0
			loop while index < game's length:
				set segment to the item at index in game's body
				if segment's x = head's x and segment's y = head's y:
					set game's running to false
				increment index

		# Move snake
		if game is running:
			# Grow if food eaten
			if head overlaps game's food:
				increment game's score
				set game's food to a grid position at x (the remainder of (a random number) divided by board's cells) and y (the remainder of (a random number) divided by board's cells)
				increment game's length

			# Shift body segments backward
			set index to (game's length - 1)
			loop while index > 0:
				store the item at (index - 1) in game's body into game's body at index
				decrement index

			store head into game's body at 0

	# Render
	clear the screen

	if game is running:
		draw a rectangle at x 0 and y 0 with width board's extent and height board's extent in color red 30, green 30 and blue 30

		# Draw food
		set food to game's food
		draw a rectangle at x (food's x * board's scale) and y (food's y * board's scale) with width board's scale and height board's scale in color red 200, green 0 and blue 0

		# Draw snake (head = bright green, body = dark green)
		set index to 0
		loop while index < game's length:
			set segment to the item at index in game's body
			set horizontal to (segment's x * board's scale)
			set vertical to (segment's y * board's scale)
			if index = 0:
				draw a rectangle at x horizontal and y vertical with width board's scale and height board's scale in color red 0, green 200 and blue 0
			else:
				draw a rectangle at x horizontal and y vertical with width board's scale and height board's scale in color red 0, green 150 and blue 0
			increment index

		# Draw score
		draw "SCORE" as text at x 4 and y 20 using typeface in color red 200, green 200 and blue 200
		draw game's score as a number at x 100 and y 20 using typeface in color red 255, green 255 and blue 100
	else:
		draw a rectangle at x 0 and y 0 with width board's extent and height board's extent in color red 80, green 20 and blue 20
		draw "GAME OVER" as text at x 60 and y 180 using typeface in color red 255, green 255 and blue 255
		draw "SCORE" as text at x 120 and y 220 using typeface in color red 200, green 200 and blue 200
		draw game's score as a number at x 196 and y 220 using typeface in color red 255, green 255 and blue 100

	display the frame of window
	sleep for 150 milliseconds

close the window
print game's score as a line
