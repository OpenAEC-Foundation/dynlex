# LEXI-8 console front end
#
# Assembles the Breakout program, boots the machine and presents it like a CRT:
# every emulated pixel is drawn as a glowing amber phosphor dot that fades
# over a few frames after it turns off. The status area reads the score
# and the lives straight out of the emulated registers while the game runs.
#
# Controls: left/right arrows (or A and D) move the paddle,
#           R reboots the console, escape quits.

import lib/graphics.dl
import lib/font.dl
import lib/random.dl
import tests/games/lexi8/chip8.dl
import tests/games/lexi8/breakout.dl

class:
	patterns:
		[a|] console display
	members:
		scale, playfield, status, phosphor

class:
	patterns:
		[a|] phosphor color
	members:
		red, green, blue

function a phosphor color with red {integer:red}, green {integer:green} and blue {integer:blue}:
	replacement:
		@intrinsic("construct", a phosphor color, red, green, blue)

function a console display at scale {integer:scale} with playfield {integer:playfield} and status area height {integer:status}, backed by {a pointer to a floating-point number:phosphor}:
	replacement:
		@intrinsic("construct", a console display, scale, playfield, status, phosphor)

allocate 2048 slots of 0.0 and set phosphor to it
set panel to a console display at scale 16 with playfield (32 * 16) and status area height 48, backed by phosphor

function the key code {integer:number} is down in {C string:window}:
	execute:
		return @intrinsic("call", "glfw", "glfwGetKey", an integer, window, number) = 1

function feed the pad from {C string:window}:
	execute:
		set left to 0
		if the key code 263 is down in window:
			set left to 1
		if the key code 65 is down in window:
			set left to 1
		set right to 0
		if the key code 262 is down in window:
			set right to 1
		if the key code 68 is down in window:
			set right to 1
		set machine key 4 to left
		set machine key 6 to right

function request that {C string:window} close:
	execute:
		@intrinsic("call", "glfw", "glfwSetWindowShouldClose", nothing, window, 1)

function render the phosphor screen:
	globals: panel
	execute:
		# Fade every cell toward darkness, snap lit cells to full brightness.
		set row to 0
		loop while row < 32:
			set column to 0
			loop while column < 64:
				set cell to (row * 64 + column)
				set brightness to ((the item at cell in panel's phosphor) * 0.76)
				if the machine pixel at column, row = 1:
					set brightness to 1.0
				store brightness into panel's phosphor at cell
				increment column
			increment row

		# Glow pass: a wide dim halo behind every visible cell.
		set row to 0
		loop while row < 32:
			set column to 0
			loop while column < 64:
				set brightness to the item at (row * 64 + column) in panel's phosphor
				if brightness > 0.05:
					set glow to a phosphor color with red ((105.0 * brightness) as an integer), green ((58.0 * brightness) as an integer) and blue ((12.0 * brightness) as an integer)
					draw a rectangle at x (column * (panel's scale) - 3) and y (row * (panel's scale) - 3) with width 22 and height 22 in color red glow's red, green glow's green and blue glow's blue
				increment column
			increment row

		# Core pass: the bright phosphor dot with a thin grid gap.
		set row to 0
		loop while row < 32:
			set column to 0
			loop while column < 64:
				set brightness to the item at (row * 64 + column) in panel's phosphor
				if brightness > 0.05:
					set core to a phosphor color with red ((255.0 * brightness) as an integer), green ((196.0 * brightness) as an integer) and blue ((98.0 * brightness) as an integer)
					draw a rectangle at x (column * (panel's scale) + 1) and y (row * (panel's scale) + 1) with width 14 and height 14 in color red core's red, green core's green and blue core's blue
				increment column
			increment row

seed the random number generator with the current time
build the breakout program
initialize the machine
load the assembled program into the machine

set window to a new window with width (64 * (panel's scale)) and height ((panel's playfield) + (panel's status))
set typeface to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 24

loop while the window remains open:
	if the key code 256 is down in window:
		request that window close
	if the key code 82 is down in window:
		initialize the machine
		load the assembled program into the machine

	feed the pad from window
	step the machine 32 times
	tick the machine timers

	clear the screen
	draw a rectangle at x 0 and y 0 with width 1024 and height panel's playfield in color red 9, green 7 and blue 12
	render the phosphor screen

	draw a rectangle at x 0 and y panel's playfield with width 1024 and height panel's status in color red 24, green 18 and blue 28
	draw a rectangle at x 0 and y panel's playfield with width 1024 and height 2 in color red 92, green 60 and blue 24
	draw "LEXI-8 BREAKOUT" as text at x 16 and y ((panel's playfield) + 32) using typeface in color red 255, green 196 and blue 98
	draw "SCORE" as text at x 330 and y ((panel's playfield) + 32) using typeface in color red 160, green 130 and blue 90
	draw (the machine register 8) as a number at x 430 and y ((panel's playfield) + 32) using typeface in color red 255, green 220 and blue 140
	draw "LIVES" as text at x 530 and y ((panel's playfield) + 32) using typeface in color red 160, green 130 and blue 90
	draw (the machine register 10) as a number at x 630 and y ((panel's playfield) + 32) using typeface in color red 255, green 220 and blue 140
	draw "ARROWS MOVE - R RESET" as text at x 700 and y ((panel's playfield) + 32) using typeface in color red 120, green 100 and blue 80

	display the frame of window
	sleep for 16 milliseconds

close the window
