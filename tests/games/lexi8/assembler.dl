# LEXI-8 assembler
#
# A natural-language CHIP-8 assembler embedded in DynLex. Every statement
# below is an ordinary DynLex pattern that appends bytecode to the program.
# Labels may be referenced before they are defined; `resolve all labels`
# patches every recorded forward reference afterwards.

import lib/std.dl
import lib/array.dl

# --- Assembler state ---

class:
	patterns:
		assembled program
	members:
		bytes, cursor

class:
	patterns:
		label table
	members:
		names, addresses, count

class:
	patterns:
		fixup table
	members:
		offsets, names, count

class:
	patterns:
		assembly state
	members:
		program, labels, fixups

function an assembled program with {a pointer to an integer:bytes} and cursor {integer:cursor}:
	replacement:
		@intrinsic("construct", assembled program, bytes, cursor)

function a label table using {a pointer to a C string:names} and {a pointer to an integer:addresses} with count {integer:count}:
	replacement:
		@intrinsic("construct", label table, names, addresses, count)

function a fixup table using {a pointer to an integer:offsets} and {a pointer to a C string:names} with count {integer:count}:
	replacement:
		@intrinsic("construct", fixup table, offsets, names, count)

function an assembly state with {assembled program:program}, {label table:labels} and {fixup table:fixups}:
	replacement:
		@intrinsic("construct", assembly state, program, labels, fixups)

allocate 3584 slots of an integer and set bytes to it
allocate 128 slots of "unnamed" and set names to it
allocate 128 slots of an integer and set addresses to it
allocate 512 slots of an integer and set offsets to it
allocate 512 slots of "unnamed" and set symbols to it
set program to an assembled program with bytes and cursor 0
set labels to a label table using names and addresses with count 0
set fixups to a fixup table using offsets and symbols with count 0
set assembler to an assembly state with program, labels and fixups

# CHIP-8 programs are loaded at address 512, so byte n lives there.
function the current assembly address:
	globals: assembler
	execute:
		return 512 + assembler's program's cursor

function the assembled program size:
	globals: assembler
	execute:
		return assembler's program's cursor

function the assembled program byte at {integer:offset}:
	globals: assembler
	execute:
		return the item at offset in assembler's program's bytes

function reset the assembly state:
	globals: assembler
	execute:
		set assembler's program's cursor to 0
		set assembler's labels's count to 0
		set assembler's fixups's count to 0

# --- Byte emission ---

function emit a program byte {integer:value}:
	globals: assembler
	execute:
		store (value bitwise and 255) into assembler's program's bytes at assembler's program's cursor
		increment assembler's program's cursor

function emit an opcode with high byte {integer:high} and low byte {integer:low}:
	execute:
		emit a program byte high
		emit a program byte low

# --- Labels and fixups ---

function label {C string:name}:
	globals: assembler
	execute:
		store name into assembler's labels's names at assembler's labels's count
		store the current assembly address into assembler's labels's addresses at assembler's labels's count
		increment assembler's labels's count

function the address of label {C string:name}:
	globals: assembler
	execute:
		set index to 0
		loop while index < assembler's labels's count:
			if the item at index in assembler's labels's names = name:
				return the item at index in assembler's labels's addresses
			increment index
		return the negative of 1

# Emits `top nnn` with nnn unknown; records the spot so `resolve all labels`
# can patch the 12 bit address in later.
function emit an opcode with top nibble {integer:top} addressing label {C string:name}:
	globals: assembler
	execute:
		store assembler's program's cursor into assembler's fixups's offsets at assembler's fixups's count
		store name into assembler's fixups's names at assembler's fixups's count
		increment assembler's fixups's count
		emit an opcode with high byte (top shifted left by 4) and low byte 0

function resolve [all|] labels:
	globals: assembler
	execute:
		set index to 0
		loop while index < assembler's fixups's count:
			set name to the item at index in assembler's fixups's names
			set target to the address of label name
			if target < 0:
				print "assembler error: unknown label" as a line
				print name as a line
				@intrinsic("call", "libc", "exit", nothing, 1)
			set offset to the item at index in assembler's fixups's offsets
			store ((the item at offset in assembler's program's bytes) bitwise or ((target shifted right by 8) bitwise and 15)) into assembler's program's bytes at offset
			store (target bitwise and 255) into assembler's program's bytes at offset + 1
			increment index

# --- Instruction statements ---
# Register numbers run from 0 through 15; expressions are allowed, so games
# can name their register roles with ordinary DynLex variables.

# 00E0
function clear the display:
	execute:
		emit an opcode with high byte 0 and low byte 224

# 00EE
function end the routine:
	execute:
		emit an opcode with high byte 0 and low byte 238

# 1nnn
function jump to label {C string:name}:
	execute:
		emit an opcode with top nibble 1 addressing label name

# 2nnn
function run the routine named {C string:name}:
	execute:
		emit an opcode with top nibble 2 addressing label name

# 3xnn
function skip when register {integer:target} equals {integer:value}:
	execute:
		emit an opcode with high byte (48 bitwise or target) and low byte value

# 4xnn
function skip when register {integer:target} differs from {integer:value}:
	execute:
		emit an opcode with high byte (64 bitwise or target) and low byte value

# 5xy0
function skip when register {integer:target} matches register {integer:source}:
	execute:
		emit an opcode with high byte (80 bitwise or target) and low byte (source shifted left by 4)

# 9xy0
function skip when register {integer:target} differs from register {integer:source}:
	execute:
		emit an opcode with high byte (144 bitwise or target) and low byte (source shifted left by 4)

# 6xnn
function load value {integer:value} into register {integer:target}:
	execute:
		emit an opcode with high byte (96 bitwise or target) and low byte value

# 7xnn (adds modulo 256, so 254 means "subtract 2")
function raise register {integer:target} by {integer:value}:
	execute:
		emit an opcode with high byte (112 bitwise or target) and low byte value

# 8xy0
function copy register {integer:source} into register {integer:target}:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte (source shifted left by 4)

# 8xy1
function combine register {integer:target} with register {integer:source} using bitwise or:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 1)

# 8xy2
function combine register {integer:target} with register {integer:source} using bitwise and:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 2)

# 8xy3
function combine register {integer:target} with register {integer:source} using bitwise xor:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 3)

# 8xy4 (carry lands in register 15)
function add register {integer:source} into register {integer:target}:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 4)

# 8xy5 (borrow flag lands in register 15)
function subtract register {integer:source} from register {integer:target}:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 5)

# 8xy6
function shift register {integer:target} right:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((target shifted left by 4) bitwise or 6)

# 8xy7
function replace register {integer:target} with register {integer:source} minus it:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((source shifted left by 4) bitwise or 7)

# 8xyE
function shift register {integer:target} left:
	execute:
		emit an opcode with high byte (128 bitwise or target) and low byte ((target shifted left by 4) bitwise or 14)

# Annn
function point index at label {C string:name}:
	execute:
		emit an opcode with top nibble 10 addressing label name

# Bnnn
function jump to label {C string:name} plus register zero:
	execute:
		emit an opcode with top nibble 11 addressing label name

# Cxnn
function randomize register {integer:target} masked by {integer:value}:
	execute:
		emit an opcode with high byte (192 bitwise or target) and low byte value

# Dxyn
function draw {integer:count} [row|rows] at horizontal register {integer:horizontal} and vertical register {integer:vertical}:
	execute:
		emit an opcode with high byte (208 bitwise or horizontal) and low byte ((vertical shifted left by 4) bitwise or count)

# Ex9E
function skip when key in register {integer:target} is down:
	execute:
		emit an opcode with high byte (224 bitwise or target) and low byte 158

# ExA1
function skip when key in register {integer:target} is up:
	execute:
		emit an opcode with high byte (224 bitwise or target) and low byte 161

# Fx07
function load the delay into register {integer:target}:
	execute:
		emit an opcode with high byte (240 bitwise or target) and low byte 7

# Fx0A
function wait for a key and store it in register {integer:target}:
	execute:
		emit an opcode with high byte (240 bitwise or target) and low byte 10

# Fx15
function start the delay from register {integer:source}:
	execute:
		emit an opcode with high byte (240 bitwise or source) and low byte 21

# Fx18
function start the sound from register {integer:source}:
	execute:
		emit an opcode with high byte (240 bitwise or source) and low byte 24

# Fx1E
function add register {integer:source} to the index:
	execute:
		emit an opcode with high byte (240 bitwise or source) and low byte 30

# Fx29
function point the index at the digit sprite in register {integer:source}:
	execute:
		emit an opcode with high byte (240 bitwise or source) and low byte 41

# Fx33
function store the decimal digits of register {integer:source}:
	execute:
		emit an opcode with high byte (240 bitwise or source) and low byte 51

# Fx55 (stores register 0 through the selected final register)
function save all registers through register {integer:last}:
	execute:
		emit an opcode with high byte (240 bitwise or last) and low byte 85

# Fx65 (loads register 0 through the selected final register)
function restore all registers through register {integer:last}:
	execute:
		emit an opcode with high byte (240 bitwise or last) and low byte 101

# --- Data statements ---

function emit a data byte {integer:value}:
	execute:
		emit a program byte value

# Sprite art: an 8 character picture row, `X` for a lit pixel.
function emit a data row {C string:picture}:
	execute:
		set value to 0
		set index to 0
		loop while index < 8:
			set glyph to (the character at index in picture) as an integer
			if glyph = 0:
				set index to 8
			else:
				if glyph = 88:
					set value to value bitwise or (128 shifted right by index)
				increment index
		emit a program byte value
