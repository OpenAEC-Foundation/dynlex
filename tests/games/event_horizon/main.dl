import lib/graphics.dl
import tests/games/three_dimensional.dl

# EVENT HORIZON — interactive procedural black hole
#
# WASD or arrows move the camera. Move the mouse to shift the lens.
# Click to send a gravitational shockwave. R recenters. Escape closes.

class:
    patterns:
        [a|] horizon resource set
    members:
        program as a shader program

function a horizon resource set owning {shader program:program}:
    replacement:
        @intrinsic("construct", a horizon resource set, program)

function read the cursor from {pointer:window} into {spatial position:position}:
    execute:
        set {pointer position} to the cursor position of window
        set the x coordinate of position to pointer position's x
        set the y coordinate of position to pointer position's y

function mouse button {integer:number} is down in {pointer:window}:
    execute:
        return a mouse button numbered number is pressed in window

flex function release {horizon resource set:resources}:
    replacement:
        release resources's program

set window to a new window with width 1280 and height 720
set the title of window to "EVENT HORIZON  |  WASD/arrows: move  |  mouse: bend  |  click: pulse  |  R: center"
preserve mouse clicks in window

set program to a shader program for window using vertex shader at "tests/games/event_horizon/vertex.spv" and fragment shader at "tests/games/event_horizon/horizon.spv"
set resources to a horizon resource set owning program

set click to (0.0 - 10.0)
set ready to true
set view to a camera at (a position with x 0.0, y 0.0 and z 0.0) facing 0.0 degrees with speed 0.72 and turn rate 0.0
set previous to the time since start for window

while window remains open:
    set time to the time since start for window
    set elapsed to (time - previous)
    set previous to time
    clamp elapsed between 0.0 and 0.1
    set movement to (elapsed * view's movement)

    set left to key (the A key) is down in window or key (the left arrow key) is down in window
    set right to key (the D key) is down in window or key (the right arrow key) is down in window
    set up to key (the W key) is down in window or key (the up arrow key) is down in window
    set down to key (the S key) is down in window or key (the down arrow key) is down in window
    if left:
        decrease the x coordinate of view's position by movement
    if right:
        increase the x coordinate of view's position by movement
    if up:
        increase the y coordinate of view's position by movement
    if down:
        decrease the y coordinate of view's position by movement
    set the x coordinate of view's position to (view's position's x clamped between (0.0 - 0.82) and 0.82)
    set the y coordinate of view's position to (view's position's y clamped between (0.0 - 0.52) and 0.52)
    if key 82 is down in window:
        set the x coordinate of view's position to 0.0
        set the y coordinate of view's position to 0.0

    set width to the framebuffer width of window
    set height to the framebuffer height of window

    set mouse to a position with x 0.0, y 0.0 and z 0.0
    read the cursor from window into mouse

    set pressed to mouse button 0 is down in window
    if pressed:
        if ready:
            set click to time
        set ready to false
    else:
        set ready to true

    if key (the escape key) is down in window:
        request that window close

    set frame to a new graphics frame in window
    use resources's program in frame
    set uniform binding 0 in frame to time
    set uniform binding 1 in frame to width
    set uniform binding 2 in frame to height
    set uniform binding 3 in frame to mouse's x
    set uniform binding 4 in frame to mouse's y
    set uniform binding 5 in frame to time - click
    set uniform binding 6 in frame to view's position's x
    set uniform binding 7 in frame to view's position's y
    draw a fullscreen surface in frame
    display frame

release resources
close the window
