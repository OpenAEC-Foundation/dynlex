import tests/games/gallery/painting.dl

to explore shaders in {UI reference:description} starting with {integer:selection}:
    set session to a new gallery session
    set session's selected to selection
    set session's pulse to -10.0
    set interface to an instance of description with state (the address of session)
    bind (the control labeled "Study" in (the address of interface)) in (the address of interface) to (the function named "paint the gallery on $") for event 1
    set view to a native view of (the address of interface) sized 1280 by 780 using fonts "tests/games/fonts/NotoSans-Regular.ttf" and "tests/games/fonts/NotoSans-SemiBold.ttf"
    set session's view to (the address of view) as a pointer
    set paths to ["build/games/shaders/mandelbrot.spv", "build/games/shaders/plasma.spv", "build/games/shaders/julia.spv", "build/games/shaders/rings.spv", "build/games/shaders/horizon.spv"]
    for each path at index in paths:
        store (a shader program for (view's window) using vertex shader at "build/games/shaders/vertex.spv" and fragment shader at path) into session's programs at index
    set names to ["MANDELBROT", "PLASMA", "JULIA", "RINGS", "EVENT HORIZON"]
    set pause, reset, left, right and click to false
    render the address of view
    set previous to the time since start for view's window
    loop while view's window remains open:
        poll window events
        set window to view's window
        set now to the time since start for window
        set pressed to key (the space key) is down in window
        if pressed and not pause:
            set session's paused to not session's paused
            if session's paused:
                show page "paused" in the address of interface
            else:
                show page "playing" in the address of interface
        set pause to pressed
        set pressed to key (the R key) is down in window
        if pressed and not reset:
            set session's elapsed to 0.0
            set session's camera x and session's camera y to 0.0
            set session's pulse to -10.0
        set reset to pressed
        set pressed to key (the left arrow key) is down in window
        if pressed and not left:
            set session's selected to (session's selected + 4) mod 5
        set left to pressed
        set pressed to key (the right arrow key) is down in window
        if pressed and not right:
            set session's selected to (session's selected + 1) mod 5
        set right to pressed
        if key (the escape key) is down in window:
            request that window close
        if not session's paused:
            add (now - previous) to session's elapsed
            if session's selected = 4:
                set movement to (the minimum of 0.1 and (now - previous)) * 0.72
                if key (the A key) is down in window:
                    subtract movement from session's camera x
                if key (the D key) is down in window:
                    add movement to session's camera x
                if key (the W key) is down in window:
                    add movement to session's camera y
                if key (the S key) is down in window:
                    subtract movement from session's camera y
                clamp session's camera x between -0.82 and 0.82
                clamp session's camera y between -0.52 and 0.52
        set cursor to the UI cursor in (the address of view)
        set box to session's bounds
        set inside to (cursor's x from (box's x) until (box's x + box's width)) and (cursor's y from (box's y) until (box's y + box's height))
        set pressed to false
        if inside and (session's selected = 4):
            set pressed to a mouse button numbered 0 is pressed in window
            if pressed and ((not click) and not session's paused):
                set session's pulse to session's elapsed
        set click to pressed
        set previous to now
        set the text of "Current study" in (the address of interface) to the item at (session's selected) in names
        render the address of view
        sleep for 4 milliseconds
    loop index from 0 to the length of session's programs:
        release the item at index in (session's programs)
    close the address of view
    close the address of interface
