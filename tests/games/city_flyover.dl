import tests/games/studio/application.dl
import tests/games/city/scene.dl

to paint the city on {a pointer to UI canvas frame:canvas}:
    set session to the spatial study in (canvas's instance)
    set view to session's camera
    set frame to canvas's frame
    use a perspective of 70.0 degrees from 0.4 to 1400.0 on canvas
    position the flyover camera from view in frame
    set ground to a position with x (view's position's x), y 0.0 and z (view's position's z)
    draw a box centered at ground with (the dimensions measuring 1400.0 by 0.02 by 1400.0) and (a color with red 92, green 112 and blue 88) in frame
    set region to a position with x (the floor of (view's position's x / the city block size)), y 0.0 and z (the floor of (view's position's z / the city block size))
    set row to region's z - 4.0
    while row <= region's z + 4.0:
        set column to region's x - 4.0
        while column <= region's x + 4.0:
            set center to a position with x ((column + 0.5) * the city block size), y 0.0 and z ((row + 0.5) * the city block size)
            if (the squared distance from center to view's position) < 1100000.0:
                if (column from (region's x - 1.0) through (region's x + 1.0)) and (row from (region's z - 1.0) through (region's z + 1.0)):
                    draw a block at grid position column, row at (session's elapsed) with detail level 0.0 in frame
                else:
                    draw a distant block silhouette at grid position column, row in frame
            add 1.0 to column
        add 1.0 to row

set session to a new spatial study from (a camera at (a position with x 0.0, y 8.0 and z 24.0) facing 0.0 degrees with speed 1.15 and turn rate 2.4)
set session's minimum altitude to 2.4
set session's background to UI ink 173 204 242
set session's painter to (the function named "paint the city on $") as a pointer
explore (the address of session) named "City flyover" in spatial studio
