# Test text rendering

import lib/font.dl

set window to a new window with width 400 and height 300
set typeface to a loaded font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 32
enable text rendering
draw "Hello DynLex!" as text at x 20 and y 100 using typeface in color red 255, green 255 and blue 255
disable text rendering
display the frame of window
sleep for 3000 milliseconds
