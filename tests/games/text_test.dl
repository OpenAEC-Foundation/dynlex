# Test text rendering

import lib/font.dl

set window to a new window with width 400 and height 300
set typeface to a font loaded from "tests/games/fonts/LiberationMono-Regular.ttf" at size 32 for window
set frame to a new graphics frame in window
use screen coordinates in frame
draw "Hello DynLex!" as text at x 20 and y 100 using typeface in color red 255, green 255 and blue 255 in frame
display frame
sleep for 3000 milliseconds
release typeface
close window
