import lib/ui_native.dl

window typography studio:
    group at 40 32 sized 720 by 64:
        brand "TYPE / DYNLEX"
        caption "A STUDY IN CLARITY"
    panel at 40 128 sized 720 by 432:
        eyebrow "SIMPLE WORDS. PRECISE SHAPES."
        space of 20 pixels
        title "Hello,"
        accent title "DynLex."
        space of 12 pixels
        heading "Room for every idea."
        label "From small captions to large headlines, one interface language."
        caption "NOTO SANS / REGULAR + SEMIBOLD"
    group at 40 584 sized 720 by 24:
        caption "RESIZE THE WINDOW TO EXPLORE THE TYPE     ESC  CLOSE"
    style:
        the interface uses a "midnight" theme
        the interface fits 800 by 640 pixels
        the window is at least 600 by 480 pixels

set interface to an instance of typography studio
set view to a native view of (the address of interface) sized 800 by 640 using fonts "tests/games/fonts/NotoSans-Regular.ttf" and "tests/games/fonts/NotoSans-SemiBold.ttf"
loop while view's window remains open:
    poll window events
    if key (the escape key) is down in (view's window):
        request that view's window close
    render the address of view
    sleep for 4 milliseconds
close the address of view
close the address of interface
