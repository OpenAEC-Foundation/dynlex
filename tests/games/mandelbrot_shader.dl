import lib/shader.dl

# Animated Mandelbrot fragment shader — zooms into the fractal
# DynLex entrypoint flags: --emit-spirv --shader-stage=fragment

set px to the fragment x coordinate
set py to the fragment y coordinate
set t to the shader time

# Animated zoom: oscillate zoom level with time
set zoom_sin to the sine of (t * 0.3)
set zoom to 1.0 + 2.0 * zoom_sin * zoom_sin
set zoom to zoom * zoom * zoom

# Zoom target: Seahorse Valley area (-0.745, 0.186)
set center_x to 0.0 - 0.745
set center_y to 0.186

# Map pixel to complex plane centered on zoom target
set cx to center_x + (px / 800.0 * 3.0 - 1.5) / zoom
set cy to center_y + (py / 600.0 * 3.0 - 1.5) / zoom

set zx to 0.0
set zy to 0.0
set iteration to 0
set max_iterations to 100

while iteration < max_iterations and zx * zx + zy * zy < 4.0:
    set tmp to zx * zx - zy * zy + cx
    set zy to 2.0 * zx * zy + cy
    set zx to tmp
    set iteration to iteration + 1

# Color based on iteration count
set tf to iteration as a float / max_iterations as a float
if iteration = max_iterations:
    set the fragment color to 0.0 0.0 0.0 1.0
else:
    set the fragment color to tf 0.5 * tf 1.0 - tf 1.0
