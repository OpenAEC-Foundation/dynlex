import tests/games/shader_values.dl

# Animated Mandelbrot fragment shader — zooms into the fractal
# DynLex entrypoint flags: --emit-spirv --shader-stage=fragment

set pixel to a planar position with x the fragment x coordinate and y the fragment y coordinate
set time to the shader time

# Animated zoom: oscillate zoom level with time
set wave to the sine of (time * 0.3)
set zoom to (1.0 + ((2.0 * wave) * wave))
set zoom to ((zoom * zoom) * zoom)

# Zoom target: Seahorse Valley area (-0.745, 0.186)
set center to a complex number with real (0.0 - 0.745) and imaginary 0.186

# Map pixel to complex plane centered on zoom target
set coordinate to a complex number with real (center's real part + (pixel's x / 800.0 * 3.0 - 1.5) / zoom) and imaginary (center's imaginary part + (pixel's y / 600.0 * 3.0 - 1.5) / zoom)

set orbit to a complex number with real 0.0 and imaginary 0.0
set iteration to 0
set limit to 100
set magnitude to ((orbit's real part * orbit's real part) + (orbit's imaginary part * orbit's imaginary part))

while iteration < limit and magnitude < 4.0:
    set next to (((orbit's real part * orbit's real part) - (orbit's imaginary part * orbit's imaginary part)) + coordinate's real part)
    set the imaginary part of orbit to (((2.0 * orbit's real part) * orbit's imaginary part) + coordinate's imaginary part)
    set the real part of orbit to next
    set iteration to (iteration + 1)
    set magnitude to ((orbit's real part * orbit's real part) + (orbit's imaginary part * orbit's imaginary part))

# Color based on iteration count
set progress to ((iteration as a float) / (limit as a float))
if iteration = limit:
    set the fragment color with red 0.0, green 0.0, blue 0.0 and alpha 1.0
else:
    set color to a light color with red progress, green (0.5 * progress), blue (1.0 - progress) and alpha 1.0
    set the fragment color with red color's red, green color's green, blue color's blue and alpha color's alpha
