import lib/std.dl

class:
    patterns:
        point
    members:
        x
        y

macro expression new point with x px and y py:
    replacement:
        @intrinsic("construct", point, px, py)

set p to new point with x 10 and y 20
print the x of p as line
print p's y as line
print the x of p + the y of p as line

# Type cast tests
print 3.14 as an integer as line
print 42 as a 16 bit integer as line
print 7 as a byte as line
print 100 as a float as line
