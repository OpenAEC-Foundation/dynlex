import lib/events.dl

set squares to a synchronous event receiving integer returning integer
when squares is requested:
    return this request * this request
print (request 9 from squares) as a line

set greetings to a synchronous event receiving string returning string
when greetings is requested:
    return this request + "!"
print (request (the string form of "Hello") from greetings) as a line

set other to a synchronous event receiving integer returning integer
when other is requested:
    return this request + 1
print (request 9 from other) as a line
print (request 9 from squares) as a line

when squares is requested:
    return this request + 10
print (request 9 from squares) as a line

set notices to a synchronous event receiving (a pointer to integer) returning nothing
when notices is requested:
    store (the value at this request) + 1 at this request
set count to 0
request (the address of count) from notices
print count as a line

to get a greeting counted by {a pointer to integer:counter}:
    store (the value at counter) + 1 at counter
    return "Hi"
print (request (a greeting counted by (the address of count)) from greetings) as a line
print count as a line
