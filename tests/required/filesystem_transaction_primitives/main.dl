import lib/filesystem.dl
import lib/process.dl

set root to "tests/required/filesystem_transaction_primitives/tree.tmp"
set source to "tests/required/filesystem_transaction_primitives/tree.tmp/original.bin"
set missing to "tests/required/filesystem_transaction_primitives/tree.tmp/missing.bin"
set copy to "tests/required/filesystem_transaction_primitives/tree.tmp/copied.bin"
set destination to "tests/required/filesystem_transaction_primitives/tree.tmp/durable.bin"
set windows to the process platform is Windows

remove the filesystem tree at root
create a directory tree at root and set created to it
print whether created succeeded as a line

set absence to the file system entry at missing
print whether absence is supported as a line
print whether absence lookup succeeded as a line
print whether absence was absent as a line
print whether (the length of absence's error message) = 0 as a line

write the string form of "old" to the file at source
set original to the file system entry at source
print whether original lookup succeeded as a line
print whether original was found as a line
print whether original is a regular file as a line
print whether original is not a directory as a line
print whether original is not a symbolic link as a line
print whether original does not have another filesystem kind as a line
print whether original supports modification times as a line
print whether (original's modification time)'s nanoseconds >= 0 as a line
print whether (original's modification time)'s nanoseconds < 1000000000 as a line
print whether original's identity is supported as a line
print whether original's identity is available as a line

if windows:
    print whether original's mode is unsupported as a line
    print whether original's Windows attributes are supported as a line
    print whether original's Windows attributes >= 0 as a line
    print whether original's Windows attributes <= 4294967295 as a line
else:
    print whether original's mode is supported as a line
    print whether original's Windows attributes are unsupported as a line
    print whether original's mode >= 0 as a line
    print whether original's mode <= 4095 as a line

set unchanged to the file system entry at source
print whether original's identity identifies the same file as unchanged's identity as a line

set exact to a new string buffer containing 2 bytes
store 0 as a byte into the data of exact at 0
store 255 as a byte into the data of exact at 1
set identity to @intrinsic("construct", a file identity, true, true, exact)
set identical to @intrinsic("construct", a file identity, true, true, exact)
print whether identity identifies the same file as identical as a line

create a staging file beside exact and set invalid to it
set message to invalid's error message
print whether invalid is supported as a line
print whether invalid failed as a line
print whether the length of message > 0 as a line

create a staging file beside source and set staging to it
write the string form of "refused" to staging and set staging to it
print whether staging is supported as a line
print whether staging succeeded as a line

commit staging where overwriting is false and durability is false and set refused to it
print whether refused is supported as a line
print whether refused's commit outcome is known as a line
print whether refused was not committed as a line
print whether refused failed as a line
print whether refused's cleanup succeeded as a line
read the file at source and print whether (it succeeded) and ((the contents of it) = "old") as a line

create a staging file beside source and set first to it
write the string form of "first" to first and set first to it
write the string form of "second" to first and set second to it
print whether first succeeded as a line
print whether second succeeded as a line
restore metadata from original to second and set restored to it
print whether restored is supported as a line
print whether restored succeeded as a line
commit restored where overwriting is true and durability is false and set committed to it
if committed failed:
    print committed's error message as a line
print whether committed is supported as a line
print whether committed succeeded as a line
print whether committed's commit outcome is known as a line
print whether committed was committed as a line
print whether committed is not durable as a line
print whether committed's cleanup succeeded as a line

set replaced to the file system entry at source
if windows:
    print whether replaced's restorable Windows attributes = original's restorable Windows attributes as a line
else:
    print whether replaced's mode = original's mode as a line
print whether (replaced's access time)'s seconds = (original's access time)'s seconds as a line
print whether (replaced's access time)'s nanoseconds = (original's access time)'s nanoseconds as a line
print whether (replaced's modification time)'s seconds = (original's modification time)'s seconds as a line
print whether (replaced's modification time)'s nanoseconds = (original's modification time)'s nanoseconds as a line
read the file at source and print whether it succeeded as a line
print whether ((the contents of it) = "firstsecond") as a line

create a staging file beside copy and set cancellation to it
set pathname to cancellation's path
cancel cancellation and set cancelled to it
print whether cancelled is supported as a line
print whether cancelled succeeded as a line
print whether cancelled's cleanup succeeded as a line
set remnant to the file system entry at pathname
print whether remnant is supported as a line
print whether remnant lookup succeeded as a line
print whether remnant was absent as a line
print whether (the length of remnant's error message) = 0 as a line

set replacement to the string form of "new"
create a staging file beside copy and set temporary to it
write replacement to temporary and set temporary to it
commit temporary where overwriting is false and durability is false and set publication to it
if publication failed:
    print publication's error message as a line
print whether publication succeeded as a line
print whether publication was committed as a line
print whether publication's cleanup succeeded as a line
read the file at copy and print whether (it succeeded) and ((the contents of it) = "new") as a line

create a staging file beside destination and set staging to it
write the string form of "durable" to staging and set staging to it
commit staging where overwriting is false and durability is true and set commit to it
if windows:
    print whether commit is unsupported as a line
    print whether commit's commit outcome is known as a line
    print whether commit was not committed as a line
    print whether commit's cleanup succeeded as a line
    set metadata to the file system entry at staging's path
    print whether (metadata lookup succeeded) and (metadata was absent) as a line
else:
    print whether commit is supported as a line
    print whether commit succeeded as a line
    print whether commit's commit outcome is known as a line
    print whether commit is durable as a line
    print whether commit's cleanup succeeded as a line

remove the filesystem tree at root and set cleaned to it
print whether cleaned succeeded as a line
