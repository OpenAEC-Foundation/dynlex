function [a|] thirty two bit integer:
    replacement:
        @intrinsic("type", "int", 32)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

class:
    patterns:
        [a|] managed token
    members:
        payload as a thirty two bit integer
    retain:
        ignore @intrinsic("lifecycle value")
    release:
        ignore @intrinsic("lifecycle value")

set token to @intrinsic("construct", a managed token, 7)
