integer means: @intrinsic("type", "int")
text means: @intrinsic("add pointer depth", @intrinsic("type", "int", 8))
the type of value means: @intrinsic("type of", value)
implicitly convert {integer:value}:
    execute:
        @intrinsic("return", @intrinsic("select", @intrinsic("equal", value, 7), "7", "0"))
to get measured {text:value}:
    @intrinsic("return", @intrinsic("cast", @intrinsic("dereference", value), integer))
to get sample:
    @intrinsic("return", measured 7)
class:
    patterns:
        container
    members:
        value as the type of sample
implicitly convert {container:item}:
    execute:
        @intrinsic("return", @intrinsic("select", @intrinsic("equal", item's value, 9), "9", "0"))
@intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, sample))
@intrinsic("store", item, @intrinsic("construct", container, 9))
@intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, measured item))
