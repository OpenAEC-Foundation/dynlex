import std.dl
set variable to 3

if variable < 2:
	print "variable is less than 4" as a line
else if variable < 4:
	print "variable is less than 4" as a line
else:
	print "variable is not less than 4" as a line

match based on variable:
	case 1:
		print "variable is 1" as a line
	case 2:
		print "variable is 2" as a line
	case 3:
		print "variable is 3" as a line
	case 4:
		print "variable is 4" as a line

