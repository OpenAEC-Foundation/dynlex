import lib/std.dl

# test: recursive function (factorial)
function the factorial of number:
    execute:
        if number is less than or equal to 1:
            return 1
        set predecessor to number - 1
        return number * the factorial of predecessor

print the factorial of 5 as a line
print the factorial of 10 as a line

# test: mutual recursion (even parity / odd parity)
function number has even parity:
    execute:
        if number = 0:
            return 1
        return number - 1 has odd parity

function number has odd parity:
    execute:
        if number = 0:
            return 0
        return number - 1 has even parity

print whether (4 has even parity) as a line
print whether (7 has even parity) as a line

# exception case: base return appears after the recursive return path
function number has even parity under inversion:
    execute:
        if number is not 0:
            return number - 1 has odd parity under inversion
        return 1

function number has odd parity under inversion:
    execute:
        if number is not 0:
            return number - 1 has even parity under inversion
        return 0

print whether (4 has even parity under inversion) as a line
print whether (7 has even parity under inversion) as a line

# exception case: recursive call is used in a nested condition before base return
function number has even parity through nested recursion:
    execute:
        if number is not 0:
            if (number - 1) has odd parity through nested recursion:
                return true
            else:
                return false
        return true

function number has odd parity through nested recursion:
    execute:
        if number is not 0:
            return (number - 1) has even parity through nested recursion
        return false

print whether (4 has even parity through nested recursion) as a line
print whether (7 has even parity through nested recursion) as a line
