import lib/std.dl

# test: recursive function (factorial)
to get the factorial of number:
    if number is less than or equal to 1:
        return 1
    set predecessor to (number - 1)
    return number * the factorial of predecessor

print lines (the factorial of 5) and (the factorial of 10)

# test: mutual recursion (even parity / odd parity)
to get number has even parity:
    if number = 0:
        return 1
    return number - 1 has odd parity

to get number has odd parity:
    if number = 0:
        return 0
    return number - 1 has even parity

print lines (4 has even parity) and (7 has even parity)

# exception case: base return appears after the recursive return path
to get number has even parity under inversion:
    if number is not 0:
        return number - 1 has odd parity under inversion
    return 1

to get number has odd parity under inversion:
    if number is not 0:
        return number - 1 has even parity under inversion
    return 0

print lines (4 has even parity under inversion) and (7 has even parity under inversion)

# exception case: recursive call is used in a nested condition before base return
to get number has even parity through nested recursion:
    if number is not 0:
        if (number - 1) has odd parity through nested recursion:
            return true
        else:
            return false
    return true

to get number has odd parity through nested recursion:
    if number is not 0:
        return (number - 1) has even parity through nested recursion
    return false

print lines (4 has even parity through nested recursion) and (7 has even parity through nested recursion)
