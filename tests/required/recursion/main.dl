import lib/std.dl

# test: recursive function (factorial)
function factorial of n:
    execute:
        if n is less than or equal to 1:
            return 1
        set m to n - 1
        return n * factorial of m

print factorial of 5 as line
print factorial of 10 as line

# test: mutual recursion (is even / is odd)
function n is even:
    execute:
        if n = 0:
            return 1
        return n - 1 is odd

function n is odd:
    execute:
        if n = 0:
            return 0
        return n - 1 is even

print 4 is even as line
print 7 is even as line

# exception case: base return appears after the recursive return path
function n is even inverted:
    execute:
        if n != 0:
            return n - 1 is odd inverted
        return 1

function n is odd inverted:
    execute:
        if n != 0:
            return n - 1 is even inverted
        return 0

print 4 is even inverted as line
print 7 is even inverted as line

# exception case: recursive call is used in a nested condition before base return
function n is even nested:
    execute:
        if n != 0:
            if (n - 1) is odd nested:
                return true
            else:
                return false
        return true

function n is odd nested:
    execute:
        if n != 0:
            return (n - 1) is even nested
        return false

print 4 is even nested as line
print 7 is even nested as line
