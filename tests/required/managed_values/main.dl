import lib/std.dl

class:
    patterns:
        [a|] tracked allocation
    members:
        references as a pointer to an integer
        number as an integer
    retain:
        set count to @intrinsic("dereference", the references of @intrinsic("lifecycle value"))
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count + 1)
    release:
        set count to (@intrinsic("dereference", the references of @intrinsic("lifecycle value")) - 1)
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count)
        if count = 0:
            ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", the number of @intrinsic("lifecycle value"))
            deallocate the references of @intrinsic("lifecycle value")

class:
    patterns:
        [a|] tracked container
    members:
        value as a tracked allocation

class:
    patterns:
        [a|] padded tracked container
    members:
        marker as a byte
        value as a tracked allocation

to get a new tracked allocation numbered number:
    set references to @intrinsic("call", "libc", "calloc", a pointer to an integer, 1 as a word sized integer, the size of an integer as a word sized integer)
    return @intrinsic("construct", a tracked allocation, references, number)

to get the identity of {tracked allocation:value}:
    return value

to consume {tracked allocation:value}: ignore the number of value

flex function publish {tracked allocation:value}:
    replacement:
        set the subject to value

flex function publish through a nested flex {tracked allocation:value}:
    replacement:
        publish value

to exercise copies:
    set first to a new tracked allocation numbered 1
    set second to first
    set second to a new tracked allocation numbered 2
    ignore a new tracked allocation numbered 3

to exercise return:
    set original to a new tracked allocation numbered 4
    set returned to the identity of original

to exercise temporary argument: consume a new tracked allocation numbered 5

to exercise subject:
    publish a new tracked allocation numbered 6
    ignore it

to exercise conditional ownership for condition:
    if condition:
        set branch to a new tracked allocation numbered 7
    else:
        set branch to a new tracked allocation numbered 8

to exercise loop:
    set number to 9
    loop while number <= 10:
        set iteration to a new tracked allocation numbered number
        set number to (number + 1)

to exercise array: set values to [a new tracked allocation numbered 11, a new tracked allocation numbered 12]

to exercise aggregate:
    set container to @intrinsic("construct", a tracked container, a new tracked allocation numbered 13)

to exercise property:
    set container to @intrinsic("construct", a tracked container, a new tracked allocation numbered 14)
    set extracted to the value of container

to exercise padded aggregate:
    set container to @intrinsic("construct", a padded tracked container, 1 as a byte, a new tracked allocation numbered 15)
    set extracted to the value of container

to exercise nested subject condition:
    if condition:
        publish through a nested flex a new tracked allocation numbered 16
        ignore it

to exercise runtime select:
    set left to a new tracked allocation numbered 17
    set right to a new tracked allocation numbered 18
    set condition to (@intrinsic("call", "libc", "abs", a 32 bit integer, 1) = 1)
    set selected to (left if condition, else right)

to exercise compile time select:
    set left to a new tracked allocation numbered 19
    set right to a new tracked allocation numbered 20
    set selected to (left if true, else right)

function observe explicit return global:
    globals:
        global
    execute:
        ignore the number of global

to exercise managed pointer reads:
    set original to a new tracked allocation numbered 23
    set source to @intrinsic("address of", original)
    set dereferenced to @intrinsic("dereference", source)
    set second to @intrinsic("dereference", source)

to exercise direct managed construction:
    set references to @intrinsic("call", "libc", "calloc", a pointer to an integer, 1 as a word sized integer, the size of an integer as a word sized integer)
    set value to @intrinsic("construct", a tracked allocation, references, 24)

exercise copies
exercise return
exercise temporary argument
exercise subject
exercise conditional ownership for true
exercise conditional ownership for false
exercise loop
exercise array
exercise aggregate
exercise property
exercise padded aggregate
exercise nested subject true
exercise nested subject false
exercise runtime select
exercise compile time select
set result to a new tracked allocation numbered 21
set global to a new tracked allocation numbered 22
observe explicit return global
exercise managed pointer reads
exercise direct managed construction
return 0
