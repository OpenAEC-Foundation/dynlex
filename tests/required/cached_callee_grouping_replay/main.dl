# A rejected outer grouping forces replay after the callee's conditional
# and loop body have already established reusable line groupings.
integer means: @intrinsic("type", "uint", 32)
slot means: @intrinsic("add pointer depth", state)
type means: @intrinsic("type", "type")
function return value:
    replacement:
        @intrinsic("return", value)
function set variable to value:
    replacement:
        @intrinsic("store", variable, value)
to get value as {type:kind}:
    return @intrinsic("cast", value, kind)
to get left > right:
    return @intrinsic("greater than", left, right)
flex section if condition:
    replacement:
        @intrinsic("if", condition)
flex section loop while condition:
    replacement:
        @intrinsic("loop while", condition)
class:
    patterns:
        state
    members:
        index as integer
class:
    patterns:
        text
    members:
        digit as integer
to get format {integer:value}:
    return @intrinsic("construct", text, value)
to get format {text:value}:
    return value
to get value as a digit:
    set result to format value
    return result
to emit value:
    set message to format value
    @intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, message's digit))
to get the next number from {slot:source}:
    if the index of source > 0 as integer:
        set position to 0
        loop while 2 > position:
            if the index of source > 0 as integer:
                set the index of source to 54 as integer
            set position to @intrinsic("add", position, 1)
        set the index of source to 55 as integer
    return the index of source
to run:
    set digit to @intrinsic("construct", state, (55 as integer))
    set address to @intrinsic("address of", digit)
    emit the next number from address as a digit
    emit the next number from address as a digit
run
