function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

function [a|] pointer to pointee:
    replacement:
        @intrinsic("add pointer depth", pointee)

function value as destination:
    execute:
        return @intrinsic("cast", value, destination)

function left = right:
    execute:
        return @intrinsic("equal", left, right)

function left or right:
    execute:
        return @intrinsic("or", left, right)

function whether first matches second and third:
    execute:
        return (first = 0 as a pointer to a byte) or ((second = 0 as a pointer to a byte) or (third = 0 as a pointer to a byte))

ignore whether (0 as a pointer to a byte) matches (0 as a pointer to a byte) and (0 as a pointer to a byte)
