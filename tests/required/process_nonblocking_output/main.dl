import lib/process.dl

function [the|] nonblocking process test interpreter:
    execute:
        return "python" if the process platform is windows, else "python3"

set command to a process command for the nonblocking process test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add "import os\nchunk=b'X'*4096\nwhile True:\n os.write(1,chunk)\n os.write(2,chunk)" as an argument to command
set child to launch command

set output to read the standard output of child
set error to read the standard error of child
set status to poll child
set cleanup_result to clean up child

print child's launched as line
print output's succeeded as line
print (output's contents's length > 0) as line
print error's succeeded as line
print (error's contents's length > 0) as line
print status's succeeded as line
print (not status's finished) as line
print cleanup_result's succeeded as line
