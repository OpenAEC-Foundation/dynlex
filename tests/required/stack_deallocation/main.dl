flex function deallocate address:
    replacement:
        @intrinsic("check deallocation", address)
        @intrinsic("call", "libc", "free", @intrinsic("type", "nothing"), address)

function exercise:
    execute:
        @intrinsic("store", value, 0)
        @intrinsic("store", pointer, @intrinsic("address of", value))
        deallocate pointer

exercise
