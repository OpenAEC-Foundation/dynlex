function [a|] pointer to pointee:
    replacement:
        @intrinsic("add pointer depth", pointee)

function return value:
    replacement:
        @intrinsic("return", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

class:
    patterns:
        [a|] payload
    members:
        value

class:
    patterns:
        [an|] envelope
    members:
        payload as a pointer to a payload

function a payload pointer:
    execute:
        set initial to @intrinsic("construct", a payload, 42)
        return @intrinsic("address of", initial)

function the wrapping of {a pointer to a payload:value}:
    execute:
        return @intrinsic("construct", an envelope, value)

set wrapped to the wrapping of a payload pointer
ignore the payload of wrapped
