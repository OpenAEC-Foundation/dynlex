function set variable to value:
    replacement:
        @intrinsic("store", variable, value)
flex section while condition:
    replacement:
        @intrinsic("loop while", condition)
flex section loop index from start to end:
    replacement:
        set index to start
        while @intrinsic("less than", index, end):
            @intrinsic("execute body")
            set index to @intrinsic("add", index, 1)
flex section for each item [at index|] in values:
    replacement:
        set {collection} to values
        loop index from 0 to @intrinsic("type extent", collection, 0):
            set item to @intrinsic("extract element", collection, index)
            @intrinsic("execute body")
function visit {arguments:values}:
    replacement:
        for each {item} at {position} in values:
            @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", @intrinsic("type", "int", 32), 1, "%d ", position))
            set {extent} to @intrinsic("construct", @intrinsic("array", position, @intrinsic("type", "int", 32)))
            @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", @intrinsic("type", "int", 32), 1, "%d\n", @intrinsic("type extent", extent, 0)))
function assign {arguments:variables} to value:
    replacement:
        set {assigned} to value
        for each {variable} in variables:
            set variable to assigned
assign first, second and third to 7
visit 1 and 2
