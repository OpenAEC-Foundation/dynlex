function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

an integer means: @intrinsic("type", "int")

function print line number:
    replacement:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", number))

the address of value means: @intrinsic("address of", value)

class:
    patterns:
        [an|] inner state
    members:
        value as an integer

class:
    patterns:
        [an|] outer state
    members:
        inner as an inner state

an inner state containing {an integer:value} means: @intrinsic("construct", an inner state, value)

an outer state containing {inner state:inner} means: @intrinsic("construct", an outer state, inner)

set inner to an inner state containing 0
set outer to an outer state containing inner
set outer's inner's value to 1
print line outer's inner's value
set pointer to the address of outer
set pointer's inner's value to 2
print line outer's inner's value
