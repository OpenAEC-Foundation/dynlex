import std.dl

# `otherwise` (or `default`) runs when no case matches.

function classify value:
	execute:
		set result to 0
		match based on value:
			case 1:
				set result to 10
			case 2:
				set result to 20
			otherwise:
				set result to 99
		return result

print (classify 1) as line
print (classify 2) as line
print (classify 7) as line

set r to 0
match based on 5:
	case 1:
		set r to 1
	default:
		set r to 42
print r as line

# Nested matches keep their case and default branches on their own switch.
function pair code a and b:
	execute:
		set r to 0
		match based on a:
			case 1:
				match based on b:
					case 5:
						set r to 15
					otherwise:
						set r to 19
			case 2:
				set r to 2
			otherwise:
				set r to 90
		return r

print (pair code 1 and 5) as line
print (pair code 1 and 8) as line
print (pair code 2 and 5) as line
print (pair code 7 and 7) as line
