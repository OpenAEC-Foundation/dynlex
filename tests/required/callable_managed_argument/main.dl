import lib/std.dl

class:
    patterns:
        [a|] callable tracked value
    members:
        references as a pointer to an integer
        number as an integer
    retain:
        set count to @intrinsic("dereference", the references of @intrinsic("lifecycle value"))
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count + 1)
    release:
        set count to @intrinsic("dereference", the references of @intrinsic("lifecycle value")) - 1
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count)
        if count = 0:
            @intrinsic("call", "libc", "free", nothing, the references of @intrinsic("lifecycle value"))

function a new callable tracked value numbered number:
    execute:
        set references to @intrinsic("call", "libc", "calloc", a pointer to an integer, 1 as a word sized integer, the size of an integer as a word sized integer)
        return @intrinsic("construct", a callable tracked value, references, number)

exposed function replace {callable tracked value:value}:
    execute:
        set value to a new callable tracked value numbered 2

ignore the function named "replace $"
