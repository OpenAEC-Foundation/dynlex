function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

flex section if condition:
    replacement:
        @intrinsic("if", condition)

set number to 0
ignore @intrinsic("variadic call", "libc", "sscanf", @intrinsic("type", "int", 32), 2, "17", "%d", @intrinsic("address of", number))
if @intrinsic("equal", number, 17):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "integer out-parameter")

set remainder to @intrinsic("cast", 0, @intrinsic("add pointer depth", @intrinsic("type", "int", 8)))
ignore @intrinsic("call", "libc", "strtol", @intrinsic("type", "int", @intrinsic("build info", "c long size")), "23tail", @intrinsic("address of", remainder), 10)
if @intrinsic("not equal", remainder, @intrinsic("cast", 0, @intrinsic("add pointer depth", @intrinsic("type", "int", 8)))):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "pointer out-parameter")

set alias to 0
set address to @intrinsic("address of", alias)
ignore @intrinsic("variadic call", "libc", "sscanf", @intrinsic("type", "int", 32), 2, "31", "%d", address)
if @intrinsic("equal", alias, 31):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "aliased out-parameter")

set encoded to 0
set representation to @intrinsic("cast", @intrinsic("address of", encoded), @intrinsic("type", "int", @intrinsic("build info", "word size")))
set decoded to @intrinsic("cast", representation, @intrinsic("add pointer depth", @intrinsic("type", "int", 32)))
ignore @intrinsic("variadic call", "libc", "sscanf", @intrinsic("type", "int", 32), 2, "59", "%d", decoded)
if @intrinsic("equal", encoded, 59):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "integer-encoded out-parameter")
