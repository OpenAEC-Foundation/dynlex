integer means: @intrinsic("type", "int")
number means: @intrinsic("type", "float", 64)
the type of value means: @intrinsic("type of", value)
implicitly convert {integer:value}:
    execute:
        @intrinsic("return", @intrinsic("cast", value, number))
to get measured {number:value}:
    @intrinsic("return", @intrinsic("cast", value, integer))
to get sample:
    @intrinsic("return", measured 7)
class:
    patterns:
        container
    members:
        value as the type of sample
implicitly convert {container:item}:
    execute:
        @intrinsic("return", @intrinsic("cast", item's value, number))
@intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, @intrinsic("add", sample, 48)))
@intrinsic("store", item, @intrinsic("construct", container, 9))
@intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, @intrinsic("add", measured item, 48)))
