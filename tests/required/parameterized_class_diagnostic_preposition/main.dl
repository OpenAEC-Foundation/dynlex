function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

[an|] integer means: @intrinsic("type", "int")

fixed value means: @intrinsic("fix", value)

class:
    patterns:
        [a|] record owned by {fixed integer:owner}
    members:
        value

a record owned by {fixed integer:owner} containing value means: @intrinsic("construct", a record owned by owner, value)

function consume {integer:value}:
    replacement:
        @intrinsic("discard", value)

set result to a record owned by 7 containing 3
consume result
