function integer:
    replacement:
        @intrinsic("type", "int")

function floating:
    replacement:
        @intrinsic("type", "float")

function discard value:
    execute:
        @intrinsic("discard", value)

implicitly convert {integer:value}:
    replacement:
        2.0

function require {floating:value}:
    replacement:
        value

discard require 1
