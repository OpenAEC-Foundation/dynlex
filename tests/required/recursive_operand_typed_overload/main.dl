function floating:
    replacement:
        @intrinsic("type", "float")

function finish with value:
    replacement:
        @intrinsic("return", value)

section if condition:
    replacement:
        @intrinsic("if", condition)

function the adjustment of value:
    execute:
        finish with @intrinsic("add", value, 100)

function the adjustment of {floating:value}:
    execute:
        finish with @intrinsic("negate", value)

function the recursive result at depth from seed:
    execute:
        if @intrinsic("greater than", depth, 0):
            finish with the adjustment of (the recursive result at @intrinsic("subtract", depth, 1) from seed)
        finish with seed

if @intrinsic("not equal", the recursive result at 3 from 7.0, @intrinsic("negate", 7.0)):
    @intrinsic("return", 1)
if @intrinsic("not equal", the recursive result at 2 from 1, 201):
    @intrinsic("return", 2)
@intrinsic("return", 0)
