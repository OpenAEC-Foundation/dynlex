# SPDX-License-Identifier: MPL-2.0
# Stable allocated nodes survive slot-list growth; keys must be rechecked after removal.
import lib/bim/arena.dl

set nodes to a cad arena of an integer
set key to the cad key after inserting 7 into nodes
set borrowed to the cad node pointer for key in nodes
set index to 0
loop while index < 100:
    ignore the cad key after inserting index into nodes
    increment index
print line borrowed = (the cad node pointer for key in nodes)
@intrinsic("store at", borrowed, 42)
print line the cad value of (the cad lookup of key in nodes)
set entries to the cad entries of nodes
set pointers to the cad mutable values of nodes
print lines (the length of entries) and (the length of pointers)
print line the cad debug text of (the key of (the item at 0 in entries))
@intrinsic("store at", the item at 0 in pointers, 43)
print line @intrinsic("dereference", the value of (the item at 0 in entries))
free entries
free pointers
ignore the cad removal of key from nodes
# Do not dereference the expired borrow: verify its key is refused instead.
print line (the cad node pointer for key in nodes) = (0 as a pointer to an integer)
set fresh to the cad key after inserting 9 into nodes
print lines (key equals cad key fresh) and (the cad value of (the cad lookup of fresh in nodes))
free cad arena nodes
