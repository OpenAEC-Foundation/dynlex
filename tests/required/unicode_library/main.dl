import unicode.dl

function a Unicode test string:
    execute:
        set text to a new string buffer containing 10 bytes
        store 65 as a byte into the data of text at 0
        store 194 as a byte into the data of text at 1
        store 162 as a byte into the data of text at 2
        store 226 as a byte into the data of text at 3
        store 130 as a byte into the data of text at 4
        store 172 as a byte into the data of text at 5
        store 240 as a byte into the data of text at 6
        store 159 as a byte into the data of text at 7
        store 152 as a byte into the data of text at 8
        store 128 as a byte into the data of text at 9
        return text

function a string containing bytes first second:
    execute:
        set text to a new string buffer containing 2 bytes
        store first as a byte into the data of text at 0
        store second as a byte into the data of text at 1
        return text

function a three byte string from {integer:first} then {integer:second} then {integer:third}:
    execute:
        set text to a new string buffer containing 3 bytes
        store first as a byte into the data of text at 0
        store second as a byte into the data of text at 1
        store third as a byte into the data of text at 2
        return text

function a four byte string from {integer:first} then {integer:second} then {integer:third} then {integer:fourth}:
    execute:
        set text to a new string buffer containing 4 bytes
        store first as a byte into the data of text at 0
        store second as a byte into the data of text at 1
        store third as a byte into the data of text at 2
        store fourth as a byte into the data of text at 3
        return text

function print validation of {string:text}:
    execute:
        validate text as UTF8 and set validation to it
        print the status of validation
        print ":"
        print the error byte offset of validation as a line

set text to a Unicode test string
validate text as UTF8 and set validation to it
print the status of validation as a line

set offset to 0
loop while offset < the length of text:
    decode the UTF8 code point in text at byte offset and set decoded to it
    print the code point of decoded
    print "@"
    print the byte offset of decoded
    print "-"
    print the next byte offset of decoded as a line
    set offset to the next byte offset of decoded

decode the UTF8 code point in text at byte 2 and set middle to it
print the status of middle as a line
decode the UTF8 code point in text at byte 10 and set past to it
print the status of past as a line

set encoded to the UTF16 position of UTF8 byte offset 6 in text
print the status of encoded
print ":"
print the position of encoded as a line
set position to the UTF8 byte offset of UTF16 position 3 in text
print the status of position
print ":"
print the position of position as a line
set surrogate to the UTF8 byte offset of UTF16 position 4 in text
print the status of surrogate as a line
set sequence to the UTF16 position of UTF8 byte offset 8 in text
print the status of sequence as a line

print validation of a string containing bytes 192 128
print validation of a string containing bytes 226 130
print validation of a string containing bytes 237 160
print validation of a string containing bytes 244 144
print validation of a string containing bytes 128 65
print validation of a string containing bytes 194 128
print validation of a three byte string from 224 then 160 then 128
print validation of a four byte string from 240 then 144 then 128 then 128
print validation of a four byte string from 244 then 143 then 191 then 191
print validation of a three byte string from 224 then 159 then 128
print validation of a three byte string from 226 then 130 then 65
print validation of a four byte string from 240 then 144 then 128 then 65
print validation of a four byte string from 245 then 128 then 128 then 128

set malformed to a string containing bytes 192 128
decode the UTF8 code point in malformed at byte 0 and set decoding to it
print the status of decoding
print ":"
print the error byte offset of decoding as a line
set conversion to the UTF16 position of UTF8 byte offset 0 in malformed
print the status of conversion
print ":"
print the error byte offset of conversion as a line

set source to the string form of "a\r\nb\rc\n"
scan lines in source and set indexed to it
print the status of indexed as a line
set lines to the line index of indexed
print the number of lines in lines as a line
set number to 0
loop while number < the number of lines in lines:
    set start to the start of line number in lines
    set finish to the content end of line number in lines
    set following to the next start after line number in lines
    print the position of start
    print "-"
    print the position of finish
    print "-"
    print the position of following as a line
    set number to number + 1
set newline to the line number at byte offset 1 in lines
print the status of newline
print ":"
print the position of newline as a line
set carriage to the line number at byte offset 2 in lines
print the status of carriage
print ":"
print the position of carriage as a line
set following to the line number at byte offset 3 in lines
print the status of following
print ":"
print the position of following as a line
set nonexistent to the start of line 4 in lines
print the status of nonexistent as a line
free indexed

scan lines in a string containing bytes 192 128 and set scanning to it
print the status of scanning
print ":"
print the error byte offset of scanning as a line
free scanning

scan lines in "" and set empty to it
print the status of empty
print ":"
print the number of lines in the line index of empty as a line
set beginning to the start of line 0 in the line index of empty
set ending to the content end of line 0 in the line index of empty
print the position of beginning
print "-"
print the position of ending as a line
free empty
