import json.dl

parse "01" as JSON and set leading to it
print lines (leading succeeded) and (the JSON error position in leading)
free leading

parse "1." as JSON and set fraction to it
print lines (fraction succeeded) and (the JSON error position in fraction)
free fraction

parse "1e+" as JSON and set exponent to it
print lines (exponent succeeded) and (the JSON error position in exponent)
free exponent

parse "\"\\x\"" as JSON and set escape to it
print lines (escape succeeded) and (the JSON error position in escape)
free escape

parse "\"\\ud800\"" as JSON and set surrogate to it
print lines (surrogate succeeded) and (the JSON error position in surrogate)
free surrogate

parse "[1,]" as JSON and set trailing to it
print lines (trailing succeeded) and (the JSON error position in trailing)
free trailing
