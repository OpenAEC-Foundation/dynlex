import json.dl

set leading_zero to parse "01" as json
print json parsing succeeded for leading_zero as line
print the json error position in leading_zero as line
free json result leading_zero

set bad_fraction to parse "1." as json
print json parsing succeeded for bad_fraction as line
print the json error position in bad_fraction as line
free json result bad_fraction

set bad_exponent to parse "1e+" as json
print json parsing succeeded for bad_exponent as line
print the json error position in bad_exponent as line
free json result bad_exponent

set bad_escape to parse "\"\\x\"" as json
print json parsing succeeded for bad_escape as line
print the json error position in bad_escape as line
free json result bad_escape

set bad_surrogate to parse "\"\\ud800\"" as json
print json parsing succeeded for bad_surrogate as line
print the json error position in bad_surrogate as line
free json result bad_surrogate

set trailing_comma to parse "[1,]" as json
print json parsing succeeded for trailing_comma as line
print the json error position in trailing_comma as line
free json result trailing_comma
