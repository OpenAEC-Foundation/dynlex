function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

to get one more than value:
    return @intrinsic("add", value, 1)

to get two more than value:
    return one more than one more than value

ignore @intrinsic("type", "int", two more than 6)
