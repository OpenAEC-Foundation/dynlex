fixed value means: @intrinsic("fix", value)

[an|] integer means: @intrinsic("type", "int")

[a|] {fixed integer:bits} bit integer means: @intrinsic("type", "int", bits)

class:
    patterns:
        [a|] sample
    members:
        count as a 32 bit integer

@intrinsic("discard", @intrinsic("size of", a sample))
