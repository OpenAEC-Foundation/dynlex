import lib/json_rpc.dl

function [the|] json rpc id test interpreter:
    execute:
        return "python" if the process platform is windows, else "python3"

set script to "import json,sys\ndef read():\n h={}\n while True:\n  line=sys.stdin.buffer.readline()\n  if line==b'\\r\\n': break\n  n,v=line.decode('ascii').split(':',1);h[n.lower()]=v.strip()\n return json.loads(sys.stdin.buffer.read(int(h['content-length'])))\ndef send(m):\n p=json.dumps(m,separators=(',',':')).encode();sys.stdout.buffer.write(b'Content-Length: '+str(len(p)).encode()+b'\\r\\n\\r\\n'+p);sys.stdout.buffer.flush()\na=read();b=read();c=read();d=read()\nassert a['id']==9007199254740993 and a['method']=='number' and 'params' not in a\nassert b['id']=='9007199254740993' and b['params'] is None\nassert c['id'] is None and c['params']=={}\nassert d['id']==0 and 'params' not in d\nsend({'jsonrpc':'2.0','id':'9007199254740993','result':{'kind':'string'}})\nsend({'jsonrpc':'2.0','id':9007199254740993,'error':{'code':-9007199254740993,'message':'exact','data':None}})\nsend({'jsonrpc':'2.0','id':None,'result':3})\nsend({'jsonrpc':'2.0','id':0,'result':4})\nsend({'jsonrpc':'2.0','id':'unknown','result':False})"
set command to a process command for the json rpc id test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add script as an argument to command
set child to launch command
set opened to connect json rpc to child
set state to start a json rpc session with opened's connection

set number_id to a new json rpc integer from "9007199254740993"
set string_id to a new json rpc text for "9007199254740993"
set null_id to a new json rpc null
set negative_zero_id to a new json rpc integer from "-0"
set zero_id to a new json rpc integer from "0"
set null_parameters to a new json rpc null
set object_parameters to a new json rpc object

set number_send to send json rpc request "number" and identifier number_id using state
set string_send to send json rpc request "string" with null_parameters and identifier string_id using state
set null_send to send json rpc request "null" with object_parameters and identifier null_id using state
set zero_send to send json rpc request "zero" and identifier negative_zero_id using state
print number_send's succeeded as line
print string_send's succeeded as line
print null_send's succeeded as line
print zero_send's succeeded as line
print (number_send's request id = "9007199254740993") as line
print (null_send's request id = "null") as line

set duplicate to send json rpc request "duplicate" and identifier zero_id using state
print (not duplicate's succeeded) as line
print (duplicate's status = the json rpc protocol error status) as line

set number_response to await json rpc response for identifier number_id using state
print (number_response's status = the json rpc remote error status) as line
print (number_response's remote error code text = "-9007199254740993") as line
print (number_response's remote error message = "exact") as line
print (number_response's remote error data is json null) as line
free json rpc response number_response

set string_response to await json rpc response for identifier string_id using state
print string_response's succeeded as line
print (json text named "kind" in string_response's result = "string") as line
free json rpc response string_response

set null_response to await json rpc response for identifier null_id using state
print null_response's succeeded as line
print (the number of null_response's result = 3.0) as line
free json rpc response null_response

set zero_response to await json rpc response for identifier negative_zero_id using state
print zero_response's succeeded as line
print (the number of zero_response's result = 4.0) as line
free json rpc response zero_response

set unknown to pump one json rpc message using state
print (not unknown's succeeded) as line
print (unknown's status = the json rpc protocol error status) as line
set diagnostic to take next json rpc diagnostic from state
print diagnostic's succeeded as line
print (diagnostic's error message = "JSON-RPC response has an unknown ID") as line
print (json text named "id" in diagnostic's message = "unknown") as line
free json rpc queued message diagnostic

free json value number_id
free json value string_id
free json value null_id
free json value negative_zero_id
free json value zero_id
free json value null_parameters
free json value object_parameters
free json rpc session state
