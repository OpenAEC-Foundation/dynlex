import lib/filesystem.dl

create a temporary directory
set first_temporary to it
create a temporary directory
set second_temporary to it
print first_temporary's succeeded as line
print second_temporary's succeeded as line
print (not ((first_temporary's directory_path) = (second_temporary's directory_path))) as line

set first_status to the file system entry at first_temporary's directory_path
set second_status to the file system entry at second_temporary's directory_path
print (((first_status's succeeded) and (first_status's found)) and (first_status's directory)) as line
print (((second_status's succeeded) and (second_status's found)) and (second_status's directory)) as line

set payload_path to first_temporary's directory_path + the string form of "/payload.bin"
set payload to a new string buffer with length 5
store 65 as a byte into the data of payload at 0
store 0 as a byte into the data of payload at 1
store 66 as a byte into the data of payload at 2
store 67 as a byte into the data of payload at 3
store 68 as a byte into the data of payload at 4
write payload to payload_path
print it succeeded as line

open file at payload_path for streaming reads
set input to it
print input's succeeded as line
read up to 3 bytes from input
set first_chunk to it
print first_chunk's succeeded as line
print first_chunk's count as line
print first_chunk's end_of_file as line
print (character 0 of first_chunk's data) as line
print (character 1 of first_chunk's data) as line
print (character 2 of first_chunk's data) as line

read up to 3 bytes from input
set second_chunk to it
print second_chunk's succeeded as line
print second_chunk's count as line
print second_chunk's end_of_file as line
print (character 0 of second_chunk's data) as line
print (character 1 of second_chunk's data) as line

read up to 3 bytes from input
set final_chunk to it
print final_chunk's succeeded as line
print final_chunk's count as line
print final_chunk's end_of_file as line

read up to (-1) bytes from input
set invalid_chunk to it
print invalid_chunk's succeeded as line
print invalid_chunk's count as line
print invalid_chunk's end_of_file as line
print (the length of invalid_chunk's error_message) > 0 as line

open file at "tests/required/filesystem_streaming_temp/missing.bin" for streaming reads
set missing_input to it
print missing_input's succeeded as line
print the length of missing_input's error_message > 0 as line

remove filesystem tree at first_temporary's directory_path
set first_cleanup to it
remove filesystem tree at second_temporary's directory_path
set second_cleanup to it
print first_cleanup's succeeded as line
print second_cleanup's succeeded as line
