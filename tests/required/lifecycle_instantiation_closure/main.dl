import lib/std.dl

class:
    patterns:
        [a|] late managed box {fixed integer:length}
    members:
        values as an array of length items
    retain:
        ignore @intrinsic("lifecycle value")
    release:
        ignore @intrinsic("lifecycle value")

class:
    patterns:
        [an|] outer managed value
    members:
        number as an integer
    retain:
        ignore @intrinsic("construct", a late managed box 2, [1, 2])
    release:
        ignore @intrinsic("construct", a late managed box 2, [1, 2])

set value to @intrinsic("construct", an outer managed value, 1)
ignore value
