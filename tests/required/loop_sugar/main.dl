import lib/std.dl

set sum to 0

loop 3 times:
    add 1 to sum
print sum as a line

loop i from 2 to 5:
    add i to sum
print sum as a line

loop j from 1 through 3:
    add j to sum
print sum as a line

loop k from 5 down to 2:
    add k to sum
print sum as a line

loop m from 3 down through 1:
    add m to sum
print sum as a line
