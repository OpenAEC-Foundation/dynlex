import lib/process.dl
import lib/text.dl

function [the|] terminate handler test interpreter:
    execute:
        return "python" if the process platform is windows, else "python3"

set command to a process command for the terminate handler test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add "import os,signal,sys,time\nif os.name != 'nt': signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))\nprint('ready')\ntime.sleep(30)" as an argument to command
set child to launch command

set ready_contents to the string form of ""
set ready_succeeded to true
set ready_complete to false
set ready_stream_ended to false
loop while ready_succeeded and ((not ready_complete) and (not ready_stream_ended)):
    set ready_chunk to read the standard output of child
    set ready_succeeded to ready_chunk's succeeded
    if ready_succeeded:
        set ready_contents to ready_contents + ready_chunk's contents
        set ready_complete to ready_contents ends with "\n"
        set ready_stream_ended to ready_chunk's end of stream
set termination to terminate child
set status to wait for child
set expected_exit_code to 0 as a 64 bit integer
if the process platform is windows:
    set expected_exit_code to 1 as a 64 bit integer

print child's launched as line
print (ready_succeeded and ready_complete) as line
print (ready_contents = "ready\n") as line
print termination's succeeded as line
print status's succeeded as line
print status's finished as line
print status's terminated as line
print (status's exit code = expected_exit_code) as line
print (status's termination signal = (0 as a 32 bit integer)) as line
