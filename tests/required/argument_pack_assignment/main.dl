function set variable to value:
    replacement:
        @intrinsic("store", variable, value)
flex section while condition:
    replacement:
        @intrinsic("loop while", condition)
flex section for each item in values:
    replacement:
        set index to 0
        while @intrinsic("less than", index, @intrinsic("type extent", @intrinsic("type of", values), 0)):
            set item to @intrinsic("extract element", values, index)
            @intrinsic("execute body")
            set index to @intrinsic("add", index, 1)
function assign {arguments:variables} to value:
    replacement:
        set assigned to value
        for each variable in variables:
            set variable to assigned
assign x, y and z to 8
@intrinsic("return", @intrinsic("subtract", @intrinsic("add", @intrinsic("add", x, y), z), 24))
