import json.dl

parse "{\"safe\":9007199254740991,\"rounded\":9007199254740993,\"minimum\":-9223372036854775808,\"signedMaximum\":9223372036854775807,\"maximum\":18446744073709551615,\"fraction\":1.5,\"exponent\":1e2,\"negative\":-1,\"minusZero\":-0,\"signedOverflow\":9223372036854775808,\"overflow\":18446744073709551616,\"text\":\"1\"}" as JSON and set parsed to it
set document to the value of parsed
set safeResult to the unsigned 64 bit JSON integer read from the JSON member named "safe" in document
set roundedResult to the unsigned 64 bit JSON integer read from the JSON member named "rounded" in document
set minimumResult to the signed 64 bit JSON integer read from the JSON member named "minimum" in document
set signedMaximumResult to the signed 64 bit JSON integer read from the JSON member named "signedMaximum" in document
set maximumResult to the unsigned 64 bit JSON integer read from the JSON member named "maximum" in document
set fractionResult to the signed 64 bit JSON integer read from the JSON member named "fraction" in document
set exponentResult to the signed 64 bit JSON integer read from the JSON member named "exponent" in document
set negativeResult to the unsigned 64 bit JSON integer read from the JSON member named "negative" in document
set minusZeroResult to the unsigned 64 bit JSON integer read from the JSON member named "minusZero" in document
set signedMinusZeroResult to the signed 64 bit JSON integer read from the JSON member named "minusZero" in document
set signedOverflowResult to the signed 64 bit JSON integer read from the JSON member named "signedOverflow" in document
set overflowResult to the unsigned 64 bit JSON integer read from the JSON member named "overflow" in document
set textResult to the signed 64 bit JSON integer read from the JSON member named "text" in document
print lines (safeResult succeeded), (the unsigned 64 bit integer value of safeResult) and (roundedResult succeeded)
print lines (the unsigned 64 bit integer value of roundedResult) and (minimumResult succeeded)
print lines (the signed 64 bit integer value of minimumResult) and (signedMaximumResult succeeded)
print lines (the signed 64 bit integer value of signedMaximumResult) and (maximumResult succeeded)
print lines (the unsigned 64 bit integer value of maximumResult) and (fractionResult succeeded)
print lines (exponentResult succeeded), (negativeResult succeeded) and (minusZeroResult succeeded)
print lines (signedMinusZeroResult succeeded) and (the signed 64 bit integer value of signedMinusZeroResult)
print lines (signedOverflowResult succeeded), (overflowResult succeeded) and (textResult succeeded)
free parsed

set signedNode to a new JSON number from -9223372036854775808
set unsignedNode to a new JSON number from (18446744073709551615 as a 64 bit unsigned integer)
print lines (the compact JSON form of signedNode) and (the compact JSON form of unsignedNode)
parse the compact JSON form of signedNode as JSON and set signedRoundTrip to it
parse the compact JSON form of unsignedNode as JSON and set unsignedRoundTrip to it
set signedRoundTripResult to the signed 64 bit JSON integer read from the value of signedRoundTrip
set unsignedRoundTripResult to the unsigned 64 bit JSON integer read from the value of unsignedRoundTrip
