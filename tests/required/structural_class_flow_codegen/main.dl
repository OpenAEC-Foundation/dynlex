function [a|] pointer to pointee:
    replacement:
        @intrinsic("add pointer depth", pointee)

function value as destination:
    replacement:
        @intrinsic("cast", value, destination)

function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

class:
    patterns:
        [a|] storage
    members:
        data

class:
    patterns:
        [a|] node
    members:
        items

function a built node:
    execute:
        set tentative to 0 as a pointer to a node
        set temporary to @intrinsic("construct", a storage, tentative)
        set subject to @intrinsic("construct", a node, temporary)
        set result to @intrinsic("address of", subject)
        set concrete to 0 as a pointer to a node
        set finalized to @intrinsic("construct", a storage, concrete)
        @intrinsic("store", @intrinsic("property", result, "items"), finalized)
        ignore @intrinsic("not equal", result, 0 as a pointer to a node)
        return result

ignore a built node
