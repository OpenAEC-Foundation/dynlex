import lib/std.dl

flex section around:
    replacement:
        set marker to 1
        execute the body
        set marker to 2

function observed at runtime:
    execute:
        discard @intrinsic("call", "libc", "rand", an integer)
        set marker to 0
        set captured to 0
        around:
            set captured to marker
        return captured

print observed at runtime as line
