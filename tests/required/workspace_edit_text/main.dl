import lib/workspace_edit.dl

function the required workspace edit parsed from {C string:source}:
    execute:
        set outcome to the result of parsing source as a workspace edit
        if outcome failed:
            print outcome's failure reason as a line
            @intrinsic("call", "libc", "abort", nothing)
        return outcome

set astral to the required workspace edit parsed from "{\"changes\":{\"file:///alpha.txt\":[{\"range\":{\"start\":{\"line\":0,\"character\":1},\"end\":{\"line\":0,\"character\":3}},\"newText\":\"X\"},{\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":1}},\"newText\":\"D\"}]}}"
set change to the workspace change at index 0 in the changes of astral's edit
set source to the string form of "A😀B\r\nC\n"
set result to the result of applying workspace text edits (the edits of change) to source using the workspace UTF-16 position encoding
print whether result succeeded as a line
print (result's text = "AXB\r\nD\n") as a line
free astral

set ordered to the required workspace edit parsed from "{\"changes\":{\"file:///alpha.txt\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"newText\":\"A\"},{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"newText\":\"B\"},{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"newText\":\"X\"},{\"range\":{\"start\":{\"line\":0,\"character\":1},\"end\":{\"line\":0,\"character\":2}},\"newText\":\"Y\"},{\"range\":{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":2}},\"newText\":\"Z\"}]}}"
set change to the workspace change at index 0 in the changes of ordered's edit
set source to the string form of "abcd"
set result to the result of applying workspace text edits (the edits of change) to source using the workspace UTF-16 position encoding
print whether result succeeded as a line
print result's text as a line
free ordered

set invalid to the required workspace edit parsed from "{\"changes\":{\"file:///alpha.txt\":[{\"range\":{\"start\":{\"line\":0,\"character\":2},\"end\":{\"line\":0,\"character\":3}},\"newText\":\"X\"}]}}"
set change to the workspace change at index 0 in the changes of invalid's edit
set source to the string form of "A😀B"
set result to the result of applying workspace text edits (the edits of change) to source using the workspace UTF-16 position encoding
print whether result succeeded as a line
print result's failure reason as a line
free invalid

set overlap to the required workspace edit parsed from "{\"changes\":{\"file:///alpha.txt\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":2}},\"newText\":\"X\"},{\"range\":{\"start\":{\"line\":0,\"character\":1},\"end\":{\"line\":0,\"character\":3}},\"newText\":\"Y\"}]}}"
set change to the workspace change at index 0 in the changes of overlap's edit
set source to the string form of "abcd"
set result to the result of applying workspace text edits (the edits of change) to source using the workspace UTF-16 position encoding
print whether result succeeded as a line
print result's failure reason as a line
free overlap
