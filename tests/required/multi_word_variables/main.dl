import lib/std.dl

to get the sum of {left value} and {right value}:
    return left value + right value

long double means: a floating-point number

implicitly convert {integer:value}:
    replacement:
        value as a floating-point number

textual value means: a value

to get the carried {textual value:text value}:
    return text value

set {width} to 20
set {half width} to width / 2
add 4 to half width
print line half width

set {same line value} to 1 and add 2 to same line value
print line same line value

set {player 2 score} to 5
add 3 to player 2 score
print line player 2 score
@intrinsic("discard", player 2 score)
ignore (player 2 score)
ignore [player 2 score]

set {player 20 score} to 9
print line player 20 score

print line the sum of 3 and 5

set {long double:val} to 2
print line val = 2.0

set {a number:numeric value} to 7
print line numeric value

print line (the carried "typed, not lexical")
