import regex.dl

set valid to compile "^(ab|cd)+[0-9]?$" as a regular expression
print valid is valid as line
print (the regex error position in "^(ab|cd)+[0-9]?$") as line
print "abcd7" matches valid as line

set unclosed_group to compile "(abc" as a regular expression
print unclosed_group is valid as line
print the error position of unclosed_group as line

set empty_alternative to compile "a|" as a regular expression
print empty_alternative is valid as line
print the error position of empty_alternative as line

set repeated_quantifier to compile "a**" as a regular expression
print repeated_quantifier is valid as line
print the error position of repeated_quantifier as line
