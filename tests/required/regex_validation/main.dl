import regex.dl

compile "^(ab|cd)+[0-9]?$" as a regular expression and set valid to it
print lines (valid is valid), (the regular expression error position in "^(ab|cd)+[0-9]?$") and ("abcd7" matches valid)

compile "(abc" as a regular expression and set unclosed to it
print lines (unclosed is valid) and (the error position of unclosed)

compile "a|" as a regular expression and set empty to it
print lines (empty is valid) and (the error position of empty)

compile "a**" as a regular expression and set repeated to it
print lines (repeated is valid) and (the error position of repeated)
