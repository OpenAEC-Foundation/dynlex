import regex.dl

compile "^(ab|cd)+[0-9]?$" as a regular expression and set valid to it
print whether valid is valid as a line
print (the regular expression error position in "^(ab|cd)+[0-9]?$") as a line
print whether "abcd7" matches valid as a line

compile "(abc" as a regular expression and set unclosed to it
print whether unclosed is valid as a line
print the error position of unclosed as a line

compile "a|" as a regular expression and set empty to it
print whether empty is valid as a line
print the error position of empty as a line

compile "a**" as a regular expression and set repeated to it
print whether repeated is valid as a line
print the error position of repeated as a line
