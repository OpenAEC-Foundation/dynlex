function ignore value:
    replacement:
        @intrinsic("discard", value)

function [a|] type:
    replacement:
        @intrinsic("type", "type")

function [a|] byte:
    replacement:
        @intrinsic("type", "int", 8)

function [a|] pointer to pointed:
    replacement:
        @intrinsic("add pointer depth", pointed)

function the identity of {type:value}:
    replacement:
        value

ignore @intrinsic("size of", the identity of a pointer to a byte)
