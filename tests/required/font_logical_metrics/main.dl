import lib/font.dl

set library to 0 as a pointer
set error to @intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)
require condition (error = 0) reporting "FreeType initialization failed"
set face to 0 as a pointer
set error to @intrinsic("call", "freetype", "FT_New_Face", an integer, library, "tests/games/fonts/NotoSans-Regular.ttf", 0 as a C long integer, the address of face)
require condition (error = 0) reporting "The test font could not be loaded"
set error to @intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0, 32)
require condition (error = 0) reporting "The test font could not be sized"
set cache to a new font cache for (0 as a pointer)
set typeface to @intrinsic("construct", font, library, face, cache, 2.0)
set first to the advance of character 65 using typeface
set second to the advance of character 86 using typeface
set extent to the width of "AV" using typeface
require condition (extent = (first + second)) reporting "Text measurement discarded fractional advances"
set error to @intrinsic("call", "freetype", "FT_Load_Char", an integer, face, 65 as a C long integer, 0)
require condition (error = 0) reporting "The test glyph could not be loaded"
set metadata to face as a pointer to FT face
set slot to metadata's glyph as a pointer to FT glyph slot
require condition (first = ((slot's advance x as a floating-point number) / 128.0)) reporting "Raster scaling changed the logical text size"
set released to the result of releasing (the address of typeface)
require condition (released succeeded) reporting "The test font could not be released"
print "Logical font metrics passed" as a line
