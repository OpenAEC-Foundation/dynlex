import lib/std.dl

class:
    patterns:
        [a|] singleton record
    members:
        value as an integer

class:
    patterns:
        [a|] pair record
    members:
        name as a string
        value as an integer

class:
    patterns:
        [a|] nested record
    members:
        single as a singleton record
        pair as a pair record

to get the increment of {integer:value}:
    return value + 1

set nestedSingleton to [@intrinsic(
    "construct",
    a nested record,
    @intrinsic("construct", a singleton record, (1 + 2)),
    @intrinsic("construct", a pair record, the string form of "three", the increment of 3)
)]
set firstNested to the item at 0 in nestedSingleton
print lines (the value of the single of firstNested) and (the length of the name of the pair of firstNested)
print line the value of the pair of firstNested

set nestedArrays to [[@intrinsic("construct", a singleton record, 9)]]
set firstRow to the item at 0 in nestedArrays
set nestedValue to the item at 0 in firstRow
print line the value of nestedValue

set grouped to [(1 + 2) * 3]
print line the item at 0 in grouped

set singletonString to [the string form of "hello"]
set word to the item at 0 in singletonString
print line (the length of word)

set multiple to [
    @intrinsic("construct", a singleton record, 11),
    @intrinsic("construct", a singleton record, 12)
]
print lines (the value of the item at 0 in multiple) and (the value of the item at 1 in multiple)
