section if condition:
    replacement:
        @intrinsic("if", condition)

to visit first depth:
    @intrinsic("discard", @intrinsic("call", "libc", "puts", @intrinsic("type", "int"), "first"))
    if @intrinsic("less than", depth, 3):
        visit second @intrinsic("add", depth, 1)

to visit second depth:
    @intrinsic("discard", @intrinsic("call", "libc", "puts", @intrinsic("type", "int"), "second"))
    if @intrinsic("less than", depth, 3):
        visit first @intrinsic("add", depth, 1)

visit first 0
visit second 0
