import lib/process.dl

function {process wait result:status} has no termination report:
    replacement:
        the inverse of (status reports termination)

function the terminated status test interpreter:
    execute:
        return "python" if the process platform is Windows, else "python3"

set command to a process command for the terminated status test interpreter
add "-c" as an argument to command
add "" as an argument to command
launch command and set child to it

set delay to a process command for the terminated status test interpreter
add "-c" as an argument to delay
add "import time; time.sleep(0.5)" as an argument to delay
run delay and set pause to it

terminate child and set termination to it
wait for child and set status to it

print whether child was launched as a line
print whether pause succeeded as a line
print whether termination succeeded as a line
print whether status succeeded as a line
print whether status reports completion as a line
print whether (status's exit code = (0 as a 64 bit integer)) as a line
print whether status has no termination report as a line
print whether (status's termination signal = (0 as a 32 bit integer)) as a line
