import lib/path.dl
import lib/host.dl

to check {file URI result:result} against expected:
    print line (result succeeded) and ((result is supported) and (result's value = expected))

set platform to whether the host platform is Windows
set destination to the string form of "C:/tmp/native path" if platform's value, else the string form of "/tmp/native path"
set locator to the string form of "file:///C:/tmp/native%20path" if platform's value, else the string form of "file:///tmp/native%20path"

set resolved to the path from locator interpreted as a file URI
print lines (resolved succeeded), (resolved is supported) and (resolved's value = destination)
print line resolved's error message is empty

set rejected to the path from (the string form of "file:///tmp/a%2Fb") interpreted as a file URI
print line (
    (rejected failed) and
    ((rejected is supported) and
    ((rejected's value is empty) and (rejected's error message is not empty)))
)

check (the file URI for destination interpreted as a native path) against locator
