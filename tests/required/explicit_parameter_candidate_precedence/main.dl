function ignore value:
    replacement:
        @intrinsic("discard", value)

[a|] boolean means: @intrinsic("type", "bool")

function return value:
    replacement:
        @intrinsic("return", value)

to get whether support for the value is {boolean:support}:
    return support

to get whether {boolean:value} controls support:
    return value

to get [whether support is available before the check when {boolean:support}|whether {boolean:support} means support is available after the check]:
    return support

to get whether shared support [before the check|after the check] is {boolean:support}:
    return support

label value means: @intrinsic("type", "string")

to get the label named {label value:label}:
    return label

function:
    patterns:
        the selected value is {boolean:value}
        {boolean:value} is the selected value
        the implicitly selected value
    execute:
        return value

class:
    patterns:
        [a|] holder
    members:
        instance as a boolean

ignore whether support for the value is @intrinsic("equal", 1, 1)
ignore whether @intrinsic("equal", 1, 1) controls support
ignore whether support is available before the check when @intrinsic("equal", 1, 1)
ignore whether @intrinsic("equal", 1, 1) means support is available after the check
ignore whether shared support before the check is @intrinsic("equal", 1, 1)
ignore whether shared support after the check is @intrinsic("equal", 1, 1)
ignore the label named "token"
ignore the selected value is @intrinsic("equal", 1, 1)
ignore @intrinsic("equal", 1, 1) is the selected value
ignore the implicitly selected @intrinsic("equal", 1, 1)
@intrinsic("store", record, @intrinsic("construct", a holder, @intrinsic("equal", 1, 1)))
ignore the instance of record
