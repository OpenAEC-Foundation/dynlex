
import lib/std.dl

local function secret:
    execute:
        return 11

local class:
    patterns:
        [a|] shared record
    members:
        number as an integer

local flex section when shared condition:
    replacement:
        @intrinsic("if", condition)

local function visibility private after:
    execute:
        ignore private

to visibility public before: ignore public

to get the result from first module:
    set record to @intrinsic("construct", a shared record, secret)
    set output to 0
    when shared true:
        set output to record's number
    return output

visibility 1 after
