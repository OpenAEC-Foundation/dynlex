import lib/std.dl

set platform_is_cpu to 1 if the build target is cpu, else 0
set shader_stage_is_empty to 1 if (not this is a fragment shader) and (not this is a vertex shader), else 0
set word_size to 64 if the build word size = 64, else 32

print platform_is_cpu as line
print shader_stage_is_empty as line
print word_size as line
