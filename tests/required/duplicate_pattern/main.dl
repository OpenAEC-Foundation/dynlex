function [an|a|] integer:
	replacement:
		@intrinsic("type", "int")

function discard val:
	replacement:
		@intrinsic("discard", val)

function test:
	execute:
		discard @intrinsic("variadic call", "libc", "printf", an integer, 1, "1")

function te[st|]:
	execute:
		discard @intrinsic("variadic call", "libc", "printf", an integer, 1, "2")
