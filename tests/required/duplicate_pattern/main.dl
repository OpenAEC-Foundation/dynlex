function [an|] integer:
	replacement:
		@intrinsic("type", "int")

function ignore value:
	replacement:
		@intrinsic("discard", value)

function test:
	execute:
		ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "1")

function te[st|]:
	execute:
		ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "2")
