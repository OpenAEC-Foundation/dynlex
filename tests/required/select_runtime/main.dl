function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function fixed quantity:
    replacement:
        @intrinsic("fix", quantity)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function [a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("type", "int", bits)

function value as [a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("cast", value, @intrinsic("type", "int", bits))

function affirmative if condition, else negative:
    replacement:
        @intrinsic("select", condition, affirmative, negative)

function left = right:
    replacement:
        @intrinsic("equal", left, right)

function print message:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", a 32 bit integer, 1, "%d\n", message as a 32 bit integer)

set succeeds to (@intrinsic("call", "libc", "abs", a 32 bit integer, 1) = 1)
set fails to (@intrinsic("call", "libc", "abs", a 32 bit integer, 1) = 2)

print 10 if succeeds, else 20
print 10 if fails, else 20
