import lib/json_rpc.dl

function [the|] strict transport test interpreter:
    execute:
        return "python" if the process platform is Windows, else "python3"

function the strict transport test command for {C string:bytes} hanging {boolean:hang} with {C string:error}:
    execute:
        set script to "import sys,time\nsys.stderr.write(sys.argv[3]);sys.stderr.flush()\nsys.stdout.buffer.write(bytes.fromhex(sys.argv[1]));sys.stdout.buffer.flush()\nif sys.argv[2]=='1': time.sleep(10)"
        set result to a process command for the strict transport test interpreter
        add "-u" as an argument to result
        add "-c" as an argument to result
        add script as an argument to result
        add bytes as an argument to result
        add ("1" if hang, else "0") as an argument to result
        add error as an argument to result
        return result

function the strict transport test limits:
    execute:
        set rules to the default json rpc limits
        set rules's maximum header length to 256
        set rules's maximum payload length to 256
        set rules's maximum buffered output length to 512
        set rules's maximum standard error length to 256
        set rules's graceful close timeout to 10
        set rules's termination timeout to 100
        return rules

function frame {C string:bytes} is rejected with status {integer:status} while hanging {boolean:hang}:
    execute:
        set command to the strict transport test command for bytes hanging hang with ""
        set opened to the result of opening a json rpc connection using command under the strict transport test limits
        if the inverse of (opened's succeeded):
            return false
        set connection to opened's connection
        set received to the next json rpc message from connection
        set repeated to the next json rpc message from connection
        set broken to (connection's state = the json rpc broken state)
        set closed to the result of closing json rpc connection connection
        set passed to ((received's status = status) and (repeated's status = status))
        set passed to (passed and broken)
        set passed to (passed and closed's succeeded)
        free json rpc receive result received
        free json rpc receive result repeated
        free json rpc connection connection
        return passed

print frame "436f6e74656e742d4c656e6774683a20320a0a7b7d" is rejected with status the json rpc malformed frame status while hanging true as a line
print frame "436f6e74656e742d4c656e6774683a20320d583a20790d0d7b7d" is rejected with status the json rpc malformed frame status while hanging true as a line
print frame "583a206101620d0a436f6e74656e742d4c656e6774683a20320d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging true as a line
print frame "583a20617f620d0a436f6e74656e742d4c656e6774683a20320d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging true as a line
print frame "426164204e616d653a20780d0a436f6e74656e742d4c656e6774683a20320d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging false as a line
print frame "436f6e74656e742d4c656e6774683a20320d0a636f6e74656e742d6c656e6774683a20320d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging false as a line
print frame "583a20790d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging false as a line
print frame "436f6e74656e742d4c656e6774683a20320d0a436f6e74656e742d547970653a206170706c69636174696f6e2f7673636f64652d6a736f6e7270633b20636861727365743d6c6174696e310d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging false as a line
print frame "436f6e74656e742d4c656e6774683a20320d0a436f6e74656e742d547970653a206170706c69636174696f6e2f6a736f6e3b20636861727365743d7574662d380d0a0d0a7b7d" is rejected with status the json rpc malformed frame status while hanging false as a line
