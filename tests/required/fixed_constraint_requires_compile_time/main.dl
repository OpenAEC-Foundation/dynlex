function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function fixed value:
    replacement:
        @intrinsic("fix", value)

function the required {fixed integer:value}:
    execute:
        return value

function the runtime {integer:value}:
    execute:
        return the required value

ignore the runtime 1
