function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function [a|] C string:
    replacement:
        @intrinsic("type", "string")

class:
    patterns:
        box
    members:
        item

set instance to @intrinsic("construct", box, 1)
set instance's item to "wrong"
