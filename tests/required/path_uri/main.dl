import lib/path.dl
import lib/host.dl

function check {file URI result:result} against expected:
    execute:
        print whether (result succeeded) and ((result is supported) and (result's value = expected)) as a line

function check failure {file URI result:result}:
    execute:
        print whether (
            (result failed) and
            ((result is supported) and (result's error message is not empty))
        ) as a line

function check unsupported {file URI result:result}:
    execute:
        print whether (
            (result failed) and
            ((result is unsupported) and (result's error message is not empty))
        ) as a line

function check path failure {path result:result}:
    execute:
        print whether (result failed) and (result's error message is not empty) as a line

set style to the POSIX path style
set windows to the Windows path style

check (the file URI representing "/" using style) against "file:///"
check (the path from "file:///" interpreted as a file URI using style) against "/"

set encoded to the file URI representing "/tmp/é space#%.txt" using style
check encoded against "file:///tmp/%C3%A9%20space%23%25.txt"
check (the path from encoded's value interpreted as a file URI using style) against "/tmp/é space#%.txt"
check (the path from "file:///tmp/%3F%23%5Cx" interpreted as a file URI using style) against "/tmp/?#\\x"
check (the path from "file:/tmp/single-sigil" interpreted as a file URI using style) against "/tmp/single-sigil"
check (the path from "file://localhost/tmp/local" interpreted as a file URI using style) against "/tmp/local"
check unsupported (the path from "file://server/share/file" interpreted as a file URI using style)
check unsupported (the path from "file://[::1]/share/file" interpreted as a file URI using style)

set network to the file URI representing "//server/share/file" using style
check network against "file:////server/share/file"
check (the path from network's value interpreted as a file URI using style) against "//server/share/file"

check (the file URI representing "/tmp/a/../target" using style) against "file:///tmp/a/../target"
check (the path from "file:///tmp/a/../target" interpreted as a file URI using style) against "/tmp/a/../target"
check (the path from "file:///tmp/a/%2E%2E/target" interpreted as a file URI using style) against "/tmp/a/../target"
check (the path from "file:///tmp/a/%2e/target" interpreted as a file URI using style) against "/tmp/a/./target"

set drive to the file URI representing "C:\\Program Files\\é.txt" using windows
check drive against "file:///C:/Program%20Files/%C3%A9.txt"
check (the path from drive's value interpreted as a file URI using windows) against "C:/Program Files/é.txt"
check (the path from "file:/C:/single-sigil" interpreted as a file URI using windows) against "C:/single-sigil"
check (the path from "file://localhost/C:/local" interpreted as a file URI using windows) against "C:/local"

set share to the file URI representing "\\\\server\\share\\a b" using windows
check share against "file://server/share/a%20b"
check (the path from share's value interpreted as a file URI using windows) against "//server/share/a b"
check (the path from "file:////server/share/a%20b" interpreted as a file URI using windows) against "//server/share/a b"
check (the path from "file://192.0.2.1/share/a" interpreted as a file URI using windows) against "//192.0.2.1/share/a"
check (the path from "file://[2001:db8::1]/share/a" interpreted as a file URI using windows) against "//[2001:db8::1]/share/a"
check (the path from "file://[v1.host]/share/a" interpreted as a file URI using windows) against "//[v1.host]/share/a"
check (the file URI representing "\\\\[2001:db8::1]\\share\\a" using windows) against "file://[2001:db8::1]/share/a"
check (the path from "file:///C:/a/%2E%2E/target" interpreted as a file URI using windows) against "C:/a/../target"

set international to the file URI representing "\\\\server\\共享\\é.txt" using windows
check international against "file://server/%E5%85%B1%E4%BA%AB/%C3%A9.txt"
check (the path from international's value interpreted as a file URI using windows) against "//server/共享/é.txt"

set server to the file URI representing "\\\\sérver\\share\\文.txt" using windows
check server against "file://s%C3%A9rver/share/%E6%96%87.txt"
check (the path from server's value interpreted as a file URI using windows) against "//sérver/share/文.txt"

check path failure (the path obtained by resolving "child" against "relative/base" using style)
check path failure (the path from "relative/target" relative to "/absolute/base" using style)
check path failure (the path from "D:/target" relative to "C:/base" using windows)
check failure (the file URI representing "relative/path" using style)
check failure (the file URI representing "C:relative" using windows)
check failure (the path from "https://example.com/a" interpreted as a file URI using style)
check failure (the path from "file:///tmp/%G0" interpreted as a file URI using style)
check failure (the path from "file:///tmp/%" interpreted as a file URI using style)
check failure (the path from "file:///tmp/%00" interpreted as a file URI using style)
check failure (the path from "file:///tmp/é" interpreted as a file URI using style)
check failure (the path from "file:///tmp/a?query" interpreted as a file URI using style)
check failure (the path from "file:///tmp/a#fragment" interpreted as a file URI using style)
check failure (the path from "file:relative" interpreted as a file URI using style)
check failure (the path from "file://server/" interpreted as a file URI using windows)
check failure (the path from "file:///tmp/a%2Fb" interpreted as a file URI using style)
check failure (the path from "file:///C:/a%2Fb" interpreted as a file URI using windows)
check failure (the path from "file:///C:/a%5Cb" interpreted as a file URI using windows)
check failure (the path from "file:///tmp/a\\b" interpreted as a file URI using style)
check failure (the path from "file:///tmp/a b" interpreted as a file URI using style)
check failure (the path from "file://bad%G0/share" interpreted as a file URI using windows)
check failure (the path from "file://bad%2Fhost/share" interpreted as a file URI using windows)
check failure (the path from "file://user@server/share" interpreted as a file URI using windows)
check failure (the path from "file://server:80/share" interpreted as a file URI using windows)
check failure (the path from "file://[:::1]/share" interpreted as a file URI using windows)
check failure (the path from "file://[v1.]/share" interpreted as a file URI using windows)
check failure (the path from "file://[::1/share" interpreted as a file URI using windows)

set platform to whether the host platform is Windows
set destination to the string form of "C:/tmp/native path" if platform's value, else the string form of "/tmp/native path"
set locator to the string form of "file:///C:/tmp/native%20path" if platform's value, else the string form of "file:///tmp/native%20path"

set resolved to the path from locator interpreted as a file URI
print whether resolved succeeded as a line
print whether resolved is supported as a line
print whether (resolved's value = destination) as a line
print whether resolved's error message is empty as a line

set rejected to the path from (the string form of "file:///tmp/a%2Fb") interpreted as a file URI
print whether (
    (rejected failed) and
    ((rejected is supported) and
    ((rejected's value is empty) and (rejected's error message is not empty)))
) as a line

check (the file URI for destination interpreted as a native path) against locator
