function print shared value:
    globals:
        value
    execute:
        @intrinsic("discard", @intrinsic("call", "libc", "printf", @intrinsic("type", "int", 32), "%d\n", value))

@intrinsic("store", value, 7)
@intrinsic("store", holder, @intrinsic("static reference", @intrinsic("address of", value)))
@intrinsic("store at", @intrinsic("dereference", holder), 42)
print shared value
