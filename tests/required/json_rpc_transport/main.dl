import lib/json_rpc.dl

function [the|] json rpc transport test interpreter:
    execute:
        return "python" if the process platform is windows, else "python3"

set script to "import json,sys\nmessages=[({'jsonrpc':'2.0','method':'one','params':{'text':'hé😀'}},['X-Test: first','content-length: {length}']),({'jsonrpc':'2.0','method':'two'},['CONTENT-LENGTH: {length}','Content-Type: application/vscode-jsonrpc; charset=utf-8'])]\nfor message,headers in messages:\n payload=json.dumps(message,separators=(',',':'),ensure_ascii=False).encode('utf-8')\n frame=('\\r\\n'.join(line.format(length=len(payload)) for line in headers)+'\\r\\n\\r\\n').encode('ascii')+payload\n for byte in frame:\n  sys.stdout.buffer.write(bytes([byte])); sys.stdout.buffer.flush()\nrequest=sys.stdin.buffer.read()\nseparator=request.index(b'\\r\\n\\r\\n')\nheaders=request[:separator].decode('ascii').split('\\r\\n')\nlength=int(next(line.split(':',1)[1] for line in headers if line.split(':',1)[0].lower()=='content-length'))\npayload=request[separator+4:separator+4+length]\nmessage=json.loads(payload)\nvalid=message=={'jsonrpc':'2.0','method':'client/message','params':[1,True]}\nreply=json.dumps({'jsonrpc':'2.0','method':'verified','params':valid},separators=(',',':')).encode()\nsys.stdout.buffer.write(b'Content-Length: '+str(len(reply)).encode()+b'\\r\\n\\r\\n'+reply);sys.stdout.buffer.flush()"
set command to a process command for the json rpc transport test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add script as an argument to command

set child to launch command
set opened to connect json rpc to child
print opened's succeeded as line
set connection to opened's connection

set first to receive a json rpc message from connection
print first's succeeded as line
print (json text named "method" in first's message = "one") as line
set first_parameters to json member named "params" in first's message
print (json text named "text" in first_parameters = "hé😀") as line
free json rpc receive result first

set second to receive a json rpc message from connection
print second's succeeded as line
print (json text named "method" in second's message = "two") as line
free json rpc receive result second

set outgoing_parameters to a new json value of kind the json array kind
set outgoing_number to a new json value of kind the json number kind
set the number of outgoing_number to 1.0
set the text of outgoing_number to the string form of "1"
append json item outgoing_number to outgoing_parameters
set outgoing_boolean to a new json value of kind the json boolean kind
set the boolean of outgoing_boolean to true
append json item outgoing_boolean to outgoing_parameters
set sent to send json rpc notification "client/message" with outgoing_parameters using connection
print sent's succeeded as line
free json value outgoing_parameters
set closed_input to close the input of connection
print closed_input's succeeded as line

set verified to receive a json rpc message from connection
print verified's succeeded as line
print (json text named "method" in verified's message = "verified") as line
print json boolean named "params" in verified's message as line
free json rpc receive result verified

set eof_result to receive a json rpc message from connection
print (eof_result's status = the json rpc end of stream status) as line
free json rpc receive result eof_result

set closed to close json rpc connection connection
print closed's succeeded as line
free json rpc connection connection
