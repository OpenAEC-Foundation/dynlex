function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function fixed quantity:
    replacement:
        @intrinsic("fix", quantity)

function [an|] array of {fixed integer:length} items:
    replacement:
        @intrinsic("array", length)

function return value:
    replacement:
        @intrinsic("return", value)

function the product of left and right:
    execute:
        return @intrinsic("multiply", left, right)

function left is right:
    execute:
        return @intrinsic("equal", left, right)

function left and right:
    execute:
        return @intrinsic("and", left, right)

function affirmative if condition, else negative:
    replacement:
        @intrinsic("select", condition, affirmative, negative)

function the build target is GPU:
    replacement:
        @intrinsic("target is", "gpu")

flex section if condition:
    replacement:
        @intrinsic("if", condition)

class:
    patterns:
        [a|] CPU box with {fixed integer:height} rows and {fixed integer:width} columns
    members:
        values as an array of the product of height and width items

function the box type with {fixed integer:height} rows and {fixed integer:width} columns:
    replacement:
        @intrinsic("matrix", height, width, an integer) if the build target is GPU, else a CPU box with height rows and width columns

function a box with {fixed integer:height} rows and {fixed integer:width} columns constructed from value:
    replacement:
        @intrinsic("construct", the box type with height rows and width columns, value)

function the selected box with {fixed integer:height} rows and {fixed integer:width} columns:
    execute:
        if height is 2 and width is 2:
            @intrinsic("return", a box with height rows and width columns constructed from [1, 2, 3, 4])

ignore the selected box with 2 rows and 2 columns
