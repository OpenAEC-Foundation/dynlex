function integer:
    replacement:
        @intrinsic("type", "int", 32)

function fixed tofix:
    replacement:
        @intrinsic("type", "const", tofix)

function array of {fixed integer:n} items:
    replacement:
        @intrinsic("array", n)

function return value:
    replacement:
        @intrinsic("return", value)

function left * right:
    execute:
        return @intrinsic("multiply", left, right)

function left is right:
    execute:
        return @intrinsic("equal", left, right)

function left and right:
    execute:
        return @intrinsic("and", left, right)

function true_value if condition, else false_value:
    replacement:
        @intrinsic("select", condition, true_value, false_value)

function [the|] build target is {word:platform}:
    replacement:
        @intrinsic("target is", platform)

flex section if condition:
    replacement:
        @intrinsic("if", condition)

class:
    patterns:
        cpu box {fixed integer:n} x {fixed integer:m}
    members:
        values as array of n * m items

function box type {fixed integer:n} x {fixed integer:m}:
    replacement:
        @intrinsic("matrix", n, m, integer) if the build target is gpu, else cpu box n x m

function constructed box {fixed integer:n} x {fixed integer:m} from value:
    replacement:
        @intrinsic("construct", box type n x m, value)

function selected box {fixed integer:n} x {fixed integer:m}:
    execute:
        if n is 2 and m is 2:
            @intrinsic("return", constructed box n x m from [1, 2, 3, 4])

@intrinsic("discard", selected box 2 x 2)
