import map.dl
import set.dl

set alice to the string form of "alice"
set bob to the string form of "bob"
set ages to an empty map from string to integer
put 30 for alice in ages
put 40 for bob in ages
put 31 for alice in ages
print lines (the number of entries in ages), (ages contains key alice) and (the value for alice in ages)
remove alice from ages
print lines (ages contains key alice) and (the value for bob in ages)
clear ages
print line the number of entries in ages

set answer to the string form of "answer"
set labels to an empty map from integer to string
put answer for 42 in labels
print line the value for 42 in labels

set names to an empty set of string
add alice, bob and alice to names
print lines (the size of names) and (names contains alice)
remove alice from names
print line (names contains alice)
clear names
print line the size of names

free ages
free labels
free names
