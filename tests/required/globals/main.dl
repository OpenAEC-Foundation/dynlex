import lib/std.dl
import lib/string.dl

# test 1: global variable shared across multiple functions
expression increase total by amount:
    globals: total
    execute:
        set total to total + amount

expression show total:
    globals: total
    execute:
        print total as line

set total to 0
increase total by 10
increase total by 20
increase total by 5
show total

# test 2: local variable with same name as global (shadowing)
expression double value:
    get:
        set total to value * 2
        return total

print double 7 as line

# test 3: global should still be unchanged after shadowing
print total as line

# test 4: function-local variable doesn't leak to global scope
set result to 99
expression triple value:
    get:
        set result to value * 3
        return result

print triple 5 as line
# global "result" should still be 99, not overwritten by triple's local
print result as line

# test 5: expression with globals: DOES modify the global
expression set result to value times multiplier:
    globals: result
    execute:
        set result to value * multiplier

set result to 7 times 3
# global "result" should now be 21
print result as line
