import lib/std.dl

function {boolean:left} woven with {boolean:right}:
    before: $ follows $
    execute:
        return left and right

to get {floating-point number:left} [woven with|braided with] {floating-point number:right}:
    return left + right

to get {integer:left} braided with {integer:right}:
    return left + right

to get left follows right:
    return left - right

print line 10 follows 2 braided with 3
