import lib/host.dl
import lib/path.dl

set executable to the running executable path
set directory to the running executable directory
set cache to the user cache directory
set platform to whether the host platform is Windows
set native to the native path style
set style to native's value

print whether executable succeeded as a line
print whether executable is supported as a line
print whether directory succeeded as a line
print whether directory is supported as a line
print whether cache succeeded as a line
print whether cache is supported as a line
print whether platform succeeded as a line
print whether platform is supported as a line
print whether native succeeded as a line
print whether native is supported as a line
print whether (executable's error message = "") as a line
print whether (directory's error message = "") as a line
print whether (cache's error message = "") as a line
print whether (platform's error message = "") as a line
print whether (native's error message = "") as a line

set filename to the filename of executable's value using style
set parent to the parent path of executable's value using style
set resolved to the path obtained by resolving executable's value against directory's value using style
set program to whether executable's value is an absolute path using style
set folder to whether directory's value is an absolute path using style
set cached to whether cache's value is an absolute path using style

set expected to "main.exe" if platform's value, else "main.out"
print whether (filename succeeded) and (filename's value = expected) as a line
print whether (parent succeeded) and (parent's value = directory's value) as a line
print whether (resolved succeeded) and (resolved's value = executable's value) as a line
print ((program succeeded) and program's value) as a line
print ((folder succeeded) and folder's value) as a line
print ((cached succeeded) and cached's value) as a line
