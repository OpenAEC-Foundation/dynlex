import lib/filesystem.dl

set directory to "tests/required/filesystem_metadata/directory.tmp"
set file to "tests/required/filesystem_metadata/directory.tmp/file.tmp"
set missing to "tests/required/filesystem_metadata/missing.tmp"

delete the filesystem entry at file
delete the filesystem entry at directory

create a directory at directory and print whether it succeeded as a line
print (the length of (the error message of it)) as a line
print whether directory is a regular file as a line
print whether directory is readable as a line

write the string form of "metadata" to the file at file and print whether it succeeded as a line
print (the length of (the error message of it)) as a line
print whether file is a regular file as a line
set entry to the file system entry at file
print whether (entry's modification time)'s seconds > 0 as a line

read the file at missing and print whether it succeeded as a line
print whether (the length of the error message of it) > 0 as a line

create a directory at directory and print whether it succeeded as a line
print whether (the length of the error message of it) > 0 as a line

delete the filesystem entry at file and print whether it succeeded as a line
delete the filesystem entry at directory and print whether it succeeded as a line
