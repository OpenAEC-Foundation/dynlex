function return value:
    replacement:
        @intrinsic("return", value)

left = right means: @intrinsic("equal", left, right)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

flex section if condition:
    replacement:
        @intrinsic("if", condition)

class:
    patterns:
        [a|] container
    members:
        stored value

class:
    patterns:
        [a|] box
    members:
        values

to get {container:values} contains value:
    return the stored value of values = value

to get {box:object} contains value:
    return the values of object contains value

to get {box:object} does not contain value:
    return @intrinsic("not", object contains value)

flex function add value to {box:object}:
    replacement:
        if object does not contain value:
            @intrinsic("discard", value)

set values to @intrinsic("construct", a container, 2)
set object to @intrinsic("construct", a box, values)
add 1 to object
