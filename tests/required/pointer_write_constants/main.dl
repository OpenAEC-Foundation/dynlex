function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

flex section if condition:
    replacement:
        @intrinsic("if", condition)

flex section loop while condition:
    replacement:
        @intrinsic("loop while", condition)

function write through pointer:
    execute:
        @intrinsic("store at", pointer, 37)

function the identity of value:
    execute:
        @intrinsic("return", value)

function opaque zero:
    execute:
        @intrinsic("return", @intrinsic("call", "libc", "abs", @intrinsic("type", "int", 32), 0))

function write indirectly through holder:
    execute:
        set pointer to @intrinsic("dereference", holder)
        @intrinsic("store at", pointer, 53)

class:
    patterns:
        pointer state
    members:
        value
        published address
        returned value

set state to @intrinsic("construct", pointer state, 0, @intrinsic("cast", 0, @intrinsic("add pointer depth", @intrinsic("type", "int", 32))), 0)

function publish global address:
    globals:
        state
    execute:
        set state's published address to @intrinsic("address of", state's value)

function global value address:
    globals:
        state
    execute:
        @intrinsic("return", @intrinsic("address of", state's returned value))

class:
    patterns:
        address holder
    members:
        stored address

set direct to 0
write through @intrinsic("address of", direct)
if @intrinsic("equal", direct, 37):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "function pointer write")

set target to 0
@intrinsic("store at", @intrinsic("address of", target), 41)
if @intrinsic("equal", target, 41):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "direct store at")

set alias to 0
set address to @intrinsic("address of", alias)
@intrinsic("store at", address, 43)
if @intrinsic("equal", alias, 43):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "aliased store at")

set initialized to 0
@intrinsic("initialize at", @intrinsic("address of", initialized), 47)
if @intrinsic("equal", initialized, 47):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "initialize at")

set identity to 0
set reference to the identity of @intrinsic("address of", identity)
@intrinsic("store at", reference, 49)
if @intrinsic("equal", identity, 49):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "identity pointer return")

set number to 0
set pointer to @intrinsic("address of", number)
set holder to @intrinsic("address of", pointer)
write indirectly through holder
if @intrinsic("equal", number, 53):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "double pointer write")

set offset to 0
set forward to @intrinsic("add", @intrinsic("address of", offset), 0)
@intrinsic("store at", forward, 61)
if @intrinsic("equal", offset, 61):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "pointer arithmetic write")

set reverse to 0
set backward to @intrinsic("add", opaque zero, @intrinsic("address of", reverse))
@intrinsic("store at", backward, 63)
if @intrinsic("equal", reverse, 63):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "numeric-left pointer arithmetic write")

set property to 0
set container to @intrinsic("construct", address holder, @intrinsic("address of", property))
@intrinsic("store at", @intrinsic("property", container, "stored address"), 67)
if @intrinsic("equal", property, 67):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "property-held pointer write")

set owned to 0
set owner to @intrinsic("construct", address holder, @intrinsic("address of", owned))
set ownership to @intrinsic("address of", owner)
@intrinsic("store at", @intrinsic("property", ownership, "stored address"), 68)
if @intrinsic("equal", owned, 68):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "pointer-owner property write")

set byte to @intrinsic("cast", 0, @intrinsic("type", "int", 8))
set data to @intrinsic("address of", byte)
@intrinsic("store at", @intrinsic("property", data, "data"), @intrinsic("cast", 6, @intrinsic("type", "int", 8)))
if @intrinsic("equal", byte, @intrinsic("cast", 6, @intrinsic("type", "int", 8))):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "byte-pointer data property write")

set initial to 0
set replacement to 0
set reassigned to @intrinsic("construct", address holder, @intrinsic("address of", initial))
set @intrinsic("property", reassigned, "stored address") to @intrinsic("address of", replacement)
@intrinsic("store at", @intrinsic("property", reassigned, "stored address"), 69)
if @intrinsic("equal", replacement, 69):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "reassigned property-held pointer write")

set original to 0
set encoded to @intrinsic("cast", @intrinsic("address of", original), @intrinsic("type", "int", @intrinsic("build info", "word size")))
set decoded to @intrinsic("cast", encoded, @intrinsic("add pointer depth", @intrinsic("type", "int", 32)))
@intrinsic("store at", decoded, 71)
if @intrinsic("equal", original, 71):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "integer pointer round trip")

publish global address
@intrinsic("store at", state's published address, 73)
if @intrinsic("equal", state's value, 73):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "callee global pointer write")

set result to global value address
@intrinsic("store at", result, 75)
if @intrinsic("equal", state's returned value, 75):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "returned global pointer write")

set first to 0
set second to 0
set branch to @intrinsic("address of", first)
set choice to @intrinsic("equal", @intrinsic("call", "libc", "abs", @intrinsic("type", "int", 32), 1), 1)
if choice:
    set branch to @intrinsic("address of", second)
@intrinsic("store at", branch, 79)
if @intrinsic("equal", second, 79):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "branch pointer merge")

set entry to 0
set iteration to 0
set destination to @intrinsic("address of", entry)
set ongoing to @intrinsic("equal", @intrinsic("call", "libc", "abs", @intrinsic("type", "int", 32), 1), 1)
loop while ongoing:
    set destination to @intrinsic("address of", iteration)
    set ongoing to @intrinsic("equal", 0, 1)
@intrinsic("store at", destination, 83)
if @intrinsic("equal", iteration, 83):
    ignore @intrinsic("call", "libc", "puts", @intrinsic("type", "int", 32), "loop pointer merge")
