import lib/workspace_edit.dl
import lib/process.dl

create a temporary directory and set temporary to it
if temporary failed:
    print line temporary's error message
    @intrinsic("call", "libc", "abort", nothing)

set root to temporary's directory path
set native to the native path style
set child to root joined with "a b.txt" using native's value
set uri to the file URI for child's value interpreted as a native path
set normalized to the normalized workspace file URI for uri's value inside root
print lines (normalized succeeded), (normalized's path = child's value) and (normalized's relative path = "a b.txt")

set uri to the file URI for root interpreted as a native path
set text to formatted "{uri's value}/%2e%2e/outside.txt"
set escaped to the normalized workspace file URI for text inside root
print lines (escaped succeeded) and (escaped's failure reason)

set text to formatted "{uri's value}/folder/"
set directory to the normalized workspace file URI for text inside root
print lines (directory succeeded) and (directory's directory hint)

set invalid to the normalized workspace file URI for "https://example.com/file" inside root
print line invalid succeeded

set invalid to the normalized workspace file URI for "file:///tmp/a%2Fb" using the POSIX path style
print line invalid succeeded

set drive to the normalized workspace file URI for "file:///C:/Folder/%41.txt" using the Windows path style
print lines (drive succeeded), drive's path and drive's identity

set network to the normalized workspace file URI for "file://server/share/a%20b" using the Windows path style
print lines (network succeeded) and network's path

set target to root joined with "target" using native's value
set link to root joined with "alias" using native's value
create a directory tree at target's value
if the process platform is Windows:
    set command to a process command for "powershell.exe"
    add "-NoLogo" as an argument to command
    add "-NoProfile" as an argument to command
    add "-NonInteractive" as an argument to command
    add "-Command" as an argument to command
    add "$ErrorActionPreference = 'Stop'; New-Item -ItemType Junction -Path $env:DYNLEX_LINK -Target $env:DYNLEX_TARGET | Out-Null" as an argument to command
    set environment variable "DYNLEX_LINK" of command to link's value
    set environment variable "DYNLEX_TARGET" of command to target's value
else:
    set command to a process command for "ln"
    add "-s" as an argument to command
    add target's value as an argument to command
    add link's value as an argument to command
run command and set creation to it
if creation failed:
    print line creation's standard error
print line creation's exit code
set uri to the file URI for link's value interpreted as a native path
set linked to the normalized workspace file URI for uri's value inside root
print lines (linked succeeded) and (linked's failure reason)

remove the filesystem tree at root and set cleanup to it
print line cleanup succeeded
