import lib/workspace_edit.dl

create a temporary directory and set temporary to it
if temporary failed:
    print temporary's error message as a line
    @intrinsic("call", "libc", "abort", nothing)

set root to temporary's directory path
set native to the native path style
set child to root joined with "a b.txt" using native's value
set uri to the file URI for child's value interpreted as a native path
set normalized to the normalized workspace file URI for uri's value inside root
print whether normalized succeeded as a line
print (normalized's path = child's value) as a line
print (normalized's relative path = "a b.txt") as a line

set uri to the file URI for root interpreted as a native path
set text to (uri's value + the string form of "/%2e%2e/outside.txt")
set escaped to the normalized workspace file URI for text inside root
print whether escaped succeeded as a line
print escaped's failure reason as a line

set text to (uri's value + the string form of "/folder/")
set directory to the normalized workspace file URI for text inside root
print whether directory succeeded as a line
print directory's directory hint as a line

set invalid to the normalized workspace file URI for "https://example.com/file" inside root
print whether invalid succeeded as a line

set invalid to the normalized workspace file URI for "file:///tmp/a%2Fb" using the POSIX path style
print whether invalid succeeded as a line

set drive to the normalized workspace file URI for "file:///C:/Folder/%41.txt" using the Windows path style
print whether drive succeeded as a line
print drive's path as a line
print drive's identity as a line

set network to the normalized workspace file URI for "file://server/share/a%20b" using the Windows path style
print whether network succeeded as a line
print network's path as a line

set target to root joined with "target.txt" using native's value
set link to root joined with "alias.txt" using native's value
set status to @intrinsic(
    "call",
    "libc",
    "symlink",
    an integer,
    the data of target's value,
    the data of link's value
)
print status as a line
set uri to the file URI for link's value interpreted as a native path
set linked to the normalized workspace file URI for uri's value inside root
print whether linked succeeded as a line
print linked's failure reason as a line

remove the filesystem tree at root and set cleanup to it
print whether cleanup succeeded as a line
