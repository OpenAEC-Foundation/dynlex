import lib/workspace_edit.dl

create a temporary directory
set temporary to it
if not temporary's succeeded:
    print temporary's error_message as line
    @intrinsic("call", "libc", "abort", void)

set root_path to temporary's directory_path
set native_style to the native path style
set child_path_result to join root_path with "a b.txt" using native_style's value
set child_uri_result to a file URI from native path child_path_result's value
set normalized to normalize workspace file URI child_uri_result's value inside native root root_path
print normalized's succeeded as line
print (normalized's path = child_path_result's value) as line
print (normalized's relative path = "a b.txt") as line

set root_uri_result to a file URI from native path root_path
set escaped_uri to root_uri_result's value + the string form of "/%2e%2e/outside.txt"
set escaped to normalize workspace file URI escaped_uri inside native root root_path
print escaped's succeeded as line
print escaped's failure reason as line

set directory_uri to root_uri_result's value + the string form of "/folder/"
set directory_normalized to normalize workspace file URI directory_uri inside native root root_path
print directory_normalized's succeeded as line
print directory_normalized's directory hint as line

set invalid_scheme to normalize workspace file URI "https://example.com/file" inside native root root_path
print invalid_scheme's succeeded as line

set invalid_escape to normalize workspace file URI "file:///tmp/a%2Fb" using the POSIX path style
print invalid_escape's succeeded as line

set windows_drive to normalize workspace file URI "file:///C:/Folder/%41.txt" using the Windows path style
print windows_drive's succeeded as line
print windows_drive's path as line
print windows_drive's identity as line

set windows_unc to normalize workspace file URI "file://server/share/a%20b" using the Windows path style
print windows_unc's succeeded as line
print windows_unc's path as line

set target_path_result to join root_path with "target.txt" using native_style's value
set link_path_result to join root_path with "alias.txt" using native_style's value
set target_path to target_path_result's value
set link_path to link_path_result's value
set symlink_status to @intrinsic(
    "call",
    "libc",
    "symlink",
    an integer,
    the data of target_path,
    the data of link_path
)
print symlink_status as line
set link_uri_result to a file URI from native path link_path
set link_normalized to normalize workspace file URI link_uri_result's value inside native root root_path
print link_normalized's succeeded as line
print link_normalized's failure reason as line

remove filesystem tree at root_path
set cleanup to it
print cleanup's succeeded as line
