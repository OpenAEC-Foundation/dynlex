import lib/std.dl

class:
    patterns:
        a number box
    members:
        payload as an integer

implicitly convert {integer:number}:
    execute:
        return @intrinsic("construct", a number box, number)

function the payload unwrapped from {a number box:wrapped}:
    execute:
        return the payload of wrapped

print (the payload unwrapped from 42) as a line
