import lib/std.dl

flex section choose {boolean:condition}:
    replacement:
        @intrinsic("if", condition)

flex section choose {integer:count}:
    replacement:
        @intrinsic("loop while", false)

flex section fallback:
    replacement:
        @intrinsic("else")

set result to 0
choose true:
    set result to 1
fallback:
    set result to 2

print result as a line
