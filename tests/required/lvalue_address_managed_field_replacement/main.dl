import lib/std.dl

class:
    patterns:
        [a|] tracked value
    members:
        references as pointer to integer
    retain:
        set count to @intrinsic("dereference", the references of @intrinsic("lifecycle value"))
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count + 1)
    release:
        set count to @intrinsic("dereference", the references of @intrinsic("lifecycle value")) - 1
        @intrinsic("store at", the references of @intrinsic("lifecycle value"), count)

class:
    patterns:
        managed container
    members:
        value as tracked value

set old_references to 0
set new_references to 0
set container to @intrinsic("construct", managed container, @intrinsic("construct", a tracked value, the address of old_references))
set value_address to the address of the value of container
@intrinsic("store at", value_address, @intrinsic("construct", a tracked value, the address of new_references))
print old_references as line
print new_references as line
