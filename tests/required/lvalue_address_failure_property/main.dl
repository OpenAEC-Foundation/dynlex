function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

class:
    patterns:
        [a|] box
    members:
        value as an integer

ignore @intrinsic("property", @intrinsic("dereference", @intrinsic("address of", @intrinsic("construct", a box, 1))), "value")
