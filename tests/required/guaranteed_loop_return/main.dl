import lib/std.dl

function value from a guaranteed loop:
    execute:
        set unrelated to 0
        loop while true:
            set unrelated to 1
            return 1

function value after an unreachable loop:
    execute:
        loop while false:
            return false
        return 2

function value after a skipped falling loop:
    execute:
        loop while false:
            discard 0
        return 3

function value from a maybe returning loop condition:
    execute:
        loop while condition:
            return 4
        return 5

function value after a maybe falling loop condition:
    execute:
        loop while condition:
            discard 0
        return 6

print value from a guaranteed loop as line
print value after an unreachable loop as line
print value after a skipped falling loop as line
print value from a maybe returning loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, -1), 1) as line
print value from a maybe returning loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, 0), 1) as line
print value after a maybe falling loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, 0), 1) as line
