import lib/std.dl

to get the value from a guaranteed loop:
    set unrelated to 0
    loop while true:
        set unrelated to 1
        return 1

to get value after an unreachable loop:
    loop while false:
        return false
    return 2

to get value after a skipped falling loop:
    loop while false:
        ignore 0
    return 3

to get the value from a maybe returning loop condition:
    loop while condition:
        return 4
    return 5

to get value after a maybe falling loop condition:
    loop while condition:
        ignore 0
    return 6

print lines (the value from a guaranteed loop) and (value after an unreachable loop)
print line value after a skipped falling loop
print line the value from a maybe returning loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, -1), 1)
print line the value from a maybe returning loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, 0), 1)
print line value after a maybe falling loop @intrinsic("equal", @intrinsic("call", "libc", "abs", an integer, 0), 1)
