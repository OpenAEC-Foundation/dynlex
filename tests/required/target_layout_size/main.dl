import lib/std.dl

class:
    patterns:
        [a|] layout sample
    members:
        marker as a byte
        text as a string
        count as a 32 bit integer

class:
    patterns:
        [an|] aligned layout sample
    alignment:
        16
    members:
        marker as a byte
        padding:
            8
        count as a 32 bit integer
        tail as a byte

print lines (the size of a string), (the size of a layout sample) and (the size of an aligned layout sample)
set aligned to @intrinsic("construct", an aligned layout sample, 1 as a byte, 42, 2 as a byte)
print lines (the count of aligned) and (the tail of aligned)
