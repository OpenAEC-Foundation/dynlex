import lib/process.dl

function [the|] live process test interpreter:
    execute:
        return "python" if the process platform is windows, else "python3"

set command to a process command for the live process test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add "import sys\nfor line in sys.stdin:\n sys.stdout.write('out:' + line); sys.stdout.flush()\n sys.stderr.write('err:' + line); sys.stderr.flush()" as an argument to command
set child to launch command

print child's launched as line
set initial_status to poll child
print initial_status's succeeded as line
print (not initial_status's finished) as line
set initial_stdout to read available the standard output of child
print initial_stdout's succeeded as line
print (initial_stdout's contents = "") as line
print (not initial_stdout's end of stream) as line

set first_write to write (the string form of "first\n") to child
print first_write's succeeded as line
print first_write's byte count as line
set first_stdout to read the standard output of child
set first_stderr to read the standard error of child
print first_stdout's succeeded as line
print (first_stdout's contents = "out:first\n") as line
print first_stderr's succeeded as line
print (first_stderr's contents = "err:first\n") as line

set second_write to write (the string form of "second\n") to child
set close_result to close the standard input of child
print second_write's succeeded as line
print close_result's succeeded as line
set second_stdout to read the standard output of child
set second_stderr to read the standard error of child
print (second_stdout's contents = "out:second\n") as line
print (second_stderr's contents = "err:second\n") as line

set status to wait for child
print status's succeeded as line
print status's finished as line
print status's exit code as line
print (not status's terminated) as line

set sleeper_command to a process command for the live process test interpreter
add "-c" as an argument to sleeper_command
add "import time; time.sleep(30)" as an argument to sleeper_command
set sleeper to launch sleeper_command
set termination to terminate sleeper
set terminated_status to wait for sleeper
print sleeper's launched as line
print termination's succeeded as line
print terminated_status's succeeded as line
print terminated_status's finished as line
print terminated_status's terminated as line

set cleanup_child to launch sleeper_command
set cleanup_result to clean up cleanup_child
print cleanup_child's launched as line
print cleanup_result's succeeded as line
