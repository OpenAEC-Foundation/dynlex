function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

class:
    patterns:
        [a|] box
    members:
        value as an integer

ignore @intrinsic("address of", @intrinsic("property", @intrinsic("construct", a box, 1), "value"))
