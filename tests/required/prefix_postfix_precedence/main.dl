import lib/std.dl

function the loose opposite of value:
    after: $ + $
    execute:
        return -value

function the tight opposite of value:
    before: $ + $
    execute:
        return -value

function value loosely inverted:
    after: $ + $
    execute:
        return -value

function value tightly inverted:
    before: $ + $
    execute:
        return -value

print lines (the loose opposite of 2 + 1), (the tight opposite of 2 + 1) and (1 + 2 loosely inverted)
print line (1 + 2 tightly inverted)
