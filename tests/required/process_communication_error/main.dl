import lib/process.dl

function the communication error test interpreter:
    execute:
        return "python" if the process platform is Windows, else "python3"

set length to 262144
set input to a new string buffer containing length bytes
set position to 0
loop while position < length:
    store 73 as a byte into the data of input at position
    set position to (position + 1)

set command to a process command for the communication error test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add "import os,sys; print('before close'); print('input rejected', file=sys.stderr); os.close(0); sys.exit(9)" as an argument to command
run command using input and set result to it

print whether result was launched as a line
print whether result failed as a line
print whether (result's standard output = "before close\n") as a line
print whether (result's standard error = "input rejected\n") as a line
print whether (result's exit code = (9 as a 64 bit integer)) as a line
print whether result's error message is not empty as a line
