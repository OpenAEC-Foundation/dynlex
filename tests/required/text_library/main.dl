import text.dl

set padded to the string form of "  Hello, DynLex!  "
set clean to padded trimmed
print clean as a line
print (the lowercase form of clean) as a line
print (the uppercase form of clean) as a line
print whether (clean starts with "Hello") as a line
print whether (clean ends with "Lex!") as a line
print whether (clean contains "lo, Dyn") as a line
print (the substring of clean from 7 spanning 6 bytes) as a line
print (clean with "DynLex" replaced by "world") as a line
print ("ha" repeated 3 times) as a line

set text to the string form of "red,green,blue"
set parts to text split at ","
print the length of parts as a line
print the item at 1 in parts as a line
print (parts joined with " | ") as a line
free parts
