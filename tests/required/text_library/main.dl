import text.dl

set padded to the string form of "  Hello, DynLex!  "
set clean to padded trimmed
print lines clean, (the lowercase form of clean), (the uppercase form of clean) and (clean starts with "Hello")
print lines (clean ends with "Lex!"), (clean contains "lo, Dyn") and (the substring of clean from 7 spanning 6 bytes)
print lines (clean with "DynLex" replaced by "world") and ("ha" repeated 3 times)

set text to the string form of "red,green,blue"
set parts to text split at ","
print lines (the length of parts), (the item at 1 in parts) and (parts joined with " | ")
free parts
