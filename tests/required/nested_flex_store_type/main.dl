function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function return value:
    replacement:
        @intrinsic("return", value)

left = right means: @intrinsic("equal", left, right)

flex section if condition:
    replacement:
        @intrinsic("if", condition)

left + right means: @intrinsic("add", left, right)

class:
    patterns:
        [a|] list
    members:
        capacity

class:
    patterns:
        [a|] wrapper
    members:
        values

flex function ensure {list:values} using sample:
    replacement:
        set capacity to (the capacity of values + sample)

flex function append item to {list:values}:
    replacement:
        ensure values using item

to get {list:values} contains item:
    return the capacity of values = item

to get {wrapper:items} contains item:
    return the values of items contains item

to get {wrapper:items} does not contain item:
    return @intrinsic("not", items contains item)

flex function add item to {wrapper:items}:
    replacement:
        if items does not contain item:
            set updated to the values of items
            append item to updated
            set the values of items to updated

set values to @intrinsic("construct", a list, 7)
set items to @intrinsic("construct", a wrapper, values)
add 1 to items
