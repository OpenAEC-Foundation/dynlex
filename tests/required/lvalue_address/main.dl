function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function [a|] pointer to pointee:
    replacement:
        @intrinsic("add pointer depth", pointee)

class:
    patterns:
        [a|] cell
    members:
        number as an integer

class:
    patterns:
        [a|] holder
    members:
        child as a cell
        pointer as a pointer to an integer

class:
    patterns:
        [a|] managed holder
    members:
        references as a pointer to an integer
        child as a cell
    retain:
        @intrinsic("store", count, @intrinsic("dereference", @intrinsic("property", @intrinsic("lifecycle value"), "references")))
        @intrinsic("store at", @intrinsic("property", @intrinsic("lifecycle value"), "references"), @intrinsic("add", count, 1))
    release:
        @intrinsic("store", count, @intrinsic("subtract", @intrinsic("dereference", @intrinsic("property", @intrinsic("lifecycle value"), "references")), 1))
        @intrinsic("store at", @intrinsic("property", @intrinsic("lifecycle value"), "references"), count)

function pointer after incrementing counter:
    execute:
        @intrinsic("store", counter, @intrinsic("add", counter, 1))
        @intrinsic("return", pointer)

@intrinsic("store", number, 10)
@intrinsic("store", pointer, @intrinsic("address of", number))
@intrinsic("store", dereferenced, @intrinsic("address of", @intrinsic("dereference", pointer)))
@intrinsic("store at", dereferenced, 11)

@intrinsic("store", owner, @intrinsic("construct", a holder, @intrinsic("construct", a cell, 20), pointer))
@intrinsic("store", handle, @intrinsic("address of", owner))
@intrinsic("store", child, @intrinsic("address of", @intrinsic("property", owner, "child")))
@intrinsic("store", nested, @intrinsic("address of", @intrinsic("property", @intrinsic("property", owner, "child"), "number")))
@intrinsic("store at", nested, 21)
@intrinsic("store", indirect, @intrinsic("address of", @intrinsic("property", @intrinsic("dereference", handle), "child")))
@intrinsic("store", numeric, @intrinsic("address of", @intrinsic("dereference", @intrinsic("property", owner, "pointer"))))
@intrinsic("store at", numeric, 12)
@intrinsic("store", evaluations, 0)
@intrinsic("store", evaluated, @intrinsic("address of", @intrinsic("property", handle after incrementing evaluations, "child")))
@intrinsic("store", references, 0)
@intrinsic("store", managed, @intrinsic("construct", a managed holder, @intrinsic("address of", references), @intrinsic("construct", a cell, 30)))
@intrinsic("store", ownership, @intrinsic("address of", managed))
@intrinsic("store", retained, @intrinsic("address of", @intrinsic("property", managed, "child")))
@intrinsic("store", deep, @intrinsic("address of", @intrinsic("property", @intrinsic("property", managed, "child"), "number")))

ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d %d %d %d %d\n", @intrinsic("dereference", dereferenced), @intrinsic("property", @intrinsic("dereference", child), "number"), @intrinsic("property", @intrinsic("dereference", indirect), "number"), evaluations, references)
