function return value:
    replacement:
        @intrinsic("return", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

[an|] integer means: @intrinsic("type", "int")

to get left + right:
    return @intrinsic("add", left, right)

to get left - right:
    return @intrinsic("subtract", left, right)

to get left < right:
    return @intrinsic("less than", left, right)

to get left > right:
    return @intrinsic("greater than", left, right)

flex function repeat while condition:
    replacement:
        @intrinsic("loop while", condition)

flex section loop while condition:
    replacement:
        repeat while condition

flex section if condition:
    replacement:
        @intrinsic("if", condition)

to get the count from initial:
    set total to initial
    set cursor to 0
    loop while cursor < 2:
        if cursor > 0:
            set total to (total + 1)
        set cursor to (cursor + 1)
    return total

set initial to @intrinsic("call", "libc", "rand", an integer)
set result to the count from initial
set difference to (result - initial)
ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", difference)
