import lib/callbacks.dl

to get twice {integer:value}:
    return value * 2

class:
    patterns:
        callback holder
    members:
        action

set action to the function named "twice $"
set holder to @intrinsic("construct", callback holder, action)
print line (@intrinsic("invoke", holder's action, 7))
set empty to a new (a callback receiving integer returning integer)
print line (empty = (a new (the type of action)))
print line (action != empty)

set textual to a new (a callback receiving string returning string)
set container to @intrinsic("construct", callback holder, textual)
print line ((the size of (the request type of (container's action))) = (the size of string))
print line ((the size of (the request type of (holder's action))) = (the size of integer))

function describe {@intrinsic("function type", integer, integer):action}:
    execute:
        return 1
function describe {@intrinsic("function type", string, string):action}:
    execute:
        return 2
print line (describe action)
print line (describe textual)

to get the answer:
    return 42
set answer to the function named "the answer"
print line (@intrinsic("invoke", answer))
