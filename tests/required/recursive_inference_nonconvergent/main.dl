flex section if condition:
	replacement:
		@intrinsic("if", condition)

function first value:
	execute:
		if @intrinsic("greater than", value, 0):
			@intrinsic("return", second @intrinsic("subtract", value, 1))
		@intrinsic("return", second value)

function second value:
	execute:
		if @intrinsic("greater than", value, 0):
			@intrinsic("return", first @intrinsic("subtract", value, 1))
		@intrinsic("return", first value)

@intrinsic("discard", first 1)
