import lib/std.dl

function the text of {integer:value}:
    execute:
        return the string form of value

function {string:text} at character {integer:index}:
    execute:
        return the character at index in text

function {integer:number} at character {integer:index}:
    execute:
        return the remainder of (number / (10 raised to the power of index)) divided by 10

print the length of (the text of 123 at character 0) as a line
