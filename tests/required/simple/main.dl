macro function return value:
	replacement:
		@intrinsic("return", value)

macro function set var to val:
    replacement:
        @intrinsic("store", var, val)

macro function [an|a|] bits bit integer:
    replacement:
        @intrinsic("type", "int", bits)

macro function value as [a|an|] bits bit integer:
    replacement:
        @intrinsic("cast", value, @intrinsic("type", "int", bits))

function print msg:
    execute:
        @intrinsic("call", "libc", "printf", a 32 bit integer, "%ld", msg as a 64 bit integer)

macro function left + right:
    replacement:
        @intrinsic("add", left, right)

# Simple test
set x to 42
set y to 10
#this matches 'set $ to $' and the second '$' matches '$ + $'
set z to x  + y
print z