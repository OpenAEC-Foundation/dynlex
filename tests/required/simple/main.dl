function return value:
	replacement:
		@intrinsic("return", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

fixed quantity means: @intrinsic("fix", quantity)

[an|] integer means: @intrinsic("type", "int")

[a|] {fixed integer:bits} bit integer means: @intrinsic("type", "int", bits)

value as [a|] {fixed integer:bits} bit integer means: @intrinsic("cast", value, @intrinsic("type", "int", bits))

affirmative if condition, else negative means: @intrinsic("select", condition, affirmative, negative)

the build target is WebAssembly means: @intrinsic("target is", "wasm")

left = right means: @intrinsic("equal", left, right)

the WebAssembly output result for message means: @intrinsic("call", "env", "dynlex_print_i64", a 32 bit integer, message as a 64 bit integer)

the native output result for message means: @intrinsic("variadic call", "libc", "printf", a 32 bit integer, 1, "%ld", message as a 64 bit integer)

function print message:
    replacement:
        ignore (
            (the WebAssembly output result for message)
            if the build target is WebAssembly,
            else (the native output result for message)
        )

left + right means: @intrinsic("add", left, right)

# Simple test
set first to 42
set second to 10
#this matches 'set $ to $' and the second '$' matches '$ + $'
set total to (first  + second)
print total
