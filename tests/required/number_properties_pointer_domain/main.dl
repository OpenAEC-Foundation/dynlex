import lib/std.dl

to get pointer kind {a pointer to an integer:value}:
    return 1

to get numeric pointer {a pointer to a number:value}:
    return 2

to get width pointer {a pointer to a 32 bit value:value}:
    return 3

set signedValue to 1
set unsignedValue to 1 as a 32 bit unsigned integer
set floatValue to 1.0 as a 32 bit floating-point number
print lines (pointer kind (the address of signedValue)) and (pointer kind (the address of unsignedValue))
print lines (numeric pointer (the address of signedValue)) and (numeric pointer (the address of floatValue))
print lines (width pointer (the address of unsignedValue)) and (width pointer (the address of floatValue))

to get pointer kind {a pointer to a boolean:value}:
    return 4

to get byte pointer {a pointer to an 8 bit value:value}:
    return 5

to get byte pointer {a pointer to a boolean:value}:
    return 6

set boolValue to true
set byteValue to 1 as an 8 bit integer
print lines (pointer kind (the address of boolValue)) and (byte pointer (the address of byteValue))
print line byte pointer (the address of boolValue)
