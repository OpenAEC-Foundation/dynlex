import lib/filesystem.dl

set root to "tests/required/filesystem_directory_tree/tree.tmp"
set folder to "tests/required/filesystem_directory_tree/tree.tmp/one/two"
set file to "tests/required/filesystem_directory_tree/tree.tmp/file.bin"
set leaf to "tests/required/filesystem_directory_tree/tree.tmp/one/two/nested.bin"
set missing to "tests/required/filesystem_directory_tree/missing.tmp"

remove the filesystem tree at root and set initial to it
print whether initial succeeded as a line

create a directory tree at folder and set created to it
print whether created succeeded as a line
create a directory tree at folder and set duplicate to it
print whether duplicate succeeded as a line

write the string form of "root" to the file at file
write the string form of "nested" to the file at leaf

set metadata to the file system entry at file
print whether metadata lookup succeeded as a line
print whether metadata was found as a line
print whether metadata is a regular file as a line
print whether metadata is a directory as a line
print whether metadata is a symbolic link as a line
print whether metadata has another filesystem kind as a line
print whether (metadata's modification time)'s seconds > 0 as a line

set listing to the file system entry at folder
print whether listing lookup succeeded as a line
print whether listing was found as a line
print whether listing is a regular file as a line
print whether listing is a directory as a line

set absence to the file system entry at missing
print whether absence lookup succeeded as a line
print whether absence was found as a line
print (the length of absence's error message) as a line

set invalid to a new string from "A" containing 2 bytes
set failure to the file system entry at invalid
print whether failure lookup succeeded as a line
print whether failure was found as a line
print whether (the length of failure's error message) > 0 as a line
remove the filesystem tree at invalid and set cleanup to it
print whether cleanup succeeded as a line
print whether (the length of cleanup's error message) > 0 as a line

open the directory at root and set enumeration to it
print whether enumeration succeeded as a line
set entries to 0
set files to 0
set directories to 0
set success to true
set reading to true
loop while reading:
    read the next directory entry from enumeration and set next to it
    if next lookup failed:
        set success to false
        set reading to false
    else if next was found:
        increment entries
        if next is a regular file:
            increment files
        if next is a directory:
            increment directories
    else:
        set reading to false
print success as a line
print entries as a line
print files as a line
print directories as a line

remove the filesystem tree at root and set removed to it
print whether removed succeeded as a line
set remnant to the file system entry at root
print whether remnant lookup succeeded as a line
print whether remnant was found as a line
