import lib/filesystem.dl

set root to "tests/required/filesystem_directory_tree/tree.tmp"
set nested to "tests/required/filesystem_directory_tree/tree.tmp/one/two"
set file_path to "tests/required/filesystem_directory_tree/tree.tmp/file.bin"
set nested_file_path to "tests/required/filesystem_directory_tree/tree.tmp/one/two/nested.bin"
set missing_path to "tests/required/filesystem_directory_tree/missing.tmp"

set initial_cleanup to remove filesystem tree at root
print initial_cleanup's succeeded as line

set created to create directory tree at nested
print created's succeeded as line
set created_again to create directory tree at nested
print created_again's succeeded as line

write the string form of "root" to file_path
write the string form of "nested" to nested_file_path

set file_status to inspect filesystem entry at file_path
print file_status's succeeded as line
print file_status's found as line
print file_status's regular_file as line
print file_status's directory as line
print file_status's symbolic_link as line
print file_status's other as line
print file_status's modification_time > 0 as line

set directory_status to inspect filesystem entry at nested
print directory_status's succeeded as line
print directory_status's found as line
print directory_status's regular_file as line
print directory_status's directory as line

set missing_status to inspect filesystem entry at missing_path
print missing_status's succeeded as line
print missing_status's found as line
print (the length of missing_status's error_message) as line

set invalid_path to new string from data "A" with length 2
set invalid_status to inspect filesystem entry at invalid_path
print invalid_status's succeeded as line
print invalid_status's found as line
print (the length of invalid_status's error_message) > 0 as line
set invalid_cleanup to remove filesystem tree at invalid_path
print invalid_cleanup's succeeded as line
print (the length of invalid_cleanup's error_message) > 0 as line

set enumeration to open directory at root
print enumeration's succeeded as line
set entry_count to 0
set regular_file_count to 0
set directory_count to 0
set enumeration_succeeded to true
set reading_entries to true
loop while reading_entries:
    set next_entry to read next directory entry from enumeration
    if not next_entry's succeeded:
        set enumeration_succeeded to false
        set reading_entries to false
    else:
        if not next_entry's has_entry:
            set reading_entries to false
        else:
            increment entry_count
            if next_entry's regular_file:
                increment regular_file_count
            if next_entry's directory:
                increment directory_count
print enumeration_succeeded as line
print entry_count as line
print regular_file_count as line
print directory_count as line

set removed to remove filesystem tree at root
print removed's succeeded as line
set removed_status to inspect filesystem entry at root
print removed_status's succeeded as line
print removed_status's found as line
