import json.dl

parse "{\"name\":\"DynLex\",\"enabled\":true,\"values\":[1,2.5,null]}" as JSON and set parsed to it
print whether parsed succeeded as a line
set document to the value of parsed
print the JSON text named "name" in document as a line
print the JSON boolean named "enabled" in document as a line
set values to the JSON member named "values" in document
print the number of JSON items in values as a line
print the JSON number at index 1 in values as a line
free parsed

parse "{\"missing\":}" as JSON and set invalid to it
print whether invalid succeeded as a line
print the JSON error position in invalid as a line
free invalid
