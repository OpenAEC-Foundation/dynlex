function return value:
	replacement:
		@intrinsic("return", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function fixed quantity:
    replacement:
        @intrinsic("fix", quantity)

function value as [a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("cast", value, @intrinsic("type", "int", bits))

function print message as a line:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%ld\n", message as a 64 bit integer)

function left < right:
	execute:
		return @intrinsic("less than", left, right)

function left + right:
    replacement:
        @intrinsic("add", left, right)

flex section loop while condition:
	replacement:
		@intrinsic("loop while", condition)

set index to 0

loop while index < 10:
	print index as a line
	set index to (index + 1)
