import lib/std.dl
import lib/matrix.dl

class:
    patterns:
        [a|] car
    members:
        speed as an integer

set vehicle_type to a car
set vehicle to a new car
set transform_type to a 3 by 3 matrix
set transform to a new 3 by 3 matrix

print lines (the speed of vehicle), (the item at 0 in the values of transform) and (the size of transform_type)
ignore @intrinsic("size of", vehicle_type)
ignore @intrinsic("size of", transform_type)
