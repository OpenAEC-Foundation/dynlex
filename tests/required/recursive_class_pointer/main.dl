function [a|] pointer to pointed_type:
    replacement:
        @intrinsic("add pointer depth", pointed_type)

function discard value:
    replacement:
        @intrinsic("discard", value)

function value as destination_type:
    replacement:
        @intrinsic("cast", value, destination_type)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function [the|] address of variable:
    replacement:
        @intrinsic("address of", variable)

function [the|] value at pointer:
    replacement:
        @intrinsic("dereference", pointer)

class:
    patterns:
        [a|] node
    members:
        next as a pointer to node

discard 0 as a pointer to node
set child to @intrinsic("construct", node, 0 as a pointer to node)
set child_pointer to the address of child
discard the value at child_pointer
