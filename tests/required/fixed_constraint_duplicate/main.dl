function return value:
    replacement:
        @intrinsic("return", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function fixed value:
    replacement:
        @intrinsic("fix", value)

function the duplicate of {integer:value}:
    execute:
        return value

function the duplicate of {fixed integer:value}:
    execute:
        return value

the duplicate of 1
