import lib/std.dl

# ==========================================================
# Test 1: Basic literal vs argument specificity
# ==========================================================
# Generic pattern: "item" resolves as a Variable (argument slot)
expression turn the item off for user:
    get:
        return item + 100 + user

# Body reference "turn the lights off for 4" exists BEFORE the specific pattern.
# It initially matches the generic pattern (with "lights" captured as argument).
# When the specific pattern is added later, the compiler must detect the overlap
# and re-match this reference to the specific pattern.
effect shut down the lights:
    execute:
        print turn the lights off for 4

shut down the lights

# Specific pattern: "lights" is a literal (not an argument).
# This is more specific than the generic pattern at the "lights" position.
# Adding it must invalidate references that matched the generic pattern.
expression turn the lights off for user:
    get:
        # Reference the generic pattern to confirm it still works independently
        set dummy to 1
        set test to turn the dummy off for user
        # Return a value that distinguishes this from the generic pattern
        set result to 1 + 1 + user
        return result

# Expected: 6 (specific pattern: 1+1+4=6, NOT generic: lights+100+4)

# ==========================================================
# Test 2: Specificity with submatch overlap
# ==========================================================
# "a new message" is a valid expression that returns a value.
# This means the generic "show msg" pattern's argument slot could
# consume "a new message" as a sub-expression match.
expression a new message:
    get:
        return 77

# Generic: "show msg" has an argument slot. When matching
# "show a new message", the argument could consume the sub-expression
# "a new message" (which evaluates to 77).
effect show msg:
    execute:
        print msg

# Body reference uses "show a new message" — initially matches
# "show msg" with msg = sub-expression "a new message" (value 77).
# When the specific effect is added later, the overlap detector must
# recognize that the generic's argument consumed a sub-expression
# matching the specific's literal words, and re-match.
effect demonstrate:
    execute:
        show a new message

demonstrate

# Specific: "a new message" are literals in the effect pattern,
# more specific than the generic "show msg". Its body calls
# "show 99" (the generic) to confirm both coexist.
# Defined AFTER the reference above.
effect show a new message:
    execute:
        show 99

# Expected: 99 (specific "show a new message" calls "show 99",
# NOT generic "show msg" with msg=77)

# ==========================================================
# Test 3: Specificity with word capture vs literal
# ==========================================================
# {word:name} captures a single word as a string. A literal at the same
# position is more specific. The overlap detector must recognize that
# a word capture is less specific than a literal.
expression get the {word:prop} of item:
    get:
        # word capture version: just return the item
        return item

expression get the name of item:
    get:
        # literal "name" is more specific than {word:prop}
        return item + 1

# The reference should match the specific "name" pattern
print get the name of 50

# Expected: 51 (specific "name" pattern: 50+1=51, NOT word capture: 50)
