import lib/std.dl

class:
    patterns:
        first box
    members:
        payload as integer

class:
    patterns:
        second box
    members:
        payload as integer

implicitly convert {integer:value}:
    replacement:
        @intrinsic("construct", first box, value)

implicitly convert {first box:value}:
    replacement:
        @intrinsic("construct", second box, the payload of value)

function the payload unwrapped from {second box:value}:
    execute:
        return the payload of value

print (the payload unwrapped from 5) as line
