import lib/std.dl

class:
    patterns:
        a number box
    members:
        payload as integer

implicitly convert {integer:number}:
    replacement:
        @intrinsic("construct", a number box, number)

function describe {integer:value}:
    execute:
        return 1

function describe {a number box:value}:
    execute:
        return 2

print describe 9 as line
