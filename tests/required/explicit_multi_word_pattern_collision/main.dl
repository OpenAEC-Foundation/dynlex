type means: @intrinsic("type", "type")

signed means: @intrinsic("type", "int")

signed {type:properties} means: @intrinsic("and", @intrinsic("type", "int"), properties)

to get identity {signed octet}:
    @intrinsic("return", signed octet)

@intrinsic("variadic call", "libc", "printf", @intrinsic("type", "nothing"), 1, "%d\n", identity 7)
