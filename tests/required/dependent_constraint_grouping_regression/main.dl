function return value:
    replacement:
        @intrinsic("return", value)

[an|] integer means: @intrinsic("type", "int")

fixed value means: @intrinsic("fix", value)

an array means: @intrinsic("array")

[an|] array as long as value means: @intrinsic("array", @intrinsic("type extent", value, 0))

function left[ |]+[ |]right:
    before: $ = $
    execute:
        return @intrinsic("add", left, right)

function {an array:left}[ |]+[ |]{an array as long as left:right}:
    before: $ = $
    execute:
        return left

to get left[ |]=[ |]right:
    return @intrinsic("equal", left, right)

function store value into array at index:
    replacement:
        @intrinsic("store at", array + index, value)

to copy value into target at offset: store value into target at offset + 1
