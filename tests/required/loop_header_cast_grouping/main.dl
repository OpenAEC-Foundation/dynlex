word means: @intrinsic("type", "uint", 64)
type means: @intrinsic("type", "type")
function set target to value:
    replacement:
        @intrinsic("store", target, value)
to get value as {type:kind}:
    @intrinsic("return", @intrinsic("cast", value, kind))
to get left < right:
    @intrinsic("return", @intrinsic("less than", left, right))
flex function loop while condition:
    replacement:
        @intrinsic("loop while", condition)
flex section [loop |]while condition:
    replacement:
        loop while condition
to get count:
    set position to 0 as word
    loop while position < 3 as word:
        set position to @intrinsic("add", position, (1 as word))
    @intrinsic("return", position)
set result to count
@intrinsic("discard", @intrinsic("call", "libc", "putchar", @intrinsic("type", "int"), @intrinsic("cast", @intrinsic("add", result, (48 as word)), @intrinsic("type", "int"))))
