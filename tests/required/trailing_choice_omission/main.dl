import std.dl

# A trailing choice with an empty alternative can be omitted entirely.

function describe amount [loudly|]:
	execute:
		print amount as line

describe 4 loudly
describe 9

# The same works when the trailing alternative is a parameter: bound when the
# caller supplies it, a fresh local when omitted.
function stretch amount [factor|]:
	execute:
		set factor to amount * 3
		return factor

print (stretch 2 5) as line
print (stretch 4) as line

# Adjacent omittable choices: every combination composes with clean separators.
function report [gently|] [twice|]:
	execute:
		print 5 as line

report
report gently
report twice
report gently twice

# Author-placed spaces inside alternatives are equivalent to spaces outside.
function start [the |]drill:
	execute:
		print 8 as line

start the drill
start drill
