function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function return value:
    replacement:
        @intrinsic("return", value)

class:
    patterns:
        [a|] textual value
    members:
        length as an integer

class:
    patterns:
        [a|] vector value
    members:
        element as an integer

function the length of {vector value:value}:
    execute:
        return 7
