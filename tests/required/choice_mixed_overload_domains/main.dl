function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function return value:
    replacement:
        @intrinsic("return", value)

class:
    patterns:
        textlike
    members:
        length as an integer

class:
    patterns:
        vectorlike
    members:
        element as an integer

function the length of {vectorlike:value}:
    execute:
        return 7
