import lib/std.dl

class:
    patterns:
        a number box
    members:
        payload as an integer

class:
    patterns:
        a box holder
    members:
        held as a number box

implicitly convert {integer:number}:
    replacement:
        @intrinsic("construct", a number box, number)

to get the boxed value chosen using {boolean:first}:
    if first:
        return @intrinsic("construct", a number box, 31)
    return 47

set variable to @intrinsic("construct", a number box, 1)
set variable to 2
print line the payload of variable

set holder to @intrinsic("construct", a box holder, @intrinsic("construct", a number box, 3))
set the held of holder to 4
print line the payload of the held of holder

set returned to the boxed value chosen using false
print line the payload of returned
