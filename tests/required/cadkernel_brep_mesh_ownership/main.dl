# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_mesh.dl
import lib/cadkernel/brep_make.dl

function check mesh ownership {boolean:passed} named {C string:label}:
    execute:
        if passed = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a returned test cad mesh at {a 64 bit floating-point number:offset}:
    execute:
        set made to the cad cuboid at (a cad vector3 with x offset, y 0.0 and z 0.0) with size (a cad vector3 with x 1.0, y 2.0 and z 3.0)
        return the cad mesh of made's value with maximum angle (the cad default sampling angle) within 1e-9

loop cycleIndex from 0 to 64:
    set originalMesh to a returned test cad mesh at (cycleIndex as a 64 bit floating-point number)
    set firstView to originalMesh
    set secondView to firstView
    check mesh ownership ((the cad triangle count of originalMesh) = 12) named "returned mesh"
    set otherMesh to a returned test cad mesh at ((cycleIndex + 100) as a 64 bit floating-point number)
    absorb cad mesh otherMesh into (the address of firstView)
    check mesh ownership ((the cad triangle count of originalMesh) = 24) named "shared mutation"
    check mesh ownership ((the length of secondView's positions) = 72) named "shared positions"
    free cad mesh otherMesh
    free cad mesh secondView
    free cad mesh firstView
    check mesh ownership ((the cad triangle count of originalMesh) = 24) named "surviving owner"
    free cad mesh originalMesh
print "cadkernel brep mesh ownership: PASS" as a line
