function integer:
	replacement:
		@intrinsic("type", "int")

function fixed tofix:
	replacement:
		@intrinsic("fix", tofix)

function emit [fixed {fixed integer:value}|plain]:
	execute:
		@intrinsic("return", value)

@intrinsic("discard", @intrinsic("variadic call", "libc", "printf", @intrinsic("type", "int"), 1, "%d\n", emit fixed 81))
