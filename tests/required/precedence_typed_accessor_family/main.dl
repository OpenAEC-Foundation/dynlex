function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

[an|] integer means: @intrinsic("type", "int")

function print line number:
    replacement:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", number))

left + right means: @intrinsic("add", left, right)

class:
    patterns:
        [a|] point
    members:
        coordinates as an integer

class:
    patterns:
        [a|] cursor
    members:
        x as an integer
        y as an integer

function {a point:value}'s x:
    before: $ + $
    replacement:
        value's coordinates

function {a point:value}'s y:
    before: $ + $
    replacement:
        value's coordinates

set location to @intrinsic("construct", a point, 10)
set mouse to @intrinsic("construct", a cursor, 20, 30)

print line location's x
print line mouse's x
print line mouse's y
print line location's x + mouse's x
print line location's y + mouse's y
