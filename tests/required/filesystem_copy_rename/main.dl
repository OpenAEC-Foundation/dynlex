import lib/filesystem.dl

set source_path to "tests/required/filesystem_copy_rename/input.txt"
set copy_path to "tests/required/filesystem_copy_rename/copy.tmp"
delete copy_path

copy source_path to copy_path
@intrinsic("discard", @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", @intrinsic("cast", it succeeded, an integer)))
set stream to @intrinsic("call", "libc", "fopen", a pointer to byte, copy_path, "rb")
set first_character to @intrinsic("call", "libc", "fgetc", an integer, stream)
@intrinsic("discard", @intrinsic("call", "libc", "fclose", an integer, stream))
@intrinsic("discard", @intrinsic("variadic call", "libc", "printf", an integer, 1, "%d\n", first_character))

delete copy_path
