integer means: @intrinsic("type", "int")
text means: @intrinsic("add pointer depth", @intrinsic("type", "int", 8))
the type of value means: @intrinsic("type of", value)
flex section if condition:
    replacement:
        @intrinsic("if", condition)
first matches second means: @intrinsic("equal", first, second)
to get sample:
    if 1 matches 1:
        @intrinsic("return", 7)
    @intrinsic("return", 0)
to get {the type of sample:first} matches {text:second}:
    @intrinsic("return", @intrinsic("equal", first, @intrinsic("cast", @intrinsic("dereference", second), integer)))
@intrinsic("discard", @intrinsic("call", "libc", "putchar", integer, @intrinsic("add", sample, 48)))
