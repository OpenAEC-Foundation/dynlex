import lib/sections.dl

class:
    patterns:
        configuration
    members:
        title as a C string
        values

section settings {name}:
    declares: name
    body:
        title: a C string
        values: many integer
    value:
        @intrinsic("construct", configuration, the body's title, the body's values)

settings example:
    title: "Configured"
    values:
        10
        20

print example's title as a line
print the length of example's values as a line
print the item at 1 in example's values as a line

settings empty:
    title: "Empty"

print the length of empty's values as a line
