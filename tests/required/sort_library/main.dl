import sort.dl

class:
    patterns:
        [a|] sortable record
    members:
        name as a string
        sequence as a 32 bit integer

function a new sortable record named {string:name} at index {integer:ordinal}:
    replacement:
        @intrinsic("construct", a sortable record, name, ordinal)

print (the bytewise comparison of "a" with "a") as a line
print (the bytewise comparison of "a" with "aa") as a line
print (the bytewise comparison of "b" with "aa") as a line

set extended to a new string buffer containing 1 byte
store 255 as a byte into the data of extended at 0
print (the bytewise comparison of extended with "z") as a line

set empty to an empty list of a string
sort empty stably in bytewise order
print the length of empty as a line
free empty

set strings to an empty list of a string
append the string form of "beta" to strings
append the string form of "alpha" to strings
append the string form of "alpha" to strings
append the string form of "" to strings
sort strings stably in bytewise order
set position to 0
loop while position < the length of strings:
    print the item at position in strings
    print "|"
    set position to position + 1
print "" as a line

set keys to an empty list of a string
append the string form of "b" to keys
append the string form of "a" to keys
append the string form of "b" to keys
append the string form of "a" to keys

set records to an empty list of sortable record
append a new sortable record named the string form of "first-b" at index 0 to records
append a new sortable record named the string form of "first-a" at index 1 to records
append a new sortable record named the string form of "second-b" at index 2 to records
append a new sortable record named the string form of "second-a" at index 3 to records

set order to the stable bytewise order for keys
set position to 0
loop while position < the length of order:
    if position > 0:
        print " "
    print the item at position in order
    set position to position + 1
print "" as a line

sort records stably in the bytewise order of keys
set ordinal to 0
loop while ordinal < the length of records:
    set record to the item at ordinal in records
    print the name of record
    print ":"
    print the sequence of record
    print "|"
    set ordinal to ordinal + 1
print "" as a line

free order
free records
free keys
free strings
