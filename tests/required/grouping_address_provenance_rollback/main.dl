function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

[an|] integer means: @intrinsic("type", "int")

[a|] floating-point number means: @intrinsic("type", "float")

to get left - right:
    return @intrinsic("cast", @intrinsic("subtract", left, right), @intrinsic("type", "float"))

to get {floating-point number:value} adjusted to be odd:
    return value

function {integer:value} adjusted to be odd:
    globals:
        guard
    execute:
        set rejected to @intrinsic("address of", guard)
        return @intrinsic("cast", value, @intrinsic("type", "float"))

to get value tested:
    return value - 1 adjusted to be odd

to get the identity of value:
    return value

set guard to 32
set target to 0
ignore 4 tested
set pointer to the identity of @intrinsic("address of", target)
@intrinsic("store at", pointer, 1)
ignore @intrinsic("call", "libc", "abs", @intrinsic("type", "int", guard), 1)
