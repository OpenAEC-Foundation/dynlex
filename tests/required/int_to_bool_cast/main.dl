import lib/std.dl

function output message through WebAssembly:
    replacement:
        ignore @intrinsic("call", "env", "dynlex_print_i64", an integer, message as a 64 bit integer)

function output message natively:
    replacement:
        ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%ld\n", message as a 64 bit integer)

function output message:
    execute:
        if the build target is WebAssembly:
            output message through WebAssembly
        else:
            output message natively

set one to 1 as a boolean
set zero to 0 as a boolean

output one
output zero

if 2 as a boolean:
    output 1
