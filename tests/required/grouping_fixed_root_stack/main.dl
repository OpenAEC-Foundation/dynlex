function return value:
    replacement:
        @intrinsic("return", value)

function ignore value:
    replacement:
        @intrinsic("discard", value)

function fixed value:
    replacement:
        @intrinsic("fix", value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function [a|] {fixed integer:bits} bit integer:
    replacement:
        @intrinsic("type", "int", bits)

function value as destination:
    execute:
        return @intrinsic("cast", value, destination)

function the floor of value:
    execute:
        return @intrinsic("floor", value)

function rounded value:
    execute:
        return (the floor of value) as a 64 bit integer

ignore rounded 1.5
