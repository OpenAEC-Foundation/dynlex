section if condition:
    replacement:
        @intrinsic("if", condition)

function finish with value:
    replacement:
        @intrinsic("return", value)

to visit depth:
    if @intrinsic("less than", depth, 3):
        visit @intrinsic("add", depth, 1)

to get the result at depth:
    visit depth
    if @intrinsic("less than", depth, 3):
        finish with the result at @intrinsic("add", depth, 1)
    finish with depth

@intrinsic("return", @intrinsic("subtract", the result at 0, 3))
