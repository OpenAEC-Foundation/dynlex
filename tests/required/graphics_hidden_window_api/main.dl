import lib/graphics.dl

print "graphics window visibility is available" as a line

# The creation call is intentionally unreachable: required API tests must not
# need a display server, while still compiling the public hidden-window API.
if false:
	set hidden to a new hidden window with width 1 and height 1
	if hidden is visible:
		close hidden
		return 1
	set {visible window} to a new window with width 1 and height 1
	set version to the Vulkan API version of visible window
	set portability to Vulkan portability is enabled for visible window
	set device to the graphics device name of visible window
	set {graphics error} to the current graphics error message
	ignore version
	ignore portability
	ignore device
	ignore graphics error
	set {fullscreen window} to a new fullscreen window
