class:
    patterns:
        slot
    members:
        address
class:
    patterns:
        record
    members:
        kind
class:
    patterns:
        holder
    members:
        data
to put item in owner: @intrinsic("initialize at", @intrinsic("property", owner, "data"), item)
@intrinsic("store", supplied, @intrinsic("construct", record, 1))
@intrinsic("store", source, @intrinsic("construct", holder, @intrinsic("cast", @intrinsic("address of", supplied), @intrinsic("add pointer depth", record))))
@intrinsic("store", original, @intrinsic("address of", source))
@intrinsic("store", wrapper, @intrinsic("construct", slot, original))
put supplied in @intrinsic("property", wrapper, "address")
@intrinsic("store", readback, @intrinsic("dereference", @intrinsic("property", original, "data")))
@intrinsic("return", @intrinsic("subtract", @intrinsic("property", readback, "kind"), 1))
