flex function return value:
    replacement:
        @intrinsic("return", value)

flex function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

[an|] integer means: @intrinsic("type", "int")

fixed value means: @intrinsic("fix", value)

[a|] {fixed integer:bits} bit integer means: @intrinsic("type", "int", bits)

value as [a|] {fixed integer:bits} bit integer means: @intrinsic("cast", value, @intrinsic("type", "int", bits))

function print line message:
    replacement:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", an integer, 1, "%lld\n", message))

to get left < right:
    return @intrinsic("less than", left, right)

to get left > right:
    return @intrinsic("greater than", left, right)

to get left equals right:
    return @intrinsic("equal", left, right)

truth if condition, else falsehood means: @intrinsic("select", condition, truth, falsehood)

left + right means: @intrinsic("add", left, right)

left * right means: @intrinsic("multiply", left, right)

left / right means: @intrinsic("divide", left, right)

left mod right means: @intrinsic("modulo", left, right)

flex section loop while condition:
    replacement:
        @intrinsic("loop while", condition)

set steps to 0 as a 64 bit integer
set number to 1 as a 64 bit integer

loop while number < 1000000:
    set current to number
    loop while current > 1:
        set steps to steps + 1
        set remainder to current mod 2
        set current to ((current / 2) if remainder equals 0, else ((current * 3) + 1))
    set number to number + 1

print line steps
