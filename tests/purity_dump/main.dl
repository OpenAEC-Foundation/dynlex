function return value:
    replacement:
        @intrinsic("return", value)

function set variable to value:
    replacement:
        @intrinsic("store", variable, value)

function [an|] integer:
    replacement:
        @intrinsic("type", "int")

function left + right:
    replacement:
        @intrinsic("add", left, right)

function the address of value:
    replacement:
        @intrinsic("address of", value)

function print a runtime marker:
    replacement:
        @intrinsic("discard", @intrinsic("call", "libc", "puts", an integer, "side effect"))

function the sum of left and right:
    execute:
        set result to left
        set result to (result + right)
        return result

function input increased by one:
    execute:
        return the sum of input and 1

function store value globally:
    globals: total
    execute:
        set total to value

function the global value:
    globals: total
    execute:
        return total

function set target to value through its address:
    execute:
        set target to value

function input after printing a runtime marker:
    execute:
        print a runtime marker
        return input

function atomically load target:
    execute:
        return @intrinsic("atomic load", the address of target, "relaxed")

function atomically store value in target:
    execute:
        @intrinsic("atomic store", the address of target, value, "release")

function atomically add value to target:
    execute:
        return @intrinsic("atomic fetch add", the address of target, value, "acq_rel")

set total to 0
set local to 0
set sum to the sum of 1 and 2
set increment to 4 increased by one
store 3 globally
set retrieved to the global value
set local to 9 through its address
set affected to 5 after printing a runtime marker
set slot to 0
set loaded to atomically load slot
atomically store 1 in slot
set old to atomically add 1 to slot
