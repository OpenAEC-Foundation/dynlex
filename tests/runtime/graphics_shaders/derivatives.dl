import lib/shader.dl

set x to the fragment x coordinate
set y to the fragment y coordinate
set scalar to x * 0.25 + y * 0.125
set pair to @intrinsic("construct", @intrinsic("vector", 2), x * 0.125 + y * 0.25, x * 0.25 - y * 0.125)
set triple to @intrinsic("construct", @intrinsic("vector", 3), x * 0.125 + y * 0.25, x * 0.25 - y * 0.125, x * 0.375 + y * 0.0625)
set quadruple to @intrinsic("construct", @intrinsic("vector", 4), x * 0.125 + y * 0.25, x * 0.25 - y * 0.125, x * 0.375 + y * 0.0625, x * -0.25 + y * 0.375)
set first to the horizontal shader derivative of scalar
set second to the vertical shader derivative of scalar
set third to the horizontal shader derivative of pair
set fourth to the vertical shader derivative of pair
set fifth to the horizontal shader derivative of triple
set sixth to the vertical shader derivative of triple
set seventh to the horizontal shader derivative of quadruple
set eighth to the vertical shader derivative of quadruple
set mode to the shader uniform named "mode" at binding 0 as a 32 bit integer
set red to first
set green to 0.0
set blue to 0.0
if mode = 1:
    set red to second
if mode = 2:
    set red to the element at 0 in third
    set green to the element at 1 in third
if mode = 3:
    set red to the element at 0 in fourth
    set green to the element at 1 in fourth
if mode = 4:
    set red to the element at 0 in fifth
    set green to the element at 1 in fifth
    set blue to the element at 2 in fifth
if mode = 5:
    set red to the element at 0 in sixth
    set green to the element at 1 in sixth
    set blue to the element at 2 in sixth
if mode = 6:
    set red to the element at 3 in seventh
    set green to the element at 1 in seventh
    set blue to the element at 2 in seventh
if mode = 7:
    set red to the element at 3 in eighth
    set green to the element at 1 in eighth
    set blue to the element at 2 in eighth
set the fragment color with a red channel of (red * 0.5 + 0.5), a green channel of (green * 0.5 + 0.5), a blue channel of (blue * 0.5 + 0.5) and an alpha channel of 1.0
