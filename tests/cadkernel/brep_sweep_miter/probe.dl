# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_sweep_planar.dl

function miter probe number {a number:value}:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", integer, 1, "%.17g\n", value as a 64 bit floating-point number)

function miter probe point {a number:x} {a number:y}:
    execute:
        return a cad vector2 with x (x as a 64 bit floating-point number) and y (y as a 64 bit floating-point number)

function miter probe line from {cad vector2:start} to {cad vector2:finish}:
    execute:
        return the cad curve2 of (a cad line2 from start to finish)

function miter probe body {cad body:body}:
    execute:
        miter probe number (the cad count of (body's vertices))
        miter probe number (the cad count of (body's edges))
        miter probe number (the cad count of (body's coedges))
        miter probe number (the cad count of (body's loops))
        miter probe number (the cad count of (body's faces))
        miter probe number (the cad count of (body's shells))
        miter probe number (the cad count of (body's lumps))
        miter probe number (the cad count of (body's surfaces))
        miter probe number (the cad count of (body's curves))
        miter probe number (the length of (body's roots))
        set flaws to the cad flaws of body
        miter probe number (the length of flaws)
        free flaws
        set edgeKeys to the cad edge keys of body
        set manifoldEdges to 0
        loop index from 0 to the length of edgeKeys:
            set edgeNode to the cad node pointer for (the item at index in edgeKeys) in body
            if (the length of (edgeNode's coedges's values)) = 2:
                increment manifoldEdges
        miter probe number manifoldEdges
        free edgeKeys
        set coedgeKeys to the cad keys of (body's coedges)
        set pcurveCount to 0
        loop index from 0 to the length of coedgeKeys:
            set coedgeNode to the cad node pointer for (the item at index in coedgeKeys) in (body's coedges)
            if coedgeNode's pcurve's valid:
                increment pcurveCount
        miter probe number pcurveCount
        free coedgeKeys
        set faceKeys to the cad keys of (body's faces)
        set forwardFaces to 0
        loop index from 0 to the length of faceKeys:
            set faceNode to the cad node pointer for (the item at index in faceKeys) in (body's faces)
            if faceNode's forward:
                increment forwardFaces
        miter probe number forwardFaces
        free faceKeys
        set vertexKeys to the cad keys of (body's vertices)
        loop index from 0 to the length of vertexKeys:
            set vertexNode to the cad node pointer for (the item at index in vertexKeys) in (body's vertices)
            miter probe number (vertexNode's point's x)
            miter probe number (vertexNode's point's y)
            miter probe number (vertexNode's point's z)
        free vertexKeys

set caseText to the argument at 0 in the command line arguments
set caseNumber to @intrinsic("call", "libc", "atoi", integer, the data of caseText)
set profilePlane to a cad plane with origin (the cad zero vector3), x axis (the cad y axis) and y axis (the cad z axis)
set pathPlane to the cad xy plane
set profile to a list containing (miter probe line from (miter probe point -1 0) to (miter probe point 1 0))
append (miter probe line from (miter probe point 1 0) to (miter probe point 1 3)) to profile
append (miter probe line from (miter probe point 1 3) to (miter probe point -1 3)) to profile
append (miter probe line from (miter probe point -1 3) to (miter probe point -1 0)) to profile
set path to an empty list of a cad curve2
if caseNumber = 0:
    append (miter probe line from (miter probe point 0 0) to (miter probe point 5 0)) to path
    append (miter probe line from (miter probe point 5 0) to (miter probe point 5 5)) to path
else if caseNumber = 1:
    append (miter probe line from (miter probe point 0 0) to (miter probe point 5 0)) to path
    append (miter probe line from (miter probe point 5 0) to (miter probe point 8 4)) to path
else if caseNumber = 2:
    append (miter probe line from (miter probe point 0 0) to (miter probe point 5 0)) to path
    append (miter probe line from (miter probe point 5 0) to (miter probe point 8 0)) to path
else if caseNumber = 3:
    append (miter probe line from (miter probe point 5 0) to (miter probe point 0 0)) to path
    append (miter probe line from (miter probe point 5 5) to (miter probe point 5 0)) to path
else if caseNumber = 4:
    append (miter probe line from (miter probe point 0 0) to (miter probe point 5 0)) to path
else if caseNumber = 5:
    append (miter probe line from (miter probe point 0 0) to (miter probe point 5 0)) to path
    append (miter probe line from (miter probe point 5 0) to (miter probe point 5 5)) to path
    append (miter probe line from (miter probe point 5 5) to (miter probe point 8 5)) to path
else:
    @intrinsic("call", "libc", "exit", nothing, 3)
set result to the cad planar sweep of profile on profilePlane following path on pathPlane
miter probe number (result's valid as an integer)
if result's valid:
    miter probe body (result's value)
