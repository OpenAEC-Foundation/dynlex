# SPDX-License-Identifier: MPL-2.0
# Runtime inputs exercise every Curve/Polyline variant and source operation.
import lib/cadkernel/curve2.dl
function measure2 input {integer:index}:
    execute:
        set args to the command line arguments
        set text to the argument at (index - 1) in args
        return @intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of text, 0 as a pointer)
function measure2 input point {integer:index}:
    execute:
        return a cad vector2 with x (measure2 input index) and y (measure2 input (index + 1))
function emit measure2 scalar {a number:value}:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", an integer, 1, "%.17g\n", value as a 64 bit floating-point number)
function emit measure2 flag {boolean:value}:
    execute:
        if value:
            emit measure2 scalar 1
        else:
            emit measure2 scalar 0
function emit measure2 point {cad vector2:value}:
    execute:
        emit measure2 scalar value's x
        emit measure2 scalar value's y
function emit measure2 points {a pointer to a list:points}:
    execute:
        emit measure2 scalar (the length of points)
        loop index from 0 to the length of points:
            emit measure2 point (the item at index in points)
function measure2 input curve:
    execute:
        set kind to (measure2 input 1) as an integer
        set parameter to measure2 input 2
        set target to measure2 input point 3
        set density to measure2 input 5
        set angle to measure2 input 6
        set flags to (measure2 input 7) as an integer
        set count to (measure2 input 8) as an integer
        set closed to (measure2 input 9) != 0.0
        set degree to (measure2 input 10) as an integer
        set knotCount to (measure2 input 11) as an integer
        set weightCount to (measure2 input 12) as an integer
        set start to measure2 input point 13
        set end to measure2 input point 15
        set radius to measure2 input 17
        set first to measure2 input 18
        set last to measure2 input 19
        set minor to measure2 input 20
        set axis to measure2 input point 21
        set sampling to (flags & 1) != 0
        set vertices to an empty list of a cad polyline vertex2
        set controls to an empty list of a cad vector2
        set knots to an empty list of a 64 bit floating-point number
        set weights to an empty list of a 64 bit floating-point number
        loop index from 0 to count:
            set point to measure2 input point (23 + (3 * index))
            append (a cad polyline vertex2 at point with bulge (measure2 input (25 + (3 * index)))) to vertices
            append point to controls
        set offset to 23 + (3 * count)
        loop index from 0 to knotCount:
            append (measure2 input (offset + index)) to knots
        set offset to offset + knotCount
        loop index from 0 to weightCount:
            append (measure2 input (offset + index)) to weights
        set polyline to the cad polyline2 with vertices vertices and closure closed
        set shape to the cad curve2 of (a cad line2 from start to end)
        if kind = 1:
            set shape to the cad curve2 of (a cad circle2 at start with radius radius)
        if kind = 2:
            set shape to the cad curve2 of (a cad arc2 at start with radius radius from first to last)
        if kind = 3:
            set ellipse to a cad ellipse at start with radii radius and minor along axis
            set shape to the cad curve2 of (a cad ellipse arc2 on ellipse from first to last)
        if kind = 4:
            set shape to the cad curve2 of polyline
        if kind = 5:
            set result to the cad nurbs curve2 of degree degree with controls controls, knots knots and weights weights
            emit measure2 flag result's valid
            if result's valid = false:
                free vertices
                free controls
                free knots
                free weights
                @intrinsic("call", "libc", "exit", nothing, 92)
            set shape to the cad curve2 of result's value
        if kind = 6:
            set shape to the cad curve2 of (a cad ray2 from start along end)
        if kind = 7:
            set shape to the cad curve2 of (a cad xline2 through start along end)
        free vertices
        free controls
        free knots
        free weights
        return shape
