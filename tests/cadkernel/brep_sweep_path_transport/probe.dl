# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_sweep_path_transport.dl

function transport probe number {a number:value}:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", integer, 1, "%.17g\n", value as a 64 bit floating-point number)
function transport probe vector {cad vector3:value}:
    execute:
        transport probe number value's x
        transport probe number value's y
        transport probe number value's z
function transport probe {cad path sweep vector result:result}:
    execute:
        transport probe number (result's valid as an integer)
        if result's valid:
            transport probe vector result's value
function transport probe {cad path sweep frame result:result}:
    execute:
        transport probe number (result's valid as an integer)
        if result's valid:
            transport probe vector result's value's origin
            transport probe vector result's value's xAxis
            transport probe vector result's value's yAxis

set x to the cad x axis
set y to the cad y axis
set z to the cad z axis
set zero to the cad zero vector3
set value to a cad vector3 with x 0.2, y -0.4 and z 0.6
set diagonal to the cad normalization of (a cad vector3 with x 1.0, y 1.0 and z 0.0)
set spatial to the cad normalization of (a cad vector3 with x -0.5, y 0.5 and z 1.0)
set frame to a cad path sweep frame at (a cad vector3 with x 1.0, y 2.0 and z 3.0) with x y and y z
transport probe (the cad path sweep transport of value from x to x)
transport probe (the cad path sweep transport of value from x to (the cad negative of x))
transport probe (the cad path sweep transport of value from y to (the cad negative of y))
transport probe (the cad path sweep transport of value from x to y)
transport probe (the cad path sweep transport of value from diagonal's value to spatial's value)
transport probe (the cad path sweep transport of value from x to (a cad vector3 with x -1.0, y 1e-13 and z 0.0))
transport probe (the cad path sweep moved frame frame from x to y between zero and (a cad vector3 with x 0.0, y 3.0 and z 0.0))
transport probe (the cad path sweep miter of frame at zero between x and y)
transport probe (the cad path sweep miter of frame at zero between x and (the cad negative of x))
transport probe (the cad path sweep twist of frame about (a cad vector3 with x 0.5, y 0.5 and z 0.5) by 0.8 scaled 1.5)
set singular to a cad path sweep frame at zero with x x and y x
transport probe (the cad path sweep twist of singular about zero by 0.8 scaled 1.5)
