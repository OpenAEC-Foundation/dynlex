# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/arrangement2.dl
import tests/cadkernel/cross2/support.dl

function check arrangement2 {boolean:condition}:
    execute:
        if condition = false:
            @intrinsic("call", "libc", "abort", nothing)
function arrangement2 near {a 64 bit floating-point number:actual} to {a 64 bit floating-point number:expected} within {a 64 bit floating-point number:epsilon}:
    execute:
        check arrangement2 ((the absolute value of (actual - expected)) < epsilon)
function arrangement2 segment first to last:
    execute:
        return a cad line2 from (cross2 point first) to (cross2 point last)
function arrangement2 rectangle wide {a 64 bit floating-point number:width} high {a 64 bit floating-point number:height}:
    execute:
        set result to an empty list of a cad line2
        append (arrangement2 segment [0.0,0.0] to [width,0.0]) to result
        append (arrangement2 segment [width,0.0] to [width,height]) to result
        append (arrangement2 segment [width,height] to [0.0,height]) to result
        append (arrangement2 segment [0.0,height] to [0.0,0.0]) to result
        return result
function arrangement2 one region of {a pointer to a list:segments} with area {a 64 bit floating-point number:area} within {a 64 bit floating-point number:epsilon}:
    execute:
        set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
        check arrangement2 ((the length of faces's rings) = 1)
        arrangement2 near (the cad signed area of (the item at 0 in faces's rings)) to area within epsilon

set segments to arrangement2 rectangle wide 10.0 high 5.0
arrangement2 one region of segments with area 50.0 within 1e-9
free segments
print "four_segments_that_meet_enclose_one_region" as a line

set original to arrangement2 rectangle wide 4.0 high 3.0
set segments to an empty list of a cad line2
loop index from 0 to the length of original:
    set line to the item at (((the length of original) - 1) - index) in original
    append (a cad line2 from line's end to line's start) to segments
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
check arrangement2 ((the length of faces's rings) = 1)
check arrangement2 ((the cad signed area of (the item at 0 in faces's rings)) > 0.0)
free original
free segments
print "a_ring_comes_back_counter_clockwise_whichever_way_it_was_given" as a line

set segments to an empty list of a cad line2
append (arrangement2 segment [-1.0,0.0] to [11.0,0.0]) to segments
append (arrangement2 segment [-1.0,10.0] to [11.0,10.0]) to segments
append (arrangement2 segment [0.0,-1.0] to [0.0,11.0]) to segments
append (arrangement2 segment [10.0,-1.0] to [10.0,11.0]) to segments
arrangement2 one region of segments with area 100.0 within 1e-9
free segments
print "segments_that_merely_cross_still_enclose_what_they_bound" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
append (arrangement2 segment [5.0,0.0] to [5.0,10.0]) to segments
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
check arrangement2 ((the length of faces's rings) = 2)
loop index from 0 to 2:
    arrangement2 near (the cad signed area of (the item at index in faces's rings)) to 50.0 within 1e-9
free segments
print "two_regions_sharing_an_edge_are_both_found" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
replace item at index 1 in segments with (arrangement2 segment [10.0,1e-9] to [10.0,10.0])
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
check arrangement2 ((the length of faces's rings) = 1)
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-12)
check arrangement2 ((the length of faces's rings) = 0)
free segments
print "a_gap_smaller_than_the_tolerance_is_welded_shut" as a line

set segments to an empty list of a cad line2
append (arrangement2 segment [0.0,0.0] to [10.0,0.0]) to segments
append (arrangement2 segment [10.0,0.0] to [10.0,10.0]) to segments
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
check arrangement2 ((the length of faces's rings) = 0)
free segments
print "an_open_chain_encloses_nothing" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
append (arrangement2 segment [5.0,10.0] to [5.0,15.0]) to segments
arrangement2 one region of segments with area 100.0 within 1e-9
free segments
print "a_spur_hanging_off_a_ring_does_not_become_its_own_face" as a line

set crossing to the cad crossing between (arrangement2 segment [0.0,0.0] to [10.0,0.0]) and (arrangement2 segment [4.0,0.0] to [14.0,0.0]) within (a cad tolerance of 1e-6)
check arrangement2 (crossing's kind = 2)
arrangement2 near crossing's aStart to 0.4 within 1e-12
arrangement2 near crossing's aEnd to 1.0 within 1e-12
arrangement2 near crossing's bStart to 0.0 within 1e-12
arrangement2 near crossing's bEnd to 0.6 within 1e-12
print "collinear_overlap_is_reported_as_a_stretch_not_a_point" as a line

set crossing to the cad crossing between (arrangement2 segment [0.0,0.0] to [10.0,0.0]) and (arrangement2 segment [10.0,0.0] to [20.0,0.0]) within (a cad tolerance of 1e-6)
check arrangement2 (crossing's kind = 1)
arrangement2 near crossing's aStart to 1.0 within 1e-9
print "segments_touching_end_to_end_report_one_point" as a line

set crossing to the cad crossing between (arrangement2 segment [0.0,0.0] to [10.0,0.0]) and (arrangement2 segment [0.0,5.0] to [10.0,5.0]) within (a cad tolerance of 1e-6)
check arrangement2 (crossing's kind = 0)
print "parallel_segments_apart_do_not_meet" as a line

set crossing to the cad crossing between (arrangement2 segment [0.0,0.0] to [10.0,0.0]) and (arrangement2 segment [2.0,-1.0] to [2.0,1.0]) within (a cad tolerance of 1e-6)
check arrangement2 (crossing's kind = 1)
arrangement2 near crossing's aStart to 0.2 within 1e-12
arrangement2 near crossing's bStart to 0.5 within 1e-12
print "a_crossing_is_found_at_the_right_place_on_both" as a line

set ring to an empty list of a cad vector2
set origin to cross2 point [512345.678,4512345.678]
set offsets to [[0.0,0.0],[10.0,0.0],[10.0,10.0],[0.0,10.0],[0.0,0.0]]
loop index from 0 to the length of offsets:
    append (the cad sum of origin and (cross2 point (the item at index in offsets))) to ring
arrangement2 near (the cad signed area of ring) to 100.0 within 1e-6
free ring
print "signed_area_is_stable_at_survey_coordinates" as a line

set segments to arrangement2 rectangle wide 10.0 high 5.0
loop index from 0 to the length of segments:
    set line to the item at index in segments
    replace item at index index in segments with (a cad line2 from (the cad sum of origin and line's start) to (the cad sum of origin and line's end))
arrangement2 one region of segments with area 50.0 within 1e-6
free segments
print "a_region_found_at_survey_coordinates_is_the_same_region" as a line

set segments to an empty list of a cad line2
append (arrangement2 segment [0.0,0.0] to [1e12,0.0]) to segments
append (arrangement2 segment [0.0,1.0] to [1e12,1.0]) to segments
append (arrangement2 segment [1.0,-1.0] to [1.0,2.0]) to segments
append (arrangement2 segment [2.0,-1.0] to [2.0,2.0]) to segments
arrangement2 one region of segments with area 1.0 within 1e-9
free segments
print "a_cut_on_a_very_long_segment_keeps_its_world_scale" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
replace item at index 0 in segments with (arrangement2 segment [0.0,0.0] to [7.0,0.0])
append (arrangement2 segment [3.0,0.0] to [10.0,0.0]) to segments
arrangement2 one region of segments with area 100.0 within 1e-6
free segments
print "two_collinear_runs_that_overlap_still_close_a_ring" as a line

set crossing to the cad crossing between (arrangement2 segment [0.0,0.0] to [1e9,1e-3]) and (arrangement2 segment [5e8,(5e-4 + 5e-7)] to [1.5e9,(1.5e-3 + 5e-7)]) within (a cad tolerance of 1e-6)
check arrangement2 (crossing's kind = 2)
print "near_collinear_segments_a_long_way_out_still_read_as_overlapping" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-15)
check arrangement2 ((the length of faces's rings) = 1)
arrangement2 near (the cad signed area of (the item at 0 in faces's rings)) to 100.0 within 1e-9
free segments
print "a_tolerance_finer_than_the_geometry_still_finds_a_clean_ring" as a line

set segments to arrangement2 rectangle wide 10.0 high 10.0
append (arrangement2 segment [3.0,3.0] to [3.0,3.0]) to segments
set faces to the cad bounded faces of segments within (a cad tolerance of 1e-6)
check arrangement2 ((the length of faces's rings) = 1)
free segments
print "collapsed_segments_are_dropped_rather_than_welded_into_knots" as a line
