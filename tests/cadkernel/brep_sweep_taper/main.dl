# Tapered extrusion source groups from cadkernel src/brep/sweep.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
import tests/cadkernel/brep_sweep_extrude/main.dl

function taper cone surface count in {cad body:body}:
    execute:
        set keys to the cad keys of (body's surfaces)
        set total to 0
        loop index from 0 to the length of keys:
            set node to the cad node pointer for (the item at index in keys) in (body's surfaces)
            if node != (0 as the type of node):
                if node's kind = 2:
                    increment total
        free keys
        return total

function taper nurbs surface count in {cad body:body}:
    execute:
        set keys to the cad keys of (body's surfaces)
        set total to 0
        loop index from 0 to the length of keys:
            set node to the cad node pointer for (the item at index in keys) in (body's surfaces)
            if node != (0 as the type of node):
                if node's kind = 5:
                    increment total
        free keys
        return total

set taperOpenProfile to a list containing (the cad curve2 of (a cad line2 from (extrusion point [0.0,0.0]) to (extrusion point [10.0,0.0])))
set taperDirection to a cad vector3 with x 0.0, y 0.0 and z 5.0
set taperResult to the tapered cad extrusion sheet of taperOpenProfile on (the cad xy plane) along taperDirection by 1.5707963267948966
check extrusion ((taperResult's valid) = false)
set taperResult to the tapered cad extrusion sheet of taperOpenProfile on (the cad xy plane) along taperDirection by -1.5707963267948966
check extrusion ((taperResult's valid) = false)
set taperNan to 0.0 / 0.0
set taperResult to the tapered cad extrusion sheet of taperOpenProfile on (the cad xy plane) along taperDirection by taperNan
check extrusion ((taperResult's valid) = false)
free taperOpenProfile
print "an_open_surface_rejects_invalid_taper_angles" as a line

set taperLarge to extrusion square of size 100.0
set taperResult to the tapered cad extrusion of taperLarge on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 1.0) by 0.7853981633974483
check extrusion (taperResult's valid)
set taperFlaws to the cad flaws of (taperResult's value)
check extrusion ((the length of taperFlaws) = 0)
free taperFlaws
free taperLarge

set taperSquare to extrusion square of size 10.0
set taperDirection to a cad vector3 with x 0.0, y 0.0 and z 10.0
set taperResult to the tapered cad extrusion of taperSquare on (the cad xy plane) along taperDirection by 0.3490658503988659
check extrusion (taperResult's valid)
set taperFlaws to the cad flaws of (taperResult's value)
check extrusion ((the length of taperFlaws) = 0)
free taperFlaws
set taperResult to the tapered cad extrusion of taperSquare on (the cad xy plane) along taperDirection by 0.5235987755982988
check extrusion ((taperResult's valid) = false)
set taperResult to the tapered cad extrusion of taperSquare on (the cad xy plane) along taperDirection by -0.7853981633974483
check extrusion (taperResult's valid)
set taperFlaws to the cad flaws of (taperResult's value)
check extrusion ((the length of taperFlaws) = 0)
free taperFlaws
free taperSquare
print "a_tapered_profile_stops_before_inverting" as a line

set circularProfile to a list containing (the cad curve2 of (a cad circle2 at (the cad zero vector2) with radius 2.0))
set circularResult to the tapered cad extrusion of circularProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by 0.2
check extrusion (circularResult's valid)
set circularBody to circularResult's value
check extrusion ((the cad count of (circularBody's faces)) = 3)
check extrusion ((taper cone surface count in circularBody) = 1)
set circularFlaws to the cad flaws of circularBody
check extrusion ((the length of circularFlaws) = 0)
free circularFlaws
set outwardCircle to the tapered cad extrusion of circularProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by -0.2
check extrusion (outwardCircle's valid)
check extrusion ((taper cone surface count in (outwardCircle's value)) = 1)
set collapsedCircle to the tapered cad extrusion of circularProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by 0.7
check extrusion ((collapsedCircle's valid) = false)
set obliqueCircle to the tapered cad extrusion of circularProfile on (the cad xy plane) along (a cad vector3 with x 1.0, y 0.0 and z 3.0) by 0.2
check extrusion ((obliqueCircle's valid) = false)
free circularProfile
print "a_circular_taper_preserves_an_analytic_cone" as a line

set arcProfile to an empty list of a cad curve2
loop quarter from 0 to 4:
    set firstAngle to (quarter as a 64 bit floating-point number) * 1.5707963267948966
    set lastAngle to firstAngle + 1.5707963267948966
    append (the cad curve2 of (a cad arc2 at (the cad zero vector2) with radius 2.0 from firstAngle to lastAngle)) to arcProfile
set arcResult to the tapered cad extrusion of arcProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by 0.2
check extrusion (arcResult's valid)
check extrusion ((the cad count of (arcResult's value's faces)) = 3)
check extrusion ((taper cone surface count in (arcResult's value)) = 1)
set arcFlaws to the cad flaws of (arcResult's value)
check extrusion ((the length of arcFlaws) = 0)
free arcFlaws
free arcProfile
print "a_segmented_circular_taper_preserves_an_analytic_cone" as a line

set taperedSheetProfile to extrusion square of size 8.0
set taperedSheet to the tapered cad extrusion sheet of taperedSheetProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 2.0) by 0.2
check extrusion (taperedSheet's valid)
check extrusion ((the cad count of (taperedSheet's value's faces)) = 4)
set taperedSheetFlaws to the cad flaws of (taperedSheet's value)
check extrusion ((the length of taperedSheetFlaws) = 0)
free taperedSheetFlaws
set obliqueTaperedSheet to the tapered cad extrusion sheet of taperedSheetProfile on (the cad xy plane) along (a cad vector3 with x 1.0, y 0.0 and z 2.0) by 0.2
check extrusion (obliqueTaperedSheet's valid)
check extrusion ((the cad count of (obliqueTaperedSheet's value's faces)) = 4)
set obliqueSheetFlaws to the cad flaws of (obliqueTaperedSheet's value)
check extrusion ((the length of obliqueSheetFlaws) = 0)
free obliqueSheetFlaws
free taperedSheetProfile
print "a_closed_tapered_profile_makes_an_open_lateral_skin" as a line

set conicSheetProfile to a list containing (the cad curve2 of (a cad circle2 at (the cad zero vector2) with radius 2.0))
set conicSheet to the tapered cad extrusion sheet of conicSheetProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by 0.2
check extrusion (conicSheet's valid)
check extrusion ((the cad count of (conicSheet's value's faces)) = 1)
check extrusion ((taper cone surface count in (conicSheet's value)) = 1)
set conicSheetFlaws to the cad flaws of (conicSheet's value)
check extrusion ((the length of conicSheetFlaws) = 0)
free conicSheetFlaws
free conicSheetProfile
print "a_tapered_circle_makes_an_analytic_cone_sheet" as a line

set openLineProfile to a list containing (the cad curve2 of (a cad line2 from (extrusion point [0.0,0.0]) to (extrusion point [4.0,0.0])))
set openLineSheet to the tapered cad extrusion sheet of openLineProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by 0.2
check extrusion (openLineSheet's valid)
check extrusion ((the cad count of (openLineSheet's value's faces)) = 1)
check extrusion ((taper nurbs surface count in (openLineSheet's value)) = 1)
set openLineFlaws to the cad flaws of (openLineSheet's value)
check extrusion ((the length of openLineFlaws) = 0)
free openLineFlaws
set outwardLineSheet to the tapered cad extrusion sheet of openLineProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0) by -0.2
check extrusion (outwardLineSheet's valid)
check extrusion ((taper nurbs surface count in (outwardLineSheet's value)) = 1)
set obliqueLineSheet to the tapered cad extrusion sheet of openLineProfile on (the cad xy plane) along (a cad vector3 with x 1.0, y 0.0 and z 3.0) by 0.2
check extrusion (obliqueLineSheet's valid)
set flatLineSheet to the tapered cad extrusion sheet of openLineProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 2.0 and z 0.0) by 0.2
check extrusion ((flatLineSheet's valid) = false)
free openLineProfile
print "an_open_line_tapers_into_a_ruled_sheet" as a line

set openArcProfile to a list containing (the cad curve2 of (a cad arc2 at (the cad zero vector2) with radius 2.0 from 0.0 to 1.5707963267948966))
set openArcSheet to the tapered cad extrusion sheet of openArcProfile on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 1.0) by 0.1
check extrusion (openArcSheet's valid)
check extrusion ((the cad count of (openArcSheet's value's faces)) = 1)
check extrusion ((taper nurbs surface count in (openArcSheet's value)) = 1)
set openArcFlaws to the cad flaws of (openArcSheet's value)
check extrusion ((the length of openArcFlaws) = 0)
free openArcFlaws
free openArcProfile
print "an_open_arc_tapers_into_a_ruled_sheet" as a line

set openChain to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from (extrusion point [0.0,0.0]) to (extrusion point [4.0,0.0]))) to openChain
append (the cad curve2 of (a cad line2 from (extrusion point [4.0,4.0]) to (extrusion point [4.0,0.0]))) to openChain
set chainSheet to the tapered cad extrusion sheet of openChain on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 1.0) by 0.1
check extrusion (chainSheet's valid)
check extrusion ((the cad count of (chainSheet's value's faces)) = 2)
check extrusion ((taper nurbs surface count in (chainSheet's value)) = 2)
set chainFlaws to the cad flaws of (chainSheet's value)
check extrusion ((the length of chainFlaws) = 0)
free chainFlaws
free openChain
print "a_reversed_open_chain_tapers_without_losing_topology" as a line
