import lib/cadkernel/brep_fillet_circular.dl

function check circular fillet {boolean:condition}:
    execute:
        if condition = false:
            @intrinsic("call", "libc", "abort", nothing)

function circular fillet point {a number:x} {a number:y}:
    execute:
        return a cad vector2 with x (x as a 64 bit floating-point number) and y (y as a 64 bit floating-point number)

function circular fillet line from {cad vector2:first} to {cad vector2:last}:
    execute:
        return the cad curve2 of (a cad line2 from first to last)

function circular fillet rectangle from {a number:inner} to {a number:outer} between {a number:low} and {a number:high}:
    execute:
        set points to a list containing (circular fillet point inner low)
        append (circular fillet point outer low) to points
        append (circular fillet point outer high) to points
        append (circular fillet point inner high) to points
        set profile to a list containing (circular fillet line from (the item at 0 in points) to (the item at 1 in points))
        loop index from 1 to 4:
            append (circular fillet line from (the item at index in points) to (the item at (the remainder of (index + 1) divided by 4) in points)) to profile
        free points
        return profile

function first circular fillet rim of {cad body:body}:
    execute:
        set keys to the cad edge keys of body
        set result to a new cad edge key
        set found to false
        loop index from 0 to the length of keys:
            set key to the item at index in keys
            set edge to the cad node pointer for key in body
            if edge != (0 as the type of edge):
                set curve to the cad node pointer for edge's curve in body
                if curve != (0 as the type of curve):
                    if (curve's kind = 1) and ((the length of edge's coedges's values) = 2):
                        set firstUse to the cad node pointer for (the item at 0 in edge's coedges's values) in body
                        set secondUse to the cad node pointer for (the item at 1 in edge's coedges's values) in body
                        if (firstUse != (0 as the type of firstUse)) and (secondUse != (0 as the type of secondUse)):
                            set firstLoop to the cad node pointer for firstUse's owner in body
                            set secondLoop to the cad node pointer for secondUse's owner in body
                            if (firstLoop != (0 as the type of firstLoop)) and (secondLoop != (0 as the type of secondLoop)):
                                if (firstLoop's owner != secondLoop's owner) and (found = false):
                                    set result to key
                                    set found to true
        free keys
        return result

set planeResult to the cad orthonormal plane with origin (the cad zero vector3), x axis (the cad x axis) and normal (a cad vector3 with x 0.0, y -1.0 and z 0.0)
check circular fillet planeResult's valid
set profile to circular fillet rectangle from 0.0 to 4.0 between 0.0 and 6.0
set made to the cad revolution of profile on planeResult's value about (the cad zero vector3) along (the cad z axis) by 6.283185307179586
check circular fillet made's valid
set body to made's value
set rim to first circular fillet rim of body
set selected to a list containing rim
set result to the cad circular fillet of body along selected with radius 0.75
check circular fillet result's recognized
check circular fillet result's valid
set flaws to the cad flaws of result's value
check circular fillet ((the length of flaws) = 0)
free flaws
check circular fillet ((the cad worst vertex gap of result's value) < 1e-8)
print "a_circular_rim_becomes_an_exact_round" as a line

set emptySelection to an empty list of a cad edge key
set result to the cad circular fillet of body along emptySelection with radius 0.5
check circular fillet ((result's recognized = false) and (result's valid = false))
free emptySelection
print "an_empty_selection_is_not_a_circular_fillet_case" as a line

set result to the cad circular fillet of body along selected with radius 20.0
check circular fillet (result's recognized and ((result's valid = false) and (result's error's kind = cad fillet radius interaction error)))
print "a_radius_that_consumes_the_meridian_is_refused" as a line

check circular fillet ((the cad count of body's faces) = 3)
print "the_revolved_source_body_remains_unchanged" as a line

free selected
free profile
