# Solid region extrusion from cadkernel src/brep/sweep.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
import lib/cadkernel/brep_region_solid.dl

function check region {boolean:condition}:
    execute:
        if condition = false:
            ignore @intrinsic("call", "libc", "fflush", an integer, (0 as a pointer))
            @intrinsic("call", "libc", "abort", nothing)

function region point {a 64 bit floating-point number array of 2 items:values}:
    execute:
        return a cad vector2 with x (the item at 0 in values) and y (the item at 1 in values)

function region square at {a 64 bit floating-point number array of 2 items:origin} of size {a 64 bit floating-point number:size}:
    execute:
        set x to the item at 0 in origin
        set y to the item at 1 in origin
        set points to a list containing (region point [x,y])
        append (region point [x + size,y]) to points
        append (region point [x + size,y + size]) to points
        append (region point [x,y + size]) to points
        set pieces to an empty list of a cad curve2
        loop index from 0 to 4:
            append (the cad curve2 of (a cad line2 from (the item at index in points) to (the item at (the remainder of (index + 1) divided by 4) in points))) to pieces
        free points
        return pieces

function check region manifold {cad body:body}:
    execute:
        set flaws to the cad flaws of body
        check region ((the length of flaws) = 0)
        free flaws
        set edges to the cad edge keys of body
        loop index from 0 to the length of edges:
            set edge to the cad node pointer for (the item at index in edges) in body
            check region ((the length of (edge's coedges's values)) = 2)
            set first to the cad node pointer for (the item at 0 in (edge's coedges's values)) in body
            set second to the cad node pointer for (the item at 1 in (edge's coedges's values)) in body
            check region ((first's forward) != (second's forward))
        free edges

class:
    patterns:
        [a|] region cap areas result
    members:
        valid as a boolean
        outerArea as a 64 bit floating-point number
        holeArea as a 64 bit floating-point number

function region area of {cad presspull curve loop:ring}:
    execute:
        set total to 0.0 as a 64 bit floating-point number
        loop index from 0 to the length of (ring's values's values):
            set total to total + (the cad enclosed area of (the item at index in (ring's values's values)))
        return the absolute value of total

function measure region cap of {cad body:body} at height {a 64 bit floating-point number:height}:
    execute:
        set absent to @intrinsic("construct", a region cap areas result, false, 0.0 as a 64 bit floating-point number, 0.0 as a 64 bit floating-point number)
        set target to a cad plane with origin (a cad vector3 with x 0.0, y 0.0 and z height), x axis (the cad x axis) and y axis (the cad y axis)
        set faces to the cad face keys of body
        loop index from 0 to the length of faces:
            set faceKey to the item at index in faces
            set face to the cad node pointer for faceKey in body
            set surface to the cad node pointer for face's surface in body
            if surface's kind = 0:
                set gap to the cad distance from surface's plane's origin to target
                if gap's valid:
                    if (the absolute value of gap's value) <= 1e-7:
                        set extracted to the cad planar face profile of body at faceKey
                        if extracted's valid:
                            if (the length of (extracted's value's loops's values)) >= 2:
                                set outerRing to the item at 0 in (extracted's value's loops's values)
                                set holeRing to the item at 1 in (extracted's value's loops's values)
                                free faces
                                return @intrinsic("construct", a region cap areas result, true, region area of outerRing, region area of holeRing)
        free faces
        return absent

set outer to region square at [0.0,0.0] of size 10.0
set oneHole to region square at [2.0,2.0] of size 2.0
set profiles to a list containing outer
append oneHole to profiles
set direction to a cad vector3 with x 0.0, y 0.0 and z 3.0
set single to the cad extrusion region of profiles on (the cad xy plane) along direction
check region (single's valid)
check region ((the cad count of (single's value's faces)) = 10)
check region ((the length of (single's value's roots)) = 1)
check region manifold single's value
set caps to the cad face keys of single's value
set twoLoopCaps to 0
loop index from 0 to the length of caps:
    set face to the cad node pointer for (the item at index in caps) in single's value
    if (the length of (face's loops's values)) = 2:
        increment twoLoopCaps
free caps
check region (twoLoopCaps = 2)
check region ((the length of outer) = 4)
check region ((the length of oneHole) = 4)
print "a_region_with_one_hole_is_a_manifold_solid" as a line

set secondHole to region square at [6.0,6.0] of size 1.0
append secondHole to profiles
set multiple to the cad extrusion region of profiles on (the cad xy plane) along direction
check region (multiple's valid)
check region ((the cad count of (multiple's value's faces)) = 14)
check region manifold multiple's value
set caps to the cad face keys of multiple's value
set threeLoopCaps to 0
loop index from 0 to the length of caps:
    set face to the cad node pointer for (the item at index in caps) in multiple's value
    if (the length of (face's loops's values)) = 3:
        increment threeLoopCaps
free caps
check region (threeLoopCaps = 2)
print "multiple_holes_keep_both_cap_rings" as a line

set roundHole to a list containing (the cad curve2 of (a cad circle2 at (region point [5.0,5.0]) with radius 1.0))
set roundProfiles to a list containing outer
append roundHole to roundProfiles
set roundSolid to the cad extrusion region of roundProfiles on (the cad xy plane) along direction
check region (roundSolid's valid)
check region ((the cad count of (roundSolid's value's faces)) = 10)
check region manifold roundSolid's value
free roundProfiles
free roundHole
print "a_circular_hole_is_split_into_manifold_arc_walls" as a line

set reverseDirection to a cad vector3 with x 0.0, y 0.0 and z -2.0
set reverseSolid to the cad extrusion region of profiles on (the cad xy plane) along reverseDirection
check region (reverseSolid's valid)
check region ((the cad count of (reverseSolid's value's faces)) = 14)
check region manifold reverseSolid's value
print "a_region_can_extrude_against_the_plane_normal" as a line

set empty to an empty list of (the type of outer)
check region (((the cad extrusion region of empty on (the cad xy plane) along direction)'s valid) = false)
set outside to region square at [11.0,2.0] of size 1.0
set refused to a list containing outer
append outside to refused
check region (((the cad extrusion region of refused on (the cad xy plane) along direction)'s valid) = false)
free refused
free outside
set intersecting to region square at [9.0,2.0] of size 2.0
set refused to a list containing outer
append intersecting to refused
check region (((the cad extrusion region of refused on (the cad xy plane) along direction)'s valid) = false)
free refused
free intersecting
set touching to region square at [0.0,2.0] of size 1.0
set refused to a list containing outer
append touching to refused
check region (((the cad extrusion region of refused on (the cad xy plane) along direction)'s valid) = false)
free refused
free touching
set nested to region square at [2.5,2.5] of size 0.5
set refused to a list containing outer
append oneHole to refused
append nested to refused
check region (((the cad extrusion region of refused on (the cad xy plane) along direction)'s valid) = false)
free refused
free nested
free empty
print "empty_outside_intersecting_touching_and_nested_regions_are_refused" as a line

set draftAngle to 0.1 as a 64 bit floating-point number
set draftOffset to 3.0 * @intrinsic("call", "libc", "tan", a 64 bit floating-point number, draftAngle)
set tapered to the tapered cad extrusion region of profiles on (the cad xy plane) along direction by draftAngle
check region (tapered's valid)
check region ((the cad count of (tapered's value's faces)) = 14)
check region manifold tapered's value
set taperedBase to measure region cap of tapered's value at height 0.0
set taperedTop to measure region cap of tapered's value at height 3.0
check region (taperedBase's valid and taperedTop's valid)
check region ((the absolute value of (taperedBase's outerArea - 100.0)) < 1e-5)
check region ((the absolute value of (taperedBase's holeArea - 4.0)) < 1e-5)
set wantedOuter to (10.0 - (2.0 * draftOffset)) * (10.0 - (2.0 * draftOffset))
set wantedHole to (2.0 + (2.0 * draftOffset)) * (2.0 + (2.0 * draftOffset))
check region ((the absolute value of (taperedTop's outerArea - wantedOuter)) < 1e-4)
check region ((the absolute value of (taperedTop's holeArea - wantedHole)) < 1e-4)
print "positive_draft_shrinks_the_outer_loop_and_widens_holes" as a line

set outward to the tapered cad extrusion region of profiles on (the cad xy plane) along direction by (the negative of draftAngle)
check region (outward's valid)
check region manifold outward's value
set outwardTop to measure region cap of outward's value at height 3.0
check region (outwardTop's valid)
set wantedOuter to (10.0 + (2.0 * draftOffset)) * (10.0 + (2.0 * draftOffset))
set wantedHole to (2.0 - (2.0 * draftOffset)) * (2.0 - (2.0 * draftOffset))
check region ((the absolute value of (outwardTop's outerArea - wantedOuter)) < 1e-4)
check region ((the absolute value of (outwardTop's holeArea - wantedHole)) < 1e-4)
print "negative_draft_widens_the_outer_loop_and_shrinks_holes" as a line

set zeroDraft to the tapered cad extrusion region of profiles on (the cad xy plane) along direction by 0.0
check region (zeroDraft's valid)
check region manifold zeroDraft's value
check region ((the cad count of (zeroDraft's value's faces)) = (the cad count of (multiple's value's faces)))
set zeroTop to measure region cap of zeroDraft's value at height 3.0
check region (zeroTop's valid)
check region ((the absolute value of (zeroTop's outerArea - 100.0)) < 1e-5)
check region ((the absolute value of (zeroTop's holeArea - 4.0)) < 1e-5)
print "zero_draft_uses_the_untapered_region_geometry" as a line

set taperedRoundProfiles to a list containing outer
set taperedRoundHole to a list containing (the cad curve2 of (a cad circle2 at (region point [5.0,5.0]) with radius 1.0))
append taperedRoundHole to taperedRoundProfiles
set taperedRound to the tapered cad extrusion region of taperedRoundProfiles on (the cad xy plane) along direction by draftAngle
check region (taperedRound's valid)
check region manifold taperedRound's value
free taperedRoundProfiles
free taperedRoundHole
print "a_tapered_circular_hole_keeps_a_manifold_wall" as a line

set crossingTop to a list containing outer
append oneHole to crossingTop
check region (((the tapered cad extrusion region of crossingTop on (the cad xy plane) along direction by 0.35)'s valid) = false)
free crossingTop
set nearbyFirst to region square at [3.0,3.0] of size 1.0
set nearbySecond to region square at [5.0,3.0] of size 1.0
set nearbyProfiles to a list containing outer
append nearbyFirst to nearbyProfiles
append nearbySecond to nearbyProfiles
check region (((the tapered cad extrusion region of nearbyProfiles on (the cad xy plane) along direction by 0.2)'s valid) = false)
free nearbyProfiles
free nearbyFirst
free nearbySecond
print "draft_refuses_top_cap_hole_collisions" as a line

check region (((the tapered cad extrusion region of profiles on (the cad xy plane) along direction by 1.5707963267948966)'s valid) = false)
set invalidAngle to 0.0 / 0.0
check region (((the tapered cad extrusion region of profiles on (the cad xy plane) along direction by invalidAngle)'s valid) = false)
check region (((the tapered cad extrusion region of profiles on (the cad xy plane) along direction by 1.1)'s valid) = false)
print "draft_refuses_invalid_angles_and_collapsed_outer_profiles" as a line

free profiles
free outer
free oneHole
free secondHole
