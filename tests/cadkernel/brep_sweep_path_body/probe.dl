# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_sweep_path_body.dl

# The imported frame fitter requires a concrete evaluator at compile time.
class:
    patterns:
        [a|] cad path sweep body probe evaluator
function the cad path sweep fit sample of {cad path sweep body probe evaluator:source} at {a 64 bit floating-point number:parameter}:
    execute:
        set frame to a cad path sweep frame at (the cad zero vector3) with x (the cad x axis) and y (the cad y axis)
        return @intrinsic("construct", a cad path sweep frame result, true, frame)

function emit path body number {a number:value}:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", integer, 1, "%.17g\n", value as a 64 bit floating-point number)

function emit path body summary {cad body:body}:
    execute:
        emit path body number (the cad count of (body's vertices))
        emit path body number (the cad count of (body's edges))
        emit path body number (the cad count of (body's coedges))
        emit path body number (the cad count of (body's loops))
        emit path body number (the cad count of (body's faces))
        emit path body number (the cad count of (body's shells))
        emit path body number (the cad count of (body's lumps))
        emit path body number (the cad count of (body's surfaces))
        emit path body number (the cad count of (body's curves))
        emit path body number (the length of (body's roots))
        set flaws to the cad flaws of body
        emit path body number (the length of flaws)
        free flaws
        set edges to the cad edge keys of body
        set shared to 0
        loop index from 0 to the length of edges:
            set edge to the cad node pointer for (the item at index in edges) in body
            if (the length of (edge's coedges's values)) = 2:
                increment shared
        emit path body number shared
        free edges
        set uses to the cad keys of (body's coedges)
        set pcurves to 0
        set synthesized to true
        loop index from 0 to the length of uses:
            set usage to the cad node pointer for (the item at index in uses) in (body's coedges)
            if usage's pcurve's valid:
                increment pcurves
            if usage's provenance's kind != 0:
                set synthesized to false
        emit path body number pcurves
        free uses
        set faces to the cad face keys of body
        set face to the cad node pointer for (the item at 0 in faces) in body
        emit path body number (face's forward as an integer)
        if face's provenance's kind != 0:
            set synthesized to false
        set surface to the cad node pointer for face's surface in body
        emit path body number (synthesized as an integer)
        emit path body number (surface's kind)
        set firstPoint to the cad point on (@intrinsic("dereference", surface)) at parameters 0.25 and 0.75
        set secondPoint to the cad point on (@intrinsic("dereference", surface)) at parameters 0.75 and 0.25
        emit path body number firstPoint's x
        emit path body number firstPoint's y
        emit path body number firstPoint's z
        emit path body number secondPoint's x
        emit path body number secondPoint's y
        emit path body number secondPoint's z
        free faces

function probe path body with two bands {boolean:two} reversed {boolean:reverse} rational {boolean:rational}:
    execute:
        set controls to a list containing (the cad zero vector2)
        if rational:
            append (a cad vector2 with x 0.5 and y 1.0) to controls
        append (a cad vector2 with x 1.0 and y 0.0) to controls
        set knots to a list containing (0.0 as a 64 bit floating-point number)
        append 0.0 to knots
        if rational:
            append 0.0 to knots
        append 1.0 to knots
        append 1.0 to knots
        if rational:
            append 1.0 to knots
        set weights to a list containing (1.0 as a 64 bit floating-point number)
        if rational:
            append 2.0 to weights
        append 1.0 to weights
        set degree to 1
        if rational:
            set degree to 2
        set curve to the cad rational curve2 of degree degree with controls controls, knots knots and weights weights
        set curves to a list containing curve
        set wire to a cad path sweep prepared wire from curves closed false
        set wires to a list containing wire
        set yAxis to the cad y axis
        if reverse:
            set yAxis to a cad vector3 with x 0.0, y -1.0 and z 0.0
        set first to a cad path sweep frame at (the cad zero vector3) with x (the cad x axis) and y yAxis
        set second to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 0.6666666666666666) with x (the cad x axis) and y yAxis
        set third to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 1.3333333333333333) with x (the cad x axis) and y yAxis
        set last to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 2.0) with x (the cad x axis) and y yAxis
        set patches to a list containing (a cad path sweep cubic patch with frames first, second, third and last)
        if two:
            set nextSecond to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 2.6666666666666665) with x (the cad x axis) and y yAxis
            set nextThird to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 3.3333333333333335) with x (the cad x axis) and y yAxis
            set nextLast to a cad path sweep frame at (a cad vector3 with x 0.0, y 0.0 and z 4.0) with x (the cad x axis) and y yAxis
            append (a cad path sweep cubic patch with frames last, nextSecond, nextThird and nextLast) to patches
        set built to the cad path sweep body from wires with patches patches sheet true closed path false outward (reverse = false)
        if built's valid = false:
            @intrinsic("call", "libc", "abort", nothing)
        emit path body summary built's value
        free controls
        free knots
        free weights
        free curves
        free wires
        free patches

probe path body with two bands false reversed false rational false
probe path body with two bands true reversed false rational false
probe path body with two bands false reversed true rational false
probe path body with two bands false reversed false rational true
