# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_thicken_sphere.dl
import lib/cadkernel/brep_revolve_sheet.dl
import lib/cadkernel/brep_make.dl

function sphere probe number {a number:value}:
    execute:
        ignore @intrinsic("variadic call", "libc", "printf", integer, 1, "%.17g\n", value as a 64 bit floating-point number)

function sphere probe body {cad body:body} for angle {a 64 bit floating-point number:angle} from {a 64 bit floating-point number:v0} to {a 64 bit floating-point number:v1}:
    execute:
        sphere probe number (the cad count of body's vertices)
        sphere probe number (the cad count of body's edges)
        sphere probe number (the cad count of body's coedges)
        sphere probe number (the cad count of body's loops)
        sphere probe number (the cad count of body's faces)
        sphere probe number (the cad count of body's shells)
        sphere probe number (the cad count of body's lumps)
        sphere probe number (the cad count of body's surfaces)
        sphere probe number (the cad count of body's curves)
        sphere probe number (the length of body's roots)
        set flaws to the cad flaws of body
        sphere probe number (the length of flaws)
        free flaws
        set edgeKeys to the cad edge keys of body
        set paired to 0
        loop index from 0 to the length of edgeKeys:
            set edge to the cad node pointer for (the item at index in edgeKeys) in body
            if (the length of edge's coedges's values) = 2:
                increment paired
        sphere probe number paired
        free edgeKeys
        set useKeys to the cad keys of body's coedges
        set pcurves to 0
        loop index from 0 to the length of useKeys:
            set useNode to the cad node pointer for (the item at index in useKeys) in body's coedges
            if useNode's pcurve's valid:
                increment pcurves
        sphere probe number pcurves
        free useKeys
        set faceKeys to the cad face keys of body
        set forwards to 0
        set inner to 1.7976931348623157e308 as a 64 bit floating-point number
        set outer to 0.0 as a 64 bit floating-point number
        set sphereFaces to 0
        loop index from 0 to the length of faceKeys:
            set face to the cad node pointer for (the item at index in faceKeys) in body
            if face's forward:
                increment forwards
            set surface to the cad node pointer for face's surface in body
            if surface's kind = 3:
                increment sphereFaces
                set inner to the minimum of inner and surface's sphere's radius
                set outer to the maximum of outer and surface's sphere's radius
        sphere probe number forwards
        free faceKeys
        if (sphereFaces < 2) or (inner >= outer):
            @intrinsic("call", "libc", "abort", nothing)
        set radial3 to ((outer * outer) * outer) - ((inner * inner) * inner)
        set radial4 to (((outer * outer) * outer) * outer) - (((inner * inner) * inner) * inner)
        set u0 to the minimum of angle and 0.0
        set u1 to the maximum of angle and 0.0
        set volume to (((u1 - u0) * radial3) * ((the sine of v1) - (the sine of v0))) / 3.0
        set latitudeSecond to ((v1 - v0) * 0.5) + (((the sine of (2.0 * v1)) - (the sine of (2.0 * v0))) * 0.25)
        set radialFactor to (radial4 * latitudeSecond) / (4.0 * volume)
        set centroidX to radialFactor * ((the sine of u1) - (the sine of u0))
        set centroidY to radialFactor * ((the cosine of u0) - (the cosine of u1))
        set centroidZ to (radial4 * ((((the sine of v1) * (the sine of v1)) - ((the sine of v0) * (the sine of v0))) * (u1 - u0))) / (8.0 * volume)
        sphere probe number volume
        sphere probe number centroidX
        sphere probe number centroidY
        sphere probe number centroidZ
        set vertexKeys to the cad keys of body's vertices
        loop index from 0 to the length of vertexKeys:
            set vertex to the cad node pointer for (the item at index in vertexKeys) in body's vertices
            sphere probe number vertex's point's x
            sphere probe number vertex's point's y
            sphere probe number vertex's point's z
        free vertexKeys

set caseText to the argument at 0 in the command line arguments
set caseNumber to @intrinsic("call", "libc", "atoi", integer, the data of caseText)
set angle to 1.5707963267948966 as a 64 bit floating-point number
if (caseNumber = 2) or (caseNumber = 3):
    set angle to -1.5707963267948966
else if (caseNumber = 4) or (caseNumber = 5):
    set angle to 4.71238898038469
else if (caseNumber = 6) or (caseNumber = 7):
    set angle to 6.283185307179586
else if (caseNumber = 8) or (caseNumber = 9):
    set angle to 6.2517693806436885
set v0 to (0.0 - 0.6) as a 64 bit floating-point number
set v1 to 0.7 as a 64 bit floating-point number
if (caseNumber = 10) or (caseNumber = 11):
    set v0 to -1.5707963267948966
    set v1 to 0.3
set section to a cad plane with origin (the cad zero vector3), x axis (the cad x axis) and y axis (the cad z axis)
set profile to a list containing (the cad curve2 of (a cad arc2 at (the cad zero vector2) with radius 4.0 from v0 to v1))
set source to no cad body
if caseNumber = 15:
    set source to the cad sphere body at (the cad zero vector3) with radius 4.0
else:
    set source to the cad revolved sheet of profile on section about (the cad zero vector3) along (the cad z axis) by angle
if source's valid = false:
    @intrinsic("call", "libc", "exit", nothing, 3)
set originalFaces to the cad count of source's value's faces
set originalEdges to the cad count of source's value's edges
set originalVertices to the cad count of source's value's vertices
set originalSurfaces to the cad count of source's value's surfaces
set originalPoints to an empty list of a cad vector3
set originalVertexKeys to the cad keys of source's value's vertices
loop index from 0 to the length of originalVertexKeys:
    set vertex to the cad node pointer for (the item at index in originalVertexKeys) in source's value's vertices
    append vertex's point to originalPoints
free originalVertexKeys
set faceKeys to the cad face keys of source's value
set face to the cad node pointer for (the item at 0 in faceKeys) in source's value
set originalForward to face's forward
set originalSurface to the cad node pointer for face's surface in source's value
set originalRadius to originalSurface's sphere's radius
free faceKeys
set distance to 0.5 as a 64 bit floating-point number
if (caseNumber < 12) and ((the remainder of caseNumber divided by 2) = 1):
    set distance to -0.5
if caseNumber = 12:
    set distance to 0.0
if caseNumber = 13:
    set faceKeys to the cad face keys of source's value
    set face to the cad node pointer for (the item at 0 in faceKeys) in source's value
    set distance to -5.0
    if face's forward = false:
        set distance to 5.0
    free faceKeys
if caseNumber = 14:
    set distance to 1.0 / 0.0
set result to the cad spherical thickening of source's value by distance
set faceKeys to the cad face keys of source's value
set face to the cad node pointer for (the item at 0 in faceKeys) in source's value
set surface to the cad node pointer for face's surface in source's value
set unchanged to (((the cad count of source's value's faces) = originalFaces) and ((the cad count of source's value's edges) = originalEdges)) and (((the cad count of source's value's vertices) = originalVertices) and ((the cad count of source's value's surfaces) = originalSurfaces))
set unchanged to unchanged and ((face's forward = originalForward) and (surface's sphere's radius = originalRadius))
free faceKeys
set currentVertexKeys to the cad keys of source's value's vertices
set unchanged to unchanged and ((the length of currentVertexKeys) = (the length of originalPoints))
if unchanged:
    loop index from 0 to the length of currentVertexKeys:
        set vertex to the cad node pointer for (the item at index in currentVertexKeys) in source's value's vertices
        set point to the item at index in originalPoints
        set unchanged to unchanged and (((vertex's point's x = point's x) and (vertex's point's y = point's y)) and (vertex's point's z = point's z))
free currentVertexKeys
free originalPoints
sphere probe number (result's valid as an integer)
sphere probe number (unchanged as an integer)
if result's valid:
    sphere probe body result's value for angle angle from v0 to v1
free profile
