# SPDX-License-Identifier: MPL-2.0
import lib/graphics.dl

set window to a new hidden window with width 64 and height 64
if window = 0 as a pointer to a byte:
    print (the current graphics error message) as a line
    return 1

if (run compute shader at "build/empty-compute.spv" for window with 1 workgroups) = false:
    print (the current graphics error message) as a line
    close window
    return 1
if run compute shader at "build/gpu-verify-vertex.spv" for window with 1 workgroups:
    close window
    return 1

close window
