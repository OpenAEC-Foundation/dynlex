# SPDX-License-Identifier: MPL-2.0
import lib/graphics.dl
import lib/list.dl
import lib/cadkernel/plane.dl

set plane to a cad plane with origin (a cad vector3 with x 10.0, y (0.0 - 20.0) and z 30.0), x axis (a cad vector3 with x 1.5, y 2.0 and z 0.25) and y axis (a cad vector3 with x (0.0 - 0.75), y 0.5 and z 3.0)
set values to an empty list of a 64 bit floating-point number
append (the x of (the origin of plane)) to values
append (the y of (the origin of plane)) to values
append (the z of (the origin of plane)) to values
append (the x of (the xAxis of plane)) to values
append (the y of (the xAxis of plane)) to values
append (the z of (the xAxis of plane)) to values
append (the x of (the yAxis of plane)) to values
append (the y of (the yAxis of plane)) to values
append (the z of (the yAxis of plane)) to values
loop index from 0 to 64:
    append ((index as a 64 bit floating-point number) * 0.25) to values
    append ((index as a 64 bit floating-point number) * (0.0 - 0.125)) to values
loop index from 0 to 192:
    append (0.0 - 99.0) to values

set window to a new hidden window with width 64 and height 64
if window = 0 as a pointer to a byte:
    print (the current graphics error message) as a line
    free values
    return 1
if (Vulkan 64 bit compute is available for window) = false:
    if run compute shader at "build/plane-lift.spv" for window with storage ((the data of values) as a pointer to a byte) of (2632 as a word sized unsigned integer) bytes in 1 workgroups:
        close window
        free values
        return 1
    print "64-bit GPU compute unavailable; dispatch rejected" as a line
    close window
    free values
    return 0

if (run compute shader at "build/plane-lift.spv" for window with storage ((the data of values) as a pointer to a byte) of (2632 as a word sized unsigned integer) bytes in 1 workgroups) = false:
    print (the current graphics error message) as a line
    close window
    free values
    return 1

set valid to true
loop index from 0 to 64:
    set u to (index as a 64 bit floating-point number) * 0.25
    set v to (index as a 64 bit floating-point number) * (0.0 - 0.125)
    set point to the cad point at (a cad vector2 with x u and y v) on plane
    if (the item at (137 + index * 3) in values) != (the x of point):
        set valid to false
    if (the item at (138 + index * 3) in values) != (the y of point):
        set valid to false
    if (the item at (139 + index * 3) in values) != (the z of point):
        set valid to false

close window
free values
if valid = false:
    return 1
print "64 planar GPU points match the CPU kernel" as a line
