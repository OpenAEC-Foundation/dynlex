# SPDX-License-Identifier: MPL-2.0
import lib/cadkernel/brep_imprint.dl
import lib/cadkernel/brep_make.dl

function check cad imprint {boolean:condition}:
    execute:
        if condition = false:
            @intrinsic("call", "libc", "abort", nothing)

set firstMade to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set secondMade to the cad cuboid at (a cad vector3 with x 5.0, y 5.0 and z 5.0) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
check cad imprint (firstMade's valid and secondMade's valid)
set firstBody to firstMade's value
set secondBody to secondMade's value
set firstBounds to the cad bounds of firstBody
set secondBounds to the cad bounds of secondBody
set result to the cad imprint of firstBody and secondBody within 1e-9
check cad imprint result's valid
check cad imprint (result's cuts > 0)
check cad imprint ((result's meetings > 0) and (result's meetings < 36))
check cad imprint ((the cad count of firstBody's faces) > 6)
check cad imprint ((the cad count of secondBody's faces) > 6)
check cad imprint ((the cad euler characteristic of firstBody) = 2)
check cad imprint ((the cad euler characteristic of secondBody) = 2)
check cad imprint ((the cad bounds of firstBody)'s value = firstBounds's value)
check cad imprint ((the cad bounds of secondBody)'s value = secondBounds's value)
set firstFlaws to the cad flaws of firstBody
set secondFlaws to the cad flaws of secondBody
check cad imprint ((the length of firstFlaws) = 0)
check cad imprint ((the length of secondFlaws) = 0)
free firstFlaws
free secondFlaws
print "overlapping_solids_are_imprinted_without_changing_their_shape" as a line

set apartMadeA to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 1.0, y 1.0 and z 1.0)
set apartMadeB to the cad cuboid at (a cad vector3 with x 50.0, y 50.0 and z 50.0) with size (a cad vector3 with x 1.0, y 1.0 and z 1.0)
set apartBodyA to apartMadeA's value
set apartBodyB to apartMadeB's value
set apartResult to the cad imprint of apartBodyA and apartBodyB within 1e-9
check cad imprint apartResult's valid
check cad imprint ((apartResult's cuts = 0) and (apartResult's meetings = 0))
check cad imprint ((the cad count of apartBodyA's faces) = 6)
check cad imprint ((the cad count of apartBodyB's faces) = 6)
print "disjoint_solids_are_left_unchanged" as a line

set stackedMadeA to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set stackedMadeB to the cad cuboid at (a cad vector3 with x 0.0, y 0.0 and z 10.0) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set stackedBodyA to stackedMadeA's value
set stackedBodyB to stackedMadeB's value
set stackedResult to the cad imprint of stackedBodyA and stackedBodyB within 1e-9
check cad imprint stackedResult's valid
check cad imprint (stackedResult's cuts = 0)
check cad imprint ((the cad count of stackedBodyA's faces) = 6)
check cad imprint ((the cad count of stackedBodyB's faces) = 6)
print "equal_shared_ground_needs_no_partition" as a line

set wallMadeA to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set wallMadeB to the cad cuboid at (a cad vector3 with x 0.0, y 0.0 and z 10.0) with size (a cad vector3 with x 4.0, y 4.0 and z 4.0)
set wallBodyA to wallMadeA's value
set wallBodyB to wallMadeB's value
set wallResult to the cad imprint of wallBodyA and wallBodyB within 1e-9
check cad imprint wallResult's valid
check cad imprint (wallResult's cuts > 0)
check cad imprint ((the cad count of wallBodyA's faces) > 6)
check cad imprint ((the cad count of wallBodyB's faces) = 6)
check cad imprint ((the cad euler characteristic of wallBodyA) = 2)
check cad imprint ((the cad euler characteristic of wallBodyB) = 2)
set wallFlawsA to the cad flaws of wallBodyA
set wallFlawsB to the cad flaws of wallBodyB
check cad imprint ((the length of wallFlawsA) = 0)
check cad imprint ((the length of wallFlawsB) = 0)
free wallFlawsA
free wallFlawsB
print "a_partly_shared_wall_is_partitioned_at_its_footprint" as a line

set unknownMadeA to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set unknownMadeB to the cad cuboid at (a cad vector3 with x 5.0, y 5.0 and z 5.0) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set unknownBodyA to unknownMadeA's value
set unknownBodyB to unknownMadeB's value
set unknownFaces to the cad face keys of unknownBodyB
set unknownFace to the cad node pointer for (the item at 0 in unknownFaces) in unknownBodyB
replace cad node unknownFace's surface in unknownBodyB with (the cad surface of (a cad torus with frame (the cad xy plane), major radius 4.0 and minor radius 1.0))
set unknownResult to the cad imprint of unknownBodyA and unknownBodyB within 1e-9
check cad imprint (unknownResult's valid = false)
check cad imprint (unknownResult's snag = cad imprint no closed form snag)
free unknownFaces
print "an_unknown_surface_intersection_is_reported_as_a_snag" as a line

set surveyOrigin to a cad vector3 with x 512345.678, y 4512345.678 and z 91.5
set surveyMadeA to the cad cuboid at surveyOrigin with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set surveyMadeB to the cad cuboid at (a cad vector3 with x (surveyOrigin's x + 5.0), y (surveyOrigin's y + 5.0) and z (surveyOrigin's z + 5.0)) with size (a cad vector3 with x 10.0, y 10.0 and z 10.0)
set surveyBodyA to surveyMadeA's value
set surveyBodyB to surveyMadeB's value
set surveyResult to the cad imprint of surveyBodyA and surveyBodyB within 1e-6
check cad imprint surveyResult's valid
check cad imprint ((the cad worst vertex gap of surveyBodyA) < 1e-6)
check cad imprint ((the cad worst vertex gap of surveyBodyB) < 1e-6)
set surveyFlawsA to the cad flaws of surveyBodyA
set surveyFlawsB to the cad flaws of surveyBodyB
check cad imprint ((the length of surveyFlawsA) = 0)
check cad imprint ((the length of surveyFlawsB) = 0)
free surveyFlawsA
free surveyFlawsB
print "imprinting_remains_stable_at_survey_coordinates" as a line
