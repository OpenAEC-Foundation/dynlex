# SPDX-License-Identifier: MPL-2.0
import tests/cadkernel/brep_make_cuboid/main.dl

set cylinder to the cad cylinder body at (the cad zero vector3) with radius 5.0 and height 10.0
check solid maker (cylinder's valid)
check solid maker ((the cad count of (cylinder's value's faces)) = 3)
check solid maker ((the cad count of (cylinder's value's edges)) = 3)
check solid maker ((the cad count of (cylinder's value's vertices)) = 2)
check solid maker ((the cad euler characteristic of (cylinder's value)) = 2)
check consistent solid (cylinder's value)
print "a_cylinder_has_the_parts_a_cylinder_has" as a line

set roundEdges to the cad edge keys of (cylinder's value)
loop index from 0 to the length of roundEdges:
    set edge to the cad node pointer for (the item at index in roundEdges) in (cylinder's value)
    check solid maker ((the length of (edge's coedges's values)) = 2)
    set first to the cad node pointer for (the item at 0 in ((edge's coedges's values))) in (cylinder's value)
    set last to the cad node pointer for (the item at 1 in ((edge's coedges's values))) in (cylinder's value)
    check solid maker ((first's forward) != (last's forward))
free roundEdges
print "a_cylinders_rims_are_each_shared_by_two_faces" as a line

set sphere to the cad sphere body at (the cad zero vector3) with radius 5.0
check solid maker (sphere's valid)
check solid maker ((the cad count of (sphere's value's faces)) = 1)
check solid maker ((the cad count of (sphere's value's edges)) = 1)
check solid maker ((the cad count of (sphere's value's vertices)) = 2)
check solid maker ((the cad euler characteristic of (sphere's value)) = 2)
check consistent solid (sphere's value)
print "a_sphere_is_one_face_bounded_by_a_seam" as a line

set shifted to the cad sphere body at (a maker point [1.0,2.0,3.0]) with radius 4.0
set seamKeys to the cad edge keys of (shifted's value)
set seam to the cad node pointer for (the item at 0 in seamKeys) in (shifted's value)
set south to the cad node pointer for (seam's start) in (shifted's value)
set north to the cad node pointer for (seam's end) in (shifted's value)
check solid maker ((the absolute value of ((south's point's z) + 1.0)) < 1e-9)
check solid maker ((the absolute value of ((north's point's z) - 7.0)) < 1e-9)
free seamKeys
print "a_spheres_poles_are_a_radius_apart_along_its_axis" as a line

set sphereFaces to the cad face keys of (sphere's value)
set face to the cad node pointer for (the item at 0 in sphereFaces) in (sphere's value)
set surface to the cad node pointer for (face's surface) in (sphere's value)
set seamKeys to the cad edge keys of (sphere's value)
set seam to the cad node pointer for (the item at 0 in seamKeys) in (sphere's value)
set seamCurve to the cad node pointer for (seam's curve) in (sphere's value)
loop index from 0 to 9:
    set parameter to (seam's startParameter) + ((((seam's endParameter) - (seam's startParameter)) * (index as a 64 bit floating-point number)) / 8.0)
    set point to the cad point on (@intrinsic("dereference", seamCurve)) at parameter
    check solid maker ((@intrinsic("dereference", surface)) contains cad point point within 1e-9)
free seamKeys
free sphereFaces
print "a_spheres_seam_lies_on_the_sphere" as a line

set cone to the cad cone body at (the cad zero vector3) with radius 5.0 and height 12.0
check solid maker (cone's valid)
check solid maker ((the cad count of (cone's value's faces)) = 2)
check solid maker ((the cad count of (cone's value's edges)) = 2)
check solid maker ((the cad count of (cone's value's vertices)) = 2)
check solid maker ((the cad euler characteristic of (cone's value)) = 2)
check consistent solid (cone's value)
print "a_cone_is_a_wall_and_a_base_meeting_at_a_point" as a line

set coneVertices to the cad keys of (cone's value's vertices)
set apex to the cad zero vector3
set apexFound to false
loop index from 0 to the length of coneVertices:
    set vertexNode to the cad node pointer for (the item at index in coneVertices) in (cone's value's vertices)
    if ((vertexNode's point's z) > 1.0) and (apexFound = false):
        set apex to vertexNode's point
        set apexFound to true
check solid maker apexFound
check solid maker ((the absolute value of ((apex's z) - 12.0)) < 1e-9)
free coneVertices
set coneSurfaces to the cad keys of (cone's value's surfaces)
set coneSurfaceFound to false
loop index from 0 to the length of coneSurfaces:
    set surfaceNode to the cad node pointer for (the item at index in coneSurfaces) in (cone's value's surfaces)
    if (surfaceNode's kind) = 2:
        set coneSurfaceFound to true
        check solid maker ((@intrinsic("dereference", surfaceNode)) contains cad point apex within 1e-9)
check solid maker coneSurfaceFound
free coneSurfaces
print "a_cones_surface_reaches_its_own_apex" as a line

set absentSphere to the cad sphere body at (the cad zero vector3) with radius 0.0
check solid maker ((absentSphere's valid) = false)
set absentSphere to the cad sphere body at (the cad zero vector3) with radius -1.0
check solid maker ((absentSphere's valid) = false)
set absentCone to the cad cone body at (the cad zero vector3) with radius 1.0 and height 0.0
check solid maker ((absentCone's valid) = false)
print "zero_size_spheres_and_cones_are_refused" as a line
set absentCylinder to the cad cylinder body at (the cad zero vector3) with radius 0.0 and height 1.0
check solid maker ((absentCylinder's valid) = false)
set absentCylinder to the cad cylinder body at (the cad zero vector3) with radius 1.0 and height -1.0
check solid maker ((absentCylinder's valid) = false)
set absentCylinder to the cad cylinder body at (the cad zero vector3) with radius (0.0 / 0.0) and height 1.0
check solid maker ((absentCylinder's valid) = false)
print "a_cylinder_with_no_size_is_refused" as a line
