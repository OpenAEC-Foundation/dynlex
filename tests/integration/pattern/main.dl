import lib/std.dl
# this function has a single pattern, defined right at the function definition line instead of in a pattern section.
to get variable's next power of two:
	set result to 1
	while result < variable:
		multiply result by 2
	return result

to announce line message: print line message

class:
	patterns:
		[an|] octet
		[an|] unsigned char
		[an|] eight bit unsigned integer


to get number%:
	return number * 0.01

announce line "Hello, World!"
		
# should print 8
print line 5.5's next power of two

