import lib/std.dl

to get width only of {32 bit:value}:
    return value

to get width only pointer of {a pointer to 32 bit:address}:
    return the value at address

print line width only of (42 as a 32 bit signed integer)
print line width only of (4294967295 as a 32 bit unsigned integer)
print line width only of (1.5 as a 32 bit floating-point number)

set {signed sample} to 42 as a 32 bit signed integer
set {unsigned sample} to 4294967295 as a 32 bit unsigned integer
set {float sample} to 1.5 as a 32 bit floating-point number
print line width only pointer of (the address of {signed sample})
print line width only pointer of (the address of {unsigned sample})
print line width only pointer of (the address of {float sample})
