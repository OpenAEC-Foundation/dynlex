import ../../../site/games/river/model.dl
import ../../../site/games/river/trace.dl

set scene to the initial website river scene
set loaded to @intrinsic("construct", website river event, 1, 1, 0, the string form of "", @intrinsic("construct", a pointer to website river event))
set next to the website river scene after loaded from scene
require condition (next's error's length = 0) reporting "A passenger on the home bank could not be loaded"
require condition ((next's scene's cargo = 1) and ((the item at 0 in (next's scene's passengers)) = -1)) reporting "Loading did not move the sheep into the boat"
require condition ((scene's cargo = 0) and ((the item at 0 in (scene's passengers)) = 0)) reporting "A scene transition mutated its input snapshot"
set crossed to @intrinsic("construct", website river event, 3, 1, 0, the string form of "", @intrinsic("construct", a pointer to website river event))
set next to the website river scene after crossed from (next's scene)
require condition ((next's scene's bank = 1) and (next's scene's heading = 1)) reporting "Crossing lost the boat's bank or heading"
set unloaded to @intrinsic("construct", website river event, 2, 1, 0, the string form of "", @intrinsic("construct", a pointer to website river event))
set next to the website river scene after unloaded from (next's scene)
require condition ((next's scene's cargo = 0) and ((the item at 0 in (next's scene's passengers)) = 1)) reporting "Unloading left the sheep aboard"
set invalid to the website river scene after loaded from (next's scene)
set invalid to the website river scene after loaded from (invalid's scene)
require condition (invalid's error's length > 0) reporting "A second passenger was loaded into the occupied boat"
set danger to @intrinsic("construct", website river event, 4, 2, 1, the string form of "", @intrinsic("construct", a pointer to website river event))
set scene's bank to 1
set next to the website river scene after danger from scene
require condition ((next's error's length = 0) and (next's scene's predator = 2)) reporting "An unattended danger pair was lost"
set victory to @intrinsic("construct", website river event, 6, 0, 0, the string form of "", @intrinsic("construct", a pointer to website river event))
set next to the website river scene after victory from scene
require condition (next's error's length > 0) reporting "An incomplete crossing was declared solved"
set scene's passengers to [1,1,1]
set next to the website river scene after victory from scene
require condition ((next's error's length = 0) and (next's scene's complete)) reporting "Everyone on the far bank did not complete the crossing"

set trace to website river trace from (the string form of "DYNLEX|TRACE|2|0|2|22|-1\nRIVER|COMMAND|LOAD|SHEEP\nRIVER|ACTION|LOAD|SHEEP\nDYNLEX|TRACE|3|0|3|12|1\nRIVER|COMMAND|CROSS\nRIVER|ACTION|CROSS|FAR\nRIVER|DANGER|WOLF|HAY\nRIVER|ERROR|An example error\n") dropping 2 source lines
require condition ((trace's error's length = 0) and (trace's count = 3)) reporting "A valid command/condition trace was rejected"
require condition ((trace's first's source's start line = 0) and (trace's first's first's subject = 1)) reporting "The command lost its source or passenger"
require condition ((trace's first's next's kind = 0) and (trace's first's next's branch = 1)) reporting "A condition was not retained as a step"
require condition ((trace's outcome = 2) and (trace's message = "An example error")) reporting "A reported game error was lost"
free website river trace the address of trace
for each text in ["unexpected output", "RIVER|ACTION|LOAD|SHEEP", "RIVER|COMMAND|LOAD|DRAGON", "RIVER|COMMAND|CROSS|HOME", "RIVER|COMMAND|CROSS\nRIVER|ACTION|CROSS|BOAT", "RIVER|COMMAND|CROSS\nRIVER|DANGER|WOLF|", "RIVER|COMMAND|CROSS\nRIVER|ERROR|", "RIVER|COMMAND|CROSS\nRIVER|SUCCESS|extra", "DYNLEX|TRACE|2|0|2|3|-1"]:
    set trace to website river trace from (the string form of text) dropping 2 source lines
    require condition (trace's error's length > 0) reporting "A malformed river trace was accepted"
    free website river trace the address of trace
set trace to website river trace from (the string form of "DYNLEX|TRACE|7|0|7|4|-1\nRIVER|COMMAND|CROSS\nRIVER|ACTION|CROSS|FAR\n") dropping 5 source lines
require condition (trace's first's source's start line = 2) reporting "The trace reader assumed a fixed program prefix"
free website river trace the address of trace
print line "River traces preserve commands, conditions and source ranges; scene snapshots validate domain events."
