import lib/host.dl
import lib/path.dl

set executable to the running executable path
set directory to the running executable directory
set cache to the user cache directory
set platform to whether the host platform is Windows
set native to the native path style
set style to native's value

print lines (executable succeeded), (executable is supported), (directory succeeded) and (directory is supported)
print lines (cache succeeded), (cache is supported), (platform succeeded) and (platform is supported)
print lines (native succeeded), (native is supported) and (executable's error message = "")
print lines (directory's error message = ""), (cache's error message = "") and (platform's error message = "")
print line (native's error message = "")

set filename to the filename of executable's value using style
set parent to the parent path of executable's value using style
set resolved to the path obtained by resolving executable's value against directory's value using style
set program to whether executable's value is an absolute path using style
set folder to whether directory's value is an absolute path using style
set cached to whether cache's value is an absolute path using style

set expected to "main.exe" if platform's value, else "main.out"
print line (filename succeeded) and (filename's value = expected)
print line (parent succeeded) and (parent's value = directory's value)
print line (resolved succeeded) and (resolved's value = executable's value)
print lines ((program succeeded) and program's value) and ((folder succeeded) and folder's value)
print line ((cached succeeded) and cached's value)
