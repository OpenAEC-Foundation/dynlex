import lib/std.dl

to show {number}:
    @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", @intrinsic("type", "int", 32), 1, "%d\n", number))

to inspect fixed {fixed integer:value}:
    if @intrinsic("equal", 1, 1):
        show value
        @intrinsic("store", {value}, 20)
        show value
    show value

inspect fixed 10
