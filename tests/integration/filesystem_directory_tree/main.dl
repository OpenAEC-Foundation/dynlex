import lib/filesystem.dl

set root to "tests/integration/filesystem_directory_tree/tree.tmp"
set folder to "tests/integration/filesystem_directory_tree/tree.tmp/one/two"
set file to "tests/integration/filesystem_directory_tree/tree.tmp/file.bin"
set leaf to "tests/integration/filesystem_directory_tree/tree.tmp/one/two/nested.bin"
set missing to "tests/integration/filesystem_directory_tree/missing.tmp"

remove the filesystem tree at root and set initial to it
print line initial succeeded

create a directory tree at folder and set created to it
print line created succeeded
create a directory tree at folder and set duplicate to it
print line duplicate succeeded

write the string form of "root" to the file at file
write the string form of "nested" to the file at leaf

set metadata to the file system entry at file
print lines (metadata lookup succeeded), (metadata was found) and (metadata is a regular file)
print lines (metadata is a directory), (metadata is a symbolic link) and (metadata has another filesystem kind)
print line (metadata's modification time)'s seconds > 0

set listing to the file system entry at folder
print lines (listing lookup succeeded), (listing was found), (listing is a regular file) and (listing is a directory)

set absence to the file system entry at missing
print lines (absence lookup succeeded), (absence was found) and (the length of absence's error message)

set invalid to a new string from "A" containing 2 bytes
set failure to the file system entry at invalid
print lines (failure lookup succeeded), (failure was found) and ((the length of failure's error message) > 0)
remove the filesystem tree at invalid and set cleanup to it
print lines (cleanup succeeded) and ((the length of cleanup's error message) > 0)

open the directory at root and set enumeration to it
print line enumeration succeeded
set entries, files and directories to 0
set success and reading to true
loop while reading:
    read the next directory entry from enumeration and set next to it
    if next lookup failed:
        set success and reading to false
    else if next was found:
        increment entries
        if next is a regular file:
            increment files
        if next is a directory:
            increment directories
    else:
        set reading to false
print lines success, entries, files and directories

remove the filesystem tree at root and set removed to it
print line removed succeeded
set remnant to the file system entry at root
print lines (remnant lookup succeeded) and (remnant was found)
