import tests/games/studio/session.dl
import lib/check.dl

set session to a new spatial study from (a camera at (a position with x 0.0, y 8.0 and z 24.0) facing 0.0 degrees with speed 1.0 and turn rate 2.0)
move (the address of session) forward 1.0 sideways 0.0 vertically 0.0 turning 0.0 after (1.0 / 60.0) seconds
require condition (session's camera's position's z = 23.0) reporting "The camera did not move forward"
set session's paused to true
move (the address of session) forward 1.0 sideways 0.0 vertically 0.0 turning 0.0 after 0.1 seconds
require condition (session's camera's position's z = 23.0) reporting "A paused camera moved"
restart the address of session
require condition (session's camera's position's z = 24.0) reporting "Reset did not restore the camera"
require condition (session's elapsed = 0.0) reporting "Reset did not rewind the animation"
set session's paused to false
set slower to session
loop 10 times:
    move (the address of session) forward 1.0 sideways 0.0 vertically 0.0 turning 0.0 after (1.0 / 60.0) seconds
loop 5 times:
    move (the address of slower) forward 1.0 sideways 0.0 vertically 0.0 turning 0.0 after (1.0 / 30.0) seconds
require condition ((the absolute value of (session's camera's position's z - slower's camera's position's z)) < 0.00000001) reporting "The display rate changed the camera speed"
print line "Spatial session passed"
