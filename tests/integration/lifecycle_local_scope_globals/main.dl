import lib/std.dl

function advance shared counter:
    globals: marker
    execute:
        increment marker

function the shared counter:
    globals: marker
    execute:
        return marker

to get the independent counter:
    set marker to 99
    return marker

class:
    patterns:
        [a|] global name probe
    members:
        tag as an integer
    retain:
        set marker to 11
    release:
        set marker to 22

to exercise global shadow:
    set held to @intrinsic("construct", a global name probe, 0)
    ignore held

set marker to 40
exercise global shadow
print line (the shared counter)
advance shared counter
print lines (the shared counter), (the independent counter) and (the shared counter)
