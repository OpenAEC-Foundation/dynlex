import lib/process.dl

to get the lifecycle test interpreter:
    return "python" if the process platform is Windows, else "python3"

set discovery to a process command for the lifecycle test interpreter
add "-c" as an argument to discovery
add "import sys; sys.stdout.write(sys.executable)" as an argument to discovery
run discovery and set found to it
set interpreter to found's standard output

set setup to a process command for interpreter
add "-c" as an argument to setup
add "import os; os.remove('sentinel.tmp') if os.path.exists('sentinel.tmp') else None" as an argument to setup
use "tests/integration/process_lifecycle_cleanup" as the working directory of setup
run setup and set preparation to it

to get whether an abandoned process launches using interpreter:
    set command to a process command for interpreter
    add "-c" as an argument to command
    add "import time; time.sleep(0.4); open('sentinel.tmp', 'w').close()" as an argument to command
    use "tests/integration/process_lifecycle_cleanup" as the working directory of command
    launch command and set child to it
    return child was launched

set abandoned to whether an abandoned process launches using interpreter

set verification to a process command for interpreter
add "-c" as an argument to verification
add "import os,sys,time; time.sleep(1); existed=os.path.exists('sentinel.tmp'); sys.stdout.buffer.write(b'True\\n' if existed else b'False\\n'); os.remove('sentinel.tmp') if existed else None" as an argument to verification
use "tests/integration/process_lifecycle_cleanup" as the working directory of verification
run verification and set check to it

print lines (found succeeded), (preparation succeeded), abandoned and (check succeeded)
print line (check's standard output = "False\n")
