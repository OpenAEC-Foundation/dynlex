import lib/std.dl

value doubled means: value * 2 # replacement shorthand comment

to print doubled value: print line value doubled # action shorthand comment

to get value quadrupled: # value shorthand comment
    if value = 0:
        return 0
    return (value doubled) * 2

function value still means:
    execute:
        return value + 1

