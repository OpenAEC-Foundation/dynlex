import lib/std.dl

class:
    patterns:
        [a|] scope probe
    members:
        marker as an integer
    retain:
        set localMarker to 111
        if localMarker != 111:
            @intrinsic("call", "libc", "exit", nothing, 81)
    release:
        set localMarker to 222
        if localMarker != 222:
            @intrinsic("call", "libc", "exit", nothing, 82)

to exercise local lifetime:
    set held to @intrinsic("construct", a scope probe, 0)
    ignore held

to get the unrelated local value:
    set localMarker to 333
    return localMarker

set localMarker to 99
exercise local lifetime
print lines localMarker, (the unrelated local value) and localMarker
