import lib/filesystem.dl

set path to "tests/integration/filesystem_binary/content.tmp"
delete the filesystem entry at path

set payload to a new string buffer containing 3 bytes
store 65 as a byte into the data of payload at 0
store 0 as a byte into the data of payload at 1
store 66 as a byte into the data of payload at 2
write payload to the file at path and set writing to it
print line writing succeeded

delete the filesystem entry at path
