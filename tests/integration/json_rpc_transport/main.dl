import lib/json_rpc.dl

to get [the|] JSON-RPC transport test interpreter:
    return "python" if the process platform is Windows, else "python3"

set script to "import json,sys\nmessages=[({'jsonrpc':'2.0','method':'one','params':{'text':'hé😀'}},['X-Test: first','content-length: {length}']),({'jsonrpc':'2.0','method':'two'},['CONTENT-LENGTH: {length}','Content-Type: application/vscode-jsonrpc; charset=utf-8'])]\nfor message,headers in messages:\n payload=json.dumps(message,separators=(',',':'),ensure_ascii=False).encode('utf-8')\n frame=('\\r\\n'.join(line.format(length=len(payload)) for line in headers)+'\\r\\n\\r\\n').encode('ascii')+payload\n for byte in frame:\n  sys.stdout.buffer.write(bytes([byte])); sys.stdout.buffer.flush()\nrequest=sys.stdin.buffer.read()\nseparator=request.index(b'\\r\\n\\r\\n')\nheaders=request[:separator].decode('ascii').split('\\r\\n')\nlength=int(next(line.split(':',1)[1] for line in headers if line.split(':',1)[0].lower()=='content-length'))\npayload=request[separator+4:separator+4+length]\nmessage=json.loads(payload)\nvalid=message=={'jsonrpc':'2.0','method':'client/message','params':[1,True]}\nreply=json.dumps({'jsonrpc':'2.0','method':'verified','params':valid},separators=(',',':')).encode()\nsys.stdout.buffer.write(b'Content-Length: '+str(len(reply)).encode()+b'\\r\\n\\r\\n'+reply);sys.stdout.buffer.flush()"
set command to a process command for the JSON-RPC transport test interpreter
add "-u" as an argument to command
add "-c" as an argument to command
add script as an argument to command

launch command and set child to it
set opened to the result of connecting JSON-RPC to child
print line opened succeeded
set connection to opened's connection

set first to the next JSON-RPC message from connection
print lines (first succeeded) and (the JSON text named "method" in first's message = "one")
set parameters to the JSON member named "params" in first's message
print line (the JSON text named "text" in parameters = "hé😀")
free first

set second to the next JSON-RPC message from connection
print lines (second succeeded) and (the JSON text named "method" in second's message = "two")
free second

set parameters to a new JSON value of kind the JSON array kind
set number to a new JSON value of kind the JSON number kind
set the number of number to 1.0
set the text of number to the string form of "1"
add number to the JSON array parameters
set truth to a new JSON value of kind the JSON boolean kind
set the boolean of truth to true
add truth to the JSON array parameters
set sent to the result of sending JSON-RPC notification "client/message" with parameters using connection
print line sent succeeded
free parameters
set closure to the result of closing the input of connection
print line closure succeeded

set verified to the next JSON-RPC message from connection
print lines (verified succeeded) and (the JSON text named "method" in verified's message = "verified")
print line the JSON boolean named "params" in verified's message
free verified

set ending to the next JSON-RPC message from connection
print line (ending's status = the JSON-RPC end of stream status)
free ending

set closed to the result of closing connection
print line closed succeeded
free connection
