print line ("abc" matches the regular expression described by "^(cat|dog)$")
print line ("dog" matches the regular expression described by "^(cat|dog)$")
print line ("color" matches the regular expression described by "^colou?r$")
print line ("colour" matches the regular expression described by "^colou?r$")
print line ("abbbc" matches the regular expression described by "^ab*c$")
print line ("xx abbbc yy" contains a match for the regular expression described by "ab+c")
