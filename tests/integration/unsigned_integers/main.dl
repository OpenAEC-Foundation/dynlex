import lib/std.dl
import lib/vector.dl

set maximum to 4294967295 as a 32 bit unsigned integer
set high64 to 9223372036854775808 as a 64 bit unsigned integer
set bareHigh64 to 9223372036854775808
set signedMinimum to -9223372036854775808
set limit to 9223372036854775808
set wrappedLimit to -limit
set full64 to 18446744073709551615
set zero8 to 0 as a 8 bit unsigned integer
set zero16 to 0 as a 16 bit unsigned integer
set zero32 to 0 as a 32 bit unsigned integer
set zero64 to 0 as a 64 bit unsigned integer
set signed32 to (-1) as a 32 bit integer
set signed64 to (-1) as a 64 bit integer
set floatMaximum to maximum as a 64 bit floating-point number
set floatRoundTrip to floatMaximum as a 64 bit unsigned integer
set floatFraction to 1.5 as a 64 bit floating-point number
set floatTruncated to floatFraction as a 32 bit unsigned integer
set floatHigh64 to 9223372036854775808 as a 64 bit floating-point number
set floatHigh64RoundTrip to floatHigh64 as a 64 bit unsigned integer
set maximumPointer to @intrinsic("address of", maximum)
set unsignedVector to a new vector with x maximum, y maximum and z (1 as a 32 bit unsigned integer)
set shiftedVector to unsignedVector / (2 as a 32 bit unsigned integer)

to get checked fixed value {fixed a number:value}:
    return value

to get checked fixed equality {fixed boolean:value}:
    return value

print lines maximum, zero8, zero16, zero32, zero64, (maximum shifted right by 1) and (maximum / 2)
