to get the combined seed from {a 32 bit unsigned integer:hash} and {a 32 bit unsigned integer:value}:
    set golden to 2654435769 as a 32 bit unsigned integer
    set multiplier to 2246822507 as a 32 bit unsigned integer
    set state to hash ^ ((value + golden) + ((hash << 6) + (hash >> 2)))
    set state to state * multiplier
    return state ^ (state >> 16)

to get the mixed animal seed from {a 32 bit unsigned integer:value}:
    set firstMultiplier to 2146121005 as a 32 bit unsigned integer
    set secondMultiplier to 2221713035 as a 32 bit unsigned integer
    set state to value ^ (value >> 16)
    set state to state * firstMultiplier
    set state to state ^ (state >> 15)
    set state to state * secondMultiplier
    return state ^ (state >> 16)

