import tests/games/city/layout.dl
import lib/check.dl

loop column from -2 through 2:
    loop row from -2 through 2:
        loop horizontal from 0 to 2:
            loop vertical from 0 to 2:
                set center to the center of city lot ((column * 2 + horizontal) as a floating-point number) ((row * 2 + vertical) as a floating-point number)
                require condition ((center's x - 6.0) >= ((column * 48 + 12) as a floating-point number)) reporting "A city lot overlaps the west road"
                require condition ((center's x + 6.0) <= ((column * 48 + 48) as a floating-point number)) reporting "A city lot leaves the east pavement"
                require condition ((center's z - 6.0) >= ((row * 48 + 12) as a floating-point number)) reporting "A city lot overlaps the north road"
                require condition ((center's z + 6.0) <= ((row * 48 + 48) as a floating-point number)) reporting "A city lot leaves the south pavement"
print line "City lots stay inside their blocks"
