import lib/std.dl

to get recursive:
	@intrinsic("discard", recursive)
	@intrinsic("return", 1)

to get referenced direct recursive {integer:value}:
	if value > 0:
		return referenced direct recursive (value - 1)
	return value

to get referenced mutual first {integer:value}:
	if value > 0:
		return referenced mutual second (value - 1)
	return value

to get referenced mutual second {integer:value}:
	if value > 0:
		return referenced mutual first (value - 1)
	return value

ignore @intrinsic("function", "recursive")
set direct to the function named "referenced direct recursive $"
set mutual to the function named "referenced mutual first $"

ignore direct
ignore mutual
