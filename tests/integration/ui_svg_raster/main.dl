import lib/ui_svg_raster.dl

to get SVG coverage at size {integer:size} using {a pointer:library}:
    set pixels to the coverage of SVG (the UI icon named "clock") at pixel size size using library
    set opaque to 0
    set partial to 0
    set area to 0
    set index to 0
    loop while index < (size * size):
        set alpha to ((the item at index in (the data of pixels)) as an integer) bitwise and 255
        set area to area + alpha
        if alpha = 255:
            increment opaque
        if (alpha > 0) and (alpha < 255):
            increment partial
        increment index
    require condition (opaque > size) reporting "SVG strokes have no opaque core"
    require condition (partial > size) reporting "SVG curves have no antialiased coverage"
    require condition ((the item at 0 in (the data of pixels)) = (0 as a byte)) reporting "SVG coverage leaked outside the icon"
    return area / (size * size)

set library to @intrinsic("construct", a pointer)
set error to @intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)
require condition (error = 0) reporting "Initializing SVG raster test failed"
set small to SVG coverage at size 24 using library
set large to SVG coverage at size 96 using library
require condition ((small - large >= -2) and (small - large <= 2)) reporting "Scaling changed the SVG stroke coverage"
set dot to a UI SVG icon from [SVG open 12.0 12.0, SVG line 12.01 12.0, SVG end]
set pixels to the coverage of SVG dot at pixel size 8 using library
set coverage to 0
set index to 0
loop while index < 64:
    set coverage to coverage + (((the item at index in (the data of pixels)) as an integer) bitwise and 255)
    increment index
require condition ((coverage > 60) and (coverage < 120)) reporting "A small round SVG bullet lost its coverage"
# Path direction must not change the coverage of two overlapping strokes.
set first to the coverage of SVG (a UI SVG icon from [SVG closed 4.0 4.0, SVG line 20.0 4.0, SVG line 20.0 20.0, SVG line 4.0 20.0, SVG end, SVG closed 4.0 4.0, SVG line 20.0 4.0, SVG line 20.0 20.0, SVG line 4.0 20.0, SVG end]) at pixel size 24 using library
set second to the coverage of SVG (a UI SVG icon from [SVG closed 4.0 4.0, SVG line 20.0 4.0, SVG line 20.0 20.0, SVG line 4.0 20.0, SVG end, SVG closed 4.0 4.0, SVG line 4.0 20.0, SVG line 20.0 20.0, SVG line 20.0 4.0, SVG end]) at pixel size 24 using library
set index to 0
loop while index < (24 * 24):
    require condition ((the item at index in (the data of first)) = (the item at index in (the data of second))) reporting "Overlapping SVG strokes cancelled each other"
    increment index
set names to ["align-center", "align-left", "audio", "background", "bold", "brush", "chart", "check", "chevron", "clock", "colors", "comment", "copy", "cut", "down", "eye", "find", "grid", "italic", "layout", "link", "list", "paste", "picture", "play", "redo", "replace", "reset", "ruler", "save", "search", "shapes", "share", "slide", "star", "table", "text", "theme", "transition", "underline", "undo", "video", "zoom"]
set item to 0
loop while item < (the length of names):
    set name to the item at item in names
    set size to 8
    loop while size <= 96:
        set raster to the coverage of SVG (the UI icon named name) at pixel size size using library
        require condition ((the length of raster) = (size * size)) reporting "An SVG raster has the wrong dimensions"
        set size to size * 2
    increment item
set error to @intrinsic("call", "freetype", "FT_Done_FreeType", an integer, library)
require condition (error = 0) reporting "Closing SVG raster test failed"
print line "SVG raster passed"
