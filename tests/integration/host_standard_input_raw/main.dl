import lib/host.dl

local function the unsigned byte at {integer:offset} in {string:text}:
    execute:
        return (the character at offset in text as a 32 bit integer) bitwise and 255

read a chunk from the standard input and set first to it
print lines (first succeeded), (first is supported) and (first's contents's length = 4096)
print lines (the unsigned byte at 4094 in first's contents) and (the unsigned byte at 4095 in first's contents)
print lines (first has not reached the end of file) and (first's error message = "")

read a chunk from the standard input and set second to it
print lines (second succeeded), (second is supported) and (second's contents's length = 4)
print lines (the unsigned byte at 0 in second's contents) and (the unsigned byte at 1 in second's contents)
print lines (the unsigned byte at 2 in second's contents) and (the unsigned byte at 3 in second's contents)
print lines (second reached the end of file) and (second's error message = "")

read a chunk from the standard input and set finished to it
print lines (finished succeeded), (finished is supported) and (finished's contents's length = 0)
print lines (finished reached the end of file) and (finished's error message = "")

print lines (the unsigned byte at 4094 in first's contents) and (the unsigned byte at 0 in second's contents)
