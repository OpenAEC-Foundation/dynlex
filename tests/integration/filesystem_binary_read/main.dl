import lib/filesystem.dl

set path to "tests/integration/filesystem_binary_read/content.tmp"
delete the filesystem entry at path
set stream to @intrinsic("call", "libc", "fopen", a pointer to a byte, path, "wb")
ignore @intrinsic("variadic call", "libc", "fprintf", an integer, 2, stream, "A%cB", 0)
ignore @intrinsic("call", "libc", "fclose", an integer, stream)

read the file at path and set reading to it
print lines (the length of reading's contents) and ((the character at 0 in reading's contents) as an integer)
print line (the character at 1 in reading's contents) as an integer
print line (the character at 2 in reading's contents) as an integer
delete the filesystem entry at path
