import lib/workspace_edit.dl

set source to the string form of "{\"changes\":{\"file:///workspace/ignored.txt\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"newText\":\"ignored\"}]},\"documentChanges\":[{\"textDocument\":{\"uri\":\"file:///workspace/alpha.txt\",\"version\":4},\"edits\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"newText\":\"alpha\"}]}]}"
set precedence to the result of parsing source as a workspace edit
print lines (precedence succeeded) and (the length of the changes of precedence's edit)
set first to the workspace change at index 0 in the changes of precedence's edit
print lines first's kind, (first's version presence) and first's version
free precedence

set source to the string form of "{\"changes\":{\"file:///workspace/beta.txt\":[],\"file:///workspace/alpha.txt\":[]}}"
set ordered to the result of parsing source as a workspace edit
print lines (ordered succeeded) and ((the workspace change at index 0 in the changes of ordered's edit)'s uri)
print line (the workspace change at index 1 in the changes of ordered's edit)'s uri
free ordered

set source to the string form of "{\"documentChanges\":[{\"textDocument\":{\"uri\":\"file:///workspace/alpha.txt\",\"version\":null},\"edits\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"snippet\":{\"kind\":\"snippet\",\"value\":\"${1:alpha}\"}}]}]}"
set snippet to the result of parsing source as a workspace edit
print lines (snippet succeeded), (snippet's failed change presence) and (snippet's failed change)
print line snippet's failure reason
free snippet
