import json.dl

parse "{\"name\":\"DynLex\",\"enabled\":true,\"values\":[1,2.5,null]}" as JSON and set parsed to it
print line parsed succeeded
set document to the value of parsed
print lines (the JSON text named "name" in document) and (the JSON boolean named "enabled" in document)
set values to the JSON member named "values" in document
print lines (the number of JSON items in values) and (the JSON number at index 1 in values)
free parsed

parse "{\"missing\":}" as JSON and set invalid to it
print lines (invalid succeeded) and (the JSON error position in invalid)
free invalid
