import lib/std.dl

# `integer` says nothing about the sign: it accepts signed and unsigned values.
to get the doubled value of {integer:value}:
    return value * 2

to get the kind of {integer:value}:
    return "an integer"

to get the kind of {unsigned integer:value}:
    return "an unsigned integer"

to get the kind of {signed integer:value}:
    return "a signed integer"

print lines (the doubled value of 7) and (the doubled value of (7 as a 32 bit unsigned integer))
print lines (the doubled value of (7 as a 64 bit unsigned integer)) and (the kind of (7 as an unsigned integer))
print lines (the kind of 7) and (the kind of (7 as a 64 bit integer))
