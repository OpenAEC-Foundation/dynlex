import ../../../site/shaders/program.dl

to get test shader stage {C string:name} with {integer:binding}:
    return a JSON object containing [
        JSON text "webgpu" is (the string form of name), JSON text "webgl" is (the string form of name),
        JSON child "uniforms" is (a JSON array containing [
            a JSON object containing [JSON text "name" is "time", JSON number "group" is 0, JSON number "binding" is 0],
            a JSON object containing [JSON text "name" is "width", JSON number "group" is 0, JSON number "binding" is binding]
        ])
    ]

set stages to a JSON object containing [JSON child "fragment" is (test shader stage "fragment" with 2), JSON child "vertex" is (test shader stage "vertex" with 2)]
set linked to the linkage of event horizon using stages stored as "source"
require condition (linked succeeded) reporting "The fullscreen shader did not link"
set program to linked's program
require condition (shader program program uses input "time") reporting "The linked program lost its time input"
require condition ((shader program program uses input "unknown") = false) reporting "The linked program acquired an unknown input"
set passes to the JSON member named "passes" in program
require condition (passes's length = 1) reporting "A fullscreen shader gained a geometry pass"
set first to the JSON value at index 0 in passes
require condition ((the JSON member named "vertex" in first) is JSON null) reporting "A fullscreen shader gained a vertex stage"
require condition ((the JSON text named "kind" in (the JSON member named "webgpu" in (the JSON member named "fragment" in first))) = "source") reporting "Inline shader code became a URL"
free program
set linked to the linkage of endless terrain using stages stored as "url"
require condition (linked succeeded) reporting "The terrain shader did not link"
set program to linked's program
set first to the JSON value at index 0 in (the JSON member named "passes" in program)
require condition (the JSON boolean named "depth" in first) reporting "Terrain lost depth testing"
require condition ((the JSON member named "uniforms" in first)'s length = 2) reporting "Shared vertex/fragment uniform bindings were duplicated"
require condition ((the JSON text named "kind" in (the JSON member named "webgl" in (the JSON member named "vertex" in first))) = "url") reporting "A packaged shader lost its URL source"
free program
set linked to the linkage of nano choreography using stages stored as "source"
require condition (linked succeeded) reporting "The point-cloud shader did not link"
set program to linked's program
set passes to the JSON member named "passes" in program
require condition (passes's length = 2) reporting "The point-cloud shader lost its background pass"
set second to the JSON value at index 1 in passes
require condition ((the JSON text named "blend" in second) = "additive") reporting "The point cloud lost its additive blend"
require condition ((the JSON number named "renderPass" in second) = 1.0) reporting "The point-cloud pass lost its shader layer"
free program
free stages
set stages to a JSON object containing [JSON child "fragment" is (test shader stage "fragment" with 2), JSON child "vertex" is (test shader stage "vertex" with 3)]
set linked to the linkage of endless terrain using stages stored as "source"
require condition (linked failed) reporting "A uniform acquired two bindings without a link error"
require condition (linked's error != "") reporting "A failed shader linkage lost its error"
free stages
print line "Shader descriptions share source linking, reflected bindings and geometry passes."
