import lib/font.dl

set loading to the result of loading a font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 16 for 0 as a pointer to a byte
set status to loading's status
set typeface to loading's typeface
print lines (loading failed), status's operation and (status's error code != 0)
print lines (typeface's library = 0 as a pointer to a byte) and (typeface's face = 0 as a pointer to a byte)
print line (typeface's cache = (0 as a pointer to a font cache))

set releasing to the result of releasing (the address of typeface)
print line releasing succeeded
