import lib/mersenne_twister64.dl

to print first values from {a 64 bit unsigned integer:seedValue}:
    set generator to a new Mersenne Twister 64 engine
    set generatorAddress to the address of generator
    seed generatorAddress with seedValue
    print line the next 64 bit unsigned integer from generatorAddress
    print line the next 64 bit unsigned integer from generatorAddress
    print line the next 64 bit unsigned integer from generatorAddress
    print line the next 64 bit unsigned integer from generatorAddress
    print line the next 64 bit unsigned integer from generatorAddress

to get the xor checksum after 10000 values from {a 64 bit unsigned integer:seedValue}:
    set generator to a new Mersenne Twister 64 engine
    set generatorAddress to the address of generator
    seed generatorAddress with seedValue
    set result to 0 as a 64 bit unsigned integer
    set count to 0
    loop while count < 10000:
        set result to result bitwise xor (the next 64 bit unsigned integer from generatorAddress)
        set count to count + 1
    return result

to exercise independent engines:
    set firstGenerator to a new Mersenne Twister 64 engine
    set secondGenerator to a new Mersenne Twister 64 engine
    set firstAddress to the address of firstGenerator
    set secondAddress to the address of secondGenerator
    seed firstAddress with (5489 as a 64 bit unsigned integer)
    seed secondAddress with (5489 as a 64 bit unsigned integer)
    print line the next 64 bit unsigned integer from firstAddress
    print line the next 64 bit unsigned integer from secondAddress
    print line the next 64 bit unsigned integer from firstAddress
    print line the next 64 bit unsigned integer from secondAddress

to exercise reset:
    set generator to a new Mersenne Twister 64 engine
    set generatorAddress to the address of generator
    seed generatorAddress with (1 as a 64 bit unsigned integer)
    print line the next 64 bit unsigned integer from generatorAddress
    seed generatorAddress with (1 as a 64 bit unsigned integer)
    print line the next 64 bit unsigned integer from generatorAddress

to exercise unit fractions:
    set generator to a new Mersenne Twister 64 engine
    set generatorAddress to the address of generator
    seed generatorAddress with (0 as a 64 bit unsigned integer)
    set fraction32 to the next 32 bit unit fraction from generatorAddress
    set fraction64 to the next 64 bit unit fraction from generatorAddress
    print lines (0.0 <= fraction32 < 1.0) and (0.0 <= fraction64 < 1.0)

print first values from (0 as a 64 bit unsigned integer)
