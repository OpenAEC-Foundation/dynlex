import lib/std.dl

this is not a fragment shader means: not @intrinsic("shader stage is", "fragment")

this is not a vertex shader means: not @intrinsic("shader stage is", "vertex")

set native to (1 if the build target is CPU, else 0)
set ordinary to 1 if (this is not a fragment shader) and (this is not a vertex shader), else 0
set width to (64 if the build word size = 64, else 32)

print lines native, ordinary and width
