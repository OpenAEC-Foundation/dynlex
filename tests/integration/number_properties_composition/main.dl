import lib/std.dl

# Number types are composed from independent properties.
to get half of {floating-point and 32 bit:value}:
    return value / (2.0 as a 32 bit floating-point number)

to get the byte width of {64 bit and floating-point:value}:
    return 8

print lines (3.7 as an integer), (300 as an 8 bit unsigned integer) and ((0 - 1) as a 16 bit signed integer)
print lines ((1 as a 64 bit floating-point number) / 4.0) and ((1 as a floating-point number) / 8.0)
print lines (half of (1 as a 32 bit floating-point number)) and (the byte width of 2.5)
print lines (4294967295 as a 32 bit unsigned integer) and (5 as a word sized unsigned integer)
