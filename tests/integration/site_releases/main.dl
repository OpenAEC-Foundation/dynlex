import ../../../site/downloads/release.dl
import ../../../site/downloads/platform.dl
import lib/check.dl

to verify [release platform] {C string:agent} hinted {C string:hint} expects {C string:system} and architecture {C string:architecture} named {C string:label}:
    set platform to the website platform for agent with architecture hint and 0 touch points
    require condition (platform's supported) reporting "A desktop platform was rejected"
    require condition (platform's system = system) reporting "The operating system was misidentified"
    require condition (platform's architecture = architecture) reporting "The architecture was misidentified"
    require condition (platform's label = label) reporting "The platform label was misidentified"

verify release platform "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" hinted "" expects "windows" and architecture "x64" named "Windows"
verify release platform "Mozilla/5.0 (Windows NT 10.0; ARM64)" hinted "arm" expects "windows" and architecture "arm64" named "Windows"
verify release platform "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)" hinted "" expects "macos" and architecture "unknown" named "macOS"
verify release platform "Mozilla/5.0 (X11; Linux x86_64)" hinted "" expects "linux" and architecture "x64" named "Linux"
verify release platform "Mozilla/5.0 (X11; Linux aarch64)" hinted "" expects "linux" and architecture "arm64" named "Linux"
set unsupported to ["Mozilla/5.0 (Linux; Android 16; Pixel 10 Pro)", "Mozilla/5.0 (iPhone; CPU iPhone OS 19_0 like Mac OS X)", "Mozilla/5.0 (X11; CrOS x86_64 16093.68.0)"]
set index to 0
loop while index < the length of unsupported:
    set platform to the website platform for (the item at index in unsupported) with architecture "" and 0 touch points
    require condition (platform's supported = false) reporting "An unsupported system was offered a desktop download"
    increment index

set body to "Notes\n<!-- dynlex-release-manifest\nschema 1\nrepository OpenAEC-Foundation/dynlex\nasset linux-x64-deb linux x64 deb dynlex-linux-x64.deb\nasset linux-x64-tar linux x64 tar.gz dynlex-linux-x64.tar.gz\nasset linux-arm64-deb linux arm64 deb dynlex-linux-arm64.deb\nasset linux-arm64-tar linux arm64 tar.gz dynlex-linux-arm64.tar.gz\nasset windows-x64-msi windows x64 msi dynlex-windows-x64.msi\nasset windows-arm64-msi windows arm64 msi dynlex-windows-arm64.msi\nasset macos-universal-pkg macos arm64,x64 pkg dynlex-macos-universal.pkg\n-->\n"
set assets to a JSON array containing [
    a JSON object containing [JSON text "name" is "release-manifest.txt", JSON text "browser_download_url" is "https://example.org/manifest"],
    a JSON object containing [JSON text "name" is "dynlex-linux-x64.deb", JSON text "browser_download_url" is "https://example.org/linux"],
    a JSON object containing [JSON text "name" is "dynlex-linux-x64.tar.gz", JSON text "browser_download_url" is "https://example.org/linux-tar"],
    a JSON object containing [JSON text "name" is "dynlex-linux-arm64.deb", JSON text "browser_download_url" is "https://example.org/linux-arm"],
    a JSON object containing [JSON text "name" is "dynlex-linux-arm64.tar.gz", JSON text "browser_download_url" is "https://example.org/linux-arm-tar"],
    a JSON object containing [JSON text "name" is "dynlex-windows-x64.msi", JSON text "browser_download_url" is "https://example.org/windows-x64"],
    a JSON object containing [JSON text "name" is "dynlex-windows-arm64.msi", JSON text "browser_download_url" is "https://example.org/windows"],
    a JSON object containing [JSON text "name" is "dynlex-macos-universal.pkg", JSON text "browser_download_url" is "https://example.org/macos"],
    a JSON object containing [JSON text "name" is "dynlex-obsolete.msi", JSON text "browser_download_url" is "https://example.org/obsolete"]
]
set document to a JSON object containing [JSON text "tag_name" is "v1.2.3", JSON text "body" is body, JSON child "assets" is assets]
set release to the website release described by document
require condition (release's error's length = 0) reporting "A valid release was rejected"
require condition (release's count = 7) reporting "The manifest lost packages or included an obsolete asset"
set platform to the website platform for "Mozilla Linux x86_64" with architecture "" and 0 touch points
set package to the primary website package in release for platform
require condition (package's url = "https://example.org/linux") reporting "Linux selected the wrong download"
set platform to the website platform for "Mozilla Linux aarch64" with architecture "" and 0 touch points
require condition ((the primary website package in release for platform)'s identifier = "linux-arm64-deb") reporting "ARM Linux selected the wrong download"
set platform to the website platform for "Mozilla Windows NT 10.0; x64" with architecture "" and 0 touch points
require condition ((the primary website package in release for platform)'s url = "https://example.org/windows-x64") reporting "Windows x64 selected the wrong download"
set platform to the website platform for "Mozilla Windows NT 10.0" with architecture "arm64" and 0 touch points
set package to the primary website package in release for platform
require condition (package's identifier = "windows-arm64-msi") reporting "Client architecture hints were ignored"
set platform to the website platform for "Mozilla Macintosh Intel Mac OS X" with architecture "" and 0 touch points
require condition ((the primary website package in release for platform)'s identifier = "macos-universal-pkg") reporting "A Mac with undisclosed architecture lost the universal package"
set platform to the website platform for "Mozilla Macintosh" with architecture "arm64" and 5 touch points
require condition (platform's supported = false) reporting "An iPad was offered a desktop package"
free release

set value to the JSON member named "body" in document
set value's text to "Release notes without a manifest."
set release to the website release described by document
require condition (release's error's length > 0) reporting "A release without an embedded manifest was accepted"
free release
set value's text to body + body
set release to the website release described by document
require condition (release's error's length > 0) reporting "Duplicate embedded manifests were accepted"
free release
set value's text to body
set asset to the JSON value at index 2 in assets
set name to the JSON member named "name" in asset
set name's text to "dynlex-linux-x64.deb"
set release to the website release described by document
require condition (release's error = "A release package has duplicate assets or an invalid URL") reporting "Duplicate release assets were accepted"
free release
set name's text to "wrong-name.msi"
set release to the website release described by document
require condition (release's error's length > 0) reporting "A missing release package was accepted"
free release
set malformed to ["schema", "schema 2", "schema 1\nschema 1", "schema 1\nrepository unexpected/repository\nasset test linux x64 deb test.deb", "schema 1\nrepository OpenAEC-Foundation/dynlex\nasset test linux x64,x64 deb test.deb", "schema 1\nrepository OpenAEC-Foundation/dynlex\nasset test linux x64 deb test.deb\nasset test linux x64 deb second.deb", "schema 1\nrepository OpenAEC-Foundation/dynlex\nasset test linux x64 deb test.deb\nasset duplicate linux x64 deb test.deb"]
set index to 0
loop while index < the length of malformed:
    set invalid to storage for one slot initialized with (a new website release)
    read release manifest (the string form of (the item at index in malformed)) into invalid
    require condition (invalid's error's length > 0) reporting "A malformed manifest was accepted"
    free invalid
    increment index
free document
print line "Release manifests, platform hints and package selection work."
