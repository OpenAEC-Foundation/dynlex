import ../../../site/games/river/character_art.dl
import lib/check.dl

set start to the website wolf tongue at 0.0
set middle to the website wolf tongue at 0.5
set end to the website wolf tongue at 1.0
require condition ((start's extension = 0.0) and (end's extension = 0.0)) reporting "A tongue remained extended outside its lick"
require condition ((the absolute value of (start's x - 62.152)) < 0.00001) reporting "The lick did not start at the right side of the mouth"
require condition ((the absolute value of (end's x - 30.801)) < 0.00001) reporting "The lick did not end at the left side of the mouth"
require condition ((middle's extension = 1.0) and ((the absolute value of (middle's angle - 82.451)) < 0.00001)) reporting "The lick did not follow the original mouth path"
print line "The wolf's tongue follows its original mouth path and extends only during the lick."
