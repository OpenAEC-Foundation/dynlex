import site/games/farm/save_program.dl
import lib/filesystem.dl

to get [the Farm plan test JSON for] {website farm plan:plan}:
    if plan's error is not empty:
        return a JSON object containing [JSON text "error" is (plan's error)]
    return the website farm plan JSON of plan

read the file at "input.farm" and set input to it
require condition (input succeeded) reporting "The Farm model test needs input.farm."
parse (input's contents) as JSON and set parsed to it
require condition (parsed succeeded) reporting "The Farm model test input is invalid."
set cases to parsed's value
set results to a new JSON value of kind the JSON array kind
set index to 0
loop while index < cases's length:
    set entry to the JSON value at index index in cases
    set plan to the website farm plan from (the JSON text named "stdout" in entry) dropping 2 source lines
    add (the Farm plan test JSON for plan) to the JSON array results
    free website farm plan the address of plan
    increment index
print line the compact JSON form of results
free results
free cases
