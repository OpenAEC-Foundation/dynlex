import ../../site/account/profiles.dl
import ../../site/games/river/controller.dl
import site_fixture.dl

function [check website profile case] {integer:scenario}:
    globals:
        website fixture
    execute:
        @intrinsic("call", "host", "profile_fixture", nothing, scenario)
        set instance to an instance of website fixture
        set view to a new UI view
        set view's instance to the address of instance
        set state to a new website state
        set state's services to the browser UI service provider
        set state's view to the address of view
        set instance's state to (the address of state) as a pointer
        prepare website fixture editors in (the address of state)
        initialize the website river in (the address of state)
        open website progress in (the address of state)
        require condition (state's progress's status = 1) reporting "The profile fixture could not open its guest save"
        set before to the compact JSON form of (state's progress's document)
        if scenario = 0:
            set loaded to load website account profile (the string form of "user:bob") in (the address of state)
            require condition (loaded's error's length = 0) reporting "A stored account could not be read"
            require condition (commit website account profile (the string form of "user:bob") containing (loaded's document) in (the address of state)) reporting "An account profile could not be selected"
            require condition (state's progress's profile = "user:bob") reporting "The profile metadata did not select Bob"
            set loaded to load website account profile (the string form of "guest") in (the address of state)
            require condition (commit website account profile (the string form of "guest") containing (loaded's document) in (the address of state)) reporting "The guest profile could not be restored"
            require condition ((the compact JSON form of (state's progress's document)) = before) reporting "Switching accounts changed the guest snapshot"
            @intrinsic("call", "host", "profile_fixture", nothing, 1)
            require condition ((commit website account profile (the string form of "user:charlie") containing (empty website progress) in (the address of state)) = false) reporting "A failed metadata write committed a profile switch"
            require condition ((state's progress's profile = "guest") and ((the compact JSON form of (state's progress's document)) = before)) reporting "A failed switch replaced the active profile"
            require condition ((commit website account profile (the string form of "user:bob") containing (empty website progress) in (the address of state)) = false) reporting "A blocked store accepted a later account write"
        else:
            @intrinsic("call", "host", "profile_fixture", nothing, 3)
            set loaded to load website account profile (the string form of "user:broken") in (the address of state)
            require condition ((loaded's error's length > 0) and (loaded's document = (0 as a pointer to JSON value))) reporting "A corrupt account profile was replaced with empty progress"
        require condition (state's progress's status = 2) reporting "A failed account read or switch did not block writes"
        free state's river's coding
        free state's progress's document
        set pending to state's requests
        loop while pending != @intrinsic("construct", a pointer to website request):
            set next to pending's next
            deallocate pending
            set pending to next
        release website fixture editors in (the address of state)
        close (the address of instance)

check website profile case 0
check website profile case 2
print line "Profile switching commits data before metadata, keeps guests separate, and preserves active or corrupt saves on failure."
