import ../../site/programs/controller.dl
import site_fixture.dl

set begun, ended and result to 0

function [record program start] {integer:index} in {a pointer to website state:state}:
    globals:
        begun
    execute:
        increment begun

function [record program finish] {integer:index} in {a pointer to website state:state}:
    globals:
        ended
        result
    execute:
        increment ended
        set program to state's programs + index
        set result to program's result
        if result = 1:
            set program's phase to 3

set instance to an instance of website fixture
set view to a new UI view
set view's instance to the address of instance
set state to a new website state
set state's services to the browser UI service provider
set state's view to the address of view
set instance's state to (the address of state) as a pointer
prepare website fixture editors in (the address of state)
set index to the website program for source "River source"
set program to state's programs + index
set program's started to (the function named "record program start $ in $") as a pointer
set program's finished to (the function named "record program finish $ in $") as a pointer
set source to (the UI value for (the control labeled "River source" in (the address of instance)) in (the address of instance))'s text
run website program index in (the address of state)
require condition ((begun = 1) and (program's source = source)) reporting "Run did not notify its owner or retain its source snapshot"
set reply to a JSON object containing [JSON number "status" is 0, JSON number "artifact" is 42, JSON number "milliseconds" is 0.5]
receive website compilation reply for index in (the address of state)
free reply
set reply to a JSON object containing [JSON number "invocation" is 1, JSON text "output" is "RIVER|COMMAND|CROSS\n"]
receive website program output reply in (the address of state)
free reply
require condition ((the UI value for (the control labeled "River diagnostics" in (the address of instance)) in (the address of instance))'s text = "") reporting "A protocol program displayed its raw output"
set reply to a JSON object containing [JSON number "milliseconds" is 1]
receive website execution reply for index in (the address of state)
free reply
require condition ((ended = 1) and ((result = 1) and (program's phase = 3))) reporting "A completed program could not enter its presentation phase"
stop website program index in (the address of state)
require condition ((ended = 2) and ((result = 4) and (program's phase = 0))) reporting "Stop did not stop post-execution presentation"
run website program index in (the address of state)
set reply to a JSON object containing [JSON number "status" is 1, JSON number "milliseconds" is 0.2, JSON child "diagnostics" is (a JSON array containing [a JSON object containing [JSON text "file" is "/workspace/river.dl", JSON number "line" is 4, JSON number "column" is 3, JSON text "message" is "Bad plan"], a JSON object containing [JSON text "file" is "/stdlib/river_challenge.dl", JSON number "line" is 22, JSON number "column" is 1, JSON text "message" is "Imported diagnostic"]])]
receive website compilation reply for index in (the address of state)
free reply
require condition ((ended = 3) and (result = 2)) reporting "A compilation failure did not notify its owner"
require condition ((the UI value for (the control labeled "River diagnostics" in (the address of instance)) in (the address of instance))'s text contains ":2:3: Bad plan") reporting "A hidden program prefix shifted visible diagnostic lines"
require condition ((the UI value for (the control labeled "River diagnostics" in (the address of instance)) in (the address of instance))'s text contains "/stdlib/river_challenge.dl:22:1: Imported diagnostic") reporting "A hidden prefix shifted an imported-file diagnostic"
run website program index in (the address of state)
stop website program index in (the address of state)
require condition ((ended = 4) and (result = 4)) reporting "Stopping compilation did not notify its owner"
run website program index in (the address of state)
fail website program index in (the address of state)
require condition ((begun = 4) and ((ended = 5) and (result = 3))) reporting "A platform failure did not notify its owner"
set pending to state's requests
loop while pending != @intrinsic("construct", a pointer to website request):
    set next to pending's next
    deallocate pending
    set pending to next
release website fixture editors in (the address of state)
close the address of instance
print line "Program owners receive start, success, compile failure, platform failure and Stop with traced prefixed sources."
