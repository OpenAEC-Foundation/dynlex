import ../../site/editor/language.dl
import site_fixture.dl
import ../../site/packages/dynlex-ui/ui/document_layout.dl

set instance to an instance of website fixture
set window to the address of instance
show page "/ide/index.html" in window
set view to a new UI view
set view's instance to window
set view's layout to a document UI layout for (window's description) inside (window's description)
set state to a new website state
set state's services to the browser UI service provider
set state's view to the address of view
set state's route to "/ide/index.html"
set instance's state to (the address of state) as a pointer
set source to "import lib/std.dl\nprint line \"😀\""
set the text of "IDE source" in window to source
open website source editors in (the address of state)
set language to state's language's client
advance website language analysis in (the address of state)
require condition (language's phase = 1) reporting "Language analysis did not install the source project"
set response to a new JSON-RPC null
receive website language reply response at step 1 in (the address of state)
free response
set provider to a JSON object containing [JSON child "legend" is (a JSON object containing [JSON child "tokenTypes" is (a JSON array containing [a new JSON-RPC text for "string"])])]
set capabilities to a JSON object containing [JSON child "semanticTokensProvider" is provider]
set response to a JSON array containing [a JSON object containing [JSON number "id" is 2, JSON child "result" is (a JSON object containing [JSON child "capabilities" is capabilities])]]
receive website language reply response at step 2 in (the address of state)
free response
set response to a new JSON-RPC array
receive website language reply response at step 3 in (the address of state)
free response
require condition (language's snapshot = source) reporting "The opened document lost the editor source"
set diagnostics to a JSON object containing [JSON text "uri" is (language's uri), JSON child "diagnostics" is (a new JSON-RPC array)]
set response to a JSON array containing [a JSON object containing [JSON text "method" is "textDocument/publishDiagnostics", JSON child "params" is diagnostics]]
receive website language reply response at step 4 in (the address of state)
free response
require condition (language's document's diagnostic revision != language's document's revision) reporting "A partial project report was published before its analysis barrier"
set tokens to a JSON array containing [a new JSON-RPC integer for 1, a new JSON-RPC integer for 11, a new JSON-RPC integer for 4, a new JSON-RPC integer for 0, a new JSON-RPC integer for 0]
set response to a JSON array containing [a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is tokens])]]
receive website language reply response at step 6 in (the address of state)
free response
set entry to the UI value for (the control labeled "IDE source" in window) in window
require condition ((the UI value for (the control labeled "IDE diagnostics" in window) in window)'s text = "No problems found.") reporting "A successful analysis did not clear diagnostics"
require condition ((entry's colors' end - entry's colors' start) = 6) reporting "UTF-16 semantic tokens did not convert to UTF-8 bytes"
set the text of "IDE source" in window to "newer text"
synchronize UI source workspace (state's language) at 0.5 seconds
set view's seconds to 1.0
advance website language analysis in (the address of state)
require condition ((language's phase = 5) and (language's version = 2)) reporting "A changed document was not synchronized with its own version"
set the text of "IDE source" in window to "newest text"
synchronize UI source workspace (state's language) at 1.0 seconds
set revision to language's document's diagnostic revision
set response to a JSON array containing [a JSON object containing [JSON text "method" is "textDocument/publishDiagnostics", JSON child "params" is (a JSON object containing [JSON text "uri" is (language's uri), JSON child "diagnostics" is (a new JSON-RPC array)])]]
receive website language reply response at step 5 in (the address of state)
free response
require condition (language's document's diagnostic revision = revision) reporting "An old analysis replaced diagnostics for newer source"
set response to a JSON array containing [a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is (a new JSON-RPC array)])]]
receive website language reply response at step 6 in (the address of state)
free response
set view's seconds to 1.3
set the text of "IDE filename" in window to "renamed.dl"
advance website language analysis in (the address of state)
require condition (language's phase = 9) reporting "Renaming a source did not close its old document"
set response to a new JSON-RPC array
receive website language reply response at step 9 in (the address of state)
free response
require condition (language's phase = 10) reporting "Renaming did not replace the source project"
set response to a new JSON-RPC null
receive website language reply response at step 10 in (the address of state)
free response
require condition ((language's uri = "file:///workspace/renamed.dl") and (language's version = 1)) reporting "The new document did not begin with its own URI and version"
set response to a new JSON-RPC array
receive website language reply response at step 4 in (the address of state)
free response
set response to a JSON array containing [a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is (a new JSON-RPC array)])]]
receive website language reply response at step 6 in (the address of state)
free response
# The very same connection now analyzes the actual River control and its imports.
show page "/index.html" in window
set the value of "Challenge views" in window to 1
set view's text focus to the control labeled "River source" in window
set the text of "River source" in window to "get the hay in the boat"
synchronize UI source workspace (state's language) at 2.0 seconds
set view's seconds to 2.3
advance website language analysis in (the address of state)
require condition (language's phase = 9) reporting "The River editor did not join the shared language lifecycle"
set response to a new JSON-RPC array
receive website language reply response at step 9 in (the address of state)
free response
set response to a new JSON-RPC null
receive website language reply response at step 10 in (the address of state)
free response
require condition (language's snapshot = "import lib/river_challenge.dl\n\nget the hay in the boat") reporting "River analysis omitted its runtime vocabulary"
set diagnostic to a JSON object containing [JSON text "message" is "Example problem", JSON child "range" is (an LSP range from line 2 and character 0 to line 2 and character 3)]
set response to a JSON array containing [a JSON object containing [JSON text "method" is "textDocument/publishDiagnostics", JSON child "params" is (a JSON object containing [JSON text "uri" is (language's uri), JSON child "diagnostics" is (a JSON array containing [diagnostic])])]]
receive website language reply response at step 4 in (the address of state)
free response
set tokens to a JSON array containing [a new JSON-RPC integer for 2, a new JSON-RPC integer for 0, a new JSON-RPC integer for 3, a new JSON-RPC integer for 0, a new JSON-RPC integer for 0]
set response to a JSON array containing [a JSON object containing [JSON number "id" is 6, JSON child "result" is (a JSON object containing [JSON child "data" is tokens])]]
receive website language reply response at step 6 in (the address of state)
free response
set river to the UI value for (the control labeled "River source" in window) in window
require condition ((the UI value for (the control labeled "River analysis diagnostics" in window) in window)'s text = "river.dl:1:1: Example problem\n") reporting "River diagnostics did not use shared visible-source coordinates"
require condition ((river's colors' start = 0) and (river's colors' end = 3)) reporting "River did not receive shared source colors"
require condition ((the UI value for (the control labeled "River diagnostics" in window) in window)'s text = "") reporting "Language analysis overwrote the game's execution diagnostics"
set state's shader editor's description to the custom website shader
show page "/ide/index.html" in window
set the value of "IDE modes" in window to 1
set the value of "IDE result" in window to 1
advance website language analysis in (the address of state)
require condition (language's phase = 11) reporting "Changing targets did not reset the language session"
set response to a new JSON-RPC null
receive website language reply response at step 11 in (the address of state)
free response
set response to a new JSON-RPC null
receive website language reply response at step 1 in (the address of state)
free response
free UI source workspace (state's language)
set pending to state's requests
loop while pending != @intrinsic("construct", a pointer to website request):
    set next to pending's next
    deallocate pending
    set pending to next
release UI layout (view's layout)
close window
print line "Studio and River share source projects, Unicode colors, mapped diagnostics and stale-result isolation."
