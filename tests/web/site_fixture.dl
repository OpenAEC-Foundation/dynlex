# Controller tests use the production editor/program declarations without loading
# unrelated documentation pages. Application composition stays in application.dl.
import ../../site/pages/home.dl
import ../../site/pages/ide.dl

document website fixture:
    home page
    IDE page


import ../../site/packages/dynlex-ui/platform/browser/shaders.dl
import ../../site/packages/dynlex-ui/platform/browser/requests.dl

to get [a website shader test driver]:
    set driver to a new UI driver
    set driver's shader operations to the browser UI shader operations
    return driver
