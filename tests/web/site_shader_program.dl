import ../../site/shaders/program.dl

to get test shader stage {C string:name} with {integer:binding}:
    set inputs to a new JSON-RPC array
    if name = "vertex":
        add (a JSON object containing [JSON text "name" is "Position", JSON number "location" is 0, JSON text "format" is "float32x4"]) to the JSON array inputs
    return a JSON object containing [
        JSON text "webgpu" is (the string form of name), JSON text "webgl" is (the string form of name),
        JSON child "vertexInputs" is inputs,
        JSON child "resources" is (a new JSON-RPC array), JSON child "glslBindings" is (a new JSON-RPC array), JSON child "glslUniforms" is (a new JSON-RPC array),
        JSON child "uniforms" is (a JSON array containing [
            a JSON object containing [JSON text "name" is "time", JSON number "group" is 0, JSON number "binding" is 0, JSON child "type" is (a JSON object containing [JSON text "scalar" is "float32", JSON number "rows" is 1, JSON number "columns" is 1])],
            a JSON object containing [JSON text "name" is "width", JSON number "group" is 0, JSON number "binding" is binding, JSON child "type" is (a JSON object containing [JSON text "scalar" is "float32", JSON number "rows" is 1, JSON number "columns" is 1])]
        ])
    ]

set stages to a JSON object containing [JSON child "fragment" is (test shader stage "fragment" with 2), JSON child "vertex" is (test shader stage "vertex" with 2)]
set linked to the linkage of event horizon using stages stored as "source"
require condition (linked succeeded) reporting "The fullscreen shader did not link"
set program to linked's program
require condition (UI shader program program uses input "time") reporting "The linked program lost its time input"
require condition ((UI shader program program uses input "unknown") = false) reporting "The linked program acquired an unknown input"
set passes to the JSON member named "passes" in program
require condition (passes's length = 1) reporting "A fullscreen shader gained a geometry pass"
set first to the JSON value at index 0 in passes
require condition ((the JSON member named "vertex" in first) is JSON null) reporting "A fullscreen shader gained a vertex stage"
require condition ((the JSON text named "kind" in (the JSON member named "webgpu" in (the JSON member named "fragment" in first))) = "source") reporting "Inline shader code became a URL"
set draws to the JSON member named "draws" in first
require condition (((the JSON member named "vertexBuffers" in first)'s length = 0) and ((the JSON number named "count" in (the JSON value at index 0 in draws)) = 3.0)) reporting "The fullscreen draw was not explicit."
require condition ((first has JSON member named "geometry") = false) reporting "The obsolete geometry descriptor survived."
free program
set linked to the linkage of endless terrain using stages stored as "url"
require condition (linked succeeded) reporting "The terrain shader did not link"
set program to linked's program
set first to the JSON value at index 0 in (the JSON member named "passes" in program)
require condition ((the JSON member named "depth" in first) is not JSON null) reporting "Terrain lost depth testing"
require condition (the JSON boolean named "depthWrite" in (the JSON value at index 0 in (the JSON member named "pipelines" in first))) reporting "Terrain stopped writing depth"
require condition ((the JSON member named "uniforms" in first)'s length = 2) reporting "Shared vertex/fragment uniform bindings were duplicated"
require condition ((the JSON text named "kind" in (the JSON member named "webgl" in (the JSON member named "vertex" in first))) = "url") reporting "A packaged shader lost its URL source"
set buffers to the JSON member named "vertexBuffers" in first
set layout to the JSON value at index 0 in buffers
require condition (((the JSON number named "arrayStride" in layout) = 16.0) and ((the JSON text named "stepMode" in layout) = "vertex")) reporting "Terrain lost its explicit vertex layout."
require condition (((the JSON member named "source" in layout) is JSON null) and ((the JSON member named "draws" in first)'s length = 0)) reporting "Dynamic terrain acquired an invented vertex source or draw count."
free program
set linked to the linkage of nano choreography using stages stored as "source"
require condition (linked succeeded) reporting "The point-cloud shader did not link"
set program to linked's program
set passes to the JSON member named "passes" in program
require condition (passes's length = 2) reporting "The point-cloud shader lost its background pass"
set second to the JSON value at index 1 in passes
set blend to the JSON member named "blend" in (the JSON value at index 0 in (the JSON member named "pipelines" in second))
require condition ((the JSON text named "dstFactor" in (the JSON member named "color" in blend)) = "one") reporting "The point cloud lost its additive blend"
require condition ((the JSON text named "load" in (the JSON member named "color" in second)) = "load") reporting "The point cloud stopped preserving its background"
require condition ((the JSON number named "renderPass" in second) = 1.0) reporting "The point-cloud pass lost its shader layer"
set buffer to the JSON value at index 0 in (the JSON member named "vertexBuffers" in second)
require condition ((the JSON text named "source" in buffer) = "assets/shaders/geometry/vitruvian-points.f32") reporting "A static vertex source was not preserved."
require condition ((the JSON member named "indices" in second) is JSON null) reporting "A point cloud acquired an index source."
free program
set vertex to the JSON member named "vertex" in stages
add (a JSON object containing [JSON text "name" is "Normal", JSON number "location" is 1, JSON text "format" is "float32x3"]) to the JSON array (the JSON member named "vertexInputs" in vertex)
set linked to the linkage of endless terrain using stages stored as "source"
require condition (linked failed) reporting "A preview shader input had no provider but linked anyway."
free stages
set stages to a JSON object containing [JSON child "fragment" is (test shader stage "fragment" with 2), JSON child "vertex" is (test shader stage "vertex" with 3)]
set linked to the linkage of endless terrain using stages stored as "source"
require condition (linked failed) reporting "A uniform acquired two bindings without a link error"
require condition (linked's error != "") reporting "A failed shader linkage lost its error"
free stages
print line "Shader descriptions share source linking, reflected bindings and geometry passes."

set unsupported to a JSON array containing [a JSON object containing [JSON text "name" is "camera", JSON child "type" is (a JSON object containing [JSON text "scalar" is "float32", JSON number "rows" is 4, JSON number "columns" is 4])]]
require condition ((the error supplying website shader uniforms from unsupported) != "") reporting "The preview accepted a uniform it cannot supply."
free unsupported
set unsupported to a JSON array containing [a JSON object containing [JSON text "name" is "time", JSON child "type" is (a JSON object containing [JSON text "scalar" is "float32", JSON number "rows" is 1, JSON number "columns" is 3])]]
require condition ((the error supplying website shader uniforms from unsupported) != "") reporting "The preview accepted a vector for its scalar clock."
free unsupported
