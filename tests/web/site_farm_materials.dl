# Original GLSL reference SHA-256: bf80986905647db4f126ebd46a76403b68bc0823b30aa1979da668c8d3e8533e
import ../../site/games/farm/materials.dl
import lib/check.dl

to [check Farm material] {integer:kind} [at] {vector:point} [with color] {vector:base} [normal] {vector:normal} [time] {floating-point number:time} [against] {vector:expected}:
    set actual to base
    if kind = 0:
        set actual to the website Farm cow coat on base at point
    else if kind = 1:
        set actual to the website Farm water normal from normal at point at time time
    else:
        set actual to the website Farm fogged color from base toward normal at distance (the x of point)
    require condition ((the length of (actual - expected)) < 0.0001) reporting "Farm material differs from its independent floating-point GLSL reference"

