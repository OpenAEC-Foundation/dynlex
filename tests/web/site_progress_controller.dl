import ../../site/games/river/controller.dl
import site_fixture.dl

function [check the progress fixture] {integer:scenario}:
    globals:
        website fixture
    execute:
        @intrinsic("call", "host", "progress_fixture", nothing, scenario)
        set instance to an instance of website fixture
        set view to a new UI view
        set view's instance to the address of instance
        set state to a new website state
        set state's services to the browser UI service provider
        set state's view to the address of view
        set instance's state to (the address of state) as a pointer
        prepare website fixture editors in (the address of state)
        initialize the website river in (the address of state)
        open website progress in (the address of state)
        if scenario = 0:
            require condition ((state's progress's status = 1) and (state's progress's profile = "user:alice")) reporting "An existing account profile did not open"
            require condition ((the UI value for (the control labeled "River source" in (the address of instance)) in (the address of instance))'s text = "take the sheep") reporting "Saved River code was not restored"
            require condition ((the website coding count of "passenger" in (state's river's coding)) = 0) reporting "A version-4 upgrade did not reset coding goals"
            require condition ((state's river's solved) and ((the website coding count of "rescue" in (state's river's coding)) = 0)) reporting "Solved state was incorrectly substituted for goal progress"
            set the text of "River source" in (the address of instance) to "cross the river"
            ignore record website coding goal "passenger" using key "loaded" in (state's river's coding)
            ignore record website coding goal "passenger" using key "loaded" in (state's river's coding)
            set editor to the UI source editor labeled "River source" in (state's language)
            synchronize UI source workspace (state's language) at 1.0 seconds
            set helper to a UI source document named "helper.dl" at "file:///lib/helper.dl" containing "An imported definition" in (editor's document's project)
            visit UI source document helper selecting 0 through 1 in editor in (the address of view)
            save website river progress in (the address of state)
            require condition ((the website coding count of "passenger" in (state's river's coding)) = 1) reporting "A repeated event was counted twice"
            require condition ((the value of "Game resume" in (the address of instance)) = 0) reporting "A saved game did not offer Continue"
            set first to the compact JSON form of (state's progress's document)
            save website river progress in (the address of state)
            require condition ((the compact JSON form of (state's progress's document)) = first) reporting "An unchanged save received a new revision"
            require condition (editor's document = helper) reporting "Saving the main program navigated away from an imported file."
            require condition (go back in UI source editor editor in (the address of view)) reporting "The saved program lost its navigation history."
            @intrinsic("call", "host", "progress_fixture", nothing, 1)
            set the text of "River source" in (the address of instance) to "new unsaved code"
            save website river progress in (the address of state)
            require condition ((state's progress's status = 2) and ((the compact JSON form of (state's progress's document)) = first)) reporting "A failed write replaced the committed snapshot"
            save website river progress in (the address of state)
        else if scenario = 2:
            require condition (state's progress's status = 2) reporting "A corrupt stored save did not block writes"
            set the text of "River source" in (the address of instance) to "do not overwrite damaged data"
            save website river progress in (the address of state)
        else:
            require condition (state's progress's status = 1) reporting "A current save could not be opened"
            require condition ((the website coding count of "passenger" in (state's river's coding)) = 5) reporting "Loading inferred a count from seen keys"
            require condition ((record website coding goal "passenger" using key "loaded" in (state's river's coding)) = false) reporting "A previously seen goal was counted again"
            require condition ((the website coding count of "rescue" in (state's river's coding)) = 0) reporting "Solved state was substituted for rescue progress"
            ignore record website coding goal "deliveries" using key "WOLF" in (state's river's coding)
            ignore record website coding goal "rescue" using key "solved" in (state's river's coding)
            save website river progress in (the address of state)
        if scenario != 3:
            require condition ((the UI value for (the control labeled "Game save status" in (the address of instance)) in (the address of instance))'s text = "An error occurred. Check the log.") reporting "A storage error exposed backend details or disappeared"
        free state's river's coding
        free state's progress's document
        set pending to state's requests
        loop while pending != @intrinsic("construct", a pointer to website request):
            set next to pending's next
            deallocate pending
            set pending to next
        release website fixture editors in (the address of state)
        close (the address of instance)

check the progress fixture 0
check the progress fixture 2
check the progress fixture 3
print line "All stored profiles upgrade, River resumes, goals stay distinct, and failed or corrupt saves remain intact."
