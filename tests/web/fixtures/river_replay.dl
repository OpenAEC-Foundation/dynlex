import ../../../site/games/river/model.dl
import ../../../site/games/river/trace.dl
import lib/filesystem.dl

read the file at "/input.trace" and set input to it
require condition (input succeeded) reporting "The replay needs its trace file"
set trace to website river trace from (input's contents) dropping 2 source lines
require condition (trace's error's length = 0) reporting (the data of (trace's error))
require condition (trace's outcome = 1) reporting "The actual river solution did not report success"
set scene to the initial website river scene
set commands, branches and crossings to 0
set instruction to trace's first
loop while instruction != @intrinsic("construct", a pointer to website river instruction):
    require condition (instruction's source's known) reporting "A real program step lost its source range"
    if instruction's kind = 0:
        increment branches
    else:
        increment commands
    set event to instruction's first
    loop while event != @intrinsic("construct", a pointer to website river event):
        set next to the website river scene after (the value at event) from scene
        require condition (next's error's length = 0) reporting (the data of (next's error))
        set scene to next's scene
        if event's kind = 3:
            increment crossings
        set event to event's next
    set instruction to instruction's next
require condition (scene's complete) reporting "The actual solution did not replay to a completed scene"
require condition ((commands = 17) and (crossings = 7)) reporting "The actual solution lost or duplicated a game command"
require condition (branches > 0) reporting "The traced program lost its condition step"
free website river trace the address of trace
print line "The browser compiler's traced river solution replays in DynLex with source ranges, functions and conditions."
