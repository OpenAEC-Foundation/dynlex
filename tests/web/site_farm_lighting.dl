# Original GLSL reference SHA-256: e3b460f585bb7a63ba8994063c4e08e68570dd74e690d1abf1fe85c434a2ce03
import ../../site/games/farm/lighting.dl
import lib/check.dl

to [check Farm sky along] {vector:direction} [against] {vector:expected}:
    set original to direction
    set actual to the website Farm sky radiance along direction
    require condition ((the length of (direction - original)) = 0.0) reporting "Reading sky radiance must preserve the caller's direction"
    require condition ((the length of (actual - expected)) < 0.0001) reporting "Farm sky differs from the original floating-point GLSL reference"
    set mirror to the website Farm sky reflection along direction at roughness 0.0 using 128 samples
    require condition ((the length of (direction - original)) = 0.0) reporting "Reading mirror radiance must preserve the caller's direction"
    require condition ((the length of (actual - mirror)) < 0.00001) reporting "A mirror environment level must retain the original sky"

check Farm sky along (a new vector with x 1.0, y 0.0 and z 0.0) against (a new vector with x 0.6210156679153442, y 0.6481640338897705 and z 0.4989648461341858)
check Farm sky along (a new vector with x -1.0, y 0.0 and z 0.0) against (a new vector with x 0.6210156679153442, y 0.6481640338897705 and z 0.4989648461341858)
check Farm sky along (a new vector with x 0.0, y 1.0 and z 0.0) against (a new vector with x 0.5600000023841858, y 0.7599999904632568 and z 0.8999999761581421)
check Farm sky along (a new vector with x 0.0, y -1.0 and z 0.0) against (a new vector with x 0.2800000011920929, y 0.3799999952316284 and z 0.25)
check Farm sky along (a new vector with x 0.0, y 0.0 and z 1.0) against (a new vector with x 0.6210156679153442, y 0.6481640338897705 and z 0.4989648461341858)
check Farm sky along (a new vector with x 0.0, y 0.0 and z -1.0) against (a new vector with x 0.6210156679153442, y 0.6481640338897705 and z 0.4989648461341858)
check Farm sky along (a new vector with x 1.0, y 1.0 and z 1.0) against (a new vector with x 0.5434361696243286, y 0.7364110350608826 and z 0.8584548830986023)
check Farm sky along (a new vector with x -0.5, y 0.9 and z 0.2) against (a new vector with x 5.560001373291016, y 5.060000896453857 and z 3.799999237060547)
check Farm sky along (a new vector with x -0.5, y 0.9 and z 0.25) against (a new vector with x 5.5595879554748535, y 5.0596442222595215 and z 3.7997586727142334)
check Farm sky along (a new vector with x -0.65, y 0.9 and z 0.2) against (a new vector with x 3.6679229736328125, y 3.432807207107544 and z 2.7025814056396484)
check Farm sky along (a new vector with x -0.45, y 0.9 and z 0.2) against (a new vector with x 5.560000419616699, y 5.060000419616699 and z 3.799999713897705)
check Farm sky along (a new vector with x 0.0, y 0.1 and z 1.0) against (a new vector with x 0.4905656576156616, y 0.5619837045669556 and z 0.4494558870792389)
check Farm sky along (a new vector with x 0.0, y 0.3 and z 1.0) against (a new vector with x 0.4485092759132385, y 0.5831932425498962 and z 0.5700923800468445)
check Farm sky along (a new vector with x 0.0, y -0.1 and z 1.0) against (a new vector with x 0.45862290263175964, y 0.5186328291893005 and z 0.3753030300140381)

set up to a new vector with x 0.0, y 1.0 and z 0.0
set filtered to the website Farm sky reflection along up at roughness 0.65 using 128 samples
require condition (((the x of filtered) > 0.0) and (((the y of filtered) > 0.0) and ((the z of filtered) > 0.0))) reporting "Filtered sky must retain positive radiance"
require condition ((the length of (filtered - (the website Farm sky radiance along up))) > 0.01) reporting "A rough reflection must convolve the environment"
set direction to a new vector with x 2.0, y 3.0 and z 4.0
set filtered to the website Farm sky reflection along direction at roughness 0.65 using 128 samples
require condition (((the x of direction) = 2.0) and (((the y of direction) = 3.0) and ((the z of direction) = 4.0))) reporting "Reading filtered radiance must preserve the caller's direction"
print line "Farm sky preserves the original horizon, hemisphere and HDR sun; mirror and rough reflection levels share the DynLex sampler."
