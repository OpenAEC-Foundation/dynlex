import ../../site/games/farm/materials.dl
import lib/shader.dl

set query to the shader uniform named "query" at binding 0 as @intrinsic("vector", 4)
set level to the shader uniform named "level" at binding 1 as a 32 bit floating-point number
set reflection to the shader cube image named "reflection" at binding 2
set pixel to the shader sampler named "pixel" at binding 3
set material to the shader uniform named "normal_time" at binding 4 as @intrinsic("vector", 4)
set albedo to the shader uniform named "albedo" at binding 5 as @intrinsic("vector", 4)
set direction to a new vector with x (the element at 0 in query), y (the element at 1 in query) and z (the element at 2 in query)
set color to the website Farm sky radiance along direction
set normal to a new vector with x (the element at 0 in material), y (the element at 1 in material) and z (the element at 2 in material)
set base to a new vector with x (the element at 0 in albedo), y (the element at 1 in albedo) and z (the element at 2 in albedo)
if level = -2.0:
    set color to the website Farm cow coat on base at direction
if level = -3.0:
    set color to the website Farm water normal from normal at direction at time (the element at 3 in material)
if level = -4.0:
    set color to the website Farm fogged color from base toward normal at distance (the x of direction)
if level >= 0.0:
    set sample to the sample from reflection using pixel at direction with level level
    set color to a new vector with x (the element at 0 in sample), y (the element at 1 in sample) and z (the element at 2 in sample)
if level <= -2.0:
    set color to color * 0.5 + 0.5
set color to color * (the element at 3 in query)
set the fragment color with a red channel of (the x of color), a green channel of (the y of color), a blue channel of (the z of color) and an alpha channel of 1.0
