import ../../site/games/farm/interface.dl

set instance to an instance of farm challenge
set context to the address of instance
set fields to ["Farm flags", "Farm flag color", "Farm areas", "Farm people", "Farm role", "Farm action", "Farm supply", "Farm goal"]
set index to 0
loop while index < the length of fields:
    set field to the control labeled (the item at index in fields) in context
    require condition (field's kind = 34) reporting "A Farm collection was not declared as a choice field"
    require condition ((the UI element field is enabled in context) = false) reporting "A Farm collection started with invented data"
    increment index

set roles to a sequence copying [a UI option named "lumberjack" displaying "Lumberjack" enabled true, a UI option named "gardener" displaying "Gardener" enabled true]
set the choices of "Farm role" in context to roles choosing "lumberjack"
set the choices of "Farm people" in context to (a sequence copying [a UI option named "player" displaying "You · farmer" enabled true, a UI option named "worker-1" displaying "Ada · Lumberjack" enabled true]) choosing "worker-1"
require condition ((the selected choice of "Farm role" in context) = "lumberjack") reporting "The Farm role selector discarded its model identity"
require condition ((the selected choice of "Farm people" in context) = "worker-1") reporting "The Farm worker selector discarded its actor identity"
require condition (the UI element (the control labeled "Farm role" in context) is enabled in context) reporting "Supplying Farm roles did not enable their field"
require condition ((the value of "Farm speed" in context) = 0) reporting "Farm pace did not start at one times speed"
set the value of "Farm speed" in context to 1
require condition ((the selected choice of "Farm speed" in context) = "2×") reporting "The Farm pace selector lost its static data"

require condition ((the control labeled "Farm scene" in context)'s kind = 20) reporting "The Farm world is not a programmable shared surface"
require condition ((the control labeled "Farm source" in context)'s kind = 44) reporting "Farm roles did not use the shared source editor"
require condition ((the control labeled "Farm person controls" in context)'s kind = 49) reporting "Worker and manual controls were not declared as retained alternatives"
set actions to ["Draw area", "Cancel drawing", "Reshape area", "Rename area", "Delete area", "Deliver order", "Give this role to Ada", "Stop reading the role", "Remove role", "Do this", "Take supply", "Whole farm", "View selection"]
set index to 0
loop while index < the length of actions:
    set action to the control labeled (the item at index in actions) in context
    require condition ((action's kind = 43) and ((the length of (action's destination)) > 0)) reporting "A Farm action lost its declarative destination"
    increment index
close context
print line "Farm declarations compose a shared scene, source editor, live collection fields, worker/manual views and every management action."
