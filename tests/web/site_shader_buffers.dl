import ../../site/shaders/rendering.dl
import ../../site/packages/dynlex-ui/platform/browser/shaders.dl

to get [a buffer test uniform named] {C string:name} [at] {integer:binding}:
    return a JSON object containing [JSON text "name" is name, JSON number "group" is 0, JSON number "binding" is binding, JSON child "type" is (a JSON object containing [JSON text "scalar" is "float32", JSON number "rows" is 1, JSON number "columns" is 1])]

to get a buffer test program for {live shader:shader}:
    set stage to a JSON object containing [JSON text "webgpu" is "code", JSON text "webgl" is "code", JSON child "uniforms" is (a JSON array containing [a buffer test uniform named "time" at 0, a buffer test uniform named "render_pass" at 1, a buffer test uniform named "width" at 2, a buffer test uniform named "height" at 3]), JSON child "resources" is (a new JSON-RPC array), JSON child "glslBindings" is (a new JSON-RPC array), JSON child "glslUniforms" is (a new JSON-RPC array), JSON child "vertexInputs" is (a new JSON-RPC array)]
    set stages to a JSON object containing [JSON child "fragment" is stage, JSON child "vertex" is (a copy of JSON-RPC node stage)]
    set linked to the linkage of shader using stages stored as "source"
    free stages
    require condition (linked succeeded) reporting "A test scene failed to link."
    return linked's program

set driver to a new UI driver
set driver's shader operations to the browser UI shader operations
set view to a new UI view
set view's driver to the address of driver
set view's window to 7 as a pointer
set cloud to a new website shader view
set cloud's resource to 41 as a pointer
set cloud's geometry to nano choreography's geometry
set cloud's program to a buffer test program for nano choreography
initialize loaded website shader data in (the address of cloud) using (the address of view)
free cloud's program

set terrain to a new website shader view
set terrain's resource to 42 as a pointer
set terrain's geometry to endless terrain's geometry
set terrain's program to a buffer test program for endless terrain
initialize loaded website shader data in (the address of terrain) using (the address of view)
ignore the rendered website shader (the address of terrain) sized 390 by 220 in (the address of view)
ignore the rendered website shader (the address of terrain) sized 390 by 220 in (the address of view)
set terrain's seconds to 0.5
ignore the rendered website shader (the address of terrain) sized 390 by 220 in (the address of view)
ignore the rendered website shader (the address of terrain) sized 391 by 220 in (the address of view)
free terrain's program
print line "Shader scenes upload raw typed buffers and choose their own draw ranges."
