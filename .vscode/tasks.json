{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "./scripts/build.sh"
		},
		{
			"label": "run tests",
			"type": "shell",
			"command": "./scripts/run_tests.sh",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Build & Install Extension",
			"type": "shell",
			"command": "./scripts/build-extension.sh",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "install dependencies",
			"type": "shell",
			"command": "./scripts/install.sh",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "package",
			"type": "shell",
			"command": "./scripts/package.sh",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "install",
			"type": "shell",
			"command": "sudo dpkg -i $(ls -t build/dynlex-*.deb | head -1)",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "uninstall",
			"type": "shell",
			"command": "sudo dpkg -r dynlex",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
	]
}