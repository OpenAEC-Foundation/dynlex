import lib/shader.dl

# Mandelbrot fragment shader
# Compile with: ./build/dynlex games/mandelbrot_shader.dl --emit-spirv -o games/mandelbrot.spv

# Map fragment coordinates to complex plane
set px to the fragment x coordinate
set py to the fragment y coordinate

# Map pixel to complex plane [-2, 1] x [-1.5, 1.5]
# Assumes 800x600 viewport
set cx to px / 800.0 * 3.0 - 2.0
set cy to py / 600.0 * 3.0 - 1.5

set zx to 0.0
set zy to 0.0
set iteration to 0
set max_iterations to 100

while iteration < max_iterations and zx * zx + zy * zy < 4.0:
    set tmp to zx * zx - zy * zy + cx
    set zy to 2.0 * zx * zy + cy
    set zx to tmp
    set iteration to iteration + 1

# Color based on iteration count
set t to iteration as a float / max_iterations as a float
if iteration = max_iterations:
    set the fragment color to 0.0 0.0 0.0 1.0
else:
    set the fragment color to t 0.5 * t 1.0 - t 1.0
