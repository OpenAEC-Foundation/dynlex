# The Farm language is generated from the same static catalog as its UI.
import site/games/farm/vocabulary.dl
import lib/text.dl

class:
    patterns:
        website farm language type
    members:
        name as a C string
        members as a C string

[farm language type] {C string:name} [with] {C string:members} means: @intrinsic("construct", website farm language type, name, members)

to get [the farm language number] {integer:value}:
    set literal to the string form of value
    if value < 0:
        set literal to "@intrinsic(\"negate\", " + (the string form of (0 - value)) + ")"
    return literal

to get [the farm language constructor for] {a value:kind} [with] {an array:arguments}:
    set result to "@intrinsic(\"construct\", farm " + (the string form of kind)
    set index to 0
    loop while index < the length of arguments:
        add ", " + (the item at index in arguments) to result
        increment index
    return result + ")"

to [emit farm language name] {a value:name} [as] {string:expression}:
    print line (the string form of name) + " means: " + expression

to [emit farm language choices] {an array:entries} [of type] {C string:kind}:
    set index to 0
    loop while index < the length of entries:
        emit farm language name (the item at index in entries) as (the farm language constructor for kind with [the farm language number index])
        increment index

to get [the farm language target named] {C string:key}:
    set entries to the website farm destinations
    set cursor to 0
    loop while cursor < the length of entries:
        set entry to the item at cursor in entries
        if entry's key = key:
            return cursor
        increment cursor
    require condition false reporting "A Farm target alias names an unknown target."
    return 0

to [emit farm language command] {website farm command description:entry} [at] {integer:identifier} [as action] {boolean:action}:
    set spellings to entry's patterns split at "\n"
    set index to 0
    loop while index < the length of spellings:
        set pattern to the item at index in spellings
        set argument to the farm language number (entry's argument)
        if pattern contains ":items}":
            set argument to "items's identifier"
        else if pattern contains ":direction}":
            set argument to "direction's identifier"
        else if pattern contains ":feature}":
            set argument to "feature's identifier"
        else if pattern contains ":role}":
            set argument to "role's identifier"
        set amount to the farm language number (entry's amount)
        if pattern contains ":count}":
            set amount to "count"
        else if pattern contains ":items}":
            set amount to "items's amount"
        set target to the farm language number (entry's target)
        set area to the string form of "\"\""
        if pattern contains ":target}":
            set target to "target's identifier"
            set area to "target's area"
        set values to (the farm language number identifier) + ", " + argument + ", " + amount + ", " + target + ", " + area
        set expression to "@intrinsic(\"construct\", farm condition, " + values + ")"
        if action:
            set expression to "@intrinsic(\"discard\", @intrinsic(\"variadic call\", \"libc\", \"printf\", a farm number, 1, \"DO|%d|%d|%d|%d|%s\\n\", " + values + "))"
        print line ""
        if (action = false) and (entry's subject is empty):
            emit farm language name pattern as expression
        else:
            print line "flex function " + pattern + ":"
            print line "    replacement:"
            if entry's subject is not empty:
                set subject to the string form of ""
                if entry's subject = "target":
                    set subject to the farm language constructor for "target" with [the farm language number the website farm subject target, the string form of "\"\""]
                else:
                    require condition (entry's subject = "items") reporting "Unknown Farm command subject."
                    set subject to the farm language constructor for "item" with [the farm language number the website farm subject items, the farm language number the website farm all items]
                print line "        @intrinsic(\"set subject\", " + subject + ")"
            print line "        " + expression
        increment index
    free spellings

set header to [
    "# Generated by scripts/generate_farm_vocabulary.py from site/games/farm/vocabulary.dl.",
    "# Values describe live targets and item selections; each worker evaluates its own plan.",
    "import lib/subject.dl",
    "",
    "a farm number means: @intrinsic(\"type\", \"int\", 32)",
    "a farm text means: @intrinsic(\"type\", \"string\")",
    "",
    "in this file:",
    "    @intrinsic(\"number rule\", a farm number)",
    "",
    "to emit farm text: @intrinsic(\"discard\", @intrinsic(\"variadic call\", \"libc\", \"printf\", a farm number, 1, \"%s\\n\", text))"
]
for each line in header:
    print line line
print line ""

set types to [
    farm language type "item" with "identifier as a farm number\namount as a farm number",
    farm language type "target" with "identifier as a farm number\narea as a farm text",
    farm language type "entity kind" with "identifier as a farm number",
    farm language type "direction" with "identifier as a farm number",
    farm language type "feature" with "identifier as a farm number",
    farm language type "role" with "identifier as a farm number",
    farm language type "condition" with "identifier as a farm number\nargument as a farm number\namount as a farm number\ntarget as a farm number\narea as a farm text"
]
for each description in types:
    print line "class:\n    patterns:\n        farm " + (the string form of (description's name)) + "\n    members:"
    set members to description's members split at "\n"
    set cursor to 0
    loop while cursor < the length of members:
        print line "        " + (the item at cursor in members)
        increment cursor
    free members
    print line ""

set items to the website farm items
set index to 0
loop while index < the length of items:
    set entry to the item at index in items
    emit farm language name (entry's phrase) as (the farm language constructor for "item" with [the farm language number index, the farm language number (entry's quantity)])
    if entry's aliases is not empty:
        set spellings to entry's aliases split at "\n"
        set cursor to 0
        loop while cursor < the length of spellings:
            emit farm language name (the item at cursor in spellings) as (the farm language constructor for "item" with [the farm language number index, the farm language number the website farm all items])
            increment cursor
        free spellings
    increment index
set aliases to the website farm item aliases
for each alias in aliases:
    emit farm language name (alias's phrase) as (the farm language constructor for "item" with [the farm language number (alias's identifier), the farm language number (alias's amount)])
emit farm language name "{a farm number:count} {farm item:items}" as (the farm language constructor for "item" with [the string form of "items's identifier", the string form of "count"])
set destinations to the website farm destinations
set index to 0
loop while index < the length of destinations:
    set entry to the item at index in destinations
    if entry's literal is not empty:
        emit farm language name (entry's literal) as (the farm language constructor for "target" with [the farm language number index, the string form of "\"\""])
    if entry's kind is not empty:
        emit farm language name (entry's kind) as (the farm language constructor for "entity kind" with [the farm language number index])
    increment index
emit farm language name "the nearest {farm entity kind:kind}" as (the farm language constructor for "target" with [the string form of "kind's identifier", the string form of "\"\""])
set targets to the website farm target aliases
for each {target alias} in targets:
    emit farm language name (target alias's phrase) as (the farm language constructor for "target" with [the farm language number (the farm language target named (target alias's key)), the string form of "\"\""])
emit farm language name "{farm target:target} in [the|] area {a farm text:name}" as (the farm language constructor for "target" with [the string form of "target's identifier", the string form of "name"])
emit farm language choices (the website farm directions) of type "direction"
emit farm language choices (the website farm features) of type "feature"
emit farm language choices (the website farm roles) of type "role"
set actions to the website farm actions
set index to 0
loop while index < the length of actions:
    emit farm language command (the item at index in actions) at index as action true
    increment index
set conditions to the website farm conditions
set index to 0
loop while index < the length of conditions:
    emit farm language command (the item at index in conditions) at index as action false
    increment index
print line ""
set footer to [
    "flex section if {farm condition:condition}:",
    "    replacement:",
    "        @intrinsic(\"discard\", @intrinsic(\"variadic call\", \"libc\", \"printf\", a farm number, 1, \"IF|%d|%d|%d|%d|%s\\n\", condition's identifier, condition's argument, condition's amount, condition's target, condition's area))",
    "        @intrinsic(\"execute body\")",
    "        emit farm \"END\"",
    "",
    "flex section else:",
    "    replacement:",
    "        emit farm \"ELSE\"",
    "        @intrinsic(\"execute body\")",
    "        emit farm \"END\"",
    "",
    "flex section else if {farm condition:condition}:",
    "    replacement:",
    "        emit farm \"ELSE\"",
    "        if condition:",
    "            @intrinsic(\"execute body\")",
    "        emit farm \"END\"",
    "",
    "flex section loop forever:",
    "    replacement:",
    "        emit farm \"LOOP|-1\"",
    "        @intrinsic(\"execute body\")",
    "        emit farm \"END\"",
    "",
    "flex section loop count [time|times]:",
    "    replacement:",
    "        @intrinsic(\"discard\", @intrinsic(\"variadic call\", \"libc\", \"printf\", a farm number, 1, \"LOOP|%d\\n\", @intrinsic(\"cast\", count, a farm number)))",
    "        @intrinsic(\"execute body\")",
    "        emit farm \"END\""
]
for each line in footer:
    print line line
